{
  "schemaVersion": 1,
  "id": "omarchy.active-window",
  "name": "Active window",
  "version": "1.0.0",
  "author": "Omarchy",
  "description": "Focused application name or window title",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "ActiveWindow.qml"
  },
  "barWidget": {
    "displayName": "Active window",
    "description": "Focused application name or window title",
    "category": "Compositor",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "mode": "appName",
      "maxWidth": 280
    },
    "schema": [
      {
        "key": "mode",
        "type": "enum",
        "label": "Display mode",
        "description": "Show the application name (macOS style), window title, or both",
        "options": ["appName", "title", "both"],
        "defaultValue": "appName"
      },
      {
        "key": "maxWidth",
        "type": "integer",
        "label": "Maximum width (px)",
        "description": "Maximum width of the label before eliding",
        "defaultValue": 280,
        "min": 80,
        "max": 1000,
        "step": 20
      }
    ]
  },
  "omarchy": {
    "clonePaths": [
      {
        "source": "ActiveWindowModel.js",
        "target": "ActiveWindowModel.js"
      }
    ]
  }
}

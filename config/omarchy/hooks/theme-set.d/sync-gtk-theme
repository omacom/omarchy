#!/bin/bash
# Omarchy theme-set hook: recolor GTK4 / libadwaita apps (Nautilus, etc.)
# to match the active Omarchy theme.
#
# libadwaita ignores the system GTK theme, so we override its named colors in
# ~/.config/gtk-4.0/gtk.css using the palette from the active theme's
# colors.toml. Runs on every `omarchy theme set`, so it always stays in sync.

set -euo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
OUT_DIR="$HOME/.config/gtk-4.0"
OUT="$OUT_DIR/gtk.css"

# Nothing to do if the active theme has no palette (very old themes).
[[ -f "$COLORS" ]] || exit 0

# Read a "key = value" (optionally quoted) from colors.toml.
get() {
  sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"?([^\"#]*#?[0-9A-Fa-f]{6})\"?.*/\1/p" "$COLORS" | head -1
}

MODE=$(sed -nE 's/^[[:space:]]*mode[[:space:]]*=[[:space:]]*"?([a-z]+)"?.*/\1/p' "$COLORS" | head -1)
BG=$(get background)
DBG=$(get dark_background)
DDBG=$(get darker_background)
LBG=$(get lighter_background)
FG=$(get foreground)
ACCENT=$(get accent)

# Fall back gracefully if any key is missing.
: "${BG:=#1a1a1a}" ; : "${FG:=#e0e0e0}" ; : "${ACCENT:=#3584e4}"
: "${DBG:=$BG}" ; : "${DDBG:=$DBG}" ; : "${LBG:=$BG}"

# Pick a readable foreground for text/icons drawn on top of the accent color,
# from the accent's perceived brightness.
accent_fg() {
  local h=${ACCENT#\#}
  local r=$((16#${h:0:2})) g=$((16#${h:2:2})) b=$((16#${h:4:2}))
  local y=$(( (r*299 + g*587 + b*114) / 1000 ))
  if (( y > 140 )); then echo "#101010"; else echo "#ffffff"; fi
}
ACCENT_FG=$(accent_fg)

# Layer the surfaces so panels read as distinct. The shade names in colors.toml
# are oriented for dark themes, so choose per mode.
if [[ "$MODE" == "light" ]]; then
  WINDOW=$DBG ; VIEW=$BG ; HEADER=$DBG ; SIDEBAR=$DDBG ; CARD=$BG
  SCHEME="prefer-light"
else
  WINDOW=$BG ; VIEW=$DDBG ; HEADER=$LBG ; SIDEBAR=$DBG ; CARD=$LBG
  SCHEME="prefer-dark"
fi

mkdir -p "$OUT_DIR"
cat > "$OUT" <<CSS
/* Generated by the Omarchy theme-set hook 'sync-gtk-theme'.
   Do not edit by hand: overwritten on every 'omarchy theme set'.
   Source palette: $COLORS (mode=$MODE) */

@define-color window_bg_color $WINDOW;
@define-color window_fg_color $FG;
@define-color view_bg_color $VIEW;
@define-color view_fg_color $FG;
@define-color headerbar_bg_color $HEADER;
@define-color headerbar_fg_color $FG;
@define-color headerbar_border_color $FG;
@define-color headerbar_backdrop_color $WINDOW;
@define-color sidebar_bg_color $SIDEBAR;
@define-color sidebar_fg_color $FG;
@define-color sidebar_backdrop_color $WINDOW;
@define-color secondary_sidebar_bg_color $SIDEBAR;
@define-color secondary_sidebar_fg_color $FG;
@define-color card_bg_color $CARD;
@define-color card_fg_color $FG;
@define-color dialog_bg_color $WINDOW;
@define-color dialog_fg_color $FG;
@define-color popover_bg_color $CARD;
@define-color popover_fg_color $FG;
@define-color accent_bg_color $ACCENT;
@define-color accent_fg_color $ACCENT_FG;
@define-color accent_color $ACCENT;
CSS

# Keep libadwaita's light/dark base in step with the theme.
if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme "$SCHEME" 2>/dev/null || true
fi

# Nautilus reads gtk.css at startup; quit any running instance so the next
# launch picks up the new colors. Harmless if it isn't running.
command -v nautilus >/dev/null 2>&1 && nautilus -q 2>/dev/null || true

exit 0

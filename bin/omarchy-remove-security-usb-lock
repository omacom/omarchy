#!/bin/bash

# omarchy:summary=Stop blocking unfamiliar USB and Thunderbolt devices while locked
# omarchy:requires-sudo=true

set -euo pipefail
gum confirm "$(omarchy-i18n deviceProtection.disable)" || exit 0
sudo /usr/bin/omarchy-usb-lock-admin disable
omarchy-shell -q lock refreshUsbPolicy >/dev/null 2>&1 || true
omarchy-notification-dismiss "$(omarchy-i18n usb.accessoryBlocked)" || true
omarchy-notification-dismiss "$(omarchy-i18n thunderbolt.accessoryBlocked)" || true
omarchy-notification-dismiss "$(omarchy-i18n thunderbolt.protection)" || true
echo "USB and Thunderbolt protection is disabled."

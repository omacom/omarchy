#!/bin/bash

# omarchy:summary=Create a desktop launcher for a RetroArch game
# omarchy:args=[core path-to-game]
# omarchy:examples=omarchy games retro install snes9x ~/Games/roms/snes/game.sfc | omarchy-games-retro-install /usr/lib/libretro/mgba_libretro.so ~/Games/roms/gba/game.gba

set -e

if (( $# == 0 )); then
  mapfile -t cores < <(omarchy-games-retro-cores)

  if (( ${#cores[@]} == 0 )); then
    omarchy-notification-send -g 󰯉 "$(omarchy-i18n games.noCores)" "/usr/lib/libretro"
    exit 1
  fi

  core=$(omarchy-menu-select "$(omarchy-i18n games.corePrompt)" "${cores[@]}") || exit 0
  [[ -n $core ]] || exit 0
  core="${core##*(}"
  core="${core%)}"

  game_path=$(omarchy-menu-file "$(omarchy-i18n games.pickGame)" "$HOME/Games/roms" "7z bin ccd chd cue dmg elf fds gb gba gbc iso lha m3u md n64 nds nes pbp sfc smc swc zip z64") || exit 0
  [[ -n $game_path ]] || exit 0
elif (( $# == 2 )); then
  core="$1"
  game_path="$2"
else
  echo "Usage: omarchy-games-retro-install [core path-to-game]"
  echo "Example: omarchy-games-retro-install snes9x ~/Games/roms/snes/game.sfc"
  exit 1
fi

if [[ ! -f $game_path ]]; then
  echo "Game not found: $game_path"
  exit 1
fi

# A desktop launcher may run from any working directory. Preserve the
# supplied filename for its label, but use one canonical path for Exec and ID.
game_name_path="$game_path"
# Command substitution would strip terminal newlines from a valid ROM name.
# GNU realpath -z and Bash's NUL-delimited read preserve the whole path.
if ! IFS= read -r -d '' game_path < <(realpath -e -z -- "$game_path"); then
  echo "Could not resolve game path: $game_name_path" >&2
  exit 1
fi

if [[ $core == */* ]]; then
  core_path="$core"
else
  core_path="/usr/lib/libretro/${core}_libretro.so"
fi

if [[ ! -f $core_path ]]; then
  echo "Core not found: $core_path"
  exit 1
fi

desktop_exec_quote() {
  # One Exec argument, double-quoted per the freedesktop Exec spec: inside quotes
  # " ` $ \ take a backslash and a literal % becomes %%. The whole Exec line then
  # goes through desktop_string_escape, as in omarchy-webapp-install.
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//\`/\\\`}
  value=${value//\$/\\\$}
  value=${value//%/%%}

  printf '"%s"' "$value"
}

desktop_string_escape() {
  # Desktop Entry "string" value (Name, Comment): a raw newline would start a
  # new key line and let a value inject a second Exec=. Escape backslash
  # first, then tab/CR/LF. Mirrors omarchy-webapp-install's helper.
  local value="$1"

  value=${value//\\/\\\\}
  value=${value//$'\t'/\\t}
  value=${value//$'\r'/\\r}
  value=${value//$'\n'/\\n}

  printf '%s' "$value"
}

game_name=$(printf '%s' "${game_name_path##*/}" | sed 's/\.[^.]*$//; s/[[:space:]]*([^)]*)//g; s/[[:space:]]\+/ /g; s/^ //; s/ $//' | perl -Mopen=locale -pe 's/(^|[[:space:]])([^[:space:]])/$1\U$2/g')

# A name that cleans to nothing (e.g. "(Europe).sfc") still needs a real
# Name= and file stem; fall back to the raw filename.
if [[ -z $game_name ]]; then
  game_name="${game_name_path##*/}"
fi

desktop_name="$game_name"
desktop_id=$(printf '%s' "$desktop_name" | tr '[:upper:]' '[:lower:]' | tr -cs '[:alnum:]' '-' | sed 's/^-//; s/-$//')

# A name with no ASCII letters or digits (e.g. Japanese titles) slugs to nothing;
# key the fallback on the ROM path so a second such game keeps its own launcher.
if [[ -z $desktop_id ]]; then
  desktop_id="retro-game-$(printf '%s' "$game_path" | md5sum | cut -d' ' -f1)"
fi

desktop_dir="$HOME/.local/share/applications"
desktop_file="$desktop_dir/$desktop_id.desktop"
mkdir -p "$desktop_dir"

cat >"$desktop_file" <<EOF
[Desktop Entry]
Version=1.0
Name=$(desktop_string_escape "$desktop_name")
Comment=Play $(desktop_string_escape "$game_name") with RetroArch
Exec=$(desktop_string_escape "retroarch -L $(desktop_exec_quote "$core_path") $(desktop_exec_quote "$game_path")")
Terminal=false
Type=Application
Icon=retro-gaming
StartupNotify=true
Categories=Game;Emulator;
EOF

chmod +x "$desktop_file"
update-desktop-database "$desktop_dir" &>/dev/null || true

omarchy-notification-send -g 󰯉 "$(omarchy-i18n games.installed "$game_name")" "$(omarchy-i18n games.startHint)"

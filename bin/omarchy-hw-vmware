#!/bin/bash

# omarchy:summary=Detect whether the computer is a VMware guest.

# Every VMware guest has the VMware SVGA adapter, the device vmwgfx drives.
# Read the cached sysfs IDs rather than lspci or systemd-detect-virt: the
# Hyprland config runs this on every reload, inside its 1.5s budget.
pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"

shopt -s nullglob

for device in "$pci_devices_path"/*; do
  [[ $(< "$device/vendor") == "0x15ad" ]] || continue
  [[ $(< "$device/class") == 0x03* ]] && exit 0
done

exit 1

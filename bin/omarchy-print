#!/bin/bash

# omarchy:summary=Print a file and show how the print job went
# omarchy:args=<file>
# omarchy:hidden=true

# lp only queues the job, and CUPS tells no one when it fails, so follow the job
# in a notification that ends as printed or failed, with CUPS's reason.

if (($# != 1)); then
  echo "Usage: omarchy-print <file>" >&2
  exit 1
fi

name=${1##*/}

notify() {
  omarchy-notification-send -r "${id:-0}" -g 󰐪 "$@"
}

if ! output=$(lp -- "$1" 2>&1); then
  notify -u critical "$(omarchy-i18n print.failed "$name")" "$output"
  exit 1
fi

# "request id is <printer>-<job> (1 file(s))", in the user's language.
[[ $output =~ ([^[:space:]]+)-([0-9]+) ]] || exit 0
printer=${BASH_REMATCH[1]}
job=${BASH_REMATCH[2]}

# The lpstat list that holds the job, then its Alerts and Status lines. The
# active list comes first: the completed one holds the whole job history. The C
# locale keeps the labels in English.
job_info() {
  for list in not-completed completed; do
    LC_ALL=C lpstat -W "$list" -l -o "$printer" | awk -v list="$list" -v job="$printer-$job" '
      $1 == job { found = 1; next }
      found && !/^\t/ { exit }
      found && sub(/^\tAlerts: /, "") { alerts = $0 }
      found && sub(/^\tStatus: /, "") { status = $0 }
      END { if (!found) exit 1; print list; print alerts; print status }' && return
  done
}

# The printer's message says what went wrong ("gstoraster filter failed."). The
# job's Status can hold a filter warning that comes with every job instead.
reason() {
  local message
  message=$(LC_ALL=C lpstat -p "$printer" | sed -n '2{s/^[[:space:]]*//;p}')
  echo "${message:-${status:-$alerts}}"
}

# Follow the job in the background, so imv isn't held up: every two seconds,
# for up to five minutes.
(
  id=$(notify -p "$(omarchy-i18n print.sending "$name")" "$(omarchy-i18n print.job "$job" "$printer")")

  for _ in {1..150}; do
    sleep 2
    { read -r list; read -r alerts; read -r status; } < <(job_info)

    # A finished job either completed successfully or failed. An active one
    # failed when a filter stopped it (job-completed-with-errors) or the printer
    # holds it: neither prints on its own.
    case "$list $alerts" in
      "completed "*job-completed-successfully*)
        notify "$(omarchy-i18n print.done "$name")"
        exit
        ;;
      "completed "* | *error* | *stopped*)
        notify -u critical "$(omarchy-i18n print.failed "$name")" "$(reason)"
        exit
        ;;
    esac
  done

  # Still queued: a printer that is off or out of paper keeps a job waiting. A
  # job in neither list (CUPS unreachable, history purged) can't be followed, so
  # name the job to look for in the queue.
  if [[ -n $list ]]; then
    notify "$(omarchy-i18n print.sending "$name")" "$(reason)"
  else
    notify "$(omarchy-i18n print.untracked "$name")" "$(omarchy-i18n print.job "$job" "$printer")"
  fi
) &

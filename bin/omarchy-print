#!/bin/bash

# omarchy:summary=Print a file and show how the print job went
# omarchy:args=<file>
# omarchy:hidden=true

# lp only queues the job, and CUPS tells no one when it fails, so follow the job
# in a notification that ends as printed or failed, with CUPS's reason.

if (($# != 1)); then
  echo "Usage: omarchy-print <file>" >&2
  exit 1
fi

name=${1##*/}

notify() {
  omarchy-notification-send -r "${id:-0}" -g 󰐪 "$@"
}

if ! output=$(lp -- "$1" 2>&1); then
  notify -u critical "$(omarchy-i18n print.failed "$name")" "$output"
  exit 1
fi

# "request id is <printer>-<job> (1 file(s))", in the user's language.
[[ $output =~ ([^[:space:]]+)-([0-9]+) ]] || exit 0
printer=${BASH_REMATCH[1]}
job=${BASH_REMATCH[2]}

# The job's Alerts and Status lines from one lpstat list, or a failure when the
# job isn't in it. The C locale keeps the labels in English.
job_info() {
  LC_ALL=C lpstat -W "$1" -l -o "$printer" | awk -v job="$printer-$job" '
    $1 == job { found = 1; next }
    found && !/^\t/ { exit }
    found && sub(/^\tAlerts: /, "") { alerts = $0 }
    found && sub(/^\tStatus: /, "") { status = $0 }
    END { if (!found) exit 1; print alerts; print status }'
}

# Follow the job in the background, so imv isn't held up: every two seconds,
# for up to five minutes.
(
  id=$(notify -p "$(omarchy-i18n print.sending "$name")" "$(omarchy-i18n print.job "$job" "$printer")")

  for _ in {1..150}; do
    sleep 2
    # A finished job leaves the active list; only then read the completed one,
    # which holds the whole job history.
    { read -r alerts; read -r status; } < <(job_info not-completed || job_info completed)

    # A failed filter stops the job with job-completed-with-errors, so failures
    # are matched before completion.
    case $alerts in
      *error* | *aborted* | *canceled* | *stopped*)
        notify -u critical "$(omarchy-i18n print.failed "$name")" "${status:-$alerts}"
        exit
        ;;
      *job-completed-*)
        notify "$(omarchy-i18n print.done "$name")"
        exit
        ;;
    esac
  done

  # Still queued: a printer that is off or out of paper keeps a job waiting.
  if [[ -n $status ]]; then
    notify "$(omarchy-i18n print.sending "$name")" "$status"
  fi
) &

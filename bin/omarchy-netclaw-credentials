#!/bin/bash
# omarchy:summary=Configure credentials for your installed NetClaw integrations

set -euo pipefail
# shellcheck source=default/netclaw/runtime.sh
source "$OMARCHY_PATH/default/netclaw/runtime.sh"
[[ -f $netclaw_state/configured ]] || { echo "Run omarchy netclaw setup first." >&2; exit 1; }
umask 077
exec 8>"$netclaw_state/setup.lock"
flock -n 8 || { echo "NetClaw setup or credential editing is already running." >&2; exit 1; }
cd "$netclaw_dir"
python3 "$OMARCHY_PATH/default/netclaw/credential-setup.py" "$netclaw_dir"
openclaw gateway restart

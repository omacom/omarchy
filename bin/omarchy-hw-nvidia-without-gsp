#!/bin/bash

# omarchy:summary=Detect whether the computer has an NVIDIA GPU without GSP firmware (Maxwell/Pascal/Volta)

# Wrapper over omarchy-hw-nvidia-arch so the device-ID ranges live in one place.
# See that helper for why 0x1340 <= ID < 0x1e00 is the legacy span.
dir=${BASH_SOURCE[0]%/*}
[[ $dir != "${BASH_SOURCE[0]}" ]] || dir=.
[[ $("$dir/omarchy-hw-nvidia-arch") == "legacy" ]]

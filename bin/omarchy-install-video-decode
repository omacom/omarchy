#!/bin/bash

# omarchy:summary=Configure hardware video decoding on supported laptops

set -euo pipefail

# The Snapdragon video chip is a V4L2 decoder. mpv's auto-safe list leaves V4L2
# decoders out, and Arch Linux ARM's Chromium only turns its V4L2 decoder on
# with ANGLE on GLES and the AcceleratedVideoDecoder feature. Other machines
# keep both programs' defaults.

# mpv reads this after /etc/mpv/mpv.conf. A global hwdec the user set stays as
# it is. One inside a profile only applies with that profile, so the fallback
# still goes in, on top, where no [profile] section can catch it.
setup_mpv_option() {
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/mpv/mpv.conf"
  local option=$1 value=$2 comment=$3

  if [[ ! -s $conf ]]; then
    mkdir -p "${conf%/*}" || return
    printf '%s\n' "$comment" "$option=$value" >"$conf"
  elif ! has_global_option "$conf" "$option"; then
    sed -i --follow-symlinks "1i $comment\n$option=$value" "$conf"
  fi
}

# Options before the first [profile] and after a [default] line are global. A
# profile line may end in a comment.
has_global_option() {
  awk -v option="$2" '
    /^[[:space:]]*\[[^]]*\][[:space:]]*(#.*)?$/ { global = ($0 ~ /^[[:space:]]*\[default\][[:space:]]*(#.*)?$/); next }
    global && $0 ~ "^[[:space:]]*" option "[[:space:]]*=" { found = 1 }
    END { exit !found }
  ' global=1 "$1"
}

# Chromium's launcher splits each line into arguments, so a switch can share a
# line with others or end in a comment. Look for switches with comments removed.
chromium_args() {
  sed -E 's/(^|[[:space:]])#.*$//' "$1"
}

# Add a line, starting a new one first if the file doesn't end in a newline.
append_line() {
  if [[ -n $(tail -c1 "$1") ]]; then
    echo >>"$1" || return
  fi
  printf '%s\n' "$2" >>"$1"
}

# A --use-angle the user set stays as it is. Chrome and Chromium each read
# their own flags file, and one that can't be written doesn't hold back the other.
setup_chromium() {
  local conf status=0

  for conf in ~/.config/chromium-flags.conf ~/.config/chrome-flags.conf; do
    [[ -f $conf ]] || continue
    if ! chromium_args "$conf" | grep -E -- '(^|[[:space:]])--use-angle=' >/dev/null; then
      append_line "$conf" '--use-angle=gles-egl' || status=$?
    fi
  done

  omarchy-chromium-add-feature AcceleratedVideoDecoder || status=$?
  return "$status"
}

if omarchy-hw-aarch64-qualcomm; then
  # A config that can't be written for one program doesn't hold back the other.
  # Running them under || turns set -e off inside, so each write returns its
  # own failure.
  status=0
  setup_mpv_option hwdec auto-safe,v4l2m2m-copy "# Fall back to the Snapdragon video chip's decoder (Omarchy)" || status=$?
  setup_chromium || status=$?
  exit "$status"
elif omarchy-hw-match '^MacBookPro8,2$'; then
  # Sandy Bridge has VA-API H.264 decoding but no usable Vulkan driver.
  # Preserve each global option the user chose, including hwdec=no.
  status=0
  setup_mpv_option hwdec vaapi "# Use Sandy Bridge's VA-API decoder (Omarchy)" || status=$?
  setup_mpv_option vo gpu "# Sandy Bridge uses the OpenGL video output (Omarchy)" || status=$?
  setup_mpv_option gpu-api opengl "# Sandy Bridge has no Vulkan support (Omarchy)" || status=$?
  exit "$status"
fi

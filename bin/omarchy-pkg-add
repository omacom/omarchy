#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  if (( EUID == 0 )); then
    PACMAN_CMD=(pacman -S --noconfirm --needed -- "$@")
  else
    PACMAN_CMD=(sudo pacman -S --noconfirm --needed -- "$@")
  fi

  if ! "${PACMAN_CMD[@]}"; then
    echo -e "\n\033[33mInstallation failed. This usually happens when package databases are out of date (e.g., 404 errors).\033[0m" >&2
    if [[ -t 0 && -t 1 ]]; then
      read -p "Would you like to run a full system update (omarchy update) now? (y/N) " -n 1 -r
      echo
      if [[ $REPLY =~ ^[Yy]$ ]]; then
        omarchy update
        "${PACMAN_CMD[@]}" || exit 1
      else
        exit 1
      fi
    else
      echo -e "To fix this safely, run: \033[1momarchy update\033[0m, then try again." >&2
      exit 1
    fi
  fi
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0

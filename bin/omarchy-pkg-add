#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if [[ ${OMARCHY_PKG_DEFER:-} == "1" && -n ${OMARCHY_PKG_QUEUE_FILE:-} ]]; then
  (( $# == 0 )) && exit 0
  printf '%s\n' "$@" >>"$OMARCHY_PKG_QUEUE_FILE" || exit 1
  exit 0
fi

flushed_queue=0
packages=()
declare -A seen=()

if (( $# > 0 )); then
  # When every requested package is already installed, leave any deferred queue
  # intact for the final flush instead of running pacman mid-pass.
  omarchy-pkg-missing "$@" || exit 0

  missing_args=()
  for pkg in "$@"; do
    [[ -n $pkg && -z ${seen[$pkg]+x} ]] || continue
    seen[$pkg]=1
    if omarchy-pkg-missing "$pkg"; then
      missing_args+=("$pkg")
    fi
  done

  if (( ${#missing_args[@]} == 0 )); then
    exit 0
  fi

  seen=()
fi

if [[ -n ${OMARCHY_PKG_QUEUE_FILE:-} && -s $OMARCHY_PKG_QUEUE_FILE ]]; then
  flushed_queue=1
  while IFS= read -r pkg; do
    [[ -n $pkg && -z ${seen[$pkg]+x} ]] || continue
    seen[$pkg]=1
    if ! pacman -Q -- "$pkg" &>/dev/null; then
      packages+=("$pkg")
    fi
  done <"$OMARCHY_PKG_QUEUE_FILE"
fi

if (( $# > 0 )); then
  for pkg in "${missing_args[@]}"; do
    [[ -z ${seen[$pkg]+x} ]] || continue
    seen[$pkg]=1
    packages+=("$pkg")
  done
fi

if (( ${#packages[@]} == 0 )); then
  if (( flushed_queue )); then
    : >"$OMARCHY_PKG_QUEUE_FILE" || exit 1
  fi
  exit 0
fi

if (( EUID == 0 )); then
  pacman -S --noconfirm --needed -- "${packages[@]}" || exit 1
else
  sudo pacman -S --noconfirm --needed -- "${packages[@]}" || exit 1
fi

for pkg in "${packages[@]}"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

if (( flushed_queue )); then
  : >"$OMARCHY_PKG_QUEUE_FILE" || exit 1
fi

exit 0

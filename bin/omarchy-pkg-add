#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true

if omarchy-pkg-missing "$@"; then
  # Only ask pacman for targets nothing installed satisfies yet. A name an
  # installed package already provides (fcitx5-mozc-ut provides fcitx5-mozc
  # while declaring Conflicts: mozc) must stay out of the transaction: with
  # --noconfirm pacman answers the provider-conflict question with N, and the
  # whole transaction fails to prepare, so migrations that pull in a sibling
  # of a -ut pair abort the entire update. (#18848)
  unsatisfied=$(pacman -T -- "$@") || true
  if [[ -n $unsatisfied ]]; then
    readarray -t unsatisfied <<< "$unsatisfied"
    if (( EUID == 0 )); then
      pacman -S --noconfirm --needed -- "${unsatisfied[@]}" || exit 1
    else
      sudo pacman -S --noconfirm --needed -- "${unsatisfied[@]}" || exit 1
    fi
  fi
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0

#!/bin/bash

# omarchy:summary=Install a supported browser
# omarchy:args=<chromium|chrome|brave|brave-origin|edge|firefox|zen|yandex>
# omarchy:examples=omarchy install browser chromium | omarchy install browser firefox

set -e

source "$OMARCHY_PATH/install/helpers/browser-policy.sh"

opt_path="${OMARCHY_OPT_PATH:-/opt}"

setup_chromium_policy_directory() {
  browser_policy_setup_dir "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

# The widevine package registers its CDM for Chromium and Firefox only; Brave
# looks for one in its own install directory.
link_widevine_cdm() {
  local cdm="$opt_path/WidevineCdm/chromium"
  local install_dir="$opt_path/$1"

  if [[ -d $cdm && -d $install_dir && ! -e $install_dir/WidevineCdm ]]; then
    as_root ln -sfn "$cdm" "$install_dir/WidevineCdm"
  fi
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "$OMARCHY_PATH/config/chromium-flags.conf" "$1"
  omarchy-install-chromium-copy-url
  omarchy-install-chromium-ytdlp
  omarchy-install-video-decode
  omarchy-install-camera
}

# Yandex's deb ships no libffmpeg.so, and its bundled update-ffmpeg script
# reads codecs.json, whose newest entry targets Chromium 112 — far behind the
# browser. The maintained manifest is codecs_snap.json, keyed by Chromium
# major version and pointing at chromium-ffmpeg snaps with a full libffmpeg.so.
# update-ffmpeg names the base the browser expects, so follow it on upgrades.
install_yandex_ffmpeg_codecs() {
  local browser_dir="$opt_path/yandex/browser"
  local base manifest url path tmp

  base=$(grep -m1 -oE '[0-9]+\.[0-9]+\.[0-9]+' "$browser_dir/update-ffmpeg" | cut -d. -f1)
  manifest=$(wget -qO- https://browser-resources.s3.yandex.net/linux/codecs_snap.json)
  url=$(jq -r --arg base "$base" '.[$base].url // empty' <<<"$manifest")
  path=$(jq -r --arg base "$base" '.[$base].path // empty' <<<"$manifest")

  if [[ -z $url || -z $path ]]; then
    echo "No codec bundle published for Chromium base $base; H.264/AAC playback may not work."
    return 0
  fi

  tmp=$(mktemp -d)
  if wget -q "$url" -O "$tmp/codecs.snap" &&
    unsquashfs -f -d "$tmp/root" "$tmp/codecs.snap" "$path" >/dev/null; then
    as_root install -m 644 "$tmp/root/$path" "$browser_dir/libffmpeg.so"
    echo "Installed full ffmpeg codecs for Chromium base $base."
  else
    echo "Failed to fetch the codec bundle; H.264/AAC playback may not work."
  fi
  rm -rf "$tmp"
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/omarchy-firefox-wayland.conf
}

case $1 in
chromium)
  echo "Installing Chromium..."
  omarchy-pkg-add chromium

  setup_chromium_policy_directory /etc/chromium/policies/managed
  copy_chromium_flags ~/.config/chromium-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install chromium
  announce_browser_installed "Chromium"
  ;;
chrome)
  echo "Installing Chrome..."
  omarchy-pkg-add google-chrome

  setup_chromium_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install chrome
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  omarchy-pkg-aur-add microsoft-edge-stable-bin || exit 1

  setup_chromium_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags ~/.config/microsoft-edge-stable-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install edge
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  omarchy-pkg-aur-add brave-bin || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  link_widevine_cdm brave-bin
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install brave
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  omarchy-pkg-aur-add brave-origin-bin || exit 1

  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-origin-flags.conf
  link_widevine_cdm brave-origin-bin
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install brave-origin
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  omarchy-pkg-add firefox || exit 1

  browser_policy_setup_firefox_distribution /usr/lib/firefox/distribution
  setup_firefox_wayland
  omarchy-lifecycle-dispatch post-install firefox
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  omarchy-pkg-aur-add zen-browser-bin || exit 1

  browser_policy_setup_firefox_distribution /opt/zen-browser/distribution
  setup_firefox_wayland
  omarchy-lifecycle-dispatch post-install zen
  announce_browser_installed "Zen"
  ;;
yandex)
  echo "Installing Yandex Browser..."
  omarchy-pkg-aur-add yandex-browser || exit 1

  omarchy-pkg-add squashfs-tools
  install_yandex_ffmpeg_codecs
  copy_chromium_flags ~/.config/yandex-browser-flags.conf
  omarchy-theme-set-browser
  omarchy-lifecycle-dispatch post-install yandex
  announce_browser_installed "Yandex Browser"
  ;;
*)
  echo "Usage: omarchy-install-browser <chromium|chrome|brave|brave-origin|edge|firefox|zen|yandex>"
  exit 1
  ;;
esac

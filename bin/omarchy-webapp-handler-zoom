#!/bin/bash

# omarchy:summary=Open Zoom web meetings from browser protocol links
# omarchy:args=[url]

url="$1"
web_url="https://app.zoom.us/wc/home"

if [[ $url =~ ^zoom(mtg|us):// ]]; then
  confno=$(echo "$url" | sed -n 's/.*[?&]confno=\([^&]*\).*/\1/p')
  pwd=$(echo "$url" | sed -n 's/.*[?&]pwd=\([^&]*\).*/\1/p')

  # A meeting number is ASCII digits; anything else could add path segments or a
  # query to the URL below. Spelled out, as [0-9] matches other digits in UTF-8.
  if [[ $confno =~ ^[0123456789]{1,20}$ ]]; then
    web_url="https://app.zoom.us/wc/join/$confno"

    # sed stops at the first &, so the passcode stays one query value however
    # it is encoded.
    if [[ -n $pwd ]]; then
      web_url+="?pwd=$pwd"
    fi
  fi
fi

exec omarchy-launch-webapp "$web_url"

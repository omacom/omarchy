#!/bin/bash

# omarchy:summary=Open Zoom web meetings from browser protocol links
# omarchy:args=[url]

url="${1:-}"
web_url="https://app.zoom.us/wc/home"

if [[ $url != *[[:cntrl:]]* && ${url,,} =~ ^zoom(mtg|us):// ]]; then
  url_no_fragment="${url%%#*}"
  confno=$(printf '%s\n' "$url_no_fragment" | sed -n 's/.*[?&]confno=\([^&]*\).*/\1/p')

  if [[ $confno =~ ^[A-Za-z0-9_-]+$ ]]; then
    pwd=$(printf '%s\n' "$url_no_fragment" | sed -n 's/.*[?&]pwd=\([^&]*\).*/\1/p')

    if [[ -n $pwd ]]; then
      pwd=$(jq -rn --arg v "$pwd" '[$v | scan("%[0-9A-Fa-f]{2}|[^%]+|%") | if test("^%[0-9A-Fa-f]{2}$") then . else @uri end] | join("")')
      web_url="https://app.zoom.us/wc/join/$confno?pwd=$pwd"
    else
      web_url="https://app.zoom.us/wc/join/$confno"
    fi
  fi
fi

exec omarchy-launch-webapp "$web_url"

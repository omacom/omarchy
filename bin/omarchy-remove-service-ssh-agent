#!/bin/bash

# omarchy:summary=Disable the gcr-ssh-agent SSH agent and its environment override.

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
systemd_env_file="$config_home/environment.d/90-gcr-ssh-agent.conf"
session_env_file="$config_home/uwsm/env.d/90-omarchy-ssh-agent"

# The file goes before disable reloads the manager, or the environment generator keeps exporting it.
rm -f "$systemd_env_file"
systemctl --user disable --now gcr-ssh-agent.socket 2>/dev/null || true
systemctl --user stop gcr-ssh-agent.service 2>/dev/null || true

# The manager can outlive a logout and uwsm restores its initial environment
# during cleanup. Explicitly drop the saved socket value during the next
# session preparation, before Hyprland or its apps inherit it.
mkdir -p "$(dirname "$session_env_file")"
printf '%s\n' \
  '# Keep a stale gcr socket restored by uwsm out of the next session.' \
  'if [ "${SSH_AUTH_SOCK:-}" = "$XDG_RUNTIME_DIR/gcr/ssh" ] && ! systemctl --user -q is-active gcr-ssh-agent.socket; then' \
  '  unset SSH_AUTH_SOCK' \
  'fi' >"$session_env_file"

# The socket exported SSH_AUTH_SOCK to the user manager, which outlives the agent.
if systemctl --user show-environment | grep -Fqx "SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/gcr/ssh"; then
  systemctl --user unset-environment SSH_AUTH_SOCK
fi

echo ""
echo "SSH agent has been disabled. Log out and back in for it to take full effect."

#!/bin/bash

# omarchy:summary=Launch a TUI or focus an existing terminal window for it
# omarchy:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  # Callers may pass the whole command as one string, which omarchy-launch-or-focus
  # re-splits, so omarchy-launch-tui names the window after its first word only.
  read -r COMMAND _ <<<"$1"
  # That re-split also removes quotes, so strip one matching pair around the word.
  if [[ $COMMAND == \'*\' || $COMMAND == \"*\" ]]; then
    COMMAND=${COMMAND:1:-1}
  fi
  APP_ID="org.omarchy.$(basename "$COMMAND")"
fi

LAUNCH_COMMAND="omarchy-launch-tui $@"

exec omarchy-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"

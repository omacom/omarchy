#!/bin/bash

# omarchy:summary=Check the update log for known failure conditions

# Same transcript path omarchy-update writes, under the user's state directory.
update_log="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/update.log"

# grep follows a symlink. The transcript is the regular file omarchy-update
# prepares. A missing log has nothing to scan.
if [[ -L $update_log || ! -f $update_log ]]; then
  exit 0
fi

# Check for initramfs generation failure
if grep -q "Updating linux initcpios" "$update_log"; then
  if ! grep -q "Initcpio image generation successful" "$update_log"; then
    echo -e '\e[31mError: Initramfs generation may have failed. Review logs before restart.\e[0m'
    echo
  fi
fi

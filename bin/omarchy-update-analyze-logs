#!/bin/bash

# omarchy:summary=Check the update log for known failure conditions

# The update transcript is a private, per-run file omarchy-update hands us
# through OMARCHY_UPDATE_LOG. It is never at a fixed location, so refuse to
# guess one.
update_log="${OMARCHY_UPDATE_LOG:?omarchy-update-analyze-logs requires OMARCHY_UPDATE_LOG}"

# Check for initramfs generation failure
if grep -q "Updating linux initcpios" "$update_log"; then
  if ! grep -q "Initcpio image generation successful" "$update_log"; then
    echo -e '\e[31mError: Initramfs generation may have failed. Review logs before restart.\e[0m'
    echo
  fi
fi

#!/bin/bash

# omarchy:summary=Check the update log for known failure conditions

# Run on its own, read this user's transcript; the updater that installs this
# command still writes the old /tmp one.
update_log=${OMARCHY_UPDATE_LOG:-}
if [[ -z $update_log ]]; then
  update_log=/tmp/omarchy-update.log
  if [[ -d ${XDG_RUNTIME_DIR:-} && -O $XDG_RUNTIME_DIR && -r $XDG_RUNTIME_DIR/omarchy-update.log ]]; then
    update_log=$XDG_RUNTIME_DIR/omarchy-update.log
  fi
fi
[[ -r $update_log ]] || exit 0

# Check for initramfs generation failure
if grep -q "Updating linux initcpios" "$update_log"; then
  if ! grep -q "Initcpio image generation successful" "$update_log"; then
    echo -e '\e[31mError: Initramfs generation may have failed. Review logs before restart.\e[0m'
    echo
  fi
fi

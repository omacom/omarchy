#!/bin/bash

# omarchy:summary=Create a new Omarchy migration in the current source tree.
# omarchy:args=[--no-edit]

set -euo pipefail

no_edit=0

while (($#)); do
  case "$1" in
    --no-edit)
      no_edit=1
      shift
      ;;
    system|user)
      echo "omarchy-dev-add-migration: migration scopes are no longer used; creating a regular migration." >&2
      shift
      ;;
    -h|--help)
      echo "Usage: omarchy-dev-add-migration [--no-edit]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: omarchy-dev-add-migration [--no-edit]" >&2
      exit 1
      ;;
  esac
done

cd "${OMARCHY_PATH:-$(pwd)}"
mkdir -p migrations

# Use wall-clock time, not HEAD's committer date, so two branches cut from the
# same commit do not mint the same migration id (#13516).
id=$(date +%s)
migration_file="migrations/${id}.sh"
# noclobber creates the file with O_EXCL, so concurrent runs cannot claim one id.
set -o noclobber
until { : >"$migration_file"; } 2>/dev/null; do
  [[ -e $migration_file ]] || { echo "Cannot create $PWD/$migration_file" >&2; exit 1; }
  id=$((id + 1))
  migration_file="migrations/${id}.sh"
done
set +o noclobber

if (( ! no_edit )); then
  nvim "$migration_file"
fi

printf '%s\n' "$PWD/$migration_file"

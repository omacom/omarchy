#!/bin/bash

# omarchy:summary=Create a new Omarchy migration in the current source tree.
# omarchy:args=[--no-edit]

set -euo pipefail

no_edit=0

while (($#)); do
  case "$1" in
    --no-edit)
      no_edit=1
      shift
      ;;
    system|user)
      echo "omarchy-dev-add-migration: migration scopes are no longer used; creating a regular migration." >&2
      shift
      ;;
    -h|--help)
      echo "Usage: omarchy-dev-add-migration [--no-edit]"
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      echo "Usage: omarchy-dev-add-migration [--no-edit]" >&2
      exit 1
      ;;
  esac
done

cd "${OMARCHY_PATH:-$(pwd)}"
mkdir -p migrations

# Wall-clock time, not HEAD's committer date: branches cut from the same commit
# used to collide on one migration id and silently skip (#13516).
migration_id=$(date +%s)
migration_file="migrations/${migration_id}.sh"
while [[ -e $migration_file ]]; do
  ((++migration_id))
  migration_file="migrations/${migration_id}.sh"
done

touch "$migration_file"

if (( ! no_edit )); then
  nvim "$migration_file"
fi

printf '%s\n' "$PWD/$migration_file"

#!/usr/bin/python3
# omarchy:summary=Print the Moonshot usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Moonshot usage into one display-ready JSON record.

Local stats come from pi/omp session files whose assistant messages ran on a
Moonshot provider, from opencode sessions on one, and from Claude Code,
MiniMax Code and Codex turns sent to Moonshot's API. Billing is prepaid, so
the record carries the live balance from GET /v1/users/me/balance when a key
is available, and the last 30 days' spend from the costs pi and opencode
wrote beside each reply. The agents panel only ever reads the JSON this
prints.
"""

from __future__ import annotations

import argparse
import math
import os
import sys
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

# The shared collector plumbing ships with the agents panel.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "shell", "plugins", "agents"))
from collectors import (  # noqa: E402
  HttpError,
  LimitsCache,
  Stats,
  base_record as shared_base_record,
  cached_scan,
  data_home,
  emit,
  limits_cache_path,
  now_ms,
  number,
  obj,
  open_json,
  opencode_db,
  pi_session_roots,
  read_json,
  routed_match,
  routed_sources,
  scan_max_age,
  scan_opencode,
  scan_pi_sessions,
  scan_routed,
  trusted_endpoint,
  warn,
)

# Kimi Code can send its requests to Moonshot's API too: those requests and
# their prompts count here. The reader lives in Kimi's own collector, since
# the wire log's routes and forks are its format.
sys.path.insert(0, os.path.join(os.environ["OMARCHY_PATH"], "bin"))
from importlib.machinery import SourceFileLoader  # noqa: E402

kimi_harness = SourceFileLoader("omarchy_agent_usage_kimi", os.path.join(os.environ["OMARCHY_PATH"], "bin", "omarchy-agent-usage-kimi")).load_module()  # noqa: E402

AGENT_ID = "moonshot"
AGENT_NAME = "Moonshot"
OUT_OF_CREDITS_HELP = "Moonshot's balance no longer covers API calls. Top up on the Moonshot platform."

# The wallets pi, omp and opencode name: the international API and China's,
# each with its own balance and currency.
PROVIDERS = ("moonshotai", "moonshotai-cn", "moonshot")
BASE_URLS = {
  "moonshotai": "https://api.moonshot.ai",
  "moonshotai-cn": "https://api.moonshot.cn",
  "moonshot": "https://api.moonshot.ai",
}


class MoonshotError(Exception):
  def __init__(self, message: str, transport: bool = False, refused: bool = False) -> None:
    super().__init__(message)
    self.transport = transport
    self.refused = refused


def model_name(raw: Any) -> str:
  value = str(raw or AGENT_ID)
  return value if value else AGENT_ID


# ---------------------------------------------------- pi, omp, and opencode

def billed_here(provider: str, model: str, entry: dict) -> bool:
  return provider in PROVIDERS


def local_stats(reuse: bool = True) -> tuple[dict[str, Any], bool]:
  """Moonshot's usage and typed prompts on pi, omp and opencode, plus the
  Claude Code, MiniMax Code and Codex turns Moonshot billed, and the Kimi
  Code requests sent to Moonshot's API."""
  stats = Stats()
  code_rows, code_complete = kimi_harness.harness_rows(AGENT_ID)
  for row in code_rows:
    stats.add_row(row, model_name(row.model))
  pi_rows, pi_complete = scan_pi_sessions(r'"provider"\s*:\s*"(' + "|".join(PROVIDERS) + r')"', billed_here)
  for row in pi_rows:
    stats.add_row(row, model_name(row.model.rstrip("/").split("/")[-1]))
  # The database's prefilter matches every provider id.
  db_rows, db_complete = scan_opencode(["moonshot"], billed_here)
  for row in db_rows:
    stats.add_row(row, model_name(row.model.rstrip("/").split("/")[-1]))
  routed_rows, routed_complete = scan_routed(AGENT_ID, reuse)
  for row in routed_rows:
    stats.add_row(row, model_name(row.model))
  return stats.snapshot_with_spend(), code_complete and pi_complete and db_complete and routed_complete


def cached_local_stats(max_age: float) -> dict[str, Any]:
  # The digest covers every data path the scan reads.
  sources = [kimi_harness.code_home(), opencode_db(), *pi_session_roots(), *routed_sources()]
  # A forced scan reads every Codex rollout again too.
  return cached_scan(AGENT_ID, sources, max_age, lambda: local_stats(reuse=max_age > 0), match={**routed_match(), **kimi_harness.harness_match()})


# -------------------------------------------------------------- credentials

def read_key_from_dict(parsed: Any, provider: str) -> str:
  if not isinstance(parsed, dict):
    return ""
  entry = parsed.get(provider)
  if isinstance(entry, dict):
    entry = entry.get("key") or entry.get("apiKey") or entry.get("api_key")
  key = entry.strip() if isinstance(entry, str) else ""
  # Only a literal key is taken: a pi `$VAR` or `!command` entry is resolved
  # by pi alone, and sent as it stands it would read as a refused key.
  return "" if key.startswith(("!", "$")) else key


def pi_agent_dir() -> Path:
  configured = os.environ.get("PI_CODING_AGENT_DIR", "").strip()
  return Path(os.path.expanduser(configured)) if configured else Path.home() / ".pi" / "agent"


def read_json_key(path: Path, provider: str) -> str:
  return read_key_from_dict(read_json(path), provider)


def api_key() -> tuple[str, str]:
  """The wallet's key and base URL, ("", "") when there is none."""
  # The environment first, then the agents that keep a Moonshot key, read
  # only: pi and omp, then opencode.
  env_key = str(os.environ.get("MOONSHOT_API_KEY", "")).strip()
  if env_key:
    return env_key, BASE_URLS["moonshotai"]
  for path, provider in (
    (pi_agent_dir() / "auth.json", "moonshotai"),
    (pi_agent_dir() / "auth.json", "moonshotai-cn"),
    (Path.home() / ".omp" / "agent" / "auth.json", "moonshot"),
    (data_home() / "opencode" / "auth.json", "moonshotai"),
    (data_home() / "opencode" / "auth.json", "moonshotai-cn"),
  ):
    key = read_json_key(path, provider)
    if key:
      return key, BASE_URLS[provider]
  return "", ""


# ----------------------------------------------------------------- balance

def fetch_balance(api_base_url: str, key: str) -> dict[str, Any]:
  """GET /v1/users/me/balance: the available balance and its currency."""
  url = api_base_url.rstrip("/") + "/v1/users/me/balance"
  # MOONSHOT_API_BASE_URL moves the endpoint, never the key onto a
  # connection anyone on the way can read.
  try:
    urllib.parse.urlsplit(url)
  except ValueError:
    raise MoonshotError("MOONSHOT_API_BASE_URL must use HTTPS (plain HTTP only for loopback).") from None
  if not trusted_endpoint(url):
    raise MoonshotError("MOONSHOT_API_BASE_URL must use HTTPS (plain HTTP only for loopback).")
  request = urllib.request.Request(
    url,
    headers={"Authorization": "Bearer " + key, "Accept": "application/json"},
  )
  try:
    payload = open_json(request, timeout=15)
  except HttpError as error:
    if error.status in (401, 403):
      raise MoonshotError("Moonshot rejected the saved API key. Set a current one in MOONSHOT_API_KEY or the agent that holds it.", refused=True) from error
    if error.status:
      raise MoonshotError(f"Moonshot's balance endpoint returned HTTP {error.status}.") from error
    if error.transport:
      # No answer at all: no route, no DNS, a timeout. Worth a retry soon.
      raise MoonshotError("Couldn't reach the Moonshot API. Retrying shortly.", transport=True) from error
    raise MoonshotError("Moonshot returned an invalid balance response.") from error

  data = payload.get("data") if isinstance(payload, dict) else None
  if not isinstance(data, dict):
    raise MoonshotError("Moonshot returned an invalid balance response.")
  amount = data.get("available_balance")
  if isinstance(amount, bool) or amount is None:
    raise MoonshotError("Moonshot's balance response carried no available_balance.")
  try:
    remaining = float(amount)
  except (TypeError, ValueError):
    raise MoonshotError("Moonshot's balance response carried no available_balance.") from None
  if not math.isfinite(remaining) or remaining < 0:
    raise MoonshotError("Moonshot's balance response carried no available_balance.")
  host = (urllib.parse.urlsplit(url).hostname or "").lower()
  # China's wallet answers in yuan, the international one in dollars. A zero
  # balance is the wallet saying it no longer covers API calls, so the panel
  # can flag it as out of credits, live and from the kept answer.
  return {"remaining": remaining, "currency": "CNY" if host.endswith(".cn") else "USD", "available": remaining > 0}


# Moonshot says what is left, never what was bought, so the balance has no
# funded figure; what was spent is the record's local spend. An amount the
# cache holds is read as untrusted JSON, not as a float.
def money(value: Any) -> float:
  if isinstance(value, bool):
    return 0.0
  try:
    amount = float(value or 0)
  except (TypeError, ValueError):
    return 0.0
  return amount if math.isfinite(amount) else 0.0


def balance_record(remaining: Any, currency: str) -> dict[str, Any]:
  return {
    "remaining": max(0.0, money(remaining)),
    "funded": 0.0,
    "spent": 0.0,
    "currency": str(currency or "USD"),
    "estimated": False,
  }


# One cache per key and endpoint, so a machine signed in to another wallet
# never shows this one's balance.
def balance_cache_path(key: str, api_base_url: str) -> Path:
  return limits_cache_path(AGENT_ID, api_base_url.rstrip("/"), key)


def out_of_credits(result: dict[str, Any], available: Any) -> None:
  # With no funded figure the balance gauge can't raise this alarm itself,
  # so the status does.
  if available is False:
    result.update(usageStatusText="Out of credits", authHelpText=OUT_OF_CREDITS_HELP)


def collect_balance(key: str, api_base_url: str, force: bool) -> dict[str, Any]:
  result: dict[str, Any] = {"balance": None, "stale": False, "fetchedAtMs": 0, "usageStatusText": "", "authHelpText": "", "retryAdvised": False}
  cache = None
  try:
    cache = LimitsCache.at(balance_cache_path(key, api_base_url))
  except OSError as exc:
    warn(f"could not read the balance cache ({exc})")
  kept = obj(cache.data.get("balance")) if cache else {}
  fetched_at = cache.fetched_at if cache else 0

  # A panel opened and closed repeatedly must not become one request per
  # flick, so a recent answer is reused, though a balance has no limit
  # windows; --force skips the wait.
  if kept and cache.fresh(force, allow_empty=True):
    result.update(balance=balance_record(kept.get("remaining"), str(kept.get("currency") or "")), fetchedAtMs=fetched_at)
    out_of_credits(result, kept.get("available"))
    return result

  try:
    live = fetch_balance(api_base_url, key)
  except MoonshotError as error:
    result["retryAdvised"] = error.transport
    result["authHelpText"] = str(error)
    if kept:
      # The last good balance, marked stale with when it was read, beats an
      # empty section while Moonshot can't be asked.
      result.update(balance=balance_record(kept.get("remaining"), str(kept.get("currency") or "")), stale=True, fetchedAtMs=fetched_at)
      out_of_credits(result, kept.get("available"))
      result["authHelpText"] = str(error)
    if error.refused:
      result["usageStatusText"] = "Sign-in expired"
    elif not kept:
      result["usageStatusText"] = "Balance unavailable"
    return result

  balance = {"remaining": str(live["remaining"]), "currency": live["currency"], "available": live.get("available")}
  fetched_at = cache.save([], only_if_newer=True, balance=balance) if cache is not None else now_ms()
  result.update(balance=balance_record(live["remaining"], live["currency"]), fetchedAtMs=fetched_at)
  out_of_credits(result, live.get("available"))
  return result


# ------------------------------------------------------------------ record

# Whether a scan found any Moonshot usage on this machine: a session, or
# tokens no session is known for.
def has_local_stats(stats: dict[str, Any]) -> bool:
  return number(stats.get("totalSessions")) > 0 or bool(stats.get("modelUsage"))


def base_record(stats: dict[str, Any] | None = None) -> dict[str, Any]:
  # Prompt and session counts are real: every pi session message carries
  # them, so today's tooltip may show "N prompts · M sessions".
  record = shared_base_record(AGENT_ID, AGENT_NAME)
  if stats is not None:
    record.update(stats, hasLocalStats=has_local_stats(stats))
  return record


def collect(api_base_url: str, max_age: float, force: bool) -> dict[str, Any]:
  record = base_record(cached_local_stats(max_age))
  record["ready"] = record["hasLocalStats"]

  # Without a key the record carries local stats only, with no plan, so the
  # panel leaves out the balance section, and skips the record altogether on
  # a machine that has never used Moonshot.
  key, default_url = api_key()
  if not key:
    return record
  record.update(ready=True, tierLabel="Prepaid")
  balance = collect_balance(key, api_base_url or default_url, force)
  if balance["balance"] is not None:
    record["balance"] = balance["balance"]
  record.update(
    usageStatusText=balance["usageStatusText"],
    authHelpText=balance["authHelpText"],
    limitsStale=balance["stale"],
    limitsFetchedAt=balance["fetchedAtMs"],
  )
  if balance["retryAdvised"]:
    record["retryAdvised"] = True
  return record


def main() -> int:
  parser = argparse.ArgumentParser(description="Print the Moonshot usage record as JSON")
  # --force rescans everything and asks Moonshot past the reuse window.
  # --limits-only (the panel's quick refresh) may reuse a scan for 15
  # minutes, but asks for the balance like a normal run.
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.add_argument("--api-base-url", default=os.environ.get("MOONSHOT_API_BASE_URL", ""))
  args = parser.parse_args()

  try:
    record = collect(args.api_base_url, scan_max_age(args.force, args.limits_only), args.force)
  except Exception as error:
    # A bug, not a state the panel should explain: an empty record keeps
    # the panel steady, and stderr says what broke.
    record = base_record()
    warn(f"{type(error).__name__}: {error}")
  emit(record)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())

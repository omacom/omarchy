#!/bin/bash

# omarchy:summary=Toggle mirroring theme changes to and from your herdr machines

omarchy-toggle theme-sync-off

if omarchy-toggle-enabled theme-sync-off; then
  omarchy-notification-send -g 󰸌 "Herdr theme sync disabled"
else
  omarchy-notification-send -g 󰸌 "Herdr theme sync enabled"
fi

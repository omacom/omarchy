#!/bin/bash

# omarchy:summary=Configure USB and Thunderbolt protection while locked and unlocked
# omarchy:requires-sudo=true

set -euo pipefail
echo "USB and Thunderbolt protection while locked is on by default. Boot input works normally."
echo "Unlocking automatically allows devices plugged in while locked, in either mode."
echo "A malicious device left connected can therefore attack when you unlock."
echo "Keep an existing keyboard available: a new keyboard cannot unlock the screen."
echo
mode=$(gum choose --label-delimiter $'\t' --header "$(omarchy-i18n deviceProtection.title)" \
  "$(omarchy-i18n deviceProtection.locked)"$'\tlocked' \
  "$(omarchy-i18n deviceProtection.approval)"$'\tapproval') || exit 0
case "$mode" in
  locked | approval) ;;
  *) exit 0 ;;
esac
omarchy-shell lock status >/dev/null
omarchy-pkg-add usbguard
# Start the packaged watcher before enabling the approval mode. A missing UI
# must not leave USBGuard denying new devices without a way to review them.
systemctl --user daemon-reload
systemctl --user enable --now omarchy-usb-lock-watch.service omarchy-thunderbolt-lock-watch.path omarchy-thunderbolt-lock-notify.service
systemctl --user is-active --quiet omarchy-usb-lock-watch.service
sudo /usr/bin/omarchy-usb-lock-admin "$mode"
# Installation may have outlived the unlocked session. Invalidate the shell's
# earlier "off" acknowledgement and wait for its current policy to take effect.
[[ $(omarchy-shell lock refreshUsbPolicy) == "ok" ]]
for (( attempt=0; attempt<40; attempt++ )); do
  if omarchy-shell lock status | jq -e '.usbPolicyApplied == true' >/dev/null; then
    if [[ -e /etc/omarchy/thunderbolt-lock.enabled ]]; then
      echo "USB and Thunderbolt protection is enabled ($mode)."
    else
      echo "USB protection is enabled ($mode). Your independently managed Bolt policy was preserved."
    fi
    exit 0
  fi
  sleep 0.2
done
echo "Device protection is enabled, but the current policy was not confirmed. Check omarchy-usb-lock.service and omarchy-thunderbolt-lock.service." >&2
exit 1

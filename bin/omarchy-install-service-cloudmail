#!/bin/bash

# omarchy:summary=Install Cloudmail and open it.
# omarchy:requires-sudo=true

set -e

echo "Installing Cloudmail..."
# npm runs Cloudflare's wrangler when `cloudmail setup` deploys the mail worker.
omarchy-pkg-add cloudmail npm

echo "Opening Cloudmail..."
setsid uwsm-app -- /usr/bin/cloudmail-gtk >/dev/null 2>&1 &

echo ""
echo "Cloudmail has been installed."
echo "Deploy it to your Cloudflare account with:"
echo "  npx wrangler login && cloudmail setup --mailbox you@yourdomain.com"

#!/bin/bash

# omarchy:summary=Lock the computer and turn off the display
# omarchy:group=system
# omarchy:name=lock
# omarchy:examples=omarchy system lock

warn_unsecured() {
  local msg="$1"
  local localized_msg="${2:-$msg}"
  local title
  title="$(omarchy-i18n lock.sessionUnsecured)"
  echo "omarchy-system-lock: $msg" >&2
  # The shell is the notification server, so a hung shell would hold the D-Bus call for 25s.
  timeout --kill-after=1s 2s omarchy-notification-send -u critical -g 󰌾 \
    "$title" \
    "$localized_msg" 2>/dev/null || \
    hyprctl notify 3 5000 "rgb(ff5555)" "${title}: ${localized_msg}" >/dev/null 2>&1 || true
}

lock_reply=$(omarchy-shell lock lock 2>/dev/null) || {
  warn_unsecured "Failed to contact lock service." "$(omarchy-i18n lock.failedToContact)"
  exit 1
}

case $lock_reply in
  ok)
    ;;
  missing-pam)
    echo "omarchy-system-lock: /etc/pam.d/omarchy-lock-password is missing. Run 'omarchy-apply-lock' to configure it." >&2
    warn_unsecured \
      "Lock screen password PAM service is missing. Run omarchy-apply-lock to configure it." \
      "$(omarchy-i18n lock.missingPam)"
    exit 1
    ;;
  failed)
    warn_unsecured "Lock service refused to lock the session." "$(omarchy-i18n lock.refused)"
    exit 1
    ;;
  *)
    raw_response=${lock_reply:-empty response}
    warn_unsecured \
      "Unexpected response from lock service: $raw_response" \
      "$(omarchy-i18n lock.unexpectedResponse "$raw_response")"
    exit 1
    ;;
esac

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked. Use timeout because `1password --lock` can
# otherwise leave a full Electron helper tree running after each lock.
if pgrep -x "1password" >/dev/null && omarchy-cmd-present 1password; then
  (
    flock -n 9 || exit 0
    timeout --kill-after=1s 3s 1password --lock >/dev/null 2>&1 || true
  ) 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-1password-lock.lock" &
fi

# Avoid running screensaver when locked
screensaver='[/]usr/lib/omarchy-screensaver/omarchy-screensaver'
if pkill -f "$screensaver" 2>/dev/null; then
  timeout 1s pidwait -f "$screensaver" 2>/dev/null || pkill -KILL -f "$screensaver" 2>/dev/null || true
  # It hid the cursor, and a killed or failed exit leaves it hidden.
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1 || hyprctl keyword cursor:invisible false >/dev/null 2>&1 || true
fi

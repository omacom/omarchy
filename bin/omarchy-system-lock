#!/bin/bash

# omarchy:summary=Lock the computer and turn off the display
# omarchy:group=system
# omarchy:name=lock
# omarchy:examples=omarchy system lock

lock_timeout=10

lock_ipc() {
  local limit=$1
  shift

  OMARCHY_SHELL_IPC_TIMEOUT="$limit" omarchy-shell "$@" 2>/dev/null
}

lock_state() {
  jq -r --arg id "$request_id" \
    'if .requestId != $id then "invalid"
     elif .state == "secured" then "secured"
     elif .state == "pending" then "pending"
     elif .state == "failed" then "failed"
     else "invalid" end' \
    <<<"$(lock_ipc 0.5s lock result "$request_id")" 2>/dev/null
}

# The journal gets the reason in English ($1), the notification the user's
# language ($2). The shell is the notification server, so a hung shell gets
# two seconds before the warning goes through Hyprland instead.
report_unsecured() {
  local title
  title=$(omarchy-i18n lock.notConfirmed)
  printf 'omarchy-system-lock: the session lock was not confirmed (%s)\n' "$1" >&2

  timeout --kill-after=1s 2s omarchy-notification-send -u critical -g 󰌾 "$title" "$2" >/dev/null 2>&1 ||
    hyprctl notify 3 5000 "rgb(ff5555)" "$title: $2" >/dev/null 2>&1 || true

  exit 1
}

deadline=$((SECONDS + lock_timeout))
lock_reply=$(lock_ipc 1s lock request)

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked. Use timeout because `1password --lock` can
# otherwise leave a full Electron helper tree running after each lock.
if pgrep -x "1password" >/dev/null && omarchy-cmd-present 1password; then
  (
    flock -n 9 || exit 0
    timeout --kill-after=1s 3s 1password --lock >/dev/null 2>&1 || true
  ) 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-1password-lock.lock" &
fi

# A refused or stalled lock leaves the screensaver up. Cleanup follows the
# request's secured receipt, which survives a legitimate immediate unlock.
close_screensaver() {
  local screensaver='[/]usr/lib/omarchy-screensaver/omarchy-screensaver'
  if pkill -f "$screensaver" 2>/dev/null; then
    timeout 1s pidwait -f "$screensaver" 2>/dev/null || pkill -KILL -f "$screensaver" 2>/dev/null || true
    # It hid the cursor, and a killed or failed exit leaves it hidden.
    hyprctl eval 'hl.config({ cursor = { invisible = false } })' >/dev/null 2>&1 || hyprctl keyword cursor:invisible false >/dev/null 2>&1 || true
  fi
}

if [[ $(jq -r '.reason // empty' <<<"$lock_reply" 2>/dev/null) == "missing-pam" ]]; then
  report_unsecured "no lock screen is configured; run omarchy-apply-lock" "$(omarchy-i18n lock.missingPam)"
fi

request_id=$(jq -er '.requestId | select(type == "string" and length > 0)' <<<"$lock_reply" 2>/dev/null)
if [[ -z $request_id ]]; then
  report_unsecured "the shell could not accept a tracked lock request" "$(omarchy-i18n lock.requestNotAccepted)"
fi

# A status snapshot cannot distinguish never-secured from already-unlocked.
# Wait for this request's immutable outcome, without requesting a second lock.
while (( SECONDS < deadline )); do
  case $(lock_state) in
    secured) close_screensaver; exit 0 ;;
    pending) ;;
    failed) report_unsecured "the lock request ended before securing the session" "$(omarchy-i18n lock.requestEnded)" ;;
    *) report_unsecured "the shell no longer has the tracked lock request" "$(omarchy-i18n lock.requestLost)" ;;
  esac

  sleep 0.1
done

report_unsecured "the shell did not secure the session within ${lock_timeout}s" "$(omarchy-i18n lock.notSecuredTimeout "$lock_timeout")"

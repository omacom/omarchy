#!/bin/bash

# omarchy:summary=Focus a Hyprland window by application identity
# omarchy:args=[--active-workspace] <app-name>
# omarchy:examples=omarchy hyprland focus app Slack | omarchy hyprland focus app --active-workspace Slack

usage() {
  echo "Usage: omarchy-hyprland-focus-app [--active-workspace] <app-name>" >&2
  exit 1
}

# With --active-workspace only windows on the current workspace are considered,
# so the call never switches workspaces.
workspace=""
if [[ ${1:-} == "--active-workspace" ]]; then
  shift
  workspace=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty')
  [[ -n $workspace ]] || exit 1
fi

app=${1:-}
[[ -n $app ]] || usage

# Agent terminals notify as kitty/foot/etc. while their shared window class is
# org.omarchy.agent, leaving the terminal name only in initialTitle. So match
# by class first, then fall back to the launch-time title of agent windows.
# Among several matches take the one focused last, which is also the window a
# browser hands a new tab to.
address=$(
  hyprctl clients -j 2>/dev/null |
    jq -r --arg pattern "$app" --arg workspace "$workspace" \
      'def matches($value): ($value // "") | test($pattern; "i");
       map(select($workspace == "" or (.workspace.id | tostring) == $workspace)) |
       sort_by(.focusHistoryID) |
       first(
         (.[] | select(matches(.class))),
         (.[] | select(.initialClass == "org.omarchy.agent" and matches(.initialTitle)))
       ).address // empty'
)

[[ -n $address ]] || exit 1

hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || \
  hyprctl dispatch focuswindow "address:$address" >/dev/null

#!/bin/bash

# omarchy:summary=Enable, disable, toggle, or recover the internal laptop display
# omarchy:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/$TOGGLE.lua"
MIRROR_TOGGLE="internal-monitor-mirror"

INTERNAL=$(omarchy-hyprland-monitor-laptop)

wake() {
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
}

on() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.laptopEnabled)"
  fi

  wake
}

off() {
  if [[ -z $INTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.noLaptopDisplay)"
    exit 1
  fi

  # The name is written into generated Lua below, so only a plain connector
  # name may pass; anything else could execute on the next reload.
  if [[ ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.unsafeName)"
    exit 1
  fi

  if ! omarchy-hyprland-monitor-external-active; then
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.onlyDisplay)"
    exit 1
  fi

  if omarchy-hyprland-toggle-disabled $TOGGLE && omarchy-hyprland-toggle-disabled $MIRROR_TOGGLE; then
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$INTERNAL" >"$TOGGLE_FLAG"
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.laptopDisabled)"
    hyprctl reload
  fi
}

recover() {
  # Runs from the clamshell watcher every few seconds, so it must be a no-op
  # unless it actually re-enables a display: an unconditional wake here undoes
  # lock-screen blanking and races the resume modeset into a visible flash.
  #
  # external-active is tri-state: only its contracted false (1) authorizes a
  # recovery. A failed or timed-out query is unknown, not evidence that the
  # external display disappeared.
  omarchy-hyprland-monitor-external-active
  case $? in
    0) return 0 ;;
    1) ;;
    *) return 0 ;;
  esac

  omarchy-hyprland-toggle-enabled $TOGGLE || return 0

  # Do not let the best-effort wake mask a failed toggle removal. The
  # clamshell caller treats a nonzero recovery as "stop before the next state
  # transition", so preserving this status is part of its transaction boundary.
  omarchy-hyprland-toggle $TOGGLE off || return 1
  wake
}

toggle() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    on
  else
    off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac

#!/bin/bash

# omarchy:summary=Enable, disable, toggle, or recover the internal laptop display
# omarchy:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/$TOGGLE.lua"
MIRROR_TOGGLE="internal-monitor-mirror"
BACKLIGHT_STATE="$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-backlight"

set -o pipefail
BLANK_STATE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.saved"
exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"
flock "$lock_fd"

wake() {
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
}

# Some backlight drivers remain lit when the output is disabled. Keep a
# recoverable level, including when the lock screen has already blanked it.
dim_backlight() {
  local device level
  device="$(omarchy-hw-display)" 2>/dev/null || return 0
  if [[ ! -s $BACKLIGHT_STATE ]]; then
    if [[ -s $BLANK_STATE ]]; then
      level=$(<"$BLANK_STATE")
    else
      level=$(brightnessctl -d "$device" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4 }') || level=""
    fi
    if [[ $level =~ ^[0-9]+$ ]]; then
      mkdir -p "$(dirname "$BACKLIGHT_STATE")"
      printf '%s\n' "$level" >"$BACKLIGHT_STATE"
    fi
  fi
  if [[ -s $BACKLIGHT_STATE ]]; then
    brightnessctl -d "$device" set 0 >/dev/null 2>&1
  fi
}

restore_backlight() {
  local device saved="$BACKLIGHT_STATE"
  [[ -s $saved ]] || saved="$BLANK_STATE"
  [[ -s $saved ]] || return 0
  device="$(omarchy-hw-display)" 2>/dev/null || return 0
  if brightnessctl -d "$device" set "$(<"$saved")%" >/dev/null 2>&1; then
    rm -f "$BACKLIGHT_STATE" "$BLANK_STATE"
  fi
}

on() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
    omarchy-notification-send -g 󰍹 "Laptop display enabled"
  fi

  restore_backlight
  wake
}

off() {
  local INTERNAL
  INTERNAL=$(omarchy-hyprland-monitor-laptop)
  if [[ -z $INTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "No laptop display found"
    exit 1
  fi

  # The name is written into generated Lua below, so only a plain connector
  # name may pass; anything else could execute on the next reload.
  if [[ ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
    omarchy-notification-send -g 󰍹 "Refusing unsafe monitor name"
    exit 1
  fi

  if ! omarchy-hyprland-monitor-external-active; then
    omarchy-notification-send -g 󰍹 "Can't disable the only active display"
    exit 1
  fi

  if omarchy-hyprland-toggle-disabled $TOGGLE && omarchy-hyprland-toggle-disabled $MIRROR_TOGGLE; then
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$INTERNAL" >"$TOGGLE_FLAG"
    omarchy-notification-send -g 󰍹 "Laptop display disabled"
    hyprctl reload
    dim_backlight
  fi
}

recover() {
  # Runs from the clamshell watcher every few seconds, so it must be a no-op
  # unless it actually re-enables a display: an unconditional wake here undoes
  # lock-screen blanking and races the resume modeset into a visible flash.
  omarchy-hyprland-monitor-external-active && return 0
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
  elif [[ ! -s $BACKLIGHT_STATE ]]; then
    return 0
  fi
  restore_backlight
  wake
}

toggle() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    on
  else
    off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  restore-backlight) restore_backlight ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac

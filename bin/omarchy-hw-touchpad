#!/bin/bash

# omarchy:summary=Print the detected Hyprland touchpad or trackpad device name

devices_json=$(hyprctl devices -j)
mice=$(jq -r '.mice[].name' <<<"$devices_json")
mapfile -t mouse_devices <<<"$mice"
mapfile -t devices < <(grep -iE 'touchpad|trackpad' <<<"$mice")

# Prefer a known internal pad when an external trackpad is also connected.
# Keep the existing fallback for external-only pads and unknown hardware.
if (( ${#mouse_devices[@]} > 1 )); then
  mapfile -t all_names < <(jq -r '.. | objects | .name? // empty' <<<"$devices_json")
  declare -A candidates=() seen=() duplicates=() internal=()
  for device in "${mouse_devices[@]}"; do
    candidates["$device"]=1
  done
  input_class_path="${OMARCHY_INPUT_CLASS_PATH:-/sys/class/input}"
  shopt -s nullglob

  for event in "$input_class_path"/event*; do
    # An incomplete name inventory could hide an external namesake.
    if ! name=$(cat "$event/device/name" 2>/dev/null) || [[ -z $name ]]; then
      internal=()
      break
    fi
    # Match Hyprland's lowercasing and space/comma/newline replacement.
    name=$(LC_ALL=C tr '[:upper:]' '[:lower:]' <<<"$name")
    name=${name// /-}
    name=${name//,/-}
    name=${name//$'\n'/-}
    if [[ -n ${seen[$name]:-} ]]; then
      duplicates["$name"]=1
    fi
    seen["$name"]=1

    # Include pads without touchpad/trackpad in their names, but only query
    # udev for names the compositor actually reports as mice.
    [[ -n ${candidates[$name]:-} ]] || continue
    properties=$(udevadm info --query=property --path="$event" 2>/dev/null) || continue
    if grep -qx 'ID_INPUT_TOUCHPAD=1' <<<"$properties" &&
      grep -qx 'ID_INPUT_TOUCHPAD_INTEGRATION=internal' <<<"$properties" &&
      ! grep -qx 'ID_INPUT_POINTINGSTICK=1' <<<"$properties"; then
      internal["$name"]=1
    fi
  done

  preferred=()
  for device in "${mouse_devices[@]}"; do
    # Hyprland suffixes colliding names across HID classes. Without event
    # paths in its JSON, a suffixed or duplicate name cannot identify a pad.
    ambiguous=false
    for other in "${all_names[@]}"; do
      if [[ $other == "$device"-* && ${other#"$device"-} =~ ^[0-9]+$ ]]; then
        ambiguous=true
        break
      fi
    done
    if [[ -n ${internal[$device]:-} && -z ${duplicates[$device]:-} && ! $device =~ -[0-9]+$ && $ambiguous == "false" ]]; then
      preferred+=("$device")
    fi
  done
  if (( ${#preferred[@]} == 1 )); then
    printf '%s\n' "${preferred[0]}"
    exit 0
  fi
fi

device=${devices[0]:-}

# Some touchpads carry neither word (Apple Silicon's is "apple-mtp-multi-touch"),
# so ask udev which mouse is one. The name alone can't say: some touchscreens'
# mouse interfaces are called multi-touch too.
if [[ -z $device ]]; then
  input_class="${OMARCHY_INPUT_CLASS_PATH:-/sys/class/input}"
  for event in "$input_class"/event*; do
    [[ -r $event/device/name ]] || continue
    # Hyprland's name for a device: the kernel's, lowercased, with spaces,
    # commas and newlines as dashes, and -1, -2 and so on after a name another
    # device already took.
    name=$(<"$event/device/name")
    name=${name,,}
    name=${name//[ ,$'\n']/-}
    # Match the name first: udevadm is a fork per device, and a desktop with no
    # touchpad would otherwise pay it for every keyboard, button and switch on
    # each menu open.
    match=""
    while IFS= read -r mouse; do
      if [[ $mouse == "$name" || ( $mouse == "$name"-* && ${mouse#"$name"-} =~ ^[0-9]+$ ) ]]; then
        match=$mouse
        break
      fi
    done <<<"$mice"
    [[ -n $match ]] || continue
    udevadm info --query=property "$event" 2>/dev/null | grep -Fxq 'ID_INPUT_TOUCHPAD=1' || continue
    device=$match
    break
  done
fi

[[ -n $device ]] && echo "$device"

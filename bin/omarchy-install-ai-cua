#!/bin/bash

# omarchy:summary=Install Cua Driver, its agent skills, and the Cua Hyprland plugin
# omarchy:requires-sudo=true

set -euo pipefail

if (( EUID == 0 )); then
  echo "Run this command as your desktop user, without sudo." >&2
  exit 1
fi

echo "Installing Cua Driver..."
omarchy-pkg-add cua-driver-bin

# The driver takes its native Wayland backend only when this reaches the
# process serving the calls. default/hypr/envs.lua exports it at login once the
# driver is installed; this hands it to the session already running.
systemctl --user set-environment CUA_DRIVER_RS_ENABLE_WAYLAND=1 2>/dev/null || true
dbus-update-activation-environment CUA_DRIVER_RS_ENABLE_WAYLAND=1 2>/dev/null || true

# The skill pack is what teaches an agent the driver's snapshot-then-act loop:
# the driver fetches the release matching its own version and links it into
# every agent skills directory that exists, and Omarchy's companion adds the
# package and Hyprland specifics upstream cannot know. A skill is read into
# every session of every agent on the machine, so it is offered rather than
# imposed. Without a terminal to ask in, the driver alone is the answer.
skills_installed=false
if [[ -t 0 ]]; then
  echo ""
  echo "Cua ships skills that teach Claude Code, Codex, Hermes, and the other"
  echo "agents on this machine how to drive apps through the driver."
  if gum confirm "Install the Cua agent skills?"; then
    echo "Installing the Cua agent skills..."
    if cua-driver skills install; then
      omarchy-agent-skill-link "$OMARCHY_PATH/default/agents/optional-skills/cua-omarchy"
      skills_installed=true
    else
      echo "The Cua skills did not install. Run 'cua-driver skills install' later to try again." >&2
    fi
  fi
fi

# The Hyprland plugin gives the driver a compositor route for input. It pins
# the exact Hyprland build it was compiled against, so it can be absent from
# the channel or pinned to a build other than the one installed (edge moves
# first), and neither undoes the driver install above. The pin is compared
# here, not left to pacman, which meets it by swapping the installed Hyprland
# for whichever build another repository carries. Installing the plugin loads
# nothing: activation is a deliberate step, omarchy-toggle-cua-input, because
# it enables compositor input.
plugin_installed=false
installed="hyprland=$(pacman -Q hyprland | cut -d' ' -f2)"
# The first record is the repository pacman installs from, and C keeps the field name it is found by.
plugin_info=$(LC_ALL=C pacman -Si cua-hyprland-plugin 2>/dev/null || true)
pinned=$(awk '/^Depends On/ { for (i = 4; i <= NF; i++) if ($i ~ /^hyprland=/) print $i; exit }' <<<"$plugin_info")
echo ""
if [[ -z $plugin_info ]]; then
  echo "The Cua Hyprland plugin is not available in your package channel; Cua Driver works without it."
elif [[ $pinned != "$installed" ]]; then
  echo "The Cua Hyprland plugin is built for ${pinned:-another Hyprland build} and this machine has $installed; skipping it. Cua Driver works without it."
else
  echo "Installing the Cua Hyprland plugin..."
  if omarchy-pkg-add cua-hyprland-plugin; then
    plugin_installed=true
  else
    echo "The Cua Hyprland plugin did not install. Cua Driver works without it." >&2
  fi
fi

echo ""
echo "Cua Driver has been installed."
if [[ $skills_installed == true ]]; then
  echo "Agents pick up the Cua skills in their next session."
fi
if [[ $plugin_installed == true ]]; then
  echo "Trigger > Toggle > Cua Input enables the plugin without changing your keyboard settings."
  echo "After a plugin update, log out and back in before enabling it. The plugin pins the exact"
  echo "Hyprland build, so an update that moves Hyprland waits for the matching plugin build."
fi

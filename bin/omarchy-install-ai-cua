#!/bin/bash

# omarchy:summary=Install Cua Driver, its agent skills, and the Cua Hyprland plugin
# omarchy:requires-sudo=true

set -euo pipefail

if (( EUID == 0 )); then
  echo "Run this command as your desktop user, without sudo." >&2
  exit 1
fi

echo "Installing Cua Driver..."
omarchy-pkg-add cua-driver-bin

# The driver takes its native Wayland backend only when this reaches the
# process serving the calls. default/hypr/envs.lua exports it at login once the
# driver is installed; this sets it in the Hyprland already running, which is
# where a terminal opened from a keybinding gets its environment. Nothing is
# written to systemd's user manager: a variable set there outlives the session
# and the driver's removal whenever the manager does.
hyprctl eval 'hl.env("CUA_DRIVER_RS_ENABLE_WAYLAND", "1")' &>/dev/null || true

# The skill pack is what teaches an agent the driver's snapshot-then-act loop:
# the driver fetches the release matching its own version and links it into
# every agent skills directory that exists, and Omarchy's companion adds the
# package and Hyprland specifics upstream cannot know. A skill is read into
# every session of every agent on the machine, so it is offered rather than
# imposed. Without a terminal to ask in, the driver alone is the answer.
skills_installed=false
if [[ -t 0 ]]; then
  echo ""
  echo "Cua ships skills that teach Claude Code, Codex, Hermes, and the other"
  echo "agents on this machine how to drive apps through the driver."
  if gum confirm "Install the Cua agent skills?"; then
    echo "Installing the Cua agent skills..."
    if cua-driver skills install; then
      omarchy-agent-skill-link "$OMARCHY_PATH/default/agents/optional-skills/cua-omarchy"
      skills_installed=true
    else
      echo "The Cua skills did not install. Run 'cua-driver skills install' later to try again." >&2
    fi
  fi
fi

# The Hyprland plugin gives the driver a compositor route for input. It can be
# absent from the channel, or a build of it can need a Hyprland other than the
# one installed, and neither undoes the driver install above. Whether the
# installed Hyprland meets that dependency is asked here, not left to the
# install, where pacman meets it by swapping the installed Hyprland for
# whichever build another repository carries. A plugin that names no version
# changes nothing and is checked against Hyprland when it is loaded. Installing
# the plugin loads nothing: activation is a deliberate step,
# omarchy-toggle-cua-input, because it enables compositor input.
plugin_installed=false
# The first record is the repository pacman installs from. C keeps the field name
# it is found by, and without COLUMNS pacman leaves the field on one line.
plugin_info=$(env -u COLUMNS LC_ALL=C pacman -Si cua-hyprland-plugin 2>/dev/null || true)
mapfile -t needs < <(awk '/^Depends On/ { for (i = 4; i <= NF; i++) if ($i ~ /^hyprland([<>=]|$)/) print $i; exit }' <<<"$plugin_info")
echo ""
if [[ -z $plugin_info ]]; then
  echo "The Cua Hyprland plugin is not available in your package channel; Cua Driver works without it."
elif (( ${#needs[@]} > 0 )) && ! pacman -T "${needs[@]}" >/dev/null; then
  echo "The Cua Hyprland plugin needs ${needs[*]} and this machine has hyprland=$(pacman -Q hyprland | cut -d' ' -f2); skipping it. Cua Driver works without it."
else
  echo "Installing the Cua Hyprland plugin..."
  if omarchy-pkg-add cua-hyprland-plugin; then
    plugin_installed=true
  else
    echo "The Cua Hyprland plugin did not install. Cua Driver works without it." >&2
  fi
fi

echo ""
echo "Cua Driver has been installed. A terminal opened with its keybinding carries the driver's"
echo "Wayland setting from now on; everything else picks it up at the next login."
if [[ $skills_installed == "true" ]]; then
  echo "Agents pick up the Cua skills in their next session."
fi
if [[ $plugin_installed == "true" ]]; then
  echo "Trigger > Toggle > Cua Input enables the plugin without changing your keyboard settings."
  echo "After a plugin update, log out and back in before enabling it. The plugin works only with"
  echo "the Hyprland build it was made for, so after a Hyprland update Cua Input waits for its matching build."
fi

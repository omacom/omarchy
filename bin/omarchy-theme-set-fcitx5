#!/bin/bash

# omarchy:summary=Sync the generated Omarchy theme to the fcitx5 candidate window
# omarchy:hidden=true

set -euo pipefail

THEME_SOURCE="$HOME/.local/state/omarchy/current/theme/fcitx5-theme.conf"
THEME_DIR="$HOME/.local/share/fcitx5/themes/omarchy"
CLASSICUI_CONF="$HOME/.config/fcitx5/conf/classicui.conf"
PACKAGED_THEME="${OMARCHY_FCITX5_PACKAGED_THEME:-/usr/share/fcitx5/themes/default-dark}"

classicui_value() {
  if [[ -f $CLASSICUI_CONF ]]; then
    sed -n "s|^$1=||p" "$CLASSICUI_CONF" | tail -n 1
  fi
}

# Only take a key that is unset, already ours, or still on a theme fcitx5 ships:
# anything else is a theme the user picked, and theirs to keep.
omarchy_may_set() {
  local value
  value=$(classicui_value "$1")

  [[ -z $value || $value == "omarchy" || $value == "default" || $value == "default-dark" ]]
}

set_classicui_key() {
  local key="$1"
  local value="$2"

  if grep -q "^$key=" "$CLASSICUI_CONF"; then
    sed -i "s|^$key=.*|$key=$value|" "$CLASSICUI_CONF"
  else
    printf '%s=%s\n' "$key" "$value" >>"$CLASSICUI_CONF"
  fi
}

# classicui caches theme images, so a running fcitx5 keeps the old colors until
# its addon config is reloaded. Nothing to reload when fcitx5 is not running.
reload_classicui() {
  busctl --user call org.fcitx.Fcitx5 /controller org.fcitx.Fcitx.Controller1 \
    ReloadAddonConfig s classicui >/dev/null 2>&1 || true
}

if [[ -f $THEME_SOURCE ]]; then
  mkdir -p "$THEME_DIR"

  # fcitx5 resolves the page-button and radio Image= entries relative to the
  # theme directory, so a generated theme needs its own copies. They are
  # monochrome glyphs that suit any palette, and ship as SVG in fcitx5 5.1 and
  # PNG before it.
  for asset in "$PACKAGED_THEME"/*.svg "$PACKAGED_THEME"/*.png; do
    if [[ -f $asset ]]; then
      cp -f "$asset" "$THEME_DIR/"
    fi
  done

  theme_tmp=$(mktemp "$THEME_DIR/theme.conf.XXXXXX")
  cp "$THEME_SOURCE" "$theme_tmp"

  # The template names the SVG glyphs; follow a fcitx5 that only ships PNG.
  for glyph in prev next radio arrow; do
    if [[ ! -f $THEME_DIR/$glyph.svg && -f $THEME_DIR/$glyph.png ]]; then
      sed -i "s|^Image=$glyph\.svg$|Image=$glyph.png|" "$theme_tmp"
    fi
  done

  mv "$theme_tmp" "$THEME_DIR/theme.conf"

  # Point classicui at the theme without rewriting the file: font, candidate
  # layout and tray settings stay the user's. DarkTheme is what classicui picks
  # when the user follows the system color scheme, so both keys have to point at
  # the generated theme for the popup to track light and dark Omarchy themes.
  mkdir -p "$(dirname "$CLASSICUI_CONF")"
  touch "$CLASSICUI_CONF"

  for key in Theme DarkTheme; do
    if omarchy_may_set "$key"; then
      set_classicui_key "$key" omarchy
    fi
  done

  reload_classicui
else
  # A theme without a palette generates nothing, and leaving classicui on the
  # previous theme's colors would be wrong for it. Hand the popup back to fcitx5.
  released=false
  for key in Theme DarkTheme; do
    if [[ $(classicui_value "$key") == "omarchy" ]]; then
      sed -i "/^$key=omarchy$/d" "$CLASSICUI_CONF"
      released=true
    fi
  done

  if [[ $released == "true" ]]; then
    reload_classicui
  fi
fi

#!/bin/bash

# omarchy:summary=Reset the trackpad by unbinding and rebinding its driver.
# omarchy:requires-sudo=true

# Only reset I2C devices that udev marks as a touchpad, so the keyboard and
# touchscreen sharing the i2c_hid_acpi driver are left alone. elan_i2c registers
# its input device on the I2C device itself; HID over I2C one level down.
is_touchpad() {
  local input

  for input in "$1"/input/input* "$1"/*/input/input*; do
    if udevadm info --query=property "$input" 2>/dev/null | grep -qx "ID_INPUT_TOUCHPAD=1"; then
      return 0
    fi
  done

  return 1
}

echo "Releasing the trackpad in Hyprland..."
omarchy-toggle-input-device touchpad cycle

drivers="${OMARCHY_I2C_DRIVERS_PATH:-/sys/bus/i2c/drivers}"

# A touchpad sits behind whichever I2C driver claimed it: i2c_hid_acpi for HID
# over I2C, elan_i2c for ELAN's own protocol (common on ASUS laptops). ACPI
# devices are named i2c-<name>; others, like an ELAN SMBus companion, are named
# <bus>-<addr> (0-0015). The driver's own bind, unbind, and uevent entries have
# no dash.
for driver in i2c_hid_acpi elan_i2c; do
  for dev in "$drivers/$driver"/*-*; do
    [[ -e $dev ]] || continue
    is_touchpad "$dev" || continue

    I2C_DEVICE=$(basename "$dev")
    echo "Resetting $I2C_DEVICE via $driver unbind/rebind..."
    echo "$I2C_DEVICE" | sudo tee "$drivers/$driver/unbind" > /dev/null
    sleep 1
    echo "$I2C_DEVICE" | sudo tee "$drivers/$driver/bind" > /dev/null
    echo "Done"
  done
done

# Also try THC path
if lsmod | grep -q intel_quicki2c; then
  echo "Reloading intel_quicki2c..."
  sudo modprobe -r intel_quicki2c && sudo modprobe intel_quicki2c
fi

#!/bin/bash

# omarchy:summary=Disable the OpenSSH server, remove standard firewall rules, and optionally remove authorized keys
# omarchy:requires-sudo=true

set -e

# Under sudo or pkexec $HOME is root's, so resolve the invoking user's home
# before judging their authorized keys (same derivation as omarchy-apply-lock).
target_user=${OMARCHY_INSTALL_USER:-${SUDO_USER:-}}
if [[ -z $target_user && -n ${PKEXEC_UID:-} ]]; then
  target_user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1) || true
  [[ -n $target_user ]] || target_user="uid $PKEXEC_UID"
fi
target_user=${target_user:-$USER}
target_home=$HOME
if [[ $target_user != "$USER" ]]; then
  target_home=$(getent passwd "$target_user" | cut -d: -f6) || true
fi

# An unresolved user must not fall back to root's keys; the server still goes down.
AUTHORIZED_KEYS=""
if [[ -n $target_home ]]; then
  AUTHORIZED_KEYS="$target_home/.ssh/authorized_keys"
fi

echo -e "\e[32mRemoving SSH server access.\n\e[0m"

echo "Stopping and disabling the OpenSSH server..."
sudo systemctl disable --now sshd.service 2>/dev/null || true

if omarchy-cmd-present ufw; then
  echo "Removing standard SSH firewall rules..."
  sudo ufw --force delete limit 22/tcp >/dev/null
  sudo ufw --force delete allow 22/tcp >/dev/null
  sudo ufw --force delete allow ssh >/dev/null
  sudo ufw --force delete limit ssh >/dev/null
  sudo ufw --force delete allow to any app SSH >/dev/null
  sudo ufw --force delete limit to any app SSH >/dev/null
  sudo ufw reload >/dev/null
  echo "Standard SSH firewall rules removed. Review custom firewall rules separately."
fi

if [[ -z $AUTHORIZED_KEYS ]]; then
  echo
  echo "Could not find the home of $target_user, so its authorized SSH keys were left alone."
elif [[ -s $AUTHORIZED_KEYS ]]; then
  echo
  if gum confirm --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n sshd.removeAuthorizedKeys "$AUTHORIZED_KEYS")"; then
    rm -f "$AUTHORIZED_KEYS"
    echo "Authorized keys removed."
  else
    echo "Keeping authorized keys."
  fi
fi

echo -e "\e[32m\nThe SSH server has been disabled.\e[0m"
echo "The openssh package remains installed since it also provides the ssh client."

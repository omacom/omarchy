#!/bin/bash

# omarchy:summary=Print monitor panel state for the shell
# omarchy:group=monitor

monitors_json=$(hyprctl monitors all -j)
focused_monitor=$(printf '%s\n' "$monitors_json" | jq -r '[.[] | select(.focused == true)][0].name // ""')

{ omarchy-brightness-display --monitor "$focused_monitor" 2>/dev/null; echo; } | head -n 1

printf '%s\n' "$monitors_json" | jq -r '
  def internal: test("^(eDP|LVDS|DSI)-");
  ([.[] | select(.name | internal)][0].name // ""),
  ([.[] | select((.name | internal) | not)][0].name // ""),
  ([.[] | select((.name | internal) and .disabled != true)][0].name // ""),
  ([.[] | select(.mirrorOf != "none") | if (.name | internal) then .mirrorOf else .name end][0] // "")
'

printf '%s\n' "$focused_monitor"
omarchy-hyprland-monitor-scaling 2>/dev/null || echo

printf '%s\n' "$monitors_json" | jq -c \
  '[.[] | {name, enabled:(.disabled != true), focused:(.focused == true), width, height}]'

# Refresh rate is reported for the focused monitor only, like scaling above.
# Delegated rather than derived from $monitors_json so the rate normalization
# and mode filtering live in one place.
#
# Each answers with exactly one line whatever the helper does, like brightness
# above. `|| echo` is not enough here: a helper that succeeds with nothing to
# say, or a jq that exits 0 on empty input, would drop the line unnoticed.
{ omarchy-hyprland-monitor-refresh-rate 2>/dev/null; echo; } | head -n 1
omarchy-hyprland-monitor-refresh-rate list 2>/dev/null |
  jq -R -s -c 'split("\n") | map(select(length > 0))'
{ omarchy-hyprland-monitor-refresh-rate pending 2>/dev/null | jq -c . 2>/dev/null
  echo '{"pending":false,"secondsLeft":0}'; } | head -n 1

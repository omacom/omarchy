#!/bin/bash

# omarchy:summary=Print monitor panel state for the shell
# omarchy:group=monitor

# Hyprland reports `mirrorOf` as the mirrored monitor's id, so name it here
# for everything below and for the panel.
monitors_json=$(hyprctl monitors all -j | jq '
  (map({key: (.id | tostring), value: .name}) | from_entries) as $names
  | map(.mirrorOf = (if (.mirrorOf // "none") == "none" then "none" else ($names[.mirrorOf | tostring] // .mirrorOf) end))
')
focused_monitor=$(printf '%s\n' "$monitors_json" | jq -r '[.[] | select(.focused == true)][0].name // ""')
# A user-created headless output can carry a newline in its name. The panel
# reads this output by line index, so it gets a folded copy while the raw name
# stays for the brightness lookup below.
focused_line=$(printf '%s\n' "$monitors_json" | jq -r 'def folded: gsub("[[:cntrl:]]"; " "); (([.[] | select(.focused == true)][0].name // "") | folded)')

# Read every enabled display's brightness at once: a DDC read takes a moment
# per monitor, so one after another they'd add up.
brightness_dir=$(mktemp -d)
trap 'rm -rf "$brightness_dir"' EXIT
while read -r name; do
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || continue
  { omarchy-brightness-display --monitor "$name" 2>/dev/null; echo; } | head -n 1 >"$brightness_dir/$name" &
done < <(printf '%s\n' "$monitors_json" | jq -r '.[] | select(.disabled != true) | .name')
wait

if [[ -n $focused_monitor && -f $brightness_dir/$focused_monitor ]]; then
  cat "$brightness_dir/$focused_monitor"
else
  echo
fi

# One line per field: a name with a newline in it would push every field below
# it one slot early, so read each name from its JSON field and fold control
# characters into spaces.
printf '%s\n' "$monitors_json" | jq -r '
  def internal: test("^(eDP|LVDS|DSI)-");
  def folded: gsub("[[:cntrl:]]"; " ");
  (([.[] | select(.name | internal)][0].name // "") | folded),
  (([.[] | select((.name | internal) | not)][0].name // "") | folded),
  (([.[] | select((.name | internal) and .disabled != true)][0].name // "") | folded),
  (([.[] | select(.mirrorOf != "none") | if (.name | internal) then .mirrorOf else .name end][0] // "") | folded)
'

printf '%s\n' "$focused_line"
omarchy-hyprland-monitor-scaling 2>/dev/null || echo

brightness_json=$(for file in "$brightness_dir"/*; do
  [[ -f $file ]] && printf '%s\t%s\n' "${file##*/}" "$(<"$file")"
done | jq -R -n '[inputs | split("\t") | select(.[1] | test("^[0-9]+$")) | {(.[0]): (.[1] | tonumber)}] | add // {}')

printf '%s\n' "$monitors_json" | jq -c --argjson brightness "$brightness_json" \
  '[.[] | {name, make, model, enabled:(.disabled != true), focused:(.focused == true), width, height, refreshRate, scale, x, y, transform, mirrorOf, availableModes:(.availableModes // []), brightness:($brightness[.name] // null)}]'

# Whether the mirror is Omarchy's own, which the panel can turn back off.
if omarchy-hyprland-toggle-enabled internal-monitor-mirror; then
  echo on
else
  echo
fi

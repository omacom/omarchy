#!/bin/bash

# omarchy:summary=Prompt for sudo once and keep the credential alive in the background.
# omarchy:requires-sudo=true

# Callers source this, so exiting here also stops them: a password prompt the
# user cancelled with Ctrl+C must not go on to install anything.
if sudo -v; then
  while true; do sudo -n true; sleep 60; done 2>/dev/null &
  SUDO_KEEPALIVE_PID=$!
  trap "kill $SUDO_KEEPALIVE_PID 2>/dev/null" EXIT
else
  exit 1
fi

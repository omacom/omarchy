#!/bin/bash

# omarchy:summary=Take a screenshot
# omarchy:group=capture
# omarchy:args=[smart|region|windows|fullscreen|scroll] [copy|save] [--delay=<seconds>]
# omarchy:examples=omarchy screenshot | omarchy capture screenshot region | omarchy capture screenshot --delay=5
# omarchy:aliases=omarchy screenshot

if [[ -n ${OMARCHY_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$OMARCHY_SCREENSHOT_DIR"
fi

delay=0
omasnap_args=()
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    --delay=*) delay="${arg#--delay=}" ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

if [[ ! $delay =~ ^[0-9]+$ ]]; then
  echo "Invalid delay: $delay (expected whole seconds)" >&2
  exit 2
fi

# Count down on the OSD so a hover state or an open menu can be set up before
# Omasnap freezes the focused monitor. The OSD only picks its monitor when it
# opens, so reopen it when focus moves to keep it on the monitor Omasnap will
# capture, and close it a moment before the capture to keep it out of the shot.
countdown_monitor=""
for (( remaining = delay; remaining > 0; remaining-- )); do
  focused_monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused).name')
  if [[ $focused_monitor != "$countdown_monitor" ]]; then
    omarchy-shell -q osd close
    countdown_monitor=$focused_monitor
  fi

  omarchy-osd -i 󱎫 -m "Screenshot in $remaining" -d 0
  sleep 1
done

if (( delay > 0 )); then
  omarchy-shell -q osd close
  sleep 0.1
fi

exec omasnap "${omasnap_args[@]}"

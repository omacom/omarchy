#!/bin/bash

# omarchy:summary=Create a new AI compartment (thin fork of Whonix-AI)
# omarchy:args=<name>
# omarchy:examples=omarchy compartment mk research | omarchy compartment mk trading

set -euo pipefail
NAME="${1:?usage: omarchy compartment mk <name>}"
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
exec sudo bash "$ROOT/scripts/mk-ai-vm.sh" "$NAME"

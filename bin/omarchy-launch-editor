#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults.
# omarchy:args=[--inline] <path>

default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

# sublime-text-4 ships `subl` on PATH, not `sublime_text`.
[[ $editor == sublime_text ]] && editor=subl

omarchy-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec omarchy-launch-tui "$editor" -- "$@"
  fi
  ;;
*)
  # GUI editors hand the file to a running instance and exit immediately unless
  # given a wait flag. --inline is the contract that the caller blocks until the
  # file is closed, so map the common ones and keep the launcher waiting.
  wait_flag=()
  setsid_flag=()
  if [[ $inline == "true" ]]; then
    setsid_flag=(-w)
    case "${editor##*/}" in
      code | code-insiders | codium | cursor | windsurf | zed | zeditor)
        wait_flag=(--wait)
        ;;
      subl | sublime_text)
        wait_flag=(-w)
        ;;
      gnome-text-editor | gedit)
        wait_flag=(--wait)
        ;;
    esac
  fi
  exec setsid "${setsid_flag[@]}" uwsm-app -- "$editor" "${wait_flag[@]}" -- "$@"
  ;;
esac

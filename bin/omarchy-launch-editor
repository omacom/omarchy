#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults.
# omarchy:args=[--inline] <path>

default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

# sublime-text-4 ships `subl` on PATH, not `sublime_text`.
[[ $editor == sublime_text ]] && editor=subl

omarchy-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec omarchy-launch-tui "$editor" -- "$@"
  fi
  ;;
Air | clion | datagrip | goland | intellij-idea-ultimate-edition | phpstorm | pycharm | rider | jetbrains-rubymine | rustrover | webstorm)
  # JetBrains treats `--` as a file to open. Absolute paths keep operands
  # beginning with a dash from being interpreted as IDE options.
  paths=()
  for path in "$@"; do
    if [[ $path == /* ]]; then
      paths+=("$path")
    else
      paths+=("$PWD/$path")
    fi
  done
  exec setsid uwsm-app -- "$editor" "${paths[@]}"
  ;;
*)
  exec setsid uwsm-app -- "$editor" -- "$@"
  ;;
esac

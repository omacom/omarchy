#!/usr/bin/python3
# omarchy:summary=Print the self-hosted model usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect self-hosted model usage into one display-ready JSON record.

Every other collector answers "what did this subscription cost me". This one
answers the question none of them can: how much work ran on hardware you own.
It counts the turns the subscription collectors deliberately skip — Codex CLI
pointed at Ollama, opencode on a local gateway, pi on llama.cpp — whether the
endpoint is this machine or a box down the hall.

An endpoint is self-hosted when its URL resolves to a loopback, private, or
link-local address, or to a bare/LAN hostname (`server.home`, `gpu-box`).
Provider ids with no URL to resolve fall back to a list of well-known local
runtimes. Neither is exhaustive, so `~/.config/omarchy/agents/local.json` can
name more:

    {"providers": ["homelab", "my-gateway"]}

There are no limits and no balance to report: the meter on self-hosted work is
the electricity bill.
"""

import argparse
import fcntl
import hashlib
import ipaddress
import json
import os
import sqlite3
import sys
import tempfile
import time
import tomllib
from datetime import datetime, timedelta
from pathlib import Path
from urllib.parse import urlparse

AGENT_ID = "local"
AGENT_NAME = "Local"
TIER_LABEL = "Self-hosted"

# Runtimes that serve models from your own hardware. Used when a provider id
# carries no URL to classify — opencode and pi record the id but not the
# endpoint, and Codex's built-in `--oss` provider has no config.toml entry.
KNOWN_LOCAL_PROVIDERS = {
  "gpt4all", "jan", "koboldcpp", "llama-cpp", "llamacpp", "llamafile",
  "lm-studio", "lmstudio", "local", "localai", "mlx", "ollama",
  "openai-local", "oss", "sglang", "tabby", "text-generation-webui", "vllm",
}

# Session files are scanned back this far, matching the Codex collector's
# window. Pi transcripts carry no rollover, so they are read in full.
NATIVE_WINDOW_DAYS = 30

# Same reuse windows as the subscription collectors: a no-flag run reuses a
# scan only long enough to dedup the concurrent collectors the update command
# backgrounds, while --limits-only promises nothing about stats freshness and
# may reuse one for far longer. This collector has no limits to fetch, so
# --limits-only is purely a cheap way to redraw.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

today = datetime.now().strftime("%Y-%m-%d")


def local_day(value):
  if value is None:
    return datetime.now().strftime("%Y-%m-%d")
  if isinstance(value, (int, float)):
    # pi message timestamps are milliseconds; Codex timestamps are seconds.
    if value > 10_000_000_000:
      value = value / 1000
    return datetime.fromtimestamp(value).strftime("%Y-%m-%d")
  text = str(value)
  try:
    if text.endswith("Z"):
      dt = datetime.fromisoformat(text[:-1] + "+00:00")
    else:
      dt = datetime.fromisoformat(text)
    if dt.tzinfo is not None:
      dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d")
  except Exception:
    return datetime.now().strftime("%Y-%m-%d")


def number(value):
  try:
    return max(0, int(value or 0))
  except Exception:
    return 0


def model_name(value):
  text = str(value or "").strip()
  return text or "local"


def is_self_hosted(url):
  """True when a base URL points at hardware the user controls."""
  try:
    host = urlparse(str(url or "")).hostname
  except Exception:
    return False
  if not host:
    return False
  host = host.lower().rstrip(".")
  if host == "localhost":
    return True
  try:
    ip = ipaddress.ip_address(host)
    return ip.is_loopback or ip.is_private or ip.is_link_local
  except ValueError:
    pass
  # A bare hostname is a LAN name by construction; the rest are the suffixes
  # home routers and mDNS hand out.
  if "." not in host:
    return True
  return host.endswith((".home", ".lan", ".local", ".internal", ".localdomain", ".home.arpa"))


def configured_providers():
  path = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "omarchy" / "agents" / "local.json"
  try:
    data = json.loads(path.read_text())
  except Exception:
    return set()
  names = data.get("providers") if isinstance(data, dict) else None
  if not isinstance(names, list):
    return set()
  return {str(name).strip().lower() for name in names if str(name).strip()}


def codex_endpoints():
  """provider id -> base_url, from the Codex CLI's own config."""
  codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
  try:
    with (codex_home / "config.toml").open("rb") as handle:
      config = tomllib.load(handle)
  except Exception:
    return {}
  providers = config.get("model_providers")
  if not isinstance(providers, dict):
    return {}
  endpoints = {}
  for name, entry in providers.items():
    if isinstance(entry, dict):
      endpoints[str(name).lower()] = str(entry.get("base_url") or "")
  return endpoints


class Scan:
  def __init__(self):
    self.extra_providers = configured_providers()
    self.endpoints = codex_endpoints()
    self.today = today
    self.recent_days = [
      (datetime.now() - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)
    ]
    self.recent = {day: 0 for day in self.recent_days}
    self.today_prompts = 0
    self.today_sessions = set()
    self.today_tokens = 0
    self.today_by_model = {}
    self.total_prompts = 0
    self.total_sessions = set()
    self.active_days = set()
    self.model_usage = {}
    self.providers_seen = set()
    self.endpoints_seen = set()
    self.seen_pi_messages = set()
    self.complete = True

  def provider_is_local(self, provider):
    pid = str(provider or "").strip().lower()
    if not pid:
      return False
    if pid in self.extra_providers or pid in KNOWN_LOCAL_PROVIDERS:
      return True
    url = self.endpoints.get(pid)
    return bool(url) and is_self_hosted(url)

  def local_provider_ids(self):
    """Every id this scan would accept, for pushing filters down into SQL."""
    ids = set(KNOWN_LOCAL_PROVIDERS) | set(self.extra_providers)
    for pid, url in self.endpoints.items():
      if url and is_self_hosted(url):
        ids.add(pid)
    return ids

  def note_provider(self, provider):
    pid = str(provider or "").strip().lower()
    self.providers_seen.add(pid)
    url = self.endpoints.get(pid)
    if url:
      host = urlparse(url).hostname
      if host:
        self.endpoints_seen.add(host.lower())

  def add(self, day, session_key, model, input_tokens, output_tokens, cache_read, cache_write):
    total = input_tokens + output_tokens + cache_read + cache_write
    if total <= 0:
      return
    self.total_prompts += 1
    self.total_sessions.add(session_key)
    self.active_days.add(day)
    if day in self.recent:
      self.recent[day] += total
    if day == self.today:
      self.today_prompts += 1
      self.today_sessions.add(session_key)
      self.today_tokens += total
      self.today_by_model[model] = self.today_by_model.get(model, 0) + total
    bucket = self.model_usage.setdefault(
      model,
      {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0},
    )
    bucket["inputTokens"] += input_tokens
    bucket["outputTokens"] += output_tokens
    bucket["cacheReadInputTokens"] += cache_read
    bucket["cacheCreationInputTokens"] += cache_write

  # ------------------------------------------------------------ native codex
  def scan_codex(self):
    codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
    cutoff = time.time() - NATIVE_WINDOW_DAYS * 24 * 60 * 60
    for root in (codex_home / "sessions", codex_home / "archived_sessions"):
      if not root.exists():
        continue
      for path in root.rglob("*.jsonl"):
        try:
          if path.stat().st_mtime < cutoff:
            continue
        except OSError:
          continue
        self._scan_codex_file(path)

  def _scan_codex_file(self, path):
    current_model = "local"
    try:
      with path.open(errors="replace") as handle:
        for raw in handle:
          try:
            entry = json.loads(raw)
          except Exception:
            continue
          if entry.get("type") == "session_meta":
            provider = (entry.get("payload") or {}).get("model_provider")
            # The subscription collector counts these; this one must not.
            if not self.provider_is_local(provider):
              return
            self.note_provider(provider)
            continue
          if entry.get("type") == "turn_context":
            payload = entry.get("payload") or {}
            current_model = model_name(payload.get("model") or payload.get("model_slug") or current_model)
            continue
          payload = entry.get("payload") or entry
          if entry.get("type") == "response_item" and isinstance(payload, dict):
            payload = payload.get("payload") or payload
          if not isinstance(payload, dict) or payload.get("type") != "token_count":
            continue
          usage = (payload.get("info") or {}).get("last_token_usage") or {}
          cache_read = number(usage.get("cached_input_tokens"))
          cache_write = number(usage.get("cache_write_input_tokens"))
          input_tokens = max(0, number(usage.get("input_tokens")) - cache_read - cache_write)
          output_tokens = number(usage.get("output_tokens"))
          day = local_day(entry.get("timestamp") or path.stat().st_mtime)
          self.add(day, str(path), current_model, input_tokens, output_tokens, cache_read, cache_write)
    except Exception:
      return

  # ----------------------------------------------------------------- pi / omp
  def scan_pi(self):
    for root in (Path.home() / ".pi" / "agent" / "sessions", Path.home() / ".omp" / "agent" / "sessions"):
      if not root.exists():
        continue
      for path in root.rglob("*.jsonl"):
        try:
          with path.open(errors="replace") as handle:
            for raw in handle:
              try:
                entry = json.loads(raw)
              except Exception:
                continue
              message = entry.get("message") or {}
              if not isinstance(message, dict) or message.get("role") != "assistant":
                continue
              provider = message.get("provider") or message.get("api")
              if not self.provider_is_local(provider):
                continue
              key = str(entry.get("id") or entry.get("uuid") or f"{path}:{raw[:64]}")
              if key in self.seen_pi_messages:
                continue
              self.seen_pi_messages.add(key)
              self.note_provider(provider)
              usage = message.get("usage") or {}
              day = local_day(entry.get("timestamp") or message.get("timestamp"))
              self.add(
                day, str(path), model_name(message.get("model")),
                number(usage.get("input")), number(usage.get("output")),
                number(usage.get("cacheRead")), number(usage.get("cacheWrite")),
              )
        except Exception:
          continue

  # ----------------------------------------------------------------- opencode
  def scan_opencode(self):
    db = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "opencode.db"
    if not db.exists():
      return
    try:
      conn = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True)
    except Exception:
      return
    # OpenCode DBs hold every historical message with its JSON, so the
    # provider filter belongs in SQL rather than in a Python loop over every
    # row. The candidate ids are known before the query runs: the well-known
    # runtimes, whatever the user configured, and any Codex provider whose
    # endpoint resolves to hardware they host. json_valid() guards the
    # extract so one malformed row cannot abort the scan.
    candidates = sorted(self.local_provider_ids())
    if not candidates:
      return
    placeholders = ",".join("?" * len(candidates))
    try:
      for session_id, raw in conn.execute(
        "SELECT session_id, data FROM message"
        " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
        " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'"
        " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.providerID') END"
        f" IN ({placeholders})",
        candidates,
      ):
        try:
          entry = json.loads(raw)
        except Exception:
          continue
        # Exact match again in Python: the SQL narrowed the rows, it did not
        # vet them.
        if not isinstance(entry, dict) or not self.provider_is_local(entry.get("providerID")):
          continue
        self.note_provider(entry.get("providerID"))
        tokens = entry.get("tokens") or {}
        cache = tokens.get("cache") or {}
        created = (entry.get("time") or {}).get("created")
        # opencode keeps thinking tokens out of output; both are generated.
        self.add(
          local_day(created), "opencode:" + str(session_id), model_name(entry.get("modelID")),
          number(tokens.get("input")), number(tokens.get("output")) + number(tokens.get("reasoning")),
          number(cache.get("read")), number(cache.get("write")),
        )
    except Exception:
      # A scan cut short by a database error must not be cached as the whole
      # story, or the missing usage stays suppressed until the cache expires.
      self.complete = False
      return
    finally:
      try:
        conn.close()
      except Exception:
        pass

  def stats(self):
    """Snapshot the aggregated local usage into the record's stats dict."""
    return {
      "todayPrompts": self.today_prompts,
      "todaySessions": len(self.today_sessions),
      "todayTotalTokens": self.today_tokens,
      "todayTokensByModel": self.today_by_model,
      "recentDays": [{"date": day, "messageCount": self.recent[day]} for day in self.recent_days],
      "totalPrompts": self.total_prompts,
      "totalSessions": len(self.total_sessions),
      "activeDays": len(self.active_days),
      "activeDates": sorted(self.active_days),
      "modelUsage": self.model_usage,
    }


def cache_root():
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def scan_cache_paths():
  codex_home = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex"))
  db = Path(os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local" / "share")) / "opencode" / "opencode.db"
  config = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")) / "omarchy" / "agents" / "local.json"
  # The digest covers every path the scan reads: the codex session roots and
  # its config.toml, the opencode DB, the provider config, and (via
  # Path.home()) the pi/omp session roots.
  digest = hashlib.sha1(
    "\n".join(str(part) for part in (Path.home(), codex_home, db, config)).encode("utf-8")
  ).hexdigest()[:16]
  root = cache_root()
  return root / f"local-scan-{digest}.json", root / f"local-scan-{digest}.lock"


def read_fresh_json(path, max_age_seconds):
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    # A negative age means the mtime is in the future: the clock moved
    # backwards since the write, so the cache's freshness cannot be trusted.
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path, payload):
  # A temp name unique to this writer, not derived from the target: several
  # collectors can run at once, and a shared temp path means the second
  # replace finds the first one's file already moved away.
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    # mkstemp opens at 0600; nothing in the cache is sensitive, so open it
    # up to the usual 0644.
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


# The cache payload is a versioned envelope around the stats dict, so a
# corrupted or foreign-shaped file is a cache miss (rescan + rewrite) instead
# of a crash or a garbage record.
def read_cached_stats(cache_file, max_age_seconds):
  cached = read_fresh_json(cache_file, max_age_seconds)
  if not isinstance(cached, dict) or cached.get("schemaVersion") != 1:
    return None
  # today* fields only mean "today" on the day they were scanned. A cache
  # from another local date (midnight passed, or the clock moved) is a miss,
  # not merely old, whatever its mtime says.
  if cached.get("scanDate") != today:
    return None
  stats = cached.get("stats")
  if not isinstance(stats, dict):
    return None
  if not all(key in stats for key in ("todayPrompts", "todayTotalTokens", "recentDays", "activeDates", "modelUsage")):
    return None
  return stats


def write_cached_stats(cache_file, stats):
  try:
    write_json(cache_file, {"schemaVersion": 1, "scanDate": today, "stats": stats})
  except Exception as exc:
    print(f"omarchy-agent-usage-local: could not write usage cache ({exc})", file=sys.stderr)


def run_local_scan():
  scan = Scan()
  scan.scan_codex()
  scan.scan_pi()
  scan.scan_opencode()
  return scan.stats(), scan.complete


def cached_stats(max_age):
  """Stats, with the cache as a pure optimization.

  The cache must never take the collector down: any cache-layer failure
  (unwritable cache root, lock errors, disk full) degrades to a direct scan
  and a warning on stderr. The JSON record is the contract; the cache is not.
  """
  try:
    return _cached_stats(max_age)
  except Exception as exc:
    print(f"omarchy-agent-usage-local: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    stats, _ = run_local_scan()
    return stats


def _cached_stats(max_age):
  cache_file, lock_file = scan_cache_paths()

  cached = read_cached_stats(cache_file, max_age)
  if cached is not None:
    return cached

  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    cached = read_cached_stats(cache_file, max_age)
    if cached is not None:
      return cached
    stats, complete = run_local_scan()
    # An interrupted scan still serves this run, but caching it would
    # suppress the missing usage for every reader until the cache expires.
    if complete:
      write_cached_stats(cache_file, stats)
    return stats


def main():
  parser = argparse.ArgumentParser()
  # Accepted for parity with the other collectors: the update command passes
  # them to everything it runs. There are no limits to fetch here, so
  # --limits-only just means "a redraw may reuse an older scan".
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now().astimezone().isoformat(),
    "ready": True,
    "hasLocalStats": True,
    "tierLabel": TIER_LABEL,
    "usageStatusText": "",
    "authHelpText": "",
    # Nothing meters self-hosted work, so the panel draws no limit rows.
    "limits": [],
  }
  record.update(cached_stats(max_age))
  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()

#!/bin/bash

# omarchy:summary=Set up fingerprint authentication for sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e


setup_pam_config() {
  # A clamshell gate runs before pam_fprintd in every stack: when the lid is
  # shut the reader is unreachable, so fingerprint is skipped and PAM drops
  # straight to the password prompt instead of blocking on the reader until it
  # times out. Lid open → fingerprint, then password as the fallback.
  #
  # pam_exec needs a literal absolute path (no env expansion). Point at the
  # fixed /usr/bin path the omarchy package always provides, so the gate keeps
  # working across package installs and dev-link — the latter overlays
  # $OMARCHY_PATH trees but leaves /usr/bin untouched.
  #
  # Use omarchy-hw-laptop-open (exit 0 when open) so the common path does not
  # make pam_exec LOG_ERR on every sudo/polkit auth (#10254). success=ignore
  # continues to pam_fprintd; default=1 skips it when the lid is closed.
  local fprintd_gate="auth      [success=ignore default=1] pam_exec.so quiet /usr/bin/omarchy-hw-laptop-open"

  # Configure sudo
  if ! grep -q pam_fprintd.so /etc/pam.d/sudo; then
    echo "Configuring sudo for fingerprint authentication..."
    sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/sudo
  fi
  # Drop any prior polarity of the gate, then insert the silent lid-open form
  # immediately before pam_fprintd so default=1 skips exactly that module.
  sudo sed -i -e '/omarchy-hw-laptop-closed/d' -e '/omarchy-hw-laptop-open/d' /etc/pam.d/sudo
  if ! grep -q 'omarchy-hw-laptop-open' /etc/pam.d/sudo; then
    echo "Adding clamshell gate to sudo..."
    sudo sed -i "/pam_fprintd\.so/i $fprintd_gate" /etc/pam.d/sudo
  fi

  # Configure polkit
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    if ! grep -q 'pam_fprintd.so' /etc/pam.d/polkit-1; then
      echo "Configuring polkit for fingerprint authentication..."
      sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/polkit-1
    fi
    sudo sed -i -e '/omarchy-hw-laptop-closed/d' -e '/omarchy-hw-laptop-open/d' /etc/pam.d/polkit-1
    if ! grep -q 'omarchy-hw-laptop-open' /etc/pam.d/polkit-1; then
      echo "Adding clamshell gate to polkit..."
      sudo sed -i "/pam_fprintd\.so/i $fprintd_gate" /etc/pam.d/polkit-1
    fi
  else
    echo "Creating polkit configuration with fingerprint authentication..."
    # omarchy:heredoc-expands paths=none -- $fprintd_gate is the literal PAM
    # line defined above, shared with the two sed insertions so the gate cannot
    # drift between files. The only path in it is the fixed /usr/bin one.
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<EOF
$fprintd_gate
auth      sufficient pam_fprintd.so
auth      required pam_unix.so

account   required pam_unix.so
password  required pam_unix.so
session   required pam_unix.so
EOF
  fi
}

setup_lock_fingerprint_pam() {
  echo "Configuring lock screen for fingerprint authentication..."
  # No lid gate here. This PamContext's only auth module is pam_fprintd;
  # skipping it is PAM success and unlocks. Lid-closed skip belongs in the
  # lock service (see #10393), not this file.
  sudo tee /etc/pam.d/omarchy-lock-fingerprint >/dev/null <<'EOF'
#%PAM-1.0
auth       required                    pam_fprintd.so
account    include                     system-local-login
EOF
}


echo -e "\e[32mSetting up fingerprint scanner for authentication.\n\e[0m"

# Bail before installing anything if there's no reader to talk to.
if ! omarchy-hw-fingerprint; then
  echo -e "\e[31mNo fingerprint sensor detected.\e[0m"
  exit 1
fi

# Prefer libfprint-git (tracks upstream ahead of Arch). Stock libfprint is
# still replaced so a new reader only needs a pin bump in omarchy-pkgs. A
# community fork that already provides libfprint / libfprint-2 must be left
# alone — pacman -Qq is provides-aware, while omarchy-pkg-missing libfprint-git
# is not, and --ask 4 would otherwise silently evict the working driver
# (see #11899). After any package change, restart fprintd so enroll/verify
# talk to the on-disk library instead of a stale in-memory .so.
libfprint_pkgs=()
while IFS= read -r pkg; do
  [[ -n $pkg ]] && libfprint_pkgs+=("$pkg")
done < <(pacman -Qq libfprint libfprint-2 libfprint-git 2>/dev/null | sort -u)

need_packages=()
if ((${#libfprint_pkgs[@]} == 0)) ||
  { ((${#libfprint_pkgs[@]} == 1)) && [[ ${libfprint_pkgs[0]} == libfprint ]]; }; then
  # Missing entirely, or only Arch stock — install / replace with libfprint-git.
  need_packages+=(libfprint-git)
fi
if omarchy-pkg-missing fprintd; then
  need_packages+=(fprintd)
fi
if omarchy-pkg-missing usbutils; then
  need_packages+=(usbutils)
fi

if ((${#need_packages[@]} > 0)); then
  echo "Installing required packages..."
  # Conflicts with stock libfprint: --noconfirm would answer N; --ask 4 accepts
  # the replacement in one transaction so a failed install leaves the existing
  # driver in place.
  sudo pacman -S --needed --noconfirm --ask 4 "${need_packages[@]}"
  # D-Bus activation keeps a running fprintd mapped to the library that was
  # just replaced; without a restart, enroll can "succeed" against the old .so.
  sudo systemctl try-restart fprintd.service 2>/dev/null || true
fi

# Enroll first fingerprint
echo -e "\e[32m\nLet's setup your right index finger as the first fingerprint.\e[0m"
echo -e "Keep moving the finger around on sensor until the process completes.\n"

if sudo fprintd-enroll "$USER"; then
  echo -e "\e[32m\nFingerprint enrolled successfully!\e[0m"

  # Verify
  echo -e "\nNow let's verify that it's working correctly.\n"
  if fprintd-verify; then
    # PAM comes last, once a print is enrolled and verified. Detection only
    # proves a reader is there, not that libfprint can drive it — an Elan MOC
    # sensor outside the elanmoc table gets this far and then fails to enroll.
    # Editing the stacks up front would leave those machines pointing at
    # pam_fprintd with nothing to match.
    setup_pam_config
    setup_lock_fingerprint_pam
    echo -e "\e[32m\nPerfect! Fingerprint authentication is now configured.\e[0m"
    echo "You can use your fingerprint for sudo, polkit, and lock screen (Super + Ctrl + L)."
  else
    echo -e "\e[31m\nVerification failed. You may want to try enrolling again.\e[0m"
  fi
else
  echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
  exit 1
fi

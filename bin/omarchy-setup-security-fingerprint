#!/bin/bash

# omarchy:summary=Set up fingerprint authentication for sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e


setup_pam_config() {
  # A clamshell gate runs before pam_fprintd in every stack: when the lid is
  # shut the reader is unreachable, so it skips fingerprint (success=1) and PAM
  # drops straight to the password prompt instead of blocking on the reader
  # until it times out. Lid open → fingerprint, then password as the fallback.
  #
  # pam_exec needs a literal absolute path (no env expansion). Point at the
  # fixed /usr/bin path the omarchy package always provides, so the gate keeps
  # working across package installs and dev-link — the latter overlays
  # $OMARCHY_PATH trees but leaves /usr/bin untouched.
  local fprintd_gate="auth      [success=1 default=ignore] pam_exec.so quiet /usr/bin/omarchy-hw-laptop-closed"

  # Configure sudo
  if ! grep -q pam_fprintd.so /etc/pam.d/sudo; then
    echo "Configuring sudo for fingerprint authentication..."
    sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/sudo
  fi
  if ! grep -q 'omarchy-hw-laptop-closed' /etc/pam.d/sudo; then
    echo "Adding clamshell gate to sudo..."
    # Insert immediately before pam_fprintd so success=1 skips exactly it.
    sudo sed -i "/pam_fprintd\.so/i $fprintd_gate" /etc/pam.d/sudo
  fi

  # Configure polkit
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    if ! grep -q 'pam_fprintd.so' /etc/pam.d/polkit-1; then
      echo "Configuring polkit for fingerprint authentication..."
      sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/polkit-1
    fi
    if ! grep -q 'omarchy-hw-laptop-closed' /etc/pam.d/polkit-1; then
      echo "Adding clamshell gate to polkit..."
      sudo sed -i "/pam_fprintd\.so/i $fprintd_gate" /etc/pam.d/polkit-1
    fi
  else
    echo "Creating polkit configuration with fingerprint authentication..."
    # omarchy:heredoc-expands paths=none -- $fprintd_gate is the literal PAM
    # line defined above, shared with the two sed insertions so the gate cannot
    # drift between files. The only path in it is the fixed /usr/bin one.
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<EOF
$fprintd_gate
auth      sufficient pam_fprintd.so
auth      include system-auth

account   include system-auth
password  include system-auth
session   include system-auth
EOF
  fi
}

# Synaptics Tudor match-on-sensor readers (e.g. 06cb:00be on the Lenovo Yoga
# C740, plus 00da/00fd/00ff relatives) are not supported by upstream libfprint,
# so stock libfprint-git enrolls fail with NoSuchDevice even though
# omarchy-hw-fingerprint correctly detects a reader. They need the community
# synaTudor TOD stack (libfprint-tod + relinked Windows driver) instead.
# Prints the sysfs vendor:product (e.g. 06cb:00be) of the first Tudor reader,
# so troubleshooting names the exact device instead of whatever 06cb entry
# lsusb happens to list first. Scans sysfs directly so this works even if
# lsusb/usbutils is missing.
tudor_device_id() {
  local usb_devices_path="${OMARCHY_USB_DEVICES_PATH:-/sys/bus/usb/devices}"
  local dev vendor product
  for dev in "$usb_devices_path"/*; do
    [[ -r $dev/idVendor && -r $dev/idProduct ]] || continue
    vendor=$(<"$dev/idVendor")
    product=$(<"$dev/idProduct")
    case "$vendor:$product" in
      06cb:00be | 06cb:00da | 06cb:00fd | 06cb:00ff)
        printf '%s\n' "$vendor:$product"
        return 0
        ;;
    esac
  done
  return 1
}

is_tudor_device_present() {
  tudor_device_id >/dev/null
}

# libfprint-tod-git (the Tudor community stack) conflicts with libfprint-git:
# installing libfprint-git would remove the working TOD driver, so its
# presence means this setup must never reinstall libfprint-git.
has_tod_stack() {
  pacman -Q -- libfprint-tod-git &>/dev/null
}

report_tudor_if_present() {
  local id="${1:-}"
  if [[ -n $id ]]; then
    echo -e "\e[33mThis looks like a Synaptics Tudor reader ($id).\e[0m"
  else
    echo -e "\e[33mThis looks like a Synaptics Tudor reader.\e[0m"
  fi
  echo -e "Upstream libfprint does not support Tudor match-on-sensor devices,"
  echo -e "so the stock libfprint-git driver cannot drive it."
  echo -e "\nOptions:"
  echo -e "  1. Use the community synaTudor TOD stack:"
  echo -e "     https://github.com/Popax21/synaTudor"
  echo -e "     - Replace libfprint-git with libfprint-tod-git (they conflict),"
  echo -e "       build/install synaTudor (relink branch), enable tudor-host-launcher,"
  echo -e "       restart fprintd, then re-run this setup (it keeps the TOD stack"
  echo -e "       instead of reinstalling libfprint-git)."
  echo -e "     - Note: downloads Synaptics' proprietary Windows driver at build time,"
  echo -e "       needs AUR/manual build, and can crash (tudor_host SIGABRT) —"
  echo -e "       'sudo systemctl restart tudor-host-launcher fprintd' recovers."
  echo -e "  2. Stay on password-only auth and skip fingerprint for this device."
}


echo -e "\e[32mSetting up fingerprint scanner for authentication.\n\e[0m"

# Bail before installing anything if there's no reader to talk to.
if ! omarchy-hw-fingerprint; then
  echo -e "\e[31mNo fingerprint sensor detected.\e[0m"
  exit 1
fi

# libfprint-git tracks upstream ahead of the Arch release, so a new reader only
# needs a pin bump in omarchy-pkgs. It conflicts with stock libfprint, and
# --noconfirm answers that prompt with N; --ask 4 accepts the replacement in
# one transaction, so a failed install leaves the existing driver in place.
# A Tudor machine that already runs libfprint-tod-git must never get
# libfprint-git: that swap would remove the working TOD driver, so a rerun
# only tops up fprintd/usbutils and leaves TOD alone.
if has_tod_stack; then
  if omarchy-pkg-missing fprintd usbutils; then
    echo "Installing required packages (keeping libfprint-tod)..."
    sudo pacman -S --needed --noconfirm --ask 4 -- fprintd usbutils
  fi
elif omarchy-pkg-missing libfprint-git fprintd usbutils; then
  echo "Installing required packages..."
  sudo pacman -S --needed --noconfirm --ask 4 -- libfprint-git fprintd usbutils
fi

# Enroll first fingerprint
echo -e "\e[32m\nLet's setup your right index finger as the first fingerprint.\e[0m"
echo -e "Keep moving the finger around on sensor until the process completes.\n"

# Stream enrollment live while keeping a copy: the user needs scan progress
# and retry guidance while their finger is on the reader, and the failure
# branch needs the text to decide whether the Tudor hint applies. pipefail
# stays scoped to this pipeline so no other exit status changes meaning.
enroll_log=$(mktemp)
set -o pipefail
enroll_status=0
sudo fprintd-enroll "$USER" 2>&1 | tee "$enroll_log" || enroll_status=$?
set +o pipefail
enroll_output=$(<"$enroll_log")
rm -f "$enroll_log"

if (( enroll_status == 0 )); then
  echo -e "\e[32m\nFingerprint enrolled successfully!\e[0m"

  # Verify
  echo -e "\nNow let's verify that it's working correctly.\n"
  if fprintd-verify; then
    # PAM comes last, once a print is enrolled and verified. Detection only
    # proves a reader is there, not that libfprint can drive it — an Elan MOC
    # sensor outside the elanmoc table gets this far and then fails to enroll.
    # Editing the stacks up front would leave those machines pointing at
    # pam_fprintd with nothing to match.
    setup_pam_config
    "$OMARCHY_PATH/bin/omarchy-apply-lock"
    if [[ ! -f /etc/pam.d/omarchy-lock-fingerprint ]]; then
      echo "Fingerprint enrollment succeeded, but lock-screen configuration could not be confirmed. Run omarchy-apply-lock and try again." >&2
      exit 1
    fi
    echo -e "\e[32m\nPerfect! Fingerprint authentication is now configured.\e[0m"
    echo "You can use your fingerprint for sudo, polkit, and lock screen (Super + Ctrl + L)."
  else
    echo -e "\e[31m\nVerification failed. You may want to try enrolling again.\e[0m"
  fi
else
  # The Tudor hint explains only a no-device failure, not a finger-scan
  # failure on another reader: a machine with both a Tudor and a supported
  # external reader must not blame Tudor when enrollment on the external one
  # fails for its own reason. Gate on the actual error text.
  if tudor_id=$(tudor_device_id) && grep -qiE 'no such device|no devices? available' <<<"$enroll_output"; then
    echo -e "\e[31m\nEnrollment failed: no devices available.\e[0m"
    report_tudor_if_present "$tudor_id"
  else
    echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
  fi
  exit 1
fi

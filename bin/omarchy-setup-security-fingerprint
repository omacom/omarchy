#!/bin/bash

# omarchy:summary=Set up fingerprint authentication for sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e


is_validity_fingerprint() {
  command -v omarchy-hw-fingerprint-validity >/dev/null 2>&1 &&
    omarchy-hw-fingerprint-validity
}

setup_pam_config() {
  # A clamshell gate runs before pam_fprintd in every stack: when the lid is
  # shut the reader is unreachable, so it skips fingerprint (success=1) and PAM
  # drops straight to the password prompt instead of blocking on the reader
  # until it times out. Lid open -> fingerprint, then password as the fallback.
  local fprintd_gate="auth      [success=1 default=ignore] pam_exec.so quiet /usr/bin/omarchy-hw-laptop-closed"

  # Configure sudo
  if ! grep -q pam_fprintd.so /etc/pam.d/sudo; then
    echo "Configuring sudo for fingerprint authentication..."
    sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/sudo
  fi
  if ! grep -q 'omarchy-hw-laptop-closed' /etc/pam.d/sudo; then
    echo "Adding clamshell gate to sudo..."
    sudo sed -i "/pam_fprintd\.so/i $fprintd_gate" /etc/pam.d/sudo
  fi

  # Configure polkit
  if [[ -f /etc/pam.d/polkit-1 ]]; then
    if ! grep -q 'pam_fprintd.so' /etc/pam.d/polkit-1; then
      echo "Configuring polkit for fingerprint authentication..."
      sudo sed -i '1i auth      sufficient pam_fprintd.so' /etc/pam.d/polkit-1
    fi
    if ! grep -q 'omarchy-hw-laptop-closed' /etc/pam.d/polkit-1; then
      echo "Adding clamshell gate to polkit..."
      sudo sed -i "/pam_fprintd\.so/i $fprintd_gate" /etc/pam.d/polkit-1
    fi
  else
    echo "Creating polkit configuration with fingerprint authentication..."
    sudo tee /etc/pam.d/polkit-1 >/dev/null <<EOF
$fprintd_gate
auth      sufficient pam_fprintd.so
auth      include system-auth

account   include system-auth
password  include system-auth
session   include system-auth
EOF
  fi
}

echo -e "\e[32mSetting up fingerprint scanner for authentication.\n\e[0m"

# Bail before installing anything if there's no reader to talk to.
if ! omarchy-hw-fingerprint; then
  echo -e "\e[31mNo fingerprint sensor detected.\e[0m"
  exit 1
fi

if is_validity_fingerprint; then
  echo -e "\e[32mValidity fingerprint sensor detected; using python-validity + open-fprintd.\e[0m"

  if omarchy-pkg-present fprintd; then
    echo "Removing incompatible stock fprintd daemon..."
    omarchy-pkg-drop fprintd
  fi

  as_root() {
    if (( EUID == 0 )); then
      "$@"
    else
      sudo "$@"
    fi
  }

  as_root systemctl mask fprintd 2>/dev/null || true

  if ! grep -q '^IgnorePkg = fprintd' /etc/pacman.conf; then
    grep -q '^\[options\]' /etc/pacman.conf &&
      sudo sed -i '/^\[options\]/a IgnorePkg = fprintd' /etc/pacman.conf
  fi

  if omarchy-pkg-missing python-validity open-fprintd usbutils; then
    echo "Installing required packages..."
    omarchy-pkg-aur-add python-validity open-fprintd
    omarchy-pkg-add usbutils
  fi

  # Healthy sensors should be tried directly; factory reset only runs when
  # the sensor cannot be opened. A reset also clears enrolled prints.
  if ! fprintd-list "$USER" >/dev/null 2>&1; then
    echo "Sensor not reachable; repairing it first..."
    if command -v omarchy-fingerprint-repair >/dev/null 2>&1; then
      omarchy-fingerprint-repair
    elif [[ -x "$OMARCHY_PATH/bin/omarchy-fingerprint-repair" ]]; then
      "$OMARCHY_PATH/bin/omarchy-fingerprint-repair"
    else
      echo -e "\e[31mMissing omarchy-fingerprint-repair.\e[0m" >&2
      exit 1
    fi
  fi

  if ! fprintd-list "$USER" >/dev/null 2>&1; then
    echo -e "\e[31mSensor still unavailable after repair.\e[0m"
    echo "Try a cold shutdown (power off 15 seconds) and rerun: omarchy setup security fingerprint"
    exit 1
  fi
else
  # libfprint-git tracks upstream ahead of the Arch release, so a new reader only
  # needs a pin bump in omarchy-pkgs. It conflicts with stock libfprint, and
  # --noconfirm answers that prompt with N; --ask 4 accepts the replacement in
  # one transaction, so a failed install leaves the existing driver in place.
  if omarchy-pkg-missing libfprint-git fprintd usbutils; then
    echo "Installing required packages..."
    sudo pacman -S --needed --noconfirm --ask 4 -- libfprint-git fprintd usbutils
  fi
fi

# Enroll first fingerprint
echo -e "\e[32m\nLet's setup your right index finger as the first fingerprint.\e[0m"
echo -e "Keep moving the finger around on sensor until the process completes.\n"

enrolled_ok=false
if sudo fprintd-enroll -f right-index-finger "$USER"; then
  enrolled_ok=true
else
  echo -e "\e[31m\nFirst enrollment attempt failed.\e[0m"
  if is_validity_fingerprint; then
    if ! fprintd-list "$USER" >/dev/null 2>&1; then
      echo "The sensor is no longer usable; repairing it before retrying enrollment..."
      if command -v omarchy-fingerprint-repair >/dev/null 2>&1; then
        omarchy-fingerprint-repair || true
      elif [[ -x "$OMARCHY_PATH/bin/omarchy-fingerprint-repair" ]]; then
        "$OMARCHY_PATH/bin/omarchy-fingerprint-repair" || true
      fi
      if sudo fprintd-enroll -f right-index-finger "$USER"; then
        enrolled_ok=true
      fi
    else
      # A failed capture or a full enrollment store does not necessarily mean
      # that the sensor is stuck. Do not factory-reset without consent.
      if [[ -t 0 && -t 2 ]]; then
        read -r -p "Retry with a factory reset, which erases all saved fingerprints? [y/N] " reset_choice || true
      else
        reset_choice=""
      fi
      if [[ "$reset_choice" == [yY]* ]]; then
        if command -v omarchy-fingerprint-repair >/dev/null 2>&1; then
          omarchy-fingerprint-repair || true
        elif [[ -x "$OMARCHY_PATH/bin/omarchy-fingerprint-repair" ]]; then
          "$OMARCHY_PATH/bin/omarchy-fingerprint-repair" || true
        fi
        if sudo fprintd-enroll -f right-index-finger "$USER"; then
          enrolled_ok=true
        fi
      else
        echo "Enrollment failed, but existing prints were left untouched."
        echo "Run 'omarchy setup security fingerprint' again, or 'omarchy-fingerprint-repair' to reset manually."
        exit 1
      fi
    fi
  else
    exit 1
  fi
fi

if [[ $enrolled_ok != true ]]; then
  echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
  exit 1
fi

echo -e "\e[32m\nFingerprint enrolled successfully!\e[0m"

echo -e "\nNow let's verify that it's working correctly.\n"
if ! fprintd-verify -f right-index-finger; then
  echo -e "\e[31m\nVerification failed. You may want to try enrolling again.\e[0m"
  exit 1
fi

# PAM comes last: detection proves a reader is there, but enrollment + verify
# confirms that the chosen backend can actually drive it.
setup_pam_config
"$OMARCHY_PATH/bin/omarchy-apply-lock"
if [[ ! -f /etc/pam.d/omarchy-lock-fingerprint ]]; then
  echo "Fingerprint enrollment succeeded, but lock-screen configuration could not be confirmed. Run omarchy-apply-lock and try again." >&2
  exit 1
fi

echo -e "\e[32m\nPerfect! Fingerprint authentication is now configured.\e[0m"
echo "You can use your fingerprint for sudo, polkit, and lock screen (Super + Ctrl + L)."

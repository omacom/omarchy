#!/bin/bash

# omarchy:summary=Check free disk space required for an update
# omarchy:hidden=true

set -e

ROOT_MIN_BYTES=$((10 * 1024 * 1024 * 1024))
ESP_FLOOR_BYTES=$((400 * 1024 * 1024))

bytes_as_mib() {
  local bytes=$1
  local mib=$((bytes / (1024 * 1024)))

  if (( bytes % (1024 * 1024) > 0 )); then
    ((++mib))
  fi
  if (( mib < 1 )); then
    mib=1
  fi

  echo "$mib"
}

resolve_esp_path() {
  local limine_default=${OMARCHY_TEST_LIMINE_DEFAULT:-/etc/default/limine}
  local esp="" candidate

  if [[ -f $limine_default ]]; then
    esp=$(sed -n 's/^ESP_PATH=["'\'']\?\([^"'\'']*\).*/\1/p' "$limine_default" | tail -1)
  fi

  for candidate in "${esp:-/boot}" /boot; do
    [[ -n $candidate && -d $candidate ]] || continue
    if mountpoint -q -- "$candidate" 2>/dev/null; then
      echo "$candidate"
      return 0
    fi
  done

  return 1
}

esp_required_bytes() {
  local esp_path=$1 sizes size largest=0 uki_count=0 kernel_count
  if [[ -d $esp_path/EFI/Linux ]]; then
    if ! sizes=$(find "$esp_path/EFI/Linux" -maxdepth 1 -type f -name '*.efi' -printf '%s\n' 2>/dev/null); then
      echo "Could not read UKI sizes on $esp_path; check ESP free space before updating." >&2
      return 1
    fi
    while IFS= read -r size; do
      [[ $size =~ ^[0-9]+$ ]] || continue
      ((uki_count += 1))
      if (( size > largest )); then largest=$size; fi
    done <<<"$sizes"
  elif [[ ! -r $esp_path || ! -x $esp_path ]]; then
    echo "Could not read $esp_path; check ESP free space before updating." >&2
    return 1
  fi
  kernel_count=$(pacman -Qq linux linux-omarchy linux-lts linux-zen linux-hardened 2>/dev/null | wc -l)
  if (( uki_count > kernel_count )); then kernel_count=$uki_count; fi
  if (( kernel_count < 1 )); then kernel_count=1; fi
  # Reserve a largest-size image per kernel plus a spare for snapshot history.
  local required=$((largest * (kernel_count + 1)))
  if (( required < ESP_FLOOR_BYTES )); then required=$ESP_FLOOR_BYTES; fi
  echo "$required"
}

if [[ ${OMARCHY_UPDATE_FORCE:-0} == "1" ]]; then
  exit 0
fi

if read -r available_bytes < <(df --output=avail --block-size=1 / 2>/dev/null | tail -n 1) &&
  [[ $available_bytes =~ ^[0-9]+$ ]] &&
  (( available_bytes < ROOT_MIN_BYTES )); then
  echo "You need at least 10 GiB free to safely update Omarchy."
  exit 1
fi

if esp_path=$(resolve_esp_path); then
  esp_source=$(findmnt -nro SOURCE -T "$esp_path" 2>/dev/null || true)
  root_source=$(findmnt -nro SOURCE -T / 2>/dev/null || true)
  if [[ -n $esp_source && $esp_source == "$root_source" ]]; then
    exit 0
  fi
  if read -r esp_available_bytes < <(df --output=avail --block-size=1 "$esp_path" 2>/dev/null | tail -n 1) &&
    [[ $esp_available_bytes =~ ^[0-9]+$ ]]; then
    if ! esp_required_bytes=$(esp_required_bytes "$esp_path"); then
      exit 0
    fi

    if (( esp_available_bytes < esp_required_bytes )); then
      shortfall_bytes=$((esp_required_bytes - esp_available_bytes))
      required_mib=$(bytes_as_mib "$esp_required_bytes")
      shortfall_mib=$(bytes_as_mib "$shortfall_bytes")
      echo "You need at least ${required_mib} MiB free on ${esp_path} to safely update Omarchy (${shortfall_mib} MiB short)."
      exit 1
    fi
  else
    echo "Could not determine free space on $esp_path; check the ESP before updating." >&2
  fi
fi

exit 0

#!/bin/bash

# omarchy:summary=Sign out of the Cloudflare CLI and remove the Cloudflare Dashboard web app.

set -e

marker="$HOME/.local/state/omarchy/cloudflare-service"
if [[ ! -f $marker ]] && ! omarchy-installed-service-cloudflare; then
  echo "Cloudflare service is not set up."
  exit 0
fi

# Repair the managed wrapper if it was removed, and never invoke another cf.
omarchy-mise-install npm:cf cf
if ! "$HOME/.local/bin/cf" auth logout; then
  echo "Cloudflare sign-out failed. Setup was kept so you can retry Remove > Services > Cloudflare." >&2
  exit 1
fi

# Remove only our exact dashboard launcher, not an unrelated Cloudflare.desktop
# or a nested same-named web app selected by the generic web-app remover.
if omarchy-installed-service-cloudflare; then
  rm -- "$HOME/.local/share/applications/Cloudflare.desktop"
  # The dashboard owns this downloaded icon, but another launcher may share it.
  icon="$HOME/.local/share/icons/hicolor/256x256/apps/cloudflare.png"
  icon_references=0
  grep -rFxq --include='*.desktop' -e 'Icon=cloudflare' -e 'Icon=cloudflare.png' -e "Icon=$icon" \
    "$HOME/.local/share/applications" || icon_references=$?
  if ((icon_references == 1)); then
    rm -f -- "$icon"
    gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
  fi
  update-desktop-database "$HOME/.local/share/applications"
fi
rm -f -- "$marker"

echo ""
echo "Cloudflare has been removed."

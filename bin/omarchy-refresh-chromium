#!/bin/bash

# omarchy:summary=Refresh the ~/.config/chromium-flags.conf file from the Omarchy defaults.

# Refresh the Chromium configuration
omarchy-refresh-config chromium-flags.conf

# Install/refresh the native messaging hosts used by the bundled extensions
omarchy-install-chromium-copy-url
omarchy-install-chromium-ytdlp

# Put the Snapdragon camera and video decoding settings back. Last, so a
# failure of either is the command's result.
status=0
omarchy-install-camera || status=$?
omarchy-install-video-decode || status=$?
exit "$status"

#!/bin/bash

# omarchy:summary=Minimize a window to the dock
# omarchy:args=[window-address]

# The active window when given no address. Minimized windows wait on a special
# workspace, and the dock brings them back.
#
# One value a line: a value Hyprland leaves out, such as the workspace id of a
# window on the scratchpad, then reads as empty instead of the next one taking
# its place.
if [[ -n ${1:-} ]]; then
  ADDRESS=$1
  { read -r WORKSPACE; read -r FULLSCREEN; } < <(hyprctl clients -j | jq -r --arg address "$ADDRESS" 'first(.[] | select(.address == $address)) | .workspace.id // "", .fullscreen // 0')
else
  { read -r ADDRESS; read -r WORKSPACE; read -r FULLSCREEN; } < <(hyprctl activewindow -j | jq -r '.address // "", .workspace.id // "", .fullscreen // 0')
fi

[[ -n $ADDRESS && $WORKSPACE =~ ^[0-9]+$ ]] || exit 1

# Only floating workspaces have the dock to bring a window back from.
[[ $(omarchy-hyprland-workspace-layout-current "$WORKSPACE") == "floating" ]] || exit 0

remember_minimized_from() {
  local address=$1 workspace=$2 clients tag
  if clients=$(hyprctl clients -j); then
    while read -r tag; do
      [[ $tag =~ ^omarchy-minimized-from-[0-9]+$ && $tag != "omarchy-minimized-from-$workspace" ]] || continue
      hyprctl dispatch "hl.dsp.window.tag({ tag = \"-$tag\", window = \"address:$address\" })" >/dev/null
    done < <(jq -r --arg address "$address" '.[] | select(.address == $address) | (.tags // [])[]' <<<"$clients")
  fi
  hyprctl dispatch "hl.dsp.window.tag({ tag = \"+omarchy-minimized-from-$workspace\", window = \"address:$address\" })" >/dev/null
}

# A window waits among the minimized ones at its own size. Once a monitor going
# away or coming back has carried their workspace along, Hyprland takes it for
# shown, and while it holds a maximized or fullscreen window the floating ones
# waiting with it are drawn: a window minimized after that stays on screen, dead
# to input.
case ${FULLSCREEN:-0} in
  1) MODE=maximized ;;
  2 | 3) MODE=fullscreen ;;
  *) MODE="" ;;
esac

remember_minimized_from "$ADDRESS" "$WORKSPACE"
if [[ -n $MODE ]]; then
  hyprctl dispatch "hl.dsp.window.fullscreen({ mode = \"$MODE\", action = \"unset\", window = \"address:$ADDRESS\" })" >/dev/null
fi
hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:minimized\", follow = false, window = \"address:$ADDRESS\" })" >/dev/null

# What the window gave up is tagged on it, and given back when it returns
# (default/hypr/workspace-modes.lua). Tagged on its own workspace, it would be
# given straight back.
if [[ -n $MODE ]]; then
  hyprctl dispatch "hl.dsp.window.tag({ tag = \"+omarchy-minimized-$MODE\", window = \"address:$ADDRESS\" })" >/dev/null
fi

# Focus would otherwise stay with the minimized window, and the next window
# opened would join it on the hidden workspace.
hyprctl dispatch "hl.dsp.focus({ workspace = \"$WORKSPACE\" })" >/dev/null

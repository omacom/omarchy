#!/bin/bash

# omarchy:summary=Set a window aside on the Shelf, to restore later on any workspace
# omarchy:args=[window-address]

ADDRESS=${1:-$(hyprctl activewindow -j | jq -r '.address // empty')}
[[ $ADDRESS =~ ^0x[0-9a-fA-F]+$ ]] || exit 1

SELECTOR="address:$ADDRESS"
SHELF_DIR="$XDG_RUNTIME_DIR/omarchy/shelf"

client() {
  hyprctl clients -j | jq -c --arg address "$ADDRESS" 'first(.[] | select(.address == $address)) // empty'
}

CLIENT=$(client)
[[ -n $CLIENT ]] || exit 1

# The Shelf and the scratchpad are special workspaces, with negative ids. A
# window on one is already set aside.
(( $(jq '.workspace.id' <<<"$CLIENT") >= 1 )) || exit 0

# Restoring a window drops its note, and the notes of windows closed while set
# aside are dropped here. A window still on its way to the Shelf keeps its own.
mkdir -p "$SHELF_DIR"
OPEN=$(hyprctl clients -j | jq -r '.[].address')
for record in "$SHELF_DIR"/*.json; do
  [[ -f $record ]] || continue
  grep -qxF "$(basename "$record" .json)" <<<"$OPEN" || rm -f "$record"
done

# A fullscreen window comes back to its normal size first, so that size is what
# gets remembered, along with the fullscreen state to return to.
NORMAL=$CLIENT
if (( $(jq '.fullscreen' <<<"$CLIENT") )); then
  hyprctl dispatch "hl.dsp.window.fullscreen_state({ internal = 0, client = 0, window = \"$SELECTOR\" })" >/dev/null
  NORMAL=$(client)
fi

MONITOR=$(hyprctl monitors -j | jq -c --argjson id "$(jq '.monitor' <<<"$CLIENT")" 'first(.[] | select(.id == $id)) // {}')

# Written before the window moves, so an interrupted command can never leave a
# window on the Shelf without a note of where it came from. A note that cannot
# be saved stops the window from moving at all.
jq -n --argjson client "$CLIENT" --argjson normal "$NORMAL" --argjson monitor "$MONITOR" --arg order "$(date +%s%3N)" '
  def area: if $monitor.width then
    ($monitor.width / $monitor.scale) as $w | ($monitor.height / $monitor.scale) as $h
    | (if ($monitor.transform // 0) % 2 == 1 then [$h, $w] else [$w, $h] end) as [$width, $height]
    | ($monitor.reserved // [0, 0, 0, 0]) as [$left, $top, $right, $bottom]
    | [$monitor.x + $left, $monitor.y + $top, $width - $left - $right, $height - $top - $bottom]
  else null end;
  {
    address: $client.address,
    pid: $client.pid,
    initialClass: $client.initialClass,
    workspace: $client.workspace.name,
    monitor: ($monitor.name // ""),
    monitorArea: area,
    at: $normal.at,
    size: $normal.size,
    floating: $client.floating,
    fullscreen: $client.fullscreen,
    fullscreenClient: ($client.fullscreenClient // 0),
    pinned: $client.pinned,
    tags: ($client.tags // []),
    order: ($order | tonumber)
  }' >"$SHELF_DIR/$ADDRESS.json.tmp" && mv "$SHELF_DIR/$ADDRESS.json.tmp" "$SHELF_DIR/$ADDRESS.json" || exit 1

if [[ $(jq -r '.pinned' <<<"$CLIENT") == "true" ]]; then
  hyprctl dispatch "hl.dsp.window.pin({ action = \"disable\", window = \"$SELECTOR\" })" >/dev/null
fi

hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:shelf\", follow = false, window = \"$SELECTOR\" })" >/dev/null

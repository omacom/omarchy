#!/bin/bash

# omarchy:summary=Pick a file from a menu
# omarchy:group=menu
# omarchy:name=file
# omarchy:args=label paths formats [menu args...]
# omarchy:examples=omarchy menu file "Select image" "$HOME/Pictures" "jpg png webp"|omarchy-menu-file "Select media" "$HOME/Pictures:$HOME/Videos" "jpg png mp4 mov" --width 800

set -euo pipefail

if (( $# < 3 )); then
  echo "Usage: omarchy-menu-file <label> <paths> <formats> [menu args...]" >&2
  exit 1
fi

label="$1"
paths_arg="$2"
formats_arg="$3"
shift 3

IFS=: read -r -a paths <<<"$paths_arg"
read -r -a formats <<<"$formats_arg"

if (( ${#paths[@]} == 0 || ${#formats[@]} == 0 )); then
  echo "Usage: omarchy-menu-file <label> <paths> <formats> [menu args...]" >&2
  exit 1
fi

for path in "${paths[@]}"; do
  [[ -e $path ]] || { echo "Path not found: $path" >&2; exit 1; }
done

find_args=("${paths[@]}" "(" -type d -name ".*" ! -name "." -prune ")" -o -type f ! -name ".*" "(")
first_format=true
for format in "${formats[@]}"; do
  if [[ $first_format == "true" ]]; then
    first_format=false
  else
    find_args+=(-o)
  fi

  format="${format#.}"
  find_args+=(-iname "*.$format")
done
find_args+=(")" -printf '%T@\t%p\n')

# -L follows a starting point that is itself a symlink (e.g. ~/Videos ->
# /mnt/storage/Videos). Without it find does not descend, so transcode sees
# zero files and omarchy-menu-select fails on empty stdin.
# Cap entry count and total path bytes for ordinary valid-UTF-8 names so
# omarchy-menu-select is less likely to hit a single-argument MAX_ARG_STRLEN
# (~128KiB). LC_ALL=C makes awk length() count bytes (not UTF-8 characters).
# Encoded JSON expansion (escapes / invalid UTF-8 -> U+FFFD) is enforced in
# omarchy-menu-select itself; this budget is only a first cut at the lister.
# Temporarily drop pipefail so SIGPIPE from the consumer does not fail the pipeline.
set +o pipefail
find -L "${find_args[@]}" 2>/dev/null | sort -rn | cut -f2- | LC_ALL=C awk '
  BEGIN { max_n = 500; max_bytes = 80000; n = 0; bytes = 0 }
  {
    len = length($0) + 1
    if (n >= max_n || bytes + len > max_bytes) exit
    print
    n++
    bytes += len
  }
' | omarchy-menu-select "$label" -- --width 800 --maxheight 500 "$@"
status=${PIPESTATUS[4]:-$?}
set -o pipefail
exit "$status"

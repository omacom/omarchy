#!/bin/bash

# omarchy:summary=Toggle recording lock, idle, display and sleep transitions for bug reports

# Off by default: the trail is for reproducing a lock or idle failure, and
# omarchy debug idle prints it alongside the rest of the diagnostics.

readonly unit=omarchy-state-trail.service
unit_source="$OMARCHY_PATH/default/systemd/user/$unit"
trail="$HOME/.local/state/omarchy/state-trail.log"

omarchy-toggle state-trail

if omarchy-toggle-enabled state-trail; then
  # The package does not ship this unit, so it is installed from the checkout
  # on each enable, which also picks up changes to it.
  install -Dm644 "$unit_source" "$HOME/.config/systemd/user/$unit"
  systemctl --user daemon-reload
  systemctl --user enable --now "$unit"
  echo "Recording lock, idle, display and sleep transitions to $trail"
else
  systemctl --user disable --now "$unit"
  echo "Stopped recording. The trail so far stays in $trail"
fi

#!/bin/bash

# omarchy:summary=Have an agent make a new theme, plugin, app, or game
# omarchy:args=<theme|plugin|app|game>
# omarchy:examples=omarchy agent make theme | omarchy agent make app

# A few ways into making Omarchy your own, shared by the agents panel's starter
# tiles and the menu's Agent > Make something. The task goes to the default
# agent.

case "${1:-}" in
theme) prompt="Make me a new Omarchy theme. Ask me what look or inspiration I have in mind, then build it following the omarchy-make-theme skill and switch to it." ;;
plugin) prompt="Make me a new Omarchy shell plugin. Ask me what I'd like it to do, then build it following the omarchy-make-plugin skill and enable it." ;;
app) prompt="Make me a new app for my Omarchy desktop. Ask me what it should do, then build it following the omarchy-make-app skill and install it so it shows up in the app launcher." ;;
game) prompt="Make me a new game for my Omarchy desktop. Ask me what kind of game I'd like, or which game in Game Vibes to keep working on, then build it following the omarchy-make-game skill and open it in Game Vibes." ;;
*)
  echo "Usage: omarchy-agent-make <theme|plugin|app|game>" >&2
  exit 1
  ;;
esac

exec omarchy-agent --pick --prompt "$prompt"

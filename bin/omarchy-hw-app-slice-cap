#!/bin/bash

# omarchy:summary=Cap app.slice MemoryMax at boot on >=64 GiB machines
# omarchy:hidden=true

# On >=64 GiB machines, zram is capped at 8 GiB (<=12.5% of RAM; ~6% at 128 GiB),
# so fast multi-threaded bursts can fill zram in <1s and outrun systemd-oomd.
# Writes /run/systemd/user/app.slice.d/10-omarchy-high-memory.conf at boot
# reserving 11 GiB (8 GiB max zram + ~3 GiB session/system/kernel) outside
# app.slice; overrides or masks in /etc or ~/.config win cleanly.

set -euo pipefail

if (( $# > 0 )); then
  echo "Usage: $(basename "$0")" >&2
  exit 2
fi

meminfo=${OMARCHY_MEMINFO:-/proc/meminfo}
runtime_dir=${OMARCHY_USER_RUNTIME_DIR:-/run/systemd/user}
dropin_dir="$runtime_dir/app.slice.d"
dropin_file="$dropin_dir/10-omarchy-high-memory.conf"
high_memory_kib=58720256
reserve_mib=11264

total_kib=$(awk '$1 == "MemTotal:" { print $2; exit }' "$meminfo" 2>/dev/null || true)
if [[ ! $total_kib =~ ^[0-9]+$ ]] || (( total_kib < high_memory_kib )); then
  exit 0
fi

app_max_mib=$(( total_kib / 1024 - reserve_mib ))
mkdir -p "$dropin_dir"
tmp=$(mktemp "$dropin_dir/.10-omarchy-high-memory.conf.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat >"$tmp" <<CONF
# >=64 GiB machines: reserve 11 GiB outside app.slice so fast bursts stay
# inside cgroup OOM; override or mask in /etc/systemd/user/app.slice.d/ or
# ~/.config/systemd/user/app.slice.d/.
[Slice]
MemoryMax=${app_max_mib}M
CONF
chmod 0644 "$tmp"
mv -f "$tmp" "$dropin_file"

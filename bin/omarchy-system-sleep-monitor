#!/bin/bash

# omarchy:summary=Monitor sleep preparation and lock before suspend
# omarchy:group=system
# omarchy:hidden=true

# logind's delay inhibitor pattern: hold the inhibitor while awake, lock and
# release it when PrepareForSleep(true) announces a suspend, and take it again
# when PrepareForSleep(false) reports the wake. The inhibitor lives exactly as
# long as the systemd-inhibit child that consumes the next sleep event, while a
# single dbus-monitor outlives every cycle, so no wake is missed in between.

consume_sleep_events() {
  local line sleep_lock
  sleep_lock="$OMARCHY_PATH/bin/omarchy-system-sleep-lock"

  while IFS= read -r line; do
    if [[ $line == *"boolean true"* ]]; then
      "$sleep_lock"
      return 0
    fi
  done

  return 1
}

wait_for_wake() {
  local line

  while IFS= read -r line; do
    if [[ $line == *"boolean false"* ]]; then
      return 0
    fi
  done

  return 1
}

monitor_sleep_events() {
  local monitor_fd monitor_pid sleep_monitor
  sleep_monitor="$OMARCHY_PATH/bin/omarchy-system-sleep-monitor"

  exec {monitor_fd}< <(
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
  )
  monitor_pid=$!

  cleanup_monitor() {
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
    exec {monitor_fd}<&-
  }
  trap cleanup_monitor EXIT

  # A failed inhibit, or a bus that went away, ends the monitor so systemd
  # starts it over with a fresh subscription.
  while systemd-inhibit \
      --what=sleep \
      --mode=delay \
      --who=Omarchy \
      --why="Lock screen before suspend" \
      "$sleep_monitor" --consume <&"$monitor_fd" &&
    wait_for_wake <&"$monitor_fd"; do
    :
  done

  cleanup_monitor
  trap - EXIT
  return 1
}

if [[ ${1:-} == "--consume" ]]; then
  consume_sleep_events
  exit
else
  monitor_sleep_events
  exit
fi

#!/bin/bash

# omarchy:summary=Authorize a waiting Thunderbolt device

set -euo pipefail

devices_dir=${OMARCHY_THUNDERBOLT_DEVICES_PATH:-/sys/bus/thunderbolt/devices}
state_file=$HOME/.local/state/omarchy/thunderbolt/notified
state_dir=$(dirname "$state_file")
lock_file=$state_file.lock

# Rewrite the notified-state file without the given id, under the same lock the
# scanner uses, so the two writers cannot clobber each other and each uses its
# own temporary file.
forget_notified_id() {
  local id=$1
  local tmp

  mkdir -p "$state_dir"
  if exec {lock_fd}>"$lock_file" 2>/dev/null && flock -w 10 "$lock_fd"; then
    if [[ -f $state_file ]]; then
      tmp=$(mktemp "$state_file.XXXXXX")
      while IFS= read -r known_id; do
        [[ -n $known_id && $known_id != "$id" ]] || continue
        printf '%s\n' "$known_id"
      done <"$state_file" >"$tmp"
      mv "$tmp" "$state_file"
    fi
    exec {lock_fd}<&-
  fi
}

# Same detection as omarchy-thunderbolt-check: only real peripherals expose all
# three attributes, domain0 never does, and the host router 0-0 is skipped by
# name because newer kernels expose the trio for it too.
waiting_ids=()
declare -A device_paths=()
declare -A device_names=()
declare -A device_vendors=()
declare -A device_generations=()

if [[ -d $devices_dir ]]; then
  for device_path in "$devices_dir"/*/; do
    device_dir=$(basename "$device_path")
    [[ $device_dir != domain* && $device_dir != "0-0" ]] || continue

    # A device can be unplugged mid-scan and its sysfs directory vanishes with
    # it; read every attribute tolerantly so a failed read skips the device
    # instead of aborting under set -e. unique_id is the real requirement.
    authorized=$(cat "${device_path}authorized" 2>/dev/null) || continue
    [[ $authorized == "0" ]] || continue

    unique_id=$(cat "${device_path}unique_id" 2>/dev/null) || continue
    [[ -n $unique_id ]] || continue

    waiting_ids+=("$unique_id")
    device_paths[$unique_id]=$device_path
    # device_name is optional; fall back to the unique id when it is missing,
    # unparseable, or empty, so the menu never shows a blank name.
    device_names[$unique_id]=$(cat "${device_path}device_name" 2>/dev/null) || device_names[$unique_id]="$unique_id"
    [[ -n ${device_names[$unique_id]} ]] || device_names[$unique_id]="$unique_id"
    device_vendors[$unique_id]=$(cat "${device_path}vendor_name" 2>/dev/null) || device_vendors[$unique_id]=""
    device_generations[$unique_id]=$(cat "${device_path}generation" 2>/dev/null) || device_generations[$unique_id]=""
  done
fi

if ((${#waiting_ids[@]} == 0)); then
  enrolled_count=$(boltctl list | grep -c '^ \*' || true)
  echo "No Thunderbolt devices waiting for authorization."
  echo "Connected devices: $enrolled_count"
  exit 0
fi

for unique_id in "${waiting_ids[@]}"; do
  name=${device_names[$unique_id]}
  vendor=${device_vendors[$unique_id]}
  generation=${device_generations[$unique_id]}

  gum style --bold -- "$name"
  [[ -n $vendor ]] && gum style "  Vendor: $vendor"
  (( generation > 0 )) && gum style "  Generation: $generation"
  gum style "  ID: $unique_id"

  # Cancelled gum (Esc or Ctrl-C) exits non-zero; treat that as a clean exit.
  choice=$(gum choose --header "Authorize $name?" \
    "Authorize for this session" \
    "Authorize permanently (enroll)" \
    "Skip") || exit 0

  case $choice in
  "Authorize for this session")
    action=authorize
    ;;
  "Authorize permanently (enroll)")
    action=enroll
    ;;
  "Skip")
    continue
    ;;
  esac

  if boltctl "$action" "$unique_id" >/dev/null 2>&1; then
    boltctl_status=0
  else
    boltctl_status=$?
  fi

  # boltctl returns before the sysfs attribute flips, so give it a beat before
  # trusting the kernel state.
  sleep 1

  # The device can be unplugged while the menu is open, so a failed read is an
  # unsuccessful action, not a crash.
  authorized_path="${device_paths[$unique_id]}authorized"
  authorized_now=0
  if [[ -r $authorized_path ]]; then
    authorized_now=$(cat "$authorized_path" 2>/dev/null) || authorized_now=0
  fi

  if (( boltctl_status == 0 && authorized_now != 0 )); then
    gum style --foreground 2 -- "$name is authorized for this system."

    # Forget that this device was notified, so the next unauthorized event
    # starts fresh instead of staying silent.
    forget_notified_id "$unique_id"

    omarchy-notification-send -u normal -g ⚡ "Thunderbolt device authorized" \
      "$name is authorized and its ports are active." || true
  else
    gum style --foreground 1 --bold -- "Failed to authorize $name (boltctl exit code $boltctl_status)."
    gum style --foreground 1 -- "Check 'boltctl list' for the device state, then run omarchy-thunderbolt again."
  fi
done

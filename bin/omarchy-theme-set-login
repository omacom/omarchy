#!/bin/bash

# omarchy:summary=Apply the current theme colors to the boot splash and login screen
# omarchy:hidden=true

# The boot splash draws before the disk is unlocked, so it reads its colors
# from the ESP, and the login screen runs as the greeter user; both copies are
# root's to write, which omarchy-theme-set-login-colors does.
SYSTEM_COPY=/var/lib/omarchy/login/colors

# Both are the machine's, and the passwordless grant to write them
# (etc/sudoers.d/omarchy-theme-login) is wheel's. Anyone else would be asked to
# authenticate on every theme change; their theme stays their own.
if (( EUID != 0 )) && [[ " $(id -Gn) " != *" wheel "* ]]; then
  exit 0
fi

declare -A palette=()
while IFS=$'\t' read -r key value; do
  palette[$key]=$value
done < <(omarchy-theme-color --all)

# Six lowercase hex digits, without the "#": the form the writer and its
# sudoers rule take.
hex() {
  local value=${palette[$1]:-}
  value=${value#\#}
  value=${value,,}
  if [[ $value =~ ^[0-9a-f]{6}$ ]]; then
    echo "$value"
  else
    echo "$2"
  fi
}

# SplashColors.qml's defaults, for any color a theme leaves out, repeated here
# because the writer takes all four.
background=$(hex background 1a1b26)
foreground=$(hex foreground a9b1d6)
accent=$(hex accent 7aa2f7)
error=$(hex red f7768e)

# Skip the privileged write when the colors are already in place: this must
# match what the writer writes (omarchy-theme-set-login-colors), or every theme
# change writes again. The writer adds a line when the boot splash's copy did
# not take them, so they are written again.
expected="background=#$background"$'\n'"foreground=#$foreground"$'\n'"accent=#$accent"$'\n'"error=#$error"
if [[ -f $SYSTEM_COPY && $(<"$SYSTEM_COPY") == "$expected" ]]; then
  exit 0
fi

exec omarchy-theme-set-login-colors "$background" "$foreground" "$accent" "$error"

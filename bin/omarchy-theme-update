#!/bin/bash

# omarchy:summary=Update user-installed git themes

mapfile -t themes < <(omarchy-theme-extras)

rc=0
for theme in "${themes[@]}"; do
  echo "Updating: $(basename "$theme")"
  if ! origin_url=$(git -C "$theme" remote get-url origin 2>/dev/null) || [[ -z $origin_url ]]; then
    echo "omarchy-theme-update: $(basename "$theme") has no readable origin URL" >&2
    rc=1
    continue
  fi
  if ! omarchy-git-url-check --require-authenticated-network "$origin_url"; then
    echo "omarchy-theme-update: $(basename "$theme") cannot be updated from its current origin." >&2
    echo "Set it to an HTTPS, SSH, FTPS, or local URL before updating:" >&2
    printf '  git -C %q remote set-url origin URL\n' "$theme" >&2
    rc=1
    continue
  fi
  git -C "$theme" pull || rc=1
done

exit $rc

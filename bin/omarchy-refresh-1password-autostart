#!/bin/bash

# omarchy:summary=Pin the device scale factor in 1Password's autostart entry.
# omarchy:hidden=true

set -euo pipefail

autostart="$HOME/.config/autostart/com.onepassword.OnePassword.desktop"

if [[ -f $autostart && ! -L $autostart ]]; then
  temporary=$(mktemp "${autostart}.XXXXXX")
  trap 'rm -f "$temporary"' EXIT

  sed -E '/--force-device-scale-factor/! s#^(Exec=(/opt/1Password/1password|1password))([[:space:]]|$)#\1 --force-device-scale-factor=1\3#' "$autostart" >"$temporary"

  if ! cmp -s "$autostart" "$temporary"; then
    chmod --reference="$autostart" "$temporary"
    mv -f "$temporary" "$autostart"
  fi
fi

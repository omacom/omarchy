#!/bin/bash

# omarchy:summary=Keep 1Password autostart display scaling consistent.
# omarchy:hidden=true

set -euo pipefail

# 1Password rewrites its desktop file on each launch. Override the generated
# systemd service instead, for both the current and pre-8.12 desktop filenames.
changed=false
for unit in app-com.onepassword.OnePassword@autostart.service app-1password@autostart.service; do
  directory="$HOME/.config/systemd/user/$unit.d"
  dropin="$directory/90-omarchy-scale.conf"
  [[ ! -L $dropin ]] || continue
  mkdir -p "$directory"
  temporary=$(mktemp "$directory/.scale.XXXXXX")
  trap 'rm -f "$temporary"' EXIT
  cat >"$temporary" <<'CONF'
# Managed by omarchy-refresh-1password-autostart.
[Service]
ExecStart=
ExecStart=:/opt/1Password/1password --silent --force-device-scale-factor=1
CONF
  chmod 644 "$temporary"
  if [[ ! -f $dropin ]] || ! cmp -s "$dropin" "$temporary"; then
    mv -f "$temporary" "$dropin"
    changed=true
  else
    rm -f "$temporary"
  fi
done

if [[ $changed == "true" ]]; then
  # Installation/migration can also run without a user manager. The files
  # will be picked up at the next graphical login in that case.
  systemctl --user daemon-reload || true
fi

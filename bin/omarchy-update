#!/bin/bash

# omarchy:summary=Update Omarchy and system packages
# omarchy:alias=omarchy up
# omarchy:args=[-y]
# omarchy:examples=omarchy update | omarchy update -y
# omarchy:requires-sudo=true

set -e

update_stay_awake_stopped=0
sudo_keepalive_pid=""
failed_units_before=""
snapshot_taken=0

# Ask for the password once, then keep sudo's timestamp fresh so long package
# downloads, migrations, hooks, and mise never outlast it and prompt again.
# Authorize by running a command rather than sudo -v: under the default
# verifypw=all, -v prompts even when passwordless sudo is enabled.
authorize_update() {
  sudo true || return 1

  local update_pid=$$
  (
    [[ -z ${OMARCHY_UPDATE_LOCK_FD:-} ]] || exec {OMARCHY_UPDATE_LOCK_FD}>&-
    sleep_pid=""
    trap - EXIT HUP INT
    trap '[[ -z $sleep_pid ]] || kill "$sleep_pid" 2>/dev/null; exit 0' TERM
    while :; do
      sleep 60 &
      sleep_pid=$!
      wait "$sleep_pid"
      kill -0 "$update_pid" 2>/dev/null || exit 0
      sudo -n true 2>/dev/null || exit 0
    done
  ) &
  sudo_keepalive_pid=$!
}

end_update_authorization() {
  if [[ -n $sudo_keepalive_pid ]]; then
    kill "$sudo_keepalive_pid" 2>/dev/null || true
    wait "$sudo_keepalive_pid" 2>/dev/null || true
    sudo_keepalive_pid=""
  fi
}

cleanup_update() {
  local status=$?
  trap - EXIT HUP INT TERM
  end_update_authorization
  if (( update_stay_awake_stopped == 0 )); then
    omarchy-update-stay-awake stop || status=1
  fi
  [[ -z $failed_units_before ]] || rm -rf "$failed_units_before"
  exit "$status"
}

if [[ -z ${OMARCHY_UPDATE_LOGGED:-} ]]; then
  # Keep an untrapped shell as the PTY session leader. If script disappears,
  # its hangup must reach the foreground prompt, not wait on our signal traps.
  # script uses SHELL to interpret this Bash command; restore the caller's
  # value inside it so hooks and package builds keep their original environment.
  if [[ ${SHELL@a} == *x* ]]; then
    printf -v script_command 'export SHELL=%q; ' "$SHELL"
  else
    script_command='unset SHELL; '
  fi
  script_command+="$(printf '%q ' "$0" "$@"); exit \$?"
  exec env OMARCHY_UPDATE_LOGGED=1 SHELL=/usr/bin/bash script -qefc "$script_command" "/tmp/omarchy-update.log"
fi

if ! omarchy-update-lock held; then
  exec omarchy-update-lock run "$0" "$@"
fi

trap 'echo ""; echo -e "\033[0;31m$(omarchy-i18n update.failed)\n\n$(omarchy-i18n update.failedReview)\n\n$(omarchy-i18n update.failedHelp https://omarchy.org/discord)\033[0m"' ERR
trap cleanup_update EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

# The units that had already failed, so the health report at the end can tell
# them from units this update broke. A list that could not be read is left
# out, and the report then treats every failed unit in that scope as unknown.
record_failed_units() {
  local list="$failed_units_before/$1" units
  shift

  units=$(timeout --kill-after=1 5 systemctl "$@" --failed --plain --no-legend 2>/dev/null) || return 0
  awk 'NF { print $1 }' <<<"$units" >"$list" || rm -f "$list"
}

# The package database's problems, likewise. pacman -Dk prints them as errors
# and exits non-zero (1 to 3, one for each kind of problem) when it finds any;
# a list it could not finish is left out.
record_package_problems() {
  local list="$failed_units_before/packages" status=0

  timeout --kill-after=1 5 pacman -Dkq >"$list" 2>&1 || status=$?
  (( status <= 3 )) || rm -f "$list"
}

if failed_units_before=$(mktemp -d /tmp/omarchy-update-failed-units.XXXXXX 2>/dev/null); then
  record_failed_units system
  record_failed_units user --user
  record_package_problems
else
  failed_units_before=""
fi

omarchy-update-requires-free-space

# -y skips the start confirmation and, unless the caller set
# OMARCHY_UPDATE_UNATTENDED itself, suppresses Omarchy confirmation prompts;
# sudo authorization is still required. Interactive review steps report and
# move on instead of waiting.
[[ ${1:-} != "-y" ]] || export OMARCHY_UPDATE_UNATTENDED=${OMARCHY_UPDATE_UNATTENDED:-1}

if [[ ${1:-} == "-y" ]] || omarchy-update-confirm; then
  authorize_update

  # Before the snapshot: the cache is on the snapshotted subvolume, so pruning
  # after it frees nothing until that snapshot ages out.
  omarchy-update-pkg-prune

  # 127 means Snapper is deliberately absent. Any other failure already said
  # what went wrong, and a missing snapshot is not worth blocking an update
  # over, but it must not pass for one either.
  # With no boot loader Omarchy manages, no boot menu lists the snapshot and
  # restore has nothing to boot it with, so there is none to point back to.
  if omarchy-snapshot create; then
    [[ $(omarchy-boot-backend 2>/dev/null) == "none" ]] || snapshot_taken=1
  elif (( $? != 127 )); then
    echo -e "\e[33m$(omarchy-i18n update.noSnapshot)\e[0m" >&2
  fi

  omarchy-update-stay-awake start

  # Preserve the established development-checkout update ordering.
  omarchy-update-dev
  omarchy-update-keyring

  # Migrations ship with the packages installed here and are written against
  # them, so everything below waits on this finishing. An upgrade that stopped
  # takes the update with it rather than migrating against what is still on disk.
  omarchy-update-system-pkgs

  # Migrations call the shell over IPC, so give them one running current code.
  if omarchy-migrate --pending >/dev/null; then
    omarchy-restart-shell || true
  fi
  omarchy-migrate
  omarchy-update-orphan-pkgs -y

  omarchy-update-analyze-logs

  # The dev checkout was fast-forwarded and the full upgrade went through, so
  # there is no Omarchy update left to show. Rechecking would download every
  # sync database again and refetch the checkout only to hear the same.
  omarchy-done mark first-update
  omarchy-shell -q omarchy.system-update clear

  # Service restart helpers can need sudo. The reboot-only phase below
  # performs no privileged work.
  omarchy-update-restart --services-only

  omarchy-hook post-update
  # Optional tool downloads must not skip boot verification or the reboot
  # prompt after system packages have already been upgraded.
  mise_updated=1
  omarchy-update-mise || mise_updated=0

  # AUR packages build against the upgraded system, so they go after it, and
  # share the update's one authorization like every step before them.
  omarchy-update-aur-pkgs

  # The last sudo-capable step: the boot files every package step left, AUR
  # packages' initramfs rebuilds included, must be shown to boot the updated
  # system. Until it passes, the update neither finishes nor offers a reboot.
  boot_verified=1
  omarchy-update-boot || boot_verified=0
  end_update_authorization

  # The sleep inhibitor covers AUR builds, hooks and mise as well. Release it
  # before offering a reboot: a confirmed reboot can terminate this
  # process before its EXIT trap gets a chance to remove the persistent Stay
  # Awake marker.
  omarchy-update-stay-awake stop
  update_stay_awake_stopped=1

  # Report whether the desktop and services answer before the reboot offer.
  # The report is information only, so nothing it finds may end the update.
  # It is told which units had failed and which package database problems were
  # there before the update, and whether there is a snapshot to return to, so
  # its advice fits this update. A snapshot only counts once the boot files
  # passed: with them unverified the update says not to reboot, and the report
  # must not say to reboot into the snapshot.
  OMARCHY_UPDATE_HEALTH_BASELINE="$failed_units_before" OMARCHY_UPDATE_HEALTH_SNAPSHOT="$(( snapshot_taken && boot_verified ))" \
    omarchy-update-health || true

  if (( mise_updated == 0 )); then
    echo -e "\e[33m\n$(omarchy-i18n update.miseFailed "'omarchy update mise'")\e[0m" >&2
  fi

  if (( boot_verified )); then
    "$OMARCHY_PATH/bin/omarchy-update-restart" --reboot-only
  else
    echo -e "\e[31m\n$(omarchy-i18n update.bootUnverified "omarchy update")\e[0m" >&2
    exit 1
  fi
fi

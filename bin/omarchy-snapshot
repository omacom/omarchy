#!/bin/bash

# omarchy:summary=Create or restore system snapshots with snapper
# omarchy:args=<create|restore>
# omarchy:requires-sudo=true

set -e

COMMAND="$1"

if [[ -z $COMMAND ]]; then
  echo "Usage: omarchy-snapshot <create|restore>" >&2
  exit 1
fi

if omarchy-cmd-missing snapper; then
  exit 127 # omarchy-update can use this to just ignore if snapper is not available
fi

case "$COMMAND" in
create)
  # The description is just a label, so never let it abort the snapshot.
  DESC="$(omarchy-version 2>/dev/null || echo unknown)"

  # Capture list-configs on its own so a failed sudo is not mistaken for an
  # empty config list. Process substitution hides the command's exit status,
  # which previously reported "No Snapper configs found" and pointed users at
  # install/config/snapper.sh — a script that overwrites a working root config.
  # Keep stderr on the terminal so sudo can still prompt for a password.
  if ! configs_csv="$(sudo snapper --csvout list-configs)"; then
    # Any non-zero status lands here (sudo, D-Bus, snapper). Snapper's own
    # stderr already printed above; keep this line cause-neutral.
    echo -e "\e[31mCould not list Snapper configs.\e[0m" >&2
    exit 1
  fi

  mapfile -t CONFIGS < <(printf '%s\n' "$configs_csv" | awk -F, 'NR>1 {print $1}')

  # Snapper installed but listing nothing snapshots nothing. Staying quiet here
  # reads as a successful snapshot, so the next update looks recoverable when
  # nothing has ever been captured. An exit-0 header-only listing also happens
  # when /etc/snapper/configs/root exists but is unregistered, unreadable, or
  # empty — never point those at snapper.sh, which overwrites that file.
  if (( ${#CONFIGS[@]} == 0 )); then
    snapper_root=${OMARCHY_SNAPPER_CONFIG_PATH:-/etc/snapper/configs/root}
    snapper_conf=${OMARCHY_SNAPPER_CONF_PATH:-/etc/conf.d/snapper}

    echo -e "\e[33mNo Snapper configs found, so no snapshot was created.\e[0m" >&2
    if [[ -e $snapper_root ]]; then
      echo "A config file exists at $snapper_root but Snapper did not list it." >&2
      echo "Check SNAPPER_CONFIGS in $snapper_conf and permissions on the config file." >&2
    else
      echo "Configure Snapper with: sudo bash -euo pipefail \"$OMARCHY_PATH/install/config/snapper.sh\"" >&2
    fi
    exit 1
  fi

  echo -e "\e[32mCreate system snapshot\e[0m"

  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number -d "$DESC"
    sudo snapper -c "$config" cleanup number
  done

  echo "Snapshots can be selected during boot."
  ;;
restore)
  sudo limine-snapper-restore
  ;;
esac

#!/bin/bash

# omarchy:summary=Create, list, boot into or restore system snapshots
# omarchy:args=<create|list|boot NUMBER|restore [NUMBER|backup|--cancel]>
# omarchy:examples=omarchy snapshot create | omarchy snapshot boot 12 | omarchy snapshot restore 12
# omarchy:requires-sudo=true

set -e

COMMAND="$1"
STORE=${OMARCHY_BOOT_STORE:-/var/lib/omarchy/boot}

if [[ -z $COMMAND ]]; then
  echo "Usage: omarchy-snapshot <create|list|boot NUMBER|restore [NUMBER|backup|--cancel]>" >&2
  exit 1
fi

if omarchy-cmd-missing snapper; then
  exit 127 # omarchy-update can use this to just ignore if snapper is not available
fi

backend=$(omarchy-boot-backend)

# The snapshot the running system was booted from, if any.
booted_snapshot() {
  sed -n 's#.*rootflags=[^ ]*subvol=[^ ,]*/\.snapshots/\([0-9]*\)/snapshot.*#\1#p' /proc/cmdline
}

# entries: PROFILE-ID <TAB> ENTRY-ID <TAB> TITLE, written by omarchy-boot-sync.
snapshot_entries() {
  [[ -f $STORE/entries ]] && awk -F'\t' '$1 ~ /^snapshot-[0-9]+$/ { sub(/^snapshot-/, "", $1); print $1 "\t" $2 "\t" $3 }' "$STORE/entries" | sort -rn
  return 0
}

confirm_reboot() {
  if gum confirm "$1"; then
    omarchy-system reboot
  else
    echo "It happens at the next reboot."
  fi
}

case "$COMMAND" in
create)
  # The description is just a label, so never let it abort the snapshot.
  DESC="$(omarchy-version 2>/dev/null || echo unknown)"

  # Get existing snapper config names from CSV output
  mapfile -t CONFIGS < <(sudo snapper --csvout list-configs | awk -F, 'NR>1 {print $1}')

  # Snapper installed but unconfigured snapshots nothing. Staying quiet here
  # reads as a successful snapshot, so the next update looks recoverable when
  # nothing has ever been captured.
  if (( ${#CONFIGS[@]} == 0 )); then
    echo -e "\e[33mNo Snapper configs found, so no snapshot was created.\e[0m" >&2
    echo "Configure Snapper with: sudo bash -euo pipefail \"$OMARCHY_PATH/install/config/snapper.sh\"" >&2
    exit 1
  fi

  echo -e "\e[32mCreate system snapshot\e[0m"

  for config in "${CONFIGS[@]}"; do
    sudo snapper -c "$config" create -c number -d "$DESC"
    sudo snapper -c "$config" cleanup number
  done

  # On systemd-boot the snapshot's boot entry is built by omarchy-boot-sync;
  # wait for it, so an update only goes ahead once its rollback point boots.
  if [[ $backend == systemd-boot ]] && ! sudo omarchy-boot-sync sync >/dev/null; then
    echo -e "\e[33mThe snapshot was taken but its boot entry could not be built.\e[0m" >&2
    exit 1
  fi

  echo "Snapshots can be selected during boot."
  ;;
list)
  if [[ $backend == systemd-boot ]]; then
    snapshot_entries | awk -F'\t' '{ print $1 "\t" $3 }'
  else
    sudo snapper -c root list
  fi
  ;;
boot)
  [[ $backend == systemd-boot ]] || { echo "Pick a snapshot from the Limine boot menu instead." >&2; exit 1; }
  number=${2:-}
  [[ $number =~ ^[0-9]+$ ]] || { echo "Usage: omarchy-snapshot boot NUMBER" >&2; exit 1; }
  entry=$(snapshot_entries | awk -F'\t' -v n="$number" '$1 == n { print $2; exit }')
  [[ -n $entry ]] || { echo "Snapshot $number has no boot entry." >&2; exit 1; }
  # Only arm an entry whose image is on the ESP.
  sudo test -s "/boot/EFI/Linux/${entry%%@*}" || { echo "The boot image of snapshot $number is missing." >&2; exit 1; }
  sudo bootctl set-oneshot "$entry"
  echo "The next boot starts snapshot $number. Changes made while it runs are discarded at the reboot after; restore it to keep it."
  confirm_reboot "Reboot into snapshot $number now?"
  ;;
restore)
  if [[ $backend != systemd-boot ]]; then
    sudo limine-snapper-restore
    exit
  fi
  target=${2:-}
  if [[ $target == --cancel ]]; then
    sudo omarchy-boot-sync restore-cancel
    exit
  fi
  [[ -n $target ]] || target=$(booted_snapshot)
  if [[ -z $target ]]; then
    target=$(snapshot_entries | awk -F'\t' '{ print $1 "  " $3 }' | gum choose --header "Restore which snapshot?" | awk '{ print $1 }') || exit 1
  fi
  [[ -n $target ]] || exit 1

  if [[ $target == backup ]]; then
    echo "This puts back the system as it was before the last restore."
  else
    echo "Snapshot $target becomes the system. The system as it is now is kept, and"
    echo "can be booted from the menu as \"Before restore\" to go back."
    echo "Your home directory is not affected."
  fi
  gum confirm "Restore?" || exit 1
  sudo omarchy-boot-sync restore-stage "$target"
  confirm_reboot "The restore happens while the machine restarts. Reboot now?"
  ;;
*)
  echo "Usage: omarchy-snapshot <create|list|boot NUMBER|restore [NUMBER|backup|--cancel]>" >&2
  exit 1
  ;;
esac

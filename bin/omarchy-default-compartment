#!/bin/bash

# omarchy:summary=Pick which compartment `omarchy agent` routes into
# omarchy:args=[<name>]
# omarchy:examples=omarchy default compartment hermes-coding | omarchy default compartment

set -euo pipefail
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/vmctl/default-compartment"
if [ $# -eq 0 ]; then cat "$CONF" 2>/dev/null || echo "none"; exit 0; fi
mkdir -p "$(dirname "$CONF")"; echo "$1" > "$CONF"
echo "default compartment: $1"
echo "wire it: omarchy-agent will route agent launches here via vmctl"

#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting an update

# A metered link (a phone hotspot, or one the user marked as limited) gets one
# warning per network. Confirming on it once records the NetworkManager profile,
# so that network never asks again while a different one still does.
metered_networks="$HOME/.local/state/omarchy/update-metered-networks"

metered_uuid=""
metered_name=""

# The device traffic leaves by, then the main table's preferred default
# route — checked per address family, because an IPv6-only link has no
# IPv4 default route at all and would otherwise escape the warning.
# A full-tunnel VPN (a Tailscale exit node, WARP) routes through its own
# device with a policy rule, while the link carrying the tunnel keeps
# that default.
ipv4_device=$(ip route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
ipv4_default_device=$(ip -o route show default 2>/dev/null | awk '{
  metric = 0
  for (i = 1; i <= NF; i++) {
    if ($i == "dev") dev = $(i + 1)
    if ($i == "metric") metric = $(i + 1)
  }
  print metric, dev
}' | sort -n | awk 'NR == 1 { print $2 }')
ipv6_device=$(ip -6 route get 2001:4860:4860::8888 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
ipv6_default_device=$(ip -6 -o route show default 2>/dev/null | awk '{
  metric = 0
  for (i = 1; i <= NF; i++) {
    if ($i == "dev") dev = $(i + 1)
    if ($i == "metric") metric = $(i + 1)
  }
  print metric, dev
}' | sort -n | awk 'NR == 1 { print $2 }')

for device in "$ipv4_device" "$ipv4_default_device" "$ipv6_device" "$ipv6_default_device"; do
  [[ -n $device ]] || continue
  [[ $(nmcli -g GENERAL.METERED device show "$device" 2>/dev/null) == yes* ]] || continue

  # A remembered network is settled, but traffic can still leave by another
  # family's link, so keep looking until one needs the warning.
  uuid=$(nmcli -g GENERAL.CON-UUID device show "$device" 2>/dev/null)
  if [[ -n $uuid ]] && ! grep -qxF "$uuid" "$metered_networks" 2>/dev/null; then
    metered_uuid=$uuid
    metered_name=$(nmcli -g GENERAL.CONNECTION device show "$device" 2>/dev/null | sed 's/\\:/:/g')
    break
  fi
done

lines=(
  "$(omarchy-i18n update.ready)"
  ""
  "• $(omarchy-i18n update.cannotStop)"
  "• $(omarchy-i18n update.connectPower)"
)

if [[ -n $metered_uuid ]]; then
  lines+=(
    "• $(omarchy-i18n update.meteredNetwork "${metered_name:-$(omarchy-i18n update.meteredFallback)}")"
    "  $(omarchy-i18n update.meteredHint)"
  )
fi

lines+=(
  ""
  "$(omarchy-i18n update.whatsNew "https://github.com/omacom/omarchy/releases/latest")"
)

gum style --border normal --padding "1 2" "${lines[@]}"

echo

if ! gum confirm --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n update.continue)"; then
  echo "Update cancelled"
  exit 1
fi

# Remembering the network is a courtesy; failing to save it must not cancel
# the update the user just confirmed.
if [[ -n $metered_uuid ]]; then
  if ! { mkdir -p "${metered_networks%/*}" && printf '%s\n' "$metered_uuid" >>"$metered_networks"; } 2>/dev/null; then
    echo "Couldn't remember this network; you'll be asked about it again next time."
  fi
fi

exit 0

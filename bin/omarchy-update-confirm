#!/bin/bash

# omarchy:summary=Prompt for confirmation before starting an update

gum style --border normal --padding "1 2" \
  "$(omarchy-i18n update.ready)" \
  "" \
  "• $(omarchy-i18n update.cannotStop)" \
  "• $(omarchy-i18n update.connectPower)" \
  "" \
  "$(omarchy-i18n update.whatsNew "https://github.com/omacom/omarchy/releases/latest")"

echo

yes=$(omarchy-i18n common.yes)
no=$(omarchy-i18n common.no)

# Exit 0 to update, 1 to cancel, 2 to update and turn automatic updates on.
if systemctl is-enabled --quiet omarchy-update-auto.timer 2>/dev/null; then
  if ! gum confirm --affirmative "$yes" --negative "$no" "$(omarchy-i18n update.continue)"; then
    echo "Update cancelled"
    exit 1
  fi
else
  automatically=$(omarchy-i18n update.automatically)
  choice=$(gum choose --header "$(omarchy-i18n update.continue)" "$yes" "$automatically" "$no") || choice=$no

  if [[ $choice == "$automatically" ]]; then
    exit 2
  elif [[ $choice != "$yes" ]]; then
    echo "Update cancelled"
    exit 1
  fi
fi

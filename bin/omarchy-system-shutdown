#!/bin/bash

# omarchy:summary=Shut down after closing application windows
# omarchy:examples=omarchy shutdown | omarchy system shutdown
# omarchy:aliases=omarchy shutdown

if [[ ${1:-} == "--inhibited" ]]; then
  # Close windows in the background so they cannot delay power-off.
  (
    omarchy-osd -i shutdown -m "Shutting down" -d 5000
    omarchy-state clear re*-required
    omarchy-hyprland-window-close-all
  ) &

  sleep 2 # Allow apps like Chrome to shut down correctly
  systemctl poweroff --no-wall
elif [[ ${1:-} == "--inhibit" ]]; then
  # Report failures from inside the service, independently of the launching terminal.
  # Block lid handling explicitly: it ignores high-level sleep inhibitors.
  systemd-inhibit --what=sleep:idle:handle-lid-switch \
    --who=Omarchy --why="Shutdown in progress" --mode=block \
    "$0" --inhibited || {
    status=$?
    omarchy-notification-send -u critical "Shutdown failed" "Could not complete shutdown. Please try again."
    exit "$status"
  }
else
  # tmux/SSH/bare TTY often drop the session bus even when a graphical session exists.
  if [[ -z ${XDG_RUNTIME_DIR:-} ]]; then
    export XDG_RUNTIME_DIR=/run/user/$(id -u)
  fi
  if [[ -z ${DBUS_SESSION_BUS_ADDRESS:-} && -S $XDG_RUNTIME_DIR/bus ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  fi

  # Schedule the shutdown in the user manager so closing the terminal's systemd
  # scope cannot terminate it. Fall back to the system manager when no user bus is available.
  if ! systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
    "$OMARCHY_PATH/bin/omarchy-system-shutdown" --inhibit; then
    systemd-run --system --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
      "$OMARCHY_PATH/bin/omarchy-system-shutdown" --inhibit
  fi
fi

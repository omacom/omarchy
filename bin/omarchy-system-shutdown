#!/bin/bash

# omarchy:summary=Shut down after closing application windows
# omarchy:examples=omarchy shutdown | omarchy system shutdown
# omarchy:aliases=omarchy shutdown

# Runs from the user manager for the same reasons as omarchy-system-reboot.
systemd-run --user --collect --quiet --unit=omarchy-system-exit "$OMARCHY_PATH/bin/omarchy-system-exit" shutdown

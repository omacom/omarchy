#!/bin/bash

# omarchy:summary=Shut down after closing application windows
# omarchy:examples=omarchy shutdown | omarchy system shutdown
# omarchy:aliases=omarchy shutdown

# Capture before windows close; a failed snapshot must not prevent shutdown.
timeout 5 omarchy-session prepare-exit || true

# Schedule the shutdown in the user manager so closing the terminal's systemd
# scope cannot terminate it before it runs.
systemd-run --user --collect --quiet --on-active="2s" --timer-property=AccuracySec=100ms systemctl poweroff --no-wall || { omarchy-session cancel-exit; exit 1; }

omarchy-osd -i shutdown -m "Shutting down" -d 5000

omarchy-state clear re*-required

# Now close all windows
omarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly

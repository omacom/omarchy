#!/bin/bash

# omarchy:summary=Add a shell plugin from git
# omarchy:group=plugin
# omarchy:args=[git-url] [--yolo|--trusted-local] [--inspect|--stage] [--commit <sha>] [--json] [--enable] [--yes]
# omarchy:examples=omarchy plugin add https://github.com/acme/omarchy-weather.git | omarchy plugin add ./my-plugin --trusted-local
# omarchy:alias=omarchy plugin install

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
mode="ward"
explicit_mode=0
inspect=0
review_stage=0
json=0
expected_commit=""

fail() {
  echo "omarchy-plugin-add: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

ENABLE_PLACEMENT=()

select_bar_widget_placement() {
  local id="$1"
  local section
  local default_section
  interactive || return 0
  (( ASSUME_YES )) && return 0

  jq -e '(.kinds // []) | (index("bar") | not) and (index("bar-widget") != null)' \
    "$PLUGINS_DIR/$id/manifest.json" >/dev/null 2>&1 || return 0

  default_section=$(jq -r '.barWidget.defaultSection // "center"' "$PLUGINS_DIR/$id/manifest.json")
  section=$(printf '%s\n' left center right |
    gum choose --header="Place $id in which bar section?" --selected "$default_section") || return 0
  [[ -n $section ]] || return 0
  ENABLE_PLACEMENT=(--section "$section")
}

plugin_id_manifest() {
  omarchy-plugin-catalog | jq -r --arg id "$1" '
    map(select(.id == $id))[0].manifestPath // empty
  '
}

url=""
enable_after=""

while (( $# > 0 )); do
  case "$1" in
  --commit)
    expected_commit="${2:-}"
    [[ $expected_commit =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]] || fail "--commit requires an exact Git commit"
    shift 2
    ;;
  --yolo | --trusted-local)
    (( explicit_mode == 0 )) || fail "choose only one execution mode"
    mode="${1#--}"
    explicit_mode=1
    shift
    ;;
  --inspect)
    inspect=1
    shift
    ;;
  --stage)
    review_stage=1
    shift
    ;;
  --json)
    json=1
    shift
    ;;
  --enable)
    enable_after=true
    shift
    ;;
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin add [git-url] [--yolo|--trusted-local] [--inspect|--stage] [--commit <sha>] [--json] [--enable] [--yes]"
    echo "Defaults to Ward isolation. --yolo explicitly trusts unsandboxed in-process code."
    echo "--trusted-local accepts only an existing local Git folder. --yes never selects YOLO."
    echo "--inspect clones and validates without installing or running code."
    echo "--stage retains a unique Ward checkout for permission review; requires --json."
    exit 0
    ;;
  -*)
    fail "unknown add option: $1"
    ;;
  *)
    [[ -z $url ]] || fail "unexpected argument: $1"
    url="$1"
    shift
    ;;
  esac
done

if [[ -z $url ]]; then
  interactive ||
    fail "a git URL is required (e.g. omarchy plugin add https://github.com/acme/omarchy-weather.git)"
  url=$(gum input --prompt "Git URL of the plugin repo: ") || fail "cancelled"
  [[ -n $url ]] || fail "a git URL is required"
fi

# Refuse a URL that names a git option or a transport helper before cloning, so
# an untrusted URL cannot run a command before the plugin is validated or
# enabled. The check is shared with omarchy-theme-install and explains itself; a
# missing checker leaves this non-zero, which refuses the URL rather than
# cloning it.
omarchy-git-url-check "$url" || exit 1
source_kind="git"
if [[ -d $url ]]; then
  url=$(realpath -e -- "$url")
  source_kind="local"
fi
[[ $mode != "trusted-local" || $source_kind == "local" ]] || fail "--trusted-local requires an existing local Git folder"
(( ! inspect )) || [[ -z $enable_after ]] || fail "--inspect cannot enable a plugin"
(( ! json )) || [[ -z $enable_after ]] || fail "--json reports installation only; enable separately"
if (( review_stage )); then
  (( ! inspect && json )) && [[ $mode == "ward" && -z $enable_after ]] || fail "--stage requires Ward mode and --json, without --inspect or --enable"
fi

if [[ $mode != "ward" ]]; then
  echo "WARNING: $mode runs arbitrary code inside your desktop shell, with your files, accounts and network. Ward provides no containment." >&2
fi
if (( ! ASSUME_YES && ! inspect && ! review_stage )); then
  echo "Source: $url · Mode: $mode" >&2
  confirm "Clone and add this plugin?" || fail "aborted"
fi

mkdir -p "$PLUGINS_DIR"

staging=$(mktemp -d "$PLUGINS_DIR/.add.XXXXXXXX")
stage="$staging/checkout"
trap '[[ -z $staging ]] || rm -rf -- "$staging"' EXIT
if ! git clone -- "$url" "$stage" >&2; then
  fail "failed to clone $url"
fi

if ! validation=$(omarchy-plugin-validate "$stage" 2>&1); then
  echo "$validation" >&2
  fail "refusing to add: validation failed"
fi

id=$(jq -r '.id' "$stage/manifest.json")
# Serialize publication with staged-review publication. Cloning itself does
# not hold the lock, so independent review attempts remain independent.
if (( ! inspect && ! review_stage )); then
  exec {install_lock}>"$PLUGINS_DIR/.install.lock"
  flock "$install_lock"
fi
existing_manifest=$(plugin_id_manifest "$id") || {
  fail "could not inspect installed plugin ids"
}
if (( ! inspect )) && [[ -n $existing_manifest ]]; then
  fail "plugin id '$id' is already used by $existing_manifest"
fi

target="$PLUGINS_DIR/$id"
if (( ! inspect )) && [[ -e $target || -L $target ]]; then
  fail "plugin '$id' is already installed; update it with: omarchy plugin update $id"
fi

declares_ward=$(jq 'has("sandbox")' "$stage/manifest.json")
if [[ $mode == "ward" && $declares_ward != "true" ]]; then
  fail "this plugin is not Ward-compatible; choose --yolo explicitly for trusted in-process execution, or --trusted-local for your own local code"
elif [[ $mode != "ward" ]]; then
  [[ $declares_ward != "true" ]] || fail "a sandbox declaration cannot be overridden by $mode"
  identities=$(omarchy-plugin-isolation retained)
  if jq -e --arg id "$id" 'index($id) != null' <<<"$identities" >/dev/null; then
    fail "'$id' has retained Ward identity; use a different identity for deliberately trusted code"
  fi
fi
commit=$(git -C "$stage" rev-parse HEAD)
[[ -z $expected_commit || $commit == "$expected_commit" ]] || fail "source changed since validation; validate the new revision before installing"
report=$(jq -c --arg mode "$mode" --arg source "$url" --arg kind "$source_kind" --arg commit "$commit" \
  '{id, name, version, kinds, mode: $mode, source: $source, sourceKind: $kind, commit: $commit, validation: "manifest", installed: false}' "$stage/manifest.json")
if (( inspect )); then
  if (( json )); then
    echo "$report"
  else
    echo "$validation"
    echo "Validated $id at $commit · $mode. No plugin was installed or run."
  fi
  exit 0
fi

if (( review_stage )); then
  report=$(jq -c --arg stage "${staging##*/}" '. + {stage: $stage}' <<<"$report")
  printf '%s\n' "$report" > "$staging/record.json"
  printf '%s\n' "$report"
  staging=""
  exit 0
fi

if [[ $mode == "ward" ]]; then
  omarchy-plugin-isolation mark "$id"
fi
# Publish host provenance before the checkout can be observed by the shell.
omarchy-plugin-installation record "$id" "$mode" "$source_kind" "$url" "$commit"
mv -T "$stage" "$target"
stage=""
if (( json )); then
  jq '.installed = true' <<<"$report"
else
  echo "Added $id into $target · $mode"
fi

if [[ $mode == "ward" ]]; then
  omarchy-shell -q shell rescanPlugins >/dev/null
  (( json )) || echo "Review its requested access with: omarchy plugin review $id"
  if [[ $enable_after == "true" ]]; then
    fail "installed but not enabled; sandbox plugins require exact-revision approval first"
  fi
  exit 0
fi

omarchy-shell shell rescanPlugins >/dev/null

if (( json )); then
  exit 0
fi

if [[ -z $enable_after ]]; then
  if (( ASSUME_YES )) || ! interactive; then
    enable_after=false
  elif confirm "Enable '$id' now?"; then
    enable_after=true
  else
    enable_after=false
  fi
fi

if [[ $enable_after == true ]]; then
  select_bar_widget_placement "$id"
  discovered=0
  for (( attempt = 0; attempt < 40; attempt++ )); do
    if omarchy-plugin-list --json | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null; then
      discovered=1
      break
    fi
    sleep 0.05
  done
  (( discovered )) || fail "plugin '$id' is not known"
  omarchy-plugin-enable "$id" "${ENABLE_PLACEMENT[@]}"
else
  echo "Enable it later with: omarchy plugin enable $id"
fi

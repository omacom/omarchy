#!/bin/bash

# omarchy:summary=Remove an installed shell plugin
# omarchy:group=plugin
# omarchy:args=[id] [--yes]
# omarchy:alias=omarchy plugin rm

set -euo pipefail

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
[[ $STATE_DIR == /* ]] || { echo "omarchy-plugin-remove: state path must be absolute" >&2; exit 1; }
ASSUME_YES=0

fail() {
  echo "omarchy-plugin-remove: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$ && $1 != *..* ]]
}

id=""

while (( $# > 0 )); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin remove [id] [--yes]"
    exit 0
    ;;
  -*)
    fail "unknown remove option: $1"
    ;;
  *)
    [[ -z $id ]] || fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

if [[ -z $id ]]; then
  interactive || fail "a plugin-id is required"
  id=$(find "$PLUGINS_DIR" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) \
    ! -name '.*' -printf '%f\n' 2>/dev/null |
    sort |
    gum choose --header="Remove which plugin?") || fail "cancelled"
  [[ -n $id ]] || fail "nothing selected"
fi
valid_plugin_id "$id" || fail "invalid plugin id '$id'"

target="$PLUGINS_DIR/$id"
# Removal and publication must never interleave checkout/provenance changes.
mkdir -p "$PLUGINS_DIR"
exec {install_lock}>"$PLUGINS_DIR/.install.lock"
flock "$install_lock"
catalog=$(omarchy-plugin-catalog)

was_enabled=""
sandboxed=false
if jq -e --arg id "$id" 'any(.[]; .id == $id and .sandboxed and .wardIdentity != false)' <<<"$catalog" >/dev/null; then
  sandboxed=true
else
  if [[ ! -e $target && ! -L $target && ! -e $STATE_DIR/plugins/$id && ! -L $STATE_DIR/plugins/$id ]]; then
    jq -e --arg id "$id" 'any(.[]; .id == $id and (.firstParty | not))' <<<"$catalog" >/dev/null || fail "plugin '$id' is not installed"
  fi
  shell_plugins=$(omarchy-shell shell listPlugins)
  if [[ -n $shell_plugins ]]; then
    was_enabled=$(jq -r --arg id "$id" '
      .[] | select(.id == $id) | .enabled
    ' <<<"$shell_plugins")
  fi
fi

cloned_from=""
if [[ $sandboxed != "true" && -f $target/manifest.json ]]; then
  cloned_from=$(jq -r '.omarchy.clonedFrom // empty' "$target/manifest.json")
fi

confirm "Permanently remove '$id', its saved plugin data, permissions and installation history? Original sources and files accessed through permissions are not deleted." || fail "aborted"

# These are exact per-plugin children, never a grant's host path. Refuse
# redirected state parents instead of recursively following them elsewhere.
[[ ! -L $STATE_DIR && ! -L $STATE_DIR/plugins ]] || fail "plugin state directory must not be a symlink"

if [[ $sandboxed == "true" ]]; then
  omarchy-shell -q shell setPluginEnabled "$id" false >/dev/null
  # Native removal confirms controller shutdown, then purges approval and all
  # owned snapshots. Keep the external isolation marker until checkout removal.
  jq -cn --arg id "$id" '{operation: "remove", id: $id}' | omarchy-ward-runtime >/dev/null
elif [[ $was_enabled == "true" ]]; then
  omarchy-shell shell setPluginEnabled "$id" false >/dev/null
fi

source "$OMARCHY_PATH/bin/omarchy-shell-config"
forget_plugin_config "$id"

if [[ ! -e $target && ! -L $target ]]; then
  echo "No checkout remains for $id."
elif [[ -L $target ]]; then
  rm -f "$target"
  echo "Unlinked $id."
else
  rm -rf "$target"
  echo "Removed $id."
fi

rm -rf -- "$STATE_DIR/plugins/$id"
omarchy-plugin-installation forget "$id"
omarchy-plugin-isolation forget "$id"

if [[ $sandboxed == "true" ]]; then
  omarchy-shell -q shell rescanPlugins >/dev/null
else
  omarchy-shell shell rescanPlugins >/dev/null
fi
echo "Saved plugin data, permissions, reviewed snapshots and installation records removed."

if [[ -n $cloned_from && $was_enabled == "true" ]]; then
  echo "Restored $cloned_from."
elif [[ $was_enabled == "true" ]]; then
  echo "Plugin was enabled and was unloaded from omarchy-shell."
fi

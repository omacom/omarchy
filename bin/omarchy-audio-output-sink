#!/bin/bash

# omarchy:summary=Print the sink whose volume and mute a given output really uses
# omarchy:args=[sink-name]
# omarchy:group=audio
# omarchy:examples=omarchy audio output sink | omarchy audio output sink omarchy_speaker_tuning

set -uo pipefail

# A DSP sink -- a speaker tuning filter-chain, EasyEffects, JamesDSP, or a null-sink --
# can be the selected output without being where loudness lives. Changing its volume
# alters the level going *into* the processing: the display moves while the speakers
# do not, and on a chain with a compressor or limiter the tone changes too. Resolve
# through it to the physical sink it feeds.
#
# With no argument this resolves the current default output, so when headphones or
# HDMI are selected it returns those, not the speakers a tuning happens to front.

sink="${1:-$(pactl get-default-sink 2>/dev/null)}"

# If it is already a physical hardware or network sink, return immediately.
# Expanded to cover AirPlay (raop), PipeWire tunnels, and ROC streaming.
if [[ -z $sink || $sink =~ ^(alsa_output|bluez_output|raop_output|tunnel_output|roc_output)\. ]]; then
  printf '%s\n' "$sink"
  exit 0
fi

# 1. Generic PipeWire graph resolution:
# Real DSP sinks create multiple independent nodes (e.g., input front-door, output back-door).
# Find all nodes sharing the same 'node.link-group' as the requested sink using pw-dump.
# The awk regexes are strictly anchored to ^[ \t]* to avoid matching nested/similar keys like "client.id".
related_nodes="$(pw-dump 2>/dev/null | awk -v virt="$sink" '
  /^[ \t]*"id":[ \t]*[0-9]+/ {
    id = $0; sub(/.*"id":[ \t]*/, "", id); sub(/,.*/, "", id)
  }
  /^[ \t]*"node\.name":[ \t]*"/ {
    name = $0; sub(/.*"node\.name":[ \t]*"/, "", name); sub(/".*/, "", name)
    names[id] = name
  }
  /^[ \t]*"node\.link-group":[ \t]*"/ {
    group = $0; sub(/.*"node\.link-group":[ \t]*"/, "", group); sub(/".*/, "", group)
    groups[id] = group
  }
  END {
    virt_group = ""
    for (i in names) {
      if (names[i] == virt) {
        virt_group = groups[i]
        break
      }
    }
    if (virt_group != "") {
      for (i in names) {
        if (groups[i] == virt_group) print names[i]
      }
    } else {
      print virt
    }
  }
')"

if [[ -n $related_nodes ]]; then
  physical_sink="$(pw-link -l 2>/dev/null | awk -v nodes="$related_nodes" '
    BEGIN {
      split(nodes, arr, "\n")
      for (i in arr) {
        # Limpiar posibles retornos de carro residuales del output JSON
        sub(/\r$/, "", arr[i])
        if (arr[i] != "") valid[arr[i]] = 1
      }
    }
    /^[^[:space:]]/ {
      node = $1; sub(/:.*/, "", node)
      active = (node in valid) ? 1 : 0
    }
    /^[[:space:]]*\|->/ && active {
      target = $2; sub(/:.*/, "", target)
      if (target ~ /^(alsa_output|bluez_output|raop_output|tunnel_output|roc_output)/) {
        print target
        exit
      }
    }
  ')"

  if [[ -n $physical_sink ]]; then
    printf '%s\n' "$physical_sink"
    exit 0
  fi
fi

# 2. Fallback via PulseAudio sink-inputs (for compatibility with legacy modules/filters)
downstream="$(pactl list sink-inputs 2>/dev/null |
  awk -v virt="$sink" '
    BEGIN {
      # Map effect_input.<name> to effect_output.<name> for module-filter-chain compatibility
      alt_virt = virt
      if (index(virt, "effect_input.") == 1) {
        sub(/^effect_input\./, "effect_output.", alt_virt)
      }
    }
    /^Sink Input #/ {target = ""}
    /^[[:space:]]*Sink:/ {target = $2}
    /^[ \t]*node\.name = / {
      name = $0
      sub(/.*node\.name = "/, "", name)
      sub(/"$/, "", name)
      if ((index(name, virt) == 1 || index(name, alt_virt) == 1) && target != "") {
        print target
        exit
      }
    }')"

if [[ -n $downstream ]]; then
  name="$(pactl list sinks short 2>/dev/null |
    awk -v id="$downstream" '$1 == id {print $2; exit}')"
  if [[ -n $name ]]; then
    printf '%s\n' "$name"
    exit 0
  fi
fi

# 3. EasyEffects specific resolution (Hardware routing takes precedence over database)
if [[ $sink == "easyeffects_sink" ]]; then

  # a) Live routing check: Look for active links from EasyEffects output nodes directly.
  # This prevents returning a stale configuration if dynamic routing is active.
  target="$(pw-link -l 2>/dev/null | awk '
    /^[^[:space:]]/ {
      node = $1; sub(/:.*/, "", node)
      # Match standard EasyEffects output nodes
      active = (node == "ee_soe_output_level" || node ~ /easyeffects.*output/) ? 1 : 0
    }
    /^[[:space:]]*\|->/ && active {
      t = $2; sub(/:.*/, "", t)
      if (t ~ /^(alsa_output|bluez_output|raop_output|tunnel_output|roc_output)/) { print t; exit }
    }
  ')"

  if [[ -n $target ]]; then
    printf '%s\n' "$target"
    exit 0
  fi

  # b) Fallback to configuration only if EasyEffects is idle
  ee_native="${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc"
  ee_flatpak="${HOME}/.var/app/com.github.wwmm.easyeffects/config/easyeffects/db/easyeffectsrc"

  # tr limpia comillas dobles en caso de que EasyEffects cambie su formato de guardado
  if [[ -f "$ee_native" ]]; then
    target="$(grep '^outputDevice=' "$ee_native" 2>/dev/null | cut -d= -f2- | tr -d '\"')"
  elif [[ -f "$ee_flatpak" ]]; then
    target="$(grep '^outputDevice=' "$ee_flatpak" 2>/dev/null | cut -d= -f2- | tr -d '\"')"
  fi

  if [[ -n $target && $target =~ ^(alsa_output|bluez_output|raop_output|tunnel_output|roc_output)\. ]]; then
    printf '%s\n' "$target"
    exit 0
  fi
fi

# Nothing resolvable downstream -- fallback to the sink itself.
printf '%s\n' "$sink"

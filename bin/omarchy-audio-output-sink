#!/bin/bash

# omarchy:summary=Print the sink whose volume and mute a given output really uses
# omarchy:args=[sink-name]
# omarchy:group=audio
# omarchy:examples=omarchy audio output sink | omarchy audio output sink omarchy_speaker_tuning

set -uo pipefail

# A DSP sink -- a speaker tuning filter-chain, EasyEffects, JamesDSP, or a null-sink --
# can be the selected output without being where loudness lives. Changing its volume
# alters the level going *into* the processing: the display moves while the speakers
# do not, and on a chain with a compressor or limiter the tone changes too. Resolve
# through it to the physical sink it feeds.
#
# With no argument this resolves the current default output, so when headphones or
# HDMI are selected it returns those, not the speakers a tuning happens to front.

sink="${1:-$(pactl get-default-sink 2>/dev/null)}"

# If it is already a physical hardware sink, return immediately.
if [[ -z $sink || $sink == alsa_output.* || $sink == bluez_output.* ]]; then
  printf '%s\n' "$sink"
  exit 0
fi

# 1. Generic PipeWire graph resolution:
# Real DSP sinks create multiple independent nodes (e.g., input front-door, output back-door).
# Find all nodes sharing the same 'node.link-group' as the requested sink, then
# traverse their outgoing links to find the connected physical hardware sink.
related_nodes="$(pw-cli dump node 2>/dev/null | awk -v virt="$sink" '
  /^[[:space:]]*id / {
    if (name != "") {
      names[id] = name
      if (group != "") groups[id] = group
      if (name == virt) virt_group = group
    }
    id = $2; sub(/,.*/, "", id)
    name = ""; group = ""
  }
  /node\.name = / { name = $0; sub(/.*node\.name = "/, "", name); sub(/".*/, "", name) }
  /node\.link-group = / { group = $0; sub(/.*node\.link-group = "/, "", group); sub(/".*/, "", group) }
  END {
    if (name != "") {
      names[id] = name
      if (group != "") groups[id] = group
      if (name == virt) virt_group = group
    }
    if (virt_group != "") {
      for (i in groups) { if (groups[i] == virt_group) print names[i] }
    } else {
      print virt
    }
  }
')"

if [[ -n $related_nodes ]]; then
  physical_sink="$(pw-link -l 2>/dev/null | awk -v nodes="$related_nodes" '
    BEGIN {
      split(nodes, arr, "\n")
      for (i in arr) { if (arr[i] != "") valid[arr[i]] = 1 }
    }
    /^[^[:space:]]/ {
      node = $1; sub(/:.*/, "", node)
      active = (node in valid) ? 1 : 0
    }
    /^[[:space:]]*\|->/ && active {
      target = $2; sub(/:.*/, "", target)
      if (target ~ /^(alsa_output|bluez_output)/) {
        print target
        exit
      }
    }
  ')"

  if [[ -n $physical_sink ]]; then
    printf '%s\n' "$physical_sink"
    exit 0
  fi
fi

# 2. Fallback via PulseAudio sink-inputs (for compatibility with legacy modules/filters)
downstream="$(pactl list sink-inputs 2>/dev/null |
  awk -v virt="$sink" '
    BEGIN {
      # Map effect_input.<name> to effect_output.<name> for module-filter-chain compatibility
      alt_virt = virt
      if (index(virt, "effect_input.") == 1) {
        sub(/^effect_input\./, "effect_output.", alt_virt)
      }
    }
    /^Sink Input #/ {target = ""}
    /^[[:space:]]*Sink:/ {target = $2}
    /node\.name = / {
      name = $0
      sub(/.*node\.name = "/, "", name)
      sub(/"$/, "", name)
      if ((index(name, virt) == 1 || index(name, alt_virt) == 1) && target != "") {
        print target
        exit
      }
    }')"

if [[ -n $downstream ]]; then
  name="$(pactl list sinks short 2>/dev/null |
    awk -v id="$downstream" '$1 == id {print $2; exit}')"
  if [[ -n $name ]]; then
    printf '%s\n' "$name"
    exit 0
  fi
fi

# 3. If EasyEffects is idle (no active streams in pw-link), check its configured target device
if [[ $sink == "easyeffects_sink" ]]; then
  target="$(grep '^outputDevice=' "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc" 2>/dev/null | cut -d= -f2-)"
  if [[ -n $target && ($target == alsa_output.* || $target == bluez_output.*) ]]; then
    printf '%s\n' "$target"
    exit 0
  fi
fi

# Nothing resolvable downstream -- fallback to the sink itself.
printf '%s\n' "$sink"

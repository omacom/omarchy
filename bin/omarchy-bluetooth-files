#!/bin/bash

# omarchy:summary=Accept files sent over Bluetooth from paired devices
# omarchy:group=bluetooth
# omarchy:args=<on|off|toggle|is-on>

# Receiving is BlueZ's Object Push profile: obexd (bluez-obex) accepts the
# session, and an agent on this bus names where the file lands. bt-obex is that
# agent — it auto-accepts and writes into the download directory, which is what
# the phone's own Bluetooth share target pushes to. Nothing here needs Wi-Fi or
# an app on the phone, so it works while the phone is on mobile data.
#
# The unit is the state. `on` enables it, so the receiver also comes up at the
# next login, `off` disables it, and the panel switch reads it back with
# `is-on`. Only paired devices can push: Android's share sheet only offers
# bonded devices, and pairing runs through omarchy-bluetooth-device.

case "${1:-}" in
  on)
    systemctl --user enable --now omarchy-bluetooth-files.service
    ;;
  off)
    systemctl --user disable --now omarchy-bluetooth-files.service
    ;;
  toggle)
    if systemctl --user is-enabled --quiet omarchy-bluetooth-files.service; then
      systemctl --user disable --now omarchy-bluetooth-files.service
    else
      systemctl --user enable --now omarchy-bluetooth-files.service
    fi
    ;;
  is-on)
    systemctl --user is-active --quiet omarchy-bluetooth-files.service
    ;;
  *)
    echo "Usage: omarchy-bluetooth-files <on|off|toggle|is-on>" >&2
    exit 1
    ;;
esac

#!/bin/bash

# omarchy:summary=Toggle between per-monitor and global workspace numbering
# omarchy:args=[toggle|on|off]
# omarchy:examples=omarchy toggle monitor-workspaces | omarchy toggle monitor-workspaces off

set -euo pipefail

if (( $# > 1 )); then
  echo "Usage: omarchy-toggle-monitor-workspaces [toggle|on|off]" >&2
  exit 1
fi

FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/no-monitor-workspaces"
ENABLED=on
[[ -f $FLAG ]] && ENABLED=off

case ${1:-toggle} in
  toggle)
    if [[ $ENABLED == "on" ]]; then
      NEW=off
    else
      NEW=on
    fi
    ;;
  on|off) NEW=$1 ;;
  *)
    echo "Usage: omarchy-toggle-monitor-workspaces [toggle|on|off]" >&2
    exit 1
    ;;
esac

# Windows on later monitors sit above 10, out of the number keys' reach.
compact_workspaces() {
  if ! hyprctl dispatch 'o.workspaces.compact()' >/dev/null; then
    echo "Could not renumber workspaces above 10; run omarchy toggle monitor-workspaces off to try again" >&2
    return 1
  fi
}

if [[ $NEW == $ENABLED ]]; then
  if [[ $NEW == "off" ]]; then
    compact_workspaces
  fi
  exit 0
fi

set_mode() {
  if [[ $1 == "off" ]]; then
    mkdir -p "$(dirname "$FLAG")"
    touch "$FLAG"
  else
    rm -f "$FLAG"
  fi
}

set_mode "$NEW"

# Hyprland keeps the old config and still answers ok when a config fails to
# load, so any config error means the new mode may not be running.
if ! hyprctl reload >/dev/null || [[ -n $(hyprctl configerrors || true) ]]; then
  set_mode "$ENABLED"
  hyprctl reload >/dev/null || true
  echo "Could not reload Hyprland cleanly, see hyprctl configerrors; workspace numbering was not changed" >&2
  exit 1
fi

# The mode has changed by now, so the bar and the notification still follow it.
status=0
if [[ $NEW == "off" ]] && ! compact_workspaces; then
  status=1
fi

omarchy-shell -q omarchy.workspaces refresh
if [[ $NEW == "on" ]]; then
  omarchy-notification-send -g 󱂬 "$(omarchy-i18n workspaces.perMonitorEnabled)"
else
  omarchy-notification-send -g 󱂬 "$(omarchy-i18n workspaces.globalEnabled)"
fi

exit "$status"

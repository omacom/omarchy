#!/bin/bash

# omarchy:summary=Show or adjust brightness on the focused display.
# omarchy:args=[--no-osd] [--monitor name] [+N%|N%-|N%|off|on]
# omarchy:examples=omarchy brightness display | omarchy brightness display +5% | omarchy brightness display --monitor DP-1 50% | omarchy brightness display off | omarchy brightness display on

# The implementation moved to omarchy-media, where the work is one process
# instead of the sixteen this script spent on a single key press. The header
# above stays because `omarchy` routes subcommands through it, and `exec`
# replaces this shell rather than running alongside it, so a key press is
# still one process.
exec omarchy-media brightness display "$@"

#!/bin/bash

# omarchy:summary=Show or adjust brightness on the focused display.
# omarchy:args=[--no-osd] [--monitor name] [+N%|N%-|N%|off|on]
# omarchy:examples=omarchy brightness display | omarchy brightness display +5% | omarchy brightness display --monitor DP-1 50% | omarchy brightness display off | omarchy brightness display on

no_osd=0
monitor=""

while (( $# > 0 )); do
  case "$1" in
  --no-osd)
    no_osd=1
    shift
    ;;
  --monitor)
    (( $# >= 2 )) || exit 1
    monitor="$2"
    shift 2
    ;;
  *)
    break
    ;;
  esac
done

# Get the brightness of the passed display
backlight_brightness() {
  brightnessctl -d "$1" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END{ exit !found }'
}

gamma_brightness() {
  local gamma
  gamma=$(gamma_command get) || return 1
  awk -v gamma="$gamma" 'BEGIN {
    tenth = int((gamma - 25) * 10 / 75 + 0.5)
    if (tenth < 0) tenth = 0
    if (tenth > 10) tenth = 10
    printf "%.1f\n", tenth / 10
  }'
}

display_brightness() {
  local hardware
  hardware=$(backlight_brightness "$1") || return 1
  if (( hardware == 0 )); then
    gamma_brightness
  else
    printf '%s\n' "$hardware"
  fi
}

set_gamma_tenth() {
  local tenth=$1
  (( tenth < 0 )) && tenth=0
  (( tenth > 10 )) && tenth=10
  gamma_command set "$(( 25 + (75 * tenth + 5) / 10 ))"
}

gamma_command() {
  if [[ -n ${lock_fd:-} ]]; then
    omarchy-brightness-display-gamma "$@" {lock_fd}>&-
  else
    omarchy-brightness-display-gamma "$@"
  fi
}

[[ -n $monitor ]] || monitor="$(omarchy-hyprland-monitor-focused 2>/dev/null || true)"

monitor_is_internal() {
  [[ $monitor =~ ^(eDP|LVDS|DSI)- ]]
}

use_apple_display() {
  omarchy-hyprland-monitor-focused-apple "$monitor"
}

use_ddc_display() {
  [[ -n $monitor ]] && ! monitor_is_internal
}

if (( $# == 0 )); then
  if use_apple_display; then
    omarchy-brightness-display-apple
    exit
  elif use_ddc_display; then
    omarchy-brightness-display-ddc "$monitor"
    exit
  fi

  device="$(omarchy-hw-display)" || exit 1
  display_brightness "$device"
  exit
fi

step="$1"

if [[ $step == "off" ]]; then
  hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null 2>&1
  exit 0
elif [[ $step == "on" ]]; then
  # Skip the dispatch when every active display is already lit: a redundant
  # DPMS enable right after system resume forces another modeset, which blanks
  # the panel for a beat (visible flash at the unlock screen).
  hyprctl monitors -j 2>/dev/null | jq -e '[.[] | select(.disabled == false)] | length > 0 and all(.dpmsStatus)' >/dev/null 2>&1 && exit 0
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1
  exit 0
fi

# Drop overlapping brightness key events so concurrent invocations do not race.
# Hardware key repeat present on some devices can otherwise glitch OSD rendering.
exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"
flock -n "$lock_fd" || exit 0

if use_apple_display; then
  [[ $step == "0%" ]] && step="1%"
  if (( no_osd )); then
    omarchy-brightness-display-apple --no-osd "$step"
  else
    omarchy-brightness-display-apple "$step"
  fi
elif use_ddc_display; then
  [[ $step == "0%" ]] && step="1%"
  brightness="$(omarchy-brightness-display-ddc "$monitor" "$step")" || exit 1
  (( no_osd )) || omarchy-osd -i brightness -p "$brightness"
else
  # Current device highlighted
  device="$(omarchy-hw-display)" || exit 1

  # Current brightness percentage
  current=$(backlight_brightness "$device") || exit 1

  if [[ $step == "+5%" || $step == "+1%" || $step == "5%-" || $step == "1%-" ]]; then
    if (( current == 0 )); then
      gamma=$(gamma_command get) || exit 1
      tenth=$(awk -v gamma="$gamma" 'BEGIN { printf "%.0f", (gamma - 25) * 10 / 75 }')
      if [[ $step == +* ]]; then
        if (( tenth < 10 )); then
          set_gamma_tenth "$(( tenth + 1 ))" || exit 1
        else
          brightnessctl -d "$device" set 1% >/dev/null || exit 1
          gamma_command cleanup
        fi
      else
        set_gamma_tenth "$(( tenth - 1 ))" || exit 1
      fi
    else
      if [[ $step == +* ]]; then
        if [[ $step == "+5%" ]] && (( current >= 5 )); then
          (( target = current + 5 ))
        else
          (( target = current + 1 ))
        fi
        (( target > 100 )) && target=100
      else
        if [[ $step == "5%-" ]] && (( current > 5 )); then
          (( target = current - 5 ))
        else
          (( target = current - 1 ))
        fi
        (( target < 0 )) && target=0
      fi
      brightnessctl -d "$device" set "$target%" >/dev/null || exit 1
      gamma_command set 100 || exit 1
    fi
  elif [[ $step =~ ^[0-9]+([.][0-9]+)?%$ ]]; then
    requested=${step%%%}
    if awk -v requested="$requested" 'BEGIN { exit !(requested < 1) }'; then
      # Gamma changes only after the hardware backlight reaches zero.
      brightnessctl -d "$device" set 0% >/dev/null || exit 1
      tenth=$(awk -v requested="$requested" 'BEGIN { printf "%.0f", requested * 10 }')
      set_gamma_tenth "$tenth" || exit 1
    else
      gamma_command set 100 || exit 1
      brightnessctl -d "$device" set "$step" >/dev/null || exit 1
    fi
  else
    brightnessctl -d "$device" set "$step" >/dev/null || exit 1
    if (( $(backlight_brightness "$device") > 0 )); then
      gamma_command set 100 || exit 1
    fi
  fi

  # Show the new brightness in OSD
  (( no_osd )) || omarchy-osd -i brightness -p "$(display_brightness "$device")"
fi

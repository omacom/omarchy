#!/bin/bash

# omarchy:summary=Cap Intel CPU package power on battery, restore on AC
# omarchy:args=[0|1]
# omarchy:examples=omarchy battery cpu limit 0
# omarchy:hidden=true
# omarchy:requires-sudo=true

# A big parallel build on battery can spike an Intel CPU past what the battery
# sustains alone: the voltage droops until the BMS cuts all power (a hard
# shutdown with nothing in the journal). power-saver only hints EPP, it never
# caps frequency or package power, so this caps the CPU while discharging and
# restores the saved AC policy when the charger returns.
#
# Invoked as root from the udev power-supply rule (with the Mains online
# state), from the system-sleep hook (no args: re-reads the state), and from
# the boot service. Exits quietly on machines without Intel pstate/RAPL or
# without a battery, so the udev rule can ship everywhere.
#
# RAPL limits are best-effort: some firmware (e.g. Apple T2) exposes the
# powercap constraints read-only, in which case no-turbo + max-perf-pct still
# bound the draw and a warning is logged.

set -euo pipefail

sys_root="${OMARCHY_SYSFS_ROOT:-/sys}"
state_dir="${OMARCHY_BATTERY_CPU_STATE_DIR:-/var/lib/omarchy/battery-cpu-limit}"

pstate_no_turbo="$sys_root/devices/system/cpu/intel_pstate/no_turbo"
pstate_max_pct="$sys_root/devices/system/cpu/intel_pstate/max_perf_pct"
rapl_pl1="$sys_root/class/powercap/intel-rapl:0/constraint_0_max_power_uw"
rapl_pl2="$sys_root/class/powercap/intel-rapl:0/constraint_1_max_power_uw"

bat_max_pct=50
bat_pl1=25000000
bat_pl2=35000000

# Firmware values, only a fallback: the real saved AC policy wins whenever the
# state files exist.
ac_no_turbo_fallback=0
ac_max_pct_fallback=100
ac_pl1_fallback=45000000
ac_pl2_fallback=0

fail() {
  echo "omarchy-battery-cpu-limit: error: $*" >&2
  exit 1
}

if (( $# > 1 )); then
  fail "usage: omarchy battery cpu-limit [0|1]"
fi

if (( $# == 1 )); then
  [[ $1 == 0 || $1 == 1 ]] || fail "state must be 0 (battery) or 1 (AC)"
  online=$1
else
  online=1
  for supply in "$sys_root"/class/power_supply/*; do
    [[ $(cat "$supply/type" 2>/dev/null) == Mains ]] || continue
    [[ $(cat "$supply/online" 2>/dev/null) == 0 ]] && online=0
  done
fi

[[ -d "$sys_root/devices/system/cpu/intel_pstate" ]] || exit 0

battery_found=0
for supply in "$sys_root"/class/power_supply/*; do
  [[ $(cat "$supply/type" 2>/dev/null) == Battery ]] && battery_found=1
done
(( battery_found )) || exit 0

# Save the AC policy before anything is capped: at that point the live values
# are still the firmware/boot policy, including on a boot that starts on
# battery. Each knob is saved individually so a later version that tracks a new
# knob never re-snapshots (and contaminates) the knobs it already saved.
mkdir -p "$state_dir"
if [[ ! -f $state_dir/no-turbo ]]; then
  cat "$pstate_no_turbo" >"$state_dir/no-turbo"
fi
if [[ ! -f $state_dir/max-pct ]]; then
  cat "$pstate_max_pct" >"$state_dir/max-pct"
fi
if [[ ! -f $state_dir/pl1 ]]; then
  cat "$rapl_pl1" >"$state_dir/pl1" 2>/dev/null || printf 'unwritable' >"$state_dir/pl1"
fi
if [[ ! -f $state_dir/pl2 ]]; then
  cat "$rapl_pl2" >"$state_dir/pl2" 2>/dev/null || printf 'unwritable' >"$state_dir/pl2"
fi

set_value() {
  local path=$1 value=$2 label=$3 actual
  echo "$value" >"$path" || fail "cannot write $label ($path)"
  actual=$(cat "$path") || fail "cannot read back $label ($path)"
  [[ $actual == "$value" ]] || fail "$label not applied (want $value, got $actual)"
  echo "omarchy-battery-cpu-limit: $label=$actual"
}

# RAPL is firmware-locked read-only on some machines: try it, warn, move on.
try_rapl() {
  local path=$1 value=$2 label=$3 actual
  if ! echo "$value" >"$path" 2>/dev/null; then
    echo "omarchy-battery-cpu-limit: warning: $label not writable, skipping" >&2
    return 0
  fi
  actual=$(cat "$path" 2>/dev/null) || {
    echo "omarchy-battery-cpu-limit: warning: cannot read back $label" >&2
    return 0
  }
  if [[ $actual == "$value" ]]; then
    echo "omarchy-battery-cpu-limit: $label=$actual"
  else
    echo "omarchy-battery-cpu-limit: warning: $label not applied (want $value, got $actual)" >&2
  fi
}

if (( online == 0 )); then
  echo "omarchy-battery-cpu-limit: on battery, capping CPU package power"
  set_value "$pstate_no_turbo" 1 no-turbo
  set_value "$pstate_max_pct" "$bat_max_pct" max-perf-pct
  try_rapl "$rapl_pl1" "$bat_pl1" PL1
  try_rapl "$rapl_pl2" "$bat_pl2" PL2
else
  echo "omarchy-battery-cpu-limit: on AC, restoring saved policy"
  want_turbo=$ac_no_turbo_fallback
  want_pct=$ac_max_pct_fallback
  want_pl1=$ac_pl1_fallback
  want_pl2=$ac_pl2_fallback
  [[ -r $state_dir/no-turbo ]] && want_turbo=$(cat "$state_dir/no-turbo")
  [[ -r $state_dir/max-pct ]] && want_pct=$(cat "$state_dir/max-pct")
  [[ -r $state_dir/pl1 ]] && want_pl1=$(cat "$state_dir/pl1")
  [[ -r $state_dir/pl2 ]] && want_pl2=$(cat "$state_dir/pl2")
  set_value "$pstate_no_turbo" "$want_turbo" no-turbo
  set_value "$pstate_max_pct" "$want_pct" max-perf-pct
  if [[ $want_pl1 != unwritable ]]; then
    try_rapl "$rapl_pl1" "$want_pl1" PL1
  fi
  if [[ $want_pl2 != unwritable ]]; then
    try_rapl "$rapl_pl2" "$want_pl2" PL2
  fi
fi

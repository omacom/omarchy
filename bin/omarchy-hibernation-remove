#!/bin/bash

# omarchy:summary=Remove hibernation setup including swap and boot resume settings
# omarchy:requires-sudo=true

MKINITCPIO_CONF="/etc/mkinitcpio.conf.d/omarchy_resume.conf"
RESUME_DROP_IN="/etc/limine-entry-tool.d/resume.conf"
RESUME_REBUILD_PENDING="/var/lib/omarchy/hibernation-resume-rebuild"

# Check if hibernation is configured (including a stale resume drop-in left by an older remove)
hook_present=false
if [[ -f $MKINITCPIO_CONF ]] && grep -q "^HOOKS+=(resume)$" "$MKINITCPIO_CONF"; then
  hook_present=true
fi

if ! $hook_present && [[ ! -f $RESUME_DROP_IN && ! -f $RESUME_REBUILD_PENDING ]]; then
  echo "Hibernation is not set up"
  exit 0
fi

if ! gum confirm "Remove hibernation setup?"; then
  exit 0
fi

SWAP_SUBVOLUME="/swap"
SWAP_FILE="$SWAP_SUBVOLUME/swapfile"

# Disable swap if active
if swapon --show | grep -q "$SWAP_FILE"; then
  echo "Disabling swap on $SWAP_FILE"
  sudo swapoff "$SWAP_FILE"
fi

# Remove swapfile
if [[ -f $SWAP_FILE ]]; then
  echo "Removing swapfile"
  sudo rm "$SWAP_FILE"
fi

# Remove swap subvolume
if sudo btrfs subvolume show "$SWAP_SUBVOLUME" &>/dev/null; then
  echo "Removing Btrfs subvolume $SWAP_SUBVOLUME"
  sudo btrfs subvolume delete "$SWAP_SUBVOLUME"
fi

# Remove fstab entry
if grep -Fq "$SWAP_FILE" /etc/fstab; then
  echo "Removing swapfile from /etc/fstab"
  sudo cp -a /etc/fstab "/etc/fstab.$(date +%Y%m%d%H%M%S).back"
  sudo sed -i "\|$SWAP_FILE|d" /etc/fstab
  sudo sed -i '/^# Btrfs swapfile for system hibernation$/d' /etc/fstab
fi

# Keep the rebuild retryable after a failure or interruption during removal.
sudo install -Dm644 /dev/null "$RESUME_REBUILD_PENDING" || exit 1

# Remove mkinitcpio resume hook and Limine resume kernel parameters
if [[ -f $MKINITCPIO_CONF ]]; then
  echo "Removing resume hook"
  sudo rm -f "$MKINITCPIO_CONF" || exit 1
fi

if [[ -f $RESUME_DROP_IN || -f $RESUME_REBUILD_PENDING ]]; then
  echo "Removing resume kernel parameters"
  sudo rm -f "$RESUME_DROP_IN" || exit 1
fi

echo "Regenerating initramfs..."
build_log=$(mktemp) || exit 1
sudo limine-mkinitcpio 2>&1 | tee "$build_log"
status=("${PIPESTATUS[@]}")
if (( status[0] == 0 && status[1] == 0 )) && ! grep -q 'mkinitcpio failed for kernel' "$build_log"; then
  rm -f "$build_log"
  sudo rm -f "$RESUME_REBUILD_PENDING" || exit 1
else
  rm -f "$build_log"
  echo "Could not rebuild the boot image; retry hibernation removal after fixing the build error." >&2
  exit 1
fi

echo "Hibernation removed"

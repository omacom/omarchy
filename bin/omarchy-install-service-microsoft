#!/bin/bash

# omarchy:summary=Install Microsoft Outlook, Word, Excel, PowerPoint, Teams, and OneDrive as web apps.

set -e

ICONS="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png"

echo "Installing Microsoft Outlook..."
omarchy-webapp-install "Microsoft Outlook" "https://outlook.office.com/mail/" "$ICONS/microsoft-outlook.png"

echo "Installing Microsoft Word..."
omarchy-webapp-install "Microsoft Word" "https://word.cloud.microsoft/" "$ICONS/microsoft-word.png" \
  "omarchy-webapp-handler-microsoft word %F" "application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;"

echo "Installing Microsoft Excel..."
omarchy-webapp-install "Microsoft Excel" "https://excel.cloud.microsoft/" "$ICONS/microsoft-excel.png" \
  "omarchy-webapp-handler-microsoft excel %F" "application/vnd.ms-excel;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;"

echo "Installing Microsoft PowerPoint..."
omarchy-webapp-install "Microsoft PowerPoint" "https://powerpoint.cloud.microsoft/" "$ICONS/microsoft-powerpoint.png" \
  "omarchy-webapp-handler-microsoft powerpoint %F" "application/vnd.ms-powerpoint;application/vnd.openxmlformats-officedocument.presentationml.presentation;"

echo "Installing Microsoft Teams..."
omarchy-webapp-install "Microsoft Teams" "https://teams.cloud.microsoft/" "$ICONS/microsoft-teams.png"

echo "Installing Microsoft OneDrive..."
omarchy-webapp-install "Microsoft OneDrive" "https://www.office.com/launch/onedrive" "$ICONS/microsoft-onedrive.png"

update-desktop-database "$HOME/.local/share/applications"

echo ""
echo "You can now find Microsoft Outlook, Word, Excel, PowerPoint, Teams, and OneDrive using the app launcher (SUPER + SPACE)"
echo "To open local Office documents, connect OneDrive with: omarchy setup microsoft-office"

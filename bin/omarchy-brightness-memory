#!/bin/bash
# omarchy:hidden=true
# omarchy:summary=Remember internal display brightness per power source

# Only Omarchy-controlled internal backlight writes are remembered; external DDC
# displays and the Apple display helper deliberately use their own paths.
set -euo pipefail
(( $# >= 1 && $# <= 2 )) || exit 2
action=$1
[[ $action == "set" || $action == "sync" ]] || exit 2
if [[ $action == "set" ]]; then
  (( $# == 2 )) || exit 2
  requested=$2
  if [[ $requested =~ ^\+([0-9]+)%$ ]]; then
    step=${BASH_REMATCH[1]}
  elif [[ $requested =~ ^([0-9]+)%-$ ]]; then
    step=-${BASH_REMATCH[1]}
  elif [[ $requested =~ ^\+([0-9]+)$ ]]; then
    step=${BASH_REMATCH[1]}
  else
    value=${requested%%%}
    [[ $value =~ ^[0-9]{1,3}$ ]] && (( value <= 100 )) || exit 2
  fi
else
  (( $# == 1 )) || exit 2
fi
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/brightness"
mkdir -p "$state_dir"
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-memory.lock"
flock 9
device=$(omarchy-hw-display 2>/dev/null) || exit 0
[[ -n $device ]] || exit 0
power_source=""
power_status=$(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) || power_status=""
case "$power_status" in
  "b true") power_source=battery ;;
  "b false") power_source=ac ;;
esac
if [[ $action == "sync" && -z $power_source ]]; then exit 0; fi
atomic_write() {
  local destination=$1 value=$2 temp
  temp=$(mktemp "$state_dir/.tmp.XXXXXX")
  printf '%s\n' "$value" >"$temp"
  mv -f "$temp" "$destination"
}
if [[ $action == "set" ]]; then
  if [[ -n ${step:-} ]]; then
    current=$(brightnessctl -d "$device" -m | awk -F, '{ gsub("%", "", $4); print $4; exit }')
    [[ $current =~ ^[0-9]+$ ]] || exit 1
    if [[ $requested == "+5%" || $requested == "5%-" ]]; then
      if [[ $requested == "+5%" ]]; then
        value=$(( current < 5 ? current + 1 : current + 5 ))
      else
        value=$(( current <= 5 ? current - 1 : current - 5 ))
      fi
    else
      value=$(( current + step ))
    fi
    (( value < 1 )) && value=1
    (( value > 100 )) && value=100
  fi
  brightnessctl -q -d "$device" set "$value%"
  if [[ -n $power_source ]]; then
    atomic_write "$state_dir/$power_source" "$value"
    atomic_write "$state_dir/active" "$power_source"
  fi
  exit 0
fi
active=""
[[ -r $state_dir/active ]] && IFS= read -r active <"$state_dir/active" || true
if [[ $active != "$power_source" ]]; then
  if [[ $active == "ac" || $active == "battery" ]]; then
    saved=""
    if [[ -r $state_dir/$power_source ]]; then IFS= read -r saved <"$state_dir/$power_source" || true; fi
    if [[ $saved =~ ^[0-9]{1,3}$ ]] && (( saved <= 100 )); then brightnessctl -q -d "$device" set "$saved%"; fi
  fi
  atomic_write "$state_dir/active" "$power_source"
fi

#!/bin/bash

# omarchy:summary=Open the Omarchy background switcher
# omarchy:group=theme
# omarchy:name=bg-switcher
# omarchy:aliases=omarchy background

# Up and Down in the picker switch between this theme's backgrounds, every
# installed theme's, and the user's own loose ones in
# ~/.config/omarchy/backgrounds when there are any. The picker fetches another
# view with `--rows <view>`, which also remembers it as the view to open next.

theme_name=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)
view_file="$HOME/.local/state/omarchy/background-switcher-view"
mine_dir="$HOME/.config/omarchy/backgrounds"

# Whether mine_dir holds media of its own, not just per-theme folders. A glob,
# so opening the switcher starts no process for it; a broken link or a folder
# named like an image does not count.
has_mine() {
  local files file
  shopt -s nullglob nocaseglob
  files=("$mine_dir"/*.{jpg,jpeg,png,gif,bmp,webp,mp4,m4v,mov,webm,mkv,avi})
  shopt -u nullglob nocaseglob
  for file in "${files[@]}"; do
    [[ -f $file ]] && return 0
  done
  return 1
}

# Prints the view to open on: all and mine as asked, while mine has media,
# otherwise theme.
known_view() {
  if [[ $1 == "all" ]] || { [[ $1 == "mine" ]] && has_mine; }; then
    printf '%s' "$1"
  else
    printf '%s' "theme"
  fi
}

# Every installed theme's backgrounds as one folder of "<theme> · <n>" links,
# so the picker labels each by its theme. Files with the same content are
# listed once. Like omarchy-menu-images' rows, the folder is trusted while no
# source directory's mtime has changed, so an unchanged open costs one stat.
all_backgrounds_dir() {
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/backgrounds-all"
  local sources signature list

  shopt -s nullglob
  sources=("$OMARCHY_PATH"/themes/*/backgrounds "$HOME"/.config/omarchy/themes/*/backgrounds "$HOME"/.config/omarchy/backgrounds/*/)
  shopt -u nullglob
  sources=("${sources[@]%/}")

  signature=$(stat -L -c '%Y %n' "${sources[@]}" 2>/dev/null)
  if [[ -d $dir && $signature == "$(cat "$dir.signature" 2>/dev/null)" ]]; then
    printf '%s\n' "$dir"
    return
  fi

  # Only media the picker shows, so a stray copy (say a .bak) never claims a
  # wallpaper's content. Paths holding a tab or newline would break the
  # tab-separated records.
  # Only files that share a size are hashed, in one md5sum run, in order.
  list=$(
    # find lists each source in turn; numbering them keeps that order (stock
    # themes first) while sorting each source's files by name.
    find -L "${sources[@]}" -maxdepth 1 -type f ! -path $'*\n*' ! -path $'*\t*' \
      \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \
         -o -iname '*.mp4' -o -iname '*.m4v' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.avi' \) \
      -printf '%h\t%s\t%f\t%p\n' 2>/dev/null |
      awk -F '\t' '$1 != last { last = $1; source++ } { print source "\t" $0 }' |
      sort -t $'\t' -k1,1n -k4,4 |
      awk -F '\t' '
        NF != 5 { next }
        {
          n = ++rows
          theme = $2
          sub(/\/backgrounds$/, "", theme)
          sub(/.*\//, "", theme)
          size[n] = $3; owner[n] = theme; ext[n] = $4; path[n] = $5; count[$3]++
        }
        END {
          # -z ends each line with NUL and leaves names unescaped, so a hash
          # is matched to its file by name rather than by output order.
          command = "md5sum -z --"
          for (i = 1; i <= rows; i++) {
            if (count[size[i]] < 2) continue
            quoted = path[i]
            gsub(/'\''/, "'\''\\'\'''\''", quoted)
            command = command " '\''" quoted "'\''"
            hashes++
          }
          if (hashes) {
            RS = "\0"
            while ((command | getline line) > 0) hash[substr(line, 35)] = substr(line, 1, 32)
            close(command)
          }
          for (i = 1; i <= rows; i++) {
            k = (path[i] in hash) ? hash[path[i]] : "path:" path[i]
            if (seen[k]++) continue
            sub(/.*\./, "", ext[i])
            print owner[i] " · " ++number[owner[i]] "." ext[i] "\t" path[i]
          }
        }'
  )

  if [[ $list != "$(cat "$dir.list" 2>/dev/null)" ]]; then
    rm -rf "$dir"
    mkdir -p "$dir"
    while IFS=$'\t' read -r name target; do
      [[ -n $name ]] && ln -s "$target" "$dir/$name"
    done <<<"$list"
    printf '%s' "$list" >"$dir.list"
  fi
  printf '%s' "$signature" >"$dir.signature"

  printf '%s\n' "$dir"
}

# Prints the entry in dirs showing the current background. omarchy-theme-set
# copies a theme's backgrounds, and All themes lists one copy of each, so a
# file with the same content counts when the file itself is not there.
current_in_view() {
  local match="" size candidate

  [[ -n $current_background ]] || return 0
  match=$(find -L "${dirs[@]}" -maxdepth 1 -type f -samefile "$current_background" -print -quit 2>/dev/null)
  if [[ -z $match ]] && size=$(stat -L -c '%s' "$current_background" 2>/dev/null); then
    while IFS= read -r -d '' candidate; do
      if cmp -s "$candidate" "$current_background"; then
        match=$candidate
        break
      fi
    done < <(find -L "${dirs[@]}" -maxdepth 1 -type f -size "${size}c" -print0 2>/dev/null)
  fi
  printf '%s' "$match"
}

# Sets dirs to the folders that make up a view.
set_view_dirs() {
  if [[ $1 == "all" ]]; then
    dirs=("$(all_backgrounds_dir)")
  elif [[ $1 == "mine" ]]; then
    dirs=("$mine_dir")
  else
    dirs=("$HOME/.local/state/omarchy/current/theme/backgrounds" "$HOME/.config/omarchy/backgrounds/$theme_name")
  fi
}

if [[ ${1:-} == "--rows" ]]; then
  # Answers for the view asked for, even when it has emptied since the picker
  # opened: the picker then drops it and moves on.
  view=${2:-}
  [[ $view == "all" || $view == "mine" ]] || view="theme"
  mkdir -p "${view_file%/*}"
  printf '%s\n' "$view" >"$view_file"
  set_view_dirs "$view"

  # The picker reads the view, then the image to select, then the rows.
  printf '%s\n' "$view"
  printf '%s\n' "$(current_in_view)"
  omarchy-menu-images --lazy-thumbnails --sizes --print-rows "${dirs[@]}"
else
  view=""
  read -r view 2>/dev/null <"$view_file"
  view=$(known_view "$view")
  set_view_dirs "$view"

  # All themes and the user's own backgrounds are labelled and filterable;
  # either can hold hundreds of images, so their thumbnails are made in the
  # background.
  flags=()
  [[ $view != "theme" ]] && flags+=(--lazy-thumbnails --show-labels --filterable)
  views='{"id":"theme","title":"imagePicker.viewTheme"},{"id":"all","title":"imagePicker.viewAllThemes","labels":true,"filterable":true}'
  has_mine && views+=',{"id":"mine","title":"imagePicker.viewMine","labels":true,"filterable":true}'

  # omarchy-menu-images finds the current background itself, except as a copy.
  selected=""
  [[ $view == "all" ]] && selected=$(current_in_view)

  # --sizes lets the picker show each background's resolution.
  omarchy-menu-images "${flags[@]}" --sizes \
    --selected "${selected:-$current_background}" \
    --views "{\"current\":\"$view\",\"command\":[\"omarchy-theme-bg-switcher\",\"--rows\"],\"views\":[$views]}" \
    "${dirs[@]}"
fi

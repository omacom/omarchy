#!/bin/bash

# omarchy:summary=Open the Omarchy background switcher
# omarchy:group=theme
# omarchy:name=bg-switcher
# omarchy:aliases=omarchy background

theme_name=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

# Without a theme name the user folder is the shared one, which is listed last.
background_dirs=("$HOME/.local/state/omarchy/current/theme/backgrounds")
if [[ -n $theme_name ]]; then
  background_dirs+=("$HOME/.config/omarchy/backgrounds/$theme_name")
fi

omarchy-menu-images \
  --selected "$current_background" \
  "${background_dirs[@]}" \
  "$HOME/.config/omarchy/backgrounds"

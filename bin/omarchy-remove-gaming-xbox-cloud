#!/bin/bash

# omarchy:summary=Remove the Xbox Cloud Gaming web app.

set -e

while (( $# > 0 )); do
  case "$1" in
  -h | --help | help)
    echo "Usage: omarchy-remove-gaming-xbox-cloud"
    echo
    echo "Remove the Xbox Cloud Gaming web app."
    exit 0
    ;;
  *)
    echo "omarchy-remove-gaming-xbox-cloud: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
  shift
done

omarchy-webapp-remove "Xbox Cloud Gaming"

#!/bin/bash

# omarchy:summary=Give each local model that is set up a launcher of its own, and take away those of models removed
# omarchy:hidden=true

# A model set up on this machine gets a launcher beside Agent, as signing in to
# Claude, Codex or Grok adds one: its name, its vendor's logo, and an agent
# opened on it, in the default agent where that can take a local model and in
# pi or OpenCode where it can't. An image, video or music model's opens Fantasi on it instead,
# since no agent runs on one. Removing the model takes the launcher away.
#
# This makes the launchers match the models set up right now, so it is safe to
# run at any time: omarchy-agent-local runs it after a setup or a removal, and
# the agents panel when a setup it started in the background has finished.

APPLICATIONS="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
ICONS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"
LOGOS="$OMARCHY_PATH/shell/plugins/agents/assets"
PREFIX="omarchy-agent-local-"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agent-local"

shopt -s nullglob

# The vendor's logo on a dark tile, which reads under any theme: most of the
# logos are white, drawn for the dark agents panel. The logo's own <svg> turns
# into a group scaled to the tile, keeping the fill its root may carry.
draw_icon() {
  local vendor=$1 target=$2 logo svg attrs body x y w h transform
  logo="$LOGOS/$vendor.svg"
  [[ -f $logo ]] || logo="$LOGOS/local.svg"

  svg=$(tr '\n' ' ' <"$logo")
  [[ $svg =~ \<svg([^\>]*)\>(.*)\</svg\> ]] || return 1
  attrs=${BASH_REMATCH[1]}
  body=${BASH_REMATCH[2]}
  [[ $attrs =~ viewBox=\"([^\"]*)\" ]] || return 1
  read -r x y w h <<<"${BASH_REMATCH[1]//,/ }"
  transform=$(awk -v x="$x" -v y="$y" -v w="$w" -v h="$h" 'BEGIN {
    scale = 272 / (w > h ? w : h)
    printf "translate(%.3f %.3f) scale(%.5f)", 256 - (x + w / 2) * scale, 256 - (y + h / 2) * scale, scale
  }')
  attrs=$(sed -E 's/ (xmlns|viewBox|width|height|style)="[^"]*"//g' <<<"$attrs")

  cat >"$target.tmp" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <rect x="32" y="32" width="448" height="448" rx="104" fill="#16161e" stroke="#3b3d52" stroke-width="8"/>
  <g transform="$transform"$attrs>$body</g>
</svg>
SVG
  mv -f "$target.tmp" "$target"
}

mkdir -p "$APPLICATIONS" "$ICONS" "$STATE"

# omarchy-agent-local and the agents panel can both run this after the same
# setup or removal. Each removes what isn't in its own reading of the models,
# so one at a time, from that reading to the last file removed.
exec 9>"$STATE/launchers.lock"
flock 9

# A reading that fails says nothing about which models are gone, so the
# launchers stay as they are rather than all being taken away. Models still
# downloading, or on their way out, have nothing to open yet.
if ! status=$(omarchy-agent-local status --json 2>/dev/null) ||
  ! jq -e '.models | type == "object"' <<<"$status" >/dev/null 2>&1; then
  echo "Couldn't read which local models are set up" >&2
  exit 1
fi
mapfile -t models < <(jq -r '
  .models | to_entries[]
  | select(.value.unit != "installing" and .value.unit != "removing")
  | [.key, (.value.name // .key | gsub("[[:cntrl:]]"; " ")), (.value.vendor // "local"), (.value.kind // "text")] | @tsv' <<<"$status")

declare -A entries=() icons=()

for model in "${models[@]}"; do
  IFS=$'\t' read -r recipe name vendor kind <<<"$model"
  # The recipe goes on a command line and the vendor into a file name.
  [[ $recipe =~ ^[a-z0-9][a-z0-9._-]*$ ]] || continue
  [[ $vendor =~ ^[a-z0-9-]+$ ]] || vendor="local"
  [[ -n $name ]] || name=$recipe

  entry="$PREFIX$recipe.desktop"
  icon="$PREFIX$vendor"
  app_id="org.omarchy.local.$recipe"
  entries[$entry]=1

  if [[ -z ${icons[$icon.svg]:-} ]]; then
    draw_icon "$vendor" "$ICONS/$icon.svg" || icon="omarchy-agent"
    icons[$icon.svg]=1
  fi

  if [[ $kind == "image" || $kind == "video" || $kind == "music" ]]; then
    case $kind in
      video) made="videos" ;;
      music) made="music" ;;
      *) made="images" ;;
    esac
    cat >"$APPLICATIONS/$entry.tmp" <<ENTRY
[Desktop Entry]
Version=1.0
Name=$name
Comment=Make $made with $name in Fantasi, running on this machine
Exec=fantasi open --model $recipe
Icon=$icon
Terminal=false
Type=Application
Categories=Graphics;
ENTRY
  else
    cat >"$APPLICATIONS/$entry.tmp" <<ENTRY
[Desktop Entry]
Version=1.0
Name=$name
Comment=Start a coding agent on $name, running on this machine
Exec=omarchy-agent --local-model $recipe --app-id=$app_id
Icon=$icon
StartupWMClass=$app_id
Terminal=false
Type=Application
Categories=Development;
X-Omarchy-Dock-Click=new
ENTRY
  fi
  chmod 644 "$APPLICATIONS/$entry.tmp"
  mv -f "$APPLICATIONS/$entry.tmp" "$APPLICATIONS/$entry"
done

# What a model removed since the last run left behind.
for entry in "$APPLICATIONS/$PREFIX"*.desktop; do
  [[ -n ${entries[${entry##*/}]:-} ]] || rm -f "$entry"
done
for icon in "$ICONS/$PREFIX"*.svg; do
  [[ -n ${icons[${icon##*/}]:-} ]] || rm -f "$icon"
done

update-desktop-database "$APPLICATIONS" 2>/dev/null || true

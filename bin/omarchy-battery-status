#!/bin/bash

# omarchy:summary=Returns a formatted battery status string with percentage and power draw/charge.
# omarchy:args=[--shell]

shell_output=false
power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: omarchy-battery-status [--shell]" >&2
    exit 2
    ;;
esac

batteries=$(upower -e 2>/dev/null | grep BAT || true)
[[ -z $batteries ]] && exit 0

# Aggregate every battery. Multi-battery machines (ThinkPads, Surface Book)
# expose one UPower device per pack, and the first one alone misstates the
# charge. Percentage is energy-weighted like UPower's DisplayDevice; the
# remaining time is the most urgent pack's.
total_energy=0
total_full=0
total_rate=0
percentage_sum=0
battery_count=0
min_empty_mins=""
min_full_mins=""
state=""
threshold_start=""
threshold_end=""

while IFS= read -r battery; do
  [[ -n $battery ]] || continue
  battery_info=$(upower -i "$battery" 2>/dev/null)
  [[ -n $battery_info ]] || continue

  read -r energy full rate percent bat_state empty_mins full_mins t_start t_end <<<"$(
    awk '
      $1 == "energy:" { energy = $2 }
      $1 == "energy-full:" { full = $2 }
      $1 == "energy-rate:" { rate = $2 }
      $1 == "percentage:" { percent = $2; sub(/%/, "", percent) }
      $1 == "state:" { st = $2 }
      $3 == "empty:" {
        if ($5 ~ /^minute/) { empty = int($4) }
        else { h = int($4); m = int(($4 - h) * 60); empty = h * 60 + m }
      }
      $3 == "full:" {
        if ($5 ~ /^minute/) { fullm = int($4) }
        else { h = int($4); m = int(($4 - h) * 60); fullm = h * 60 + m }
      }
      $1 == "charge-start-threshold:" { t = $2; gsub(/%/, "", t); tstart = t }
      $1 == "charge-end-threshold:" { t = $2; gsub(/%/, "", t); tend = t }
      END {
        printf "%s %s %s %s %s %s %s %s %s",
          energy + 0, full + 0, rate + 0, percent + 0, st, empty, fullm, tstart, tend
      }
    ' <<<"$battery_info"
  )"

  total_energy=$(awk -v a="$total_energy" -v b="$energy" 'BEGIN { print a + b }')
  total_full=$(awk -v a="$total_full" -v b="$full" 'BEGIN { print a + b }')
  total_rate=$(awk -v a="$total_rate" -v b="$rate" 'BEGIN { print a + b }')
  percentage_sum=$(awk -v a="$percentage_sum" -v b="$percent" 'BEGIN { print a + b }')
  battery_count=$((battery_count + 1))

  case "$bat_state" in
    charging) state="charging" ;;
    discharging) [[ $state != "charging" ]] && state="discharging" ;;
    *) [[ -z $state ]] && state="$bat_state" ;;
  esac

  if [[ -n $empty_mins ]]; then
    if [[ -z $min_empty_mins ]] || ((empty_mins < min_empty_mins)); then
      min_empty_mins=$empty_mins
    fi
  fi
  if [[ -n $full_mins ]]; then
    if [[ -z $min_full_mins ]] || ((full_mins < min_full_mins)); then
      min_full_mins=$full_mins
    fi
  fi
  [[ -z $threshold_start && -n $t_start ]] && threshold_start=$t_start
  [[ -z $threshold_end && -n $t_end ]] && threshold_end=$t_end
done <<<"$batteries"

((battery_count > 0)) || exit 0

if awk -v full="$total_full" 'BEGIN { exit !(full > 0) }'; then
  percentage=$(awk -v energy="$total_energy" -v full="$total_full" 'BEGIN { print int(100 * energy / full) }')
else
  percentage=$(awk -v sum="$percentage_sum" -v count="$battery_count" 'BEGIN { print int(sum / count) }')
fi
capacity=$(awk -v full="$total_full" 'BEGIN { printf "%d", full }')
power_rate_raw=$total_rate

remaining_mins=""
if [[ $state == "charging" ]]; then
  remaining_mins=$min_full_mins
else
  remaining_mins=$min_empty_mins
fi
time_remaining=""
if [[ -n $remaining_mins ]]; then
  if ((remaining_mins < 60)); then
    printf -v time_remaining '%dm' "$remaining_mins"
  else
    if ((remaining_mins % 60 == 0)); then
      printf -v time_remaining '%dh' "$((remaining_mins / 60))"
    else
      printf -v time_remaining '%dh %dm' "$((remaining_mins / 60))" "$((remaining_mins % 60))"
    fi
  fi
fi

# UPower's energy-rate can lag the kernel telemetry by tens of seconds. Use
# the instantaneous sysfs readings when available so the open panel stays
# live. Summed across packs so multi-battery machines report the real draw.
sysfs_rate=""
for bat_dir in "$power_supply_path"/BAT*; do
  [[ -d $bat_dir ]] || continue
  if [[ -r $bat_dir/power_now ]]; then
    watts=$(awk -v microwatts="$(<"$bat_dir/power_now")" 'BEGIN { print microwatts / 1000000 }')
  elif [[ -r $bat_dir/current_now && -r $bat_dir/voltage_now ]]; then
    watts=$(awk \
      -v microamps="$(<"$bat_dir/current_now")" \
      -v microvolts="$(<"$bat_dir/voltage_now")" \
      'BEGIN { print microamps * microvolts / 1000000000000 }')
  else
    continue
  fi
  sysfs_rate=$(awk -v sum="${sysfs_rate:-0}" -v watts="$watts" 'BEGIN { print sum + watts }')
done
[[ -n $sysfs_rate ]] && power_rate_raw=$sysfs_rate

power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
  rounded = sprintf("%.1f", rate)
  sub(/\.0$/, "", rounded)
  print rounded
}')
[[ -z $state ]] && state="unknown"

[[ -z $threshold_end ]] && threshold_end=$(cat "$power_supply_path"/BAT*/charge_control_end_threshold 2>/dev/null | head -1)
[[ -z $threshold_start ]] && threshold_start=$(cat "$power_supply_path"/BAT*/charge_control_start_threshold 2>/dev/null | head -1)

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue

  if [[ $(<"$supply/online") == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_idle=false
if awk -v rate="${power_rate_raw:-0}" 'BEGIN { exit !(rate <= 0.2) }'; then
  charge_idle=true
fi

charge_holding=false
if [[ $ac_online == "true" && -n $threshold_end ]]; then
  if [[ $state == "pending-charge" ]]; then
    charge_holding=true
  elif [[ $state == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ $state == "charging" && $charge_idle == "true" ]] && (( threshold_end < 99 && percentage >= threshold_end )); then
    charge_holding=true
  fi
fi

if [[ $shell_output == "true" ]]; then
  printf 'percentage\t%s\n' "${percentage}%"
  if [[ $charge_holding == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "$state"
  fi
  printf 'rate\t%s\n' "${power_rate}W"
  printf 'size\t%s\n' "${capacity}Wh"
  printf 'time\t%s\n' "$time_remaining"

  cycles=$(cat "$power_supply_path"/BAT*/cycle_count 2>/dev/null | head -1)

  [[ -n $cycles ]] && printf 'cycles\t%s\n' "$cycles"

  if [[ -n $threshold_end ]]; then
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
    else
      printf 'threshold\t%s%%\n' "$threshold_end"
    fi
  fi

  exit 0
fi

if [[ $charge_holding == "true" ]]; then
  if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
    threshold_label="${threshold_start}-${threshold_end}%"
  else
    threshold_label="${threshold_end}%"
  fi

  echo "Battery ${percentage}%  ·  Holding at ${threshold_label}  ·  ${power_rate}W / ${capacity}Wh"
elif [[ $state == "charging" ]]; then
  echo "Battery ${percentage}%  ·  ${time_remaining} to full  ·   ${power_rate}W / ${capacity}Wh"
else
  echo "Battery ${percentage}%  ·  ${time_remaining} left  ·   ${power_rate}W / ${capacity}Wh"
fi

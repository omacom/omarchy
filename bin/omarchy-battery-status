#!/bin/bash

# omarchy:summary=Returns a formatted battery status string with percentage and power draw/charge.
# omarchy:args=[--shell]

shell_output=false
power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: omarchy-battery-status [--shell]" >&2
    exit 2
    ;;
esac

battery=$(upower -e 2>/dev/null | grep BAT | head -n 1)
[[ -z $battery ]] && exit 0

battery_info=$(upower -i "$battery")

format_hours() {
  awk -v hours="$1" 'BEGIN {
    if (hours < 0) hours = 0
    whole = int(hours)
    minutes = int((hours - whole) * 60)
    if (whole == 0) {
      printf "%dm", minutes
    } else if (minutes > 0) {
      printf "%dh %dm", whole, minutes
    } else {
      printf "%dh", whole
    }
  }'
}

percentage=$(awk '/percentage/ { print int($2); exit }' <<<"$battery_info")
capacity=$(awk '/energy-full:/ { printf "%d", $2; exit }' <<<"$battery_info")
time_remaining=$(awk '/time to (empty|full)/ {
  value = $4
  unit = $5
  if (unit ~ /^minute/) {
    printf "%dm", int(value)
  } else {
    hours = int(value)
    minutes = int((value - hours) * 60)
    if (minutes > 0) {
      printf "%dh %dm", hours, minutes
    } else {
      printf "%dh", hours
    }
  }
  exit
}' <<<"$battery_info")
upower_rate=$(awk '/energy-rate/ { print $2; exit }' <<<"$battery_info")
power_rate_raw="$upower_rate"
state=$(awk '/state/ { print $2; exit }' <<<"$battery_info")
native_path=$(awk '/native-path/ { print $2; exit }' <<<"$battery_info")
battery_path="$power_supply_path/$native_path"

# UPower's energy-rate can lag the kernel telemetry by tens of seconds. Use
# the instantaneous sysfs reading when available so the open panel stays live.
# Guards: the read must succeed and be numeric, and the magnitude must be sane.
# Some ECs report bogus values (e.g. MSI BIF0_9 reports current_now=-65A for a
# ~7.5W discharge, yielding -1124W), so reject anything above 150W or wildly
# above UPower's rate and keep the UPower value instead.
sysfs_rate=""
if microwatts=$(cat "$battery_path/power_now" 2>/dev/null) && [[ $microwatts =~ ^[0-9]+$ ]]; then
  sysfs_rate=$(awk -v microwatts="$microwatts" 'BEGIN { print microwatts / 1000000 }')
elif microamps=$(cat "$battery_path/current_now" 2>/dev/null) && [[ $microamps =~ ^-?[0-9]+$ ]] \
  && microvolts=$(cat "$battery_path/voltage_now" 2>/dev/null) && [[ $microvolts =~ ^[0-9]+$ ]]; then
  sysfs_rate=$(awk \
    -v microamps="$microamps" \
    -v microvolts="$microvolts" \
    'BEGIN { print microamps * microvolts / 1000000000000 }')
fi

sysfs_usable=false
if [[ -n $sysfs_rate ]]; then
  if awk -v s="${sysfs_rate:-0}" -v u="${upower_rate:-0}" 'BEGIN {
    s_abs = (s < 0 ? -s : s)
    u_abs = (u < 0 ? -u : u)
    ok = (s_abs <= 150) && (u_abs <= 0.5 || s_abs <= 10 || s_abs <= 3 * u_abs)
    exit !ok
  }'; then
    power_rate_raw="$sysfs_rate"
    sysfs_usable=true
  fi
fi

# Last resort: estimate from charge_now deltas. UPower's estimator can wedge at
# 0W for hours on ECs reporting bogus current, and sysfs is unusable then too.
# charge_now advances in whole steps, so a short window quantises badly (one
# 1mAh step per 5s is 8.6W at 12V) and the panel would flicker between 0W and
# multiples of that step. Keep a short history instead and measure across the
# oldest sample that is at least 30s old, so the value tracks the actual load.
# Every sample records the battery and charge state, so a swapped pack or an
# AC transition can never borrow a reading from the previous battery state.
minimum_window=30
maximum_window=600
rate_cache="${OMARCHY_BATTERY_CACHE:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-battery-rate.cache}"
cache_dir=$(dirname -- "$rate_cache")
charge_sample=$(cat "$battery_path/charge_now" 2>/dev/null)
volt_sample=$(cat "$battery_path/voltage_now" 2>/dev/null)
sampleable=false
if [[ $charge_sample =~ ^[0-9]+$ ]] && [[ $volt_sample =~ ^[0-9]+$ ]] \
  && { [[ $state == "discharging" ]] || [[ $state == "charging" ]]; } \
  && { [[ -d $cache_dir ]] || mkdir -p -- "$cache_dir" 2>/dev/null; }; then
  sampleable=true
fi

if [[ $sampleable == "true" ]]; then
  now_ts=$(date +%s)

  # Keep only this battery's samples from the current state, dropping anything
  # past the maximum window.
  kept_samples=()
  if [[ -r $rate_cache ]]; then
    while read -r sample_battery sample_state sample_ts sample_charge sample_volt; do
      [[ $sample_battery == "$native_path" && $sample_state == "$state" ]] || continue
      [[ $sample_ts =~ ^[0-9]+$ ]] || continue
      (( now_ts - sample_ts <= maximum_window )) || continue
      kept_samples+=("$sample_ts $sample_charge $sample_volt")
    done <"$rate_cache"
  fi

  # Estimate only when neither UPower nor sysfs supplied a usable rate. Older
  # than the minimum window and there is nothing to measure yet, so the panel
  # keeps UPower's 0W until the first full window elapses.
  if [[ $sysfs_usable == "false" ]] \
    && awk -v u="${upower_rate:-0}" 'BEGIN { u_abs = (u < 0 ? -u : u); exit !(u_abs <= 0.5) }'; then
    for sample in "${kept_samples[@]}"; do
      read -r sample_ts sample_charge sample_volt <<<"$sample"
      if (( now_ts - sample_ts >= minimum_window )); then
        delta_charge=$((charge_sample - sample_charge))
        if { [[ $state == "discharging" ]] && (( delta_charge < 0 )); } \
          || { [[ $state == "charging" ]] && (( delta_charge > 0 )); }; then
          avg_volt=$(((volt_sample + sample_volt) / 2))
          estimate=$(awk -v dc="$delta_charge" -v v="$avg_volt" -v dt="$((now_ts - sample_ts))" \
            'BEGIN { dc_abs = (dc < 0 ? -dc : dc); print dc_abs / 1000000 * v / 1000000 / (dt / 3600) }')
          if awk -v e="${estimate:-0}" 'BEGIN { exit !(e >= 0.2 && e <= 150) }'; then
            power_rate_raw="$estimate"
          fi
        fi
        break
      fi
    done
  fi

  {
    for sample in "${kept_samples[@]}"; do
      printf '%s %s %s\n' "$native_path" "$state" "$sample"
    done
    printf '%s %s %s %s %s\n' "$native_path" "$state" "$now_ts" "$charge_sample" "$volt_sample"
  } >"$rate_cache.tmp" 2>/dev/null && mv -f "$rate_cache.tmp" "$rate_cache" 2>/dev/null || true
fi

power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
  if (rate < 0) rate = -rate
  rounded = sprintf("%.1f", rate)
  sub(/\.0$/, "", rounded)
  print rounded
}')

# UPower drops its time estimate whenever its rate is wedged at 0W, which is
# exactly when the estimated rate above takes over, and the panel then loses
# the remaining-time row. Derive it from energy over the rate we settled on.
if [[ -z $time_remaining ]] && awk -v rate="${power_rate_raw:-0}" 'BEGIN { r = (rate < 0 ? -rate : rate); exit !(r > 0.2) }'; then
  energy_now=$(awk '$1 == "energy:" { print $2; exit }' <<<"$battery_info")
  if [[ $energy_now =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    if [[ $state == "charging" ]]; then
      time_remaining=$(format_hours "$(awk -v full="$capacity" -v now="$energy_now" -v r="${power_rate_raw:-0}" \
        'BEGIN { r_abs = (r < 0 ? -r : r); d = full - now; if (d < 0) d = 0; print d / r_abs }')")
    else
      time_remaining=$(format_hours "$(awk -v now="$energy_now" -v r="${power_rate_raw:-0}" \
        'BEGIN { r_abs = (r < 0 ? -r : r); print now / r_abs }')")
    fi
  fi
fi

threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")

[[ -z $threshold_end ]] && threshold_end=$(cat "$power_supply_path"/BAT*/charge_control_end_threshold 2>/dev/null | head -1)
[[ -z $threshold_start ]] && threshold_start=$(cat "$power_supply_path"/BAT*/charge_control_start_threshold 2>/dev/null | head -1)

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue

  if [[ $(<"$supply/online") == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_idle=false
if awk -v rate="${power_rate_raw:-0}" 'BEGIN { r = (rate < 0 ? -rate : rate); exit !(r <= 0.2) }'; then
  charge_idle=true
fi

charge_holding=false
if [[ $ac_online == "true" && -n $threshold_end ]]; then
  if [[ $state == "pending-charge" ]]; then
    charge_holding=true
  elif [[ $state == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ $state == "charging" && $charge_idle == "true" ]] && (( threshold_end < 99 && percentage >= threshold_end )); then
    charge_holding=true
  fi
fi

if [[ $shell_output == "true" ]]; then
  printf 'percentage\t%s\n' "${percentage}%"
  if [[ $charge_holding == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "$state"
  fi
  printf 'rate\t%s\n' "${power_rate}W"
  printf 'size\t%s\n' "${capacity}Wh"
  printf 'time\t%s\n' "$time_remaining"

  cycles=$(cat "$power_supply_path"/BAT*/cycle_count 2>/dev/null | head -1)
  upower_cycles=$(awk '/charge-cycles/ { print $2; exit }' <<<"$battery_info")

  # Some ECs report cycle_count 0 while UPower reports N/A. Omit it so the
  # panel shows "—" instead of a misleading 0.
  if [[ -n $cycles ]]; then
    if ! { [[ $cycles == "0" ]] && { [[ -z $upower_cycles ]] || [[ $upower_cycles == "N/A" ]]; }; }; then
      printf 'cycles\t%s\n' "$cycles"
    fi
  fi

  if [[ -n $threshold_end ]]; then
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
    else
      printf 'threshold\t%s%%\n' "$threshold_end"
    fi
  fi

  exit 0
fi

if [[ $charge_holding == "true" ]]; then
  if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
    threshold_label="${threshold_start}-${threshold_end}%"
  else
    threshold_label="${threshold_end}%"
  fi

  echo "Battery ${percentage}%  ·  Holding at ${threshold_label}  ·  ${power_rate}W / ${capacity}Wh"
elif [[ $state == "charging" ]]; then
  echo "Battery ${percentage}%  ·  ${time_remaining} to full  ·   ${power_rate}W / ${capacity}Wh"
else
  echo "Battery ${percentage}%  ·  ${time_remaining} left  ·   ${power_rate}W / ${capacity}Wh"
fi

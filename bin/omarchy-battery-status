#!/bin/bash

# omarchy:summary=Returns a formatted battery status string with percentage and power draw/charge.
# omarchy:args=[--shell]

shell_output=false
power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

case "${1:-}" in
  "")
    ;;
  --shell)
    shell_output=true
    ;;
  *)
    echo "Usage: omarchy-battery-status [--shell]" >&2
    exit 2
    ;;
esac

# Durations and the status line read in the Omarchy language; the --shell
# time feeds the power panel, which shows it as-is.
# The power reading is joined with no-break spaces so a longer language wraps
# the line between its parts rather than inside "13.1W / 53Wh".
format_duration() {
  local minutes=$1
  if [[ -z $minutes ]] || (( minutes <= 0 )); then
    return
  elif (( minutes < 60 )); then
    omarchy-i18n battery.durationMinutes "$minutes"
  elif (( minutes % 60 == 0 )); then
    omarchy-i18n battery.durationHours "$(( minutes / 60 ))"
  else
    omarchy-i18n battery.durationHoursMinutes "$(( minutes / 60 ))" "$(( minutes % 60 ))"
  fi
}

# UPower names the device after the sysfs entry, and only some kernels call
# that BAT*: Apple Silicon reports battery_macsmc_battery. Match on the class,
# then take the first one that powers the machine: a wireless mouse or keyboard
# is a battery_ device too, and UPower marks it "power supply: no". Keep
# looking past the first, because a laptop can have several packs; an empty
# bay lists a battery with no capacity, which is not a pack, and it can come
# first, so the headline follows the first pack that has some.
battery=""
battery_info=""
fallback=""
fallback_info=""
pack_infos=()
while read -r candidate; do
  [[ -n $candidate ]] || continue
  candidate_info=$(LC_ALL=C upower -i "$candidate" 2>/dev/null) || continue
  if grep -qE '^\s*power supply:\s+yes' <<<"$candidate_info"; then
    if awk '/energy-full:/ { exit !($2 > 0) }' <<<"$candidate_info"; then
      pack_infos+=("$candidate_info")
      if [[ -z $battery ]]; then
        battery=$candidate
        battery_info=$candidate_info
      fi
    elif [[ -z $fallback ]]; then
      fallback=$candidate
      fallback_info=$candidate_info
    fi
  fi
done < <(upower -e 2>/dev/null | grep '/battery_')
if [[ -z $battery ]]; then
  battery=$fallback
  battery_info=$fallback_info
fi
[[ -z $battery ]] && exit 0

percentage=$(awk '/percentage/ { print int($2); exit }' <<<"$battery_info")
capacity=$(awk '/energy-full:/ { printf "%d", $2; exit }' <<<"$battery_info")
energy=$(awk '/^ *energy:/ { print $2; exit }' <<<"$battery_info")
energy_full=$(awk '/energy-full:/ { print $2; exit }' <<<"$battery_info")
upower_hours=$(awk '/time to (empty|full)/ { print ($5 ~ /^minute/ ? $4 / 60 : $4); exit }' <<<"$battery_info")
power_rate_raw=$(awk '/energy-rate/ { print $2; exit }' <<<"$battery_info")
native_path=$(awk '/native-path/ { print $2; exit }' <<<"$battery_info")
battery_path="$power_supply_path/$native_path"

# UPower's energy-rate can lag the kernel telemetry by tens of seconds. Use
# the instantaneous sysfs reading when available so the open panel stays live.
if [[ -r $battery_path/power_now ]]; then
  power_rate_raw=$(awk -v microwatts="$(<"$battery_path/power_now")" 'BEGIN { print microwatts / 1000000 }')
elif [[ -r $battery_path/current_now && -r $battery_path/voltage_now ]]; then
  power_rate_raw=$(awk \
    -v microamps="$(<"$battery_path/current_now")" \
    -v microvolts="$(<"$battery_path/voltage_now")" \
    'BEGIN { print microamps * microvolts / 1000000000000 }')
fi

# Some kernels sign power_now by direction (negative while discharging on
# Apple Silicon); the state field already says which way it flows.
power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
  if (rate < 0) rate = -rate
  rounded = sprintf("%.1f", rate)
  sub(/\.0$/, "", rounded)
  print rounded
}')
state=$(awk '/state/ { print $2; exit }' <<<"$battery_info")
threshold_start=$(awk '/charge-start-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")
threshold_end=$(awk '/charge-end-threshold:/ { gsub(/%/, "", $2); print int($2); exit }' <<<"$battery_info")

# Read the thresholds from the battery UPower resolved rather than a BAT* glob,
# which misses every battery with another name.
[[ -n $threshold_end || ! -r $battery_path/charge_control_end_threshold ]] || threshold_end=$(<"$battery_path/charge_control_end_threshold")
[[ -n $threshold_start || ! -r $battery_path/charge_control_start_threshold ]] || threshold_start=$(<"$battery_path/charge_control_start_threshold")
# The time to full counts to this battery's own limit, never another one's.
charge_limit=${threshold_end:-100}
[[ -n $threshold_end ]] || threshold_end=$(cat "$power_supply_path"/BAT*/charge_control_end_threshold 2>/dev/null | head -1)
[[ -n $threshold_start ]] || threshold_start=$(cat "$power_supply_path"/BAT*/charge_control_start_threshold 2>/dev/null | head -1)

# Time left is the energy left over the draw shown beside it, so the two always
# agree; charging counts up to the charge limit. UPower's own estimate averages
# the draw, and stands in only when the readings to do the sum are missing.
minutes_remaining=$(awk \
  -v energy="$energy" -v full="$energy_full" -v rate="${power_rate_raw:-0}" \
  -v state="$state" -v limit="$charge_limit" -v fallback="$upower_hours" 'BEGIN {
  if (rate < 0) rate = -rate
  if (energy != "" && full != "" && rate > 0.2) {
    hours = state == "charging" ? (full * limit / 100 - energy) / rate : energy / rate
  } else {
    hours = fallback
  }
  if (hours == "" || hours <= 0) exit
  printf "%d", int(hours * 60 + 0.5)
}')
time_remaining=$(format_duration "$minutes_remaining")

ac_online=false
for supply in "$power_supply_path"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue

  if [[ $(<"$supply/online") == "1" ]]; then
    ac_online=true
    break
  fi
done

charge_idle=false
if awk -v rate="${power_rate_raw:-0}" 'BEGIN { exit !(rate <= 0.2) }'; then
  charge_idle=true
fi

charge_holding=false
if [[ $ac_online == "true" && -n $threshold_end ]]; then
  if [[ $state == "pending-charge" ]]; then
    charge_holding=true
  elif [[ $state == "fully-charged" ]] && (( percentage < 99 )); then
    charge_holding=true
  elif [[ $state == "charging" && $charge_idle == "true" ]] && (( threshold_end < 99 && percentage >= threshold_end )); then
    charge_holding=true
  fi
fi

# With several packs, describe them together and list each one. UPower's
# display device already sums them, but it keeps counting a dead pack's
# capacity, so when only one pack still holds charge, describe that one.
pack_lines=""
if (( ${#pack_infos[@]} > 1 )); then
  combined=$(
    {
      printf '@display\n'
      LC_ALL=C upower -i /org/freedesktop/UPower/devices/DisplayDevice 2>/dev/null
      printf '@pack\n%s\n' "${pack_infos[@]}"
    } | awk -v supply_path="$power_supply_path" -v ac_online="$ac_online" '
      function measure(value, parts) {
        split(value, parts, /[ %]/)
        return parts[1] ~ /^-?[0-9]+([.][0-9]+)?$/ ? parts[1] + 0 : ""
      }

      function read_value(path, value, result) {
        result = (getline value < path)
        close(path)
        return result > 0 ? value : ""
      }

      function kernel_rate(path, power, current, voltage) {
        power = read_value(path "power_now")
        if (power ~ /^-?[0-9]+$/) return (power < 0 ? -power : power) / 1000000
        current = read_value(path "current_now")
        voltage = read_value(path "voltage_now")
        if (current ~ /^-?[0-9]+$/ && voltage ~ /^[0-9]+$/) return (current < 0 ? -current : current) * voltage / 1000000000000
        return ""
      }

      function upower_hours(value, parts) {
        split(value, parts, " ")
        if (parts[2] ~ /^minute/) return parts[1] / 60
        if (parts[2] ~ /^hour/) return parts[1] + 0
        return ""
      }

      # A pack that stores no energy and moves none is dead or disconnected,
      # unless it still shows a cell voltage: then it is only drained.
      function holds_charge(i) {
        if (voltage[i] != "" && voltage[i] > 1) return 1
        return !(energy[i] != "" && energy[i] <= 0 && !(rate[i] > 0))
      }

      # Firmware will not charge a pack sitting at or above its start
      # threshold, and often stops a percent short of an end-only one. Some
      # keeps reporting charging at a trickle once it reaches the end.
      function at_limit(i, charging) {
        charging = state[i] == "charging"
        if (!charging && state[i] != "pending-charge" && state[i] != "fully-charged") return 0
        if (rate[i] > 0.2 || !(end[i] > 0 && end[i] < 100)) return 0
        if (state[i] == "fully-charged" && percentage[i] >= 99) return 0
        if (charging) return percentage[i] >= end[i]
        return percentage[i] >= (start[i] > 0 && start[i] < end[i] ? start[i] : end[i] - 1)
      }

      /^@display$/ { section = "display"; next }
      /^@pack$/ { section = ++count; next }
      match($0, /^[[:space:]]*[a-z -]+:/) {
        key = substr($0, RSTART, RLENGTH - 1)
        sub(/^[[:space:]]+/, "", key)
        value = substr($0, RSTART + RLENGTH)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
        data[section, key] = value
      }

      END {
        for (i = 1; i <= count; i++) {
          name[i] = data[i, "native-path"]
          sub(/^.*\//, "", name[i])
          path = supply_path "/" name[i] "/"
          state[i] = data[i, "state"]
          percentage[i] = measure(data[i, "percentage"])
          energy[i] = measure(data[i, "energy"])
          full[i] = measure(data[i, "energy-full"])
          rate[i] = measure(data[i, "energy-rate"])
          kernel[i] = kernel_rate(path)
          voltage[i] = read_value(path "voltage_now")
          voltage[i] = voltage[i] ~ /^[0-9]+$/ ? sprintf("%.2f", voltage[i] / 1000000) + 0 : ""
          cycles[i] = read_value(path "cycle_count")
          # The kernel holds the limit in force; UPower can report a preset.
          start[i] = read_value(path "charge_control_start_threshold")
          end[i] = read_value(path "charge_control_end_threshold")
          if (start[i] == "") start[i] = measure(data[i, "charge-start-threshold"])
          if (end[i] == "") end[i] = measure(data[i, "charge-end-threshold"])
          if (holds_charge(i)) live[++live_count] = i
        }

        source = live_count == 1 ? live[1] : "display"
        pct = measure(data[source, "percentage"])
        size = measure(data[source, "energy-full"])
        upower_rate = measure(data[source, "energy-rate"])
        now = data[source, "state"]
        if (live_count == 1) headline[headline_count = 1] = live[1]
        else for (n = 1; n <= count; n++) headline[++headline_count] = n

        # UPower lags the kernel by tens of seconds, so use the kernel readings
        # when every pack has one.
        watts = 0
        for (n = 1; n <= headline_count; n++) {
          if (kernel[headline[n]] == "") break
          watts += kernel[headline[n]]
        }
        if (n <= headline_count) watts = upower_rate

        # As with one pack, time left is the energy left over the draw shown
        # beside it; charging counts each pack up to its own limit, and a pack
        # already held at its limit takes no more. The UPower estimate stands in
        # when a reading is missing or the draw is negligible.
        left = 0
        for (n = 1; n <= headline_count; n++) {
          i = headline[n]
          if (energy[i] == "" || full[i] == "") break
          if (now != "charging") gap = energy[i]
          else if (at_limit(i)) gap = 0
          else gap = full[i] * (end[i] > 0 ? end[i] : 100) / 100 - energy[i]
          left += gap > 0 ? gap : 0
        }
        if (n > headline_count && watts > 0.2) hours = left / watts
        else hours = upower_hours(data[source, now == "charging" ? "time to full" : "time to empty"])

        # One pack still filling means the machine is charging, not holding.
        # Packs held at different limits share none worth naming; each pack
        # line carries its own.
        holding = "false"
        shared = 1
        if (ac_online == "true") {
          for (n = 1; n <= live_count; n++) {
            i = live[n]
            if (at_limit(i)) {
              if (holding == "false") limit = i
              else if (start[i] != start[limit] || end[i] != end[limit]) shared = 0
              holding = "true"
            } else if (state[i] != "fully-charged") {
              holding = "false"
              break
            }
          }
        }

        rounded = sprintf("%.1f", watts)
        sub(/\.0$/, "", rounded)
        printf "percentage\t%s\n", pct != "" ? int(pct) : ""
        printf "capacity\t%d\n", size
        printf "minutes_remaining\t%s\n", (hours == "" || hours <= 0) ? "" : int(hours * 60 + 0.5)
        printf "power_rate\t%s\n", rounded
        printf "state\t%s\n", now
        printf "charge_holding\t%s\n", holding
        printf "threshold_start\t%s\n", holding == "true" && shared ? start[limit] : ""
        printf "threshold_end\t%s\n", holding == "true" && shared ? end[limit] : ""
        for (i = 1; i <= count; i++) {
          printf "pack.%d.path\t%s\n", i - 1, name[i]
          printf "pack.%d.cycles\t%s\n", i - 1, cycles[i]
          printf "pack.%d.thresholdStart\t%s\n", i - 1, start[i]
          printf "pack.%d.thresholdEnd\t%s\n", i - 1, end[i]
          printf "pack.%d.voltage\t%s\n", i - 1, voltage[i]
        }
      }
    '
  )

  while IFS=$'\t' read -r key value; do
    case $key in
      percentage) percentage=$value ;;
      capacity) capacity=$value ;;
      minutes_remaining) time_remaining=$(format_duration "$value") ;;
      power_rate) power_rate=$value ;;
      state) state=$value ;;
      charge_holding) charge_holding=$value ;;
      threshold_start) threshold_start=$value ;;
      threshold_end) threshold_end=$value ;;
      pack.*) pack_lines+="$key"$'\t'"$value"$'\n' ;;
    esac
  done <<<"$combined"
fi

if [[ $shell_output == "true" ]]; then
  printf 'percentage\t%s\n' "${percentage}%"
  if [[ $charge_holding == "true" ]]; then
    printf 'state\tholding\n'
  else
    printf 'state\t%s\n' "$state"
  fi
  printf 'rate\t%s\n' "${power_rate}W"
  printf 'size\t%s\n' "${capacity}Wh"
  printf 'time\t%s\n' "$time_remaining"

  cycles=""
  [[ ! -r $battery_path/cycle_count ]] || cycles=$(<"$battery_path/cycle_count")
  [[ -n $cycles ]] || cycles=$(cat "$power_supply_path"/BAT*/cycle_count 2>/dev/null | head -1)

  # Each pack's count is listed below; a single number would mislead.
  [[ -n $pack_lines ]] && cycles=""
  [[ -n $cycles ]] && printf 'cycles\t%s\n' "$cycles"

  if [[ -n $threshold_end ]]; then
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      printf 'threshold\t%s-%s%%\n' "$threshold_start" "$threshold_end"
    else
      printf 'threshold\t%s%%\n' "$threshold_end"
    fi
  fi

  printf '%s' "$pack_lines"
  exit 0
fi

# The power reading shows its numbers in the language's own way.
power_reading="$(omarchy-i18n --number "$power_rate")W / $(omarchy-i18n --number "$capacity")Wh"

if [[ $charge_holding == "true" ]]; then
  if [[ -z $threshold_end ]]; then
    holding_label=$(omarchy-i18n battery.holding)
  else
    if [[ -n $threshold_start && $threshold_start != $threshold_end ]]; then
      threshold_label="$(omarchy-i18n --number "$threshold_start")-$(omarchy-i18n --number "$threshold_end")%"
    else
      threshold_label="$(omarchy-i18n --number "$threshold_end")%"
    fi
    holding_label=$(omarchy-i18n battery.holdingAt "$threshold_label")
  fi

  echo "$(omarchy-i18n battery.statusLabel "$percentage")  ·  ${holding_label}  ·  ${power_reading}"
elif [[ $state == "charging" ]]; then
  echo "$(omarchy-i18n battery.statusLabel "$percentage")  ·  $(omarchy-i18n battery.toFull "$time_remaining")  ·   ${power_reading}"
else
  echo "$(omarchy-i18n battery.statusLabel "$percentage")  ·  $(omarchy-i18n battery.timeLeft "$time_remaining")  ·   ${power_reading}"
fi

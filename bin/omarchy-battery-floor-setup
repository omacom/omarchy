#!/bin/bash

# omarchy:summary=Set up suspend battery floor (power off a bagged laptop instead of draining to zero)
# omarchy:group=battery-floor
# omarchy:name=setup
# omarchy:requires-sudo=true
# omarchy:args=[--force]

FORCE=false
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
  esac
done

HOOK_DEST="/usr/lib/systemd/system-sleep/battery-floor"

install_root_file() {
  local source="$1"
  local destination="$2"
  local mode="$3"
  local stage

  stage=$(sudo /usr/bin/mktemp -- "${destination%/*}/.${destination##*/}.omarchy.XXXXXX") || return 1
  safe_stage_path "$stage" "$destination" || return 1

  if sudo /usr/bin/install -m "$mode" -o root -g root -T "$source" "$stage" &&
    sudo /usr/bin/mv -Tf -- "$stage" "$destination"; then
    return 0
  else
    safe_stage_path "$stage" "$destination" && sudo /usr/bin/rm -f -- "$stage"
    return 1
  fi
}

safe_stage_path() {
  local stage="$1"
  local destination="$2"
  local prefix suffix

  prefix="${destination%/*}/.${destination##*/}.omarchy."
  [[ $stage == "$prefix"* ]] || return 1
  suffix=${stage#"$prefix"}
  [[ $suffix =~ ^[[:alnum:]]{6}$ ]]
}

if ! omarchy-battery-present; then
  echo "No battery detected; the suspend battery floor is for laptops"
  exit 0
fi

if ! $FORCE && omarchy-hibernation-available; then
  echo "Hibernation is already set up, so hibernate is available on this machine."
  echo "The battery floor only protects plain suspends. Use --force to install it anyway."
  exit 0
fi

if ! $FORCE; then
  if ! gum confirm "Power off a lid-closed, undocked laptop 20 minutes after it suspends on battery?"; then
    exit 0
  fi
fi

sudo mkdir -p /usr/lib/systemd/system-sleep
if ! install_root_file "$OMARCHY_PATH/default/systemd/system-sleep/battery-floor" \
  "$HOOK_DEST" 0755; then
  echo "Could not install the battery-floor system-sleep hook" >&2
  exit 1
fi

echo "Suspend battery floor is set up: a lid-closed, undocked suspend powers off 20 minutes in, even on early wakes"

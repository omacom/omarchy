#!/bin/bash

# omarchy:summary=Launch Amp with its first message piped in
# omarchy:args=[--wait] <amp> <prompt>
# omarchy:hidden=true

# Amp takes its first interactive message from piped input; a positional
# message is for --execute, which exits after one turn. The binary rides in
# as an argument so a user install can replace it, and this launch needs no
# bash -c through xdg-terminal-exec -e. When launched in its own terminal
# window (--wait), hold the window open after Amp finishes its piped turn.
wait=false
if [[ ${1:-} == "--wait" ]]; then
  wait=true
  shift
fi

printf "%s\n" "$2" | "$1" --dangerously-allow-all
status=$?

if [[ $wait == "true" ]]; then
  read -r </dev/tty || true
fi

exit "$status"

#!/bin/bash

# omarchy:summary=Move an older monitors.lua over to the monitor panel's saved settings
# omarchy:hidden=true

# Older versions kept Omarchy's monitor defaults in hypr/monitors.lua and saved
# the display panel's scale there as rules naming the connector. The defaults
# now live in default/hypr/monitors.lua and the panel's choices are saved per
# monitor, so this turns such a file into the new template and what's left:
#
# - omarchy_monitor_scale, omarchy_gdk_scale and the lines using them go, or
#   become plain lines where they no longer match Omarchy's defaults;
# - a one-line rule for a connector with only a mode, a position and a number
#   scale becomes that monitor's saved settings, when the monitor behind the
#   connector is known, and goes when settings are already saved for it;
# - every other line is kept, in order, below the template.
#
# The old file is kept beside it as monitors.lua.bak.<time>. A file with
# nothing to move is left alone.

monitor_lua="$HOME/.config/hypr/monitors.lua"
template="$OMARCHY_PATH/config/hypr/monitors.lua"
settings="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitors/settings"

[[ -f $monitor_lua && -f $template ]] || exit 0
target=$(readlink -f "$monitor_lua")

re_monitor_scale='^local[[:space:]]+omarchy_monitor_scale[[:space:]]*=[[:space:]]*(.+)$'
re_gdk_scale='^local[[:space:]]+omarchy_gdk_scale[[:space:]]*=[[:space:]]*(.+)$'
re_gdk_env_local='^hl\.env\("GDK_SCALE",[[:space:]]*tostring\(omarchy_gdk_scale\)\)$'
re_gdk_env='^hl\.env\("GDK_SCALE",[[:space:]]*"([^"]*)"\)$'
re_catch_all='^hl\.monitor\(\{[[:space:]]*output[[:space:]]*=[[:space:]]*"",[[:space:]]*mode[[:space:]]*=[[:space:]]*"preferred",[[:space:]]*position[[:space:]]*=[[:space:]]*"auto",[[:space:]]*scale[[:space:]]*=[[:space:]]*omarchy_monitor_scale[[:space:]]*\}\)$'
re_rule='^hl\.monitor\(\{[[:space:]]*output[[:space:]]*=[[:space:]]*"([A-Za-z0-9._-]+)",[[:space:]]*mode[[:space:]]*=[[:space:]]*"([^"]*)",[[:space:]]*position[[:space:]]*=[[:space:]]*"([^"]*)",[[:space:]]*scale[[:space:]]*=[[:space:]]*([0-9]+([.][0-9]+)?)[[:space:]]*\}\)$'
re_number='^[0-9]+([.][0-9]+)?$'

changed=0
monitor_scale=""
monitor_scale_line=""
gdk_scale=""
gdk_scale_line=""
kept=()

saved() {
  [[ -f $settings ]] && awk -F'\t' -v identity="$1" '$4 == identity { found = 1 } END { exit !found }' "$settings"
}

while IFS= read -r line || [[ -n $line ]]; do
  code="${line%%--*}"
  code="${code#"${code%%[![:space:]]*}"}"
  code="${code%"${code##*[![:space:]]}"}"

  # Comments and blank lines: the old file keeps them in its backup.
  [[ -n $code ]] || continue

  if [[ $code =~ $re_monitor_scale ]]; then
    monitor_scale="${BASH_REMATCH[1]//\"/}"
    monitor_scale_line="$line"
    changed=1
  elif [[ $code =~ $re_gdk_scale ]]; then
    gdk_scale="${BASH_REMATCH[1]//\"/}"
    gdk_scale_line="$line"
    changed=1
  elif [[ $code =~ $re_gdk_env_local || $code =~ $re_catch_all ]]; then
    changed=1
  elif [[ $code =~ $re_gdk_env ]]; then
    gdk_scale="${BASH_REMATCH[1]}"
    changed=1
  elif [[ $code =~ $re_rule ]]; then
    output="${BASH_REMATCH[1]}"
    mode="${BASH_REMATCH[2]}"
    position="${BASH_REMATCH[3]}"
    scale="${BASH_REMATCH[4]}"
    [[ $mode == "preferred" ]] && mode=""
    [[ $position == "auto" ]] && position=""
    identity=$(omarchy-hyprland-monitor-identity "$output" 2>/dev/null)

    # A connector nothing knows the monitor behind can't be saved by monitor,
    # so its rule stays where it is.
    if [[ -z $identity || $identity == "$output" ]]; then
      kept+=("$line")
    elif saved "$identity"; then
      changed=1
    elif omarchy-hyprland-monitor-persist "$output" "$scale" "$mode" "$position"; then
      changed=1
    else
      kept+=("$line")
    fi
  else
    kept+=("$line")
  fi
done <"$target"

(( changed )) || exit 0

extras=()

# A default that differs from Omarchy's own becomes a plain line; one that
# isn't a plain number keeps the lines that set it.
if [[ $monitor_scale =~ $re_number ]]; then
  extras+=("hl.monitor({ output = \"\", mode = \"preferred\", position = \"auto\", scale = $monitor_scale })")
elif [[ -n $monitor_scale && $monitor_scale != "auto" ]]; then
  extras+=("$monitor_scale_line" 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })')
  monitor_scale_line=""
fi
if [[ $gdk_scale =~ ^[0-9]+$ ]]; then
  (( gdk_scale == 2 )) || extras+=("hl.env(\"GDK_SCALE\", \"$gdk_scale\")")
elif [[ -n $gdk_scale ]]; then
  extras+=("${gdk_scale_line:-hl.env(\"GDK_SCALE\", \"$gdk_scale\")}")
  [[ -n $gdk_scale_line ]] && extras+=('hl.env("GDK_SCALE", tostring(omarchy_gdk_scale))')
  gdk_scale_line=""
fi

# A kept line that still names one of the old locals needs it defined.
if (( ${#kept[@]} )); then
  [[ -n $monitor_scale_line ]] && printf '%s\n' "${kept[@]}" | grep -q '\<omarchy_monitor_scale\>' && extras+=("$monitor_scale_line")
  [[ -n $gdk_scale_line ]] && printf '%s\n' "${kept[@]}" | grep -q '\<omarchy_gdk_scale\>' && extras+=("$gdk_scale_line")
  extras+=("${kept[@]}")
fi

backup="$target.bak.$(date +%s)"
cp -p "$target" "$backup"

# Hyprland reloads on every write, so build the new file beside the real one
# and rename it into place, through any symlink, in one step.
tmp=$(mktemp "$target.XXXXXX")
{
  cat "$template"
  if (( ${#extras[@]} )); then
    printf '\n-- Kept from your earlier monitors.lua, which is saved as %s.\n' "${backup##*/}"
    printf '%s\n' "${extras[@]}"
  fi
} >"$tmp"
chmod --reference="$target" "$tmp"
mv "$tmp" "$target"

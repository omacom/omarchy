#!/bin/bash

# omarchy:summary=Keep a machine awake while a GPU process is running
# omarchy:args=<busy|once|watch|limits|enable>

set -euo pipefail

busy() {
  if [[ -n ${OMARCHY_ML_GPU_BUSY+x} ]]; then
    [[ $OMARCHY_ML_GPU_BUSY == 1 ]]
    return
  fi
  if omarchy-cmd-present nvidia-smi; then
    local apps
    apps=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2>/dev/null || true)
    [[ -n ${apps//[[:space:]]/} ]]
    return
  fi
  if omarchy-cmd-present rocm-smi; then
    local apps
    apps=$(rocm-smi --showpids 2>/dev/null || true)
    [[ $apps == *PID* ]]
    return
  fi
  return 1
}

write_limits() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user.conf.d"
  mkdir -p "$dir"
  cat > "$dir/omarchy-ml.conf" <<'EOF'
[Manager]
DefaultLimitNOFILE=1048576
EOF
  if ((EUID == 0)); then
    mkdir -p /etc/security/limits.d
    cat > /etc/security/limits.d/omarchy-ml.conf <<'EOF'
* soft nofile 1048576
* hard nofile 1048576
EOF
  fi
  echo "Open files limit is 1048576 for this user. Log in again so it applies."
  echo "Lid close and suspend stay blocked only while a GPU process is running."
}

enable_service() {
  write_limits
  local unit="$OMARCHY_PATH/default/systemd/user/omarchy-ml-long-job.service"
  local dest="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omarchy-ml-long-job.service"
  install -Dm644 "$unit" "$dest"
  systemctl --user daemon-reload
  systemctl --user enable --now omarchy-ml-long-job.service
}

case "${1:-}" in
  busy)
    busy
    ;;
  once)
    if busy; then
      echo inhibit
    else
      echo idle
    fi
    ;;
  watch)
    while true; do
      if busy; then
        systemd-inhibit --what=sleep:idle:handle-lid-switch --who=omarchy-ml --why="GPU work is running" --mode=block \
          bash -c 'while omarchy-ml-long-job busy; do sleep 15; done'
      fi
      sleep 15
    done
    ;;
  limits)
    write_limits
    ;;
  enable)
    enable_service
    ;;
  *)
    echo "Usage: omarchy ml long-job <busy|once|watch|limits|enable>" >&2
    exit 1
    ;;
esac

#!/bin/bash

# omarchy:summary=Disable LLMNR and multicast DNS in systemd-resolved
# omarchy:requires-sudo=true

set -euo pipefail

case "${1:-}" in
  --help | -h)
    echo "Usage: omarchy-setup-security-resolved"
    echo "Disables LLMNR and multicast DNS in systemd-resolved; discovery through Avahi remains enabled."
    exit 0
    ;;
  "") ;;
  *) echo "Usage: omarchy-setup-security-resolved" >&2; exit 2 ;;
esac
if (( $# > 1 )); then
  echo "Usage: omarchy-setup-security-resolved" >&2
  exit 2
fi

echo "Disables LLMNR and multicast DNS in systemd-resolved; discovery through Avahi remains enabled."
# Harden systemd-resolved against local name resolution poisoning
sudo mkdir -p /etc/systemd/resolved.conf.d
sudo tee /etc/systemd/resolved.conf.d/99-omarchy-hardening.conf >/dev/null <<'EOF'
[Resolve]
LLMNR=no
MulticastDNS=no
EOF

if systemctl is-active --quiet systemd-resolved; then
  sudo systemctl restart systemd-resolved
fi

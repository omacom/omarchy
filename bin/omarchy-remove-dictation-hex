#!/bin/bash

# omarchy:summary=Remove Hex dictation
# omarchy:requires-sudo=true

set -e

while (( $# > 0 )); do
  case "$1" in
  -h | --help | help)
    echo "Usage: omarchy-remove-dictation-hex"
    echo
    echo "Remove Hex dictation"
    exit 0
    ;;
  *)
    echo "omarchy-remove-dictation-hex: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
  shift
done

systemctl --user disable --now hex.service 2>/dev/null || true
omarchy-pkg-drop hex-bin
systemctl --user daemon-reload

# Hex's settings, history, and downloaded models stay in ~/.local/share/hex.
backend_config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults/dictation"
if [[ -f $backend_config && $(< "$backend_config") == "hex" ]]; then
  rm "$backend_config"
fi

omarchy-restart-hyprctl

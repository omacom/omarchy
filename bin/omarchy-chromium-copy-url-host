#!/bin/bash

# omarchy:summary=Native messaging host for Omarchy's Chromium browser integration
# omarchy:hidden=true

set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
export OMARCHY_PATH="${OMARCHY_PATH:-$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)}"
export PATH="$OMARCHY_PATH/bin:/usr/local/bin:/usr/bin:$PATH"

parse_url() {
  jq -r '.url // empty' 2>/dev/null <<<"$1" || true
}

parse_action() {
  jq -r '.action // "copy"' 2>/dev/null <<<"$1" || true
}

copy_url() {
  local url="$1"

  [[ -n $url ]] || return 1
  printf '%s' "$url" | wl-copy --type text/plain
  omarchy-notification-send -g 󰅍 "URL copied to clipboard"
}

open_url() {
  local url="$1"

  [[ ${url,,} =~ ^https?://[^[:space:]]+$ ]] || return 1
  omarchy-launch-browser "$url" >/dev/null 2>&1
}

reply_copied() {
  if [[ $1 == "true" ]]; then
    printf '\x0f\x00\x00\x00{"copied":true}'
  else
    printf '\x10\x00\x00\x00{"copied":false}'
  fi
}

reply_opened() {
  if [[ $1 == "true" ]]; then
    printf '\x0f\x00\x00\x00{"opened":true}'
  else
    printf '\x10\x00\x00\x00{"opened":false}'
  fi
}

main() {
  local length payload action url

  length=$(head -c4 | od -An -v -tu4 --endian=little | tr -d ' ')
  [[ -n ${length:-} ]] && (( length > 0 )) || exit 0

  payload=$(head -c "$length")
  action=$(parse_action "$payload")
  url=$(parse_url "$payload")

  case $action in
  copy)
    if copy_url "$url"; then
      reply_copied true
    else
      reply_copied false
    fi
    ;;
  open)
    if open_url "$url"; then
      reply_opened true
    else
      reply_opened false
    fi
    ;;
  *) reply_opened false ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi

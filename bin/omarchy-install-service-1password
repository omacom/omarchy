#!/bin/bash

# omarchy:summary=Install 1Password and its Chromium extension.
# omarchy:requires-sudo=true

set -e

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_DIR="/usr/share/chromium/extensions"
EXTENSION_FILE="$EXTENSION_DIR/$EXTENSION_ID.json"
WEBSTORE_UPDATE_URL="https://clients2.google.com/service/update2/crx"
ONEPASSWORD_DIR=${OMARCHY_1PASSWORD_DIR:-/opt/1Password}
ONEPASSWORD_TARBALL_URL=${OMARCHY_1PASSWORD_TARBALL_URL:-https://downloads.1password.com/linux/tar/stable/aarch64/1password-latest.tar.gz}

install_chromium_extension() {
  if omarchy-cmd-missing chromium; then
    echo "Chromium is not installed; skipping 1Password Chromium extension."
    return
  fi

  sudo mkdir -p "$EXTENSION_DIR"
  printf '{ "external_update_url": "%s" }\n' "$WEBSTORE_UPDATE_URL" | sudo tee "$EXTENSION_FILE" >/dev/null
  sudo chmod 644 "$EXTENSION_FILE"
}

# AUR 1password is x86_64-only, but omarchy-pkgs supplies an aarch64 package
# on edge (since omarchy-pkgs ca99c24 / Sep 5). Prefer pacman when available;
# use the official tarball only when the package is missing (stable/rc lag).
install_1password_aarch64() {
  if pacman -Si 1password &>/dev/null; then
    echo "1Password is available via pacman; installing..."
    omarchy-pkg-add 1password 1password-cli
    return
  fi

  local tmp extracted tarball_version installed_version

  tmp=$(mktemp -d)
  # Subshell so the cleanup trap cannot leak onto later helpers.
  (
    trap 'rm -rf "$tmp"' EXIT

    echo "Downloading 1Password for aarch64..."
    curl --fail --location --retry 3 "$ONEPASSWORD_TARBALL_URL" --output "$tmp/1password-latest.tar.gz"
    tar -xf "$tmp/1password-latest.tar.gz" -C "$tmp"

    extracted=
    for dir in "$tmp"/1password-*; do
      if [[ -d $dir ]]; then
        extracted=$dir
        break
      fi
    done
    if [[ -z $extracted ]]; then
      echo "Error: 1Password tarball did not contain a 1password-* directory." >&2
      exit 1
    fi

    if [[ ${extracted##*/} =~ ^1password-([0-9][^/]+)\.arm64$ ]]; then
      tarball_version=${BASH_REMATCH[1]}
    elif [[ -x $extracted/1password ]]; then
      tarball_version=$("$extracted/1password" --version 2>/dev/null || true)
    fi

    if [[ -x $ONEPASSWORD_DIR/1password ]]; then
      installed_version=$("$ONEPASSWORD_DIR/1password" --version 2>/dev/null || true)
    fi

    if [[ -n $tarball_version && -n $installed_version && $installed_version == *"$tarball_version"* ]]; then
      echo "1Password $installed_version is already current."
      exit 0
    fi

    echo "Installing 1Password ${tarball_version:-from tarball}..."
    sudo rm -rf "$ONEPASSWORD_DIR"
    sudo mkdir -p "$ONEPASSWORD_DIR"
    sudo mv "$extracted"/* "$ONEPASSWORD_DIR"/

    if [[ ! -x $ONEPASSWORD_DIR/after-install.sh ]]; then
      echo "Error: 1Password tarball is missing after-install.sh." >&2
      exit 1
    fi
    sudo "$ONEPASSWORD_DIR/after-install.sh"
  )
}

echo "Installing 1Password..."
machine=$(uname -m)
if [[ $machine == "aarch64" || $machine == "arm64" ]]; then
  install_1password_aarch64
else
  omarchy-pkg-add 1password 1password-cli
fi

echo "Installing 1Password extension for Chromium..."
install_chromium_extension

echo "Opening 1Password..."
uwsm-app -- 1password >/dev/null 2>&1 &

echo ""
echo "1Password has been installed. Restart Chromium to load the browser extension."

#!/bin/bash

# omarchy:summary=Mark an Omarchy release's what's-new notes as seen
# omarchy:args=<release>
# omarchy:hidden=true

set -euo pipefail

release=${1:-}
if [[ ! $release =~ ^[0-9]+\.[0-9]+$ ]]; then
  echo "Usage: omarchy-update-whats-new-seen <release>" >&2
  exit 2
fi

omarchy-done mark "whats-new-$release"

# The update icon stands in for the notes until they're seen; tell it they are.
omarchy-shell -q omarchy.system-update refreshWhatsNew >/dev/null 2>&1 || true

#!/bin/bash

# omarchy:summary=Install the Hermes desktop app
# omarchy:requires-sudo=true

set -e

if (( EUID == 0 )); then
  echo "Run this command as your desktop user, without sudo." >&2
  exit 1
fi

# The same install the default agent gets, plus opening the window.
omarchy-install-hermes-cli --now

echo "Opening Hermes Desktop..."
# Prefer the user-PATH override (5-tuple safe) over stock /usr/bin when present.
launcher="$HOME/.config/omarchy/bin/hermes-desktop"
if [[ ! -x $launcher ]]; then
  launcher=$(command -v hermes-desktop 2>/dev/null || true)
fi
[[ -x ${launcher:-} ]] || launcher=/usr/bin/hermes-desktop
setsid uwsm-app -- "$launcher" >/dev/null 2>&1 &

echo ""
echo "Hermes Desktop has been installed."

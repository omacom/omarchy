#!/bin/bash

# omarchy:summary=Install Zed Editor and configure it with the current Omarchy theme

echo "Installing Zed Editor..."
if [[ $(uname -m) == "x86_64" ]] || pacman -Si zed &>/dev/null; then
  omarchy-pkg-add zed omazed
else
  omarchy-pkg-add omazed || exit 1
  set -o pipefail
  curl -fsSL https://zed.dev/install.sh | sh || exit 1
  if omarchy-cmd-missing zeditor; then
    ln -sfn zed "$HOME/.local/bin/zeditor" || exit 1
  fi
fi

# Apply Omarchy theme to Zed
omazed setup

setsid uwsm-app -- gtk-launch dev.zed.Zed >/dev/null 2>&1 &

#!/bin/bash

# omarchy:summary=Boost or restore the power profile while a game is running
# omarchy:args=<boost|restore>
# omarchy:hidden=true

set -euo pipefail

action="${1:-}"

usage() {
  echo "Usage: omarchy-powerprofiles-game <boost|restore>" >&2
  exit 1
}

(( $# == 1 )) || usage
[[ $action == "boost" || $action == "restore" ]] || usage

state_file="${OMARCHY_GAME_POWER_STATE:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-game-power-active}"
mkdir -p "$(dirname "$state_file")"
exec 9>"${state_file}.lock"
flock 9

if [[ $action == "boost" ]]; then
  : >"$state_file"
  if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) != "b true" ]]; then
    if powerprofilesctl set performance >/dev/null 2>&1; then
      omarchy-shell -q battery refreshPowerProfile >/dev/null 2>&1 || true
    fi
  fi
else
  if [[ -f $state_file ]]; then
    rm -f "$state_file"
    omarchy-powerprofiles-set autodetect >/dev/null 2>&1 || true
  fi
fi

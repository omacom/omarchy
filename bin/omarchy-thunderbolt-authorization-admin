#!/bin/bash -p

# omarchy:summary=Run the retired Thunderbolt startup guard
# omarchy:hidden=true

# This root entrypoint uses installed code and rejects unsafe Bash startup.
if [[ $- != *p* ]]; then exit 126; fi
source /usr/bin/omarchy-security-functions || exit 126
omarchy_security_require_privileged_bash_startup || exit 126
omarchy_security_sanitize_bash_environment "$0" "$@"
set -euo pipefail
(( EUID == 0 )) || exit 126
export PATH=/usr/bin:/bin LC_ALL=C
unset DBUS_SYSTEM_BUS_ADDRESS DBUS_SESSION_BUS_ADDRESS
source /usr/share/omarchy/migrations/retired-device-authorization/thunderbolt-policy.sh
source /usr/share/omarchy/migrations/retired-device-authorization/thunderbolt-setup.sh
[[ $# == 1 && $1 == "guard" ]] || exit 64
tb_guard

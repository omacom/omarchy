#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Read Antigravity CLI quotas and local prompt/session history.

agy 1.1.11 introduced read-only /usage JSON output. Let the CLI handle
credentials, refresh and quota requests; older versions must never receive
this prompt because they may send it to a model instead. Transcripts do not
record token counts or model IDs, so those fields are deliberately empty.
"""

import argparse
import fcntl
import hashlib
import json
import math
import os
import re
import shutil
import signal
import sqlite3
import subprocess
import tempfile
import time
from collections import Counter, defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900
CACHE_VERSION = 3
AUTH_HELP = "Run `agy` to check your sign-in, then refresh the panel."


def app_root():
  return Path(os.environ.get("AGY_DIR") or Path.home() / ".gemini/antigravity-cli").expanduser().resolve()


def cache_root():
  return Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "omarchy/agent-usage"


def read_json(path):
  try:
    data = json.loads(path.read_text(encoding="utf-8"))
    return data if isinstance(data, dict) else {}
  except (OSError, ValueError):
    return {}


def write_json(path, payload):
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(payload, handle, separators=(",", ":"), allow_nan=False)
      handle.write("\n")
    os.replace(name, path)
  finally:
    Path(name).unlink(missing_ok=True)


def parse_time(value):
  try:
    if isinstance(value, (int, float)) and not isinstance(value, bool):
      return datetime.fromtimestamp(value / 1000, timezone.utc)
    parsed = datetime.fromisoformat(str(value or "").replace("Z", "+00:00"))
    return parsed if parsed.tzinfo else parsed.replace(tzinfo=timezone.utc)
  except (ValueError, TypeError, OverflowError, OSError):
    return None


def json_lines(path):
  try:
    with path.open(encoding="utf-8", errors="replace") as handle:
      for line in handle:
        try:
          entry = json.loads(line)
          if isinstance(entry, dict):
            yield entry
        except ValueError:
          continue
  except OSError:
    return


def collect_local_stats(root, now):
  today = now.astimezone().date().isoformat()
  days = [(now.astimezone().date() - timedelta(days=i)).isoformat() for i in range(6, -1, -1)]
  history_prompts = Counter()
  transcript_prompts = Counter()
  history_events = defaultdict(list)
  active_dates = set()
  sessions = set()
  today_sessions = set()

  def activity(value, session=None):
    parsed = parse_time(value)
    if parsed is None or parsed > now:
      return None
    day = parsed.astimezone().date().isoformat()
    active_dates.add(day)
    if isinstance(session, str) and session:
      sessions.add(session)
      if day == today:
        today_sessions.add(session)
    return day

  for entry in json_lines(root / "history.jsonl"):
    # History includes slash commands; those are not prompts to an agent.
    display = entry.get("display", entry.get("prompt", ""))
    if isinstance(display, str) and display.lstrip().startswith("/"):
      continue
    day = activity(entry.get("timestamp"), entry.get("conversationId") or entry.get("conversation_id"))
    if day:
      history_prompts[day] += 1
      stamp = parse_time(entry["timestamp"]).timestamp()
      history_events[int(stamp)].append({"time": stamp, "text": display, "matched": False,
                                        "session": entry.get("conversationId") or entry.get("conversation_id")})

  for transcript in (root / "brain").glob("*/.system_generated/logs/transcript.jsonl"):
    session = transcript.parents[2].name
    # An interrupted append can leave repeated steps. Count each dated user
    # input once, without examining or estimating the text's token length.
    seen = set()
    for entry in json_lines(transcript):
      if not isinstance(entry.get("created_at"), str) or not isinstance(entry.get("step_index"), int):
        continue
      key = (entry.get("step_index"), entry.get("created_at"))
      if key in seen:
        continue
      seen.add(key)
      day = activity(entry.get("created_at"), session)
      if day and entry.get("type") == "USER_INPUT":
        stamp = parse_time(entry["created_at"]).timestamp()
        content = entry.get("content")
        candidates = []
        # CLI history timestamps are milliseconds; transcript creation is
        # slightly later and may wrap the prompt in <USER_REQUEST> context.
        # Match one event at a time so distinct prompts from either source
        # survive, including repeated text and partially retained logs.
        for second in range(int(stamp) - 1, int(stamp) + 2):
          for event in history_events.get(second, []):
            text = event["text"]
            if (not event["matched"] and abs(event["time"] - stamp) <= 1
                and (not event["session"] or event["session"] == session)
                and isinstance(text, str) and text.strip() and isinstance(content, str)
                and (content.strip() == text.strip() or (content.startswith("<USER_REQUEST>") and text.strip() in content))):
              candidates.append(event)
        if candidates:
          min(candidates, key=lambda event: abs(event["time"] - stamp))["matched"] = True
        else:
          transcript_prompts[day] += 1

  # Summaries also know about conversations whose transcript is unavailable.
  database = root / "conversation_summaries.db"
  if database.exists():
    try:
      connection = sqlite3.connect(database.as_uri() + "?mode=ro", uri=True)
      try:
        for session, modified in connection.execute("SELECT conversation_id, last_modified_time FROM conversation_summaries"):
          if session:
            sessions.add(session)
            activity(modified, session)
      finally:
        connection.close()
    except sqlite3.Error:
      pass

  prompts = history_prompts + transcript_prompts
  return {
    "todayPrompts": prompts.get(today, 0),
    "todaySessions": len(today_sessions),
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in days],
    "totalPrompts": sum(prompts.values()),
    "totalSessions": len(sessions),
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "modelUsage": {},
  }


def installed_cli():
  path = shutil.which("agy")
  if path:
    executable = Path(path)
    # Omarchy's stock wrapper installs agy on first invocation. A passive
    # usage scan must not install a CLI, including through a mise shim.
    try:
      wrapper = b"mise use" in executable.read_bytes()[:1024] if executable.stat().st_size < 8192 else False
      if executable.resolve().name != "mise" and not wrapper:
        return str(executable)
    except OSError:
      pass
  mise = shutil.which("mise")
  if mise:
    try:
      found = subprocess.run([mise, "which", "agy"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=3)
      executable = Path(found.stdout.strip())
      if found.returncode == 0 and executable.is_file() and os.access(executable, os.X_OK):
        return str(executable)
    except (OSError, subprocess.TimeoutExpired):
      pass
  return ""


def run_cli(cli, *args, timeout=20):
  # A timed-out CLI must not leave descendants holding our output pipes.
  with subprocess.Popen([cli, *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE, text=True, start_new_session=True) as process:
    try:
      stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
      os.killpg(process.pid, signal.SIGKILL)
      process.communicate()
      raise
    return process.returncode, stdout, stderr


def supported_version(value):
  match = re.fullmatch(r"(?:agy\s+|Antigravity CLI\s+)?v?(\d+)\.(\d+)\.(\d+)", value.strip(), re.I)
  return bool(match and tuple(map(int, match.groups())) >= (1, 1, 11))


def extract_limits(data):
  groups = data.get("groups")
  if not isinstance(groups, list):
    return []
  groups = [group for group in groups if isinstance(group, dict)]
  primary = next((group for group in groups if "gemini" in str(group.get("name", "")).lower()), None)
  ordered = ([primary] if primary is not None else []) + [group for group in groups if group is not primary]
  limits = []
  for group in ordered:
    name = str(group.get("name") or "Models")
    scoped = "Claude/GPT" if "claude" in name.lower() else name
    buckets = group.get("buckets")
    if not isinstance(buckets, list):
      continue
    for window, title, label in (("5h", "Session", "Session (5-hour)"), ("weekly", "Weekly", "Weekly (7-day)")):
      for bucket in buckets:
        if not isinstance(bucket, dict) or bucket.get("window") != window:
          continue
        remaining = bucket.get("remaining_fraction")
        if isinstance(remaining, bool) or not isinstance(remaining, (int, float)):
          continue
        if not math.isfinite(remaining) or not 0 <= remaining <= 1:
          continue
        used = round(1 - remaining, 4)
        reset = parse_time(bucket.get("reset_time"))
        limits.append({
          "label": label if group is primary else f"{scoped} {label}",
          "title": title if group is primary else f"{scoped} {title}",
          "percent": used,
          "resetsAt": reset.isoformat() if reset else "",
        })
  return limits


def probe_failure(message):
  # Do not publish raw stderr: it can contain account or credential details.
  message = message.lower()
  status = "Antigravity limits unavailable"
  help_text = "Antigravity could not read quotas. Run `agy` and check `/usage`, then refresh."
  retry = False
  if re.search(r"\b429\b|resource.?exhausted|rate.?limit", message):
    status = "Antigravity limits rate limited"
    help_text = "Antigravity is rate limiting quota checks. Try refreshing later."
  elif re.search(r"\b401\b|\b403\b|unauthenticated|permission.?denied", message):
    status = "Antigravity sign-in required"
    help_text = AUTH_HELP
  elif re.search(r"network|connection|dial tcp|no such host|timed? ?out|timeout|deadline exceeded|unreachable", message):
    help_text = "Could not reach Antigravity. Retrying shortly; local history is still shown."
    retry = True
  elif re.search(r"sign.?in|log.?in|auth|credential", message):
    status = "Antigravity sign-in required"
    help_text = AUTH_HELP
  return {"usageStatusText": status, "authHelpText": help_text, "retryAdvised": retry}


def probe_limits(cli):
  try:
    code, version, _ = run_cli(cli, "--version", timeout=5)
    if code != 0 or not supported_version(version):
      return {"usageStatusText": "Antigravity update required", "authHelpText": "Quota checks require Antigravity CLI 1.1.11 or newer. Update `agy`, then refresh."}
    code, stdout, stderr = run_cli(cli, "-p", "/usage", "--output-format", "json")
    if code != 0:
      return probe_failure(stderr + "\n" + stdout)
    payload = json.loads(stdout)
    command = payload.get("command") if isinstance(payload, dict) else None
    if not isinstance(command, dict) or command.get("name") not in ("usage", "quota") or payload.get("status") != "SUCCESS":
      return probe_failure("invalid quota response")
    data = command.get("data")
    limits = extract_limits(data) if isinstance(data, dict) else []
    if not limits:
      return {"usageStatusText": "Antigravity limits unavailable", "authHelpText": "Antigravity returned no quota windows for this sign-in. Check `/usage` in `agy`."}
    return {"limits": limits, "usageStatusText": "", "authHelpText": ""}
  except subprocess.TimeoutExpired:
    return probe_failure("timeout")
  except (OSError, ValueError):
    return probe_failure("could not read CLI output")


def collect_limits(cli):
  # /usage provides no account identifier. Reusing quotas or errors across
  # calls could attribute a previous sign-in's result to the current account.
  # Always ask the CLI and leave the meters empty when it cannot answer.
  result = {"limits": [], "limitsStale": False, "limitsFetchedAt": 0,
            "usageStatusText": "", "authHelpText": "", "retryAdvised": False}
  if not cli:
    result.update(usageStatusText="Antigravity CLI unavailable", authHelpText="Install Antigravity CLI and run `agy` to sign in.")
  else:
    result.update(probe_limits(cli))
    if result["limits"]:
      result["limitsFetchedAt"] = round(time.time() * 1000)
  return result


def tier_label():
  # /usage does not report a plan. Only show a label the user supplied.
  config_home = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
  value = os.environ.get("AGY_TIER") or read_json(config_home / "omarchy/agents/antigravity.json").get("tier")
  return value.strip() if isinstance(value, str) else ""


def main():
  parser = argparse.ArgumentParser(description=__doc__)
  parser.add_argument("--force", action="store_true", help="Bypass the history cache; quotas are always read fresh")
  parser.add_argument("--limits-only", action="store_true", help="Reuse a recent history scan")
  args = parser.parse_args()
  root = app_root()
  now = datetime.now().astimezone()
  # Isolate custom app roots and invalidate the old estimated-token cache.
  key = hashlib.sha256(str(root).encode()).hexdigest()[:16]
  prefix = cache_root() / f"antigravity-v{CACHE_VERSION}-{key}"
  prefix.parent.mkdir(parents=True, exist_ok=True)
  with prefix.with_suffix(".lock").open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    stats_path = prefix.with_suffix(".stats.json")
    cached = read_json(stats_path)
    age = LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS
    fetched = cached.get("fetchedAt", 0)
    stats = cached.get("stats")
    if (args.force or not isinstance(stats, dict)
        or not all(isinstance(stats.get(key), int) for key in ("totalPrompts", "totalSessions", "todayPrompts", "todaySessions"))
        or cached.get("scanDate") != now.date().isoformat()
        or not isinstance(fetched, (int, float)) or not 0 <= time.time() - fetched < age):
      stats = collect_local_stats(root, now)
      write_json(stats_path, {"scanDate": now.date().isoformat(), "fetchedAt": time.time(), "stats": stats})
    limits = collect_limits(installed_cli())
  has_stats = stats["totalPrompts"] > 0 or stats["totalSessions"] > 0
  record = {"schemaVersion": 1, "id": "antigravity", "name": "Antigravity",
            "updatedAt": datetime.now(timezone.utc).isoformat(), "ready": has_stats or bool(limits["limits"]),
            "hasLocalStats": has_stats, "tierLabel": tier_label(), **stats, **limits}
  print(json.dumps(record, separators=(",", ":"), allow_nan=False))


if __name__ == "__main__":
  main()

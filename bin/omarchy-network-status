#!/bin/bash

# omarchy:summary=Print active network status for the shell
# omarchy:group=network
# omarchy:args=[--verbose] [--no-ping]

verbose=false
no_ping=false
internet_probe=1.1.1.1

for arg in "$@"; do
  case "$arg" in
    --verbose)
      verbose=true
      ;;
    --no-ping)
      no_ping=true
      ;;
    *)
      echo "Usage: omarchy-network-status [--verbose] [--no-ping]" >&2
      exit 2
      ;;
  esac
done

# Prefer the main-table default route for the uplink description. Policy routes
# (Clash/Meta TUN, custom tables) can win `ip route get` while the physical
# uplink still lives in table main (#13525).
uplink_device() {
  local dev
  dev=$(ip -j route show table main default 2>/dev/null |
    jq -r 'sort_by(.metric // 0) | .[0].dev // empty' 2>/dev/null)
  if [[ -n $dev ]]; then
    printf '%s\n' "$dev"
    return 0
  fi

  ip route get "$internet_probe" 2>/dev/null |
    awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
}

# Classify the uplink iface. TUN/WireGuard/etc. are not Ethernet just because
# they lack a wireless sysfs node.
iface_type() {
  local iface=$1
  local link_type sys_type

  if [[ -d /sys/class/net/$iface/wireless ]]; then
    printf 'wifi\n'
    return
  fi

  link_type=$(ip -j link show "$iface" 2>/dev/null | jq -r '.[0].link_type // empty' 2>/dev/null)
  sys_type=$([[ -r /sys/class/net/$iface/type ]] && cat "/sys/class/net/$iface/type")

  # ARPHRD_NONE (65534) covers Clash Meta TUN and many other tunnel devices.
  case $link_type in
    none | tun | tap | wireguard | void)
      printf 'vpn\n'
      return
      ;;
  esac
  if [[ -e /sys/class/net/$iface/tun_flags || $sys_type == "65534" || $sys_type == "778" ]]; then
    # 778 = ARPHRD_WIREGUARD
    printf 'vpn\n'
    return
  fi

  printf 'ethernet\n'
}

print_status() {
  local device nm state ssid signal freq type

  device=$(uplink_device)

  if [[ -z $device ]]; then
    printf 'disconnected\t\t\t\n'
    return
  fi

  type=$(iface_type "$device")

  if [[ $type == "wifi" ]]; then
    nm=$(nmcli -t -f GENERAL.STATE,GENERAL.CONNECTION dev show "$device" 2>/dev/null)
    state=$(awk -F: '$1 == "GENERAL.STATE" { print $2; exit }' <<<"$nm")
    ssid=$(awk -F: '$1 == "GENERAL.CONNECTION" { print $2; exit }' <<<"$nm")
    signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi list ifname "$device" --rescan no 2>/dev/null | awk -F: '$1 == "*" { print $2; exit }')
    freq=$(iw dev "$device" link 2>/dev/null | awk '/freq:/ { print $2; exit }')

    if [[ $state != 100* ]]; then
      printf 'disconnected\t\t\t\n'
      return
    fi

    printf 'wifi\t%s\t%s\t%s\n' "${ssid:-$device}" "$signal" "$freq"
    return
  fi

  if [[ $type == "vpn" ]]; then
    printf 'vpn\t%s\t\t\n' "$device"
    return
  fi

  printf 'ethernet\t%s\t\t\n' "$device"
}

ping_latency_ms() {
  local host=$1

  LC_ALL=C ping -n -c 1 -W 1 "$host" 2>/dev/null | awk -F'time[=<]' '/time[=<]/ { split($2, parts, " "); print parts[1]; exit }'
}

print_ping_samples() {
  local gateway=$1
  local tmpdir router_file internet_file
  local router_pid="" internet_pid=""

  omarchy-cmd-present ping || return
  tmpdir=$(mktemp -d) || return
  router_file="$tmpdir/router"
  internet_file="$tmpdir/internet"

  if [[ -n $gateway ]]; then
    ping_latency_ms "$gateway" >"$router_file" &
    router_pid=$!
  fi

  ping_latency_ms "$internet_probe" >"$internet_file" &
  internet_pid=$!

  if [[ -n $router_pid ]]; then
    wait "$router_pid"
    printf 'router_ping_ms\t%s\n' "$(cat "$router_file")"
  fi

  wait "$internet_pid"
  printf 'internet_ping_ms\t%s\n' "$(cat "$internet_file")"
  rm -rf "$tmpdir"
}

print_verbose() {
  local iface gw src prefix link type
  local routed_json routed_gw default_json address_json

  # Physical/main uplink for the panel description.
  iface=$(uplink_device)
  [[ -z $iface ]] && return

  type=$(iface_type "$iface")

  # Prefer the selected main route's source, then a matching route-get source.
  default_json=$(ip -j route show table main default 2>/dev/null |
    jq -c --arg d "$iface" 'map(select(.dev == $d)) | sort_by(.metric // 0) | .[0] // {}' 2>/dev/null)
  routed_json=$(ip -j route get "$internet_probe" 2>/dev/null)
  address_json=$(ip -j addr show "$iface" 2>/dev/null)
  src=$(jq -r '.prefsrc // empty' <<<"$default_json" 2>/dev/null)
  if [[ -z $src ]]; then
    src=$(jq -r --arg d "$iface" '.[0] | select(.dev == $d) | .prefsrc // empty' <<<"$routed_json" 2>/dev/null)
  fi
  if [[ -z $src ]]; then
    src=$(jq -r '[.[0].addr_info[]? | select(.family == "inet")][0].local // empty' <<<"$address_json" 2>/dev/null)
  fi
  prefix=$(jq -r --arg src "$src" '[.[0].addr_info[]? | select(.family == "inet" and .local == $src)][0].prefixlen // ""' <<<"$address_json" 2>/dev/null)
  gw=$(jq -r '.gateway // empty' <<<"$default_json" 2>/dev/null)

  printf 'iface\t%s\n' "$iface"
  printf 'ip\t%s\n' "$src"
  printf 'prefix\t%s\n' "$prefix"
  printf 'gateway\t%s\n' "$gw"

  if [[ -r /sys/class/net/$iface/statistics/rx_bytes ]]; then
    printf 'rx_bytes\t%s\n' "$(cat /sys/class/net/$iface/statistics/rx_bytes)"
  fi
  if [[ -r /sys/class/net/$iface/statistics/tx_bytes ]]; then
    printf 'tx_bytes\t%s\n' "$(cat /sys/class/net/$iface/statistics/tx_bytes)"
  fi

  printf 'type\t%s\n' "$type"

  if [[ $type == "wifi" ]]; then
    if omarchy-cmd-present iw; then
      link=$(iw dev "$iface" link 2>/dev/null)

      if [[ -n $link ]]; then
        printf 'ssid\t%s\n' "$(awk '/SSID:/ { sub(/.*SSID: /, ""); print; exit }' <<<"$link")"
        printf 'signal_dbm\t%s\n' "$(awk '/signal:/ { print $2; exit }' <<<"$link")"
        printf 'freq\t%s\n' "$(awk '/freq:/ { print $2; exit }' <<<"$link")"
        printf 'bitrate\t%s %s\n' "$(awk '/tx bitrate:/ { print $3; exit }' <<<"$link")" "$(awk '/tx bitrate:/ { print $4; exit }' <<<"$link")"
      fi
    fi
  elif [[ $type == "ethernet" ]]; then
    [[ -r /sys/class/net/$iface/speed ]] && printf 'speed\t%s\n' "$(cat /sys/class/net/$iface/speed)"
    [[ -r /sys/class/net/$iface/duplex ]] && printf 'duplex\t%s\n' "$(cat /sys/class/net/$iface/duplex)"
  fi

  # Internet ping still follows the actually routed path (may be TUN).
  routed_gw=$(jq -r '.[0].gateway // ""' <<<"$routed_json" 2>/dev/null)
  [[ -n $routed_gw ]] || routed_gw=$gw
  if [[ $no_ping == "false" ]]; then
    print_ping_samples "$routed_gw"
  fi
}

if [[ $verbose == "true" ]]; then
  print_verbose
else
  print_status
fi

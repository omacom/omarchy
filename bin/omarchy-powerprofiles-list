#!/bin/bash

# omarchy:summary=Returns a list of all the available power profiles on the system.
# omarchy:args=[--active-state]

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: omarchy-powerprofiles-list [--active-state]" >&2
  exit 1
fi

# Read the daemon over D-Bus: powerprofilesctl is a PyGObject script that can
# crash at interpreter shutdown (python/cpython#124619).
active=$(busctl --system --json=short get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles ActiveProfile 2>/dev/null | jq -r '.data // empty')
busctl --system --json=short get-property net.hadess.PowerProfiles /net/hadess/PowerProfiles net.hadess.PowerProfiles Profiles 2>/dev/null |
  jq -r '.data[] | .Profile.data' |
  awk -v active="$active" -v with_state="${1:+1}" '{ print $0 (with_state ? "\t" ($0 == active ? 1 : 0) : "") }'

#!/bin/bash

# omarchy:summary=Install the Nextcloud desktop sync client and start it with the session.
# omarchy:requires-sudo=true

set -e

HYPR_AUTOSTART_FILE="$HOME/.config/hypr/autostart.lua"
HYPR_AUTOSTART_ENTRY='o.launch_on_start("nextcloud --background")'

enable_hyprland_autostart() {
  mkdir -p "$(dirname "$HYPR_AUTOSTART_FILE")"
  touch "$HYPR_AUTOSTART_FILE"

  if grep -Fxq "$HYPR_AUTOSTART_ENTRY" "$HYPR_AUTOSTART_FILE"; then
    return
  fi

  # Only add the separating newline when the file does not already end in one,
  # so removing the entry again leaves the file exactly as it was found.
  if [[ -s $HYPR_AUTOSTART_FILE && -n $(tail -c1 "$HYPR_AUTOSTART_FILE") ]]; then
    printf '\n' >>"$HYPR_AUTOSTART_FILE"
  fi

  printf '%s\n' "$HYPR_AUTOSTART_ENTRY" >>"$HYPR_AUTOSTART_FILE"
}

echo "Installing Nextcloud..."
omarchy-pkg-add nextcloud-client

echo "Enabling Nextcloud autostart..."
enable_hyprland_autostart

echo "Opening Nextcloud..."
setsid uwsm-app -- /usr/bin/nextcloud >/dev/null 2>&1 &

echo ""
echo "Nextcloud has been installed. Connect it to your server, then find its icon behind  hover tray in top right."

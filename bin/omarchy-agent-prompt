#!/bin/bash

# omarchy:summary=Launch the default coding agent with a prompt
# omarchy:args=[--inline] [--pick] [--local] [--local-model <recipe>] [--prefer-local] [--agent <id>] <prompt...>
# omarchy:examples=omarchy agent prompt "Review this project" | omarchy agent prompt --agent codex "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

flags=()
while (($#)); do
  case "$1" in
    --inline|--pick|--local|--prefer-local)
      flags+=("$1")
      shift
      ;;
    --local-model)
      flags+=(--local-model "${2:?--local-model needs a recipe id}")
      shift 2
      ;;
    --agent)
      flags+=(--agent "${2:?--agent needs an agent id}")
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z $* ]]; then
  echo "Usage: omarchy agent prompt [--inline] [--pick] [--local] [--local-model <recipe>] [--prefer-local] [--agent <id>] <prompt...>" >&2
  exit 1
fi

exec omarchy-agent "${flags[@]}" --prompt "$*"

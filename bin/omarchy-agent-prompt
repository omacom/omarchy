#!/bin/bash

# omarchy:summary=Launch the default coding agent with a prompt
# omarchy:args=[--inline] [--persist | --session <name>] <prompt...>
# omarchy:examples=omarchy agent prompt "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

launch_args=()
while (( $# > 0 )); do
  case $1 in
    --inline | --persist) launch_args+=("$1"); shift ;;
    --session)
      (( $# >= 2 )) || { echo "--session requires a name" >&2; exit 2; }
      launch_args+=("$1" "$2"); shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if (($# == 0)); then
  echo "Usage: omarchy agent prompt [--inline] [--persist | --session <name>] <prompt...>" >&2
  exit 1
fi

exec omarchy-agent "${launch_args[@]}" --prompt "$*"

#!/bin/bash

# omarchy:summary=Launch the default coding agent with a prompt
# omarchy:args=[--inline] [--fallback] <prompt...>
# omarchy:examples=omarchy agent prompt "Review this project" | omarchy agent prompt --fallback "Review this project"

# Prompts live here rather than on `omarchy agent`, where a bare prompt would
# shadow the subcommands under that group.

set -euo pipefail

flags=()
while (($#)); do
  case "$1" in
    --inline | --fallback)
      flags+=("$1")
      shift
      ;;
    *)
      break
      ;;
  esac
done

if (($# == 0)); then
  echo "Usage: omarchy agent prompt [--inline] [--fallback] <prompt...>" >&2
  exit 1
fi

exec omarchy-agent "${flags[@]}" --prompt "$*"

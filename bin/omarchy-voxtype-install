#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

# Install voxtype and configure it for use.

if gum confirm "Install Voxtype + AI models (up to 1.7GB) to enable dictation?"; then
  omarchy-pkg-add wtype wl-clipboard voxtype-bin

  # Setup voxtype
  mkdir -p ~/.config/voxtype
  fresh_config=0
  if [[ ! -f ~/.config/voxtype/config.toml ]]; then
    cp "$OMARCHY_PATH/default/voxtype/config.toml" ~/.config/voxtype/
    touch ~/.config/voxtype/omarchy-osd
    fresh_config=1
  fi

  voxtype setup --download --no-post-install
  if (( fresh_config )) && omarchy-hw-vulkan; then
    voxtype setup gpu --enable || true
    if omarchy-pkg-add voxtype-cohere-vulkan; then
      omarchy-voxtype-cohere enable || echo "Using local Whisper; Cohere Vulkan was not available."
    fi
  fi
  voxtype setup systemd

  hyprctl reload >/dev/null
  omarchy-restart-shell
  omarchy-notification-send -g  "Voxtype Dictation Ready" "Hold F9 to dictate (or toggle with Super + Ctrl + X)." -t 10000
fi

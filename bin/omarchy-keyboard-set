#!/bin/bash

# omarchy:summary=Configure the active keyboard layout for the system and desktop
# omarchy:group=keyboard
# omarchy:name=set
# omarchy:args=<layout> [variant]
# omarchy:desc=Set the console and Hyprland keyboard layout (e.g. br abnt2, us intl)

set -e

layout="$1"
variant="${2:-}"

if [[ -z $layout ]]; then
  echo "Usage: omarchy keyboard set <layout> [variant]" >&2
  echo "Example: omarchy keyboard set br abnt2" >&2
  echo "Example: omarchy keyboard set us intl" >&2
  exit 1
fi

# Apply immediately to Hyprland seat using supported hl.config Lua evaluation
apply_hyprland() {
  local target_layout="$layout"
  local target_variant="${variant:-}"

  # Non-Latin layouts list from default/hypr/input.lua and omarchy_hooks.conf.
  # Hyprland resolves keybindings against the first entry in kb_layout, so
  # non-Latin layouts must be prefixed with "us," and provide an alt-toggle option.
  local non_latin_layouts=" af am ara bd bg by et ge gr il in iq ir kg kh kz la lk mk mm mn mv np rs ru sy th tj ua "
  local primary="${layout%%,*}"

  local lua_cmd
  if [[ $non_latin_layouts == *" $primary "* ]]; then
    target_layout="us,$target_layout"
    target_variant=",$target_variant"

    # Read live kb_options from Hyprland and preserve custom options without overwriting them
    local current_options=""
    if command -v hyprctl >/dev/null 2>&1; then
      current_options=$(hyprctl -j getoption input:kb_options 2>/dev/null | grep -Po '(?<="str": ")[^"]*' || true)
    fi
    local target_options="${current_options:-compose:caps,shift:both_capslock_cancel}"
    if [[ $target_options != *"grp:alts_toggle"* ]]; then
      target_options="${target_options:+$target_options,}grp:alts_toggle"
    fi
    lua_cmd="hl.config({ input = { kb_layout = \"$target_layout\", kb_variant = \"$target_variant\", kb_options = \"$target_options\" } })"
  else
    # For Latin layouts, do NOT touch or pass kb_options at all — preserve all user custom options intact
    lua_cmd="hl.config({ input = { kb_layout = \"$target_layout\", kb_variant = \"$target_variant\" } })"
  fi

  if command -v hyprctl >/dev/null 2>&1; then
    if ! hyprctl eval "$lua_cmd" >/dev/null 2>&1; then
      echo "Warning: hyprctl eval failed to apply keyboard layout immediately" >&2
    fi
  fi
}

apply_hyprland

# Persist to /etc/vconsole.conf if writable or via sudo
persist_vconsole() {
  local target="/etc/vconsole.conf"
  local temp_file
  temp_file=$(mktemp)

  if [[ -f $target ]]; then
    grep -v -E '^(KEYMAP|XKBLAYOUT|XKBVARIANT)=' "$target" > "$temp_file" || true
  fi

  # Map common XKB to console keymap
  local console_keymap="$layout"
  if [[ $layout == "br" ]]; then
    console_keymap="br-abnt2"
  fi

  {
    echo "KEYMAP=$console_keymap"
    echo "XKBLAYOUT=$layout"
    [[ -n $variant ]] && echo "XKBVARIANT=$variant"
  } >> "$temp_file"

  local status=0
  if [[ -w $target ]]; then
    cat "$temp_file" > "$target" || status=$?
  else
    if [[ -t 0 ]]; then
      sudo cp "$temp_file" "$target" || status=$?
    else
      pkexec cp "$temp_file" "$target" || status=$?
    fi
  fi
  rm -f "$temp_file"
  return $status
}

if ! persist_vconsole; then
  echo "Error: Failed to persist keyboard configuration to /etc/vconsole.conf" >&2
  exit 1
fi

# Notify user and refresh shell indicators
if [[ -n $variant ]]; then
  omarchy-notification-send -g  "Keyboard layout set to $layout ($variant)"
else
  omarchy-notification-send -g  "Keyboard layout set to $layout"
fi

#!/bin/bash

# omarchy:summary=Read or change Lenovo battery conservation mode
# omarchy:args=[status|on|off]

set -euo pipefail

action=${1:-status}
if (( $# > 1 )) || [[ $action != "status" && $action != "on" && $action != "off" ]]; then
  echo "Usage: omarchy-battery-conservation [status|on|off]" >&2
  exit 2
fi

control=""
state="unsupported"
on_value=1
off_value=0

# Newer ideapad_laptop kernels expose conservation through the battery's
# charge_types. The extension identifies Lenovo's implementation, not just
# a brand name or a battery that happens to offer another long-life mode.
for battery in /sys/class/power_supply/*; do
  [[ -e $battery/extensions/ideapad_laptop && -r $battery/charge_types ]] || continue
  modes=$(cat "$battery/charge_types" 2>/dev/null) || continue
  [[ $modes == *"Long_Life"* && $modes == *"Standard"* ]] || continue
  case $modes in
    *"[Long_Life]"*) state=on ;;
    *"[Standard]"* | *"[Fast]"*) state=off ;;
    *) continue ;;
  esac
  control="$battery/charge_types"
  on_value=Long_Life
  off_value=Standard
  break
done

# Older kernels use this Lenovo-specific interface. Discover the device;
# VPC2004:00 is common but is not part of the interface's contract.
if [[ -z $control ]]; then
  for candidate in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode; do
    [[ -r $candidate ]] || continue
    value=$(cat "$candidate" 2>/dev/null) || continue
    case $value in
      1) state=on ;;
      0) state=off ;;
      *) continue ;;
    esac
    control=$candidate
    break
  done
fi

if [[ $action == "status" ]]; then
  echo "$state"
elif [[ -z $control ]]; then
  echo "Lenovo battery conservation mode is unavailable." >&2
  exit 1
elif [[ $action != $state ]]; then
  if [[ $action == "on" ]]; then
    value=$on_value
  else
    value=$off_value
  fi

  # Only tee is elevated, with a kernel-owned path discovered above and a
  # fixed value. No privileged helper, writable script, or sudoers rule.
  if [[ -t 0 && -t 2 ]]; then
    printf '%s\n' "$value" | sudo /usr/bin/tee "$control" >/dev/null
  else
    printf '%s\n' "$value" | pkexec /usr/bin/tee "$control" >/dev/null
  fi

  actual=$(cat "$control")
  if [[ $control == */charge_types ]]; then
    [[ $actual == *"[$value]"* ]] || exit 1
  else
    [[ $actual == "$value" ]] || exit 1
  fi
fi

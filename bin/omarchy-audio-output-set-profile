#!/bin/bash

# omarchy:summary=Activate an audio card output profile and make its sink default
# omarchy:args=<card-name> <profile-name>
# omarchy:hidden=true

set -euo pipefail

card_name=${1:-}
profile_name=${2:-}

if [[ -z $card_name || -z $profile_name ]]; then
  echo "Usage: omarchy-audio-output-set-profile <card-name> <profile-name>" >&2
  exit 1
fi

cards=$(LC_ALL=C timeout 2 pactl -f json list cards 2>/dev/null)
if ! jq -e --arg card "$card_name" --arg profile "$profile_name" '
  any(.[];
    .name == $card
    and (.profiles[$profile].sinks // 0) > 0
    and (.profiles[$profile].available // true) != false
    and ($profile | startswith("output:")))
' <<<"$cards" >/dev/null; then
  echo "Audio output profile is unavailable: $card_name $profile_name" >&2
  exit 1
fi

timeout 2 pactl set-card-profile "$card_name" "$profile_name"

# The sink is named after the output mapping alone, so a duplex profile such as
# output:hdmi-stereo+input:analog-stereo creates the hdmi-stereo sink.
output_mapping=${profile_name#output:}
output_mapping=${output_mapping%%+*}
for _ in {1..20}; do
  sinks=$(LC_ALL=C timeout 2 pactl -f json list sinks 2>/dev/null)
  sink=$(jq -c --arg card "$card_name" --arg profile "$output_mapping" '
    first(.[]
      | select(.properties["device.name"] == $card)
      | select(.properties["device.profile.name"] == $profile)) // empty
  ' <<<"$sinks")
  if [[ -n $sink ]]; then
    # Same rule as the output switcher: the physical sink an active speaker tuning
    # fronts must not become the default, or playback skips the tuning. Hand the
    # profile's output to the tuning sink instead.
    fronted=$(omarchy-audio-tuning fronted-sink 2>/dev/null || true)
    if [[ -n $fronted && $(jq -r '.name' <<<"$sink") == "$fronted" ]]; then
      tuning=$(omarchy-audio-tuning sink 2>/dev/null || true)
      tuning_sink=$(jq -c --arg name "$tuning" 'first(.[] | select(.name == $name)) // empty' <<<"$sinks")
      if [[ -n $tuning_sink ]]; then
        sink=$tuning_sink
      fi
    fi
    omarchy-audio-output-set-default "$(jq -r '.index' <<<"$sink")" "$(jq -r '.name' <<<"$sink")"
    exit 0
  fi
  sleep 0.1
done

echo "Audio sink did not appear for profile: $card_name $profile_name" >&2
exit 1

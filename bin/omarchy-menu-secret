#!/bin/bash

# omarchy:summary=Prompt for a secret without showing what you type
# omarchy:group=menu
# omarchy:name=secret
# omarchy:args=<prompt> [--width <px>]
# omarchy:examples=omarchy menu secret "GitHub token"|omarchy menu secret Passphrase --width 400

# Like `omarchy menu input`, but the value is painted as dots as you type and
# Tab reveals it deliberately. Use it whenever the answer is a token, passphrase
# or anything else that should not be readable over a shoulder or in a capture.

set -euo pipefail

prompt="${1:-Secret}"
if (( $# > 0 )); then
  shift
fi

menu_width=""

while (( $# > 0 )); do
  case "$1" in
    --width)
      shift
      if (( $# == 0 )); then
        echo "omarchy-menu-secret: --width requires a value" >&2
        exit 1
      fi
      menu_width="$1"
      ;;
  esac
  shift
done

selection_file=$(mktemp)
done_file=$(mktemp)
rm -f "$done_file"
trap 'rm -f "$selection_file" "$done_file"' EXIT

payload=$(perl -MEncode=decode -MJSON::PP=encode_json -e '
  my $payload = {
    mode => "secret",
    prompt => decode("UTF-8", $ARGV[0]),
    selectionFile => decode("UTF-8", $ARGV[1]),
    doneFile => decode("UTF-8", $ARGV[2])
  };
  $payload->{width} = int($ARGV[3]) if length($ARGV[3] // "");
  print encode_json($payload)
' "$prompt" "$selection_file" "$done_file" "$menu_width")

omarchy-shell shell summon omarchy.menu "$payload" >/dev/null

while [[ ! -e $done_file ]]; do
  sleep 0.05
done

if [[ -s $selection_file ]]; then
  cat "$selection_file"
else
  exit 1
fi

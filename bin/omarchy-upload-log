#!/bin/bash -p

# omarchy:summary=Upload logs to logs.omarchy.org
# omarchy:args=<log-file>
# omarchy:hidden=true

if [[ $- != *p* ]]; then
  echo "Refusing an unsafe Bash startup." >&2
  exit 126
fi

security_entrypoint=$(/usr/bin/readlink -e -- "${BASH_SOURCE[0]}") || exit 126
source "${security_entrypoint%/*}/omarchy-security-functions" || exit 126
omarchy_security_require_privileged_bash_startup || exit 126
set -euo pipefail
omarchy_security_sanitize_bash_environment "$0" "$@" || exit 126

LOG_TYPE="${1:-install}"

# The privileged reader is dispatched only as one fixed installed command with
# no user-selected path. sudo does not need to preserve the caller's checkout
# environment for it; every ordinary uploader invocation remains bound to its
# canonical OMARCHY_PATH before extensible collectors can run.
if [[ $LOG_TYPE != __read-private-install-logs ]]; then
  omarchy_security_require_source_root "$0" || exit 126
fi

read_private_install_log() {
  local selector=${1:-} path parent current canonical owner mode first=1
  ((EUID == 0)) || {
    echo "The private install-log reader must run through sudo." >&2
    return 1
  }

  case "$selector" in
  live) path=/var/log/omarchy-install.log ;;
  target) path=/mnt/var/log/omarchy-install.log ;;
  *)
    echo "Unknown private install-log selector." >&2
    return 2
    ;;
  esac

  [[ -e $path || -L $path ]] || return 3
  if [[ -L $path || ! -f $path ]]; then
    echo "Refusing to read an unsafe Omarchy install log." >&2
    return 4
  fi
  canonical=$(/usr/bin/realpath -e -- "$path" 2>/dev/null) || return 4
  owner=$(/usr/bin/stat -c '%u' -- "$path" 2>/dev/null) || return 4
  mode=$(/usr/bin/stat -c '%a' -- "$path" 2>/dev/null) || return 4
  if [[ $canonical != "$path" || $owner != 0 || $mode != 600 ]]; then
    echo "Refusing to read an install log without root ownership and mode 0600." >&2
    return 4
  fi

  parent=$(/usr/bin/dirname -- "$path") || return 4
  canonical=$(/usr/bin/realpath -e -- "$parent" 2>/dev/null) || return 4
  [[ $canonical == "$parent" ]] || return 4
  current=$parent
  while :; do
    [[ -d $current && ! -L $current ]] || return 4
    owner=$(/usr/bin/stat -c '%u' -- "$current" 2>/dev/null) || return 4
    mode=$(/usr/bin/stat -c '%a' -- "$current" 2>/dev/null) || return 4
    [[ $owner =~ ^[0-9]+$ && $mode =~ ^[0-7]+$ ]] || return 4
    [[ $owner == 0 ]] || return 4
    if ((first)); then
      ! ((8#$mode & 0022)) || return 4
      first=0
    elif ((8#$mode & 0022)); then
      [[ $owner == 0 ]] && ((8#$mode & 01000)) || return 4
    fi
    [[ $current == / ]] && break
    current=$(/usr/bin/dirname -- "$current") || return 4
  done

  /usr/bin/cat -- "$path"
}

same_or_prefix_log() {
  local a="$1" b="$2" size_a size_b min_size
  [[ -s $a && -s $b ]] || return 1
  cmp -s "$a" "$b" && return 0

  size_a=$(stat -c '%s' "$a" 2>/dev/null) || return 1
  size_b=$(stat -c '%s' "$b" 2>/dev/null) || return 1
  if (( size_a < size_b )); then
    min_size=$size_a
  else
    min_size=$size_b
  fi
  (( min_size > 0 )) || return 1

  cmp -n "$min_size" "$a" "$b" >/dev/null 2>&1
}

read_private_install_logs() {
  local status live_found=0 target_found=0

  # Validate both fixed inputs before emitting either. A later validation
  # error must not turn a partial collection into a successful upload.
  if read_private_install_log live >/dev/null; then
    live_found=1
  else
    status=$?
    ((status == 3)) || return 1
  fi
  if read_private_install_log target >/dev/null; then
    target_found=1
  else
    status=$?
    ((status == 3)) || return 1
  fi
  ((live_found || target_found)) || return 3

  if ((live_found)); then
    printf '\n========================================\nOMARCHY INSTALL LOG (/var/log/omarchy-install.log)\n========================================\n\n'
    read_private_install_log live || return 1
  fi
  if ((target_found)) &&
    { ((!live_found)) || ! same_or_prefix_log /var/log/omarchy-install.log /mnt/var/log/omarchy-install.log; }; then
    printf '\n========================================\nTARGET OMARCHY INSTALL LOG (/mnt/var/log/omarchy-install.log)\n========================================\n\n'
    read_private_install_log target || return 1
  fi
}

if [[ $LOG_TYPE == __read-private-install-logs ]]; then
  (($# == 1)) || exit 2
  read_private_install_logs
  exit
fi

PRIVATE_LOG_AUTHORIZATION=false

prepare_private_log_authorization() {
  [[ $LOG_TYPE == install ]] || return 0
  ((EUID != 0)) || return 0
  omarchy_security_sudo_supports_no_update || {
    echo "This sudo does not support --no-update; refusing to collect private install logs." >&2
    return 1
  }
  # Collectors such as fastfetch are intentionally extensible user commands.
  # Start them with no reusable authorization, then authorize only the fixed
  # private-log reader without publishing a timestamp they can wait for.
  omarchy_security_revoke_sudo_timestamp || {
    echo "Could not invalidate cached sudo authorization." >&2
    return 1
  }
  PRIVATE_LOG_AUTHORIZATION=true
}

prepare_private_log_authorization

ORIGINAL_UMASK=$(umask)
umask 077
WORK_DIR=$(mktemp -d) || {
  echo "Could not create a private support-log workspace." >&2
  exit 1
}
cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  /usr/bin/rm -rf -- "$WORK_DIR"
  umask "$ORIGINAL_UMASK"
  if [[ $PRIVATE_LOG_AUTHORIZATION == true ]]; then
    omarchy_security_exit_with_revoked_sudo "$status"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

TEMP_LOG="$WORK_DIR/upload-log.txt"
SYSTEM_INFO="$WORK_DIR/system-info.txt"

# Get system information if fastfetch is available
if omarchy-cmd-present fastfetch; then
  {
    echo "========================================="
    echo "SYSTEM INFORMATION"
    echo "========================================="
    # Use fastfetch with no logo to get clean output
    fastfetch --logo none --pipe 2>/dev/null || echo "Failed to get system info"
    echo ""
    echo "========================================="
    echo "LOG CONTENT"
    echo "========================================="
    echo ""
  } >"$SYSTEM_INFO"
else
  # Fallback to basic info if fastfetch isn't available
  {
    echo "========================================="
    echo "SYSTEM INFORMATION"
    echo "========================================="
    echo "Hostname: $(uname -n)"
    echo "Kernel: $(uname -r)"
    echo "Date: $(date)"
    echo ""
    echo "========================================="
    echo "LOG CONTENT"
    echo "========================================="
    echo ""
  } >"$SYSTEM_INFO"
fi

collect_private_install_logs() {
  local destination="$1" status
  if ((EUID == 0)); then
    if read_private_install_logs >"$destination"; then
      return 0
    else
      status=$?
    fi
  elif /usr/bin/sudo -N -- /usr/bin/omarchy-upload-log __read-private-install-logs >"$destination"; then
    return 0
  else
    status=$?
  fi
  /usr/bin/rm -f -- "$destination"
  ((status == 3)) && return 3
  echo "Could not safely read the private Omarchy install logs." >&2
  return 1
}

case "$LOG_TYPE" in
install)
  # In the live ISO before reboot, the target system is mounted at /mnt so the
  # omarchy install log lives at /mnt/var/log/omarchy-install.log. On the
  # installed system it's at /var/log/omarchy-install.log. Prefer whichever
  # exists, with /mnt taking precedence (only present in the ISO context, and
  # there it's the right one).
  ARCHINSTALL_LOG="/var/log/archinstall/install.log"
  LIVE_OMARCHY_LOG="/var/log/omarchy-install.log"
  TARGET_OMARCHY_LOG="/mnt/var/log/omarchy-install.log"
  PRIVATE_OMARCHY_COPY="$WORK_DIR/omarchy-install-logs.txt"
  private_logs_found=0

  cat "$SYSTEM_INFO" >"$TEMP_LOG"
  if [[ -s $ARCHINSTALL_LOG ]]; then
    printf '\n========================================\nARCHINSTALL SUBSYSTEM LOG (%s)\n========================================\n\n' "$ARCHINSTALL_LOG" >>"$TEMP_LOG"
    cat "$ARCHINSTALL_LOG" >>"$TEMP_LOG"
  fi

  if collect_private_install_logs "$PRIVATE_OMARCHY_COPY"; then
    private_logs_found=1
  else
    status=$?
    ((status == 3)) || exit 1
  fi
  if ((private_logs_found)) && [[ -s $PRIVATE_OMARCHY_COPY ]]; then
    cat "$PRIVATE_OMARCHY_COPY" >>"$TEMP_LOG"
  fi

  if ((!private_logs_found)); then
    echo "Warning: omarchy install log not found (looked at /var/log and /mnt/var/log)" >&2
  fi

  if [[ ! -s $TEMP_LOG ]]; then
    echo "Error: No install logs found"
    exit 1
  fi

  echo "Uploading installation log to logs.omarchy.org..."
  ;;

this-boot)
  # Combine system info with boot logs
  cat "$SYSTEM_INFO" >"$TEMP_LOG"
  journalctl -b 0 >>"$TEMP_LOG" 2>/dev/null

  if [[ ! -s $TEMP_LOG ]]; then
    echo "Error: No logs found for current boot"
    exit 1
  fi

  echo "Uploading current boot logs to logs.omarchy.org..."
  ;;

last-boot)
  # Combine system info with previous boot logs
  cat "$SYSTEM_INFO" >"$TEMP_LOG"
  journalctl -b -1 >>"$TEMP_LOG" 2>/dev/null

  if [[ ! -s $TEMP_LOG ]]; then
    echo "Error: No logs found for previous boot"
    exit 1
  fi

  echo "Uploading previous boot logs to logs.omarchy.org..."
  ;;

installed|system-info)
  # System info plus all installed packages
  cat "$SYSTEM_INFO" >"$TEMP_LOG"
  {
    echo ""
    echo "========================================="
    echo "INSTALLED PACKAGES (pacman -Q)"
    echo "========================================="
    pacman -Q 2>/dev/null || echo "Failed to get package list"
  } >>"$TEMP_LOG"

  if [[ ! -s $TEMP_LOG ]]; then
    echo "Error: Failed to gather system information"
    exit 1
  fi

  echo "Uploading system information to logs.omarchy.org..."
  ;;

*)
  echo "Usage: $0 [install|this-boot|last-boot|installed|system-info]"
  echo "  install      - Upload installation logs (default)"
  echo "  this-boot    - Upload logs from current boot"
  echo "  last-boot    - Upload logs from previous boot"
  echo "  installed    - Upload system info and installed packages"
  exit 1
  ;;
esac

echo ""

if URL=$(curl -sf -F "file=@$TEMP_LOG" -Fexpires=24 https://logs.omarchy.org/) && [[ -n $URL ]]; then
  echo "✓ Log uploaded successfully!"
  echo "Share this URL:"
  echo ""
  echo "  $URL"
else
  echo "Error: Failed to upload log file"
  exit 1
fi

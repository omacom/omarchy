#!/bin/bash

# omarchy:summary=Silence crash notifications for a program or user service, or list what is silenced
# omarchy:args=[[--] <program> | --unit <service>] [on|off|toggle]
# omarchy:examples=omarchy crash mute | omarchy crash mute hyprland | omarchy crash mute /usr/bin/hyprland | omarchy crash mute hyprland off | omarchy crash mute --unit example.service

# The flags omarchy-crash-watch reads before announcing a crash. Trigger >
# Toggle > Crash Capture is the switch for all of them.

set -uo pipefail

readonly TOGGLES="$HOME/.local/state/omarchy/toggles"
readonly SERVICE_PATTERN='^([a-zA-Z0-9_.:@-]|\\x[0-9a-fA-F]{2})+\.service$'

usage() {
  echo "Usage: omarchy crash mute [[--] <program> | --unit <service>] [on|off|toggle]" >&2
}

# Only regular files, because that is all the watcher honours: anything else in
# there would be reported as muted while the crashes kept arriving. The dotted
# glob is for a program legitimately called .hidden, and `.` and `..` fail the
# same -f test that keeps them out.
list() {
  local entry found=0

  for entry in "$TOGGLES/crash-ignore"/* "$TOGGLES/crash-ignore"/.*; do
    [[ -f $entry ]] || continue
    printf '%s\n' "${entry##*/}"
    found=1
  done
  for entry in "$TOGGLES/crash-ignore-unit"/* "$TOGGLES/crash-ignore-unit"/.*; do
    [[ -f $entry ]] || continue
    printf '%s\n' "--unit ${entry##*/}"
    found=1
  done

  ((found)) || echo "No programs muted. Crashes all notify."
}

if [[ ${1:-} == "--unit" ]]; then
  shift
  target=${1:-}
  if [[ ! $target =~ $SERVICE_PATTERN ]]; then
    echo "Not a user service name: $target" >&2
    usage
    exit 1
  fi
  flag="crash-ignore-unit/$target"
else
  # A program may be named -h or --unit. A leading -- takes it literally.
  [[ ${1:-} == "--" ]] && shift
  if (($# == 0)); then
    list
    exit 0
  fi

  # Match what the watcher uses, whether given a name or a full path.
  target=${1##*/}
  if [[ -z $target || $target == "." || $target == ".." ]]; then
    echo "Not a program name: $1" >&2
    usage
    exit 1
  fi
  flag="crash-ignore/$target"
fi

action=${2:-on}
case "$action" in
  on|off|toggle) ;;
  *)
    echo "Not an action: $action" >&2
    usage
    exit 1
    ;;
esac

omarchy-toggle "$flag" "$action" || exit 1

# Report what is now true rather than what was asked for: the flag is what the
# watcher reads, and a toggle does not say which way it went.
if omarchy-toggle-enabled "$flag"; then
  echo "Muted crash notifications for $target."
else
  echo "Crash notifications for $target are back on."
fi

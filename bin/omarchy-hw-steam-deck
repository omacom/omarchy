#!/bin/bash

# omarchy:summary=Match the Steam Deck (LCD "Jupiter" and OLED "Galileo").

# The product names alone are generic words, so the vendor has to be Valve too.
[[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == "Valve" ]] &&
  { omarchy-hw-match "Jupiter" || omarchy-hw-match "Galileo"; }

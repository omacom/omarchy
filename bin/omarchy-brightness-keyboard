#!/bin/bash

# omarchy:summary=Adjust keyboard backlight brightness using available steps.
# omarchy:args=[--no-osd] <up|down|cycle|off|restore>

no_osd=0
if [[ ${1:-} == "--no-osd" ]]; then
  no_osd=1
  shift
fi

direction="${1:-up}"
leds_path="${OMARCHY_LEDS_PATH:-/sys/class/leds}"

# Find keyboard backlight device (look for *kbd_backlight* pattern in leds class).
device=""
for candidate in "$leds_path"/*kbd_backlight*; do
  if [[ -e $candidate ]]; then
    device="$(basename "$candidate")"
    break
  fi
done

if [[ -z $device ]]; then
  echo "No keyboard backlight device found" >&2
  exit 1
fi

state_file="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR must be set}/omarchy-keyboard-backlight-$device"

# Serialize hardware changes with their saved state, including repeated keys.
exec {lock_fd}>"$state_file.lock" || exit 1
flock "$lock_fd" || exit 1

save_brightness() {
  if printf '%s\n' "$1" >"$state_file.tmp" && mv -T -- "$state_file.tmp" "$state_file"; then
    return 0
  else
    rm -f -- "$state_file.tmp"
    return 1
  fi
}

if [[ $direction == "off" ]]; then
  current_brightness="$(brightnessctl -d "$device" get)" || exit 1

  # Zero could be a hardware timeout or a manual choice. Never infer a new
  # preference from it or send set 0 again, which can disable Dell wake triggers.
  if (( current_brightness > 0 )); then
    # Seed a lit first lock if no manual change has recorded a level yet.
    if [[ ! -f $state_file ]]; then
      save_brightness "$current_brightness" || exit 1
    fi
    brightnessctl -d "$device" set 0 >/dev/null || exit 1
  fi
  exit 0
elif [[ $direction == "restore" ]]; then
  if [[ -f $state_file ]]; then
    read -r saved_brightness <"$state_file" || exit 1
    [[ $saved_brightness =~ ^[0-9]+$ ]] || exit 1
    brightnessctl -d "$device" set "$saved_brightness" >/dev/null || exit 1
  fi
  exit 0
fi

# Get current and max brightness to determine step size.
max_brightness="$(brightnessctl -d "$device" max)" || exit 1
current_brightness="$(brightnessctl -d "$device" get)" || exit 1

# Calculate step as 10% of max brightness. Keyboards with many levels (e.g. 512)
# need larger steps; keyboards with few levels (e.g. 3) fall back to step=1.
step=$(( max_brightness / 10 ))
(( step < 1 )) && step=1

if [[ $direction == "cycle" ]]; then
  new_brightness=$(( current_brightness + step ))
  (( new_brightness > max_brightness )) && new_brightness=0
elif [[ $direction == "up" ]]; then
  new_brightness=$(( current_brightness + step ))
  (( new_brightness > max_brightness )) && new_brightness=$max_brightness
else
  new_brightness=$(( current_brightness - step ))
  (( new_brightness < 0 )) && new_brightness=0
fi

# Record successful manual changes, including an intentional zero, before a
# hardware timeout can make the current reading ambiguous.
brightnessctl -d "$device" set "$new_brightness" >/dev/null || exit 1
save_brightness "$new_brightness" || exit 1
(( no_osd )) || omarchy-osd -i keyboard -p "$(( new_brightness * 100 / max_brightness ))"

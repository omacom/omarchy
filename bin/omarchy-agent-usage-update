#!/bin/bash

# omarchy:summary=Regenerate the AI agent usage data files
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omarchy:examples=omarchy agent usage-update | omarchy agent usage-update claude | omarchy agent usage-update --except codex

# Each omarchy-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/omarchy/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    excluded[$2]=1
    shift
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

# Each limit keeps [ms, percent] samples of its current window, carried over
# from the record it replaces, so the panel can project from the recent burn
# rate rather than the window's average. A sample is stamped with when its
# limits were measured (the record's limitsFetchedAt, an account's fetchedAt),
# so a cached or stale answer adds none. A reset that moved, or another active
# account behind the record's own limits, starts the history over. Samples
# reach back 26 hours (a day of a weekly window, with slack), at least five
# minutes apart except the newest. Only the distance between two resets
# matters, so the offset is dropped before parsing.
LIMIT_HISTORY='
  def epoch: (.[0:19] + "Z" | fromdateiso8601? * 1000) // null;
  def active: [.accounts[]? | objects | select(.active == true) | .id][0];
  def stamp: if type == "number" then . else 0 end;
  def carry($before; $at):
    ([$before[]? | objects] | INDEX(.label)) as $prior
    | map(if type != "object" then . else
        ($prior[.label | tostring] // {}) as $was
        | (.resetsAt // "" | tostring | epoch) as $resets
        | ($was.resetsAt // "" | tostring | epoch) as $resetsBefore
        | (if $resets != null and $resetsBefore != null and ($resets - $resetsBefore | fabs) < 600000
           then [$was.history[]? | arrays | select(.[0] >= $at - 93600000)]
           else [] end) as $kept
        | .history = (if $at > 0 and ($kept | length == 0 or .[-1][0] < $at)
            then (if ($kept | length) >= 2 and $kept[-1][0] - $kept[-2][0] < 300000
              then $kept[:-1] else $kept end) + [[$at, .percent]]
            else $kept end)
      end);
  ($previous[0] | if type == "object" then . else {} end) as $previous
  | (if ($previous | active) == active then $previous.limits else [] end) as $before
  | (.limitsFetchedAt | stamp) as $at
  | (if (.limits | type) == "array" then .limits |= carry($before; $at) else . end)
  | ([$previous.accounts[]? | objects] | INDEX(.id)) as $accounts
  | if (.accounts | type) != "array" then . else
      .accounts |= map(if type == "object" and (.limits | type) == "array"
        then . as $account
          | .limits |= carry($accounts[$account.id | tostring].limits; $account.fetchedAt | stamp)
        else . end)
    end'

collect() {
  local collector="$1" agent="$2"
  local record tmp previous merged
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  # A history that can't be carried costs only the recent rate, never the
  # record. The record it replaces is read from its file, since a record can
  # outgrow what one argument may hold.
  previous=$USAGE_DIR/$agent.json
  [[ -f $previous ]] || previous=/dev/null
  if merged=$(jq -c --slurpfile previous "$previous" "$LIMIT_HISTORY" <<<"$record" 2>/dev/null) && [[ -n $merged ]]; then
    record=$merged
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

# Accounts can be signed in to someone else since they were added; the
# records name them from the registry, so bring it up to date first.
accounts_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/accounts"
if [[ -d $accounts_dir ]]; then
  "$OMARCHY_PATH/bin/omarchy-agent-account-state" refresh
fi

# Collectors forced together read the Codex rollouts they share once between
# them, whenever each gets to them, by knowing when this refresh began.
# EPOCHREALTIME uses the locale's decimal separator, a comma in many.
export OMARCHY_AGENT_USAGE_REFRESH_AT=${EPOCHREALTIME/,/.}

pids=()
for collector in "$OMARCHY_PATH"/bin/omarchy-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/omarchy-agent-usage-}"
  [[ $agent == "update" ]] && continue
  wanted "$agent" || continue
  collect "$collector" "$agent" &
  pids+=($!)
done

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done

# Fresh limits are when switching accounts near a limit gets decided. A switch
# changes which account the record's own limits describe, so that record is
# collected once more; the limits probes it repeats are still cached.
for agent in claude codex grok; do
  if wanted "$agent" && [[ -f $accounts_dir/$agent.json ]]; then
    switched=$("$OMARCHY_PATH/bin/omarchy-agent-account-state" autoswitch "$agent")
    if [[ -n $switched ]]; then
      flags=(--limits-only)
      collect "$OMARCHY_PATH/bin/omarchy-agent-usage-$agent" "$agent" || status=1
    fi
  fi
done

exit $status

#!/bin/bash

# omarchy:summary=Regenerate the AI agent usage data files
# omarchy:args=[--force] [--limits-only] [--except <agent>] [agent...]
# omarchy:examples=omarchy agent usage-update | omarchy agent usage-update claude | omarchy agent usage-update --except codex

# Each omarchy-agent-usage-<agent> collector prints one display-ready JSON
# record; this writes them to ~/.local/state/omarchy/agents/usage/ where the
# agents panel watches them. Adding an agent is adding a collector — the
# panel picks up any record that appears here.

USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
mkdir -p "$USAGE_DIR"

flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    if [[ -z ${2:-} ]]; then
      echo "--except needs an agent" >&2
      exit 1
    else
      excluded[$2]=1
      shift
    fi
    ;;
  *) only+=("$1") ;;
  esac
  shift
done

wanted() {
  local agent="$1"
  [[ -n ${excluded[$agent]} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  local candidate
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local collector="$1" agent="$2"
  local record tmp
  if ! record=$("$collector" "${flags[@]}") || [[ -z $record ]] || ! jq -e . >/dev/null 2>&1 <<<"$record"; then
    echo "omarchy-agent-usage-update: $agent collector failed" >&2
    return 1
  fi
  tmp=$(mktemp "$USAGE_DIR/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$USAGE_DIR/$agent.json"
}

# Wait on each collector pid once. wait -n is not that wait: when several
# have already finished it can return 127, and that 127 is not a collector
# status. In posix mode it also consumes the status, so a second wait on the
# pid is 127 too. A pid that has left the running set has finished, and its
# status is still there for this one wait.
reap_finished() {
  local -A still_running=()
  local alive pid
  local pending=()
  while IFS= read -r alive; do
    if [[ -n $alive ]]; then
      still_running[$alive]=1
    fi
  done < <(jobs -pr)
  for pid in "${collector_pids[@]}"; do
    if [[ -n ${still_running[$pid]} ]]; then
      pending+=("$pid")
    else
      if ! builtin wait "$pid"; then
        status=1
      fi
    fi
  done
  collector_pids=()
  if (( ${#pending[@]} > 0 )); then
    collector_pids=("${pending[@]}")
  fi
}

# Accounts can be signed in to someone else since they were added; the
# records name them from the registry, so bring it up to date first.
accounts_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/accounts"
if [[ -d $accounts_dir ]]; then
  "$OMARCHY_PATH/bin/omarchy-agent-account-state" refresh
fi

# Collectors forced together read the Codex rollouts they share once between
# them, whenever each gets to them, by knowing when this refresh began and
# that this process is still the one running them. A capped refresh can
# outlast the stamp's own window; a stamp inherited from elsewhere stops
# counting once this process is gone. EPOCHREALTIME uses the locale's
# decimal separator, a comma in many.
export OMARCHY_AGENT_USAGE_REFRESH_AT=${EPOCHREALTIME/,/.}
export OMARCHY_AGENT_USAGE_REFRESH_PID=$$

# A refresh starts every collector, and each one re-scans local session
# stores. All at once, that pins every core for the whole scan. Two at a
# time leaves the foreground its cores. OMARCHY_AGENT_USAGE_JOBS overrides
# the width. The stamp and pid above are shared either way, so collectors
# that read one store still scan it once between them, whenever each gets to it.
collector_jobs=${OMARCHY_AGENT_USAGE_JOBS:-2}
[[ $collector_jobs =~ ^[1-9][0-9]*$ ]] || collector_jobs=2

collector_pids=()
status=0
for collector in "$OMARCHY_PATH"/bin/omarchy-agent-usage-*; do
  [[ -x $collector ]] || continue
  agent="${collector##*/omarchy-agent-usage-}"
  [[ $agent == "update" ]] && continue
  wanted "$agent" || continue
  # Sleep only while every slot is still busy, so a fast collector can take
  # the slot a slow one is not using.
  while (( ${#collector_pids[@]} >= collector_jobs )); do
    reap_finished
    if (( ${#collector_pids[@]} >= collector_jobs )); then
      sleep 0.05
    fi
  done
  collect "$collector" "$agent" &
  collector_pids+=("$!")
done
while (( ${#collector_pids[@]} > 0 )); do
  reap_finished
  if (( ${#collector_pids[@]} > 0 )); then
    sleep 0.05
  fi
done

# Fresh limits are when an account near a limit gets announced.
for agent in claude codex grok; do
  if wanted "$agent" && [[ -f $accounts_dir/$agent.json ]]; then
    "$OMARCHY_PATH/bin/omarchy-agent-account-state" alert "$agent"
  fi
done

exit $status

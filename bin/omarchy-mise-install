#!/bin/bash

# omarchy:summary=Install a small mise-backed wrapper for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

# The command name becomes a file name under ~/.local/bin, so a slash in it
# writes the wrapper somewhere else and the rm below deletes somewhere else. A
# leading dot hides it or walks up, and a leading dash makes a name that reads
# as an option to whatever picks it up. Checked before anything is removed or
# written, and kept to those shapes so package names like npm:playwright still
# stand in for the command name.
case "$command" in
  */* | .* | -* | *[[:cntrl:]]*)
    echo "omarchy-mise-install: '$command' is not usable as a command name" >&2
    exit 1
    ;;
esac

mkdir -p "$HOME/.local/bin"
target="$HOME/.local/bin/$command"

# Every form this script has written, rebuilt from the package the file names
# and the bin being installed, which no caller changes. Anything else is the
# user's own.
is_mise_wrapper() {
  local contents named_package named_bin exec_line form
  # One argument as this script quotes it: in double quotes, or as %q leaves it.
  local token='^("[^"$`\\!]*"|([A-Za-z0-9_@%+=:,./-]|\\.)+)$'

  [[ -f $1 ]] && (($(stat -c%s "$1") <= 4096)) || return 1
  contents=$(<"$1")

  named_package=$(sed -n 's/^mise use -g \(--quiet \)\{0,1\}\(.*\)$/\2/p' <<<"$contents")
  named_package=${named_package% || exit 1}
  exec_line=$(sed -n 's/^exec \(.*\) "\$@"$/\1/p' <<<"$contents")
  named_bin=${exec_line#mise x "$named_package" -- }
  named_bin=${named_bin#mise exec "$named_package" -- }
  [[ $named_package =~ $token ]] || return 1
  [[ $named_bin == "\"$bin\"" || $named_bin == "$(printf '%q' "$bin")" ]] || return 1

  for form in \
    "export MISE_MINIMUM_RELEASE_AGE=0"$'\n'"mise use -g --quiet $named_package || exit 1"$'\n'"exec mise x $named_package -- $named_bin \"\$@\"" \
    "export MISE_MINIMUM_RELEASE_AGE=0"$'\n'"mise use -g $named_package || exit 1"$'\n'"exec mise x $named_package -- $named_bin \"\$@\"" \
    "mise use -g $named_package || exit 1"$'\n'"exec mise x $named_package -- $named_bin \"\$@\"" \
    "mise use -g $named_package"$'\n'"exec mise exec $named_package -- $named_bin \"\$@\"" \
    "mise use -g $named_package"$'\n'"exec $named_bin \"\$@\""; do
    [[ $contents == "#!/bin/bash"$'\n'"$form" ]] && return 0
  done

  return 1
}

# `cat >` would write through a symlink into the real binary behind it (issue
# #6618), so a link is dropped rather than followed. A user's own command at the
# same path keeps precedence, and leaving it is a success, so a migration
# installing this command does not stop every migration after it.
if [[ -L $target ]] || is_mise_wrapper "$target"; then
  rm -f "$target"
elif [[ -f $target ]]; then
  echo "omarchy-mise-install: leaving $target alone, it is not a mise wrapper" >&2
  exit 0
elif [[ -e $target ]]; then
  echo "omarchy-mise-install: $target is in the way and is not a file" >&2
  exit 1
fi

# The heredoc below is unquoted, so whatever these hold is written into the
# wrapper as shell source. Quote them the way omarchy-install-and-launch does, so
# a package name carrying shell characters stays one argument instead of running.
printf -v package_arg '%q' "$package"
printf -v bin_arg '%q' "$bin"

# Keep values that are inert inside double quotes in the form existing migrations
# recognize, including mise backend options that %q would unnecessarily escape.
case "$package" in
  *'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
  *) package_arg="\"$package\"" ;;
esac
case "$bin" in
  *'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
  *) bin_arg="\"$bin\"" ;;
esac

# These tools install and upgrade on first run, so mise's release cooldown would
# hold a new version back for days after it ships. Exported rather than set on
# the install line alone, so resolving the version to execute agrees with the
# one just installed.
cat >"$HOME/.local/bin/$command" <<EOF
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet $package_arg || exit 1
exec mise x $package_arg -- $bin_arg "\$@"
EOF

chmod +x "$HOME/.local/bin/$command"

#!/bin/bash

# omarchy:summary=Retire a mise wrapper an older Omarchy release left in ~/.local/bin
# omarchy:args=<package> [command-name [bin-name]]
# omarchy:hidden=true

# This once wrote a ~/.local/bin wrapper that installed a tool through mise the
# first time it ran. Omarchy installs nothing that way anymore, but migrations
# from then still call this to create or rewrite such wrappers. So it removes
# the wrapper an earlier release left at that path, and writes nothing.

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

command=${2:-$1}

# The command name is a file name under ~/.local/bin, so a slash, a leading dot
# or a leading dash would reach somewhere else.
case "$command" in
  */* | .* | -* | *[[:cntrl:]]*)
    echo "omarchy-mise-install: '$command' is not usable as a command name" >&2
    exit 1
    ;;
esac

# Only a small regular file that runs `mise use -g` is one of those wrappers;
# anything else at the path is the user's own.
wrapper="$HOME/.local/bin/$command"
if [[ -f $wrapper && ! -L $wrapper ]] && (( $(stat -c%s "$wrapper") <= 1024 )) &&
  grep -q '^\(export MISE_MINIMUM_RELEASE_AGE=0\|MISE_MINIMUM_RELEASE_AGE=0 \)\?mise use -g ' "$wrapper"; then
  rm -f "$wrapper"
fi

#!/bin/bash

# omarchy:summary=Install a small mise-backed wrapper for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

set -e

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

# Reject names that escape ~/.local/bin, hide a launcher, or look like options.
# Backend names such as npm:playwright are still valid command names.
case "$command" in
  */* | .* | -* | *[[:cntrl:]]*)
    echo "omarchy-mise-install: '$command' is not usable as a command name" >&2
    exit 1
    ;;
esac

mkdir -p "$HOME/.local/bin"
launcher="$HOME/.local/bin/$command"
if [[ -e $launcher && ! -f $launcher && ! -L $launcher ]]; then
  echo "omarchy-mise-install: '$launcher' is not a file or symlink" >&2
  exit 1
fi

wrapper=$(mktemp "$HOME/.local/bin/.mise-wrapper.XXXXXX")
trap 'rm -f -- "$wrapper"' EXIT

# The heredoc below is unquoted, so whatever these hold is written into the
# wrapper as shell source. Quote them the way omarchy-install-and-launch does, so
# a package name carrying shell characters stays one argument instead of running.
printf -v package_arg '%q' "$package"
printf -v bin_arg '%q' "$bin"

# Keep values that are inert inside double quotes in the form existing migrations
# recognize, including mise backend options that %q would unnecessarily escape.
case "$package" in
  *'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
  *) package_arg="\"$package\"" ;;
esac
case "$bin" in
  *'$'* | *'`'* | *'"'* | *'\'* | *'!'* | *[[:cntrl:]]*) ;;
  *) bin_arg="\"$bin\"" ;;
esac

# These tools install and upgrade on first run, so mise's release cooldown would
# hold a new version back for days after it ships. Exported rather than set on
# the install line alone, so resolving the version to execute agrees with the
# one just installed.
cat >"$wrapper" <<EOF
#!/bin/bash
export MISE_MINIMUM_RELEASE_AGE=0
mise use -g --quiet $package_arg || exit 1
exec mise x $package_arg -- $bin_arg "\$@"
EOF

if [[ -f $launcher ]]; then
  chmod --reference="$launcher" "$wrapper"
  chmod u+x "$wrapper"
else
  chmod 755 "$wrapper"
fi

generated_wrapper() {
  [[ -f $launcher && ! -L $launcher ]] || return 1
  (( $(stat -c%s "$launcher") <= 1024 )) || return 1
  local contents current legacy
  contents=$(<"$launcher")
  current=$(<"$wrapper")
  [[ $contents == "$current" ]] && return 0

  # These are the four templates regenerated by migration 1787573629.
  legacy=${current/ --quiet/}
  [[ $contents == "$legacy" ]] && return 0
  legacy=${legacy/$'export MISE_MINIMUM_RELEASE_AGE=0\n'/}
  [[ $contents == "$legacy" ]] && return 0
  legacy=${legacy/ || exit 1/}
  legacy=${legacy/exec mise x/exec mise exec}
  [[ $contents == "$legacy" ]] && return 0
  legacy=$(printf '#!/bin/bash\nmise use -g %s\nexec %s "$@"' "$package_arg" "$bin_arg")
  [[ $contents == "$legacy" ]]
}

# Keep custom launchers off PATH so later migrations cannot regenerate a backup.
if [[ -L $launcher ]] || { [[ -e $launcher ]] && ! generated_wrapper; }; then
  backup_dir="$HOME/.local/state/omarchy/mise-backups"
  mkdir -p "$backup_dir"
  backup=$(mktemp "$backup_dir/$command.XXXXXX")
  if ! cp -pP -- "$launcher" "$backup"; then
    rm -f -- "$backup"
    exit 1
  fi
  echo "Saved existing launcher to $backup"
fi

mv -fT -- "$wrapper" "$launcher"

#!/bin/bash

# omarchy:summary=Returns true when a fingerprint reader is present
# omarchy:hidden=true

# Detect straight from sysfs so this works before fprintd/usbutils are
# installed (the fingerprint setup pulls those in). USB vendor IDs listed here
# ship fingerprint readers; multi-purpose vendors (e.g. Elan/STMicro, which
# also make USB touchscreens) are left out to avoid nagging laptops with no
# reader — those still match on the product string below when present.
fingerprint_vendors=" 27c6 138a 06cb 08ff 1c7a 147e "
usb_devices_path="${OMARCHY_USB_DEVICES_PATH:-/sys/bus/usb/devices}"

# Limit each platform value read, including opening a path replaced after stat.
# Base64 preserves NULs and trailing newlines so truncated/oversized values
# cannot become a match through shell command-substitution normalization.
platform_value_matches() {
  local LC_ALL=C encoded expected line
  [[ -f $1 && -r $1 ]] || return 1
  (( ${#2} <= 255 )) || return 1
  encoded=$(set -o pipefail; timeout --kill-after=0.1s 0.25s head -c 257 -- "$1" 2>/dev/null | base64 -w0) || return 1
  expected=$(printf '%s' "$2" | base64 -w0)
  line=$(printf '%s\n' "$2" | base64 -w0)
  [[ $encoded == "$expected" || $encoded == "$line" ]]
}

# A reader the kernel drives without USB (a Mac's Touch ID, behind its Secure
# Enclave) is the platform's to name: each line of its fingerprint-readers file
# is a file (a shell glob) and the value that file reads once the reader is
# usable (see docs/file-layout.md).
platform_readers=/usr/share/omarchy-platform/fingerprint-readers
if [[ -f $platform_readers && -r $platform_readers ]]; then
  while IFS= read -r reader_line || [[ -n $reader_line ]]; do
    IFS=$' \t\r' read -r -a reader_fields <<<"$reader_line"
    ((${#reader_fields[@]} >= 2)) || continue
    reader_glob=${reader_fields[0]}
    reader_value=${reader_fields[1]}
    [[ $reader_glob == /* && -n $reader_value ]] || continue
    guards_ok=1
    guard_index=2
    while ((guard_index < ${#reader_fields[@]})); do
      guard_token=${reader_fields[guard_index]}
      if [[ $guard_token == +exists:/* ]]; then
        guard_glob=${guard_token#+exists:}
        guard_mode=exists
        ((guard_index += 1))
      else
        if ((guard_index + 1 >= ${#reader_fields[@]})); then
          guards_ok=0
          break
        fi
        guard_glob=$guard_token
        guard_value=${reader_fields[guard_index + 1]}
        guard_mode=value
        ((guard_index += 2))
        if [[ $guard_glob != /* || -z $guard_value ]]; then
          guards_ok=0
          break
        fi
      fi
      guard_count=0
      guard_matches=0
      for guard_file in $guard_glob; do
        [[ -e $guard_file || -L $guard_file ]] || continue
        ((guard_count += 1))
        if [[ $guard_mode == "exists" && -e $guard_file ]]; then
          guard_matches=1
        elif [[ $guard_mode == "value" ]] && platform_value_matches "$guard_file" "$guard_value"; then
          guard_matches=1
        fi
      done
      if ((guard_count != 1 || guard_matches != 1)); then
        guards_ok=0
        break
      fi
    done
    ((guards_ok == 1)) || continue
    for reader_file in $reader_glob; do
      if platform_value_matches "$reader_file" "$reader_value"; then
        exit 0
      fi
    done
  done <"$platform_readers"
fi

# libfprint drives every reader it supports from userspace over libusb, so a
# real reader sits there with no kernel driver bound to any of its interfaces.
# The other things these vendors build — Synaptics webcam bridges (usbio-bridge
# on the Dell XPS 14), touchpads and touchscreens (usbhid), cameras (uvcvideo)
# — all bind one. Only the vendor-ID guess needs this; a device that names
# itself a fingerprint reader is trusted outright.
has_kernel_driver() {
  local intf driver
  for intf in "$1"/*:*; do
    [[ -e $intf/driver ]] || continue
    # usbfs is the exception: libusb claims an interface through it, so a reader
    # fprintd is enrolling or verifying against binds a driver for as long as it
    # holds the claim. That is userspace driving the device — what a reader is
    # supposed to look like — so it must not read as a kernel driver here.
    driver=$(readlink -f "$intf/driver")
    [[ ${driver##*/} == "usbfs" ]] || return 0
  done
  return 1
}

for dev in "$usb_devices_path"/*; do
  # The device's own product descriptor usually names it, e.g. "Goodix
  # Fingerprint USB Device" — driver-independent and vendor-agnostic.
  if [[ -r $dev/product ]]; then
    product=$(<"$dev/product")
    product=${product,,}
    # Elan's match-on-chip readers report "ELAN:ARM-M4" and Fingerprint Cards'
    # report "FPC Sensor Controller" or "FPC L:0000 FW:1425046" — the family or
    # the manufacturer rather than the function. Both vendors are left out of
    # the list above on purpose (Elan also makes touchscreens), so without these
    # they match nothing. FPC leads the string on every reader on record, and
    # three letters are little to match on, so require the prefix.
    [[ $product == *fingerprint* || $product == *biometric* || $product == *elan:arm-m4* || $product == "fpc "* ]] && exit 0
  fi

  if [[ -r $dev/idVendor ]]; then
    vendor=$(<"$dev/idVendor")
    [[ $fingerprint_vendors == *" $vendor "* ]] &&
      ! has_kernel_driver "$dev" && exit 0
  fi
done

exit 1

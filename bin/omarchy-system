#!/bin/bash

# omarchy:summary=Log out, reboot, or shut down after closing applications
# omarchy:args=<logout|reboot|shutdown> [--policy <always|conditional|never>]
# omarchy:examples=omarchy system logout | omarchy system reboot | omarchy system shutdown
# omarchy:aliases=omarchy logout | omarchy reboot | omarchy shutdown

usage="Usage: omarchy-system <logout|reboot|shutdown> [--policy <always|conditional|never>]"
for arg in "$@"; do
  case $arg in
    -h | --help) echo "$usage"; exit 0 ;;
  esac
done
action=${1:-}
(( $# > 0 )) && shift
phase=""
policy="conditional"
while (( $# > 0 )); do
  case $1 in
    --policy)
      policy=${2:-}
      case $policy in always | conditional | never) ;; *) echo "$usage" >&2; exit 2 ;; esac
      shift 2
      ;;
    --execute | --inhibited)
      [[ -z $phase ]] || { echo "$usage" >&2; exit 2; }
      phase=$1
      shift
      ;;
    *) echo "$usage" >&2; exit 2 ;;
  esac
done
case $action in
  logout) command=(uwsm stop) ;;
  reboot) command=(systemctl reboot --no-wall) ;;
  shutdown) command=(systemctl poweroff --no-wall) ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

# The interactive request is outside the bounded service and precedes every
# visible/destructive preparation step. Worker phases must never prompt again.
if [[ -z $phase ]]; then
  omarchy-hyprland-window-close --confirm-exit "$action" --policy "$policy" || exit "$?"
fi

# Each action has whole sentences of its own, so a translation can inflect it.
case $action in
  logout)
    message=$(omarchy-i18n system.loggingOut)
    failed_title=$(omarchy-i18n system.logoutFailed)
    failed_body=$(omarchy-i18n system.logoutRetry)
    ;;
  reboot)
    message=$(omarchy-i18n system.rebooting)
    failed_title=$(omarchy-i18n system.rebootFailed)
    failed_body=$(omarchy-i18n system.rebootRetry)
    ;;
  shutdown)
    message=$(omarchy-i18n system.shuttingDown)
    failed_title=$(omarchy-i18n system.shutdownFailed)
    failed_body=$(omarchy-i18n system.shutdownRetry)
    ;;
esac

exit_session() {
  omarchy-osd -i "$action" -m "$message" -d 5000
  if [[ $action != "logout" ]]; then
    omarchy-state clear re*-required
  fi

  # Proceed as soon as apps exit, with a bound for unresponsive windows.
  timeout 2s omarchy-hyprland-window-close-all --wait --policy never
  "${command[@]}"
}

if [[ $phase == "--inhibited" ]]; then
  exit_session
elif [[ $phase == "--execute" ]]; then
  if [[ $action == "shutdown" ]]; then
    # Block lid handling explicitly: it ignores high-level sleep inhibitors.
    systemd-inhibit --what=sleep:idle:handle-lid-switch \
      --who=Omarchy --why="Shutdown in progress" --mode=block \
      "$0" "$action" --inhibited
  else
    exit_session
  fi
  status=$?
  if (( status != 0 )); then
    omarchy-notification-send -u critical "$failed_title" "$failed_body"
    exit "$status"
  fi
elif [[ -z $phase ]]; then
  # Survive closing the terminal that requested the session exit.
  systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
    --setenv=PATH --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=OMARCHY_PATH \
    "$0" "$action" --execute
else
  echo "$usage" >&2
  exit 2
fi

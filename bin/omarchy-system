#!/bin/bash

# omarchy:summary=Log out, reboot, reboot to the BIOS, or shut down after closing applications
# omarchy:args=<logout|reboot|firmware|shutdown>
# omarchy:examples=omarchy system logout | omarchy system reboot | omarchy system firmware | omarchy system shutdown
# omarchy:aliases=omarchy logout | omarchy reboot | omarchy shutdown

usage="Usage: omarchy-system <logout|reboot|firmware|shutdown>"
for arg in "$@"; do
  case $arg in
    -h | --help) echo "$usage"; exit 0 ;;
  esac
done
if (( $# > 2 )); then
  echo "$usage" >&2
  exit 2
fi

action=${1:-}
case $action in
  logout) command=(uwsm stop) ;;
  reboot) command=(systemctl reboot --no-wall) ;;
  firmware) command=(systemctl reboot --firmware-setup --no-wall) ;;
  shutdown) command=(systemctl poweroff --no-wall) ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

# Each action has whole sentences of its own, so a translation can inflect it.
case $action in
  logout)
    message_key=system.loggingOut
    failed_title_key=system.logoutFailed
    failed_body_key=system.logoutRetry
    ;;
  reboot)
    message_key=system.rebooting
    failed_title_key=system.rebootFailed
    failed_body_key=system.rebootRetry
    ;;
  firmware)
    message_key=system.rebootingToFirmware
    failed_title_key=system.firmwareFailed
    failed_body_key=system.firmwareRetry
    ;;
  shutdown)
    message_key=system.shuttingDown
    failed_title_key=system.shutdownFailed
    failed_body_key=system.shutdownRetry
    ;;
esac

exit_session() {
  # systemctl only finds out the firmware can't do it after the apps are gone.
  if [[ $action == "firmware" ]]; then
    local answer
    answer=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager CanRebootToFirmwareSetup 2>/dev/null)
    if [[ $answer != 's "yes"' ]]; then
      return 1
    fi
  fi

  # Only show the OSD once the exit has taken 2 seconds, so a quick one doesn't flash it.
  { sleep 2; omarchy-osd -i "${action/firmware/reboot}" -m "$(omarchy-i18n "$message_key")" -d 0; } &
  local osd_pid=$!

  if [[ $action != "logout" ]]; then
    omarchy-state clear re*-required
  fi

  # Proceed as soon as apps exit, with a bound for unresponsive windows.
  timeout 2s omarchy-hyprland-window-close-all --wait
  if "${command[@]}"; then
    # The unit kills the delayed OSD when this script exits, so stay until the session goes down.
    wait "$osd_pid"
  else
    local status=$?
    kill "$osd_pid" 2>/dev/null
    omarchy-shell -q osd close
    return "$status"
  fi
}

if [[ ${2:-} == "--inhibited" ]]; then
  exit_session
elif [[ ${2:-} == "--execute" ]]; then
  if [[ $action == "shutdown" ]]; then
    # Block lid handling explicitly: it ignores high-level sleep inhibitors.
    systemd-inhibit --what=sleep:idle:handle-lid-switch \
      --who=Omarchy --why="Shutdown in progress" --mode=block \
      "$0" "$action" --inhibited
  else
    exit_session
  fi
  status=$?
  if (( status != 0 )); then
    omarchy-notification-send -u critical "$(omarchy-i18n "$failed_title_key")" "$(omarchy-i18n "$failed_body_key")"
    exit "$status"
  fi
elif [[ -z ${2:-} ]]; then
  # Survive closing the terminal that requested the session exit.
  systemd-run --user --collect --quiet --property=Type=exec --property=RuntimeMaxSec=30s \
    --setenv=PATH --setenv=HYPRLAND_INSTANCE_SIGNATURE --setenv=OMARCHY_PATH \
    "$0" "$action" --execute
else
  echo "$usage" >&2
  exit 2
fi

#!/bin/bash

# omarchy:summary=Returns true when a fingerprint reader is present that only libfprint-git can drive
# omarchy:hidden=true

# Readers stock libfprint (1.94.100) does not know yet, as USB vendor:product.
# The fingerprint setup installs the omarchy repo's libfprint-git for these,
# and the stock-libfprint migration leaves that package alone for them. When
# adding an ID, raise the version floor in omarchy-setup-security-fingerprint
# to the first libfprint-git pin that carries it.
#   06cb:010b  Synaptics, upstream 6f9479c
git_readers=" 06cb:010b "
usb_devices_path="${OMARCHY_USB_DEVICES_PATH:-/sys/bus/usb/devices}"

for dev in "$usb_devices_path"/*; do
  [[ -r $dev/idVendor && -r $dev/idProduct ]] || continue
  [[ $git_readers == *" $(<"$dev/idVendor"):$(<"$dev/idProduct") "* ]] && exit 0
done

exit 1

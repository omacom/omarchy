#!/bin/bash

# omarchy:summary=Enable or disable single-instance mode for a terminal (improves startup time and memory usage)
# omarchy:args=<alacritty|foot|kitty> [on|off|toggle]
# omarchy:examples=omarchy toggle terminal-daemon foot | omarchy toggle alacritty-daemon off

terminal=${1:-}
action=${2:-toggle}
flag=terminal-daemon-$terminal
apps=${XDG_DATA_HOME:-$HOME/.local/share}/applications
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
unit_dir=$config_home/systemd/user

usage() {
  echo "Usage: omarchy-toggle-terminal-daemon <alacritty|foot|kitty> [on|off|toggle]" >&2
}

install_desktop() {
  local src=$1 expr=$2 body
  if ! body=$(sed "$expr" "$src"); then
    echo "failed to read $src" >&2
    return 1
  fi
  if ! printf '%s\n' "$body" >"$desktop"; then
    echo "failed to write $desktop" >&2
    return 1
  fi
}

desktop_done=0
server_done=0

update_desktop() {
  case $terminal in
    foot)
      if [[ $action == on ]]; then
        install_desktop "$OMARCHY_PATH/applications/foot.desktop" 's/^Exec=foot$/Exec=footclient --client-environment/'
      else
        if ! cp "$OMARCHY_PATH/applications/foot.desktop" "$desktop"; then
          echo "failed to restore $desktop" >&2
          return 1
        fi
      fi
      ;;
    kitty)
      if [[ $action == on ]]; then
        install_desktop /usr/share/applications/kitty.desktop 's/^Exec=kitty$/Exec=kitty --single-instance/'
      else
        if ! rm -f "$desktop"; then
          echo "failed to remove $desktop" >&2
          return 1
        fi
      fi
      ;;
    alacritty)
      if [[ $action == on ]]; then
        install_desktop "$OMARCHY_PATH/default/alacritty/Alacritty.desktop" 's/^Exec=alacritty$/Exec=alacritty msg create-window/'
      else
        if ! cp "$OMARCHY_PATH/default/alacritty/Alacritty.desktop" "$desktop"; then
          echo "failed to restore $desktop" >&2
          return 1
        fi
      fi
      ;;
  esac
}

fail() {
  echo "$1" >&2
  if (( server_done )); then
    if [[ $action == on ]]; then
      systemctl --user disable --now "omarchy-$terminal-server.service" || echo "failed to stop the server" >&2
    else
      systemctl --user enable --now "omarchy-$terminal-server.service" || echo "failed to start the server" >&2
    fi
  fi
  if (( desktop_done )); then
    if [[ $action == on ]]; then
      action=off
    else
      action=on
    fi
    update_desktop || echo "failed to revert $desktop" >&2
  fi
  exit 1
}

case $terminal in
  alacritty|foot|kitty) ;;
  *) usage; exit 1 ;;
esac

case $action in
  on|off) ;;
  toggle) omarchy-toggle-enabled "$flag" && action=off || action=on ;;
  *) usage; exit 1 ;;
esac

mkdir -p "$apps" "$unit_dir"
ln -sfn "$OMARCHY_PATH/default/systemd/user/omarchy-foot-server.service" "$unit_dir/omarchy-foot-server.service"
ln -sfn "$OMARCHY_PATH/default/systemd/user/omarchy-kitty-server.service" "$unit_dir/omarchy-kitty-server.service"
ln -sfn "$OMARCHY_PATH/default/systemd/user/omarchy-alacritty-server.service" "$unit_dir/omarchy-alacritty-server.service"
systemctl --user daemon-reload || exit 1

if [[ $terminal == alacritty ]]; then
  desktop=$apps/Alacritty.desktop
else
  desktop=$apps/$terminal.desktop
fi

if [[ $action == on ]]; then
  cmd=enable
else
  cmd=disable
fi

update_desktop || fail "failed to update $desktop"
desktop_done=1
systemctl --user $cmd --now "omarchy-$terminal-server.service" || fail "failed to $cmd the server"
server_done=1

omarchy-toggle "$flag" "$action" || fail "failed to set $flag"

if [[ $action == on && $terminal == alacritty ]]; then
  echo "WARNING: due to limitations with alacritty, every window will share an environment with the server" >&2
fi

if [[ "$action" == on ]]; then
  omarchy-notification-send -g "" "${terminal^} single-instance mode enabled"
else
  omarchy-notification-send -g "" "${terminal^} single-instance mode disabled"
fi

#!/bin/bash

# omarchy:summary=Set up Chewing Bopomofo input for Traditional Chinese with the fcitx5 that already runs in every session
# omarchy:requires-sudo=true

set -euo pipefail

omarchy-pkg-add fcitx5-chewing

# fcitx5 only scans for engines at startup, so the one just installed is
# invisible to the running instance until it comes back up.
omarchy-restart-xcompose

# --check on its own still reports the input state on stdout once fcitx5
# answers, and complains on stderr while it can't reach the bus, so keep both
# out of the terminal.
fcitx_ready=false
for _ in {1..50}; do
  if fcitx5-remote --check >/dev/null 2>&1; then
    fcitx_ready=true
    break
  fi
  sleep 0.1
done

if [[ $fcitx_ready == "false" ]]; then
  echo "Fcitx 5 is not running. Log in to an Omarchy desktop session and try again." >&2
  exit 1
fi

# Append chewing to whatever input methods the user already has rather than
# replacing the group: a Japanese or Korean engine added earlier stays put.
group=$(fcitx5-remote -q)
group_info=$(busctl --user --json=short call \
  org.fcitx.Fcitx5 \
  /controller \
  org.fcitx.Fcitx.Controller1 \
  InputMethodGroupInfo \
  s "$group")

if ! jq -e '.data[1] | any(.[0] == "chewing")' <<<"$group_info" >/dev/null; then
  layout=$(jq -r '.data[0]' <<<"$group_info")
  mapfile -t input_methods < <(jq -r '.data[1][] | @tsv' <<<"$group_info")

  args=("$group" "$layout" "$((${#input_methods[@]} + 1))")
  for input_method in "${input_methods[@]}"; do
    IFS=$'\t' read -r name item_layout <<<"$input_method"
    args+=("$name" "$item_layout")
  done
  args+=(chewing "")

  busctl --user call \
    org.fcitx.Fcitx5 \
    /controller \
    org.fcitx.Fcitx.Controller1 \
    SetInputMethodGroupInfo \
    'ssa(ss)' "${args[@]}" >/dev/null
  busctl --user call \
    org.fcitx.Fcitx5 \
    /controller \
    org.fcitx.Fcitx.Controller1 \
    Save >/dev/null
fi

echo "Traditional Chinese input is ready. Press Ctrl+Space to switch between English and Chinese."
echo "Chewing reads Bopomofo off the standard arrangement. To pick Hsu, ETen or another one, run 'omarchy pkg add fcitx5-configtool' and then 'fcitx5-configtool' from a terminal."

#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

voxtype_lib_path="${OMARCHY_VOXTYPE_LIB_PATH:-/usr/lib/voxtype}"

if omarchy-cmd-missing voxtype; then
  if gum confirm --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n dictation.installVoxtype)"; then
    omarchy-pkg-add wtype voxtype-bin
  else
    exit 0
  fi
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$config_home/voxtype"
if [[ ! -e $config_home/voxtype/config.toml ]]; then
  cp "$OMARCHY_PATH/default/voxtype/config.toml" "$config_home/voxtype/"
  # A Vulkan runtime is not enough: aarch64 voxtype-bin ships no Vulkan backend.
  if omarchy-hw-vulkan && [[ -x $voxtype_lib_path/voxtype-vulkan ]]; then
    voxtype setup gpu --enable || true
  fi
fi

# Setup reuses the configured model and downloads it only when missing.
# Retry these steps even when an earlier attempt already installed the binary.
voxtype setup --download --no-post-install
voxtype setup systemd

# The intel-ipu7 camera resume hook restarts wireplumber.service on every
# resume, and WirePlumber going away under Voxtype's open playback stream can
# leave its audio thread spinning at 100% CPU. Tie the service's lifetime to
# WirePlumber's so it stops with WirePlumber and starts after it comes back.
drop_in_dir="$config_home/systemd/user/voxtype.service.d"
mkdir -p "$drop_in_dir"
cat >"$drop_in_dir/omarchy-restart-with-wireplumber.conf" <<'EOF'
# Omarchy: restart Voxtype with WirePlumber. The intel-ipu7 camera resume hook
# restarts wireplumber.service on every resume, and Voxtype's open playback
# stream can spin at 100% CPU once WirePlumber disappears under it.
[Unit]
PartOf=wireplumber.service
After=wireplumber.service
EOF
systemctl --user daemon-reload
systemctl --user enable --now voxtype.service

omarchy-dictation-use voxtype
hyprctl reload >/dev/null
omarchy-notification-send -g  "$(omarchy-i18n dictation.voxtypeReady)" "$(omarchy-i18n dictation.hint)" -t 10000

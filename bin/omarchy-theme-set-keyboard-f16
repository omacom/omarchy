#!/bin/bash

# omarchy:summary=Apply the current theme keyboard color to Framework Laptop 16 keyboards
# omarchy:hidden=true

FRAMEWORK16_THEME=$HOME/.local/state/omarchy/current/theme/keyboard.rgb

# QMK hue and saturation on a 0-255 scale. The floating-point steps follow
# Python's colorsys.rgb_to_hsv, which this replaces to save starting Python on
# every theme switch, so every colour truncates to the same values it always did.
hex_to_qmk_hue_saturation() {
  awk -v r=$((16#${1:0:2})) -v g=$((16#${1:2:2})) -v b=$((16#${1:4:2})) 'BEGIN {
    r /= 255; g /= 255; b /= 255
    maxc = r; if (g > maxc) maxc = g; if (b > maxc) maxc = b
    minc = r; if (g < minc) minc = g; if (b < minc) minc = b
    if (maxc == minc) { print 0, 0; exit }

    s = (maxc - minc) / maxc
    rc = (maxc - r) / (maxc - minc)
    gc = (maxc - g) / (maxc - minc)
    bc = (maxc - b) / (maxc - minc)
    if (r == maxc) h = bc - gc
    else if (g == maxc) h = 2.0 + rc - bc
    else h = 4.0 + gc - rc

    h = h / 6.0
    h -= int(h)
    if (h < 0) h += 1.0
    print int(h * 255), int(s * 255)
  }'
}

# Gate on actual Framework 16 hardware (same check install/udev use). qmk_hid
# targets any connected VIA device, so keying off "qmk_hid is installed" alone
# would poke a non-Framework QMK keyboard (e.g. a Keychron) on other machines.
if omarchy-hw-framework16 && omarchy-cmd-present qmk_hid && [[ -f $FRAMEWORK16_THEME ]]; then
  hex=$(cat "$FRAMEWORK16_THEME")
  hex="${hex#\#}"

  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || exit 0

  read -r h s <<<"$(hex_to_qmk_hue_saturation "$hex")"

  # Pin Framework 16's VID/PID (matches default/udev/framework16-qmk-hid.rules)
  # so qmk_hid addresses only the Framework keyboard, never some other VIA board.
  apply_framework16_rgb() {
    qmk_hid --vid 32ac --pid 0012 via --rgb-effect 1
    qmk_hid --vid 32ac --pid 0012 via --rgb-hue "$1"
    qmk_hid --vid 32ac --pid 0012 via --rgb-saturation "$2"
    qmk_hid --vid 32ac --pid 0012 via --rgb-brightness 100
    qmk_hid --vid 32ac --pid 0012 via --save
  }

  # Belt-and-suspenders: this hook runs inside omarchy-theme-set's waited-on
  # run_parallel batch, so even a wedged Framework keyboard must not stall the
  # theme switch. One outer timeout bounds the whole sequence.
  export -f apply_framework16_rgb
  timeout 10 bash -c 'apply_framework16_rgb "$@"' _ "$h" "$s" 2>/dev/null
fi

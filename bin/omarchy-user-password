#!/bin/bash

# omarchy:summary=Set a new password for the login user and for root
# omarchy:requires-sudo=true
# omarchy:examples=omarchy user password

set -euo pipefail

user="${USER:-$(id -un)}"

# Non-wheel accounts cannot sudo chpasswd; keep the old user-only passwd path.
if ! id -nG "$user" | grep -qw wheel; then
  exec passwd
fi

new_password=$(gum input --password --header "New password (user and root)") || exit $?
[[ -n $new_password ]] || { echo "Password cannot be empty."; exit 1; }

confirmation=$(gum input --password --header "Confirm new password") || exit $?
[[ $new_password == "$confirmation" ]] || { echo "Passwords do not match."; exit 1; }

# Locked (!hash) or unset (*) root should stay disabled unless the admin confirms.
sync_root=1
root_status=$(passwd -S root 2>/dev/null | awk '{print $2}')
if [[ $root_status == "L" || $root_status == "NP" ]]; then
  if gum confirm --default=false "Root currently has no usable password. Also set root to this password?"; then
    sync_root=1
  else
    sync_root=0
  fi
fi

if (( sync_root )); then
  # Install sets user and root to the same password. The menu used to run
  # `passwd`, which only updates the login account and leaves the old root
  # password live for `su` and a TTY login.
  printf '%s:%s\n%s:%s\n' "$user" "$new_password" root "$new_password" | sudo chpasswd
else
  printf '%s:%s\n' "$user" "$new_password" | sudo chpasswd
fi

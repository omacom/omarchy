#!/bin/bash

# omarchy:summary=Change a person's password, which also unlocks the disk
# omarchy:args=[NAME]
# omarchy:requires-sudo=true

set -euo pipefail
set +x

source "$OMARCHY_PATH/install/helpers/user-prompts.sh"
user_start

me=$(id -un)
name=${1:-$me}
changed=$(omarchy-i18n users.passwordChanged "$name")

if [[ $name == "$me" ]]; then
  current=$(user_secret "$(omarchy-i18n users.currentPassword)") || exit 1
  password=$(user_prompt_new_password "$(omarchy-i18n users.newPassword)") || exit 1
  if [[ " $(id -nG) " == *" omarchy-child "* ]]; then
    # A child's grant reaches only password-self, and asks for no sudo password.
    printf '%s\n%s\n' "$current" "$password" | user_helper "$changed" password-self
  else
    printf '%s\n' "$current" | sudo -S -p '' -v 2>/dev/null || { user_problem "$(omarchy-i18n users.wrongPassword)"; exit 1; }
    printf '%s\n%s\n' "$current" "$password" | user_helper "$changed" password "$name"
  fi
else
  password=$(user_prompt_new_password "$(omarchy-i18n users.newPasswordFor "$name")") || exit 1
  mine=$(user_prompt_own_password "$(omarchy-i18n users.yourPassword)") || exit 1
  printf '%s\n%s\n' "$mine" "$password" | user_helper "$changed" password "$name"
fi

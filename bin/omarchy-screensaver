#!/bin/bash

# omarchy:summary=Run the Omarchy screensaver using random effects from TTE.

CURRENT_THEME_PATH="$HOME/.local/state/omarchy/current/theme"

# A theme may ship its own screensaver.txt, taking precedence over the
# global branding file set via `omarchy branding screensaver`.
screensaver_input_file() {
  if [[ -f $CURRENT_THEME_PATH/screensaver.txt ]]; then
    echo "$CURRENT_THEME_PATH/screensaver.txt"
  else
    echo ~/.config/omarchy/branding/screensaver.txt
  fi
}

# A theme may also ship screensaver.conf: extra ttfx arguments (e.g.
# --include-effects, --exclude-effects, a slower --frame-rate, a fixed
# --canvas-width/--canvas-height), one per line, blank lines and lines
# starting with # ignored.
screensaver_theme_args() {
  local conf="$CURRENT_THEME_PATH/screensaver.conf"
  [[ -f $conf ]] || return 0
  grep -vE '^[[:space:]]*(#|$)' "$conf"
}

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.omarchy.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || hyprctl keyword cursor:invisible false &>/dev/null || true
  pkill -x ttfx 2>/dev/null
  pkill -f '[o]rg.omarchy.screensaver' 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || hyprctl keyword cursor:invisible true &>/dev/null

tty=$(tty 2>/dev/null)

# Terminals allocate the pty at the default 80x24 and only resize it once the
# compositor has told the window how big it is. ttfx measures the terminal once,
# at startup, so starting it before the resize lands sizes an 80x24 canvas and
# paints it into the corner of a fullscreen window.
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}

wait_for_terminal_resize

theme_defines_flag() {
  local flag="$1" arg
  for arg in "${theme_args[@]}"; do
    [[ $arg == "$flag" ]] && return 0
  done
  return 1
}

# ttfx (clap) errors out if a flag is passed twice, so a theme providing its
# own value for one of these drops the built-in default instead of adding to it.
add_default() {
  theme_defines_flag "$1" || ttfx_args+=("$@")
}

while true; do
  mapfile -t theme_args < <(screensaver_theme_args)

  ttfx_args=(-i "$(screensaver_input_file)")
  add_default --frame-rate 120
  add_default --canvas-width 0
  add_default --canvas-height 0
  add_default --anchor-canvas c
  add_default --anchor-text c
  add_default --reuse-canvas
  add_default --random-effect
  add_default --no-eol
  add_default --no-restore-cursor
  ttfx_args+=("${theme_args[@]}")

  ttfx "${ttfx_args[@]}" &

  while pgrep -t "${tty#/dev/}" -x ttfx >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
done

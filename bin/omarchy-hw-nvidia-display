#!/bin/bash

# omarchy:summary=Detect whether NVIDIA drives the display (rather than a hybrid iGPU).

# On hybrid laptops the display is usually wired to the integrated GPU while
# the NVIDIA card only handles offloaded rendering. Forcing NVIDIA's VA-API and
# GLX drivers globally then breaks Chromium-based browsers (black video with
# audio still playing), so the Hyprland NVIDIA env only applies when NVIDIA is
# the display GPU.
#
# Prefer connected DRM displays over the boot GPU, which can differ when an
# external monitor is attached. Displays on both GPUs, as on a hybrid laptop
# docked to ports wired to NVIDIA, do not say where the compositor renders, so
# fall back to boot_vga then, as when nothing is connected. When no device
# claims it (attribute missing or unreadable), assume NVIDIA is the
# display GPU to preserve the current behavior on machines we cannot tell.
#
# Read the cached sysfs IDs rather than lspci, which reads PCI config space and
# resumes runtime-suspended GPUs.
pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"
drm_path="${OMARCHY_DRM_PATH:-/sys/class/drm}"

shopt -s nullglob

nvidia_connected=0
other_connected=0

for connector in "$drm_path"/card*-*; do
  # Writeback connectors capture to memory and report connected without a monitor.
  [[ $connector == *-Writeback-* ]] && continue
  [[ -f $connector/status ]] || continue
  [[ $(< "$connector/status") == "connected" ]] || continue
  card=${connector##*/}
  card=${card%%-*}
  vendor_file="$drm_path/$card/device/vendor"
  [[ -f $vendor_file ]] || continue
  if [[ $(< "$vendor_file") == "0x10de" ]]; then
    nvidia_connected=1
  else
    other_connected=1
  fi
done

nvidia_boot=0
other_boot=0

for device in "$pci_devices_path"/*; do
  [[ $(< "$device/class") == 0x03* ]] || continue
  boot_vga=0
  if [[ -f $device/boot_vga ]]; then
    boot_vga=$(< "$device/boot_vga")
  fi
  if [[ $(< "$device/vendor") == "0x10de" ]]; then
    if (( boot_vga == 1 )); then
      nvidia_boot=1
    fi
  else
    if (( boot_vga == 1 )); then
      other_boot=1
    fi
  fi
done

if (( nvidia_connected && !other_connected )); then
  exit 0
elif (( other_connected && !nvidia_connected )); then
  exit 1
elif (( other_boot == 1 && nvidia_boot == 0 )); then
  exit 1
else
  exit 0
fi

#!/bin/bash

# omarchy:summary=Detect whether NVIDIA drives the display rather than a hybrid iGPU

# Read cached sysfs metadata, never PCI config space or an NVIDIA query.
# A foreign built-in panel identifies an iGPU laptop even with the lid closed;
# a connected NVIDIA panel takes precedence for a discrete/MUX display mode.
pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"
drm_class_path="${OMARCHY_DRM_CLASS_PATH:-/sys/class/drm}"
shopt -s nullglob

nvidia_present=0
nvidia_boot=0
other_boot=0
for device in "$pci_devices_path"/*; do
  [[ -r $device/class && -r $device/vendor ]] || continue
  [[ $(<"$device/class") == 0x03* ]] || continue
  boot_vga=0
  if [[ -r $device/boot_vga ]]; then boot_vga=$(<"$device/boot_vga"); fi
  if [[ $(<"$device/vendor") == "0x10de" ]]; then
    nvidia_present=1
    if [[ $boot_vga == "1" ]]; then nvidia_boot=1; fi
  elif [[ $boot_vga == "1" ]]; then
    other_boot=1
  fi
done

drm_cards=0
nvidia_cards=0
other_cards=0
nvidia_connected=0
nvidia_panel=0
foreign_panel=0
any_connected=0
for card in "$drm_class_path"/card[0-9]*; do
  [[ ${card##*/} == *-* ]] && continue
  [[ -r $card/device/vendor ]] || continue
  ((drm_cards += 1))
  vendor=$(<"$card/device/vendor")
  if [[ $vendor == "0x10de" ]]; then
    ((nvidia_cards += 1))
    nvidia_present=1
  else
    ((other_cards += 1))
  fi
  for connector in "$card"-*; do
    [[ -r $connector/status ]] || continue
    name=${connector##*/}
    panel=0
    case ${name#card*-} in eDP*|LVDS*|DSI*) panel=1 ;; esac
    if [[ $vendor != "0x10de" ]] && ((panel)); then foreign_panel=1; fi
    [[ $(<"$connector/status") == "connected" ]] || continue
    any_connected=1
    if [[ $vendor == "0x10de" ]]; then
      nvidia_connected=1
      if ((panel)); then nvidia_panel=1; fi
    fi
  done
done

if ((drm_cards && !nvidia_cards)); then
  exit 1
elif ((nvidia_panel)); then
  exit 0
elif ((foreign_panel)); then
  exit 1
elif ((nvidia_connected)); then
  exit 0
elif ((nvidia_cards && !other_cards)); then
  # NVIDIA-only desktops still need their drivers with the monitor off or KVM.
  exit 0
elif ((any_connected || (other_boot && !nvidia_boot))); then
  exit 1
else
  # No useful DRM output information: retain the upstream boot_vga fallback.
  ((nvidia_present))
fi

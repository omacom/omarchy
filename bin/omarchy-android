#!/bin/bash

# omarchy:summary=Install, launch, list, stop, or remove Android apps running seamlessly via Waydroid
# omarchy:args=<install|launch|apps|stop|status|remove> [package]
# omarchy:examples=omarchy android install | omarchy android launch | omarchy android apps
# omarchy:requires-sudo=true

# Waydroid boots a full Android system in an LXC container, but Omarchy runs it
# in multi-window mode: each Android app is a separate Wayland toplevel the
# compositor tiles, floats, and resizes like any native window, so there is no
# full-screen Android desktop to step into. Unlike the Windows VM, nothing here
# is proprietary and nothing runs a privileged, user-writable compose file --
# the waydroid CLI and systemd own the privileged container, and this script
# only drives them, elevating with sudo in the terminal the menu opens it in.

set -euo pipefail

DESKTOP_DIR="$HOME/.local/share/applications"
LAUNCHER_DESKTOP="$DESKTOP_DIR/omarchy-android.desktop"

# --- state helpers -----------------------------------------------------------

waydroid_installed() { omarchy-cmd-present waydroid; }

# Waydroid is initialized once its images are downloaded under /var/lib/waydroid.
waydroid_initialized() { [[ -f /var/lib/waydroid/waydroid.cfg ]]; }

container_active() { systemctl is-active --quiet waydroid-container.service; }

session_running() { waydroid status 2>/dev/null | grep -qi "Session:[[:space:]]*RUNNING"; }

require_installed() {
  if ! waydroid_installed || ! waydroid_initialized; then
    echo "Android (Waydroid) is not installed yet." >&2
    echo "Set it up first: omarchy android install" >&2
    exit 1
  fi
}

# --- seamless system integration ---------------------------------------------

# Omarchy's firewall denies incoming by default, which also blocks Waydroid's
# own bridge (waydroid0: the container's dnsmasq hands out DHCP leases and
# resolves DNS, and the NAT needs forwarding). Open only what the container
# needs on that interface -- DHCP and DNS to the host, and forwarding out -- so
# installed APKs cannot reach arbitrary host services listening on waydroid0.
# ufw de-duplicates identical rules, so this is safe to re-run.
configure_networking() {
  echo "Allowing Android container traffic through the firewall..."
  sudo ufw allow in on waydroid0 to any port 67 proto udp comment 'allow-waydroid-dhcp' >/dev/null 2>&1 || true
  sudo ufw allow in on waydroid0 to any port 53 comment 'allow-waydroid-dns' >/dev/null 2>&1 || true
  sudo ufw route allow in on waydroid0 comment 'allow-waydroid-forward' >/dev/null 2>&1 || true
  sudo ufw route allow out on waydroid0 comment 'allow-waydroid-forward' >/dev/null 2>&1 || true
}

remove_networking() {
  sudo ufw delete allow in on waydroid0 to any port 67 proto udp >/dev/null 2>&1 || true
  sudo ufw delete allow in on waydroid0 to any port 53 >/dev/null 2>&1 || true
  sudo ufw route delete allow in on waydroid0 >/dev/null 2>&1 || true
  sudo ufw route delete allow out on waydroid0 >/dev/null 2>&1 || true
}

# Per-app windows feel native. multi_windows gives each app its own toplevel;
# suspend must be off too, or Android freezes the moment no window is mapped and
# a freshly launched app never gets the chance to show. Both are persisted, so a
# reboot or image re-init keeps the behavior.
enable_multi_window() {
  waydroid prop set persist.waydroid.multi_windows true >/dev/null 2>&1 || true
  waydroid prop set persist.waydroid.suspend false >/dev/null 2>&1 || true
}

# A single app-launcher entry that opens the picker. The picker is an interactive
# gum prompt (and may need to start the container), so it runs inside a terminal
# rather than being launched headless. Per-app .desktop files are generated by
# Waydroid itself when apps are installed, so individual apps also show up on
# their own and launch directly without the picker.
write_launcher_desktop() {
  mkdir -p "$DESKTOP_DIR"
  cat >"$LAUNCHER_DESKTOP" <<EOF
[Desktop Entry]
Name=Android Apps
Comment=Launch an Android app in its own window via Waydroid
Exec=uwsm app -- xdg-terminal-exec omarchy-android launch
Icon=waydroid
Terminal=false
Type=Application
Categories=System;
EOF
}

# --- session control ---------------------------------------------------------

ensure_session() {
  container_active || sudo systemctl start waydroid-container.service

  if ! session_running; then
    echo "Starting the Android session..."
    nohup waydroid session start >/dev/null 2>&1 &
    local tries=0
    while ! session_running; do
      sleep 1
      ((++tries > 30)) && {
        echo "The Android session did not come up within 30 seconds." >&2
        echo "Check the logs with: sudo journalctl -u waydroid-container -b" >&2
        return 1
      }
    done
    enable_multi_window
  fi
}

# --- commands ----------------------------------------------------------------

install_android() {
  trap 'echo; echo "Installation cancelled."; exit 1' INT

  # Only choose an image when there is none yet: once Waydroid is initialized,
  # waydroid init is skipped below, so asking again would be a choice that
  # silently does nothing. Switching images means removing first.
  local system_arg="VANILLA"
  if waydroid_initialized; then
    echo "An Android image is already installed -- keeping it."
    echo "To switch between Vanilla and GApps, run 'omarchy android remove' first, then reinstall."
  else
    # Vanilla is fully open source and needs nothing signed in; GAPPS adds the
    # Google Play stack (proprietary, and a device registration step to pass
    # Play's integrity check). The choice is the user's, not a default.
    local system_type
    system_type=$(printf '%s\n' \
      "Vanilla (open source, no Google Play)" \
      "GAPPS (includes Google Play, proprietary)" |
      gum choose --header "Which Android image do you want to install?") || {
      echo "Installation cancelled."
      exit 1
    }
    [[ -z $system_type ]] && { echo "Installation cancelled."; exit 1; }
    [[ $system_type == GAPPS* ]] && system_arg="GAPPS"
  fi

  echo "Installing Waydroid and its dependencies..."
  omarchy-pkg-add waydroid

  # Waydroid mounts binderfs itself through its container service; a current
  # kernel exposes binder as a filesystem, so no extra module is normally
  # needed. If init below fails for a missing binder node, binder_linux-dkms is
  # the upstream fallback -- we surface that rather than silently patching around
  # it.
  if ! waydroid_initialized; then
    echo "Downloading the Android system image (this can take a while)..."
    if ! sudo waydroid init -s "$system_arg"; then
      echo "waydroid init failed." >&2
      echo "If the error mentions binder, install the kernel module and retry:" >&2
      echo "  omarchy-pkg-aur-add binder_linux-dkms && sudo modprobe binder_linux" >&2
      exit 1
    fi
  fi

  echo "Enabling the Android container service..."
  sudo systemctl enable --now waydroid-container.service

  configure_networking
  ensure_session
  enable_multi_window
  write_launcher_desktop

  gum style --border normal --padding "1 2" --margin "1" \
    "Android is ready." \
    "" \
    "Launch an app:        omarchy android launch" \
    "List installed apps:  omarchy android apps" \
    "Apps also appear in your app launcher as you install them."
}

launch_android() {
  require_installed
  ensure_session || exit 1

  local package="${1:-}"

  if [[ -z $package ]]; then
    # Show "Name  (package.id)" per app so two apps that share a name are still
    # distinct choices, and recover the exact package from the selected line
    # rather than matching on the name (which could be ambiguous).
    local list rows choice
    list=$(waydroid app list 2>/dev/null) || true
    rows=$(awk -F': ' '/^Name:/{name=$2} /^packageName:/{printf "%s  (%s)\n", name, $2}' <<<"$list")
    if [[ -z $rows ]]; then
      echo "No Android apps are installed yet."
      echo "Install an APK with: waydroid app install <file.apk>"
      exit 0
    fi
    choice=$(gum choose --header "Which Android app do you want to open?" <<<"$rows") || exit 0
    [[ -z $choice ]] && exit 0
    # The package id is the parenthesized tail of the chosen line.
    package=${choice##*\(}
    package=${package%\)}
  fi

  [[ -n $package ]] || { echo "No app selected." >&2; exit 1; }
  echo "Opening $package ..."
  waydroid app launch "$package"
}

apps_android() {
  require_installed
  ensure_session || exit 1
  echo "Installed Android apps:"
  waydroid app list 2>/dev/null | awk -F': ' '/^Name:/{name=$2} /^packageName:/{printf "  %-28s %s\n", name, $2}'
  echo
  echo "Each app opens in its own window with: omarchy android launch"
}

stop_android() {
  require_installed
  if session_running; then
    echo "Stopping the Android session..."
    waydroid session stop || true
  fi
  if container_active; then
    sudo systemctl stop waydroid-container.service || true
  fi
  echo "Android stopped."
}

status_android() {
  if ! waydroid_installed; then
    echo "Android (Waydroid) is not installed."
    echo "To set it up: omarchy android install"
    exit 0
  fi

  gum style --border normal --padding "1 2" --margin "1" \
    "Container service: $(systemctl is-active waydroid-container.service 2>/dev/null || echo unknown)" \
    "Session:           $(session_running && echo running || echo stopped)" \
    "Multi-window:      $(waydroid prop get persist.waydroid.multi_windows 2>/dev/null || echo unknown)"
}

remove_android() {
  trap 'echo; echo "Removal cancelled."; exit 1' INT

  if ! waydroid_installed; then
    echo "Android (Waydroid) is not installed."
    exit 0
  fi

  local keep_data="false"
  gum confirm --default=false "Also delete all Android data and the downloaded system image?" || keep_data="true"

  echo "Stopping Android..."
  waydroid session stop >/dev/null 2>&1 || true
  sudo systemctl disable --now waydroid-container.service >/dev/null 2>&1 || true

  remove_networking
  rm -f "$LAUNCHER_DESKTOP"
  rm -f "$DESKTOP_DIR"/waydroid.*.desktop

  echo "Removing the Waydroid packages..."
  # Abort before deleting data if the package removal did not actually happen
  # (e.g. another process holds the pacman lock), rather than claiming success.
  if ! omarchy-pkg-drop waydroid; then
    echo "Could not remove the Waydroid package -- another package operation may be running." >&2
    echo "Nothing was deleted. Re-run 'omarchy android remove' once it finishes." >&2
    exit 1
  fi

  if [[ $keep_data == "false" ]]; then
    echo "Deleting Android data and images..."
    sudo rm -rf /var/lib/waydroid "$HOME/.local/share/waydroid" 2>/dev/null || true
  else
    echo "Kept Android data under ~/.local/share/waydroid and /var/lib/waydroid."
  fi

  echo "Android removed."
}

show_usage() {
  echo "Usage: omarchy android [command] [options]"
  echo ""
  echo "Commands:"
  echo "  install              Install Waydroid, choose an image, and wire it into Omarchy"
  echo "  launch [package]     Open an Android app in its own window (picker if no package)"
  echo "  apps                 List installed Android apps"
  echo "  stop                 Stop the running Android session and container"
  echo "  status               Show the current Android status"
  echo "  remove               Remove Waydroid and optionally its data"
  echo "  help                 Show this help message"
  echo ""
  echo "Examples:"
  echo "  omarchy android install              # First-time setup"
  echo "  omarchy android launch               # Pick an app to open"
  echo "  omarchy android launch com.app.id    # Open a specific app"
}

case "${1:-}" in
install)
  install_android
  ;;
launch | start)
  launch_android "${2:-}"
  ;;
apps | list)
  apps_android
  ;;
stop | down)
  stop_android
  ;;
status)
  status_android
  ;;
remove | uninstall)
  remove_android
  ;;
help | --help | -h | "")
  show_usage
  ;;
*)
  echo "Unknown command: $1" >&2
  echo "" >&2
  show_usage >&2
  exit 1
  ;;
esac

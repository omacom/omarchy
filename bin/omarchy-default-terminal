#!/bin/bash

# omarchy:summary=Set the default terminal used by xdg-terminal-exec
# omarchy:args=[alacritty|foot|ghostty|kitty]
# omarchy:examples=omarchy default terminal ghostty | omarchy default terminal kitty

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

executable_present() {
  if [[ $1 == */* ]]; then
    [[ -x $1 ]]
  else
    type -P "$1" >/dev/null 2>&1
  fi
}

# Fast-path reading xdg-terminals.list directly in bash when called without args
# (the menu guard hot path), avoiding xdg-terminal-exec's ~15ms shell scan for
# the common Omarchy-managed config. Falls back to xdg-terminal-exec for
# directives, exclusions, actions, or non-standard entries.
fast_default_terminal() {
  [[ -z ${XTE_EXECARG_COMPAT:-} && -z ${XTE_DEBUG:-} && -z ${XTE_CACHE_ENABLED:-} ]] || return 1

  local list_dir desktop list line first_id="" binary data_dir entry
  local in_entry categories try_exec exec_line exec_bin
  local -a config_dirs data_dirs desktops list_dirs

  IFS=: read -ra config_dirs <<<"${XDG_CONFIG_HOME:-$HOME/.config}:${XDG_CONFIG_DIRS:-/etc/xdg}"
  IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  IFS=: read -ra desktops <<<"${XDG_CURRENT_DESKTOP:-}"

  list_dirs=("${config_dirs[@]}")
  for data_dir in "${data_dirs[@]:1}"; do
    [[ -n $data_dir ]] && list_dirs+=("$data_dir/xdg-terminal-exec")
  done

  for list_dir in "${list_dirs[@]}"; do
    [[ -n $list_dir ]] || continue
    for desktop in "${desktops[@]}" ""; do
      list="$list_dir/${desktop:+${desktop,,}-}xdg-terminals.list"
      [[ -r $list ]] || continue

      while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        line=${line#"${line%%[![:space:]]*}"}
        [[ -z $line || $line == \#* ]] && continue
        if [[ $line == /* ]]; then
          [[ $line == /execarg_default:* ]] || return 1
          continue
        fi
        if [[ -z $first_id ]]; then
          case "$line" in
          Alacritty.desktop) binary="alacritty" ;;
          foot.desktop) binary="foot" ;;
          com.mitchellh.ghostty.desktop) binary="ghostty" ;;
          kitty.desktop) binary="kitty" ;;
          *) return 1 ;;
          esac
          first_id=$line
        elif [[ $line == "-$first_id" ]]; then
          return 1
        fi
      done <"$list"
    done
  done

  [[ -n $first_id ]] || return 1

  for data_dir in "${data_dirs[@]}"; do
    [[ -n $data_dir ]] || continue
    entry="$data_dir/applications/$first_id"
    [[ -r $entry ]] || continue

    in_entry=0
    categories=""
    try_exec=""
    exec_line=""
    while IFS= read -r line || [[ -n $line ]]; do
      line=${line%$'\r'}
      line=${line#"${line%%[![:space:]]*}"}
      if [[ $line =~ ^\[Desktop\ Entry\][[:blank:]]*$ ]]; then
        in_entry=1
      elif [[ $line == "["* ]]; then
        (( in_entry )) && break
      elif (( in_entry )); then
        case "$line" in
        Hidden*=* | OnlyShowIn*=* | NotShowIn*=*) return 1 ;;
        Categories=*) categories=${line#Categories=} ;;
        TryExec=*) try_exec=${line#TryExec=} ;;
        Exec=*) exec_line=${line#Exec=} ;;
        Categories*=* | TryExec*=* | Exec*=*) return 1 ;;
        esac
      fi
    done <"$entry"

    (( in_entry )) && [[ -n $exec_line && ";$categories;" == *";TerminalEmulator;"* ]] || return 1
    if [[ -n $try_exec ]]; then
      [[ $try_exec != *\\* ]] && executable_present "$try_exec" || return 1
    fi
    [[ $exec_line != [\"\'\\]* && $exec_line != *\\* ]] || return 1
    exec_bin=${exec_line%%[[:space:]]*}
    executable_present "$exec_bin" || return 1

    echo "$binary"
    return 0
  done

  return 1
}

if (($# == 0)); then
  if fast_default_terminal; then
    exit 0
  fi
  desktop_id=$(xdg-terminal-exec --print-id 2>/dev/null || true)
  desktop_id=${desktop_id%%:*}
  case "$desktop_id" in
  Alacritty.desktop) echo "alacritty" ;;
  foot.desktop) echo "foot" ;;
  com.mitchellh.ghostty.desktop) echo "ghostty" ;;
  kitty.desktop) echo "kitty" ;;
  *) echo "$desktop_id" ;;
  esac
  exit 0
fi

case "$1" in
alacritty) terminal="alacritty"; desktop_id="Alacritty.desktop"; name="Alacritty"; glyph= ;;
foot) terminal="foot"; desktop_id="foot.desktop"; name="Foot"; glyph= ;;
ghostty) terminal="ghostty"; desktop_id="com.mitchellh.ghostty.desktop"; name="Ghostty"; glyph= ;;
kitty) terminal="kitty"; desktop_id="kitty.desktop"; name="Kitty"; glyph= ;;
*)
  echo "Usage: omarchy-default-terminal <alacritty|foot|ghostty|kitty>"
  exit 1
  ;;
esac

if omarchy-cmd-missing "$terminal"; then
  if [[ $installing == "false" ]]; then
    exec omarchy-launch-floating-terminal-with-presentation omarchy-default-terminal --install "$terminal"
  else
    omarchy-install-terminal "$terminal" || exit 1
  fi
fi

cat >~/.config/xdg-terminals.list <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
EOF

omarchy-notification-send -g $glyph "$(omarchy-i18n default.terminalSet "$name")"

#!/bin/bash

# omarchy:summary=Hibernate the system
# omarchy:group=system

set -uo pipefail

log_hibernate_path() {
  logger --tag omarchy-system-hibernate -- "$*" 2>/dev/null || true
}

# A session lock is still the only authentication after resume on an
# unencrypted install, or on an encrypted install that unlocks automatically.
# Those paths go straight through the ordinary sleep monitor.
if ! omarchy-hibernation-boot-auth; then
  log_hibernate_path "boot-auth=unavailable marker=none action=ordinary-hibernate"
  exec systemctl hibernate
fi

# The user sleep monitor cannot learn the sleep operation from logind's
# PrepareForSleep signal. Hold an advisory lock while this explicit hibernate
# request is in flight so the monitor can distinguish it from suspend without
# leaving stale state behind if either process dies.
runtime_dir=${XDG_RUNTIME_DIR:-}
if [[ -z $runtime_dir || ! -d $runtime_dir ]]; then
  log_hibernate_path "boot-auth=interactive marker=unavailable reason=runtime-dir action=ordinary-hibernate"
  exec systemctl hibernate
fi

marker="$runtime_dir/omarchy-hibernate-boot-auth.lock"
if ! exec {marker_fd}>>"$marker"; then
  log_hibernate_path "boot-auth=interactive marker=unavailable reason=open action=ordinary-hibernate"
  exec systemctl hibernate
fi
if ! flock -n "$marker_fd"; then
  log_hibernate_path "boot-auth=interactive marker=unavailable reason=already-held action=ordinary-hibernate"
  exec systemctl hibernate
fi

# logind answers the hibernate request right after it emits
# PrepareForSleep(true), so `systemctl hibernate` can return while the sleep
# monitor is still checking the marker. Keep holding it until logind emits
# PrepareForSleep(false), after resume or when the hibernate fails. The watch
# starts before the request so that signal cannot slip past.
sleep_events_fd=
sleep_events_pid=
start_sleep_watch() {
  # The watch must not inherit the marker: a lock lives as long as any process
  # holds the open file, so a watch outliving a killed hibernate command would
  # keep the marker held and make the monitor skip the lock for the next suspend.
  coproc SLEEP_EVENTS {
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" \
      {marker_fd}>&-
  }
  sleep_events_fd=${SLEEP_EVENTS[0]:-}
  sleep_events_pid=${SLEEP_EVENTS_PID:-}

  # dbus-monitor prints the bus's NameAcquired greeting only once its match is
  # in place.
  if [[ -n $sleep_events_fd ]]; then
    IFS= read -r -t 2 _ 2>/dev/null <&"$sleep_events_fd" || true
  fi
}

# Returns 0 once logind reports the sleep is over, 1 when there is no working
# watch (it never started or died), 2 when no signal arrived within a minute.
# A frozen process does not run its timeout, so a hibernate that is really
# happening cannot reach 2: that means the machine is awake and nothing is
# being written.
wait_for_sleep_end() {
  local line status
  [[ -n $sleep_events_fd ]] || return 1
  while true; do
    IFS= read -r -t 60 line 2>/dev/null <&"$sleep_events_fd"
    status=$?
    (( status == 0 )) || break
    [[ $line == *"boolean false"* ]] && return 0
  done
  (( status > 128 )) && return 2
  return 1
}

# Seconds the machine has spent asleep since boot: CLOCK_BOOTTIME runs through
# a suspend or hibernation and CLOCK_MONOTONIC stops, so the difference only
# grows across a real sleep. Prints nothing when it cannot be read.
slept_seconds() {
  python3 -c 'import time; print(int(time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()))' 2>/dev/null
}

# Reaching here after PrepareForSleep(false) with no sleep in between means the
# hibernate failed or was cancelled after the session lock had been skipped, and
# nothing authenticated anyone. Lock now. A successful hibernate always spends
# at least the boot and LUKS prompt asleep; if that cannot be shown, locking is
# the safe answer.
lock_unless_slept() {
  local before=$1 after
  after=$(slept_seconds)
  if [[ $before =~ ^[0-9]+$ && $after =~ ^[0-9]+$ ]] && (( after - before >= 5 )); then
    log_hibernate_path "boot-auth=interactive marker=held resumed=true"
    return 0
  fi

  log_hibernate_path "boot-auth=interactive marker=held resumed=false action=lock"
  omarchy-system-lock >/dev/null 2>&1 || true
  # The lid handler also skipped reconciling the displays for this attempt.
  omarchy-hyprland-monitor-clamshell >/dev/null 2>&1 || true
}

cleanup_marker() {
  if [[ -n $sleep_events_pid ]]; then
    kill "$sleep_events_pid" 2>/dev/null || true
    wait "$sleep_events_pid" 2>/dev/null || true
  fi
  flock -u "$marker_fd" 2>/dev/null || true
  rm -f -- "$marker"
}
trap cleanup_marker EXIT INT TERM

start_sleep_watch
slept_before=$(slept_seconds)

log_hibernate_path "boot-auth=interactive marker=held action=hibernate"
systemctl hibernate
status=$?
if (( status == 0 )); then
  wait_for_sleep_end
  case $? in
    0) lock_unless_slept "$slept_before" ;;
    # No watch to learn the outcome from, so it cannot be told from a hibernate
    # still being entered. Locking now would be that late lock.
    1) log_hibernate_path "boot-auth=interactive marker=held sleep=unwatched" ;;
    *) log_hibernate_path "boot-auth=interactive marker=held sleep=unconfirmed"
       lock_unless_slept "$slept_before" ;;
  esac
fi
log_hibernate_path "boot-auth=interactive marker=releasing hibernate-status=$status"
exit "$status"

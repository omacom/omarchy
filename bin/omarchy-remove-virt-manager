#!/bin/bash

# omarchy:summary=Remove QEMU and Virtual Machine Manager.
# omarchy:requires-sudo=true

sudo ufw --force delete allow in on virbr0 to any port 53 proto tcp comment 'omarchy-libvirt-dns' >/dev/null 2>&1 || true
sudo ufw --force delete allow in on virbr0 to any port 53 proto udp comment 'omarchy-libvirt-dns' >/dev/null 2>&1 || true
sudo ufw --force delete allow in on virbr0 to any port 67 proto udp comment 'omarchy-libvirt-dhcp' >/dev/null 2>&1 || true
sudo ufw --force delete route deny in on virbr0 to 10.0.0.0/8 comment 'omarchy-libvirt-private' >/dev/null 2>&1 || true
sudo ufw --force delete route deny in on virbr0 to 172.16.0.0/12 comment 'omarchy-libvirt-private' >/dev/null 2>&1 || true
sudo ufw --force delete route deny in on virbr0 to 192.168.0.0/16 comment 'omarchy-libvirt-private' >/dev/null 2>&1 || true
sudo ufw --force delete route allow in on virbr0 comment 'omarchy-libvirt-forward' >/dev/null 2>&1 || true
sudo ufw reload >/dev/null
if ! omarchy-pkg-drop dnsmasq virt-manager qemu-desktop; then
  echo "Package removal failed"
  exit 1
fi

echo ""
echo "QEMU and Virtual Machine Manager have been removed."

#!/bin/bash

# omarchy:summary=Remove Heroic Games Launcher and its game libraries, configs, and caches.
# omarchy:requires-sudo=true

set -e

while (( $# > 0 )); do
  case "$1" in
  -h | --help | help)
    echo "Usage: omarchy-remove-gaming-heroic"
    echo
    echo "Remove Heroic Games Launcher and its game libraries, configs, and caches."
    exit 0
    ;;
  *)
    echo "omarchy-remove-gaming-heroic: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
  shift
done

omarchy-pkg-drop heroic-games-launcher-bin

rm -rf \
  "$HOME/.config/heroic" \
  "$HOME/.local/share/heroic" \
  "$HOME/.cache/heroic" \
  "$HOME/Games/Heroic"

echo ""
echo "Heroic and its data have been removed."

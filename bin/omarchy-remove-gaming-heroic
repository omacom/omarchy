#!/bin/bash

# omarchy:summary=Remove Heroic Games Launcher and its game libraries, configs, and caches.
# omarchy:requires-sudo=true

set -e

# Under sudo or pkexec $HOME is root's, so clean the invoking user's home
# (same derivation as omarchy-apply-lock).
target_user=${OMARCHY_INSTALL_USER:-${SUDO_USER:-}}
if [[ -z $target_user && -n ${PKEXEC_UID:-} ]]; then
  target_user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
  if [[ -z $target_user ]]; then
    echo "Could not find the user with uid $PKEXEC_UID; nothing was removed." >&2
    exit 1
  fi
fi
target_user=${target_user:-$USER}

if [[ $target_user == "$USER" ]]; then
  target_home=$HOME
else
  target_home=$(getent passwd "$target_user" | cut -d: -f6)
fi

if [[ -z $target_home || $target_home == "/" ]]; then
  echo "Could not find the home directory of $target_user; nothing was removed." >&2
  exit 1
fi

omarchy-pkg-drop heroic-games-launcher-bin

rm -rf \
  "$target_home/.config/heroic" \
  "$target_home/.local/share/heroic" \
  "$target_home/.local/state/Heroic" \
  "$target_home/.cache/heroic" \
  "$target_home/.cache/heroic_gogdl" \
  "$target_home/Games/Heroic"

echo ""
echo "Heroic and its data have been removed."

#!/bin/bash

# omarchy:summary=Install Godot with native Wayland, the GDScript language server, and an editor of your choice
# omarchy:args=[editor]
# omarchy:examples=omarchy install godot | omarchy install godot nvim
# omarchy:requires-sudo=true

set -euo pipefail

godot_quote() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

godot_settings_files() {
  local dir="$HOME/.config/godot"
  local files=()
  local version

  mkdir -p "$dir"

  shopt -s nullglob
  files=("$dir"/editor_settings-4*.tres)
  shopt -u nullglob

  if (( ${#files[@]} > 0 )); then
    printf '%s\n' "${files[@]}"
    return
  fi

  version=$(godot --version 2>/dev/null || true)
  version=${version%%$'\n'*}
  if [[ $version =~ ^([0-9]+)\.([0-9]+) ]]; then
    printf '%s/editor_settings-%s.%s.tres\n' "$dir" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  else
    printf '%s/editor_settings-4.tres\n' "$dir"
  fi
}

godot_set_setting() {
  local file=$1 key=$2 value=$3
  local tmp

  mkdir -p "$(dirname "$file")"
  if [[ ! -f $file ]]; then
    printf '%s\n' '[gd_resource type="EditorSettings" format=3]' '' '[resource]' >"$file"
  fi

  tmp=$(mktemp)
  if grep -q "^${key} =" "$file"; then
    awk -v key="$key" -v value="$value" '
      index($0, key " =") == 1 { print key " = " value; next }
      { print }
    ' "$file" >"$tmp"
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    printf '%s = %s\n' "$key" "$value" >>"$file"
  fi
}

godot_write_desktop() {
  local desktop_dir="$HOME/.local/share/applications"
  local desktop="$desktop_dir/org.godotengine.Godot.desktop"

  mkdir -p "$desktop_dir"
  cat >"$desktop" <<'EOF'
[Desktop Entry]
Name=Godot Engine
GenericName=Libre game engine
Comment=Multi-platform 2D and 3D game engine with a feature-rich editor
Exec=godot --display-driver wayland %f
Icon=godot
Terminal=false
PrefersNonDefaultGPU=true
Type=Application
MimeType=application/x-godot-project;
Categories=Development;IDE;
StartupWMClass=Godot
Keywords=develop;game;engine;godot;
X-Omarchy-Managed=godot
EOF

  update-desktop-database "$desktop_dir" >/dev/null 2>&1 || true
}

godot_write_nvim_lsp() {
  local nvim_lsp="$HOME/.config/nvim/after/plugin/omarchy-godot.lua"

  mkdir -p "$(dirname "$nvim_lsp")"
  if [[ -f $nvim_lsp ]] && ! grep -q 'omarchy-godot-lsp: managed by omarchy-install' "$nvim_lsp"; then
    echo "Left existing Neovim Godot config in place: $nvim_lsp"
    return
  fi

  cat >"$nvim_lsp" <<'EOF'
-- omarchy-godot-lsp: managed by omarchy-install-godot
vim.api.nvim_create_autocmd("FileType", {
  pattern = { "gdscript", "gdshader" },
  group = vim.api.nvim_create_augroup("OmarchyGodotLsp", { clear = true }),
  callback = function(ev)
    local port = tonumber(os.getenv("GDScript_Port") or "6005")
    local cmd = vim.lsp.rpc.connect("127.0.0.1", port)
    if not cmd then
      return
    end
    vim.lsp.start({
      name = "omarchy-godot",
      cmd = cmd,
      root_dir = vim.fs.root(ev.buf, { "project.godot", ".git" }),
    })
  end,
})
EOF
}

godot_merge_json_settings() {
  local settings_file=$1 godot_bin=$2
  local tmp

  mkdir -p "$(dirname "$settings_file")"
  [[ -f $settings_file ]] || printf '{\n}\n' >"$settings_file"

  tmp=$(mktemp)
  if jq --arg godot "$godot_bin" \
    '.["godotTools.editorPath.godot4"] = $godot | .["godotTools.lsp.headless"] = true' \
    "$settings_file" >"$tmp" 2>/dev/null; then
    mv "$tmp" "$settings_file"
  else
    rm -f "$tmp"
  fi
}

godot_wire_gui_editor() {
  local editor_bin=$1
  local godot_bin
  godot_bin=$(type -P godot || printf '%s' godot)

  "$editor_bin" --install-extension geeq1.godot-tools --force >/dev/null 2>&1 ||
    echo "Note: install the Godot Tools extension (geeq1.godot-tools) from the editor marketplace."

  case "${editor_bin##*/}" in
  cursor)
    godot_merge_json_settings "$HOME/.config/Cursor/User/settings.json" "$godot_bin"
    ;;
  *)
    godot_merge_json_settings "$HOME/.config/Code/User/settings.json" "$godot_bin"
    ;;
  esac
}

godot_normalize_editor() {
  case $1 in
  native | godot | builtin | built-in) printf '%s\n' native ;;
  nvim | neovim) printf '%s\n' nvim ;;
  vim) printf '%s\n' vim ;;
  helix | hx) printf '%s\n' helix ;;
  emacs) printf '%s\n' emacs ;;
  code | vscode) printf '%s\n' code ;;
  cursor) printf '%s\n' cursor ;;
  zed | zeditor) printf '%s\n' zed ;;
  sublime_text | sublime) printf '%s\n' sublime_text ;;
  *) return 1 ;;
  esac
}

godot_editor_label() {
  case $1 in
  native) printf '%s\n' 'Godot (built-in)' ;;
  nvim) printf '%s\n' Neovim ;;
  vim) printf '%s\n' Vim ;;
  helix) printf '%s\n' Helix ;;
  emacs) printf '%s\n' Emacs ;;
  code) printf '%s\n' VSCode ;;
  cursor) printf '%s\n' Cursor ;;
  zed) printf '%s\n' Zed ;;
  sublime_text) printf '%s\n' 'Sublime Text' ;;
  *) return 1 ;;
  esac
}

godot_editor_from_label() {
  case $1 in
  'Godot (built-in)') printf '%s\n' native ;;
  Neovim) printf '%s\n' nvim ;;
  Vim) printf '%s\n' vim ;;
  Helix) printf '%s\n' helix ;;
  Emacs) printf '%s\n' emacs ;;
  VSCode) printf '%s\n' code ;;
  Cursor) printf '%s\n' cursor ;;
  Zed) printf '%s\n' zed ;;
  'Sublime Text') printf '%s\n' sublime_text ;;
  *) return 1 ;;
  esac
}

godot_editor_present() {
  case $1 in
  native) return 0 ;;
  nvim) omarchy-cmd-present nvim ;;
  vim) omarchy-cmd-present vim ;;
  helix) omarchy-cmd-present helix || omarchy-cmd-present hx ;;
  emacs) omarchy-cmd-present emacs ;;
  code) omarchy-cmd-present code ;;
  cursor) omarchy-cmd-present cursor ;;
  zed) omarchy-cmd-present zeditor || omarchy-cmd-present zed ;;
  sublime_text) omarchy-cmd-present sublime_text ;;
  *) return 1 ;;
  esac
}

godot_list_editors() {
  local editor
  printf '%s\n' native
  for editor in nvim vim helix emacs code cursor zed sublime_text; do
    if godot_editor_present "$editor"; then
      printf '%s\n' "$editor"
    fi
  done
}

godot_prompt_editor() {
  local labels=() editor label selected status preferred=native default

  while IFS= read -r editor; do
    labels+=("$(godot_editor_label "$editor")")
  done < <(godot_list_editors)

  default=$(omarchy-default-editor)
  default=${default##*/}
  if editor=$(godot_normalize_editor "$default") && godot_editor_present "$editor" && [[ $editor != "native" ]]; then
    preferred=$editor
  fi
  selected=$(godot_editor_label "$preferred")

  label=$(printf '%s\n' "${labels[@]}" | gum choose --header "GDScript editor (esc to cancel)" --selected "$selected") && status=0 || status=$?
  if (( status != 0 )); then
    echo "Cancelled." >&2
    return 1
  fi

  godot_editor_from_label "$label"
}

godot_pick_editor() {
  local requested=${1:-} editor

  if [[ -n $requested ]]; then
    if ! editor=$(godot_normalize_editor "$requested"); then
      echo "Unknown GDScript editor: $requested" >&2
      return 1
    fi
    if ! godot_editor_present "$editor"; then
      echo "GDScript editor '$editor' is not installed." >&2
      return 1
    fi
    printf '%s\n' "$editor"
  elif [[ -t 0 ]]; then
    godot_prompt_editor
  else
    printf '%s\n' native
  fi
}

godot_wire_editor() {
  local editor=$1
  local path flags use_external=true
  local helix_bin

  # Godot is a GUI, so TUI editors must open in a terminal. --inline execs nvim
  # as a headless child of Godot with no window.

  case "$editor" in
  native)
    use_external=false
    ;;
  code)
    path=$(type -P code || printf '%s' code)
    flags='--reuse-window {project} --goto {file}:{line}:{col}'
    godot_wire_gui_editor "$path"
    ;;
  cursor)
    path=$(type -P cursor || printf '%s' cursor)
    flags='--reuse-window {project} --goto {file}:{line}:{col}'
    godot_wire_gui_editor "$path"
    ;;
  zed)
    path=$(type -P zeditor || type -P zed || printf '%s' zeditor)
    flags='{project} {file}:{line}:{col}'
    ;;
  sublime_text)
    path=$(type -P sublime_text || printf '%s' sublime_text)
    flags='{file}:{line}:{col}'
    ;;
  helix)
    path="$OMARCHY_PATH/bin/omarchy-launch-tui"
    if omarchy-cmd-present helix; then
      helix_bin=helix
    else
      helix_bin=hx
    fi
    flags="$helix_bin {file}:{line}:{col}"
    ;;
  emacs)
    path=$(type -P emacs || printf '%s' emacs)
    flags='+{line}:{col} {file}'
    ;;
  vim)
    path="$OMARCHY_PATH/bin/omarchy-launch-tui"
    flags='vim +{line} {file}'
    ;;
  nvim)
    path="$OMARCHY_PATH/bin/omarchy-launch-tui"
    flags='nvim +{line} {file}'
    godot_write_nvim_lsp
    ;;
  *)
    echo "Unknown GDScript editor: $editor" >&2
    return 1
    ;;
  esac

  local file
  while IFS= read -r file; do
    [[ -n $file ]] || continue
    godot_set_setting "$file" "network/language_server/enable" true
    godot_set_setting "$file" "network/language_server/remote_port" 6005
    godot_set_setting "$file" "network/language_server/use_thread" true
    godot_set_setting "$file" "run/platforms/linuxbsd/prefer_wayland" true
    if [[ $use_external == "true" ]]; then
      godot_set_setting "$file" "text_editor/external/use_external_editor" true
      godot_set_setting "$file" "text_editor/external/exec_path" "$(godot_quote "$path")"
      godot_set_setting "$file" "text_editor/external/exec_flags" "$(godot_quote "$flags")"
      godot_set_setting "$file" "text_editor/behavior/files/auto_reload_scripts_on_external_change" true
      godot_set_setting "$file" "interface/editor/save_on_focus_loss" true
    else
      godot_set_setting "$file" "text_editor/external/use_external_editor" false
    fi
  done < <(godot_settings_files)

  if [[ $editor == "native" ]]; then
    echo "Wired GDScript to Godot's built-in editor."
  else
    echo "Wired Godot scripts to $editor."
  fi
}

editor=$(godot_pick_editor "${1:-}")

echo -e "Installing Godot...\n"
omarchy-pkg-add godot
godot_write_desktop
godot_wire_editor "$editor"
echo -e "\nGodot is ready. The GDScript language server listens on port 6005 while the editor is open."

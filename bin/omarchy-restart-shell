#!/bin/bash

# omarchy:summary=Restart the Omarchy shell
# omarchy:examples=omarchy restart shell

# A caller opened after dev link/unlink may disagree with the still-running
# desktop. The user manager receives Hyprland's environment at session start.
session_omarchy_path=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^OMARCHY_PATH=//p' | tail -n 1)
: "${session_omarchy_path:=$OMARCHY_PATH}"

CONFIG_DIR="$session_omarchy_path/shell"
proc_root=${OMARCHY_PROC_ROOT:-/proc}
[[ -f $CONFIG_DIR/shell.qml ]] || { echo "Omarchy shell config not found: $CONFIG_DIR" >&2; exit 1; }

# Allow running from outside the session (e.g. over ssh) by deriving the
# Hyprland instance signature from the newest instance runtime dir.
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hypr_dir=$(find "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)
  [[ -n $hypr_dir ]] && export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}
fi

# Restarting a live lock client would kill the lock screen and strand the
# session behind Hyprland's failsafe. But a LOCK session without an active
# locker — the shell died, or its crash handler re-execed a fresh instance
# that holds no lock — sits in that failsafe with no way to authenticate,
# and a restart plus re-lock is the only way back in without a reboot. So
# ask the lock service rather than merely pinging the shell: only a locker
# that reports the lock secure or in progress is worth preserving.
relock=0
if omarchy-hyprland-session-locked; then
  locking=$(OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell lock status 2>/dev/null |
    jq -r '.secure or .requested' 2>/dev/null)
  if [[ $locking == "true" ]]; then
    echo "Refusing to restart Omarchy shell while the session is locked." >&2
    exit 1
  fi
  relock=1
fi

# The lock plugin loads asynchronously, so a fresh shell answers ping before
# it can lock, and may even refuse early lock requests while its plugins or
# PAM config are still loading. Mirror omarchy-system-sleep-lock: request the
# lock and poll until the session reports secure, re-requesting as needed, so
# recovery never claims success while the failsafe is still up. The deadline
# is generous because slow plugin discovery delays the lock IPC target.
relock_session() {
  local state deadline=$((SECONDS + 30))

  while (( SECONDS < deadline )); do
    state=$(OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell lock status 2>/dev/null |
      jq -r 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' 2>/dev/null)

    case $state in
      secure) return 0 ;;
      locking) ;;
      *) OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell lock lock >/dev/null 2>&1 ;;
    esac

    sleep 0.1
  done

  return 1
}

# A short timeout keeps an unresponsive user bus from stalling the restart;
# busctl would otherwise wait 25 seconds per probe.
notifications_ready() {
  [[ $(busctl --user --timeout=1s call org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus NameHasOwner s org.freedesktop.Notifications 2>/dev/null) == "b true" ]]
}

# Core IPC can answer before the notification plugin has registered its bus
# name. Restore an existing notification service before update hooks or setup
# invitations send their one-time toasts; a disabled service need not appear.
notifications_were_running=0
if notifications_ready; then
  notifications_were_running=1
fi

# Each kill stops the oldest matching instance and only returns once it has
# fully exited. A large bar can take longer than a few seconds to tear down,
# so the client gets time to see that through, and the wait below covers a
# client that timed out anyway: the fresh shell refuses to start next to a
# still-dying instance (-n), which is how a restart used to end with no bar.
#
# Another checkout's shell goes too: a worktree's, left after a visual check.
# omarchy-shell cannot reach it, and until it is gone it keeps the
# notification server and polkit agent from the fresh shell. Only a config
# inside an Omarchy tree counts, so someone's own Quickshell config stays.
omarchy_shell_dirs() {
  local dir

  while IFS= read -r dir; do
    [[ -x ${dir%/shell}/bin/omarchy-launch-shell ]] && printf '%s\n' "$dir"
  done < <(quickshell list -a -j 2>/dev/null |
    jq -r '.[].config_path | select(endswith("/shell/shell.qml")) | rtrimstr("/shell.qml")' 2>/dev/null)
}

while timeout 30 quickshell kill -p "$CONFIG_DIR" --any-display >/dev/null 2>&1; do :; done
while IFS= read -r dir; do
  timeout 30 quickshell kill -p "$dir" --any-display >/dev/null 2>&1
done < <(omarchy_shell_dirs)

deadline=$((SECONDS + 30))
while (( SECONDS < deadline )) && [[ -n $(omarchy_shell_dirs) ]]; do
  sleep 0.1
done

# The waits above are the graceful stop. A wedged shell never answers that IPC
# kill, stays alive, and quickshell -n then refuses with "already running".
# What survives is stopped with signals. The launcher is stood down first: the
# shell's death is not a clean exit, so the supervisor would otherwise take it
# for a crash and start a second shell beside the replacement.
shell_process_state() {
  awk '/^State:/ { print $2; exit }' "$proc_root/$1/status" 2>/dev/null
}

quickshell_pid_alive() {
  local state

  [[ $1 =~ ^[0-9]+$ ]] && (( $1 > 1 )) || return 1
  [[ $(awk '/^Name:/ { print $2; exit }' "$proc_root/$1/status" 2>/dev/null) == "quickshell" ]] || return 1
  state=$(shell_process_state "$1")
  [[ -n $state && $state != "Z" ]]
}

# The parent is the supervisor only when that process is omarchy-launch-shell.
# Any other parent (a terminal, a test, pid 1) is left alone.
launch_shell_pid() {
  local arg

  [[ $1 =~ ^[0-9]+$ ]] && (( $1 > 1 )) || return 1
  [[ -r $proc_root/$1/cmdline ]] || return 1
  while IFS= read -r -d '' arg || [[ -n $arg ]]; do
    [[ ${arg##*/} == "omarchy-launch-shell" ]] && return 0
  done <"$proc_root/$1/cmdline"
  return 1
}

omarchy_shell_config() {
  [[ $1 == "$CONFIG_DIR" || -x ${1%/shell}/bin/omarchy-launch-shell ]]
}

# The registry still lists a crash-relaunched shell that no longer has -p in
# its argv. The process table finds a shell whose instance lock is gone, so
# the registry no longer shows it, but which still occupies this config.
leftover_shell_pids() {
  local line pid dir arg previous

  while IFS= read -r line; do
    pid=${line%% *}
    dir=${line#* }
    [[ $pid == "$dir" ]] && continue
    omarchy_shell_config "$dir" && [[ $pid =~ ^[0-9]+$ ]] && printf '%s\n' "$pid"
  done < <(quickshell list -a -j 2>/dev/null |
    jq -r '.[] | select(.config_path | endswith("/shell/shell.qml")) | "\(.pid) \(.config_path | rtrimstr("/shell.qml"))"' 2>/dev/null)

  for pid in "$proc_root"/[0-9]*; do
    pid=${pid##*/}
    [[ $(awk '/^Name:/ { print $2; exit }' "$proc_root/$pid/status" 2>/dev/null) == "quickshell" ]] || continue
    [[ -r $proc_root/$pid/cmdline ]] || continue
    previous=""
    while IFS= read -r -d '' arg || [[ -n $arg ]]; do
      if [[ $previous == "-p" || $previous == "--path" ]]; then
        omarchy_shell_config "${arg%/}" && printf '%s\n' "$pid"
      fi
      previous=$arg
    done <"$proc_root/$pid/cmdline"
  done
}

process_gone() {
  local state

  [[ -e $proc_root/$1 ]] || return 0
  state=$(shell_process_state "$1")
  [[ -z $state || $state == "Z" ]]
}

stop_wedged_shells() {
  local pid ppid attempt
  local -a shell_pids=() launcher_pids=() alive=()

  mapfile -t shell_pids < <(leftover_shell_pids | sort -un)
  for pid in "${shell_pids[@]}"; do
    quickshell_pid_alive "$pid" || continue
    alive+=("$pid")
    ppid=$(awk '/^PPid:/ { print $2; exit }' "$proc_root/$pid/status" 2>/dev/null || true)
    launch_shell_pid "$ppid" && launcher_pids+=("$ppid")
  done
  shell_pids=("${alive[@]}")
  (( ${#shell_pids[@]} > 0 )) || return 0

  echo "Shell did not answer the IPC kill, stopping it with signals." >&2

  if (( ${#launcher_pids[@]} > 0 )); then
    for pid in "${launcher_pids[@]}"; do
      launch_shell_pid "$pid" && kill -TERM "$pid" 2>/dev/null || true
    done
    # The launcher's trap has to run before the shell dies, or the supervisor
    # reaps a non-zero exit and relaunches.
    sleep 0.1
  fi

  for signal in TERM KILL; do
    alive=()
    for pid in "${shell_pids[@]}"; do
      quickshell_pid_alive "$pid" && alive+=("$pid")
    done
    shell_pids=("${alive[@]}")
    (( ${#shell_pids[@]} > 0 )) || break
    kill -"$signal" "${shell_pids[@]}" 2>/dev/null || true
    for (( attempt = 0; attempt < 20; attempt++ )); do
      alive=()
      for pid in "${shell_pids[@]}"; do
        quickshell_pid_alive "$pid" && alive+=("$pid")
      done
      shell_pids=("${alive[@]}")
      (( ${#shell_pids[@]} > 0 )) || break 2
      sleep 0.1
    done
  done

  for pid in "${launcher_pids[@]}"; do
    for (( attempt = 0; attempt < 20; attempt++ )); do
      process_gone "$pid" && break
      launch_shell_pid "$pid" || break
      if (( attempt == 5 )); then
        kill -KILL "$pid" 2>/dev/null || true
      else
        kill -TERM "$pid" 2>/dev/null || true
      fi
      sleep 0.1
    done
  done

  if (( ${#shell_pids[@]} > 0 )); then
    echo "Omarchy shell did not exit after being signalled." >&2
    return 1
  fi
}

stop_wedged_shells || exit 1

# Spawn from Hyprland so the shell inherits the canonical session environment,
# not transient variables from a terminal, SSH connection, or development tool.
hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null

shell_ready=0
# The shell answers once its plugins have loaded, which on a large bar is
# well past ten seconds, so wait on a deadline rather than a fixed handful
# of attempts.
deadline=$((SECONDS + 60))
while (( SECONDS < deadline )); do
  if OMARCHY_PATH="$session_omarchy_path" OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; then
    shell_ready=1
    break
  fi
  sleep 0.1
done
if (( shell_ready == 0 )); then
  echo "Omarchy shell did not become ready after restart." >&2
  exit 1
fi

# The session stays compositor-locked after the old lock client died, so
# re-acquire the lock and let the user authenticate out of it. This comes
# first and depends on nothing else: a user stranded behind the failsafe must
# not wait on the notification plugin, which may be slow or absent.
if (( relock )) && ! relock_session; then
  echo "Omarchy shell restarted, but the session lock was not re-secured." >&2
  exit 1
fi

# Core IPC answers before the notification plugin has registered its bus
# name, so wait for it separately before one-time toasts are sent.
if (( notifications_were_running )); then
  notifications_restored=0
  for (( attempt = 0; attempt < 20; attempt++ )); do
    if notifications_ready; then
      notifications_restored=1
      break
    fi
    sleep 0.1
  done
  if (( notifications_restored == 0 )); then
    echo "Omarchy shell restarted, but its notification service did not become ready." >&2
    exit 1
  fi
fi

# Invitation toasts (like Voxtype/fingerprint setup) die with the old
# shell, and their notify-send waiters hang forever: the dying server
# never emits NotificationClosed. A still-running omarchy-*-invitation
# unit is therefore an unanswered invitation — re-run it so its toast
# reappears on the new shell. Answered invitations have already exited
# and been collected, so the glob no longer matches them.
systemctl --user try-restart 'omarchy-*-invitation.service' 2>/dev/null || true
exit 0

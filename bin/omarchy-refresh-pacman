#!/bin/bash

# omarchy:summary=Overwrite the package configuration for /etc/pacman with the Omarchy default of using its dedicated mirrors and repositories, then update all packages.
# omarchy:requires-sudo=true

set -euo pipefail
source "$OMARCHY_PATH/install/helpers/pacman.sh"
channel=${1:-stable}
omarchy_pacman_channel_qualified "$channel"
staged=$(mktemp -d)
trap 'sudo rm -rf "$staged"' EXIT
omarchy_pacman_stage "$channel" "$staged"
omarchy_pacman_preflight "$staged" "$channel"

sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
sudo cp -f "$staged/pacman.conf" /etc/pacman.conf
sudo cp -f "$staged/mirrorlist" /etc/pacman.d/mirrorlist

# Allow customization before upgrading. A failed package transaction is not
# rolled back by restoring configuration; retain both backups for recovery.
omarchy-hook pre-refresh-pacman

# Reset all package DBs and then update
omarchy-update-pacman -Syyuu --noconfirm

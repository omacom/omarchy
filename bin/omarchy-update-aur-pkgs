#!/bin/bash

# omarchy:summary=Update AUR packages if any are installed

sudo_options=()
if [[ ${OMARCHY_SUDO_NO_UPDATE:-0} == "1" ]]; then
  sudo_wrapper="$OMARCHY_PATH/default/omarchy/sudo-no-update/sudo"
  [[ -x $sudo_wrapper ]] || exit 1
  sudo_options=(--sudo "$sudo_wrapper" --sudoloop=false)
fi

if pacman -Qem >/dev/null; then
  if omarchy-pkg-aur-accessible; then
    echo -e "\e[32m\nUpdate AUR packages\e[0m"
    # AUR source builds (e.g. libsignal-client) can saturate the CPU for
    # minutes at default priority. Run them at lowered scheduling and I/O
    # priority — costless when the machine is idle — and give cooperating
    # build tools a default job count of half the cores. The count travels
    # through the usual variables (MAKEFLAGS, CARGO_BUILD_JOBS,
    # CMAKE_BUILD_PARALLEL_LEVEL) as a default for tools that honor them;
    # it caps nothing by itself. Override with OMARCHY_AUR_BUILD_JOBS.
    build_jobs="${OMARCHY_AUR_BUILD_JOBS:-}"
    if [[ -z "${build_jobs}" ]]; then
      build_jobs=$(( $(nproc) / 2 ))
      (( build_jobs < 1 )) && build_jobs=1
    fi
    if [[ ! ${build_jobs} =~ ^[1-9][0-9]*$ ]]; then
      build_jobs=1
    fi

    # makepkg sources its configuration after the environment, and a
    # MAKEFLAGS assigned there silently replaces the one passed here, so the
    # environment alone cannot enforce the cap. Hand makepkg a thin config
    # that sources the real configuration files from their own paths — the
    # $MAKEPKG_CONF file (or /etc/makepkg.conf; a makepkgconf saved in yay's
    # own configuration is honored, since yay merges it before the command
    # line and would otherwise be overridden), its drop-ins, then the user
    # file — and appends the selected job count last, where GNU Make reads
    # the final job option as the effective one regardless of spelling
    # (-jN, -j N, --jobs=N, --jobs N) and just before any standalone "--".
    # Files that fail to source still abort makepkg as they would without
    # this config, including unreadable drop-ins.
    makepkg_config=""
    conf="${MAKEPKG_CONF:-/etc/makepkg.conf}"
    saved_conf="$(yay -Pg 2>/dev/null | jq -r '.makepkgconf // empty' 2>/dev/null)"
    [[ -n "${saved_conf}" ]] && conf="${saved_conf}"
    if [[ -r ${conf} ]]; then
      makepkg_config="$(mktemp)"
      trap 'rm -f "$makepkg_config"' EXIT
      {
        printf 'MAKEPKG_CONF=%q\n' "${conf}"
        printf 'source %q || return\n' "${conf}"
        for dropin in "${conf}.d"/*.conf; do
          [[ -e "$dropin" ]] && printf 'source %q || return\n' "$dropin"
        done
        if [[ ${conf} == /etc/makepkg.conf ]]; then
          user_conf="${XDG_CONFIG_HOME:-$HOME/.config}/pacman/makepkg.conf"
          if [[ -r "${user_conf}" ]]; then
            printf 'source %q || return\n' "${user_conf}"
          elif [[ -r "${HOME}/.makepkg.conf" ]]; then
            printf 'source %q || return\n' "${HOME}/.makepkg.conf"
          fi
        fi
        printf 'MAKEPKG_CONF=%q\n' "${makepkg_config}"
        printf 'case " $MAKEFLAGS " in *" -- "*) MAKEFLAGS="${MAKEFLAGS%% -- *}${MAKEFLAGS:+ }-j%s -- ${MAKEFLAGS#* -- }";; *) MAKEFLAGS="${MAKEFLAGS:+${MAKEFLAGS} }-j%s";; esac\n' "${build_jobs}" "${build_jobs}"
      } >"${makepkg_config}"
    fi

    # MAKEFLAGS is deliberately not set here: an exported value would be
    # silently replaced, and the environment cannot beat a makepkg config
    # assignment anyway. The merged config appends the cap to whatever
    # survives into makepkg (exported value, then any config assignment).
    nice -n 15 ionice -c 2 -n 7 \
      env CARGO_BUILD_JOBS="${build_jobs}" \
          CMAKE_BUILD_PARALLEL_LEVEL="${build_jobs}" \
      yay "${sudo_options[@]}" -Sua --noconfirm --cleanafter --ignore gcc14,gcc14-libs \
          ${makepkg_config:+--makepkgconf "${makepkg_config}"} || exit 1
    echo
  else
    echo -e "\e[31m\nAUR is unavailable (so skipping updates)\e[0m"
    echo
  fi
fi
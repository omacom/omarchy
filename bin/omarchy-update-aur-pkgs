#!/bin/bash

# omarchy:summary=Update AUR packages if any are installed

sudo_options=()
if [[ ${OMARCHY_SUDO_NO_UPDATE:-0} == "1" ]]; then
  sudo_wrapper="$OMARCHY_PATH/default/omarchy/sudo-no-update/sudo"
  [[ -x $sudo_wrapper ]] || exit 1
  sudo_options=(--sudo "$sudo_wrapper" --sudoloop=false)
fi

if pacman -Qem >/dev/null; then
  if omarchy-pkg-aur-accessible; then
    echo -e "\e[32m\nUpdate AUR packages\e[0m"
    # AUR source builds (e.g. libsignal-client) can saturate the CPU for
    # minutes at default priority. Run them at lowered scheduling and I/O
    # priority — costless when the machine is idle — and give cooperating
    # build tools a default job count of half the cores. The count travels
    # through the usual variables (MAKEFLAGS, CARGO_BUILD_JOBS,
    # CMAKE_BUILD_PARALLEL_LEVEL) as a default for tools that honor them;
    # it caps nothing by itself. Override with OMARCHY_AUR_BUILD_JOBS.
    build_jobs="${OMARCHY_AUR_BUILD_JOBS:-}"
    if [[ -z "${build_jobs}" ]]; then
      build_jobs=$(( $(nproc) / 2 ))
      (( build_jobs < 1 )) && build_jobs=1
    fi
    nice -n 15 ionice -c 2 -n 7 \
      env CARGO_BUILD_JOBS="${build_jobs}" \
          MAKEFLAGS="-j${build_jobs}" \
          CMAKE_BUILD_PARALLEL_LEVEL="${build_jobs}" \
      yay "${sudo_options[@]}" -Sua --noconfirm --cleanafter --ignore gcc14,gcc14-libs || exit 1
    echo
  else
    echo -e "\e[31m\nAUR is unavailable (so skipping updates)\e[0m"
    echo
  fi
fi
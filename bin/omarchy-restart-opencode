#!/bin/bash

# omarchy:summary=Reload opencode configuration (used by the Omarchy theme switching).

# mise installs the binary as opencode.exe. Only the TUI handles SIGUSR2, so
# leave the background server alone; the signal would terminate it.
for pid in $(pgrep -x 'opencode|opencode\.exe'); do
  if [[ $(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null) != *" serve"* ]]; then
    kill -USR2 "$pid" 2>/dev/null
  fi
done

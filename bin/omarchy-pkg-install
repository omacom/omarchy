#!/bin/bash

# omarchy:summary=Show a fuzzy-finder TUI for picking new Arch and OPR packages to install.
# omarchy:requires-sudo=true

fzf_args=(
  --multi
  --preview 'pacman -Sii {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

# Only an administrator can change the system's packages. Say so before the
# picker rather than after, when sudo would refuse.
if ! omarchy-sudo-allowed; then
  echo "Only an administrator can install software." >&2
  omarchy-show-done 1
else
  pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}")

  if [[ -n $pkg_names ]]; then
    source omarchy-sudo-keepalive

    # Convert newline-separated selections to space-separated for pacman
    echo "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -S --noconfirm
    omarchy-show-done $?
  fi
fi

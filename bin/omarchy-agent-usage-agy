#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only] [--output <path>]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

Data comes from ~/.gemini/antigravity-cli/:
- brain/<conversation-id>/transcript.jsonl: model inference, tokens, and steps
- history.jsonl: timestamped prompt history and active dates
- conversation_summaries.db: SQLite database for session counts
"""

import argparse
import json
import os
import re
import sqlite3
import sys
import tempfile
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "agy"
AGENT_NAME = "Antigravity"
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def empty_record():
    return {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": False,
        "hasLocalStats": False,
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
        "limits": [],
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
    }


def parse_history(history_file, now):
    today_str = now.strftime("%Y-%m-%d")
    active_dates = set()
    total_prompts = 0
    today_prompts = 0

    if os.path.exists(history_file):
        try:
            with open(history_file, encoding="utf-8", errors="replace") as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        item = json.loads(line)
                    except Exception:
                        continue
                    total_prompts += 1
                    ts_ms = item.get("timestamp")
                    if ts_ms:
                        ts_sec = ts_ms / 1000.0
                        dt = datetime.fromtimestamp(ts_sec).astimezone()
                        day_str = dt.strftime("%Y-%m-%d")
                        active_dates.add(day_str)
                        if day_str == today_str:
                            today_prompts += 1
        except Exception:
            pass

    return {
        "totalPrompts": total_prompts,
        "todayPrompts": today_prompts,
        "activeDates": sorted(list(active_dates)),
        "activeDays": len(active_dates),
    }


def parse_sessions(db_file, brain_dir, now):
    today_str = now.strftime("%Y-%m-%d")
    total_sessions = 0
    today_sessions = 0

    if os.path.exists(db_file):
        try:
            conn = sqlite3.connect(f"file:{db_file}?immutable=1", uri=True)
            cur = conn.cursor()
            cur.execute("SELECT last_modified_time FROM conversation_summaries")
            rows = cur.fetchall()
            conn.close()
            for (raw_time,) in rows:
                total_sessions += 1
                if raw_time:
                    try:
                        clean = str(raw_time).strip()
                        if " " in clean and "T" not in clean:
                            clean = clean.replace(" ", "T", 1)
                        clean = re.sub(r"(\.\d{6})\d+", r"\1", clean)
                        dt = datetime.fromisoformat(clean).astimezone()
                        if dt.strftime("%Y-%m-%d") == today_str:
                            today_sessions += 1
                    except Exception:
                        pass
            return total_sessions, today_sessions
        except Exception:
            pass

    if os.path.exists(brain_dir):
        try:
            entries = [
                d
                for d in os.listdir(brain_dir)
                if os.path.isdir(os.path.join(brain_dir, d))
                and not d.startswith(".")
            ]
            total_sessions = len(entries)
            for d in entries:
                p = os.path.join(brain_dir, d)
                mtime = os.path.getmtime(p)
                dt = datetime.fromtimestamp(mtime).astimezone()
                if dt.strftime("%Y-%m-%d") == today_str:
                    today_sessions += 1
        except Exception:
            pass

    return total_sessions, today_sessions


def slugify_model(name):
    clean = name.lower().strip()
    if "flash" in clean:
        return "gemini-3.8-flash"
    elif "pro" in clean:
        return "gemini-3.5-pro"
    elif "sonnet" in clean:
        return "claude-3.7-sonnet"
    slug = re.sub(r"[^a-z0-9.]+", "-", clean).strip("-")
    return slug or "default"


def parse_transcripts(brain_dir, now):
    today_str = now.strftime("%Y-%m-%d")
    recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
    tokens_by_day = {day: 0 for day in recent_dates}
    model_usage = {}
    today_tokens_by_model = {}
    today_total_tokens = 0

    if not os.path.exists(brain_dir):
        return {
            "modelUsage": model_usage,
            "todayTokensByModel": today_tokens_by_model,
            "todayTotalTokens": today_total_tokens,
            "recentDays": [{"date": d, "messageCount": 0} for d in recent_dates],
        }

    for root, dirs, files in os.walk(brain_dir):
        for f in files:
            if f.startswith("transcript") and f.endswith(".jsonl"):
                full_path = os.path.join(root, f)
                session_model = None
                try:
                    with open(full_path, encoding="utf-8", errors="replace") as fh:
                        for line in fh:
                            line = line.strip()
                            if not line:
                                continue
                            try:
                                data = json.loads(line)
                            except Exception:
                                continue

                            content = str(data.get("content", ""))
                            if "Model Selection" in content:
                                match = re.search(
                                    r"Model Selection.*?\sto\s+([^.\n<]+(?:\.[0-9]+[^.\n<]*)?)",
                                    content,
                                )
                                if match:
                                    session_model = slugify_model(match.group(1))

                            step_type = data.get("type")
                            created_at = data.get("created_at", "")

                            step_day = None
                            if created_at:
                                try:
                                    clean_ts = created_at.replace("Z", "+00:00")
                                    clean_ts = re.sub(r"(\.\d{6})\d+", r"\1", clean_ts)
                                    dt = datetime.fromisoformat(clean_ts).astimezone()
                                    step_day = dt.strftime("%Y-%m-%d")
                                except Exception:
                                    step_day = created_at[:10]

                            in_chars = 0
                            out_chars = 0
                            if step_type in ("USER_INPUT", "GENERIC", "SYSTEM_MESSAGE"):
                                in_chars += len(content)
                            elif step_type == "PLANNER_RESPONSE":
                                out_chars += len(str(data.get("thinking", "")))
                                out_chars += len(content)
                                out_chars += len(str(data.get("tool_calls", "")))

                            in_tok = max(1, in_chars // 4) if in_chars else 0
                            out_tok = max(1, out_chars // 4) if out_chars else 0
                            tok_sum = in_tok + out_tok
                            if tok_sum == 0:
                                continue

                            active_model = session_model or "default"
                            bucket = model_usage.setdefault(
                                active_model,
                                {
                                    "inputTokens": 0,
                                    "outputTokens": 0,
                                    "cacheReadInputTokens": 0,
                                    "cacheCreationInputTokens": 0,
                                },
                            )
                            bucket["inputTokens"] += in_tok
                            bucket["outputTokens"] += out_tok

                            if step_day and step_day in tokens_by_day:
                                tokens_by_day[step_day] += tok_sum

                            if step_day == today_str:
                                today_total_tokens += tok_sum
                                today_tokens_by_model[active_model] = (
                                    today_tokens_by_model.get(active_model, 0) + tok_sum
                                )
                except Exception:
                    continue

    recent_days = [{"date": day, "messageCount": tokens_by_day[day]} for day in recent_dates]

    return {
        "modelUsage": model_usage,
        "todayTokensByModel": today_tokens_by_model,
        "todayTotalTokens": today_total_tokens,
        "recentDays": recent_days,
    }


def compute_limits(config_dir):
    limits_file = os.path.join(config_dir, "agy.json")
    if os.path.exists(limits_file):
        try:
            with open(limits_file, encoding="utf-8") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    limits = data.get("limits", [])
                    tier = data.get("tierLabel", "")
                    status = data.get("usageStatusText", "")
                    return limits, tier, status
        except Exception:
            pass

    return [], "", ""


def main():
    parser = argparse.ArgumentParser(description="Antigravity usage collector")
    parser.add_argument("--force", action="store_true", help="Bypass cache and force refresh")
    parser.add_argument("--limits-only", action="store_true", help="Quick limits update")
    parser.add_argument("--output", help="Optional target JSON file path")
    args = parser.parse_args()

    home = str(Path.home())
    antigravity_dir = os.path.join(home, ".gemini/antigravity-cli")
    cache_dir = os.path.join(home, ".cache/omarchy/agent-usage")
    cache_file = os.path.join(cache_dir, f"{AGENT_ID}.json")
    config_dir = os.path.join(home, ".config/omarchy/agents")
    default_target_dir = os.path.join(home, ".local/state/omarchy/agents/usage")
    default_target = os.path.join(default_target_dir, f"{AGENT_ID}.json")
    target_file = args.output or default_target

    now = datetime.now().astimezone()
    now_ts = now.timestamp()

    # Unused check: emit empty record if no directory exists
    if not os.path.exists(antigravity_dir):
        record = empty_record()
        record_json = json.dumps(record, separators=(",", ":"))
        if target_file:
            try:
                os.makedirs(os.path.dirname(target_file), exist_ok=True)
                with tempfile.NamedTemporaryFile("w", dir=os.path.dirname(target_file), delete=False) as tf:
                    tf.write(record_json)
                    temp_target = tf.name
                os.replace(temp_target, target_file)
            except Exception:
                pass
        print(record_json)
        return

    # Check cache
    max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
    cached_record = None
    if max_age > 0 and os.path.exists(cache_file):
        try:
            mtime = os.path.getmtime(cache_file)
            if (now_ts - mtime) < max_age:
                with open(cache_file, encoding="utf-8") as f:
                    cached_record = json.load(f)
        except Exception:
            cached_record = None

    if cached_record:
        cached_record["updatedAt"] = datetime.now(timezone.utc).isoformat()
        record = cached_record
    else:
        history_file = os.path.join(antigravity_dir, "history.jsonl")
        db_file = os.path.join(antigravity_dir, "conversation_summaries.db")
        brain_dir = os.path.join(antigravity_dir, "brain")

        hist_stats = parse_history(history_file, now)
        total_sess, today_sess = parse_sessions(db_file, brain_dir, now)
        trans_stats = parse_transcripts(brain_dir, now)
        limits, tier, usage_status = compute_limits(config_dir)

        if hist_stats["totalPrompts"] == 0 and total_sess == 0 and len(hist_stats["activeDates"]) == 0:
            record = empty_record()
        else:
            record = {
                "schemaVersion": 1,
                "id": AGENT_ID,
                "name": AGENT_NAME,
                "updatedAt": datetime.now(timezone.utc).isoformat(),
                "ready": True,
                "hasLocalStats": True,
                "todayPrompts": hist_stats["todayPrompts"],
                "todaySessions": today_sess,
                "todayTotalTokens": trans_stats["todayTotalTokens"],
                "todayTokensByModel": trans_stats["todayTokensByModel"],
                "recentDays": trans_stats["recentDays"],
                "totalPrompts": hist_stats["totalPrompts"],
                "totalSessions": total_sess,
                "activeDays": hist_stats["activeDays"],
                "activeDates": hist_stats["activeDates"],
                "modelUsage": trans_stats["modelUsage"],
                "limits": limits,
                "tierLabel": tier,
                "usageStatusText": usage_status,
                "authHelpText": "",
            }

        # Write cache
        record_json = json.dumps(record, separators=(",", ":"))
        try:
            os.makedirs(cache_dir, exist_ok=True)
            with tempfile.NamedTemporaryFile("w", dir=cache_dir, delete=False) as tf:
                tf.write(record_json)
                temp_cache = tf.name
            os.replace(temp_cache, cache_file)
        except Exception:
            pass

    record_json = json.dumps(record, separators=(",", ":"))

    # Write target file for both cached and fresh runs
    if target_file:
        try:
            os.makedirs(os.path.dirname(target_file), exist_ok=True)
            with tempfile.NamedTemporaryFile("w", dir=os.path.dirname(target_file), delete=False) as tf:
                tf.write(record_json)
                temp_target = tf.name
            os.replace(temp_target, target_file)
        except Exception:
            pass

    print(record_json)


if __name__ == "__main__":
    main()

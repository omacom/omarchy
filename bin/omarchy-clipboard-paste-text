#!/bin/bash

# omarchy:summary=Copy text to the clipboard and type or paste it
# omarchy:group=clipboard
# omarchy:args=[--shift-insert] [--copy-only] [--window <address>] [--history-index <index>|<text>]
# omarchy:examples=omarchy clipboard paste text "hello" | omarchy clipboard paste text --shift-insert "hello"
# omarchy:hidden=true

use_shift_insert=false
copy_only=false
history_index=""
window=""
text=""

while (( $# > 0 )); do
  case "$1" in
    --shift-insert)
      use_shift_insert=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    --window)
      window="${2:-}"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

copy_history_entry() {
  local history_path="$HOME/.local/state/omarchy/clipboard-history.json"

  [[ $history_index =~ ^[0-9]+$ ]] || exit
  jq -e --argjson index "$history_index" '.[$index].type == "text" and (.[$index].text | type == "string")' "$history_path" >/dev/null || exit
  jq -j --argjson index "$history_index" '.[$index].text' "$history_path" | wl-copy
}

if [[ -n $history_index ]]; then
  copy_history_entry
  if [[ $copy_only != "true" ]]; then
    use_shift_insert=true
  fi
else
  text=${1:-}
  [[ -n $text ]] || exit
  printf '%s' "$text" | wl-copy
fi

if [[ $copy_only == "true" ]]; then
  exit
fi

# The picker is a fullscreen layer holding exclusive keyboard focus, so a
# focus request while it is still up does nothing. Once it closes,
# follow_mouse hands focus to whichever window sits under the (centred)
# cursor — so a mouse-picked entry would paste into the wrong window. Wait
# for the layer to go, then re-focus the recorded origin window and confirm
# it stuck before typing.
focus_origin_window() {
  if [[ -z $window ]]; then
    sleep 0.15
    return
  fi

  [[ $window == 0x* ]] || window="0x$window"

  sleep 0.15
  for _ in {1..15}; do
    [[ $(hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""') == "$window" ]] && return
    hyprctl dispatch focuswindow "address:$window" >/dev/null 2>&1
    sleep 0.04
  done
}

focus_origin_window

if [[ $use_shift_insert == "true" ]]; then
  wtype -M shift -k Insert -m shift 2>/dev/null || true
else
  wtype "$text" 2>/dev/null || true
fi

#!/bin/bash

# omarchy:summary=Copy text to the clipboard and type or paste it
# omarchy:group=clipboard
# omarchy:args=[--shift-insert|--universal] [--copy-only] [--history-index <index>] [<text>] [window-address]
# omarchy:examples=omarchy clipboard paste text "hello" | omarchy clipboard paste text --shift-insert "hello"
# omarchy:hidden=true

use_shift_insert=false
use_universal=false
copy_only=false
history_index=""
text=""
target=""

while (( $# > 0 )); do
  case "$1" in
    --shift-insert)
      use_shift_insert=true
      shift
      ;;
    --universal)
      use_universal=true
      shift
      ;;
    --copy-only)
      copy_only=true
      shift
      ;;
    --history-index)
      if (( $# < 2 )); then
        echo "Usage: omarchy-clipboard-paste-text [--shift-insert|--universal] [--copy-only] [--history-index <index>|<text>]" >&2
        exit 1
      fi
      history_index="$2"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

copy_history_entry() {
  local history_path="$HOME/.local/state/omarchy/clipboard-history.json"
  local entry_json

  [[ $history_index =~ ^[0-9]+$ ]] || exit
  [[ -r $history_path ]] || exit
  entry_json=$(jq -ce --argjson index "$history_index" '
    .[$index] | select(type == "object" and .type == "text" and (.text | type == "string")) | .text
  ' "$history_path" 2>/dev/null) || exit
  jq -rj '.' <<<"$entry_json" | wl-copy
}

focus_window() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$1" >/dev/null 2>&1
}

active_address() {
  hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""'
}

refocus_origin() {
  [[ -n $target ]] || {
    sleep 0.15
    return
  }

  [[ $target == 0x* ]] || target="0x$target"

  # The clipboard overlay is a layer holding exclusive keyboard focus, so a
  # focus request while it is still up does nothing. Once it closes,
  # follow_mouse hands focus to whichever window sits under the (centred)
  # cursor — so a mouse-picked entry lands in the wrong window. Wait for the
  # overlay to go, then re-focus its origin window and confirm it stuck
  # before pasting.
  sleep 0.15
  for _ in {1..15}; do
    [[ $(active_address) == $target ]] && return 0
    focus_window "$target"
    sleep 0.04
  done

  [[ $(active_address) == $target ]]
}

if [[ -n $history_index ]]; then
  copy_history_entry
  target="${1:-}"
  if [[ $copy_only != "true" ]]; then
    use_shift_insert=true
  fi
else
  text=${1:-}
  target="${2:-}"
  [[ -n $text ]] || exit
  printf '%s' "$text" | wl-copy
fi

if [[ $copy_only == "true" ]]; then
  exit
fi

refocus_origin || exit 0

# Universal paste presses SUPER + V's own action: Ctrl+Shift+V in terminals,
# Ctrl+V everywhere else.
if [[ $use_universal == "true" ]]; then
  hyprctl dispatch 'o.universal_paste' >/dev/null 2>&1 || true
elif [[ $use_shift_insert == "true" ]]; then
  wtype -M shift -k Insert -m shift 2>/dev/null || true
else
  wtype -- "$text" 2>/dev/null || true
fi

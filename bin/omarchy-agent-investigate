#!/bin/bash

# omarchy:summary=Hunt down an Omarchy or Hyprland desktop bug
# omarchy:args=[--inline] [--pick]
# omarchy:examples=omarchy agent investigate --inline

set -euo pipefail

options=()
inline=false
while (( $# > 0 )); do
  case "$1" in
    --inline|--pick)
      [[ $1 == "--inline" ]] && inline=true
      options+=("$1")
      shift
      ;;
    *)
      echo "Usage: omarchy agent investigate [--inline] [--pick]" >&2
      exit 1
      ;;
  esac
done

# Crush only accepts a starting prompt in its single-turn `run` command, so it
# cannot wait for the symptom and continue this conversation.
if [[ $(omarchy-default-agent) == "crush" ]]; then
  message="Crush cannot run a back-and-forth investigation. Choose another default agent with: omarchy default agent <name>, then run Hunt Bugs again."
  echo "$message" >&2
  if [[ $inline == "false" ]]; then
    omarchy-notification-send -g 󰚩 "Hunt Bugs needs an interactive agent" "$message" \
      --exec omarchy-menu summon setup.default.agent
  fi
  exit 1
fi

prompt='Use the diagnose-omarchy skill for this session. I want to hunt down an Omarchy or Hyprland desktop bug or unexpected behavior. Start by asking me to describe the symptom, expected behavior, exact reproduction steps, and when it started. Gather relevant non-sensitive diagnostics and inspect local configuration and logs. Determine whether the problem belongs to an application, Hyprland, Omarchy, or local configuration. If a coredump exists, use the diagnose-crash skill; otherwise continue with the non-crash investigation. Do not upload diagnostics, post reports, or make irreversible changes without my review. When the evidence is sufficient, give me a concise diagnosis and a proposed fix, bug report, or pull request plan.'
prompt+=$'\n\nIf your harness cannot discover the skill, read this file directly and follow it:\n'
prompt+="$OMARCHY_PATH/default/agents/skills/diagnose-omarchy/SKILL.md"

exec omarchy-agent "${options[@]}" --prompt "$prompt"

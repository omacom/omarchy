#!/bin/bash

# omarchy:summary=Let a held plugin update again
# omarchy:group=plugin
# omarchy:args=<id>

set -euo pipefail

fail() {
  echo "omarchy-plugin-unhold: $*" >&2
  exit 1
}

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: omarchy plugin unhold <id>"
  exit 0
fi

id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"
[[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $id != *..* ]] || fail "invalid plugin id '$id'"

held_dir="$HOME/.local/state/omarchy/plugins/held"
rm -f "$held_dir/$id"

echo "Unheld $id"

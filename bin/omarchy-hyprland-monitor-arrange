#!/usr/bin/python3

# omarchy:summary=Place another screen left, right, above, or below the laptop
# omarchy:args=[left|right|above|below|status|reapply]
# omarchy:examples=omarchy hyprland monitor arrange left | omarchy hyprland monitor arrange above

"""Place the other enabled screen against the laptop and remember the side.

The Display panel calls this. The choice is written into
~/.config/hypr/monitors.lua and applied to the running session.
"""

import json
import math
import os
import re
import subprocess
import sys
import tempfile

POSITIONS = {
    "left": "auto-left",
    "right": "auto-right",
    "above": "auto-up",
    "below": "auto-down",
}

PHRASES = {
    "left": "to the left of the laptop",
    "right": "to the right of the laptop",
    "above": "above the laptop",
    "below": "below the laptop",
}

POSITION_RE = re.compile(
    r"^(?:auto|auto-(?:center-)?(?:left|right|up|down)|-?\d+x-?\d+)$"
)
BEGIN = "-- arrange:begin\n"
END = "-- arrange:end\n"
FALLBACK_LINE = 'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })'
RULE_RE = re.compile(
    r'hl\.monitor\(\{\n'
    r'  output = "([^"]*)",\n'
    r'  mode = "preferred",\n'
    r'  position = "([^"]*)",\n'
    r'  scale = omarchy_monitor_scale,\n'
    r'\}\)'
)
INTERNAL_RE = re.compile(r"^(eDP|LVDS|DSI)-")
EDGE_TOLERANCE = 48


def fail(message):
    print(f"omarchy-hyprland-monitor-arrange: {message}", file=sys.stderr)
    raise SystemExit(1)


def monitors_lua_path():
    return os.path.expanduser("~/.config/hypr/monitors.lua")


def load_monitors():
    result = subprocess.run(
        ["hyprctl", "monitors", "-j"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "hyprctl monitors failed").strip()
        fail(detail)
    try:
        payload = json.loads(result.stdout)
    except json.JSONDecodeError:
        fail("hyprctl monitors did not return JSON")
    if not isinstance(payload, list):
        fail("monitor list was not a list")
    return payload


def choose(monitors):
    """Return the laptop (anchor) and the screen the command moves."""
    enabled = [monitor for monitor in monitors if not monitor.get("disabled")]
    if len(enabled) < 2:
        return None, None

    internals = [
        monitor for monitor in enabled if INTERNAL_RE.match(str(monitor.get("name") or ""))
    ]
    anchor = internals[0] if internals else None
    if anchor is not None:
        focused = next(
            (
                monitor
                for monitor in enabled
                if monitor.get("focused") and monitor is not anchor
            ),
            None,
        )
        if focused is not None and not INTERNAL_RE.match(str(focused.get("name") or "")):
            target = focused
        else:
            target = next(monitor for monitor in enabled if monitor is not anchor)
        return anchor, target

    focused = next((monitor for monitor in enabled if monitor.get("focused")), None)
    target = focused if focused is not None else enabled[-1]
    anchor = next(monitor for monitor in enabled if monitor is not target)
    return anchor, target


def logical_size(monitor):
    scale = float(monitor.get("scale") or 0)
    width = float(monitor.get("width") or 0)
    height = float(monitor.get("height") or 0)
    if scale <= 0 or width <= 0 or height <= 0:
        return 0.0, 0.0
    # hyprctl width and height are already the oriented pixel size.
    return width / scale, height / scale


def ranges_overlap(start_a, end_a, start_b, end_b):
    return min(end_a, end_b) - max(start_a, start_b) > EDGE_TOLERANCE


def classify(anchor, target):
    anchor_x = float(anchor.get("x") or 0)
    anchor_y = float(anchor.get("y") or 0)
    target_x = float(target.get("x") or 0)
    target_y = float(target.get("y") or 0)
    anchor_w, anchor_h = logical_size(anchor)
    target_w, target_h = logical_size(target)
    anchor_right = anchor_x + anchor_w
    anchor_bottom = anchor_y + anchor_h
    target_right = target_x + target_w
    target_bottom = target_y + target_h

    vertical = ranges_overlap(anchor_y, anchor_bottom, target_y, target_bottom)
    horizontal = ranges_overlap(anchor_x, anchor_right, target_x, target_right)
    if vertical and abs(target_right - anchor_x) <= EDGE_TOLERANCE:
        return "left"
    if vertical and abs(target_x - anchor_right) <= EDGE_TOLERANCE:
        return "right"
    if horizontal and abs(target_bottom - anchor_y) <= EDGE_TOLERANCE:
        return "above"
    if horizontal and abs(target_y - anchor_bottom) <= EDGE_TOLERANCE:
        return "below"
    return ""


def status_payload(monitors):
    anchor, target = choose(monitors)
    if anchor is None or target is None:
        return {"direction": "", "monitor": "", "model": ""}
    return {
        "direction": classify(anchor, target),
        "monitor": str(target.get("name") or ""),
        "model": str(target.get("model") or ""),
    }


def screen_label(payload):
    model = payload.get("model") or ""
    if model and not model.startswith("0x"):
        return model
    return payload.get("monitor") or "The other screen"


def human_status(payload):
    direction = payload.get("direction") or ""
    if not payload.get("monitor"):
        return "One screen is connected."
    if direction not in PHRASES:
        return f"{screen_label(payload)} is connected."
    return f"{screen_label(payload)} is {PHRASES[direction]}."


def output_token(monitor):
    description = str(monitor.get("description") or "")
    if description and not re.search(r'["\\\n\r]', description):
        return "desc:" + description
    name = str(monitor.get("name") or "")
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        fail("refusing monitor name")
    return name


def format_scale(value):
    number = float(value)
    if not math.isfinite(number) or number <= 0 or number > 10:
        fail("refusing scale")
    text = f"{number:.6f}".rstrip("0").rstrip(".")
    if not re.fullmatch(r"[0-9]+(\.[0-9]+)?", text):
        fail("refusing scale")
    return text


def rule_block(output, position):
    if re.search(r'["\\\n\r]', output) or not POSITION_RE.fullmatch(position):
        fail("refusing monitor rule")
    return (
        "hl.monitor({\n"
        f'  output = "{output}",\n'
        '  mode = "preferred",\n'
        f'  position = "{position}",\n'
        "  scale = omarchy_monitor_scale,\n"
        "})\n"
    )


def arrange_block(output, position):
    return f"{BEGIN}{rule_block(output, position)}{END}"


def replace_block(text, output, position):
    if BEGIN not in text or END not in text:
        fail("monitors.lua is missing the arrange markers")
    block = arrange_block(output, position)
    pre, rest = text.split(BEGIN, 1)
    _old, post = rest.split(END, 1)
    return pre + block + post


def insert_rules(text, anchor_output, target_output, position):
    """Add the laptop origin and the arrange block above the fallback rule."""
    if FALLBACK_LINE not in text:
        fail("monitors.lua has no fallback monitor rule to update")
    addition = ""
    if f'output = "{anchor_output}"' not in text:
        addition += rule_block(anchor_output, "0x0") + "\n"
    addition += arrange_block(target_output, position)
    return text.replace(FALLBACK_LINE, addition + FALLBACK_LINE, 1)


def write_arrangement(anchor, target, position):
    path = monitors_lua_path()
    try:
        with open(path, encoding="utf-8") as handle:
            original = handle.read()
    except OSError as error:
        fail(f"could not read {path}: {error.strerror}")

    target_output = output_token(target)
    anchor_output = output_token(anchor)
    if BEGIN in original and END in original:
        updated = replace_block(original, target_output, position)
    else:
        updated = insert_rules(original, anchor_output, target_output, position)

    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".monitors.lua.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(updated)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
    except Exception:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    return updated


def eval_rules(rules):
    lines = []
    for name, position, scale in rules:
        if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
            fail("refusing monitor name")
        if not POSITION_RE.fullmatch(position):
            fail("refusing position")
        scale_text = format_scale(scale)
        lines.append(
            'hl.monitor({ output = "%s", mode = "preferred", position = "%s", scale = %s })'
            % (name, position, scale_text)
        )
    if not lines:
        return
    result = subprocess.run(
        ["hyprctl", "eval", "\n".join(lines)],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "hyprctl eval failed").strip()
        fail(detail)


def rules_in_file(text):
    rules = []
    for output, position in RULE_RE.findall(text):
        if output == "" or not POSITION_RE.fullmatch(position):
            continue
        rules.append((output, position))
    return rules


def resolve_monitor(monitors, output):
    if output.startswith("desc:"):
        description = output[5:]
        for monitor in monitors:
            if monitor.get("description") == description and not monitor.get("disabled"):
                return monitor
        return None
    for monitor in monitors:
        if monitor.get("name") == output and not monitor.get("disabled"):
            return monitor
    return None


def reapply():
    path = monitors_lua_path()
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        return
    monitors = load_monitors()
    live = []
    for output, position in rules_in_file(text):
        monitor = resolve_monitor(monitors, output)
        if monitor is None:
            continue
        live.append((str(monitor["name"]), position, monitor.get("scale")))
    if live:
        eval_rules(live)


def apply_direction(direction):
    position = POSITIONS[direction]
    monitors = load_monitors()
    anchor, target = choose(monitors)
    if anchor is None or target is None:
        fail("need two enabled displays")
    write_arrangement(anchor, target, position)
    eval_rules([(str(target["name"]), position, target.get("scale"))])


def apply_scale(scale):
    if not re.fullmatch(r"[0-9]+(\.[0-9]+)?", scale):
        fail("refusing scale")
    number = float(scale)
    if number < 1 or number > 4:
        fail("refusing scale")
    # The scaler parks the focused screen on position auto. Put the saved
    # side back afterwards.
    subprocess.run(["omarchy-hyprland-monitor-scaling", scale], check=True)
    reapply()


def emit_status():
    print(json.dumps(status_payload(load_monitors()), separators=(",", ":")))


def emit_human():
    print(human_status(status_payload(load_monitors())))


def main(argv):
    command = argv[1] if len(argv) > 1 else ""
    if command in ("-h", "--help"):
        print(
            "Usage: omarchy-hyprland-monitor-arrange [left|right|above|below|status|reapply]"
        )
        return
    if command == "":
        emit_human()
        return
    if command == "status":
        emit_status()
        return
    if command == "reapply":
        reapply()
        emit_human()
        return
    if command == "scale":
        if len(argv) != 3:
            fail("usage: omarchy-hyprland-monitor-arrange scale <n>")
        apply_scale(argv[2])
        emit_human()
        return
    if command in POSITIONS:
        apply_direction(command)
        emit_human()
        return
    fail("usage: omarchy-hyprland-monitor-arrange [left|right|above|below|status|reapply]")


if __name__ == "__main__":
    main(sys.argv)

#!/bin/bash

# omarchy:summary=Clear the shell update indicator after an update
# omarchy:hidden=true

# omarchy-update now clears the indicator itself. This stays for an update
# started by an older omarchy-update: its pipeline was parsed before the
# upgrade replaced it, and still calls this right after a full upgrade that
# went through, so there is nothing left for the indicator to show.
omarchy-shell -q omarchy.system-update clear

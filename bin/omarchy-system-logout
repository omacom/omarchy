#!/bin/bash

# omarchy:summary=Log out after closing application windows
# omarchy:examples=omarchy logout | omarchy system logout
# omarchy:aliases=omarchy logout

# Runs from the user manager for the same reasons as omarchy-system-reboot.
systemd-run --user --collect --quiet --unit=omarchy-system-exit "$OMARCHY_PATH/bin/omarchy-system-exit" logout

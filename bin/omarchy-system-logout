#!/bin/bash

# omarchy:summary=Log out after closing application windows
# omarchy:examples=omarchy logout | omarchy system logout
# omarchy:aliases=omarchy logout

# Schedule the logout in the user manager so closing the terminal's systemd
# scope cannot terminate it before it runs. nohup only survives SIGHUP; it
# does not survive the invoking scope being reaped.
systemd-run --user --collect --quiet --on-active="2s" --timer-property=AccuracySec=100ms uwsm stop || exit 1

omarchy-osd -i logout -m "Logging out" -d 5000

# Now close all windows
omarchy-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly

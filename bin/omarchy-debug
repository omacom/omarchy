#!/bin/bash

# omarchy:summary=Print debugging information
# omarchy:args=[--no-sudo] [--print]
# omarchy:examples=omarchy debug --print --no-sudo
# omarchy:requires-sudo=true

NO_SUDO=false
PRINT_ONLY=false

while (( $# > 0 )); do
  case "$1" in
    --no-sudo)
      NO_SUDO=true
      shift
      ;;
    --print)
      PRINT_ONLY=true
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: omarchy-debug [--no-sudo] [--print]"
      exit 1
      ;;
  esac
done

amd_gpu_read() {
  local value

  if IFS= read -r value 2>/dev/null < "$1" && [[ -n $value ]]; then
    printf '%s\n' "$value"
  else
    echo "unavailable"
  fi
}

amd_gpu_counter() {
  local value
  value=$(amd_gpu_read "$2")

  if [[ $value =~ ^[0-9]+$ ]]; then
    printf '  %s: %s%s\n' "$1" "$value" "$3"
  else
    printf '  %s: unavailable\n' "$1"
  fi
}

amd_gpu_diagnostics() {
  local pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"
  local device vendor class device_id driver runtime_state found=0

  if [[ ! -d $pci_devices_path || ! -r $pci_devices_path || ! -x $pci_devices_path ]]; then
    echo "PCI device information unavailable."
    return
  fi

  # Cached PCI IDs identify display controllers without loading a driver or
  # reading PCI config space. Include non-VGA Display controllers (038000).
  for device in "$pci_devices_path"/*; do
    vendor=$(amd_gpu_read "$device/vendor")
    [[ $vendor == "0x1002" ]] || continue
    class=$(amd_gpu_read "$device/class")
    [[ $class == 0x03* ]] || continue
    found=1

    device_id=$(amd_gpu_read "$device/device")
    if driver=$(readlink -- "$device/driver" 2>/dev/null); then
      driver=${driver##*/}
    else
      driver="unbound or unavailable"
    fi
    runtime_state=$(amd_gpu_read "$device/power/runtime_status")

    printf 'PCI address: %s\n' "${device##*/}"
    printf '  PCI ID: %s:%s\n' "${vendor#0x}" "${device_id#0x}"
    printf '  PCI class: %s\n' "${class#0x}"
    printf '  Driver: %s\n' "$driver"
    printf '  Runtime state: %s\n' "$runtime_state"

    if [[ $driver != "amdgpu" ]]; then
      printf '  AMDGPU counters: unavailable for this driver.\n\n'
    elif [[ $runtime_state != "active" && $runtime_state != "unsupported" ]]; then
      # Missing/transitional PM state is not proof that a device is awake.
      printf '  Live counters: skipped (device is not known to be active).\n\n'
    else
      amd_gpu_counter "GPU busy" "$device/gpu_busy_percent" "%"
      amd_gpu_counter "Driver VRAM total" "$device/mem_info_vram_total" " bytes"
      amd_gpu_counter "Driver VRAM used" "$device/mem_info_vram_used" " bytes"
      amd_gpu_counter "GTT total" "$device/mem_info_gtt_total" " bytes"
      amd_gpu_counter "GTT used" "$device/mem_info_gtt_used" " bytes"
      echo
    fi
  done

  if (( found == 0 )); then
    echo "No AMD display controllers detected."
  else
    echo "VRAM/GTT are driver pools, not an additive breakdown of system RAM."
  fi
}

LOG_FILE="/tmp/omarchy-debug.log"

if [[ $NO_SUDO = "true" ]]; then
  DMESG_OUTPUT="(skipped - --no-sudo flag used)"
else
  DMESG_OUTPUT="$(sudo dmesg)"
fi

cat > "$LOG_FILE" <<EOF
Date: $(date)
Hostname: $(hostname)
Omarchy Package: $(pacman -Q omarchy-dev 2>/dev/null || pacman -Q omarchy 2>/dev/null || echo "unknown")

=========================================
AMD GPU
=========================================
$(amd_gpu_diagnostics)

=========================================
SYSTEM INFORMATION
=========================================
$(inxi -Farz)

=========================================
DMESG
=========================================
$DMESG_OUTPUT

=========================================
JOURNALCTL (CURRENT BOOT, WARNINGS+ERRORS)
=========================================
$(journalctl -b -p 4..1)

=========================================
INSTALLED PACKAGES
=========================================
$({ expac -S '%n %v (%r)' $(pacman -Qqe) 2>/dev/null; comm -13 <(pacman -Sql | sort) <(pacman -Qqe | sort) | xargs -r expac -Q '%n %v (AUR)'; } | sort)
EOF

if [[ $PRINT_ONLY = "true" ]]; then
  cat "$LOG_FILE"
  exit 0
fi

OPTIONS=("View log" "Save in current directory")
if ping -c 1 8.8.8.8 >/dev/null 2>&1; then
  OPTIONS=("Upload log" "${OPTIONS[@]}")
fi

ACTION=$(gum choose "${OPTIONS[@]}")

case "$ACTION" in
  "Upload log")
    echo "Uploading debug log to logs.omarchy.org..."
    URL=$(curl -sf -F "file=@$LOG_FILE" -Fexpires=24 https://logs.omarchy.org/)
    if (( $? == 0 )) && [[ -n $URL ]]; then
      echo "✓ Log uploaded successfully!"
      echo "Share this URL:"
      echo ""
      echo "  $URL"
    else
      echo "Error: Failed to upload log file"
      exit 1
    fi
    ;;
  "View log")
    less "$LOG_FILE"
    ;;
  "Save in current directory")
    cp "$LOG_FILE" "./omarchy-debug.log"
    echo "✓ Log saved to $(pwd)/omarchy-debug.log"
    ;;
esac

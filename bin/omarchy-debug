#!/bin/bash

# omarchy:summary=Print debugging information
# omarchy:args=[--no-sudo] [--print]
# omarchy:examples=omarchy-debug --print --no-sudo
# omarchy:requires-sudo=true

NO_SUDO=false
PRINT_ONLY=false

while (( $# > 0 )); do
  case "$1" in
    --no-sudo)
      NO_SUDO=true
      shift
      ;;
    --print)
      PRINT_ONLY=true
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: omarchy-debug [--no-sudo] [--print]"
      exit 1
      ;;
  esac
done

LOG_FILE=$(mktemp /tmp/omarchy-debug.XXXXXX.log)
UEVENT_FILE=$(mktemp /tmp/omarchy-debug-uevents.XXXXXX)
trap 'rm -f "$LOG_FILE" "$UEVENT_FILE"' EXIT

if [[ $NO_SUDO = "true" ]]; then
  DMESG_OUTPUT="(skipped - --no-sudo flag used)"
else
  DMESG_OUTPUT="$(sudo dmesg)"
fi

if omarchy-cmd-present udevadm && omarchy-cmd-present timeout; then
  timeout 2 udevadm monitor --kernel --subsystem-match=power_supply > "$UEVENT_FILE" 2>/dev/null
  UEVENT_COUNT=$(grep -c '^KERNEL\[' "$UEVENT_FILE")
  BATTERY_UEVENTS="Battery uevents in 2s: $UEVENT_COUNT (normal 0 to a few, hundreds means a uevent loop)"
else
  BATTERY_UEVENTS="Battery uevents: not measured"
fi

rm -f "$UEVENT_FILE"

cat > "$LOG_FILE" <<EOF
Date: $(date)
Hostname: $(hostname)
Omarchy Package: $(pacman -Q omarchy-dev 2>/dev/null || pacman -Q omarchy 2>/dev/null || echo "unknown")

=========================================
SYSTEM INFORMATION
=========================================
$(inxi -Farz)

=========================================
SLEEP & BATTERY
=========================================
Sleep mode: $(cat /sys/power/mem_sleep 2>/dev/null || echo "unknown")
$(omarchy-battery-status --shell 2>/dev/null || true)
$(if [[ -r /var/lib/omarchy/sleep-history.tsv ]]; then echo "Recent sleeps (ts mode dur_s ac delta_pct delta_wh pct_hr w s0ix):"; tail -n 10 /var/lib/omarchy/sleep-history.tsv; fi)
$BATTERY_UEVENTS
Charge-limit udev rules:
$(grep -rn 'ATTR{charge_control' /etc/udev/rules.d /usr/lib/udev/rules.d 2>/dev/null || echo "none")

=========================================
DMESG
=========================================
$DMESG_OUTPUT

=========================================
JOURNALCTL (CURRENT BOOT, WARNINGS+ERRORS)
=========================================
$(journalctl -b -p 4..1)

=========================================
INSTALLED PACKAGES
=========================================
$({ expac -S '%n %v (%r)' $(pacman -Qqe) 2>/dev/null; comm -13 <(pacman -Sql | sort) <(pacman -Qqe | sort) | xargs -r expac -Q '%n %v (AUR)'; } | sort)
EOF

if publish=$(mktemp /tmp/omarchy-debug.XXXXXX.log 2>/dev/null); then
  cp "$LOG_FILE" "$publish" 2>/dev/null && mv -fT "$publish" /tmp/omarchy-debug.log 2>/dev/null || rm -f "$publish"
fi

if [[ $PRINT_ONLY = "true" ]]; then
  cat "$LOG_FILE"
  exit 0
fi

OPTIONS=("View log" "Save in current directory")
if ping -c 1 8.8.8.8 >/dev/null 2>&1; then
  OPTIONS=("Upload log" "${OPTIONS[@]}")
fi

ACTION=$(gum choose "${OPTIONS[@]}")

case "$ACTION" in
  "Upload log")
    echo "Uploading debug log to logs.omarchy.org..."
    URL=$(curl -sf -F "file=@$LOG_FILE" -Fexpires=24 https://logs.omarchy.org/)
    if (( $? == 0 )) && [[ -n $URL ]]; then
      echo "✓ Log uploaded successfully!"
      echo "Share this URL:"
      echo ""
      echo "  $URL"
    else
      echo "Error: Failed to upload log file"
      exit 1
    fi
    ;;
  "View log")
    less "$LOG_FILE"
    ;;
  "Save in current directory")
    cp "$LOG_FILE" "./omarchy-debug.log"
    echo "✓ Log saved to $(pwd)/omarchy-debug.log"
    ;;
esac

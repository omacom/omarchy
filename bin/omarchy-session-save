#!/bin/bash

# omarchy:summary=Save open windows so the next login reopens them
# omarchy:args=[--always]

# omarchy-system runs this before it closes windows to log out, reboot or shut
# down; it saves only with the reopen-windows toggle on. --always saves anyway,
# for a one-off "reboot and reopen". omarchy-session-restore reads it at login.

if [[ ${1:-} != "--always" ]] && ! omarchy-toggle-enabled reopen-windows; then
  exit 0
fi

state_dir="$HOME/.local/state/omarchy/session"
clients=$(hyprctl clients -j) || exit 1
monitors=$(hyprctl monitors -j) || exit 1

windows=$(jq -c '[
  .[]
  | select(.pid > 0 and .class != "" and (.workspace.name | startswith("special") | not))
  | {address, class, title, pid, workspace: (.workspace.name | tostring)}
]' <<<"$clients")

# The .desktop Exec for a window class, without field codes like %U.
desktop_exec() {
  local class=$1 file="" dir

  for dir in "$HOME/.local/share/applications" /usr/share/applications; do
    if [[ -f "$dir/$class.desktop" ]]; then
      file="$dir/$class.desktop"
      break
    fi
  done
  [[ -z $file ]] && file=$(grep -lsx "StartupWMClass=$class" "$HOME"/.local/share/applications/*.desktop /usr/share/applications/*.desktop | head -n1)
  [[ -n $file ]] && desktop_exec_command "$(sed -n 's/^Exec=//p' "$file" | head -n1)"
}

# A desktop entry's Exec value as a shell command, decoded per the Desktop
# Entry Spec: string escapes (\s \n \t \r \\) first, then the Exec quoting
# (double quotes, inside which \ escapes " ` $ \), then field codes: %% is a
# literal %, and %f %U and the like are dropped. omarchy-webapp-install writes
# a % in a web app's URL as %%, so copying the text as is would change the URL.
desktop_exec_command() {
  local raw=$1 value="" arg="" c i quoted=0 started=0
  local -a args=() argv=()

  for (( i = 0; i < ${#raw}; i++ )); do
    c=${raw:i:1}
    if [[ $c == "\\" ]] && (( i + 1 < ${#raw} )); then
      (( i++ ))
      case ${raw:i:1} in
        s) c=" " ;;
        n) c=$'\n' ;;
        t) c=$'\t' ;;
        r) c=$'\r' ;;
        "\\") c="\\" ;;
        *) c="\\${raw:i:1}" ;;
      esac
    fi
    value+=$c
  done

  for (( i = 0; i < ${#value}; i++ )); do
    c=${value:i:1}
    if (( quoted )); then
      if [[ $c == "\\" && ${value:i+1:1} == [\"\`\$\\] ]]; then
        (( i++ ))
        arg+=${value:i:1}
      elif [[ $c == '"' ]]; then
        quoted=0
      else
        arg+=$c
      fi
    elif [[ $c == '"' ]]; then
      quoted=1 started=1
    elif [[ $c == [[:blank:]] ]]; then
      (( started )) && args+=("$arg")
      arg="" started=0
    else
      arg+=$c started=1
    fi
  done
  (( started )) && args+=("$arg")

  for arg in "${args[@]}"; do
    [[ $arg =~ ^%[fFuUdDnNickvm]$ ]] && continue
    value=""
    for (( i = 0; i < ${#arg}; i++ )); do
      c=${arg:i:1}
      if [[ $c == "%" ]]; then
        (( i++ ))
        [[ ${arg:i:1} == "%" ]] && value+="%"
      else
        value+=$c
      fi
    done
    argv+=("$value")
  done

  (( ${#argv[@]} > 0 )) && printf '%q ' "${argv[@]}" | sed 's/ $//'
}

# Fallback when no .desktop launcher is found. A Chromium web app's class
# names its URL: brave-x.com__stevederico-Default is https://x.com/stevederico,
# with each / in the path written as _. The class drops ports, extra flags,
# and the browser profile, so prefer desktop_exec first.
webapp_launch() {
  if [[ $1 =~ ^(brave|chrome|chromium|google-chrome|microsoft-edge|vivaldi|helium|opera)-([^_]+)__(.*)-[^-]+$ ]]; then
    echo "omarchy-launch-webapp $(printf '%q' "https://${BASH_REMATCH[2]}/${BASH_REMATCH[3]//_//}")"
  fi
}

# Interactive shells a terminal runs: session leaders on a tty, as in
# omarchy-cmd-terminal-cwd. One per terminal window, tab or split.
terminal_shells() {
  local pid=$1 children_file child stat session tty_nr

  for children_file in /proc/"$pid"/task/*/children; do
    [[ -r $children_file ]] || continue
    read -ra children <"$children_file" || true
    for child in "${children[@]}"; do
      read -r stat 2>/dev/null <"/proc/$child/stat" || continue
      read -r _ _ _ session tty_nr _ <<<"${stat##*) }"
      if (( session == child && tty_nr != 0 )) && grep -Fqsx "$(readlink -f "/proc/$child/exe")" /etc/shells; then
        echo "$child"
      fi
    done
  done | sort -n
}

descendants() {
  local children_file child

  for children_file in /proc/"$1"/task/*/children; do
    [[ -r $children_file ]] || continue
    read -ra children <"$children_file" || true
    for child in "${children[@]}"; do
      echo "$child"
      descendants "$child"
    done
  done
}

# The command that resumes the coding agent session a process runs, if any.
# Claude Code records its session per pid; Grok keeps its session folder open.
# An added account runs with its own home (CLAUDE_CONFIG_DIR / GROK_HOME),
# which the resume command carries too.
agent_resume() {
  local pid=$1 home_env default_home home account="" id fd

  case $(cat "/proc/$pid/comm" 2>/dev/null) in
    claude) home_env=CLAUDE_CONFIG_DIR default_home=$HOME/.claude ;;
    grok) home_env=GROK_HOME default_home=$HOME/.grok ;;
    *) return ;;
  esac

  home=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n "s/^$home_env=//p" | tail -n1)
  if [[ -n $home ]]; then
    account="$home_env=$(printf '%q' "$home") "
  else
    home=$default_home
  fi

  case $home_env in
    CLAUDE_CONFIG_DIR)
      id=$(jq -r '.sessionId // empty' "$home/sessions/$pid.json" 2>/dev/null)
      [[ -n $id ]] && echo "${account}claude --resume $id"
      ;;
    GROK_HOME)
      for fd in /proc/"$pid"/fd/*; do
        if [[ $(readlink "$fd" 2>/dev/null) =~ ^"$home"/sessions/[^/]+/([0-9a-f-]{36}) ]]; then
          echo "${account}grok --resume ${BASH_REMATCH[1]}"
          return
        fi
      done
      ;;
  esac
}

# The agent resume command for the first agent running under a shell.
shell_agent_resume() {
  local pid resume

  for pid in $(descendants "$1"); do
    resume=$(agent_resume "$pid")
    if [[ -n $resume ]]; then
      echo "$resume"
      return
    fi
  done
}

launches=()
terminal_pids=()
while read -r pid; do
  pid_windows=$(jq -c --argjson pid "$pid" '[.[] | select(.pid == $pid)]' <<<"$windows")
  mapfile -t shells < <(terminal_shells "$pid")

  if (( ${#shells[@]} > 0 )); then
    terminal_pids+=("$pid")
    # A terminal: reopen one window per shell in the same folder. A process
    # that owns several windows (Ghostty) does not say which window holds which
    # shell, so a window whose title shows a shell's folder takes that shell
    # first. Only shells left over are paired in order, and extra tabs join the
    # last window's workspace.
    shell_info=$(for shell in "${shells[@]}"; do
      dir=$(readlink -f "/proc/$shell/cwd" 2>/dev/null)
      [[ -d $dir ]] || dir=$HOME
      jq -nc --arg dir "$dir" --arg resume "$(shell_agent_resume "$shell")" '{dir: $dir, resume: $resume}'
    done | jq -sc .)

    while read -r shell; do
      dir=$(jq -r '.dir' <<<"$shell")
      resume=$(jq -r '.resume' <<<"$shell")
      command="xdg-terminal-exec --dir=$(printf '%q' "$dir")"
      # An agent session resumes inside the shell, so the terminal stays
      # open on a prompt when the agent exits.
      [[ -n $resume ]] && command+=" -- $(printf '%q' "$SHELL") -ic $(printf '%q' "$resume; exec $SHELL")"
      launches+=("$(jq -nc --arg workspace "$(jq -r '.workspace' <<<"$shell")" --arg command "$command" \
        '{workspace: $workspace, command: $command, class: null}')")
    done < <(jq -c --arg home "$HOME" --argjson shells "$shell_info" '
      def tilde: if startswith($home) then "~" + .[($home | length):] else . end;
      def shows($title): (.dir | tilde) == $title or (.dir | split("/") | last) == $title;
      . as $windows
      | if ($windows | map(.workspace) | unique | length) == 1 then
          $shells | map(. + {workspace: $windows[0].workspace})
        else
          reduce range(0; $windows | length) as $w ({left: [range(0; $shells | length)], free: [], out: []};
            $windows[$w].title as $title
            | ([.left[] | select($shells[.] | shows($title))] | first) as $s
            | if $s == null then .free += [$w]
              else .left -= [$s] | .out += [$shells[$s] + {workspace: $windows[$w].workspace}] end)
          | . as $pairs
          | reduce range(0; $pairs.left | length) as $k ($pairs.out;
              . + [$shells[$pairs.left[$k]] + {workspace: $windows[$pairs.free[$k] // $pairs.free[-1] // ($windows | length - 1)].workspace}])
        end
      | .[]' <<<"$pid_windows")
  else
    # One launch per class: a browser's web app windows share its process.
    while read -r class; do
      workspace=$(jq -r --arg class "$class" 'first(.[] | select(.class == $class)) | .workspace' <<<"$pid_windows")
      command=$(desktop_exec "$class")
      [[ -z $command ]] && command=$(webapp_launch "$class")
      if [[ -z $command ]]; then
        mapfile -d '' -t argv <"/proc/$pid/cmdline" 2>/dev/null
        (( ${#argv[@]} > 0 )) && command=$(printf '%q ' "${argv[@]}")
      fi
      [[ -n $command ]] && launches+=("$(jq -nc --arg workspace "$workspace" \
        --arg command "$command" --arg class "$class" '{workspace: $workspace, command: $command, class: $class}')")
    done < <(jq -r '[.[].class] | unique | .[]' <<<"$pid_windows")
  fi
done < <(jq -r '[.[].pid] | unique | .[]' <<<"$windows")

# Agents in Herdr Desktop panes. herdr-core brings its panes back after a
# reboot as shells; restore types the resume command into the same pane.
herdr_panes=()
for pid in $(pgrep -u "$UID" -x 'claude|grok'); do
  pane=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^HC_TERMINAL_ID=//p')
  [[ -n $pane ]] || continue
  resume=$(agent_resume "$pid")
  [[ -n $resume ]] || continue
  herdr_panes+=("$(jq -nc --arg pane "$pane" --arg dir "$(readlink -f "/proc/$pid/cwd")" --arg resume "$resume" \
    '{pane: $pane, dir: $dir, resume: $resume}')")
done

mkdir -p "$state_dir"
printf '%s\n' "${launches[@]}" | jq -s \
  --argjson herdr "$(printf '%s\n' "${herdr_panes[@]}" | jq -s 'map(select(. != null))')" \
  --argjson windows "$windows" \
  --argjson terminals "$(printf '%s\n' "${terminal_pids[@]}" | jq -s 'map(select(. != null))')" \
  --argjson monitors "$monitors" '{
    # Terminals open straight onto their saved workspaces, so restore only
    # places other windows. Terminals launch first: they are up the fastest.
    windows: [$windows[] | select(.pid as $pid | $terminals | index($pid) | not) | {class, title, workspace}],
    launches: (map(select(. != null)) | sort_by(.class != null)),
    herdr: $herdr,
    active: [$monitors[] | {monitor: .name, workspace: (.activeWorkspace.name | tostring)}],
    focused: ([$monitors[] | select(.focused) | .name] | first)
  }' >"$state_dir/windows.json.tmp" && mv "$state_dir/windows.json.tmp" "$state_dir/windows.json"

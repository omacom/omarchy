#!/bin/bash

# omarchy:summary=Remove or uninstall the selected launcher entry
# omarchy:args=<desktop-id> <name>
# omarchy:hidden=true
# omarchy:requires-sudo=true

set -e

desktop_id="${1-}"
entry_name="${2-}"

if [[ -z $desktop_id ]]; then
  echo "Usage: omarchy-remove-launcher-entry <desktop-id> <name>" >&2
  exit 1
fi

# Uninstalling a package asks for a password in a terminal. Say so on stdout
# first, so the launcher knows to get out of the way, and leave the terminal
# running on its own rather than as a child the shell would take down with it.
uninstall_in_terminal() {
  echo "terminal"
  omarchy-launch-floating-terminal-with-presentation "$1" &>/dev/null &
}

source "$OMARCHY_PATH/default/launchers/entries.sh"
user_desktop_dirs=("$launcher_user_dir")
if ! desktop_file=$(launcher_find_entry "$desktop_id" true); then
  omarchy-refresh-launcher-renames
  echo "Could not find launcher entry: $desktop_id" >&2
  exit 1
fi
desktop_file_name=${desktop_file##*/}

is_user_desktop_file() {
  local dir relative

  for dir in "${user_desktop_dirs[@]}"; do
    relative=${desktop_file#"$dir/"}
    (( ${#relative} < ${#desktop_file} )) && return 0
  done

  return 1
}

desktop_name="${desktop_file##*/}"
desktop_name="${desktop_name%.desktop}"
exec_line="$(sed -n 's/^Exec=//p' "$desktop_file" | head -1)"

if [[ $exec_line =~ omarchy-launch-webapp|omarchy-webapp-handler ]]; then
  OMARCHY_REMOVE_NOTIFY=false omarchy-webapp-remove "$desktop_name"
  omarchy-refresh-launcher-renames
  exit 0
fi

if [[ $exec_line =~ (^|[[:space:]])(\$TERMINAL|xdg-terminal-exec)[[:space:]].*-e([[:space:]]|$) ]]; then
  OMARCHY_REMOVE_NOTIFY=false omarchy-tui-remove "$desktop_name"
  omarchy-refresh-launcher-renames
  exit 0
fi

if is_user_desktop_file; then
  display_name="${entry_name:-$desktop_name}"
  rm -f "$desktop_file"
  omarchy-refresh-launcher-renames
  update-desktop-database "${desktop_file%/*}" &>/dev/null || true
  exit 0
fi

if package_name="$(pacman -Qqo "$desktop_file" 2>/dev/null | head -1)" && [[ -n $package_name ]]; then
  display_name="${entry_name:-$desktop_name}"
  quoted_package="$(printf '%q' "$package_name")"
  quoted_display="$(printf '%q' "$display_name")"
  uninstall_in_terminal "echo Uninstalling $quoted_display...; omarchy-pkg-drop $quoted_package"
  exit 0
fi

if omarchy-cmd-present flatpak && flatpak info "${desktop_file_name%.desktop}" >/dev/null 2>&1; then
  flatpak_id="${desktop_file_name%.desktop}"
  quoted_flatpak="$(printf '%q' "$flatpak_id")"
  uninstall_in_terminal "flatpak uninstall $quoted_flatpak && omarchy-refresh-launcher-renames"
  exit 0
fi

echo "Don't know how to uninstall $desktop_file_name" >&2
exit 1

#!/usr/bin/python3
import sys
import gi
gi.require_version('Gio', '2.0')
gi.require_version('GLib', '2.0')
from gi.repository import Gio, GLib
import logging
import warnings

logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')

class SNIWatcher:
    def __init__(self):
        # Maps service_name -> watch_id
        self.items = {}
        self.hosts = {}
        
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        
        introspection_xml = """
        <node>
          <interface name="org.kde.StatusNotifierWatcher">
            <method name="RegisterStatusNotifierItem">
              <arg type="s" name="service" direction="in"/>
            </method>
            <method name="RegisterStatusNotifierHost">
              <arg type="s" name="service" direction="in"/>
            </method>
            <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
            <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
            <property name="ProtocolVersion" type="i" access="read"/>
            <signal name="StatusNotifierItemRegistered">
              <arg type="s" name="service"/>
            </signal>
            <signal name="StatusNotifierItemUnregistered">
              <arg type="s" name="service"/>
            </signal>
            <signal name="StatusNotifierHostRegistered"/>
            <signal name="StatusNotifierHostUnregistered"/>
          </interface>
        </node>
        """
        
        self.node_info = Gio.DBusNodeInfo.new_for_xml(introspection_xml)
        self.interface_info = self.node_info.interfaces[0]
        
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            self.registration_id = self.bus.register_object(
                "/StatusNotifierWatcher",
                self.interface_info,
                self.handle_method_call,
                self.handle_get_property,
                self.handle_set_property
            )
        
        Gio.bus_own_name_on_connection(
            self.bus,
            "org.kde.StatusNotifierWatcher",
            Gio.BusNameOwnerFlags.REPLACE,
            self.on_name_acquired,
            self.on_name_lost
        )

    def on_name_acquired(self, connection, name):
        logging.info(f"Acquired DBus name {name}")

    def on_name_lost(self, connection, name):
        logging.error(f"Lost DBus name {name} - another watcher claimed it?")
        sys.exit(1)

    def on_item_vanished(self, connection, name):
        logging.info(f"Item vanished: {name}")
        if name in self.items:
            watch_id = self.items.pop(name)
            Gio.bus_unwatch_name(watch_id)
            connection.emit_signal(
                None,
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "StatusNotifierItemUnregistered",
                GLib.Variant("(s)", (name,))
            )

    def on_host_vanished(self, connection, name):
        logging.info(f"Host vanished: {name}")
        if name in self.hosts:
            watch_id = self.hosts.pop(name)
            Gio.bus_unwatch_name(watch_id)
            connection.emit_signal(
                None,
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "StatusNotifierHostUnregistered",
                None
            )

    def handle_method_call(self, connection, sender, object_path, interface_name, method_name, parameters, invocation):
        if method_name == "RegisterStatusNotifierItem":
            service = parameters.unpack()[0]
            # Some clients pass a path instead of a bus name. If it's a relative path, assume the sender is the bus name.
            if service.startswith("/") and not service.startswith("org"):
                service = sender + service
                
            if service in self.items:
                invocation.return_value(None)
                return
                
            logging.info(f"Registering SNI item: {service} (from {sender})")
            watch_id = Gio.bus_watch_name_on_connection(
                self.bus,
                service,
                Gio.BusNameWatcherFlags.NONE,
                None,
                self.on_item_vanished
            )
            self.items[service] = watch_id
            
            connection.emit_signal(
                None,
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "StatusNotifierItemRegistered",
                GLib.Variant("(s)", (service,))
            )
            invocation.return_value(None)
            
        elif method_name == "RegisterStatusNotifierHost":
            service = parameters.unpack()[0]
            if service in self.hosts:
                invocation.return_value(None)
                return
                
            logging.info(f"Registering SNI host: {service} (from {sender})")
            watch_id = Gio.bus_watch_name_on_connection(
                self.bus,
                service,
                Gio.BusNameWatcherFlags.NONE,
                None,
                self.on_host_vanished
            )
            self.hosts[service] = watch_id
            
            connection.emit_signal(
                None,
                "/StatusNotifierWatcher",
                "org.kde.StatusNotifierWatcher",
                "StatusNotifierHostRegistered",
                None
            )
            invocation.return_value(None)
        else:
            invocation.return_error_literal(Gio.DBusError, Gio.DBusError.UNKNOWN_METHOD, "Unknown method")

    def handle_get_property(self, connection, sender, object_path, interface_name, property_name):
        if property_name == "RegisteredStatusNotifierItems":
            return GLib.Variant("as", list(self.items.keys()))
        elif property_name == "IsStatusNotifierHostRegistered":
            return GLib.Variant("b", len(self.hosts) > 0)
        elif property_name == "ProtocolVersion":
            return GLib.Variant("i", 0)
        return None

    def handle_set_property(self, connection, sender, object_path, interface_name, property_name, value):
        return False

if __name__ == '__main__':
    watcher = SNIWatcher()
    loop = GLib.MainLoop()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass

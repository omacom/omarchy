#!/bin/bash

# omarchy:summary=Set Sublime Text's font to the Omarchy monospace font
# omarchy:hidden=true

set -e

[[ -n ${1:-} ]] || exit 0

preferences="$HOME/.config/sublime-text/Packages/User/Preferences.sublime-settings"
[[ -f $preferences ]] || exit 0

python3 "$OMARCHY_PATH/default/sublime/set-preferences.py" "$preferences" "font_face=$1"

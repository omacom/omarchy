#!/bin/bash

# omarchy:summary=Install one of the approved terminals and set it as the default for Omarchy (Super + Return etc).
# omarchy:args=<alacritty|foot|ghostty|glass|kitty>
# omarchy:requires-sudo=true

if (($# == 0)); then
  echo "Usage: omarchy-install-terminal [alacritty|foot|ghostty|glass|kitty]"
  exit 1
fi

package="$1"

# Map package name to desktop entry ID
case "$package" in
alacritty) desktop_id="Alacritty.desktop" ;;
foot) desktop_id="foot.desktop" ;;
ghostty) desktop_id="com.mitchellh.ghostty.desktop" ;;
glass) desktop_id="glass.desktop" ;;
kitty) desktop_id="kitty.desktop" ;;
*)
  echo "Unknown terminal: $package"
  exit 1
  ;;
esac

echo "Installing $package..."

# glass is not packaged for Arch yet. Its release installer puts it in ~/.local
# for this user, checks the download against the release's SHA256SUMS, and adds
# a desktop entry that already carries the X-TerminalArg* keys. Downloaded whole
# before it runs, so a dropped connection can never run half a script.
install_glass() {
  local installer status
  installer=$(mktemp) || return 1
  curl -fsSL --retry 3 https://github.com/newjordan/glass/releases/latest/download/install.sh -o "$installer" &&
    sh "$installer"
  status=$?
  rm -f "$installer"
  return $status
}

if [[ $package == "glass" ]]; then
  install_command=(install_glass)
else
  install_command=(omarchy-pkg-add "$package")
fi

# Install package
if "${install_command[@]}"; then
  # Copy custom desktop entries with X-TerminalArg* keys
  if [[ $package == "alacritty" ]]; then
    mkdir -p ~/.local/share/applications
    cp "$OMARCHY_PATH/default/alacritty/$desktop_id" ~/.local/share/applications/
  elif [[ $package == "foot" ]]; then
    mkdir -p ~/.local/share/applications
    cp "$OMARCHY_PATH/applications/$desktop_id" ~/.local/share/applications/
  fi

  # Copy default config for optional terminals when missing
  if [[ ! -e ~/.config/$package ]]; then
    cp -Rpf "$OMARCHY_PATH/config/$package" ~/.config/
  fi

  # A current theme staged before the glass template existed has no glass.conf.
  if [[ $package == "glass" && ! -f $HOME/.local/state/omarchy/current/theme/glass.conf ]]; then
    omarchy-theme-refresh
  fi

  # Update xdg-terminals.list to prioritize the proper terminal
  cat >~/.config/xdg-terminals.list <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
EOF
else
  echo "Failed to install $package"
fi

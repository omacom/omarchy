#!/bin/bash

# omarchy:summary=Update installed git-managed plugins
# omarchy:group=plugin
# omarchy:args=[id] [--yes]

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
UPDATED_ANY=0

fail() {
  echo "omarchy-plugin-update: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

plugin_version() {
  local dir="$1" revision="$2" version
  version=$(git -C "$dir" show "$revision:manifest.json" 2>/dev/null | jq -er '.version | select(type == "string")' 2>/dev/null) || return 0
  # Manifest strings are untrusted terminal input.
  [[ $version =~ ^[[:alnum:]][[:alnum:].+_-]{0,63}$ ]] && printf '%s' "$version"
  return 0
}

review_update() {
  local id="$1" dir="$2" before="$3" after="$4"
  local old_version new_version choice
  old_version=$(plugin_version "$dir" "$before")
  new_version=$(plugin_version "$dir" "$after")

  printf '\nUpdate available: %s\n' "$id"
  if [[ -n $old_version && -n $new_version && $old_version != "$new_version" ]]; then
    printf 'Version: %s → %s\n' "$old_version" "$new_version"
  elif [[ -n $new_version ]]; then
    printf 'Version: %s (new changes)\n' "$new_version"
  fi
  git --no-pager -C "$dir" diff --no-ext-diff --no-textconv --shortstat "$before" "$after" --
  printf '\nRecent changes:\n'
  git --no-pager -C "$dir" log --no-decorate --no-color --no-show-signature --no-merges --format='  - %s' -n 5 "$before..$after" -- |
    LC_ALL=C sed 's/[[:cntrl:]]/?/g' | cut -c 1-120
  echo

  interactive || fail "refusing to continue without confirmation; pass --yes"
  while choice=$(gum choose --header "Update $id?" "Update" "Show code changes" "Skip"); do
    case "$choice" in
    Update) return 0 ;;
    "Show code changes")
      git --no-pager -C "$dir" diff --no-ext-diff --no-textconv --color=always "$before" "$after" -- |
        less -R -P 'Press q to return to the update options'
      ;;
    Skip) return 1 ;;
    esac
  done
  return 1
}

update_one() {
  local id="$1"
  local dir="$PLUGINS_DIR/$id"
  local before after

  if ! git -C "$dir" fetch --quiet origin HEAD; then
    echo "omarchy-plugin-update: fetch failed for '$id'" >&2
    return 1
  fi

  before=$(git -C "$dir" rev-parse HEAD)
  after=$(git -C "$dir" rev-parse FETCH_HEAD)
  if [[ $before == "$after" ]]; then
    echo "$id is up to date."
    return 0
  fi

  if (( ! ASSUME_YES )); then
    review_update "$id" "$dir" "$before" "$after" || {
      echo "Skipped $id."
      return 0
    }
  fi

  if [[ $(git -C "$dir" rev-parse HEAD) != "$before" ]]; then
    echo "omarchy-plugin-update: '$id' changed while reviewing; run the update again" >&2
    return 1
  fi

  if ! git -C "$dir" merge --ff-only "$after" >/dev/null 2>&1; then
    echo "omarchy-plugin-update: cannot fast-forward '$id'; you have local changes in $dir" >&2
    return 1
  fi

  if ! omarchy-plugin-validate "$dir"; then
    git -C "$dir" reset --hard ORIG_HEAD >/dev/null
    echo "omarchy-plugin-update: update of '$id' failed validation; rolled back" >&2
    return 1
  fi

  echo "Updated $id."
  UPDATED_ANY=1
}

id=""

while (( $# > 0 )); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin update [id] [--yes]"
    exit 0
    ;;
  -*)
    fail "unknown update option: $1"
    ;;
  *)
    [[ -z $id ]] || fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

[[ -d $PLUGINS_DIR ]] || fail "no plugins installed"

targets=()
if [[ -n $id ]]; then
  valid_plugin_id "$id" || fail "invalid plugin id '$id'"
  [[ -d $PLUGINS_DIR/$id ]] || fail "plugin '$id' is not installed"
  [[ -d $PLUGINS_DIR/$id/.git ]] ||
    fail "plugin '$id' is not a git checkout, so there is nothing to pull from"
  targets=("$id")
else
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir/.git ]] || continue
    targets+=("$(basename "$dir")")
  done
  if (( ${#targets[@]} == 0 )); then
    echo "No git-managed plugins installed."
    exit 0
  fi
fi

rc=0
for id in "${targets[@]}"; do
  update_one "$id" || rc=1
done

if (( UPDATED_ANY )); then
  omarchy-shell shell rescanPlugins >/dev/null
fi
exit $rc

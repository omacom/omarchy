#!/bin/bash

# omarchy:summary=Update installed git-managed plugins
# omarchy:group=plugin
# omarchy:args=[id] [--yes] [--commit <sha>]

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
UPDATED_ANY=0

fail() {
  echo "omarchy-plugin-update: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

update_one() {
  local id="$1"
  local dir="$PLUGINS_DIR/$id"
  local target_ref="FETCH_HEAD"
  local previous
  local previous_branch

  if [[ -n $commit ]]; then
    if ! git -C "$dir" cat-file -e "$commit^{commit}" 2>/dev/null; then
      if ! git -C "$dir" fetch --quiet --depth 1 origin "$commit"; then
        echo "omarchy-plugin-update: commit $commit not found for '$id'" >&2
        return 1
      fi
    fi
    target_ref="$commit"
  elif ! git -C "$dir" symbolic-ref -q HEAD >/dev/null; then
    echo "$id is pinned at $(git -C "$dir" rev-parse --short HEAD); move it with: omarchy plugin update $id --commit <sha>"
    return 0
  elif ! git -C "$dir" fetch --quiet origin HEAD; then
    echo "omarchy-plugin-update: fetch failed for '$id'" >&2
    return 1
  fi

  if [[ $(git -C "$dir" rev-parse HEAD) == $(git -C "$dir" rev-parse "$target_ref") ]]; then
    if [[ -n $commit ]] && git -C "$dir" symbolic-ref -q HEAD >/dev/null; then
      if ! git -C "$dir" -c advice.detachedHead=false checkout --quiet --detach "$commit"; then
        echo "omarchy-plugin-update: cannot pin '$id'; you have local changes in $dir" >&2
        return 1
      fi
      echo "$id is now pinned at $commit."
    else
      echo "$id is up to date."
    fi
    return 0
  fi

  if (( ! ASSUME_YES )); then
    echo "Changes for $id:"
    if omarchy-cmd-present delta; then
      git -C "$dir" diff HEAD "$target_ref" | delta --paging=never
    else
      git -C "$dir" diff HEAD "$target_ref"
    fi
    echo
    confirm "Update $id?" || {
      echo "Skipped $id."
      return 0
    }
  fi

  previous=$(git -C "$dir" rev-parse HEAD)
  previous_branch=$(git -C "$dir" symbolic-ref -q --short HEAD || true)
  if [[ -n $commit ]]; then
    if ! git -C "$dir" -c advice.detachedHead=false checkout --quiet --detach "$commit"; then
      echo "omarchy-plugin-update: cannot check out $commit for '$id'; you have local changes in $dir" >&2
      return 1
    fi
  elif ! git -C "$dir" merge --ff-only FETCH_HEAD >/dev/null 2>&1; then
    echo "omarchy-plugin-update: cannot fast-forward '$id'; you have local changes in $dir" >&2
    return 1
  fi

  if ! omarchy-plugin-validate "$dir"; then
    if [[ -n $commit ]]; then
      if [[ -n $previous_branch ]]; then
        git -C "$dir" checkout --quiet "$previous_branch" >/dev/null
      else
        git -C "$dir" -c advice.detachedHead=false checkout --quiet --detach "$previous" >/dev/null
      fi
    else
      git -C "$dir" reset --hard ORIG_HEAD >/dev/null
    fi
    echo "omarchy-plugin-update: update of '$id' failed validation; rolled back" >&2
    return 1
  fi

  if [[ -n $commit ]]; then
    echo "Updated $id to commit $commit (pinned)."
  else
    echo "Updated $id."
  fi
  UPDATED_ANY=1
}

id=""
commit=""

while (( $# > 0 )); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  --commit)
    [[ $# -ge 2 && $2 =~ ^[0-9a-f]{40}$ ]] ||
      fail "--commit requires a full 40-character commit SHA"
    commit="$2"
    shift 2
    ;;
  -h | --help)
    echo "Usage: omarchy plugin update [id] [--yes] [--commit <sha>]"
    exit 0
    ;;
  -*)
    fail "unknown update option: $1"
    ;;
  *)
    [[ -z $id ]] || fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

if [[ -n $commit && -z $id ]]; then
  fail "--commit requires a plugin id"
fi

[[ -d $PLUGINS_DIR ]] || fail "no plugins installed"

targets=()
if [[ -n $id ]]; then
  valid_plugin_id "$id" || fail "invalid plugin id '$id'"
  [[ -d $PLUGINS_DIR/$id ]] || fail "plugin '$id' is not installed"
  [[ -d $PLUGINS_DIR/$id/.git ]] ||
    fail "plugin '$id' is not a git checkout, so there is nothing to pull from"
  targets=("$id")
else
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir/.git ]] || continue
    targets+=("$(basename "$dir")")
  done
  if (( ${#targets[@]} == 0 )); then
    echo "No git-managed plugins installed."
    exit 0
  fi
fi

rc=0
for id in "${targets[@]}"; do
  update_one "$id" || rc=1
done

if (( UPDATED_ANY )); then
  omarchy-shell shell reloadPlugins >/dev/null
fi
exit $rc

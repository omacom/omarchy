#!/bin/bash

# omarchy:summary=Update installed git-managed plugins
# omarchy:group=plugin
# omarchy:args=[id] [--yes]

set -euo pipefail

export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"

PLUGINS_DIR="$HOME/.config/omarchy/plugins"
ASSUME_YES=0
UPDATED_ANY=0

fail() {
  echo "omarchy-plugin-update: $*" >&2
  exit 1
}

interactive() {
  [[ -t 0 && -t 1 ]]
}

confirm() {
  local prompt="$1"
  (( ASSUME_YES )) && return 0
  if interactive; then
    gum confirm "$prompt"
  else
    fail "refusing to continue without confirmation; pass --yes"
  fi
}

valid_plugin_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && $1 != *..* ]]
}

validate_revision() (
  local dir="$1" revision="$2" checkout
  checkout=$(mktemp -d) || return 1
  trap '
    status=$?
    git -C "$dir" worktree remove --force "$checkout" >/dev/null 2>&1 || rmdir "$checkout" 2>/dev/null || true
    exit "$status"
  ' EXIT
  git -C "$dir" worktree add --quiet --detach "$checkout" "$revision" || return 1
  omarchy-plugin-validate "$checkout"
)

update_one() {
  local id="$1"
  local dir="$PLUGINS_DIR/$id" current incoming

  if ! git -C "$dir" fetch --quiet origin HEAD; then
    echo "omarchy-plugin-update: fetch failed for '$id'" >&2
    return 1
  fi

  current=$(git -C "$dir" rev-parse HEAD) || return 1
  incoming=$(git -C "$dir" rev-parse FETCH_HEAD) || return 1
  if [[ $current == "$incoming" ]]; then
    echo "$id is up to date."
    return 0
  fi

  if (( ! ASSUME_YES )); then
    echo "Changes for $id:"
    if omarchy-cmd-present delta; then
      git -C "$dir" diff "$current" "$incoming" | delta --paging=never
    else
      git -C "$dir" diff "$current" "$incoming"
    fi
    echo
    confirm "Update $id?" || {
      echo "Skipped $id."
      return 0
    }
  fi

  # Validate the incoming files before changing the installed checkout. A
  # fast-forward can keep local edits that a hard reset would then discard.
  if ! validate_revision "$dir" "$incoming"; then
    echo "omarchy-plugin-update: update of '$id' failed validation; keeping the installed version" >&2
    return 1
  fi

  if ! git -C "$dir" merge --ff-only "$incoming" >/dev/null 2>&1; then
    echo "omarchy-plugin-update: cannot fast-forward '$id'; you have local changes in $dir" >&2
    return 1
  fi

  echo "Updated $id."
  UPDATED_ANY=1
}

id=""

while (( $# > 0 )); do
  case "$1" in
  --yes | -y)
    ASSUME_YES=1
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy plugin update [id] [--yes]"
    exit 0
    ;;
  -*)
    fail "unknown update option: $1"
    ;;
  *)
    [[ -z $id ]] || fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

[[ -d $PLUGINS_DIR ]] || fail "no plugins installed"

targets=()
if [[ -n $id ]]; then
  valid_plugin_id "$id" || fail "invalid plugin id '$id'"
  [[ -d $PLUGINS_DIR/$id ]] || fail "plugin '$id' is not installed"
  [[ -d $PLUGINS_DIR/$id/.git ]] ||
    fail "plugin '$id' is not a git checkout, so there is nothing to pull from"
  targets=("$id")
else
  for dir in "$PLUGINS_DIR"/*/; do
    [[ -d $dir/.git ]] || continue
    targets+=("$(basename "$dir")")
  done
  if (( ${#targets[@]} == 0 )); then
    echo "No git-managed plugins installed."
    exit 0
  fi
fi

rc=0
for id in "${targets[@]}"; do
  update_one "$id" || rc=1
done

if (( UPDATED_ANY )); then
  omarchy-shell shell rescanPlugins >/dev/null
fi
exit $rc

#!/bin/bash

# omarchy:summary=Enable verified local Cohere Vulkan or restore the configured Voxtype engine
# omarchy:args=[enable|disable]

set -euo pipefail

dropin="$HOME/.config/systemd/user/voxtype.service.d/40-omarchy-cohere.conf"
service="$HOME/.config/systemd/user/voxtype-cohere-vulkan.service"
model_dir="$HOME/.local/share/voxtype/models/cohere-transcribe-vulkan"
model="$model_dir/cohere-transcribe-03-2026-Q4_K_M.gguf"
model_sha="0ea56826d8bd5d74b7143a4a04e022dc1bb75452cfae49d98b6acb0c1d16a1fb"
action=${1:-enable}

if [[ $action != "enable" && $action != "disable" ]]; then
  echo "Usage: omarchy voxtype cohere [enable|disable]" >&2
  exit 1
fi

state_file="${XDG_RUNTIME_DIR:?}/voxtype/state"
check_idle() {
  if [[ -f $state_file && $(<"$state_file") != "idle" ]]; then
    echo "Finish the current dictation before changing engines." >&2
    exit 1
  fi
}
check_idle
exec 9>"$XDG_RUNTIME_DIR/voxtype-cohere-setup.lock"
flock -n 9 || { echo "Cohere setup is already running." >&2; exit 1; }

if [[ $action == "enable" ]]; then
  if omarchy-cmd-missing voxtype-cohere-vulkan; then
    echo "Install voxtype-cohere-vulkan first with omarchy pkg add." >&2
    exit 1
  fi
  mkdir -p "$model_dir"
  # Keep partial downloads away from the active model.
  if ! echo "$model_sha  $model" | sha256sum --check --status; then
    echo "Downloading Cohere Transcribe (1.56GB)…"
    curl --fail --location --retry 3 --connect-timeout 20 \
      --output "$model.part" \
      https://models.superwhisper.com/cohere-transcribe-03-2026-Q4_K_M.gguf
    echo "$model_sha  $model.part" | sha256sum --check --status
    mv "$model.part" "$model"
  fi
  echo "Checking Vulkan with a spoken transcription…"
  timeout 120 voxtype-cohere-vulkan --model "$model" --probe
  # Downloads and GPU warmup can take minutes; a recording may have begun.
  check_idle

  mkdir -p "${dropin%/*}"
  service_backup=""
  dropin_backup=""
  backend_was_active=0
  voxtype_was_active=0
  if systemctl --user is-active --quiet voxtype-cohere-vulkan.service; then
    backend_was_active=1
  fi
  if systemctl --user is-active --quiet voxtype.service; then
    voxtype_was_active=1
  fi
  if [[ -f $service ]]; then
    service_backup=$(mktemp "$service.bak.XXXXXX")
    cp -p "$service" "$service_backup"
  fi
  if [[ -f $dropin ]]; then
    dropin_backup=$(mktemp "$dropin.bak.XXXXXX")
    cp -p "$dropin" "$dropin_backup"
  fi

  restore_file() {
    if [[ -n $2 ]]; then
      cp -p "$2" "$1"
    else
      rm -f "$1"
    fi
  }

  if cp "$OMARCHY_PATH/default/voxtype/cohere-vulkan.service" "$service" &&
    systemctl --user daemon-reload &&
    systemctl --user restart voxtype-cohere-vulkan.service &&
    cp "$OMARCHY_PATH/default/voxtype/cohere-vulkan.conf" "$dropin" &&
    systemctl --user daemon-reload &&
    { (( ! voxtype_was_active )) || systemctl --user restart voxtype.service; }; then
    exit 0
  fi

  rollback_failed=0
  restore_file "$dropin" "$dropin_backup" || rollback_failed=1
  restore_file "$service" "$service_backup" || rollback_failed=1
  systemctl --user daemon-reload || rollback_failed=1
  if (( backend_was_active )); then
    systemctl --user restart voxtype-cohere-vulkan.service || rollback_failed=1
  fi
  if (( voxtype_was_active )); then
    systemctl --user restart voxtype.service || rollback_failed=1
  fi
  # The restored drop-in can start the backend as a dependency of Voxtype.
  if (( ! backend_was_active )); then
    systemctl --user stop voxtype-cohere-vulkan.service || rollback_failed=1
  fi
  if (( rollback_failed )); then
    echo "Cohere did not activate and the previous Voxtype setup could not be fully restored." >&2
  else
    echo "Cohere did not activate; the previous Voxtype setup was restored." >&2
  fi
  exit 1
fi

rm -f "$dropin"
systemctl --user daemon-reload
if systemctl --user is-active --quiet voxtype.service; then
  systemctl --user restart voxtype.service
fi
systemctl --user stop voxtype-cohere-vulkan.service

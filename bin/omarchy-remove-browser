#!/bin/bash

# omarchy:summary=Remove a supported browser and clean up Omarchy browser defaults
# omarchy:args=<chrome|brave|brave-origin|edge|firefox|zen>
# omarchy:examples=omarchy remove browser firefox | omarchy remove browser brave
# omarchy:requires-sudo=true

set_fallback_default_browser() {
  local current_browser
  current_browser=$(omarchy-cmd-default-browser)

  if [[ $current_browser != $1 ]]; then
    return
  fi

  if omarchy-cmd-present chromium; then
    env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser chromium.desktop || true
  fi
}

# PIDs running a binary owned by this package. Matching on package contents needs no per-browser
# paths, and separates Brave from Brave Origin, which both run a process named "brave".
package_pids() {
  local package=$1 file exe exe_link pid
  local -A owned_files=()

  omarchy-pkg-present "$package" || return

  while IFS= read -r file; do
    owned_files[$file]=1
  done < <(pacman -Qlq "$package" 2>/dev/null)

  for exe_link in /proc/[0-9]*/exe; do
    exe=$(readlink "$exe_link" 2>/dev/null) || continue
    # A running process whose binary was already deleted reports "<path> (deleted)"
    exe=${exe%" (deleted)"}

    if [[ -n ${owned_files[$exe]} ]]; then
      pid=${exe_link#/proc/}
      echo "${pid%/exe}"
    fi
  done
}

# A browser left running on its deleted install crashes every child process it spawns,
# so ask it to quit before removal and kill whatever is still there after 10 seconds.
close_browser() {
  local name=$1 package=$2 pids

  mapfile -t pids < <(package_pids "$package")

  if (( ${#pids[@]} > 0 )); then
    echo "Closing $name..."
    kill -TERM "${pids[@]}" 2>/dev/null

    for _ in {1..100}; do
      kill -0 "${pids[@]}" 2>/dev/null || break
      sleep 0.1
    done

    # Scan again rather than reuse the list, so late children are caught and a recycled PID is not
    mapfile -t pids < <(package_pids "$package")

    if (( ${#pids[@]} > 0 )); then
      kill -KILL "${pids[@]}" 2>/dev/null
    fi
  fi
}

case $1 in
chrome)
  close_browser Chrome google-chrome
  echo "Removing Chrome..."
  set_fallback_default_browser google-chrome.desktop
  omarchy-pkg-drop google-chrome
  rm -f ~/.config/chrome-flags.conf
  sudo rm -f /etc/opt/chrome/policies/managed/color.json /etc/opt/chrome/policies/managed/omarchy.json
  ;;
edge)
  close_browser Edge microsoft-edge-stable-bin
  echo "Removing Edge..."
  set_fallback_default_browser microsoft-edge.desktop
  omarchy-pkg-drop microsoft-edge-stable-bin
  rm -f ~/.config/microsoft-edge-stable-flags.conf
  sudo rm -f /etc/opt/edge/policies/managed/color.json /etc/opt/edge/policies/managed/omarchy.json
  ;;
brave)
  close_browser Brave brave-bin
  echo "Removing Brave..."
  set_fallback_default_browser brave-browser.desktop
  omarchy-pkg-drop brave-bin
  rm -f ~/.config/brave-flags.conf

  if omarchy-pkg-missing brave-origin-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
brave-origin)
  close_browser "Brave Origin" brave-origin-bin
  echo "Removing Brave Origin..."
  set_fallback_default_browser brave-origin.desktop
  omarchy-pkg-drop brave-origin-bin
  rm -f ~/.config/brave-origin-flags.conf

  if omarchy-pkg-missing brave-bin; then
    sudo rm -rf /etc/brave
  fi
  ;;
firefox)
  close_browser Firefox firefox
  echo "Removing Firefox..."
  set_fallback_default_browser firefox.desktop
  omarchy-pkg-drop firefox
  ;;
zen)
  close_browser Zen zen-browser-bin
  echo "Removing Zen..."
  set_fallback_default_browser zen.desktop
  omarchy-pkg-drop zen-browser-bin
  ;;
*)
  echo "Usage: omarchy-remove-browser <chrome|brave|brave-origin|edge|firefox|zen>"
  exit 1
  ;;
esac

#!/bin/bash

# omarchy:summary=Install the ONCE service, enable its background service, and launch the TUI.
# omarchy:requires-sudo=true

set -e

echo "Installing ONCE..."
omarchy-pkg-add once-bin

# Older releases allow root-running backups to follow user-controlled symlinks.
# https://github.com/basecamp/once/security/advisories/GHSA-jqwc-wmh4-9qw3
if ! pacman -T 'once-bin>=0.3.4' >/dev/null; then
  echo "ONCE 0.3.4 or newer is required. Run omarchy update, then omarchy-install-service-once." >&2
  exit 1
fi

echo "Enabling ONCE background service..."
sudo systemctl enable --now once-background.service

echo -e "\nLaunching ONCE..."
sudo once

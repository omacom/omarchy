#!/bin/bash

# omarchy:summary=Toggle tiled fullscreen for the focused Hyprland window

set -euo pipefail

active=$(hyprctl activewindow -j)
fullscreen=$(jq -r '.fullscreen // 0' <<<"$active")

if [[ $fullscreen == "2" ]]; then
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "unset" })'
else
  hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "fullscreen", action = "set" })'
fi

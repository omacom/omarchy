#!/bin/bash

# omarchy:summary=Launch the default coding agent in a terminal
# omarchy:args=[--inline] [--pick] [--local] [--local-model <recipe>] [--prefer-local] [--agent <id>]
# omarchy:examples=omarchy agent | omarchy agent --inline | omarchy agent --local | omarchy agent --agent codex

set -euo pipefail

inline=false
pick=false
prompt=""
use_local=false
prefer_local=false
local_model=""
agent_override=""

# Flags only. A bare prompt would shadow the subcommands under this group, so
# prompts go through omarchy-agent-prompt, which passes one here as --prompt.
while (($#)); do
  case "$1" in
    --inline)
      inline=true
      shift
      ;;
    --pick)
      pick=true
      shift
      ;;
    --local)
      use_local=true
      shift
      ;;
    --local-model)
      use_local=true
      local_model=${2:?--local-model needs a recipe id}
      shift 2
      ;;
    --prefer-local)
      prefer_local=true
      shift
      ;;
    --agent)
      agent_override=${2:?--agent needs an agent id}
      shift 2
      ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: omarchy agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

# Agents refuse to remember trust for $HOME, so launches from the keybinding or
# menu start in the work directory instead of re-asking on every session.
[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

# --agent launches a given agent instead of the default: the panel's terminal
# button on each subscription opens the harness made for it, Codex for OpenAI.
if [[ -n $agent_override ]]; then
  agent=$agent_override
  if omarchy-cmd-missing "$agent"; then
    omarchy-notification-send "$(omarchy-i18n agents.harnessMissing "$agent")" "$(omarchy-i18n agents.harnessMissingBody "$agent")"
    exit 1
  fi
else
  agent=$(omarchy-default-agent)
fi

# --prefer-local takes the local model when one is up and the usual agent when
# not, so the Quake console opens on whatever the machine is running. The model
# last started wins when it is running; any other running one will do. One
# still loading is not up yet, and opening an agent on it would only error.
#
# `omarchy-agent-local status` exits non-zero when no model was ever started,
# which under this script's `set -e` and `pipefail` would end the launch instead
# of falling through to the usual agent, so the probe answers empty there.
if [[ $prefer_local == "true" && $use_local != "true" ]]; then
  local_model=$(omarchy-agent-local status --json 2>/dev/null | jq -r '
    [.models // {} | to_entries[] | select(.value.unit == "active" and .value.sub_state == "running") | .key] as $up
    | if (.last as $last | $up | index($last)) != null then .last else ($up[0] // empty) end' 2>/dev/null || true)
  [[ -n $local_model ]] && use_local=true
fi

# Only agents with a launch-time overlay can be pointed at the local model. When
# the default can't, or none is set, the local model opens in pi, or OpenCode
# without pi: the agents panel launches it whether or not a default was chosen.
if [[ $use_local == "true" && $agent != "pi" && $agent != "opencode" ]]; then
  local_agent=""
  for candidate in pi opencode; do
    if omarchy-cmd-present "$candidate"; then
      local_agent=$candidate
      break
    fi
  done
  if [[ -z $local_agent && $prefer_local == "true" ]]; then
    # Preferred, not asked for: without an agent that can take the overlay,
    # open the usual one rather than nothing.
    use_local=false
  elif [[ -z $local_agent ]]; then
    omarchy-notification-send -u critical "$(omarchy-i18n agents.localUnsupported)" "$(omarchy-i18n agents.localUnsupportedBody)"
    exit 1
  else
    agent=$local_agent
  fi
fi

# Omarchy ships without a default, so there is nothing to launch until one is
# picked. --pick offers the choice instead of the error, which is what the
# keybinding wants: a keypress that opens nothing explains nothing.
if [[ -z $agent ]]; then
  [[ $pick == "true" ]] && exec omarchy-menu summon setup.default.agent
  echo "Choose default agent with: omarchy default agent <name>" >&2
  exit 1
fi

harness=$(omarchy-agent-catalog | jq -cer --arg id "$agent" '.[] | select(.id == $id)') || {
  if omarchy-cmd-missing "$agent"; then
    echo "$agent is not installed. Choose an installed agent with: omarchy default agent <name>" >&2
  else
    echo "Unknown default coding-agent harness: $agent" >&2
  fi
  exit 1
}
command_name=$(jq -r '.install.command' <<<"$harness")
# OpenClaw's launcher sets OpenClaw up when the package became the seed before
# this user's OpenClaw moved, so with the package a missing command is its to fix.
if omarchy-cmd-missing "$command_name" && ! { [[ $agent == "openclaw" ]] && omarchy-pkg-present openclaw; }; then
  echo "$agent is not installed. Choose an installed agent with: omarchy default agent <name>" >&2
  exit 1
fi

if [[ -n $prompt ]]; then
  template=$(jq -c '.launch.promptCommand // .launch.command' <<<"$harness")
else
  template=$(jq -c '.launch.command' <<<"$harness")
fi
mapfile -d '' command < <(jq -jr --arg project "$PWD" --arg prompt "$prompt" '.[] | gsub("\\{(?<placeholder>project|prompt)\\}"; if .placeholder == "project" then $project else $prompt end) + "\u0000"' <<<"$template")
mode=$(jq -r '.launch.mode' <<<"$harness")
prompt_stdin=$(jq -r '.launch.promptStdin // false' <<<"$harness")
prompt_clipboard=$(jq -r '.launch.promptViaClipboard // empty' <<<"$harness")

# An agent with no way to take a starting prompt still opens, with the prompt
# on the clipboard to paste as its first message, so a prompted launch from the
# agents panel or a crash report is not lost.
if [[ -n $prompt && -n $prompt_clipboard ]]; then
  printf '%s' "$prompt" | wl-copy
  omarchy-notification-send -g 󰅇 "$(omarchy-i18n agents.promptOnClipboard "$prompt_clipboard")" \
    "$(omarchy-i18n agents.promptOnClipboardBody)"
fi

# --local points the agent at the model `omarchy agent local use` runs, through
# a launch-time overlay Omarchy owns, never by editing the agent's own config.
# Only agents with such an overlay can be pointed there.
if [[ $use_local == "true" ]]; then
  mapfile -t overlay < <(omarchy-agent-local overlay "$agent" ${local_model:+"$local_model"})
  (( ${#overlay[@]} == 3 )) || exit 1
  case "$agent" in
  opencode)
    # The shared background service never sees the overlay, so run a private one.
    model=$(jq -nc --arg model "${overlay[1]}/${overlay[2]}" '{model: $model}')
    command=(env "OPENCODE_CONFIG=${overlay[0]}" "OPENCODE_CONFIG_CONTENT=$model" "${command[@]}" --standalone)
    ;;
  pi)
    command+=(--extension "${overlay[0]}" --provider "${overlay[1]}" --model "${overlay[2]}")
    ;;
  esac
fi

# omarchy-mise-install's wrappers run `mise use` and `mise x`, current ones on
# lines of their own and older ones after an inline variable; either way
# running one installs the tool it wraps. A symlink is the user's own install.
mise_wrapper() {
  [[ ! -L $1 ]] && head -c 4096 "$1" | grep -qaE 'mise (use|x) '
}

# The user's own install in ~/.local/bin, which omarchy-default-agent counts as
# installed, still wins over mise's lazy shim earlier on PATH, which would
# install and run mise's copy instead. Once mise has installed its own, a
# terminal runs that one, so the launcher does too. A harness whose command runs
# another launcher, such as OpenClaw's, has no such argv to swap.
user_install="$HOME/.local/bin/$command_name"
if [[ -f $user_install && -x $user_install ]] &&
  ! mise_wrapper "$user_install" && ! MISE_OFFLINE=1 mise which "$command_name" &>/dev/null; then
  for i in "${!command[@]}"; do
    if [[ ${command[i]} == "$command_name" ]]; then
      command[i]=$user_install
      break
    fi
  done
fi

# Amp reads its first interactive message from stdin, where a positional message
# belongs to the one-turn --execute mode, so a prompt is piped in the terminal.
if [[ -n $prompt && $prompt_stdin == "true" && $mode != "browser" ]]; then
  command=(bash -c 'printf "%s\n" "$1" | exec "${@:2}"' bash "$prompt" "${command[@]}")
fi

# A new session uses the current selection rather than its parent's account
# pin. Explicit provider homes still override the selection. Carry the new pin
# in the command, since terminals launched through uwsm don't inherit our env.
case "$agent" in
claude) home_env="CLAUDE_CONFIG_DIR" ;;
codex) home_env="CODEX_HOME" ;;
grok) home_env="GROK_HOME" ;;
*) home_env="" ;;
esac
if [[ -n $home_env ]]; then
  account_pin="OMARCHY_AGENT_${agent^^}_HOME"
  if [[ -v $account_pin && ${!home_env:-} == "${!account_pin}" ]]; then
    unset "$home_env"
  fi
  unset "$account_pin"
  if [[ -z ${!home_env:-} ]]; then
    home=$(omarchy-agent-account-home "$agent")
    account_env=(env -u "$home_env" "$account_pin=$home")
    [[ -n $home ]] && account_env+=("$home_env=$home")
    command=("${account_env[@]}" "${command[@]}")
  fi
fi

if [[ $mode == "browser" || $inline == "true" ]]; then
  exec "${command[@]}"
else
  exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
fi

#!/bin/bash

# omarchy:summary=Launch the default coding agent in a terminal
# omarchy:args=[--inline] [--pick] [--local]
# omarchy:examples=omarchy agent | omarchy agent --inline

inline=false
pick=false
local_only=false

# Flags only. A bare prompt would shadow the subcommands under this group, so
# prompts go through omarchy-agent-prompt, which passes one here as --prompt.
while (($#)); do
  case "$1" in
    --inline)
      inline=true
      shift
      ;;
    --pick)
      pick=true
      shift
      ;;
    --local)
      # For work that is about this machine and could not be done from another
      # one, whatever the default agent's usual home is.
      local_only=true
      shift
      ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: omarchy agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

# Agents refuse to remember trust for $HOME, so launches from the keybinding or
# menu start in the work directory instead of re-asking on every session.
[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

agent=$(omarchy-default-agent)

if [[ $local_only == "true" ]]; then
  agent_host=""
else
  agent_host=$(omarchy-default-agent --host)
fi

# Omarchy ships without a default, so there is nothing to launch until one is
# picked. --pick offers the choice instead of the error, which is what the
# keybinding wants: a keypress that opens nothing explains nothing.
if [[ -z $agent ]]; then
  [[ $pick == "true" ]] && exec omarchy-menu summon setup.default.agent
  echo "Choose default agent with: omarchy default agent <name>" >&2
  exit 1
fi

# A remote agent is installed on the machine that runs it, so the local probe
# answers for nothing: ssh reports its own failure well enough.
if [[ -z $agent_host ]] && omarchy-cmd-missing "$agent"; then
  echo "$agent is not installed. Choose an installed agent with: omarchy default agent <name>" >&2
  exit 1
fi

# Agents launched from the keybinding or menu run unattended, so each one starts
# with its own spelling of "don't stop to ask". Pi and Ori have none to skip.
case "$agent" in
opencode)
  command=(opencode --auto)
  [[ -n ${prompt:-} ]] && command+=(--prompt "$prompt")
  ;;
agy)
  command=(agy --dangerously-skip-permissions)
  [[ -n ${prompt:-} ]] && command+=(--prompt-interactive "$prompt")
  ;;
copilot)
  command=(copilot --allow-all)
  [[ -n ${prompt:-} ]] && command+=(--interactive "$prompt")
  ;;
crush)
  # --yolo belongs to the interactive command only; `crush run` never prompts.
  if [[ -n ${prompt:-} ]]; then
    command=(crush run "$prompt")
  else
    command=(crush --yolo)
  fi
  ;;
claude)
  command=(claude --permission-mode auto)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
grok)
  command=(grok --permission-mode bypassPermissions)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
openclaw)
  # The launcher owns onboarding and the gateway dance: OpenClaw's terminal UI
  # must attach to the running gateway (the embedded `openclaw chat` refuses to
  # start while the gateway owns the state directory). It has no permission
  # prompts to skip, and --message seeds the session while keeping it
  # interactive.
  command=(omarchy-launch-openclaw --tui)
  [[ -n ${prompt:-} ]] && command+=(--message "$prompt")
  ;;
codex)
  command=(codex --approve-for-me)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
cursor-agent)
  # --yolo covers commands only; the workspace trust dialog has its own flag.
  # A one-word prompt naming a subcommand (update, login, help) still runs that
  # subcommand after a bare --, so the agent subcommand is named outright, and
  # -- after it keeps a prompt starting with a dash from being read as an option.
  command=(cursor-agent --yolo --trust)
  [[ -n ${prompt:-} ]] && command+=(agent -- "$prompt")
  ;;
hermes)
  if [[ -n ${prompt:-} ]]; then
    command=(env -u HERMES_SESSION_SOURCE hermes chat --yolo --tui "--query=$prompt")
  else
    command=(hermes --yolo)
  fi
  ;;
muse)
  # --approval-mode never skips the tool prompts but keeps Muse's own sandbox.
  command=(muse --approval-mode never)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
omp)
  command=(omp --auto-approve)
  [[ -n ${prompt:-} ]] && command+=(-- "$prompt")
  ;;
ori)
  # Ori is a harness launcher, and `ori code` is the agent it runs itself.
  # A prompt alone means one headless turn there, printed after the turn ends,
  # so --interactive is what seeds the session with it and keeps the window.
  command=(ori code)
  [[ -n ${prompt:-} ]] && command+=(--interactive --prompt "$prompt")
  ;;
pi)
  command=(pi)
  [[ -n ${prompt:-} ]] && command+=("$prompt")
  ;;
*)
  echo "Unsupported default agent: $agent" >&2
  exit 1
  ;;
esac

# The remote agent wraps the command that was just built rather than replacing
# it, so every agent keeps its own don't-stop-to-ask flag and its prompt without
# a second spelling of each one here.
if [[ -n $agent_host ]]; then
  # Checked before the window is spawned: a terminal that opens and closes again
  # is the least informative way to say a machine is asleep.
  if ! omarchy-agent-host-reachable "$agent_host"; then
    if [[ $inline == "true" ]]; then
      echo "Cannot reach $agent_host, where $agent runs." >&2
      echo "Run it on this machine instead with: omarchy agent --local" >&2
    else
      omarchy-notification-send -u critical "Agent host unreachable" \
        "Cannot reach $agent_host, where $agent runs. Run it here instead with: omarchy agent --local"
    fi

    exit 1
  fi

  # Built as a script because the far side has several things to do. Only bash
  # ever parses it: the agent command inside was quoted by bash here, and tmux
  # is handed that command as separate words, which it runs without a shell,
  # so neither the remote login shell nor tmux's default-shell reads a prompt.
  remote_script="agent=${agent@Q} fresh=${prompt:+true}
command=(${command[*]@Q})
$(cat <<'REMOTE'
[[ -d ~/Work ]] && cd ~/Work

# The far side's own spelling of "not installed": a window that opens and
# closes again at once explains nothing, so it stays up long enough to read.
# The launcher is checked as well as the agent, since OpenClaw's is Omarchy's.
# type -P rather than omarchy-cmd-present, which is on this machine, not there.
for needed in "$agent" "${command[0]}"; do
  if ! type -P "$needed" >/dev/null; then
    echo "$needed is not installed on $HOSTNAME." >&2
    echo "Install it there, or run it on the machine you launched from with: omarchy agent --local" >&2
    read -rsn1 -p "Press any key to close." 2>&1
    exit 1
  fi
done

# Neither tmux nor every agent will run under a TERM the far side has no
# terminfo for, and a terminal's own name (xterm-ghostty, xterm-kitty) often is
# one.
infocmp "$TERM" >/dev/null 2>&1 || export TERM=xterm-256color

# Probed by running it, the way this repo probes any other command it does
# not own -- and omarchy-cmd-present is no help here, since the command being
# asked about is on the other machine. A machine without tmux runs the agent
# directly.
if ! tmux -V >/dev/null 2>&1; then
  exec "${command[@]}"
fi

# tmux is what makes a remote agent survive its window: a closed lid or a
# dropped tunnel would otherwise kill work on a machine that is still running
# fine. Sessions are named for the agent and the directory, so switching the
# default agent starts the new one rather than reopening the old.
base=omarchy-agent-$agent-${PWD##*/}
base=${base//[^[:alnum:]_-]/-}
session=$base

if [[ -n $fresh ]]; then
  # A prompt is new work, and attaching would drop it on the floor: tmux
  # ignores the command of a session that already exists. So a prompted launch
  # takes the next free name and leaves the running conversation alone.
  if tmux has-session -t "=$session" 2>/dev/null; then
    n=2
    while tmux has-session -t "=$session-$n" 2>/dev/null; do
      n=$((n + 1))
    done
    session=$session-$n
  fi
else
  # The agent key resumes the conversation already there. Prompts leave
  # numbered sessions behind, and the one to return to is the one last looked
  # at, whichever number it has, so the key never starts a second agent beside
  # a running one.
  latest=-1
  while read -r name attached; do
    [[ $name == "$base" || $name =~ ^$base-[0-9]+$ ]] || continue
    if ((${attached:-0} > latest)); then
      latest=${attached:-0}
      session=$name
    fi
  done < <(tmux list-sessions -F '#{session_name} #{session_last_attached}' 2>/dev/null)
fi

# Created detached so the session can be told to detach its client when it
# ends. Omarchy's own tmux.conf turns detach-on-destroy off, which would move
# the window into whatever other session is running there instead of closing.
# env carries this shell's PATH, mise shims included, into a tmux server that
# may have been started long ago from a shell without them. The size is the
# window's, so the agent draws its first screen at the width it will be seen.
if ! tmux has-session -t "=$session" 2>/dev/null; then
  read -r rows columns < <(stty size 2>/dev/null)
  ((rows > 0 && columns > 0)) || rows=24 columns=80

  # tmux reads a word ending in ; as the end of its own command and drops the
  # ;, so a prompt ending in one has it escaped for tmux to hand back intact.
  tmux_command=()
  for word in env "PATH=$PATH" "${command[@]}"; do
    [[ $word == *';' ]] && word=${word%;}'\;'
    tmux_command+=("$word")
  done

  tmux new-session -d -s "$session" -x "$columns" -y "$rows" "${tmux_command[@]}"
  tmux set-option -t "=$session:" detach-on-destroy on
fi

exec tmux attach-session -t "=$session"
REMOTE
)"

  # The login shell on the far side reads this line first, and it may be fish
  # or zsh rather than bash, so it gets nothing to interpret: the script
  # travels as base64 inside plain single quotes and bash decodes it.
  # -lic rather than -lc: agents are mise shims, and mise activates from the
  # interactive half of the remote shell's startup files, which a login shell
  # running a command skips. The TTY ssh -t forces is what makes -i safe.
  # The control socket makes every launch after the first reuse one connection,
  # which is what keeps asking "is it still running over there?" cheap enough to
  # ask often. In the runtime directory because it is per-user and cleared on
  # logout, unlike a socket left in ~/.ssh, and named by %C because a long host
  # name spelled out would overrun the socket path limit.
  command=(ssh -t
    -o ServerAliveInterval=30 -o ConnectTimeout=10
    -o ControlMaster=auto -o ControlPersist=10m
    -o "ControlPath=${XDG_RUNTIME_DIR:-/tmp}/omarchy-agent-ssh-%C"
    "$agent_host" -- "bash -lic 'eval \"\$(printf %s $(base64 -w0 <<<"$remote_script") | base64 -d)\"'")
fi

if [[ $inline == "true" ]]; then
  exec "${command[@]}"
else
  # A fixed app-id rather than the default org.omarchy.<binary>, so every agent
  # window shares one class for window rules and themes to single out.
  exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
fi

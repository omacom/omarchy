#!/usr/bin/python3
# omarchy:summary=Choose an installed local Ollama model and start an interactive chat
# omarchy:args=[--model <model>]
# omarchy:examples=omarchy launch ai-chat | omarchy launch ai-chat --model qwen3:4b

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request


def request(path, payload=None):
  opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
  req = urllib.request.Request("http://127.0.0.1:11434/api/" + path,
    data=json.dumps(payload).encode() if payload is not None else None,
    headers={"Content-Type": "application/json"})
  with opener.open(req, timeout=10) as response:
    return json.load(response)


def main():
  parser = argparse.ArgumentParser(description="Start Ollama chat with an installed local text model. Run in a terminal for the model picker, or pass --model. Does not download models or use OLLAMA_HOST.")
  parser.add_argument("--model")
  args = parser.parse_args()
  if not args.model and not sys.stdin.isatty():
    parser.error("run in a terminal for the model picker, or pass --model")
  if subprocess.run(["omarchy-cmd-missing", "ollama"]).returncode == 0:
    raise ValueError("Install Ollama first from Install > AI > Ollama.")
  models = sorted({item["name"] for item in request("tags").get("models", [])
    if isinstance(item, dict) and isinstance(item.get("name"), str) and item["name"]})
  if not models:
    raise ValueError("No installed models. Download a text model with ollama pull first.")
  model = args.model
  if model is None:
    choice = subprocess.run(["gum", "choose", "--header", "Chat with an installed model", "--", *models], stdout=subprocess.PIPE, text=True)
    if choice.returncode in (1, 130):
      return 0
    choice.check_returncode()
    if not choice.stdout.strip():
      return 0
    model = choice.stdout.strip()
  if model not in models:
    if model + ":latest" in models:
      model += ":latest"
    else:
      raise ValueError("Choose an installed model; this command does not download models.")
  metadata = request("show", {"model": model})
  if metadata.get("remote_host") or metadata.get("remote_model"):
    raise ValueError("Choose a downloaded local model; cloud models are not supported.")
  if "completion" not in metadata.get("capabilities", []):
    raise ValueError("Choose a text completion model, rather than an embedding or speech model.")
  os.execvpe("ollama", ["ollama", "run", model], dict(os.environ, OLLAMA_HOST="http://127.0.0.1:11434"))
  return 0


if __name__ == "__main__":
  try:
    sys.exit(main())
  except KeyboardInterrupt:
    sys.exit(130)
  except (OSError, ValueError, subprocess.SubprocessError, urllib.error.URLError) as error:
    print(f"Local chat: {error}", file=sys.stderr)
    sys.exit(1)

#!/bin/bash
# omarchy:summary=Choose the shortcut for switching input language
# omarchy:group=menu
# omarchy:name=keyboard-shortcuts

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/keyboard-shortcut"
DEFAULT="SUPER + I"
CHECK="✓"

# Supported shortcuts, in the order shown by the menu. This is the single list
# the menu, the validation and the Hyprland bindings all agree on.
options=(
  "ALT + SHIFT"
  "SUPER + I"
)

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

is_known() {
  local opt
  for opt in "${options[@]}"; do
    [[ $1 == $opt ]] && return 0
  done
  return 1
}

mkdir -p "$(dirname "$CONFIG")"

# First run (or an empty file): store the default so the Hyprland config always
# has something to read.
if [[ ! -s $CONFIG ]]; then
  printf '%s\n' "$DEFAULT" > "$CONFIG"
fi

# The Hyprland config reads only the first line, so do the same here.
stored=""
IFS= read -r stored < "$CONFIG" || true
stored="$(trim "$stored")"

current="$stored"

# Anything else unrecognised behaves as the default in input-method.lua, so that
# is the row that should carry the tick.
is_known "$current" || current="$DEFAULT"

# Mark the active shortcut with a tick after its name ("ALT + SHIFT ✓"), like
# the other Omarchy menus. The rows are plain text only: omarchy-menu-select
# takes the prompt followed by the options and nothing else, so any extra flag
# would show up as a menu row.
labels=()
for opt in "${options[@]}"; do
  if [[ $current == $opt ]]; then
    labels+=("$opt $CHECK")
  else
    labels+=("$opt")
  fi
done

# Escape / closing the menu is not an error, it just leaves everything as is.
picked="$("$OMARCHY_PATH/bin/omarchy-menu-select" "Language shortcut" "${labels[@]}")" || exit 0

# Strip the tick and padding again to get back the real shortcut name.
picked="$(trim "$picked")"
picked="$(trim "${picked%"$CHECK"}")"
[[ -z $picked ]] && exit 0

if ! is_known "$picked"; then
  echo "Unknown input language shortcut: $picked" >&2
  exit 1
elif [[ $stored == $picked ]]; then
  printf 'Input language switcher is already %s\n' "$picked"
else
  # Persist the choice to the config file the Hyprland config reads. Write to a
  # temp file and rename so Hyprland never reads a half-written file.
  tmp="$(mktemp "$CONFIG.XXXXXX")"
  printf '%s\n' "$picked" > "$tmp"
  mv -f "$tmp" "$CONFIG"

  # Reload Hyprland so the new binding takes effect immediately.
  hyprctl reload >/dev/null 2>&1 || true

  printf 'Input language switcher set to %s\n' "$picked"
fi

#!/bin/bash

# omarchy:summary=Install llama.cpp and a local chat service
# omarchy:requires-sudo=true

set -euo pipefail

packages=(llama-cpp)
if omarchy-cmd-present nvidia-smi; then
  packages+=(ggml-cuda)
elif omarchy-cmd-present rocminfo || omarchy-cmd-present rocm-smi; then
  packages+=(ggml-hip)
else
  packages+=(ggml-vulkan)
fi
omarchy-pkg-add "${packages[@]}"

mkdir -p "$HOME/models"
if [[ ! -e $HOME/models/chat.gguf ]]; then
  first=$(find "$HOME/models" -name '*.gguf' ! -name 'chat.gguf' -print -quit || true)
  if [[ -n $first ]]; then
    ln -s "$first" "$HOME/models/chat.gguf"
  else
    echo "Drop a .gguf on $HOME/models/chat.gguf when you have one."
  fi
fi

unit="$OMARCHY_PATH/default/systemd/user/omarchy-ml-chat.service"
dest="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/omarchy-ml-chat.service"
install -Dm644 "$unit" "$dest"
systemctl --user daemon-reload
systemctl --user enable --now omarchy-ml-chat.service || true

echo "Super + Alt + Shift + C opens the local chat."

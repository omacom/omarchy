#!/bin/bash

# omarchy:summary=Enable, disable, or toggle a Hyprland input device
# omarchy:args=<touchpad|touchscreen> [on|off|toggle]
# omarchy:hidden=true

KIND="${1:-}"
ACTION="${2:-toggle}"

usage() {
  echo "Usage: omarchy-toggle-input-device <touchpad|touchscreen> [on|off|toggle]" >&2
}

case "$KIND" in
  touchpad) LABEL="Touchpad" ICON="touchpad" ;;
  touchscreen) LABEL="Touchscreen" ICON="touch" ;;
  *)
    usage
    exit 1
    ;;
esac

# The persisted disable is one device name per line; on every reload
# default/hypr/disabled-input-device.lua reads them back and disables each.
# A touchpad line may be followed by its -mouse sibling. Names come from USB
# descriptors and must not be interpolated into shell or Lua. The path is
# hardcoded to ~/.local/state like the sibling toggle tools, so it keeps
# working when XDG_STATE_HOME diverges.
NAME_FILE="$HOME/.local/state/omarchy/toggles/hypr/$KIND-disabled-name"

device="$("omarchy-hw-$KIND")"

require_device() {
  if [[ -z $device ]]; then
    echo "No $KIND device found" >&2
    exit 1
  fi

  if [[ $device == *[[:cntrl:]]* ]]; then
    echo "Invalid $KIND device name" >&2
    exit 1
  fi
}

# Precision touchpads often expose a kernel mouse-emulation node next to the
# -touchpad node (msft0001:00-093a:0255-mouse). Toggling only the touchpad
# leaves that sibling enabled and desyncs finger tracking.
#
# The sibling is chosen by name. On some touchpad-plus-pointing-stick
# controllers the stick's events share that -mouse node, and udev's
# pointing-stick tag does not separate them for I2C *Mouse nodes. Turning the
# touchpad off then turns the stick off as well, until the touchpad is turned
# back on. A failed `hyprctl devices` query skips the sibling instead of guessing.
related_devices() {
  local primary=$1
  printf '%s\n' "$primary"
  [[ $KIND == touchpad ]] || return 0
  [[ $primary =~ ^(.*)-(touchpad|trackpad)$ ]] || return 0

  local sibling="${BASH_REMATCH[1]}-mouse"
  [[ $sibling != "$primary" ]] || return 0
  [[ $sibling != *[[:cntrl:]]* ]] || return 0

  local json
  json=$(hyprctl devices -j 2>/dev/null) || return 0
  [[ -n $json ]] || return 0
  jq -e --arg n "$sibling" '.mice[]? | select(.name == $n)' >/dev/null <<<"$json" || return 0
  printf '%s\n' "$sibling"
}

apply_device() {
  local enabled=$1
  local name=$2
  local quoted=${name//\\/\\\\}
  quoted=${quoted//\"/\\\"}
  hyprctl eval "hl.device({ name = \"$quoted\", enabled = $enabled })" >/dev/null
}

apply_devices() {
  local enabled=$1
  local name
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    apply_device "$enabled" "$name"
  done
}

enable() {
  # `on` must re-enable the sibling that `off` persisted even when a later
  # `hyprctl devices` query fails and related_devices can no longer see it.
  # Apply those names before requiring a
  # live device: omarchy-hw-* asks the compositor itself, and a failed query
  # used to delete the file and leave both nodes disabled.
  local saved=""
  [[ -f $NAME_FILE ]] && saved=$(<"$NAME_FILE")
  local -A seen=()
  local name
  local restore_status=0
  while IFS= read -r name; do
    [[ -n $name ]] || continue
    [[ -n ${seen[$name]:-} ]] && continue
    seen[$name]=1
    apply_device true "$name" || restore_status=1
  done <<<"$saved"

  if (( restore_status != 0 )); then
    echo "Failed to enable $KIND; saved disable state retained for retry" >&2
    return 1
  fi

  # Clear successfully restored names even if the live device query fails.
  # Failed IPC above retains them, so the next toggle retries on rather than off.
  rm -f "$NAME_FILE" || return 1

  require_device

  while IFS= read -r name; do
    [[ -n $name ]] || continue
    [[ -n ${seen[$name]:-} ]] && continue
    seen[$name]=1
    apply_device true "$name" || return 1
  done < <(related_devices "$device")

  omarchy-osd -i "$ICON" -m "$LABEL enabled"
}

disable() {
  require_device
  local names
  names=$(related_devices "$device")
  apply_devices false <<<"$names"

  # A repeated off whose devices query fails must keep the sibling the last off
  # saved, or on can no longer re-enable it.
  if [[ -f $NAME_FILE ]]; then
    names=$(printf '%s\n%s\n' "$names" "$(<"$NAME_FILE")" | awk 'NF && !seen[$0]++')
  fi

  mkdir -p "$(dirname "$NAME_FILE")"
  printf '%s\n' "$names" >"$NAME_FILE"
  omarchy-osd -i "$ICON" -m "$LABEL disabled"
}

case "$ACTION" in
  on) enable ;;
  off) disable ;;
  toggle) if [[ -f $NAME_FILE ]]; then enable; else disable; fi ;;
  *)
    usage
    exit 1
    ;;
esac

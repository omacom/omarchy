#!/bin/bash

# omarchy:summary=Set the default audio output and move active streams
# omarchy:args=<node-id> <sink-name>
# omarchy:examples=omarchy audio output set default 42 alsa_output.pci-0000_00_1f.3.analog-stereo

node_id=${1:-}
sink_name=${2:-}

if [[ -z $node_id || -z $sink_name ]]; then
  echo "Usage: omarchy-audio-output-set-default <node-id> <sink-name>" >&2
  exit 1
fi

timeout 2 wpctl set-default "$node_id" 2>/dev/null || true
timeout 2 pactl set-default-sink "$sink_name" 2>/dev/null || true

# Pulse stream indices differ from PipeWire node ids used by target.object.
# If pins cannot be read, leave stream movement to the session manager.
metadata=$(timeout 2 pw-metadata -n default 2>/dev/null) || exit 0
pinned_nodes=$(awk -F "'" '
  $2 == "target.object" && $4 != "" && $4 != "-1" {
    node = $1
    sub(/.*id:/, "", node)
    sub(/ .*/, "", node)
    if (node ~ /^[0-9]+$/) print node
  }' <<<"$metadata")

# DSP and EasyEffects streams keep their processing links, and pinned apps
# keep their explicit output while the remaining applications follow default.
LC_ALL=C timeout 2 pactl -f json list sink-inputs 2>/dev/null |
  jq -r --arg pins "$pinned_nodes" '
    ($pins | split("\n")) as $pinned |
    .[] |
    select(.properties["object.id"] != null) |
    select(.properties["application.name"] != null and .properties["application.name"] != "EasyEffects") |
    select((.properties["object.id"] | tostring) as $node | $pinned | index($node) | not) |
    .index' | while read -r input; do
    [[ -n $input ]] && timeout 2 pactl move-sink-input "$input" "$sink_name" 2>/dev/null || true
  done

#!/usr/bin/python3
# omarchy:summary=Read clipboard text aloud with an installed Piper voice
# omarchy:args=--model <voice.onnx> [--rate <0.5-2.0>] [--speaker <id>]
# omarchy:examples=omarchy clipboard speak --model ~/Models/en_US-lessac-medium.onnx | omarchy clipboard speak --model ~/Models/voice.onnx --rate 1.25

import argparse
import os
from pathlib import Path
import selectors
import subprocess
import sys
import tempfile
import time


MAX_CLIPBOARD_CHARS = 16_000
CLIPBOARD_READ_TIMEOUT = 2


def read_clipboard():
  argv = ["wl-paste", "--no-newline", "--type", "text"]
  # Allow four UTF-8 bytes per character and one sentinel byte. Do not drain
  # an oversized producer or accept partial input from a stalled owner.
  byte_limit = MAX_CLIPBOARD_CHARS * 4
  deadline = time.monotonic() + CLIPBOARD_READ_TIMEOUT
  data = bytearray()
  with subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as reader:
    assert reader.stdout is not None
    try:
      with selectors.DefaultSelector() as selector:
        selector.register(reader.stdout, selectors.EVENT_READ)
        while True:
          remaining = deadline - time.monotonic()
          if remaining <= 0 or not selector.select(remaining):
            raise TimeoutError("Clipboard read timed out.")
          chunk = os.read(reader.stdout.fileno(), min(16384, byte_limit + 1 - len(data)))
          if not chunk:
            break
          data.extend(chunk)
          if len(data) > byte_limit:
            raise ValueError("Copy between 1 and 16,000 characters of text first.")
      try:
        code = reader.wait(timeout=max(0, deadline - time.monotonic()))
      except subprocess.TimeoutExpired as error:
        raise TimeoutError("Clipboard read timed out.") from error
      if code:
        raise subprocess.CalledProcessError(code, argv)
    finally:
      if reader.poll() is None:
        reader.kill()
  return data.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")


def main():
  parser = argparse.ArgumentParser(description="Read copied text aloud with a local Piper neural voice. Requires piper-tts or piper, a downloaded .onnx voice and its .onnx.json config. The clipboard is left intact.")
  parser.add_argument("--model", type=Path, required=True)
  parser.add_argument("--rate", type=float, default=1.0, help="Playback rate, 0.5 to 2.0 (default 1)")
  parser.add_argument("--speaker", type=int, default=0)
  args = parser.parse_args()
  if not 0.5 <= args.rate <= 2.0 or args.speaker < 0:
    parser.error("rate must be between 0.5 and 2.0, and speaker must be nonnegative")
  model = args.model.expanduser().resolve(strict=True)
  config = Path(str(model) + ".json")
  if not model.is_file() or not config.is_file():
    raise ValueError("Choose a voice file with its matching .onnx.json config beside it.")
  engine = None
  for candidate in ("piper-tts", "piper"):
    if subprocess.run(["omarchy-cmd-present", candidate]).returncode == 0:
      engine = candidate
      break
  if engine is None:
    raise ValueError("Install Piper first (piper-tts or piper).")
  text = read_clipboard()
  if not text.strip() or len(text) > MAX_CLIPBOARD_CHARS:
    raise ValueError("Copy between 1 and 16,000 characters of text first.")

  with tempfile.TemporaryDirectory(prefix="omarchy-speak-") as scratch:
    audio = Path(scratch) / "speech.wav"
    subprocess.run([engine, "-m", str(model), "-c", str(config), "-f", str(audio),
      "--length_scale", str(1 / args.rate), "-s", str(args.speaker)], input=text,
      text=True, stdout=sys.stderr, check=True)
    if not audio.is_file() or audio.stat().st_size == 0:
      raise ValueError("Piper produced no audio.")
    subprocess.run(["pw-play", str(audio)], check=True)
  return 0


if __name__ == "__main__":
  try:
    sys.exit(main())
  except KeyboardInterrupt:
    sys.exit(130)
  except (OSError, ValueError, subprocess.SubprocessError) as error:
    print(f"Read clipboard: {error}", file=sys.stderr)
    sys.exit(1)

#!/bin/bash

# omarchy:summary=Pause or resume Hyprland config auto-reload around package transactions.
# omarchy:hidden=true

set -euo pipefail

command="${1:-}"
case "$command" in
  pause | resume | paused) ;;
  *)
    echo "Usage: omarchy-hyprland-reload-guard pause|resume|paused" >&2
    exit 1
    ;;
esac

run_root="${OMARCHY_HYPRLAND_RELOAD_GUARD_RUN_ROOT:-/run/user}"
state_dir="${OMARCHY_HYPRLAND_RELOAD_GUARD_STATE_DIR:-/run/omarchy/hyprland-reload-guard}"
# A pause is a system-wide fact (a pacman transaction is in flight), but the
# per-instance state files in state_dir carry another user's runtime_dir and
# settings, so that directory stays root-only. This marker is the public half:
# empty, world-readable, and sibling to state_dir rather than inside it, so a
# session user can check it exists without needing to read anything private.
pause_marker="$state_dir.active"
hyprctl_bin="${HYPRCTL:-/usr/bin/hyprctl}"
setpriv_bin="${SETPRIV:-/usr/bin/setpriv}"
# Exists only so tests can exercise the privileged (EUID 0) code path without
# actually running as root. Overriding it can only make this script *more*
# restrictive (it forces the privilege-drop branch on), never less, so it is
# not a usable bypass.
effective_uid="${OMARCHY_HYPRLAND_RELOAD_GUARD_EFFECTIVE_UID:-$EUID}"

valid_bool() {
  [[ $1 == "true" || $1 == "false" ]]
}

# Fast, early rejection of a path that is obviously wrong (no socket there at
# all, or one plainly owned by someone else) before spending a subprocess on
# it. This alone cannot be the real boundary -- it is a stat(), and a user
# who controls this path can swap it for a symlink after this check returns
# true but before hyprctl_instance's connection actually happens. Closing
# that race is hyprctl_instance's job, not this function's.
verify_socket_owner() {
  local runtime_dir="$1"
  local signature="$2"
  local uid="${runtime_dir##*/}"
  local socket="$runtime_dir/hypr/$signature/.socket.sock"
  local type owner

  [[ $uid =~ ^[0-9]+$ ]] || return 1
  # Unfollowed stat: a symlink standing in for the socket must be rejected
  # outright, not resolved and checked against its target's owner.
  read -r type owner < <(stat -c '%F %u' -- "$socket" 2>/dev/null) || return 1
  [[ $type == "socket" && $owner == $uid ]]
}

hyprctl_instance() {
  local runtime_dir="$1"
  local signature="$2"
  shift 2

  verify_socket_owner "$runtime_dir" "$signature" || return 1

  # verify_socket_owner only proves the socket looked right at the moment of
  # its stat() above; a user who controls this path can still swap it for a
  # symlink into another user's socket between that stat and the connect()
  # hyprctl performs next -- a stat-then-connect race no amount of rechecking
  # beforehand can close. What makes that race worth anything to an attacker
  # is that root's connect() bypasses the target socket's own permissions
  # (DAC_OVERRIDE). So when running as root, drop to the uid this path claims
  # before connecting: the kernel's own socket permission check at connect()
  # time becomes the actual boundary, and a raced swap can then only ever
  # reach a socket that uid could already connect to on its own.
  if (( effective_uid == 0 )); then
    local uid="${runtime_dir##*/}" gid
    gid=$(id -g "$uid" 2>/dev/null) || return 1
    XDG_RUNTIME_DIR="$runtime_dir" "$setpriv_bin" \
      --reuid="$uid" --regid="$gid" --clear-groups --no-new-privs \
      -- "$hyprctl_bin" --instance "$signature" "$@"
  else
    XDG_RUNTIME_DIR="$runtime_dir" "$hyprctl_bin" --instance "$signature" "$@"
  fi
}

option_bool() {
  local runtime_dir="$1"
  local signature="$2"
  local option="$3"

  # A dead instance makes hyprctl print "Couldn't connect ..." on stdout, so
  # silence jq too and let the failed pipeline skip the instance.
  hyprctl_instance "$runtime_dir" "$signature" -j getoption "$option" 2>/dev/null | jq -r '.bool' 2>/dev/null
}

instances() {
  local instance_dir signature hypr_dir runtime_dir uid

  [[ -d $run_root ]] || return 0

  for instance_dir in "$run_root"/*/hypr/*; do
    [[ -d $instance_dir && ! -L $instance_dir ]] || continue

    signature="${instance_dir##*/}"
    hypr_dir="${instance_dir%/*}"
    runtime_dir="${hypr_dir%/*}"
    uid="${runtime_dir##*/}"

    [[ $uid =~ ^[0-9]+$ ]] || continue
    [[ ! -L $runtime_dir && ! -L $hypr_dir ]] || continue

    # Every directory on the way to the instance must belong to the uid its
    # own path claims. A directory this script would otherwise treat as
    # another user's instance, but that the calling uid actually owns, is a
    # forged one.
    read -r owner < <(stat -c '%u' -- "$runtime_dir" 2>/dev/null) || continue
    [[ $owner == $uid ]] || continue
    read -r owner < <(stat -c '%u' -- "$hypr_dir" 2>/dev/null) || continue
    [[ $owner == $uid ]] || continue
    read -r owner < <(stat -c '%u' -- "$instance_dir" 2>/dev/null) || continue
    [[ $owner == $uid ]] || continue

    printf '%s\t%s\n' "$runtime_dir" "$signature"
  done
}

pause_instance() {
  local runtime_dir="$1"
  local signature="$2"
  local disable_autoreload suppress_errors state_file="$state_dir/$signature"

  mkdir -p -m 0700 "$state_dir"

  if [[ ! -f $state_file ]]; then
    disable_autoreload=$(option_bool "$runtime_dir" "$signature" misc.disable_autoreload) || return 0
    suppress_errors=$(option_bool "$runtime_dir" "$signature" debug.suppress_errors) || return 0
    # These two values are about to be interpolated into a Lua eval sent to
    # root's hyprctl on resume. Accept only the two literal values hyprctl's
    # own JSON output can produce for a bool option; anything else is a
    # compromised or spoofed instance and must not reach that eval.
    valid_bool "$disable_autoreload" || return 0
    valid_bool "$suppress_errors" || return 0
    printf '%s\t%s\t%s\n' "$runtime_dir" "$disable_autoreload" "$suppress_errors" >"$state_file"
  fi

  hyprctl_instance "$runtime_dir" "$signature" eval \
    'hl.config({ misc = { disable_autoreload = true }, debug = { suppress_errors = true } })' \
    >/dev/null 2>&1 || true
}

resume_instance() {
  local state_file="$1"
  local signature="${state_file##*/}"
  local runtime_dir disable_autoreload suppress_errors

  IFS=$'\t' read -r runtime_dir disable_autoreload suppress_errors <"$state_file" || return 0

  # Re-validate even though pause_instance already checked: the state file
  # comes from the same place the socket swap would come from, and a
  # defense that only checks once is a defense with exactly one gap.
  valid_bool "$disable_autoreload" || { rm -f "$state_file"; return 0; }
  valid_bool "$suppress_errors" || { rm -f "$state_file"; return 0; }

  if [[ -d $runtime_dir ]]; then
    hyprctl_instance "$runtime_dir" "$signature" eval \
      "hl.config({ debug = { suppress_errors = $suppress_errors } })" \
      >/dev/null 2>&1 || true

    hyprctl_instance "$runtime_dir" "$signature" reload >/dev/null 2>&1 || true

    hyprctl_instance "$runtime_dir" "$signature" eval \
      "hl.config({ misc = { disable_autoreload = $disable_autoreload }, debug = { suppress_errors = $suppress_errors } })" \
      >/dev/null 2>&1 || true
  fi

  rm -f "$state_file"
}

case "$command" in
  paused)
    [[ -e $pause_marker ]]
    ;;
  pause)
    # Created before state_dir, and without -m: a mode given to mkdir -p
    # applies to every directory it creates along the path, so combining
    # this step with state_dir's own -m 0700 would have left this parent
    # (and the marker beside state_dir) just as unreadable to a session
    # user as state_dir itself. Self-heals a parent an older build of this
    # script already left too-restrictive within the same boot.
    parent_dir="${state_dir%/*}"
    mkdir -p "$parent_dir"
    chmod 0755 "$parent_dir" 2>/dev/null || true
    : >"$pause_marker"
    chmod 0644 "$pause_marker"

    while IFS=$'\t' read -r runtime_dir signature; do
      pause_instance "$runtime_dir" "$signature"
    done < <(instances)
    ;;
  resume)
    if [[ -d $state_dir ]]; then
      for state_file in "$state_dir"/*; do
        [[ -f $state_file ]] || continue
        resume_instance "$state_file"
      done
      rmdir "$state_dir" 2>/dev/null || true
    fi
    # Removed last, and unconditionally: a pause with nothing left to
    # resume (or nothing that was ever paused) is still a pause the marker
    # must keep reporting true for until this point.
    rm -f "$pause_marker"
    ;;
esac

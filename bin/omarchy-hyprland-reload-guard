#!/bin/bash

# omarchy:summary=Pause or resume Hyprland config auto-reload around package transactions.
# omarchy:hidden=true

set -euo pipefail

command="${1:-}"
case "$command" in
  pause | resume | paused) ;;
  *)
    echo "Usage: omarchy-hyprland-reload-guard pause|resume|paused" >&2
    exit 1
    ;;
esac

run_root="${OMARCHY_HYPRLAND_RELOAD_GUARD_RUN_ROOT:-/run/user}"
state_dir="${OMARCHY_HYPRLAND_RELOAD_GUARD_STATE_DIR:-/run/omarchy/hyprland-reload-guard}"
hyprctl_bin="${HYPRCTL:-/usr/bin/hyprctl}"
proc_root="${OMARCHY_HYPRLAND_RELOAD_GUARD_PROC_ROOT:-/proc}"
declare -A account_budgets=()
deferred_state_files=()
failed_state_files=()
deadline=0

umask 077

valid_instance() {
  local runtime_dir="$1" signature="$2" uid="${1##*/}" directory

  [[ $uid =~ ^(0|[1-9][0-9]*)$ && $runtime_dir == "$run_root/$uid" ]] || return 1
  [[ $signature =~ ^[a-zA-Z0-9_-][a-zA-Z0-9_.-]{0,254}$ ]] || return 1
  (( EUID == 0 || EUID == uid )) || return 1

  for directory in "$runtime_dir" "$runtime_dir/hypr" "$runtime_dir/hypr/$signature"; do
    [[ -d $directory && ! -L $directory && $(stat -c %u -- "$directory") == "$uid" ]] || return 1
  done
}

with_account_budget() {
  local uid="$1" remaining status=0
  shift

  # Charge only this account's work. In particular, legacy state can revisit a
  # UID after another account has spent its allowance on unresponsive sockets.
  deadline=$((SECONDS + ${account_budgets[$uid]:-4}))
  "$@" || status=$?
  remaining=$((deadline - SECONDS))
  (( remaining < 0 )) && remaining=0
  account_budgets[$uid]=$remaining
  return "$status"
}

hyprctl_instance() {
  local runtime_dir="$1"
  local signature="$2" uid="${1##*/}" gid remaining
  shift 2

  remaining=$((deadline - SECONDS))
  (( remaining > 0 )) || return 1
  (( remaining > 2 )) && remaining=2

  # Checks on user-owned paths can race. Drop all root access before hyprctl
  # resolves a socket, so a replacement cannot borrow root's access to a peer.
  if (( EUID == 0 )); then
    gid=$(id -g "+$uid") || return 1
    timeout -k 1 "$remaining" setpriv --reuid "$uid" --regid "$gid" --clear-groups \
      --inh-caps=-all --ambient-caps=-all --bounding-set=-all --no-new-privs \
      env -i PATH=/usr/bin:/bin XDG_RUNTIME_DIR="$runtime_dir" \
      "$hyprctl_bin" --instance "$signature" "$@"
  else
    timeout -k 1 "$remaining" env -i PATH=/usr/bin:/bin XDG_RUNTIME_DIR="$runtime_dir" \
      "$hyprctl_bin" --instance "$signature" "$@"
  fi
}

hyprctl_ok() {
  local response

  # Some compositor refusals still produce a successful hyprctl exit status.
  response=$(hyprctl_instance "$@" 2>/dev/null | head -c 4097) || return 1
  [[ $response == "ok" ]]
}

option_bool() {
  local runtime_dir="$1"
  local signature="$2"
  local option="$3" response

  # A dead instance makes hyprctl print "Couldn't connect ..." on stdout, so
  # silence jq too and let the failed pipeline skip the instance.
  response=$(hyprctl_instance "$runtime_dir" "$signature" -j getoption "$option" 2>/dev/null | head -c 4097) || return 1
  (( ${#response} <= 4096 )) || return 1
  # Do not use jq -e: false is a legitimate saved setting, not a failed probe.
  jq -sr 'if length == 1 and (.[0].bool | type) == "boolean" then .[0].bool else error("expected one boolean") end' \
    <<<"$response" 2>/dev/null
}

instances() {
  local instance_dir signature runtime_dir uid

  [[ -d $run_root ]] || return 0

  for runtime_dir in "$run_root"/*; do
    uid="${runtime_dir##*/}"
    [[ $uid =~ ^(0|[1-9][0-9]*)$ && -d $runtime_dir/hypr && ! -L $runtime_dir && ! -L $runtime_dir/hypr ]] || continue
    # Bound each account's work, including enumeration of fake instances.
    while IFS= read -r -d '' instance_dir; do
      signature="${instance_dir##*/}"
      valid_instance "$runtime_dir" "$signature" || continue
      printf '%s\t%s\n' "$runtime_dir" "$signature"
    done < <(find "$runtime_dir/hypr" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null | head -z -n 16)
  done
}

write_state() {
  local state_file="$1" runtime_dir="$2" disable_autoreload="$3" suppress_errors="$4" reference="${5:-}"
  local temporary

  temporary=$(mktemp "${state_file%/*}/.state.XXXXXX") || return 1
  if printf '%s\t%s\t%s\n' "$runtime_dir" "$disable_autoreload" "$suppress_errors" >"$temporary" &&
    { [[ -z $reference ]] || touch -r "$reference" "$temporary"; } &&
    mv -T -- "$temporary" "$state_file"; then
    return 0
  else
    rm -f -- "$temporary"
    return 1
  fi
}

mark_paused() {
  [[ ! -e $state_dir/paused || -f $state_dir/paused ]] && [[ ! -L $state_dir/paused ]] || return 1
  touch "$state_dir/paused" || return 1
  chmod 0644 "$state_dir/paused" || return 1
}

pause_instance() {
  local runtime_dir="$1"
  local signature="$2"
  local uid="${1##*/}" disable_autoreload suppress_errors
  local state_file="$state_dir/private/$uid/$signature"

  valid_instance "$runtime_dir" "$signature" || return 0
  # Budget calls capture status in a conditional, so errexit does not protect
  # these writes. Never pause a session before its recovery state is published.
  install -d -m 0755 "$state_dir" || return 1
  install -d -m 0700 "$state_dir/private" "$state_dir/private/$uid" || return 1

  if [[ ! -f $state_file ]]; then
    disable_autoreload=$(option_bool "$runtime_dir" "$signature" misc.disable_autoreload) || return 0
    suppress_errors=$(option_bool "$runtime_dir" "$signature" debug.suppress_errors) || return 0
    write_state "$state_file" "$runtime_dir" "$disable_autoreload" "$suppress_errors" || return 1
  fi

  # The monitor watcher needs to see a pause without reading private state.
  mark_paused || return 1
  hyprctl_ok "$runtime_dir" "$signature" eval \
    'hl.config({ misc = { disable_autoreload = true }, debug = { suppress_errors = true } })' \
    >/dev/null 2>&1 || true
}

# A transaction that upgraded Hyprland replaced the binary under the running
# compositor, which the kernel then reports as deleted. That compositor predates
# the config the transaction installed and errors on keys added since.
running_replaced_binary() {
  local runtime_dir="$1"
  local signature="$2"
  local pid executable

  pid=$(hyprctl_instance "$runtime_dir" "$signature" -j instances 2>/dev/null |
    head -c 65536 |
    jq -r --arg signature "$signature" '.[] | select(.instance == $signature) | .pid' 2>/dev/null) || return 2
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 2
  executable=$(readlink "$proc_root/$pid/exe" 2>/dev/null) || return 2
  [[ $executable == *" (deleted)" ]]
}

restore_instance() {
  local runtime_dir="$1" signature="$2" disable_autoreload="$3" suppress_errors="$4"
  local replaced=0 status=0

  # A failed query is not evidence that the running binary is compatible.
  running_replaced_binary "$runtime_dir" "$signature" || replaced=$?
  (( replaced == 0 )) && return 0
  (( replaced == 1 )) || return 1

  hyprctl_ok "$runtime_dir" "$signature" eval \
    "hl.config({ debug = { suppress_errors = $suppress_errors } })" \
    >/dev/null 2>&1 || status=1

  hyprctl_ok "$runtime_dir" "$signature" reload >/dev/null 2>&1 || status=1

  # Even if reload failed, try to undo the pause. Keep the original state if
  # any step failed, so a subsequent attempt can still complete restoration.
  hyprctl_ok "$runtime_dir" "$signature" eval \
    "hl.config({ misc = { disable_autoreload = $disable_autoreload }, debug = { suppress_errors = $suppress_errors } })" \
    >/dev/null 2>&1 || status=1
  return "$status"
}

resume_instance() {
  local state_file="$1"
  local signature="${state_file##*/}"
  local runtime_dir disable_autoreload suppress_errors uid

  [[ -f $state_file && ! -L $state_file ]] || return 0
  # Leave reloads off and errors hidden until the session restarts on the new
  # binary; both settings go with the old compositor.
  # A new resume can inherit old, flat state from the pre-upgrade pause. Treat
  # both layouts as untrusted data, even though their files are root-owned.
  if IFS=$'\t' read -r runtime_dir disable_autoreload suppress_errors <"$state_file" &&
    [[ $disable_autoreload =~ ^(true|false)$ && $suppress_errors =~ ^(true|false)$ ]] &&
    valid_instance "$runtime_dir" "$signature"; then
    uid="${runtime_dir##*/}"
    if [[ $state_file == "$state_dir/$signature" ]]; then
      # Pending recovery must not look like an active transaction to paused().
      install -d -m 0700 "$state_dir/private" "$state_dir/private/$uid" || return 1
      write_state "$state_dir/private/$uid/$signature" "$runtime_dir" "$disable_autoreload" "$suppress_errors" "$state_file" || return 1
      rm -f "$state_file" || return 1
      state_file="$state_dir/private/$uid/$signature"
    fi
    if [[ $state_file == "$state_dir/private/$uid/$signature" ]]; then
      if (( ${account_budgets[$uid]:-4} <= 0 )); then
        deferred_state_files+=("$state_file")
      elif with_account_budget "$uid" restore_instance "$runtime_dir" "$signature" "$disable_autoreload" "$suppress_errors"; then
        rm -f "$state_file"
      else
        # Move attempted failures behind untouched records on the next explicit
        # resume as well, so repeated bounded calls continue making progress.
        touch "$state_file"
        failed_state_files+=("$state_file")
      fi
      return 0
    fi
  fi

  rm -f "$state_file"
}

case "$command" in
  paused)
    # Retain detection of flat state for a watcher upgraded mid-transaction.
    for state_file in "$state_dir"/*; do
      [[ -f $state_file && ! -L $state_file ]] && exit 0
    done
    exit 1
    ;;
  pause)
    while IFS=$'\t' read -r runtime_dir signature; do
      with_account_budget "${runtime_dir##*/}" pause_instance "$runtime_dir" "$signature"
    done < <(instances)
    ;;
  resume)
    [[ -d $state_dir ]] || exit 0
    mark_paused
    while IFS= read -r -d '' state_record; do
      state_file="${state_record#* }"
      [[ -f $state_file && ! -L $state_file && $state_file != "$state_dir/paused" ]] || continue
      resume_instance "$state_file"
    done < <(LC_ALL=C find "$state_dir" -mindepth 1 -maxdepth 3 -type f -printf '%T@ %p\0' | LC_ALL=C sort -z -n)
    # One bounded retry, with untouched sessions ahead of endpoints that
    # already stalled. Retain anything still pending for an explicit resume.
    retry_files=("${deferred_state_files[@]}" "${failed_state_files[@]}")
    account_budgets=()
    deferred_state_files=()
    failed_state_files=()
    for state_file in "${retry_files[@]}"; do
      resume_instance "$state_file"
    done
    rm -f "$state_dir/paused"
    if (( ${#deferred_state_files[@]} + ${#failed_state_files[@]} > 0 )); then
      echo "Hyprland settings remain saved for recovery; run sudo omarchy-hyprland-reload-guard resume to retry." >&2
    fi
    rmdir "$state_dir/private/"* "$state_dir/private" 2>/dev/null || true
    rmdir "$state_dir" 2>/dev/null || true
    ;;
esac

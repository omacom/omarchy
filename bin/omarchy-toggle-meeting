#!/bin/bash

# omarchy:summary=Mute the mic, silence notifications, and stay awake for a call
# omarchy:group=toggle
# omarchy:name=meeting
# omarchy:args=[on|off|toggle|status]
# omarchy:examples=omarchy toggle meeting | omarchy toggle meeting off

set -euo pipefail

state_file() {
  local root="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
  mkdir -p "$root"
  printf '%s\n' "$root/meeting"
}

read_state() {
  local file
  file=$(state_file)
  idle_was="allow-idle"
  dnd_was="off"
  mic_was="live"
  active=0
  if [[ -f $file ]]; then
    # shellcheck disable=SC1090
    source "$file"
    active=1
  fi
}

write_state() {
  local file
  file=$(state_file)
  cat >"$file" <<EOF
idle_was=$idle_was
dnd_was=$dnd_was
mic_was=$mic_was
EOF
}

current_idle() {
  if omarchy-toggle-idle status | grep -q '"enabled":true'; then
    printf 'stay-awake\n'
  else
    printf 'allow-idle\n'
  fi
}

current_dnd() {
  local state
  state=$(omarchy-shell notifications dndState 2>/dev/null || true)
  case "$state" in
    on | off) printf '%s\n' "$state" ;;
    *) printf 'off\n' ;;
  esac
}

current_mic() {
  if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED; then
    printf 'muted\n'
  else
    printf 'live\n'
  fi
}

meeting_on() {
  read_state
  if ((active)); then
    omarchy-notification-send -g "mic" "$(omarchy-i18n meeting.title)" "$(omarchy-i18n meeting.alreadyOn)" || true
    printf 'on\n'
    return 0
  fi

  idle_was=$(current_idle)
  dnd_was=$(current_dnd)
  mic_was=$(current_mic)
  write_state

  omarchy-toggle-idle stay-awake >/dev/null
  omarchy-shell notifications setDnd on >/dev/null 2>&1 || true
  if [[ $mic_was == live ]]; then
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 >/dev/null 2>&1 || true
  fi
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
  omarchy-notification-send -g "mic" "$(omarchy-i18n meeting.onTitle)" "$(omarchy-i18n meeting.onBody)" || true
  printf 'on\n'
}

meeting_off() {
  read_state
  if ((!active)); then
    omarchy-notification-send -g "mic" "$(omarchy-i18n meeting.title)" "$(omarchy-i18n meeting.alreadyOff)" || true
    printf 'off\n'
    return 0
  fi

  if [[ $idle_was == allow-idle ]]; then
    omarchy-toggle-idle allow-idle >/dev/null
  fi
  if [[ $dnd_was == off ]]; then
    omarchy-shell notifications setDnd off >/dev/null 2>&1 || true
  fi
  if [[ $mic_was == live ]]; then
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 >/dev/null 2>&1 || true
  fi
  rm -f "$(state_file)"
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
  omarchy-notification-send -g "mic" "$(omarchy-i18n meeting.offTitle)" "$(omarchy-i18n meeting.offBody)" || true
  printf 'off\n'
}

case "${1:-toggle}" in
  on)
    meeting_on
    ;;
  off)
    meeting_off
    ;;
  toggle)
    read_state
    if ((active)); then
      meeting_off
    else
      meeting_on
    fi
    ;;
  status | --status)
    read_state
    if ((active)); then
      printf 'on\n'
    else
      printf 'off\n'
    fi
    ;;
  *)
    echo "Usage: omarchy-toggle-meeting [on|off|toggle|status]" >&2
    exit 1
    ;;
esac

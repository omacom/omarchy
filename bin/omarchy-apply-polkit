#!/bin/bash

# omarchy:summary=Configure lock-aware Polkit authentication
# omarchy:requires-sudo=true
# omarchy:hidden=true

set -euo pipefail

if (( EUID != 0 )); then
  echo "omarchy-apply-polkit must run as root" >&2
  exit 1
fi

# This runs during installation, migrations and authentication setup. Runtime
# PAM loads only the root-owned installed copies, never a user checkout.
export PATH=/usr/bin:/bin
umask 022
method=${1:-}
if (( $# > 1 )) || [[ -n $method && $method != "--fingerprint" && $method != "--fido2" ]]; then
  echo "Usage: omarchy-apply-polkit [--fingerprint|--fido2]" >&2
  exit 1
fi
# The root-owned directory is also a stable lock inode; no file in a shared
# writable runtime directory is opened with root's privileges.
exec 9</etc/pam.d
flock 9

# Runtime code belongs to the architecture-specific omarchy-polkit package. Fail
# before touching PAM if the matching package has not been installed yet.
for runtime in /usr/lib/security/pam_omarchy_lock.so /usr/lib/omarchy/polkit-lock-guard; do
  if [[ ! -f $runtime || -L $runtime ]]; then
    echo "Missing packaged Polkit guard: $runtime. Update Omarchy first." >&2
    exit 1
  fi
  owner=$(pacman -Qqo -- "$runtime")
  if [[ $owner != "omarchy-polkit" ]]; then
    echo "Polkit guard is not owned by omarchy-polkit: $runtime" >&2
    exit 1
  fi
done

/usr/bin/python3 -I - "$OMARCHY_PATH/default/pam/polkit-policy.py" "${method#--}" <<'PYTHON'
import runpy
import sys

policy = runpy.run_path(sys.argv[1])
policy["publish"]("/etc/pam.d/polkit-1", "/usr/lib/pam.d/polkit-1", sys.argv[2] or None)
PYTHON

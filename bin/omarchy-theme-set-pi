#!/bin/bash

# omarchy:summary=Sync the generated Omarchy Pi theme
# omarchy:args=[--activate]
# omarchy:hidden=true

set -euo pipefail

CURRENT_THEME_PATH="$HOME/.local/state/omarchy/current/theme"
PI_SOURCE_PATH="$CURRENT_THEME_PATH/pi.json"
PI_AGENT_DIR="$HOME/.pi/agent"
PI_THEME_DIR="$PI_AGENT_DIR/themes"
PI_THEME_PATH="$PI_THEME_DIR/omarchy-system.json"
PI_SETTINGS_PATH="$PI_AGENT_DIR/settings.json"
PI_ACTIVATE=0

usage() {
  echo "Usage: omarchy-theme-set-pi [--activate]"
}

for arg in "$@"; do
  case "$arg" in
    --activate)
      PI_ACTIVATE=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
done

if [[ ! -f $PI_SOURCE_PATH ]]; then
  if (( PI_ACTIVATE == 1 )); then
    echo "Pi theme source missing: $PI_SOURCE_PATH" >&2
    echo "Run omarchy-theme-refresh after selecting an Omarchy theme." >&2
    exit 1
  fi

  exit 0
fi

if (( PI_ACTIVATE == 0 )) && [[ ! -d $PI_AGENT_DIR ]]; then
  exit 0
fi

write_setting_theme() {
  local tmp

  mkdir -p "$PI_AGENT_DIR"

  if [[ -f $PI_SETTINGS_PATH ]]; then
    tmp=$(mktemp "$PI_SETTINGS_PATH.XXXXXX")
    # jq rejects a hand-edited settings.json (JSONC comments, trailing commas
    # are common there). The staged file must not outlive that failure: under
    # set -e the script would otherwise exit leaving settings.json.XXXXXX
    # litter beside a settings.json it never updated.
    if ! jq '.theme = "omarchy-system"' "$PI_SETTINGS_PATH" >"$tmp" || ! mv "$tmp" "$PI_SETTINGS_PATH"; then
      rm -f "$tmp"
      echo "omarchy-theme-set-pi: could not update $PI_SETTINGS_PATH" >&2
      return 1
    fi
  else
    cat >"$PI_SETTINGS_PATH" <<EOF
{
  "theme": "omarchy-system"
}
EOF
  fi
}

mkdir -p "$PI_THEME_DIR"
tmp=$(mktemp "$PI_THEME_PATH.XXXXXX")
if ! cp "$PI_SOURCE_PATH" "$tmp" || ! mv "$tmp" "$PI_THEME_PATH"; then
  rm -f "$tmp"
  echo "omarchy-theme-set-pi: could not write $PI_THEME_PATH" >&2
  exit 1
fi

if (( PI_ACTIVATE == 1 )); then
  write_setting_theme
fi

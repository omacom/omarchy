#!/bin/bash

# omarchy:summary=Run a named hook from ~/.config/omarchy/hooks/<name> and ~/.config/omarchy/hooks/<name>.d/.
# omarchy:args=[name] [args...]

set -e

if (( $# < 1 )); then
  echo "Usage: omarchy-hook [name] [args...]"
  exit 1
fi

HOOK=$1

# Hook names are fixed labels chosen by Omarchy code (post-update, theme-set,
# font-set). The name becomes a filename under the hooks directory. A slash
# would turn it into directory levels, and a bare `.` or `..` would point bash
# at the directory itself or its parent. Refuse those rather than follow them.
# Dots inside a name (a..b) are fine; once slashes are out, only the whole
# name being `.` or `..` can leave the directory.
if [[ -z $HOOK || $HOOK == */* || $HOOK == "." || $HOOK == ".." ]]; then
  echo "Invalid hook name: $HOOK" >&2
  exit 2
fi

HOOK_PATH="$HOME/.config/omarchy/hooks/$1"
HOOK_DIR="$HOOK_PATH.d"
shift

# Executable hooks keep their shebang (python, etc.). Non-executable files stay
# on bash so plain shell snippets without +x still work (#9845).
run_hook() {
  local hook=$1
  shift

  if [[ -x $hook ]]; then
    "$hook" "$@" || echo "Hook failed: $hook"
  else
    bash "$hook" "$@" || echo "Hook failed: $hook"
  fi
}

if [[ -f $HOOK_PATH ]]; then
  run_hook "$HOOK_PATH" "$@"
fi

if [[ -d $HOOK_DIR ]]; then
  for hook in "$HOOK_DIR"/*; do
    [[ -f $hook ]] || continue
    [[ $hook == *.sample ]] && continue
    run_hook "$hook" "$@"
  done
fi

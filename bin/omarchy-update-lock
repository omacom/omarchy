#!/bin/bash

# omarchy:summary=Run a command while holding the Omarchy update lock
# omarchy:args=<held|run> [command] [args...]
# omarchy:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
lock_path="$lock_dir/omarchy-update.lock"

# The wrapper process holds the flock. The command runs with the descriptor
# closed, so AUR daemons that outlive the update (Flutter's adb, for example)
# cannot keep the lock after we exit. held() asks whether that wrapper is still
# alive with the lock open, since a leftover process keeps the environment too.
lock_is_held() {
  local holder=${OMARCHY_UPDATE_LOCK_HOLDER:-}

  [[ $holder =~ ^[0-9]+:[0-9]+$ ]] || return 1
  [[ $(readlink -f "/proc/${holder%:*}/fd/${holder#*:}" 2>/dev/null) == "$(readlink -m "$lock_path")" ]]
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: omarchy-update-lock run <command> [args...]" >&2
      exit 2
    fi

    mkdir -p "$lock_dir" 2>/dev/null || true
    exec {OMARCHY_UPDATE_LOCK_FD}>"$lock_path"
    if ! flock -n "$OMARCHY_UPDATE_LOCK_FD"; then
      echo "An Omarchy update is already running."
      exit 1
    fi

    export OMARCHY_UPDATE_LOCK_HOLDER="$$:$OMARCHY_UPDATE_LOCK_FD"
    # A closing terminal signals the whole group; hold the lock until the update's own cleanup finishes.
    trap : HUP TERM
    "$@" {OMARCHY_UPDATE_LOCK_FD}>&-
    ;;
  *)
    echo "Usage: omarchy-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac

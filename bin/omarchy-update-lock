#!/bin/bash

# omarchy:summary=Run a command while holding the Omarchy update lock
# omarchy:args=<held|run> [command] [args...]
# omarchy:hidden=true

set -e

lock_dir="${XDG_RUNTIME_DIR:-/tmp/omarchy-$EUID}"
lock_path="$lock_dir/omarchy-update.lock"

ensure_lock_dir() {
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    mkdir -p "$lock_dir" 2>/dev/null || true
    return 0
  fi

  mkdir -m 700 -- "$lock_dir" 2>/dev/null || true
  if [[ -d $lock_dir && ! -L $lock_dir && -O $lock_dir ]]; then
    chmod 700 -- "$lock_dir"
    return 0
  fi

  echo "Refusing to use an unsafe update lock directory: $lock_dir" >&2
  return 1
}

lock_is_held() {
  local lock_fd_path=""

  [[ -n ${OMARCHY_UPDATE_LOCK_FD:-} && -e /proc/$$/fd/$OMARCHY_UPDATE_LOCK_FD ]] || return 1

  lock_fd_path=$(readlink -f "/proc/$$/fd/$OMARCHY_UPDATE_LOCK_FD" 2>/dev/null || true)
  [[ $lock_fd_path == "$(readlink -m "$lock_path")" ]] &&
    flock -n "$OMARCHY_UPDATE_LOCK_FD"
}

case "${1:-}" in
  held)
    lock_is_held
    ;;
  run)
    shift
    if (( $# == 0 )); then
      echo "Usage: omarchy-update-lock run <command> [args...]" >&2
      exit 2
    fi

    ensure_lock_dir
    if [[ -L $lock_path ]]; then
      echo "Refusing to follow symlinked update lock: $lock_path" >&2
      exit 1
    fi
    # Opening a contender must not erase the holder's diagnostic PID.
    old_umask=$(umask)
    umask 077
    exec {OMARCHY_UPDATE_LOCK_FD}<>"$lock_path"
    umask "$old_umask"
    if ! flock -n "$OMARCHY_UPDATE_LOCK_FD"; then
      echo "$(omarchy-i18n update.alreadyRunning)"
      owner_pid=""
      read -r owner_pid <"/proc/self/fd/$OMARCHY_UPDATE_LOCK_FD" || true
      if [[ $owner_pid =~ ^[0-9]+$ ]]; then
        echo "Update lock acquired by PID $owner_pid."
      fi
      exit 1
    fi

    # Informational only: children can inherit the flock and PIDs can be reused.
    # Never use this value (or the file's existence) to decide to unlock.
    printf '%s\n' "$$" >"/proc/self/fd/$OMARCHY_UPDATE_LOCK_FD"
    export OMARCHY_UPDATE_LOCK_FD
    exec "$@"
    ;;
  *)
    echo "Usage: omarchy-update-lock <held|run> [command] [args...]" >&2
    exit 2
    ;;
esac

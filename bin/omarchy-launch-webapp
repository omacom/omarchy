#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

browser=$(omarchy-cmd-default-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

# Read Exec= from the same data dirs omarchy-cmd-default-browser searched, as
# omarchy-launch-browser does, so a browser it resolved is one this can start.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# Like omarchy-launch-browser, keep an env prefix's variables for the launch
# and take the browser from the word after them.
browser_exec=""
browser_env=()
for data_dir in "${data_dirs[@]}"; do
  entry="$data_dir/applications/$browser"
  [[ -f $entry ]] || continue
  read -ra exec_words <<<"$(sed -n 's/^Exec=//p' "$entry" | head -1)"
  if [[ ${exec_words[0]:-} == "env" || ${exec_words[0]:-} == "/usr/bin/env" ]]; then
    exec_words=("${exec_words[@]:1}")
    while [[ ${exec_words[0]:-} == *=* ]]; do
      browser_env+=("${exec_words[0]}")
      exec_words=("${exec_words[@]:1}")
    done
  fi
  browser_exec=${exec_words[0]:-}
  break
done

# Handing an empty command to uwsm-app surfaces as "Command not found: \"\"",
# which fails a keybinding silently. A web app runs in a Chromium-based
# browser, so say that rather than claiming no browser is set.
if [[ -z $browser_exec ]]; then
  echo "omarchy-launch-webapp: web apps need a Chromium-based browser; install Chromium with 'omarchy install browser chromium'" >&2
  omarchy-notification-send -u critical -g 󰖟 "$(omarchy-i18n browser.webappNeedsChromium)" "$(omarchy-i18n browser.webappNeedsChromiumHint)"
  exit 1
fi

if (( ${#browser_env[@]} > 0 )); then
  launch_command=(env "${browser_env[@]}" "$browser_exec")
else
  launch_command=("$browser_exec")
fi

if ! env "${browser_env[@]}" omarchy-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- "${launch_command[@]}" --app="$1" "${@:2}"
fi

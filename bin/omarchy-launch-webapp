#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

# Parse the .desktop Exec= line into tokens, honouring the desktop-entry quoting
# rules, so a wrapped launcher (env VAR=val app, flatpak run App, ...) keeps
# its full command line instead of collapsing to its first token.
desktop_exec_tokens() {
  local line="$1"
  local token="" ch=""
  local quoted=false
  local i

  exec_tokens=()

  for (( i = 0; i < ${#line}; i++ )); do
    ch="${line:i:1}"

    if [[ $quoted == true ]]; then
      if [[ $ch == '"' ]]; then
        quoted=false
      elif [[ $ch == '\' ]]; then
        if (( i + 1 < ${#line} )); then
          token+="${line:i+1:1}"
          (( i++ ))
        else
          token+="$ch"
        fi
      else
        token+="$ch"
      fi
      continue
    fi

    case "$ch" in
      '"')
        quoted=true
        ;;
      '\')
        if (( i + 1 < ${#line} )); then
          token+="${line:i+1:1}"
          (( i++ ))
        else
          token+="$ch"
        fi
        ;;
      ' ' | $'\t')
        if [[ -n $token ]]; then
          exec_tokens+=("$token")
          token=""
        fi
        ;;
      *)
        token+="$ch"
        ;;
    esac
  done

  [[ -n $token ]] && exec_tokens+=("$token")
}

browser_file=""
for candidate in "$HOME/.local/share/applications" "$HOME/.nix-profile/share/applications" /usr/share/applications; do
  if [[ -f $candidate/$browser ]]; then
    browser_file="$candidate/$browser"
    break
  fi
done

if [[ -n $browser_file ]]; then
  exec_line=$(sed -n 's/^Exec=//p' "$browser_file" | head -1)
  desktop_exec_tokens "$exec_line"
else
  exec_tokens=("$browser")
fi

# Field codes %u/%U/%f/%F/%i/%c/%k never apply here: the web-app URL is passed
# as the browser's --app= argument instead.
final_tokens=()
for token in "${exec_tokens[@]}"; do
  case "$token" in
    %u | %U | %f | %F | %i | %c | %k) ;;
    *) final_tokens+=("$token") ;;
  esac
done

exec setsid uwsm-app -- "${final_tokens[@]}" --app="$1" "${@:2}"

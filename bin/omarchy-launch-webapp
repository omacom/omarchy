#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

browser=$(omarchy-cmd-default-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

# Parse the .desktop Exec= line into tokens, honouring the desktop-entry quoting
# rules, so a wrapped launcher (env VAR=val app, flatpak run App, ...) keeps
# its full command line instead of collapsing to its first token.
desktop_exec_tokens() {
  local raw="$1" line=""
  local token="" ch="" next=""
  local quoted=false started=false
  local i

  exec_tokens=()

  # Exec= is a desktop-entry string, so its \s \n \t \r \\ escapes are decoded
  # before the quoting below is applied.
  for (( i = 0; i < ${#raw}; i++ )); do
    ch="${raw:i:1}"
    if [[ $ch == '\' ]] && (( i + 1 < ${#raw} )); then
      case "${raw:i+1:1}" in
        s) line+=" " ;;
        n) line+=$'\n' ;;
        t) line+=$'\t' ;;
        r) line+=$'\r' ;;
        '\') line+='\' ;;
        *) line+="\\${raw:i+1:1}" ;;
      esac
      (( i++ ))
    else
      line+="$ch"
    fi
  done

  for (( i = 0; i < ${#line}; i++ )); do
    ch="${line:i:1}"
    next="${line:i+1:1}"

    # Inside quotes a backslash escapes only " ` $ and \; before anything
    # else it is a literal backslash.
    if [[ $quoted == true ]]; then
      if [[ $ch == '"' ]]; then
        quoted=false
      elif [[ $ch == '\' && ( $next == '"' || $next == '`' || $next == '$' || $next == '\' ) ]]; then
        token+="$next"
        (( i++ ))
      else
        token+="$ch"
      fi
      continue
    fi

    case "$ch" in
      '"')
        quoted=true
        started=true
        ;;
      '\')
        if (( i + 1 < ${#line} )); then
          token+="$next"
          (( i++ ))
        else
          token+="$ch"
        fi
        started=true
        ;;
      ' ' | $'\t')
        if [[ $started == true ]]; then
          exec_tokens+=("$token")
          token=""
          started=false
        fi
        ;;
      *)
        token+="$ch"
        started=true
        ;;
    esac
  done

  if [[ $started == true ]]; then
    exec_tokens+=("$token")
  fi
}

# Read Exec= from the same data dirs omarchy-cmd-default-browser searched, as
# omarchy-launch-browser does, so a browser it resolved is one this can start.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec_tokens=()
for data_dir in "${data_dirs[@]}"; do
  entry="$data_dir/applications/$browser"
  [[ -f $entry ]] || continue
  desktop_exec_tokens "$(sed -n 's/^Exec=//p' "$entry" | head -1)"
  break
done

# Field codes %u/%U/%f/%F/%i/%c/%k never apply here: the web-app URL is passed
# as the browser's --app= argument instead.
final_tokens=()
for token in "${exec_tokens[@]}"; do
  case "$token" in
    %u | %U | %f | %F | %i | %c | %k) ;;
    *) final_tokens+=("$token") ;;
  esac
done

# Handing an empty command to uwsm-app surfaces as "Command not found: \"\"",
# which fails a keybinding silently. A web app runs in a Chromium-based
# browser, so say that rather than claiming no browser is set.
if (( ${#final_tokens[@]} == 0 )); then
  echo "omarchy-launch-webapp: web apps need a Chromium-based browser; install Chromium with 'omarchy install browser chromium'" >&2
  omarchy-notification-send -u critical -g 󰖟 "$(omarchy-i18n browser.webappNeedsChromium)" "$(omarchy-i18n browser.webappNeedsChromiumHint)"
  exit 1
fi

if ! omarchy-cmd-browser-handoff "${final_tokens[@]}" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- "${final_tokens[@]}" --app="$1" "${@:2}"
fi

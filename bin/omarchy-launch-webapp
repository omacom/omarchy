#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

# Web apps need a Chromium-based browser's --app mode: the default browser when
# it is one, otherwise the first one installed.
browsers=()
browser=$(omarchy-cmd-default-browser)

case $browser in
chromium* | google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) browsers+=("$browser") ;;
esac

browsers+=(chromium.desktop google-chrome.desktop brave-browser.desktop brave-origin.desktop microsoft-edge.desktop vivaldi-stable.desktop opera.desktop helium.desktop)

# Desktop entries are looked up as xdg does, the first one found winning, with
# the Nix profile ahead of the system dirs as omarchy-launch-browser reads it. A
# browser counts as installed when that entry's command resolves. An entry that
# starts with a wrapper such as env cannot take --app on the browser's behalf, so
# it is skipped.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:$HOME/.nix-profile/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

browser_command() {
  local data_dir command

  for data_dir in "${data_dirs[@]}"; do
    [[ -r $data_dir/applications/$1 ]] || continue
    command=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$data_dir/applications/$1" | head -1)
    if [[ -n $command && ${command##*/} != "env" ]] && command -v "$command" >/dev/null; then
      echo "$command"
      return 0
    fi

    # Launchers read the first entry found, so one that does not resolve hides
    # any later copy and the browser is not installed.
    return 1
  done

  return 1
}

browser_exec=""
for browser in "${browsers[@]}"; do
  browser_exec=$(browser_command "$browser") && break
done

if [[ -z $browser_exec ]]; then
  echo "No Chromium-based browser is installed to open $1 as a web app." >&2
  omarchy-notification-send -u critical "Web app needs a Chromium-based browser" "Install Chromium, Chrome, Brave, Edge, Vivaldi, Opera or Helium to open web apps."
  exit 1
fi

if ! omarchy-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- $browser_exec --app="$1" "${@:2}"
fi

#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

here=$(cd -- "$(dirname -- "$0")" && pwd)
url=$1
bin=$("$here/omarchy-webapp-browser")
app_id=$("$here/omarchy-webapp-id" get "$url" || true)

if [[ -n $app_id ]]; then
  # Origin-only launches should use the installed start_url. Passing
  # https://youtube.com/ as a shortcut override into a www.youtube.com app is
  # out of scope and can no-op. Keep the flag for real deep links (Gmail
  # compose, a /watch URL).
  rest=${url#*://}
  hostpath=${rest%%\?*}
  hostpath=${hostpath%%#*}
  hostpath=${hostpath%/}
  if [[ $hostpath == */* ]]; then
    exec setsid uwsm-app -- "$bin" --app-id="$app_id" --app-launch-url-for-shortcuts-menu-item="$url" "${@:2}"
  fi
  exec setsid uwsm-app -- "$bin" --app-id="$app_id" "${@:2}"
fi

exec setsid uwsm-app -- "$bin" --app="$url" "${@:2}"

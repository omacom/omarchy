#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

set -euo pipefail

if (( $# < 1 )); then
  echo "Usage: omarchy-launch-webapp <url> [browser-flags...]" >&2
  exit 1
fi

url=$1
shift

if [[ $url == -* ]]; then
  echo "Error: web app URL must be http or https." >&2
  exit 1
fi

if [[ $url =~ [[:space:]] ]]; then
  echo "Error: web app URL must not contain whitespace." >&2
  exit 1
fi

url_lc=$(printf '%s' "$url" | tr '[:upper:]' '[:lower:]')
if [[ ! $url_lc =~ ^https?:// ]]; then
  echo "Error: web app URL must be http or https." >&2
  exit 1
fi

for flag in "$@"; do
  if [[ $flag == -* && $flag != --* ]]; then
    echo "Error: web app launcher refuses extra browser arguments that are not long options." >&2
    exit 1
  fi
  if [[ $flag == --app=* || $flag == --gpu-launcher=* || $flag == --proxy-server=* || $flag == --type=* ]]; then
    echo "Error: web app launcher refuses extra Chromium process flags." >&2
    exit 1
  fi
done

browser=$(omarchy-cmd-default-browser || true)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="chromium.desktop" ;;
esac

if [[ $browser == */* || $browser == *..* ]]; then
  browser="chromium.desktop"
fi

# Read Exec= from the same data dirs omarchy-cmd-default-browser searched, as
# omarchy-launch-browser does, so a browser it resolved is one this can start.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
browser_exec=""
for data_dir in "${data_dirs[@]}"; do
  entry="$data_dir/applications/$browser"
  [[ -f $entry ]] || continue
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$entry" | head -1)
  break
done

# Handing an empty command to uwsm-app surfaces as "Command not found: \"\"",
# which fails a keybinding silently. A web app runs in a Chromium-based
# browser, so say that rather than claiming no browser is set.
if [[ -z $browser_exec ]]; then
  echo "omarchy-launch-webapp: web apps need a Chromium-based browser; install Chromium with 'omarchy install browser chromium'" >&2
  omarchy-notification-send -u critical -g 󰖟 "$(omarchy-i18n browser.webappNeedsChromium)" "$(omarchy-i18n browser.webappNeedsChromiumHint)"
  exit 1
fi

browser_exec=""
for desktop in \
  "$HOME/.local/share/applications/$browser" \
  "$HOME/.nix-profile/share/applications/$browser" \
  "/usr/share/applications/$browser"; do
  [[ -f $desktop ]] || continue
  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$desktop" | head -1)
  [[ -n $browser_exec ]] && break
done

if [[ -z $browser_exec ]]; then
  echo "Error: no Chromium-family browser is installed to launch a web app." >&2
  exit 1
fi

if ! omarchy-cmd-browser-handoff "$browser_exec" --app="$url" "$@"; then
  exec setsid uwsm-app -- "$browser_exec" --app="$url" "$@"
fi

#!/bin/bash

# omarchy:summary=Upgrade Sunshine to the security-fixed edge build when the installed package is older.
# omarchy:hidden=true
# omarchy:requires-sudo=true

set -euo pipefail

# Stable can lag edge. Pull a known security floor from edge when the installed
# package is behind (omacom/omarchy#10836). Soft-skip when Sunshine is absent,
# already new enough, an AUR provider, or the arch is unsupported. Hard-fail a
# missing probe or pacman -U so migrations retry instead of marking done.

SUNSHINE_MIN_VERSION="${OMARCHY_SUNSHINE_MIN_VERSION:-2026.914.233613-1}"
OMARCHY_PKGS_EDGE="${OMARCHY_PKGS_EDGE:-https://pkgs.omarchy.org/edge}"

installed=$(pacman -Qq sunshine 2>/dev/null | head -n1 || true)
[[ -n $installed ]] || exit 0

# AUR/other providers that satisfy the sunshine dependency must not be
# force-replaced mid-install; --noconfirm would answer N to the conflict.
if [[ $installed != sunshine ]]; then
  echo "Sunshine security floor skipped: installed provider is $installed, not sunshine." >&2
  exit 0
fi

current=$(pacman -Q sunshine | awk '{print $2}')
if [[ $(vercmp "$current" "$SUNSHINE_MIN_VERSION") -ge 0 ]]; then
  exit 0
fi

arch=$(uname -m)
case $arch in
  x86_64 | aarch64) ;;
  *)
    echo "Sunshine $current is older than the security floor $SUNSHINE_MIN_VERSION, but no edge package is published for $arch." >&2
    exit 0
    ;;
esac

pkg_url="$OMARCHY_PKGS_EDGE/$arch/sunshine-${SUNSHINE_MIN_VERSION}-${arch}.pkg.tar.zst"

# Probe before asking pacman. On x86_64 a missing build must not soft-skip the
# migration marker — exit non-zero so omarchy-migrate retries. aarch64 edge
# still lags this floor, so a 404 there stays a soft skip.
if ! curl -fsI --connect-timeout 5 --max-time 20 "$pkg_url" >/dev/null 2>&1; then
  echo "Sunshine $current is older than $SUNSHINE_MIN_VERSION, but $pkg_url is not available yet." >&2
  if [[ $arch == aarch64 ]]; then
    exit 0
  fi
  exit 1
fi

echo "Upgrading Sunshine $current → $SUNSHINE_MIN_VERSION (security release from edge)..."
sudo pacman -U --noconfirm "$pkg_url"

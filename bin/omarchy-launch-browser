#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]

default_browser=$(env -u BROWSER xdg-settings get default-web-browser)
if [[ -z $default_browser ]]; then
  default_browser=$(xdg-mime query default x-scheme-handler/https)
fi

desktop_file=$(ls {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
exec_line=$(sed -n 's/^Exec=//p' "$desktop_file" 2>/dev/null | head -1)
if [[ -z $exec_line ]]; then
  exec_line="$default_browser"
fi

# Parse a freedesktop Exec value without eval. Desktop entries can be user
# supplied, so shell evaluation here would turn a launcher lookup into code
# execution. This handles whitespace, quotes, and backslash escapes while
# keeping every token as a literal argv element.
parse_exec_line() {
  local input="$1"
  local token=""
  local started=0
  local in_single=0
  local in_double=0
  local escaped=0
  local char
  local index
  tokens=()

  for ((index = 0; index < ${#input}; index++)); do
    char="${input:index:1}"
    if (( escaped )); then
      token+="$char"
      escaped=0
      started=1
    elif [[ $char == "\\" && $in_single -eq 0 ]]; then
      escaped=1
      started=1
    elif [[ $char == "'" && $in_double -eq 0 ]]; then
      in_single=$((1 - in_single))
      started=1
    elif [[ $char == '"' && $in_single -eq 0 ]]; then
      in_double=$((1 - in_double))
      started=1
    elif [[ $char == ' ' || $char == $'\t' ]]; then
      if (( started )); then
        tokens+=("$token")
        token=""
        started=0
      fi
    else
      token+="$char"
      started=1
    fi
  done

  if (( escaped )); then token+='\\'; fi
  if (( in_single || in_double )); then return 1; fi
  if (( started )); then tokens+=("$token"); fi
}

if ! parse_exec_line "$exec_line" || [[ ${#tokens[@]} -eq 0 ]]; then
  echo "Invalid browser Exec entry; refusing to launch." >&2
  exit 1
fi

moz_regex='(firefox|librewolf|waterfox|tor-browser|mozilla)'
if [[ ${exec_line,,} =~ $moz_regex ]] || \
   (${exec_line%% *} --help 2>/dev/null | grep -q MOZ_LOG); then
  private_flag="--private-window"
elif [[ ${exec_line,,} =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi

is_private=false
url=""
for argument in "$@"; do
  if [[ $argument == "--private" ]]; then
    is_private=true
  elif [[ -z $url ]]; then
    url="$argument"
  fi
done

cmd=()
has_url_slot=false

for token in "${tokens[@]}"; do
  case "$token" in
    %u|%U)
      has_url_slot=true
      if [[ -n $url ]]; then
        if [[ $is_private == true ]]; then
          cmd+=("$private_flag")
          is_private=false
        fi
        cmd+=("$url")
      fi
      ;;
    %f|%F|%i|%c|%k|%%)
      ;;
    *)
      cmd+=("$token")
      ;;
  esac
done

if [[ $is_private == true ]]; then
  cmd+=("$private_flag")
fi

if [[ -n $url && $has_url_slot == false ]]; then
  cmd+=("$url")
fi

systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
  --property=StandardOutput=null --property=StandardError=null \
  uwsm-app -- "${cmd[@]}"

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  focus_name=""
  for token in "${tokens[@]}"; do
    base=$(basename "$token" 2>/dev/null || true)
    base="${base%-stable}"
    if [[ $base =~ ^(chromium|google-chrome|brave|firefox|edge|vivaldi|opera|helium|zen|librewolf|waterfox|tor-browser) ]]; then
      focus_name="$base"
      break
    elif [[ $token =~ \.([^.]+)$ ]]; then
      sub="${BASH_REMATCH[1],,}"
      if [[ $sub =~ ^(chromium|chrome|brave|firefox|edge|vivaldi|opera|helium|zen|librewolf|waterfox) ]]; then
        focus_name="$sub"
        break
      fi
    fi
  done
  if [[ -z $focus_name ]]; then
    focus_name="$(basename "${tokens[0]}" -stable)"
  fi
  omarchy-hyprland-focus-app "^${focus_name}.*$" || true
fi

#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]

default_browser=$(omarchy-cmd-default-browser)
browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)

# Only a private launch needs the browser's flag, and probing a Firefox-family
# browser's --help starts the whole binary, so ordinary launches skip it and
# leave their arguments as they are.
private_flag="--private"
if [[ " $* " == *" --private "* ]]; then
  if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
    private_flag="--private-window"
  elif [[ $browser_exec =~ edge ]]; then
    private_flag="--inprivate"
  else
    private_flag="--incognito"
  fi
fi

started_browser=0
if ! omarchy-cmd-browser-handoff "$browser_exec" "${@/--private/$private_flag}"; then
  started_browser=1
  systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "$browser_exec" "${@/--private/$private_flag}"
fi

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

# Only a browser this launcher started is focused. A URL the handoff gave to the
# running browser focuses nothing: the point of apps/browser.lua turning
# focus_on_activate off is that a URL opening in a browser that already lives on
# another workspace must not drag the view there, and focusing here would do it
# anyway. (omarchy-launch-or-focus-webapp keeps its own explicit focus; that path
# is asked for by name.)
if [[ -n $url && $started_browser == 1 && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  omarchy-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
fi

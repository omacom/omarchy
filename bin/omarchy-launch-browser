#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]

default_browser=$(omarchy-cmd-default-browser)
browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
browser_name=$(basename "$browser_exec")

case $browser_name in
  firefox* | zen* | librewolf* | waterfox* | floorp* | icecat* | mullvad*) private_flag="--private-window" ;;
  *edge*) private_flag="--inprivate" ;;
  chromium* | *chrome* | brave* | vivaldi* | opera* | helium*) private_flag="--incognito" ;;
  *)
    for argument in "$@"; do
      if [[ $argument == "--private" ]]; then
        echo "Cannot determine the private browsing flag for '$browser_name'. Open a private window from the browser." >&2
        exit 1
      fi
    done
    private_flag=""
    ;;
esac

arguments=()
for argument in "$@"; do
  if [[ $argument == "--private" ]]; then
    arguments+=("$private_flag")
  else
    arguments+=("$argument")
  fi
done

if ! omarchy-cmd-browser-handoff "$browser_exec" "${arguments[@]}"; then
  systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "$browser_exec" "${arguments[@]}"
fi

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  omarchy-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
fi

#!/bin/bash

# omarchy:summary=Launch the default browser as determined by xdg-settings.
# omarchy:args=[url]

default_browser=$(omarchy-cmd-default-browser)

# Undo the escapes every desktop entry string carries.
desktop_string() {
  local string=$1 char i
  REPLY=""
  for (( i = 0; i < ${#string}; i++ )); do
    char=${string:i:1}
    if [[ $char == "\\" ]]; then
      (( i++ ))
      case ${string:i:1} in
      s) char=" " ;;
      n) char=$'\n' ;;
      t) char=$'\t' ;;
      r) char=$'\r' ;;
      "\\") char="\\" ;;
      *) char="\\${string:i:1}" ;;
      esac
    fi
    REPLY+=$char
  done
}

desktop_exec_argv() {
  local desktop=$1
  local file line name
  desktop_exec_argv=()
  for file in "$HOME/.local/share/applications/$desktop" \
              "$HOME/.nix-profile/share/applications/$desktop" \
              "/usr/share/applications/$desktop"; do
    [[ -f $file ]] || continue
    line=$(sed -n 's/^Exec=//p' "$file" | head -1)
    [[ -n $line ]] && break
  done
  [[ -n $line ]] || return 1
  desktop_string "$(sed -n 's/^Name=//p' "$file" | head -1)"
  name=$REPLY

  # Split the Exec line by its own quoting, expanding %c and %k, keeping %% as
  # %, and dropping the other field codes. A standalone -- goes too, or the
  # launcher's own options after it would be read as operands.
  desktop_string "$line"
  local value=$REPLY arg="" char i quoted=0 started=0
  for (( i = 0; i < ${#value}; i++ )); do
    char=${value:i:1}
    if [[ $char == '"' ]]; then
      (( quoted = !quoted, started = 1 ))
    elif [[ $char == "\\" ]] && (( quoted )); then
      (( i++ ))
      arg+=${value:i:1}
    elif [[ $char == "%" ]]; then
      (( i++ ))
      case ${value:i:1} in
      "%") arg+="%" started=1 ;;
      c) arg+=$name started=1 ;;
      k) arg+=$file started=1 ;;
      esac
    elif [[ $char == " " ]] && (( ! quoted )); then
      if (( started )) && [[ $arg != "--" ]]; then
        desktop_exec_argv+=("$arg")
      fi
      arg="" started=0
    else
      arg+=$char started=1
    fi
  done
  if (( started )) && [[ $arg != "--" ]]; then
    desktop_exec_argv+=("$arg")
  fi

  (( ${#desktop_exec_argv[@]} > 0 ))
}

desktop_exec_argv "$default_browser" || exit 1

browser_exec=""
skip_value=0
for token in "${desktop_exec_argv[@]}"; do
  if (( skip_value )); then
    skip_value=0
  elif [[ $token == -u || $token == --unset || $token == -C || $token == --chdir ]]; then
    skip_value=1
  elif [[ $token != env && $token != */env && $token != *=* && $token != -* && $token != run && $token != flatpak && $token != */flatpak ]]; then
    browser_exec=$token
    break
  fi
done
[[ -n $browser_exec ]] || browser_exec=${desktop_exec_argv[0]}

# Only a private launch needs the browser's flag, and probing a Firefox-family
# browser's --help starts the whole binary, so ordinary launches skip it and
# leave their arguments as they are.
private_flag="--private"
if [[ " $* " == *" --private "* ]]; then
  if "$browser_exec" --help 2>/dev/null | grep -q MOZ_LOG; then
    private_flag="--private-window"
  elif [[ $browser_exec =~ edge ]]; then
    private_flag="--inprivate"
  else
    private_flag="--incognito"
  fi
fi

if ! omarchy-cmd-browser-handoff "${desktop_exec_argv[@]}" "${@/--private/$private_flag}"; then
  systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "${desktop_exec_argv[@]}" "${@/--private/$private_flag}"
fi

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  omarchy-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
fi

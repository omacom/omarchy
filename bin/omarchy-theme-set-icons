#!/bin/bash

# omarchy:summary=Draw Omarchy's app icons in the current theme's colors
# omarchy:hidden=true

# Runs after the theme is on screen, so drawing icons never holds up a switch.
# The icons render into a scratch dir and each one replaces its predecessor in
# ~/.local/state/omarchy/current/icons with a rename, so an app or the shell
# reading one mid-switch gets the old icon or the new, never a missing or
# half-written one. A theme may ship its own icons/<name>.svg instead.
#
# Each icon is linked by name over the packaged hicolor icon once; the link
# never changes after that. Only names with an icon template are linked, so a
# theme may redraw Omarchy's icons but not stand in for another app's. An icon
# the user put there themselves is kept. When the theme can't draw an icon, it
# and its link go, and the packaged icon shows again.
#
# The shell watches icons.revision and redraws the icons when it changes.

CURRENT="$HOME/.local/state/omarchy/current"
THEME="$CURRENT/theme"
ICONS="$CURRENT/icons"
LINKS="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/scalable/apps"

shopt -s nullglob

# Quick theme switches can start runs that overlap. One at a time, the last
# one to run reads the current theme, so an older theme never lands last.
exec 7>"$CURRENT/.icons.lock"
flock 7

scratch=$(mktemp -d "$CURRENT/.icons.XXXXXX")
trap 'rm -rf "$scratch"' EXIT

# A file already in the output dir is never overwritten, so the theme's own
# icons win over the templates.
for icon in "$THEME"/icons/*.svg; do
  [[ -L $icon ]] || cp "$icon" "$scratch/"
done
omarchy-theme-set-templates --icons "$THEME" "$scratch"

mkdir -p "$ICONS" "$LINKS"
# A user template shadows the built-in of the same name, so each name is
# published once.
declare -A published=()
for template in "$HOME/.config/omarchy/themed/icons"/*.svg.tpl "$OMARCHY_PATH/default/themed/icons"/*.svg.tpl; do
  name=${template##*/}
  name=${name%.tpl}
  [[ -z ${published[$name]:-} ]] || continue
  published[$name]=1
  link="$LINKS/$name"

  if [[ -f $scratch/$name ]]; then
    mv -f "$scratch/$name" "$ICONS/$name"
    # A working icon of the user's own stays; a dangling link at the name goes.
    [[ -e $link ]] || ln -sfn "$ICONS/$name" "$link"
  else
    rm -f "$ICONS/$name"
    [[ -L $link && $(readlink "$link") == "$ICONS/$name" ]] && rm "$link"
  fi
done

printf '%s\n' "${EPOCHREALTIME//[!0-9]/}" >"$CURRENT/icons.revision"

#!/bin/bash

# omarchy:summary=Remove 1Password and its browser extension.
# omarchy:requires-sudo=true

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"

sudo rm -f "/usr/share/google-chrome/extensions/$EXTENSION_ID.json" "/usr/share/chromium/extensions/$EXTENSION_ID.json"
omarchy-pkg-drop 1password 1password-cli

echo ""
echo "1Password has been removed."

#!/bin/bash

# omarchy:summary=Remove 1Password and its browser extension.
# omarchy:requires-sudo=true

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
NATIVE_MESSAGING_MANIFEST="com.1password.1password.json"

if omarchy-pkg-drop 1password 1password-cli; then
  sudo rm -f "/usr/share/google-chrome/extensions/$EXTENSION_ID.json" "/usr/share/chromium/extensions/$EXTENSION_ID.json"

  # Browsers keep the native-messaging registration in the user's profile, so
  # removing the packages alone leaves them pointing at the missing app.
  rm -f "$HOME"/.config/{*,*/*}/NativeMessagingHosts/"$NATIVE_MESSAGING_MANIFEST"
  rm -f "$HOME/.mozilla/native-messaging-hosts/$NATIVE_MESSAGING_MANIFEST"

  echo ""
  echo "1Password has been removed."
else
  exit 1
fi

#!/bin/bash

# omarchy:summary=Back up a browser's saved logins and cookies before its password store is pinned
# omarchy:args=<chromium|brave|chrome|microsoft-edge-stable> <flags-conf>
# omarchy:hidden=true

# The backup migration 1784508556 makes before pinning a browser's password
# store: copies each profile's Login Data and Cookies (plus -wal/-journal
# sidecars) out of the browser's data directories. Defers with a non-zero exit
# while the browser runs (a WAL checkpoint between copies would leave the
# backup unrestorable) and whenever a --user-data-dir override in the flags
# conf cannot be resolved to a safe absolute path, so the pin never lands on
# unprotected databases.

set -euo pipefail

browser=${1:-}
conf=${2:-}

case $browser in
  chromium) data_dir=$HOME/.config/chromium; process=chromium ;;
  brave) data_dir=$HOME/.config/BraveSoftware/Brave-Browser; process=brave ;;
  chrome) data_dir=$HOME/.config/google-chrome; process=chrome ;;
  microsoft-edge-stable) data_dir=$HOME/.config/microsoft-edge; process=msedge ;;
  *)
    echo "Usage: omarchy-browser-password-backup <chromium|brave|chrome|microsoft-edge-stable> <flags-conf>" >&2
    exit 1
    ;;
esac

if pgrep -x "$process" >/dev/null; then
  echo "$browser is running, which could leave its password database half-written. Quit $browser, then run 'omarchy update' again; the pin is deferred until then." >&2
  exit 1
fi

expand_data_dir() {
  local value=$1
  if [[ $value == \"* && $value == *\" ]]; then
    value=${value#\"}
    value=${value%%\"*}
  elif [[ $value == \'* && $value == *\' ]]; then
    value=${value#\'}
    value=${value%%\'*}
  fi
  case $value in
    '~') value=$HOME ;;
    '~/'*) value=$HOME/${value#'~/'} ;;
    '$HOME') value=$HOME ;;
    '$HOME/'*) value=$HOME/${value#'$HOME/'} ;;
    '${HOME}') value=$HOME ;;
    '${HOME}/'*) value=$HOME/${value#'${HOME}/'} ;;
  esac
  if [[ $value != /* || $value == *'$'* ]]; then
    echo "Cannot resolve the --user-data-dir value '$1' in $conf to a safe absolute path." >&2
    return 1
  fi
  printf '%s\n' "$value"
}

data_dirs() {
  local line value
  printf '%s\n' "$data_dir"
  [[ -n $conf && -f $conf ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line#"${line%%[![:space:]]*}"}   # trim leading whitespace
    [[ $line == '#'* ]] && continue
    if [[ $line == '--user-data-dir='* ]]; then
      value=${line#--user-data-dir=}
    elif [[ $line == '--user-data-dir' || $line == '--user-data-dir '* ]]; then
      value=${line#'--user-data-dir'}
      value=${value#"${value%%[![:space:]]*}"}
      value=${value%%[[:space:]]*}
    else
      continue
    fi
    value=$(expand_data_dir "$value") || return 1
    printf '%s\n' "$value"
  done <"$conf"
}

back_up_dir() {
  local target_dir=$1 target_backup=$2
  [[ -d $target_dir ]] || return 0

  local profile_dir profile_name file dir_backed_up=0
  local -a profile_files=()

  for profile_dir in "$target_dir"/*/; do
    [[ -d $profile_dir ]] || continue
    [[ -f "$profile_dir/Login Data" || -f "$profile_dir/Cookies" ]] || continue
    profile_files=()
    for file in "$profile_dir/Login Data" "$profile_dir/Login Data"-* "$profile_dir/Cookies" "$profile_dir/Cookies"-*; do
      [[ -f $file ]] || continue
      profile_files+=("$file")
    done
    (( ${#profile_files[@]} > 0 )) || continue

    profile_name=${profile_dir%/}
    profile_name=${profile_name##*/}
    mkdir -p "$target_backup/$profile_name" || return 1
    for file in "${profile_files[@]}"; do
      cp -a "$file" "$target_backup/$profile_name/" || return 1
    done
    dir_backed_up=1
  done

  if (( dir_backed_up )); then
    printf '%s\n' "$target_backup"
    backed_up_any=1
  fi
  return 0
}

backup_root=$HOME/.local/state/omarchy/migration-backups
stamp=$(date +%Y%m%d%H%M%S)
backed_up_any=0

# Capture first, then loop: a `done < <(data_dirs)` loop cannot see the
# function's non-zero exit, and the failure must abort before anything is copied.
dirs_list=$(data_dirs) || exit 1
declare -A seen=()
declare -a dirs=()
while IFS= read -r dir; do
  [[ -n $dir ]] || continue
  [[ -n ${seen[$dir]:-} ]] && continue
  seen[$dir]=1
  dirs+=("$dir")
done <<<"$dirs_list"

default_seen=0
override_count=0
for dir in "${dirs[@]}"; do
  if [[ $dir == "$data_dir" ]]; then
    default_seen=1
    backup_dir="$backup_root/1784508556-$browser-$stamp"
  else
    (( override_count += 1 ))
    backup_dir="$backup_root/1784508556-$browser-$stamp-user-data-$override_count"
  fi
  back_up_dir "$dir" "$backup_dir" || exit 1
done

if (( backed_up_any )); then
  echo "Backed up $browser's saved logins and cookies to the directories above." >&2
  echo "The password-store pin can leave those databases undecryptable, and the browser then deletes the" >&2
  echo "logins it cannot read (Brave Sync propagates the deletions to every synced device). If logins vanish:" >&2
  echo "quit $browser, remove the line '--password-store=gnome-libsecret' from $conf so the restored store is" >&2
  echo "not bulk-deleted again under the pinned key, then restore the databases from the backup." >&2
fi

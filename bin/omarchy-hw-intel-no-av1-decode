#!/bin/bash

# omarchy:summary=Detect an Intel-only computer whose GPU can't decode AV1 video.

# Intel's GPUs gained AV1 decoding with Tiger Lake (Gen12). Skylake through
# Ice Lake, and the Atom-class chips of the same years, play AV1 on the CPU,
# which is what YouTube serves them. Most are Intel-only laptops: a 2018-2020
# MacBook Air has an Ice Lake GPU. A machine with a second GPU is left out, as
# the browser may be using that one.
#
# Read the cached sysfs IDs rather than lspci, which reads PCI config space and
# resumes runtime-suspended GPUs. The IDs are those the kernel's
# include/drm/intel/pciids.h lists for Skylake, Kaby Lake, Amber Lake, Coffee
# Lake, Whiskey Lake, Comet Lake, Ice Lake, Apollo Lake, Gemini Lake, Elkhart
# Lake and Jasper Lake. Newer GPUs decode AV1, so no future ID belongs here.
pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"

shopt -s nullglob

gpu=""
for device in "$pci_devices_path"/*; do
  [[ $(< "$device/class") == 0x03* ]] || continue
  # A second display controller, Intel or not, ends the check.
  [[ -z $gpu ]] || exit 1
  gpu=$device
done

[[ -n $gpu && $(< "$gpu/vendor") == "0x8086" ]] || exit 1

case $(< "$gpu/device") in
    0x0a84|0x1902|0x1906|0x190a|0x190b|0x190e|0x1912|0x1913|\
    0x1915|0x1916|0x1917|0x191a|0x191b|0x191d|0x191e|0x1921|\
    0x1923|0x1926|0x1927|0x192a|0x192b|0x192d|0x1932|0x193a|\
    0x193b|0x193d|0x1a84|0x1a85|0x3184|0x3185|0x3e90|0x3e91|\
    0x3e92|0x3e93|0x3e94|0x3e96|0x3e98|0x3e99|0x3e9a|0x3e9b|\
    0x3e9c|0x3ea0|0x3ea1|0x3ea2|0x3ea3|0x3ea4|0x3ea5|0x3ea6|\
    0x3ea7|0x3ea8|0x3ea9|0x4541|0x4551|0x4555|0x4557|0x4570|\
    0x4571|0x4e51|0x4e55|0x4e57|0x4e61|0x4e71|0x5902|0x5906|\
    0x5908|0x590a|0x590b|0x590e|0x5912|0x5913|0x5915|0x5916|\
    0x5917|0x591a|0x591b|0x591c|0x591d|0x591e|0x5921|0x5923|\
    0x5926|0x5927|0x593b|0x5a84|0x5a85|0x87c0|0x87ca|0x8a50|\
    0x8a51|0x8a52|0x8a53|0x8a54|0x8a56|0x8a57|0x8a58|0x8a59|\
    0x8a5a|0x8a5b|0x8a5c|0x8a5d|0x8a70|0x8a71|0x9b21|0x9b41|\
    0x9ba2|0x9ba4|0x9ba5|0x9ba8|0x9baa|0x9bac|0x9bc2|0x9bc4|\
    0x9bc5|0x9bc6|0x9bc8|0x9bca|0x9bcc|0x9be6|0x9bf6)
  exit 0
  ;;
esac

exit 1

#!/bin/bash

# omarchy:summary=Pin an Apple Studio Display's DisplayPort link to HBR3 so 5K runs without DSC
# omarchy:hidden=true
# omarchy:requires-sudo=true

# The Studio Display advertises an HBR2 link through its Thunderbolt tunnel.
# 5120x2880@60 does not fit HBR2 uncompressed, so amdgpu turns on DSC, and that
# path flickers and blacks out on the Radeon Pro in T2 MacBooks. The panel
# trains fine at HBR3, where 5K needs no compression, so prefer that rate on
# every connector carrying a Studio Display.
#
# The preferred rate sticks to the connector until reboot, across replugs and
# suspend, so one pass per connector is enough. Writing it retrains the link at
# once; when the compositor had already lit the panel over the compressed link,
# a simulated replug makes it set the mode again over the new one.
#
# Runs as root from omarchy-apple-display-link.service, at boot and on every
# DRM hotplug via udev. Without a Studio Display it does nothing.

drm_path="${OMARCHY_DRM_PATH:-/sys/class/drm}"
debug_path="${OMARCHY_DRI_DEBUG_PATH:-/sys/kernel/debug/dri}"
settle="${OMARCHY_APPLE_DISPLAY_SETTLE:-2}"
# One marker per connector this helper pinned. It lives in /run, as the
# preference itself does: both are gone after a reboot.
state_dir="${OMARCHY_APPLE_DISPLAY_STATE:-/run/omarchy-apple-display-link}"

# debugfs is root-only; a test pointing at its own tree needs no privileges.
if (( EUID != 0 )) && [[ -z ${OMARCHY_DRI_DEBUG_PATH:-} ]]; then
  exec sudo "$0" "$@"
fi

shopt -s nullglob
mkdir -p "$state_dir" 2>/dev/null || true

replug() {
  echo 0 >"$1/trigger_hotplug"
  sleep 1
  echo 1 >"$1/trigger_hotplug"
}

# A connector this run has already written is not read back in a later pass:
# what was written is known, and a test's plain fixture files keep the written
# text rather than debugfs's formatted readback.
declare -A handled

# The udev rule starts one shared oneshot service. A start that arrives while a
# run is still going merges into that run instead of queueing another, and
# leaves no other trace, so the rule also touches a request file first. A
# request that reappeared during a pass is an event this run has not looked
# at yet: scan again until a pass finds nothing to do and no request arrived.
request="$state_dir/request"
for _ in 1 2 3 4 5 6; do
  rm -f "$request"
  acted=0
  pending=0
  for edid in "$drm_path"/card*-DP-*/edid; do
    connector=${edid%/edid}
    name=${connector##*/}
    [[ -n ${handled[$name]:-} ]] && continue
    [[ $(<"$connector/status") == connected ]] || continue
    # One read of the EDID, classified once: a display dropping between two
    # reads would read as an identified foreign sink on the second. No EDID
    # yet means no sink identified: a Studio Display still training reads
    # like this for a moment. Neither pin nor clear it, but look again after
    # the settle, since the event that completes it may merge into this run.
    sink=$(tr -d '\0' <"$edid")
    if [[ -z $sink ]]; then
      pending=1
      continue
    fi

    card=${name%%-*}
    debug="$debug_path/${card#card}/${name#"$card"-}"
    [[ -w $debug/link_settings ]] || continue

    preferred=$(tr -d '\0' <"$debug/link_settings" |
      sed -nE 's/.*Preferred:[[:space:]]+[0-9]+[[:space:]]+(0x[0-9a-fA-F]+).*/\1/p')

    if [[ $sink != *StudioDisplay* ]]; then
      # The preference outlives the Studio Display on its connector, and
      # amdgpu trains whatever comes next at HBR3 with no fallback: a monitor
      # that tops out at HBR2 would stay black until reboot. Only a preference
      # this helper wrote is its to undo, hence the marker. Invalid input
      # clears the preference, and a replug trains the link at the sink's rate.
      [[ $preferred == 0x1e && -e $state_dir/$name ]] || continue
      handled[$name]=1
      acted=1
      echo "0 0" >"$debug/link_settings"
      rm -f "$state_dir/$name"
      echo "$name: dropping the HBR3 preference a Studio Display left behind"
      replug "$debug"
      continue
    fi

    [[ $preferred == 0x1e ]] && continue
    handled[$name]=1
    acted=1
    # The marker is what lets a later run undo the pin; without it a monitor
    # that cannot do HBR3 would inherit the preference. Record it first.
    if ! touch "$state_dir/$name" 2>/dev/null; then
      echo "$name: cannot record the pin under $state_dir, leaving the link alone"
      continue
    fi
    echo "4 0x1e" >"$debug/link_settings"
    echo "$name: DisplayPort link pinned to HBR3"

    # Give a modeset that raced this write time to finish before judging it.
    sleep "$settle"
    [[ $(tr -d '\0' <"$debug/dsc_clock_en") == 1 ]] || continue
    echo "$name: stream still compressed, replugging for a fresh modeset"
    replug "$debug"
  done
  if (( acted || pending )); then
    sleep "$settle"
  elif [[ ! -e $request ]]; then
    break
  fi
done

exit 0

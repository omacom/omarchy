#!/bin/bash

# omarchy:summary=Show or configure the system DNS provider
# omarchy:args=[Cloudflare|Google|DHCP|Custom]
# omarchy:examples=omarchy dns | omarchy dns Cloudflare | omarchy dns Custom

set -euo pipefail

# Whenever this runs as root — invoked directly through the passwordless
# sudoers rule, or re-execed by require_root below — sudo's secure_path decides
# where a bare helper resolves, and a dev link (etc/sudoers.d/omarchy-dev-path)
# prepends a user-writable checkout bin/ to it. Every helper this script calls
# by bare name (dirname, install, tee, rm, nmcli, systemctl, awk) is a system
# tool, never an omarchy-* command, so pin PATH to trusted system directories
# and keep root from resolving one out of that checkout. The unprivileged
# wrapper phase keeps the caller's PATH so it can still find sudo/pkexec.
if (( EUID == 0 )); then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
fi

# Earlier releases wrote a [global-dns] drop-in here; it overrode VPN DNS, so it
# is now only removed.
NM_DNS_CONF=/etc/NetworkManager/conf.d/20-omarchy-dns.conf

# NetworkManager runs every executable in dispatcher.d as root. Link the packaged
# path, never a dev checkout, for the same reason PACKAGED_PATH does below.
NM_DISPATCHER_LINK=/etc/NetworkManager/dispatcher.d/90-omarchy-dns
NM_DISPATCHER_TARGET=/usr/bin/omarchy-dns-dispatch

provider_from_arg() {
  case "${1:-}" in
  Cloudflare | cloudflare)
    echo "Cloudflare"
    ;;
  Google | google)
    echo "Google"
    ;;
  DHCP | dhcp)
    echo "DHCP"
    ;;
  Custom | custom)
    echo "Custom"
    ;;
  *)
    return 1
    ;;
  esac
}

# The path etc/sudoers.d/omarchy-dns names. The privileged half always runs from
# there rather than from whichever copy was invoked, so the rule matches even
# where $OMARCHY_PATH points at a checkout.
PACKAGED_PATH=/usr/bin/omarchy-dns

# True when sudo would run this exact command without stopping for a password.
# `sudo -l` on its own reports whether a command is permitted, which the blanket
# %wheel rule answers yes to for everything; the long listing prints the matched
# entry's tags, so !authenticate is the grant in etc/sudoers.d/omarchy-dns and
# nothing else. Listing runs nothing and, under -n, prompts for nothing, so a
# machine whose omarchy-settings predates that file falls through to polkit
# instead of dying on a password prompt it has no terminal to show.
sudo_grants_passwordless() {
  sudo -n -l -l "$PACKAGED_PATH" "$@" 2>/dev/null | grep -q '!authenticate'
}

require_root() {
  if (( EUID == 0 )); then
    return
  elif [[ -t 0 ]] || sudo_grants_passwordless "$@"; then
    # A terminal can carry sudo's own password prompt. Without one, sudo is
    # right only where the grant reaches; polkit can at least put a prompt on
    # screen, and offer to authenticate as someone else.
    exec sudo "$PACKAGED_PATH" "$@"
  else
    exec pkexec "$PACKAGED_PATH" "$@"
  fi
}

resolved_dns() {
  awk -F= '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*DNS[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      print value
      exit
    }
  ' /etc/systemd/resolved.conf 2>/dev/null || true
}

current_dns_provider() {
  local dns=""
  local compact=""

  dns=$(resolved_dns)

  compact=$(printf '%s' "$dns" | tr -d '[:space:],')

  if [[ -z $compact ]]; then
    echo "DHCP"
  elif [[ $dns == *"cloudflare-dns.com"* || $dns == *"1.1.1.1"* || $dns == *"2606:4700:4700::1111"* ]]; then
    echo "Cloudflare"
  elif [[ $dns == *"dns.google"* || $dns == *"8.8.8.8"* || $dns == *"2001:4860:4860::8888"* ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

normalize_servers() {
  printf '%s\n' "$*" | tr ',\t\n' ' ' | xargs | tr ' ' ','
}

split_dns_servers() {
  local servers="$1"
  local server clean
  ipv4_dns=""
  ipv6_dns=""

  for server in ${servers//,/ }; do
    clean=${server#dns+tls://}
    clean=${clean#dns+udp://}
    clean=${clean%%#*}
    clean=${clean#[}
    clean=${clean%]}

    [[ -n $clean ]] || continue
    if [[ $clean == *:* ]]; then
      ipv6_dns+="${ipv6_dns:+ }$clean"
    else
      ipv4_dns+="${ipv4_dns:+ }$clean"
    fi
  done
}

# Profiles that carry the machine's own uplink. Bridges, bonds, VLANs and teams
# are uplinks too; the Ethernet ports under them are skipped by controller.
# VPN, tun and WireGuard keep the DNS they push.
networkmanager_dns_connection() {
  case "$1" in
    802-11-wireless|802-3-ethernet|bridge|bond|vlan|team) return 0 ;;
    *) return 1 ;;
  esac
}

# The fields that decide whether and how a profile can carry DNS servers. A
# bridge or bond port has no IP settings, so nmcli prints only its type and
# controller; read the result with read_profile_dns_settings, not by position.
profile_dns_info() {
  nmcli -g connection.type,connection.controller,ipv4.method,ipv4.ignore-auto-dns,ipv6.method,ipv6.ignore-auto-dns connection show "$1"
}

# From <info> (profile_dns_info's output), fill profile_dns_settings with the
# nmcli settings that pin <ipv4> <ipv6>, and set profile_dns_pinned=yes when the
# profile already ignores automatic DNS on every family it can carry. Returns 1
# when the profile takes no DNS of its own: not an uplink type, a bridge, bond
# or team port (its controller carries its IP settings), or no family that
# accepts servers. nmcli rejects ipvN.dns for a method that takes no DNS (IPv6
# disabled, say) and fails the whole modify, so only those families are set.
read_profile_dns_settings() {
  local info="$1" ipv4_dns="$2" ipv6_dns="$3"
  local fields=()

  profile_dns_settings=()
  profile_dns_pinned=yes

  mapfile -t fields <<<"$info"
  networkmanager_dns_connection "${fields[0]:-}" || return 1
  [[ -z ${fields[1]:-} ]] || return 1

  case "${fields[2]:-}" in
    link-local|shared|disabled) ;;
    *)
      profile_dns_settings+=(ipv4.ignore-auto-dns yes ipv4.dns "$ipv4_dns")
      [[ ${fields[3]:-} == "yes" ]] || profile_dns_pinned=no
      ;;
  esac
  case "${fields[4]:-}" in
    link-local|ignore|disabled) ;;
    *)
      profile_dns_settings+=(ipv6.ignore-auto-dns yes ipv6.dns "$ipv6_dns")
      [[ ${fields[5]:-} == "yes" ]] || profile_dns_pinned=no
      ;;
  esac
  (( ${#profile_dns_settings[@]} > 0 ))
}

# A profile nmcli still rejects is reported and skipped, so one bad profile
# does not stop the rest, resolved.conf, or the reloads.
dns_change_failed=false

set_connection_dns() {
  local uuid type info
  local ipv4_dns="${1:-}"
  local ipv6_dns="${2:-}"

  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    networkmanager_dns_connection "$type" || continue
    if ! info=$(profile_dns_info "$uuid"); then
      echo "omarchy-dns: could not read $uuid" >&2
      dns_change_failed=true
      continue
    fi
    read_profile_dns_settings "$info" "$ipv4_dns" "$ipv6_dns" || continue

    if ! nmcli connection modify "$uuid" "${profile_dns_settings[@]}" >/dev/null; then
      echo "omarchy-dns: could not set DNS on $uuid" >&2
      dns_change_failed=true
    fi
  done < <(nmcli -t -f UUID,TYPE connection show)
}

clear_connection_dns() {
  local uuid type controller

  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    networkmanager_dns_connection "$type" || continue
    # Bridge/bond/team ports inherit IP settings from their controller.
    if ! controller=$(nmcli -g connection.controller connection show "$uuid"); then
      echo "omarchy-dns: could not read $uuid" >&2
      dns_change_failed=true
      continue
    fi
    [[ -z $controller ]] || continue

    if ! nmcli connection modify "$uuid" \
      ipv4.ignore-auto-dns no \
      ipv4.dns "" \
      ipv6.ignore-auto-dns no \
      ipv6.dns "" \
      >/dev/null; then
      echo "omarchy-dns: could not reset DNS on $uuid" >&2
      dns_change_failed=true
    fi
  done < <(nmcli -t -f UUID,TYPE connection show)
}

# Provider changes and the dispatcher hook both read resolved.conf and write
# profiles; serialize them so a hook can't pin servers a switch just replaced.
lock_dns_changes() {
  install -d -m 0755 /run/lock
  exec {dns_lock_fd}>/run/lock/omarchy-dns.lock
  flock -x "$dns_lock_fd"
}

# NetworkManager's dispatcher hook calls this as a profile comes up. Profiles
# created after the provider was chosen still take DHCP DNS, so pin the provider
# on uplink ones; VPNs keep the DNS they push.
pin_connection() {
  local uuid="$1" device="$2" dns info

  dns=$(resolved_dns)
  [[ -n $uuid && -n ${dns//[[:space:]]/} ]] || return 0

  # Read outside a condition, so an nmcli error fails the pin rather than
  # reading as an empty, skippable profile.
  info=$(profile_dns_info "$uuid")
  split_dns_servers "$dns"
  read_profile_dns_settings "$info" "$ipv4_dns" "$ipv6_dns" || return 0
  [[ $profile_dns_pinned == "no" ]] || return 0

  nmcli connection modify "$uuid" "${profile_dns_settings[@]}" >/dev/null
  if [[ -n $device ]]; then
    nmcli device reapply "$device" >/dev/null 2>&1 || true
  fi
}

reapply_active_dns_connections() {
  local device type state

  while IFS=: read -r device type state; do
    [[ -n $device && $state == connected ]] || continue
    case "$type" in
      wifi|ethernet|bridge|bond|vlan|team)
        nmcli device reapply "$device" >/dev/null 2>&1 || true
        ;;
    esac
  done < <(nmcli -t -f DEVICE,TYPE,STATE device status)
}

reload_dns_stack() {
  if systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    # Load the updated NetworkManager config first, then reapply the active
    # profiles. A single conf,dns-full reload here pushes the old active DNS
    # settings, making the shell toggle appear one selection behind.
    nmcli general reload conf >/dev/null 2>&1 || systemctl reload NetworkManager.service 2>/dev/null || true
    reapply_active_dns_connections
  fi

  systemctl reload systemd-resolved.service 2>/dev/null || systemctl restart systemd-resolved.service

  if systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    # A resolved reload/restart can leave per-link DNS stale or empty; ask
    # NetworkManager to publish DNS after resolved has reread its config.
    nmcli general reload dns-full >/dev/null 2>&1 || true
  fi
}

usage() {
  echo "Usage: omarchy-dns [Cloudflare|Google|DHCP|Custom]" >&2
}

if (( $# == 0 )); then
  current_dns_provider
  exit 0
fi

if [[ $1 == "--pin-connection" ]]; then
  require_root "$@"
  lock_dns_changes
  pin_connection "${2:-}" "${3:-}"
  exit 0
fi

if (( $# > 1 )); then
  usage
  exit 1
fi

if ! provider=$(provider_from_arg "$1"); then
  usage
  exit 1
fi

require_root "$provider"

# Ask for Custom servers before taking the lock: a prompt left open must not
# hold up other provider changes or the dispatcher hook.
if [[ $provider == "Custom" ]]; then
  echo "Enter your DNS servers (space-separated, e.g. '192.168.1.1 1.1.1.1'):"
  if ! read -r dns_servers; then
    dns_servers=""
  fi

  dns_servers=$(normalize_servers "$dns_servers")
  if [[ -z $dns_servers ]]; then
    echo "Error: No DNS servers provided." >&2
    exit 1
  fi
fi

lock_dns_changes

rm -f "$NM_DNS_CONF"
install -d -m 0755 "$(dirname "$NM_DISPATCHER_LINK")"
ln -sfn "$NM_DISPATCHER_TARGET" "$NM_DISPATCHER_LINK"

case "$provider" in
Cloudflare)
  tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
  set_connection_dns "1.1.1.1 1.0.0.1" "2606:4700:4700::1111 2606:4700:4700::1001"
  ;;

Google)
  tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNS=8.8.8.8#dns.google 8.8.4.4#dns.google 2001:4860:4860::8888#dns.google 2001:4860:4860::8844#dns.google
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
  set_connection_dns "8.8.8.8 8.8.4.4" "2001:4860:4860::8888 2001:4860:4860::8844"
  ;;

DHCP)
  tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNSOverTLS=no
EOF
  clear_connection_dns
  ;;

Custom)
  split_dns_servers "$dns_servers"
  # omarchy:heredoc-expands paths=none -- $dns_servers is a normalized,
  # single-line DNS server list; the //,/ turns its comma separators into the
  # spaces resolved.conf wants. It is written as data, not a path or command.
  tee /etc/systemd/resolved.conf >/dev/null <<EOF
[Resolve]
DNS=${dns_servers//,/ }
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
EOF
  set_connection_dns "$ipv4_dns" "$ipv6_dns"
  ;;
esac

reload_dns_stack

if [[ $dns_change_failed == "true" ]]; then
  echo "Could not update DNS on every profile; the profiles listed above keep their previous DNS." >&2
  exit 1
fi

#!/bin/bash

# omarchy:summary=Show or configure the system DNS provider
# omarchy:args=[Cloudflare|Google|DHCP|Custom]
# omarchy:examples=omarchy dns | omarchy dns Cloudflare | omarchy dns Custom

set -euo pipefail

# Whenever this runs as root — invoked directly through the passwordless
# sudoers rule, or re-execed by require_root below — sudo's secure_path decides
# where a bare helper resolves, and a dev link (etc/sudoers.d/omarchy-dev-path)
# prepends a user-writable checkout bin/ to it. Every helper this script calls
# by bare name (dirname, install, tee, rm, nmcli, systemctl, awk) is a system
# tool, never an omarchy-* command, so pin PATH to trusted system directories
# and keep root from resolving one out of that checkout. The unprivileged
# wrapper phase keeps the caller's PATH so it can still find sudo/pkexec.
if (( EUID == 0 )) && [[ -z ${OMARCHY_DNS_CONFIG_ROOT:-}${OMARCHY_DNS_ROOT_PREFIX:-}${OMARCHY_DNS_ROOT:-} ]]; then
  export PATH=/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/sbin:/bin:/sbin
fi

DNS_CONFIG_ROOT=${OMARCHY_DNS_CONFIG_ROOT:-${OMARCHY_DNS_ROOT_PREFIX:-${OMARCHY_DNS_ROOT:-}}}
if [[ -n $DNS_CONFIG_ROOT ]]; then
  [[ $DNS_CONFIG_ROOT == "/" ]] || DNS_CONFIG_ROOT=${DNS_CONFIG_ROOT%/}
  NM_DNS_CONF="$DNS_CONFIG_ROOT/etc/NetworkManager/conf.d/20-omarchy-dns.conf"
  RESOLVED_CONF="$DNS_CONFIG_ROOT/etc/systemd/resolved.conf"
  RESOLVED_DROP_IN="$DNS_CONFIG_ROOT/etc/systemd/resolved.conf.d/90-omarchy-dns.conf"
  LEGACY_RESOLVED_DROP_IN="$DNS_CONFIG_ROOT/etc/systemd/resolved.conf.d/90-dot.conf"
  DNS_LOCK_FILE="$DNS_CONFIG_ROOT/var/lock/omarchy-dns.lock"
else
  NM_DNS_CONF=/etc/NetworkManager/conf.d/20-omarchy-dns.conf
  RESOLVED_CONF=/etc/systemd/resolved.conf
  RESOLVED_DROP_IN=/etc/systemd/resolved.conf.d/90-omarchy-dns.conf
  LEGACY_RESOLVED_DROP_IN=/etc/systemd/resolved.conf.d/90-dot.conf
  DNS_LOCK_FILE=/run/lock/omarchy-dns.lock
fi
MAX_DNS_INPUT_LENGTH=4096
MAX_DNS_TOKENS=32
MAX_DNS_TOKEN_LENGTH=512
MAX_HOSTNAME_LENGTH=253
MANAGED_MARKER='# Managed by omarchy-dns.'
LEGACY_MANAGED_MARKERS=(
  '# Managed by omarchy-dns. Custom DNS-over-TLS endpoint; remove with omarchy dns DHCP.'
  '# Managed by omarchy-dns. Custom DNS-over-TLS endpoint; remove with `omarchy dns DHCP`.'
)
SNAPSHOT_DIR=
SNAPSHOT_PATHS=()
SNAPSHOT_PRESENT=()
SNAPSHOT_PROFILE_IDS=()
SNAPSHOT_PROFILE_TYPES=()
PROFILE_SNAPSHOT_PROPERTIES=(ipv4.ignore-auto-dns ipv4.dns ipv6.ignore-auto-dns ipv6.dns)
DNS_LOCK_FD=

provider_from_arg() {
  case "${1:-}" in
  Cloudflare | cloudflare)
    echo "Cloudflare"
    ;;
  Google | google)
    echo "Google"
    ;;
  DHCP | dhcp)
    echo "DHCP"
    ;;
  Custom | custom)
    echo "Custom"
    ;;
  *)
    return 1
    ;;
  esac
}

# The path etc/sudoers.d/omarchy-dns names. The privileged half always runs from
# there rather than from whichever copy was invoked, so the rule matches even
# where $OMARCHY_PATH points at a checkout.
PACKAGED_PATH=/usr/bin/omarchy-dns

# True when sudo would run this exact command without stopping for a password.
# `sudo -l` on its own reports whether a command is permitted, which the blanket
# %wheel rule answers yes to for everything; the long listing prints the matched
# entry's tags, so !authenticate is the grant in etc/sudoers.d/omarchy-dns and
# nothing else. Listing runs nothing and, under -n, prompts for nothing, so a
# machine whose omarchy-settings predates that file falls through to polkit
# instead of dying on a password prompt it has no terminal to show.
sudo_grants_passwordless() {
  sudo -n -l -l "$PACKAGED_PATH" "$@" 2>/dev/null | grep -q '!authenticate'
}

require_root() {
  if [[ -n $DNS_CONFIG_ROOT ]]; then
    return
  elif (( EUID == 0 )); then
    return
  elif [[ -t 0 ]] || sudo_grants_passwordless "$@"; then
    # A terminal can carry sudo's own password prompt. Without one, sudo is
    # right only where the grant reaches; polkit can at least put a prompt on
    # screen, and offer to authenticate as someone else.
    exec sudo "$PACKAGED_PATH" "$@"
  else
    exec pkexec "$PACKAGED_PATH" "$@"
  fi
}

networkmanager_global_dns() {
  [[ -f $NM_DNS_CONF ]] || return 0

  awk -F= '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*\[global-dns-domain-\*\][[:space:]]*$/ { in_default = 1; next }
    /^[[:space:]]*\[/ { in_default = 0 }
    in_default && /^[[:space:]]*servers[[:space:]]*=/ {
      value = $0
      sub(/^[^=]*=/, "", value)
      print value
      exit
    }
  ' "$NM_DNS_CONF"
}

resolved_dns() {
  awk -F= '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*DNS[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      print value
      exit
    }
  ' "$RESOLVED_CONF" 2>/dev/null || true
}

resolved_dropin_dns() {
  local path value

  if [[ -f $RESOLVED_DROP_IN ]]; then
    path=$RESOLVED_DROP_IN
  else
    path=$LEGACY_RESOLVED_DROP_IN
  fi
  [[ -f $path ]] || return 0

  value=$(awk -F= '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*\[Resolve\]/ { in_resolve = 1; next }
    /^[[:space:]]*\[/ { in_resolve = 0 }
    in_resolve && /^[[:space:]]*DNS[[:space:]]*=/ {
      value=$0
      sub(/^[^=]*=/, "", value)
      if (value != "") result=value
    }
    END { if (result != "") print result }
  ' "$path") || return 1
  [[ -z $value ]] || printf '%s\n' "$value"
}

resolved_dropin_managed() {
  local path marker

  if [[ -f $RESOLVED_DROP_IN && ! -L $RESOLVED_DROP_IN ]] && grep -Fqx "$MANAGED_MARKER" "$RESOLVED_DROP_IN"; then
    return 0
  fi
  if [[ -f $LEGACY_RESOLVED_DROP_IN && ! -L $LEGACY_RESOLVED_DROP_IN ]]; then
    for marker in "${LEGACY_MANAGED_MARKERS[@]}"; do
      grep -Fqx "$marker" "$LEGACY_RESOLVED_DROP_IN" && return 0
    done
  fi
  return 1
}

current_dns_provider() {
  local dns=""
  local compact=""

  dns=$(networkmanager_global_dns)
  if [[ -z $(printf '%s' "$dns" | tr -d '[:space:],') ]]; then
    dns=$(resolved_dropin_dns)
    if [[ -z $(printf '%s' "$dns" | tr -d '[:space:],') ]] && resolved_dropin_managed; then
      echo "DHCP"
      return 0
    fi
  fi
  if [[ -z $(printf '%s' "$dns" | tr -d '[:space:],') ]]; then
    dns=$(resolved_dns)
  fi

  compact=$(printf '%s' "$dns" | tr -d '[:space:],')

  if [[ -z $compact ]]; then
    echo "DHCP"
  elif [[ $dns == *"cloudflare-dns.com"* || $dns == *"1.1.1.1"* || $dns == *"2606:4700:4700::1111"* ]]; then
    echo "Cloudflare"
  elif [[ $dns == *"dns.google"* || $dns == *"8.8.8.8"* || $dns == *"2001:4860:4860::8888"* ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

is_ipv4() {
  local octet
  local -a octets=()

  [[ $1 =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
  IFS=. read -r -a octets <<<"$1"
  for octet in "${octets[@]}"; do
    [[ ${#octet} -le 3 ]] || return 1
    [[ ${#octet} -gt 1 && ${octet:0:1} != 0 ]] || [[ ${#octet} -eq 1 ]] || return 1
    ((10#$octet <= 255)) || return 1
  done
}

ipv6_side_count() {
  local side="$1" part count=0
  local -a parts=()

  [[ -n $side ]] || {
    printf '0'
    return 0
  }
  [[ $side != :* && $side != *: ]] || return 1
  IFS=: read -r -a parts <<<"$side"
  for part in "${parts[@]}"; do
    if [[ $part == *.* ]]; then
      is_ipv4 "$part" || return 1
      count=$((count + 2))
    else
      [[ $part =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      count=$((count + 1))
    fi
  done
  printf '%s' "$count"
}

is_ipv6() {
  local address="$1" remainder left right left_count right_count total

  [[ $address == *:* && $address != "::" ]] || return 1
  if [[ $address == *"::"* ]]; then
    remainder=${address#*::}
    [[ $remainder != *"::"* ]] || return 1
    left=${address%%::*}
    right=$remainder
  else
    left=$address
    right=""
  fi

  left_count=$(ipv6_side_count "$left") || return 1
  right_count=$(ipv6_side_count "$right") || return 1
  total=$((left_count + right_count))
  if [[ $address == *"::"* ]]; then
    ((total < 8)) || return 1
  else
    ((total == 8)) || return 1
  fi
}

valid_port() {
  [[ $1 =~ ^[0-9]{1,5}$ ]] || return 1
  ((10#$1 >= 1 && 10#$1 <= 65535))
}

valid_hostname() {
  local hostname="$1" label
  local -a labels=()

  [[ -n $hostname && ${#hostname} -le $MAX_HOSTNAME_LENGTH ]] || return 1
  [[ $hostname != .* && $hostname != *. && $hostname != *..* ]] || return 1
  IFS=. read -r -a labels <<<"$hostname"
  for label in "${labels[@]}"; do
    [[ $label =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] || return 1
  done
}

has_glob() {
  case "$1" in
    *'*'* | *'?'*) return 0 ;;
  esac
  return 1
}

resolve_host() {
  local family address key
  local -a addresses=()
  local -A seen=()

  for family in ahostsv4 ahostsv6; do
    while read -r address _; do
      [[ -n $address ]] || continue
      if [[ $family == ahostsv4 ]]; then
        is_ipv4 "$address" || continue
        key="v4:$address"
      else
        is_ipv6 "$address" || continue
        key="v6:$address"
      fi
      [[ -n ${seen["$key"]+yes} ]] && continue
      seen["$key"]=1
      addresses+=("$address")
    done < <(getent "$family" "$1" 2>/dev/null || true)
  done

  ((${#addresses[@]} > 0)) || return 0
  printf '%s\n' "${addresses[@]}" | sort -u
}

custom_input_error() {
  printf '%s\n' "Error: invalid custom DNS input." >&2
}

append_resolved_server() {
  local server="$1"

  [[ " ${resolved_servers} " == *" $server "* ]] && return 0
  resolved_servers+="${resolved_servers:+ }$server"
}

append_plain_server() {
  local server="$1"

  plain_servers+="${plain_servers:+ }$server"
}

parse_entries() {
  local input="$1" normalized token scheme endpoint host ip ips port server
  local saw_dot=0 saw_plain=0
  local -a tokens=()

  dot_mode=0
  resolved_servers=""
  plain_servers=""
  (( ${#input} <= MAX_DNS_INPUT_LENGTH )) || {
    custom_input_error
    return 1
  }
  [[ $input != *$'\n'* ]] || {
    custom_input_error
    return 1
  }

  normalized=${input//,/ }
  read -r -a tokens <<<"$normalized"
  ((${#tokens[@]} > 0)) || {
    custom_input_error
    return 1
  }
  ((${#tokens[@]} <= MAX_DNS_TOKENS)) || {
    custom_input_error
    return 1
  }
  [[ $normalized == *[[:alnum:]]* || $normalized == *":"* ]] || {
    custom_input_error
    return 1
  }

  for token in "${tokens[@]}"; do
    ((${#token} <= MAX_DNS_TOKEN_LENGTH)) || {
      custom_input_error
      return 1
    }
    has_glob "$token" && {
      custom_input_error
      return 1
    }

    if [[ $token == *"["* || $token == *"]"* ]]; then
      if [[ $token =~ ^\[([^]]+)\]:([0-9]+)$ ]]; then
        ip=${BASH_REMATCH[1]}
        port=${BASH_REMATCH[2]}
        if ! valid_port "$port" || { ! is_ipv4 "$ip" && ! is_ipv6 "$ip"; }; then
          custom_input_error
          return 1
        fi
        server="[$ip]:$port"
        append_plain_server "$server"
        saw_plain=1
      else
        custom_input_error
        return 1
      fi
      continue
    fi

    if [[ $token == *"://"* ]]; then
      scheme=${token%%://*}
      endpoint=${token#*://}
      if [[ $scheme != tls && $scheme != dns+tls ]] ||
        [[ -z $endpoint || $endpoint == *"/"* || $endpoint == *"?"* || $endpoint == *"@"* ||
          $endpoint == *"#"* || $endpoint == *":"* || $endpoint == *"["* || $endpoint == *"]"* ]]; then
        custom_input_error
        return 1
      fi
      if ! valid_hostname "$endpoint"; then
        custom_input_error
        return 1
      fi
      ips=$(resolve_host "$endpoint")
      if [[ -z $ips ]]; then
        custom_input_error
        return 1
      fi
      saw_dot=1
      while IFS= read -r ip; do
        [[ -n $ip ]] || continue
        append_resolved_server "$ip#$endpoint"
      done <<<"$ips"
      continue
    fi

    if [[ $token == *"#"* ]]; then
      if [[ $token == *"#"*"#"* || $token == \#* || $token == *\# ]]; then
        custom_input_error
        return 1
      fi
      ip=${token%%#*}
      host=${token#*#}
      if ! { is_ipv4 "$ip" || is_ipv6 "$ip"; } || ! valid_hostname "$host"; then
        custom_input_error
        return 1
      fi
      append_resolved_server "$ip#$host"
      saw_dot=1
      continue
    fi

    if is_ipv4 "$token" || is_ipv6 "$token"; then
      append_plain_server "$token"
      saw_plain=1
      continue
    fi

    if [[ $token == *":"* || $token == *"@"* || $token == *"/"* || $token == *"?"* || $token == *'\'* ]]; then
      custom_input_error
      return 1
    fi
    if ! valid_hostname "$token"; then
      custom_input_error
      return 1
    fi
    ips=$(resolve_host "$token")
    if [[ -z $ips ]]; then
      custom_input_error
      return 1
    fi
    saw_dot=1
    while IFS= read -r ip; do
      [[ -n $ip ]] || continue
      append_resolved_server "$ip#$token"
    done <<<"$ips"
  done

  if ((saw_dot == 1 && saw_plain == 1)); then
    custom_input_error
    return 1
  fi
  if [[ -z $resolved_servers && -z $plain_servers ]]; then
    custom_input_error
    return 1
  fi
  dot_mode=$saw_dot
}

normalize_servers() {
  local input="$1" server
  local -a servers=()

  read -r -a servers <<<"${input//,/ }"
  ((${#servers[@]} > 0)) || return 0
  printf '%s' "${servers[0]}"
  for server in "${servers[@]:1}"; do
    printf ',%s' "$server"
  done
  printf '\n'
}

networkmanager_server() {
  local server="$1" ip port

  if [[ $server =~ ^\[([^]]+)\]:([0-9]+)$ ]]; then
    ip=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[2]}
    if [[ $ip == *:* ]]; then
      printf 'dns+udp://[%s]:%s' "$ip" "$port"
    else
      printf 'dns+udp://%s:%s' "$ip" "$port"
    fi
  else
    printf '%s' "$server"
  fi
}

networkmanager_servers() {
  local input="$1" server formatted normalized=""
  local -a servers=()

  read -r -a servers <<<"${input//,/ }"
  for server in "${servers[@]}"; do
    formatted=$(networkmanager_server "$server")
    normalized+="${normalized:+,}$formatted"
  done
  printf '%s\n' "$normalized"
}

resolved_server() {
  local server="$1" ip port

  if [[ $server =~ ^\[([^]]+)\]:([0-9]+)$ ]]; then
    ip=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[2]}
    if [[ $ip == *:* ]]; then
      printf '[%s]:%s' "$ip" "$port"
    else
      printf '%s:%s' "$ip" "$port"
    fi
  else
    printf '%s' "$server"
  fi
}

resolved_servers_for_drop_in() {
  local input="$1" server formatted normalized=""
  local -a servers=()

  read -r -a servers <<<"${input//,/ }"
  for server in "${servers[@]}"; do
    formatted=$(resolved_server "$server")
    normalized+="${normalized:+ }$formatted"
  done
  printf '%s\n' "$normalized"
}

split_dns_servers() {
  local servers="$1"
  local server clean
  local -a server_tokens=()

  ipv4_dns=""
  ipv6_dns=""
  read -r -a server_tokens <<<"${servers//,/ }"
  for server in "${server_tokens[@]}"; do
    clean=${server#dns+tls://}
    clean=${clean#dns+udp://}
    clean=${clean%%#*}
    if [[ $clean =~ ^\[([^]]+)\]:[0-9]+$ ]]; then
      clean=${BASH_REMATCH[1]}
    else
      clean=${clean#[}
      clean=${clean%]}
    fi

    [[ -n $clean ]] || continue
    if [[ $clean == *:* ]]; then
      ipv6_dns+="${ipv6_dns:+ }$clean"
    else
      ipv4_dns+="${ipv4_dns:+ }$clean"
    fi
  done
}

managed_file() {
  local path="$1"

  [[ -f $path && ! -L $path ]] || return 1
  grep -Fq "$MANAGED_MARKER" "$path"
}

ensure_managed_target() {
  local path="$1"

  [[ -e $path || -L $path ]] || return 0
  if [[ -O $path ]] && managed_file "$path"; then
    return 0
  fi
  printf 'Error: refusing to overwrite unmanaged DNS configuration: %s\n' "$path" >&2
  return 1
}

legacy_managed_file() {
  local path="$1" marker

  [[ -f $path && ! -L $path ]] || return 1
  for marker in "${LEGACY_MANAGED_MARKERS[@]}"; do
    grep -Fqx "$marker" "$path" && return 0
  done
  return 1
}

ensure_legacy_managed_target() {
  local path="$1"

  [[ -e $path || -L $path ]] || return 0
  if [[ -O $path ]] && legacy_managed_file "$path"; then
    return 0
  fi
  printf 'Error: refusing to overwrite unmanaged DNS configuration: %s\n' "$path" >&2
  return 1
}

write_owned_file() {
  local path="$1" content="$2" directory temporary

  ensure_managed_target "$path" || return 1
  directory=$(dirname "$path")
  if [[ ! -d $directory ]]; then
    install -d -m 0755 "$directory" || return 1
  fi
  temporary=$(mktemp "$directory/.omarchy-dns.XXXXXX") || return 1
  if ! printf '%s\n' "$content" >"$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! chown 0:0 "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! chmod 0644 "$temporary"; then
    rm -f -- "$temporary"
    return 1
  fi
  if ! mv -f -- "$temporary" "$path"; then
    rm -f -- "$temporary"
    return 1
  fi
}

remove_owned_file() {
  local path="$1"

  [[ -e $path || -L $path ]] || return 0
  ensure_managed_target "$path" || return 1
  rm -f -- "$path"
}

remove_legacy_resolved_drop_in() {
  local path="$LEGACY_RESOLVED_DROP_IN"

  [[ -e $path || -L $path ]] || return 0
  ensure_legacy_managed_target "$path" || return 1
  rm -f -- "$path"
}

networkmanager_dns_content() {
  local servers="$1"

  printf '%s\n' "$MANAGED_MARKER" '[global-dns]' '' '[global-dns-domain-*]' "servers=$servers"
}

write_networkmanager_dns() {
  write_owned_file "$NM_DNS_CONF" "$(networkmanager_dns_content "$1")"
}

clear_networkmanager_dns() {
  remove_owned_file "$NM_DNS_CONF"
}

networkmanager_dns_connection() {
  case "$1" in
    802-11-wireless|802-3-ethernet) return 0 ;;
    *) return 1 ;;
  esac
}

modify_snapshotted_profiles() {
  local action="$1" ipv4_dns="${2:-}" ipv6_dns="${3:-}"
  local index uuid type

  for ((index = 0; index < ${#SNAPSHOT_PROFILE_IDS[@]}; index++)); do
    uuid=${SNAPSHOT_PROFILE_IDS[index]}
    type=${SNAPSHOT_PROFILE_TYPES[index]:-}
    [[ -n $uuid && -n $type ]] || continue
    networkmanager_dns_connection "$type" || continue

    case "$action" in
      set)
        nmcli connection modify "$uuid" \
          ipv4.ignore-auto-dns yes \
          ipv4.dns "$ipv4_dns" \
          ipv6.ignore-auto-dns yes \
          ipv6.dns "$ipv6_dns" \
          >/dev/null
        ;;
      clear)
        nmcli connection modify "$uuid" \
          ipv4.ignore-auto-dns no \
          ipv4.dns "" \
          ipv6.ignore-auto-dns no \
          ipv6.dns "" \
          >/dev/null
        ;;
      dot)
        nmcli connection modify "$uuid" \
          ipv4.ignore-auto-dns yes \
          ipv4.dns "" \
          ipv6.ignore-auto-dns yes \
          ipv6.dns "" \
          >/dev/null
        ;;
      *)
        return 1
        ;;
    esac
  done
}

set_connection_dns() {
  modify_snapshotted_profiles set "${1:-}" "${2:-}"
}

clear_connection_dns() {
  modify_snapshotted_profiles clear
}

# DoT mode needs no per-link DNS at all so the global drop-in (which carries the
# SNI hostname) serves each link; per-link plain IPs would drop the SNI and make
# certificate validation fail for most custom endpoints.
clear_connection_dns_dot() {
  modify_snapshotted_profiles dot
}

resolved_dropin_content() {
  local servers="$1" tls_mode="$2" fallback="${3-}"
  local -a lines=("$MANAGED_MARKER" '[Resolve]' 'DNS=')

  [[ -z $servers ]] || lines+=("DNS=$servers")
  [[ -z $fallback ]] || lines+=("FallbackDNS=$fallback")
  lines+=("DNSOverTLS=$tls_mode")
  ((${#lines[@]} > 0)) || return 1
  printf '%s\n' "${lines[@]}"
}

write_resolved_drop_in() {
  write_owned_file "$RESOLVED_DROP_IN" "$(resolved_dropin_content "$1" "$2" "${3-}")" || return 1
  remove_legacy_resolved_drop_in
}

reapply_active_dns_connections() {
  local devices device type state failed=0

  if ! devices=$(nmcli -t -f DEVICE,TYPE,STATE device status); then
    return 1
  fi
  while IFS=: read -r device type state; do
    [[ -n $device && $state == connected ]] || continue
    case "$type" in
      wifi|ethernet)
        if ! nmcli device reapply "$device" >/dev/null 2>&1; then
          failed=1
        fi
        ;;
    esac
  done <<<"$devices"
  return "$failed"
}

reload_dns_stack() {
  local networkmanager_active=0

  if systemctl is-active --quiet NetworkManager.service 2>/dev/null; then
    networkmanager_active=1
  fi

  if ((networkmanager_active == 1)); then
    if ! nmcli general reload conf >/dev/null 2>&1; then
      systemctl reload NetworkManager.service 2>/dev/null || return 1
    fi
    reapply_active_dns_connections || return 1
  fi

  if ! systemctl reload systemd-resolved.service 2>/dev/null; then
    systemctl restart systemd-resolved.service || return 1
  fi

  if ((networkmanager_active == 1)); then
    nmcli general reload dns-full >/dev/null 2>&1 || return 1
  fi
}

acquire_dns_lock() {
  local created=0 directory old_umask

  directory=$(dirname "$DNS_LOCK_FILE")
  if [[ ! -d $directory ]]; then
    install -d -m 0755 "$directory" || return 1
  fi
  if [[ -e $DNS_LOCK_FILE || -L $DNS_LOCK_FILE ]]; then
    if [[ ! -f $DNS_LOCK_FILE || -L $DNS_LOCK_FILE || ! -O $DNS_LOCK_FILE ]]; then
      printf 'Error: refusing unsafe DNS transaction lock: %s\n' "$DNS_LOCK_FILE" >&2
      return 1
    fi
    exec {DNS_LOCK_FD}<>"$DNS_LOCK_FILE" || return 1
  else
    old_umask=$(umask)
    umask 077
    set -o noclobber
    if ! exec {DNS_LOCK_FD}>"$DNS_LOCK_FILE"; then
      set +o noclobber
      umask "$old_umask"
      DNS_LOCK_FD=
      printf '%s\n' "Error: another DNS configuration transaction created the lock." >&2
      return 1
    fi
    set +o noclobber
    umask "$old_umask"
    created=1
  fi
  if ! flock -n "$DNS_LOCK_FD"; then
    exec {DNS_LOCK_FD}>&-
    DNS_LOCK_FD=
    printf '%s\n' "Error: another DNS configuration transaction is active." >&2
    return 1
  fi
  if ! chown 0:0 "$DNS_LOCK_FILE" || ! chmod 0600 "$DNS_LOCK_FILE"; then
    flock -u "$DNS_LOCK_FD" 2>/dev/null || true
    exec {DNS_LOCK_FD}>&-
    DNS_LOCK_FD=
    if ((created == 1)); then
      rm -f -- "$DNS_LOCK_FILE"
    fi
    printf '%s\n' "Error: could not secure the DNS transaction lock." >&2
    return 1
  fi
}

release_dns_lock() {
  if [[ -n ${DNS_LOCK_FD:-} ]]; then
    flock -u "$DNS_LOCK_FD" 2>/dev/null || true
    exec {DNS_LOCK_FD}>&-
    DNS_LOCK_FD=
  fi
}

snapshot_file_state() {
  local path index backup

  SNAPSHOT_PATHS=()
  SNAPSHOT_PRESENT=()
  for path in "$NM_DNS_CONF" "$RESOLVED_DROP_IN" "$LEGACY_RESOLVED_DROP_IN" "$RESOLVED_CONF"; do
    index=${#SNAPSHOT_PATHS[@]}
    SNAPSHOT_PATHS+=("$path")
    if [[ -e $path || -L $path ]]; then
      backup="$SNAPSHOT_DIR/file-$index"
      if ! cp -a -- "$path" "$backup"; then
        return 1
      fi
      SNAPSHOT_PRESENT+=(1)
    else
      SNAPSHOT_PRESENT+=(0)
    fi
  done
}

validate_profile_snapshot() {
  local profile="$1" property value extra
  local -A seen=()
  local count=0

  [[ -f $profile ]] || return 1
  if ! while IFS=$'\t' read -r property value extra; do
    [[ -n $property && -z ${extra:-} ]] || return 1
    [[ $property == ipv4.ignore-auto-dns || $property == ipv4.dns || $property == ipv6.ignore-auto-dns || $property == ipv6.dns ]] || return 1
    [[ -z ${seen[$property]+yes} ]] || return 1
    seen["$property"]=1
    count=$((count + 1))
  done <"$profile"; then
    return 1
  fi
  ((count == ${#PROFILE_SNAPSHOT_PROPERTIES[@]})) || return 1
  for property in "${PROFILE_SNAPSHOT_PROPERTIES[@]}"; do
    [[ -n ${seen[$property]+yes} ]] || return 1
  done
}

snapshot_profile_state() {
  local uuid type property value index profile
  local -A seen=()

  SNAPSHOT_PROFILE_IDS=()
  SNAPSHOT_PROFILE_TYPES=()
  if ! nmcli -t -f UUID,TYPE connection show >"$SNAPSHOT_DIR/profiles.list"; then
    return 1
  fi
  while IFS=: read -r uuid type; do
    if [[ -z $uuid && -z $type ]]; then
      continue
    fi
    [[ -n $uuid && -n $type && $uuid != *:* && $type != *:* && $uuid != *$'\t'* && $type != *$'\t'* ]] || return 1
    if [[ -n ${seen["$uuid"]+yes} ]]; then
      [[ ${seen["$uuid"]} == "$type" ]] || return 1
      continue
    fi
    seen["$uuid"]=$type
    networkmanager_dns_connection "$type" || continue
    index=${#SNAPSHOT_PROFILE_IDS[@]}
    profile="$SNAPSHOT_DIR/profile-$index"
    if ! : >"$profile"; then
      return 1
    fi
    for property in "${PROFILE_SNAPSHOT_PROPERTIES[@]}"; do
      if ! value=$(nmcli -g "$property" connection show "$uuid" 2>/dev/null); then
        return 1
      fi
      [[ $value != *$'\n'* && $value != *$'\r'* && $value != *$'\t'* ]] || return 1
      if ! printf '%s\t%s\n' "$property" "$value" >>"$profile"; then
        return 1
      fi
    done
    if ! validate_profile_snapshot "$profile"; then
      return 1
    fi
    SNAPSHOT_PROFILE_IDS+=("$uuid")
    SNAPSHOT_PROFILE_TYPES+=("$type")
  done <"$SNAPSHOT_DIR/profiles.list"
  ((${#SNAPSHOT_PROFILE_IDS[@]} == ${#SNAPSHOT_PROFILE_TYPES[@]})) || return 1
}

begin_dns_transaction() {
  local snapshot_base snapshot_status=0

  ensure_managed_target "$NM_DNS_CONF" || return 1
  ensure_managed_target "$RESOLVED_DROP_IN" || return 1
  ensure_legacy_managed_target "$LEGACY_RESOLVED_DROP_IN" || return 1
  snapshot_base=$(dirname "$DNS_LOCK_FILE")
  SNAPSHOT_DIR=$(mktemp -d "$snapshot_base/.omarchy-dns-snapshot.XXXXXX") || return 1
  snapshot_file_state || snapshot_status=$?
  if ((snapshot_status == 0)); then
    snapshot_profile_state || snapshot_status=$?
  fi
  if ((snapshot_status != 0)); then
    rm -rf -- "$SNAPSHOT_DIR" || true
    SNAPSHOT_DIR=
    return 1
  fi
}

restore_file_state() {
  local index path backup present directory stage failed=0
  local -a stages=() targets=() removals=()

  for ((index = ${#SNAPSHOT_PATHS[@]} - 1; index >= 0; index--)); do
    path=${SNAPSHOT_PATHS[index]}
    present=${SNAPSHOT_PRESENT[index]}
    backup="$SNAPSHOT_DIR/file-$index"
    if ((present == 1)); then
      [[ -e $backup || -L $backup ]] || {
        failed=1
        continue
      }
      directory=$(dirname "$path")
      if ! stage=$(mktemp "$directory/.omarchy-dns-restore.XXXXXX"); then
        failed=1
        continue
      fi
      if ! cp -a -- "$backup" "$stage"; then
        rm -f -- "$stage" || true
        failed=1
        continue
      fi
      stages+=("$stage")
      targets+=("$path")
    elif [[ -e $path || -L $path ]]; then
      if managed_file "$path"; then
        removals+=("$path")
      else
        failed=1
      fi
    fi
  done

  if ((failed == 1)); then
    for stage in "${stages[@]}"; do
      rm -f -- "$stage" || true
    done
    return 1
  fi

  for ((index = 0; index < ${#stages[@]}; index++)); do
    if ! mv -f -- "${stages[index]}" "${targets[index]}"; then
      failed=1
      break
    fi
  done
  if ((failed == 1)); then
    for ((index = 0; index < ${#stages[@]}; index++)); do
      [[ -e ${stages[index]} || -L ${stages[index]} ]] && rm -f -- "${stages[index]}" || true
    done
    return 1
  fi

  for path in "${removals[@]}"; do
    rm -f -- "$path" || failed=1
  done
  return "$failed"
}

restore_profile_state() {
  local index uuid property value extra profile failed=0

  for ((index = 0; index < ${#SNAPSHOT_PROFILE_IDS[@]}; index++)); do
    uuid=${SNAPSHOT_PROFILE_IDS[index]}
    profile="$SNAPSHOT_DIR/profile-$index"
    if ! validate_profile_snapshot "$profile"; then
      failed=1
      continue
    fi
    while IFS=$'\t' read -r property value extra; do
      nmcli connection modify "$uuid" "$property" "$value" >/dev/null || failed=1
    done <"$profile"
  done
  return "$failed"
}

rollback_dns_transaction() {
  local failed=0

  restore_file_state || failed=1
  restore_profile_state || failed=1
  reload_dns_stack || failed=1
  return "$failed"
}

finish_dns_transaction() {
  if [[ -n ${SNAPSHOT_DIR:-} ]]; then
    rm -rf -- "$SNAPSHOT_DIR"
    SNAPSHOT_DIR=
  fi
}

run_dns_transaction() {
  local status rollback_status=0

  acquire_dns_lock || return 1
  if ! begin_dns_transaction; then
    release_dns_lock
    return 1
  fi
  set +e
  (set -e; "$@")
  status=$?
  set -e
  if ((status == 0)); then
    finish_dns_transaction
    release_dns_lock
    return 0
  else
    rollback_dns_transaction || rollback_status=$?
    if ((rollback_status == 0)); then
      finish_dns_transaction
    else
      printf '%s\n' "Error: DNS configuration rollback did not complete." >&2
      printf 'DNS recovery snapshot retained at %s\n' "$SNAPSHOT_DIR" >&2
    fi
    release_dns_lock
    return "$status"
  fi
}

apply_provider() {
  case "$1" in
    Cloudflare)
      write_networkmanager_dns "1.1.1.1,1.0.0.1,2606:4700:4700::1111,2606:4700:4700::1001"
      set_connection_dns "1.1.1.1 1.0.0.1" "2606:4700:4700::1111 2606:4700:4700::1001"
      write_resolved_drop_in "1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com" opportunistic "9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net"
      ;;
    Google)
      write_networkmanager_dns "8.8.8.8,8.8.4.4,2001:4860:4860::8888,2001:4860:4860::8844"
      set_connection_dns "8.8.8.8 8.8.4.4" "2001:4860:4860::8888 2001:4860:4860::8844"
      write_resolved_drop_in "8.8.8.8#dns.google 8.8.4.4#dns.google 2001:4860:4860::8888#dns.google 2001:4860:4860::8844#dns.google" opportunistic "9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net"
      ;;
    DHCP)
      clear_networkmanager_dns
      clear_connection_dns
      write_resolved_drop_in "" no
      ;;
  esac
  reload_dns_stack
}

apply_custom_dot() {
  clear_networkmanager_dns
  clear_connection_dns_dot
  write_resolved_drop_in "$1" yes
  reload_dns_stack
}

apply_custom_plain() {
  local servers="$1"
  local nm_servers resolved_plain_servers

  dns_servers=$(normalize_servers "$servers")
  nm_servers=$(networkmanager_servers "$dns_servers")
  resolved_plain_servers=$(resolved_servers_for_drop_in "$dns_servers")
  split_dns_servers "$dns_servers"
  write_networkmanager_dns "$nm_servers"
  set_connection_dns "$ipv4_dns" "$ipv6_dns"
  write_resolved_drop_in "$resolved_plain_servers" no "9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net"
  reload_dns_stack
}

read_dns_input() {
  local input="" character status

  while true; do
    if IFS= read -r -n 1 character; then
      if [[ -z $character ]]; then
        input+=$'\n'
      else
        input+=$character
      fi
    else
      status=$?
      ((status == 1)) || return 1
      break
    fi
    ((${#input} <= MAX_DNS_INPUT_LENGTH + 1)) || return 1
  done

  while [[ $input == *[[:space:]] ]]; do
    input=${input%?}
  done
  ((${#input} <= MAX_DNS_INPUT_LENGTH)) || return 1
  printf '%s' "$input"
}

usage() {
  echo "Usage: omarchy-dns [Cloudflare|Google|DHCP|Custom]" >&2
}

if (( $# == 0 )); then
  current_dns_provider
  exit 0
fi

if (( $# > 1 )); then
  usage
  exit 1
fi

if ! provider=$(provider_from_arg "$1"); then
  usage
  exit 1
fi

parse_only=0
if [[ ${OMARCHY_DNS_PARSE_ONLY:-0} == 1 ]]; then
  if [[ $provider != Custom ]]; then
    usage
    exit 1
  fi
  parse_only=1
else
  require_root "$provider"
fi

if [[ $provider == Custom ]]; then
  if ((parse_only == 0)); then
    echo "Enter DNS servers (space-separated): plain IPs, bracketed IP:port, tls://host, IP#host, or a bare hostname for DoT:"
  fi
  if ! dns_servers=$(read_dns_input); then
    custom_input_error
    exit 1
  fi

  if ! parse_entries "$dns_servers"; then
    exit 1
  fi

  if ((parse_only == 1)); then
    if ((dot_mode == 1)); then
      printf 'transport=dot\nservers=%s\n' "$resolved_servers"
    else
      printf 'transport=plain\nservers=%s\n' "$plain_servers"
    fi
    exit 0
  fi

  if ((dot_mode == 1)); then
    run_dns_transaction apply_custom_dot "$resolved_servers"
  else
    run_dns_transaction apply_custom_plain "$plain_servers"
  fi
else
  run_dns_transaction apply_provider "$provider"
fi

#!/bin/bash

# omarchy:summary=Pin Electron's password store to gnome-libsecret
# omarchy:hidden=true

set -euo pipefail

# Arch's electronN launcher reads electronN-flags.conf when that file exists,
# and electron-flags.conf otherwise. A versioned file with no pin hides the
# fallback, so an existing one is pinned too. An uncommented --password-store=
# line is left alone. A commented-out flag is not a choice.
pin_electron_flags() {
  local flags_file="$1"

  if [[ ! -f $flags_file ]] || ! grep -Eq '^[[:space:]]*--password-store=' "$flags_file"; then
    mkdir -p "${flags_file%/*}"

    if [[ -f $flags_file && -n $(tail -c1 "$flags_file") ]]; then
      echo >>"$flags_file"
    fi

    echo '--password-store=gnome-libsecret' >>"$flags_file"
  fi
}

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}
pin_electron_flags "$config_dir/electron-flags.conf"

shopt -s nullglob
for flags_file in "$config_dir"/electron[0-9]*-flags.conf; do
  pin_electron_flags "$flags_file"
done
shopt -u nullglob

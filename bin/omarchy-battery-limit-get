#!/bin/bash

# omarchy:summary=Print the current battery charge limit percentage.
# omarchy:hidden=true

power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

for threshold in "$power_supply_path"/*/charge_control_end_threshold; do
  [[ -r $threshold ]] || continue
  battery=${threshold%/*}
  # Peripheral batteries do not power the machine. Keep unscoped older drivers.
  [[ -r $battery/scope && $(<"$battery/scope") == "Device" ]] && continue
  cat "$threshold"
  exit 0
done

exit 1

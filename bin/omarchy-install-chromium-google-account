#!/bin/bash

# omarchy:summary=Remove Chromium's broken Google OAuth workaround and prefer Chrome for Google accounts
# omarchy:examples=omarchy install chromium google account

set -euo pipefail

CONF="${HOME}/.config/chromium-flags.conf"
removed=0

strip_oauth_flags() {
  local file="$1"

  [[ -f $file ]] || return 0

  if grep -qE -- '^--oauth2-client-(id|secret)=' "$file"; then
    local tmp
    tmp=$(mktemp)
    grep -vE -- '^--oauth2-client-(id|secret)=' "$file" >"$tmp"
    mv "$tmp" "$file"
    removed=1
  fi
}

echo "Chromium Google account support..."

# The Chrome OAuth client id/secret workaround lets Chromium attempt Google
# sign-in, but on Chromium 136+ (including 151 on Omarchy) it trips a browser
# process SIGTRAP when visiting Google Search, signing in, or enabling Sync.
# See https://github.com/omacom/omarchy/issues/2225
strip_oauth_flags "$CONF"

if (( removed )); then
  echo "Removed --oauth2-client-id / --oauth2-client-secret from $CONF."
  echo "Restart Chromium so the change takes effect."
else
  echo "No Google OAuth workaround flags were present in $CONF."
fi

echo
echo "Google account sign-in belongs in Google Chrome, not open-source Chromium."

if omarchy-pkg-present google-chrome; then
  echo "Chrome is already installed. Use it for Google accounts, or make it the"
  echo "default via Setup > Defaults > Browser (omarchy default browser chrome)."
else
  echo "Installing Chrome so Google accounts work without crashing Chromium..."
  omarchy-install-browser chrome
fi

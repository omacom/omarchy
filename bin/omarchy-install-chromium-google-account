#!/bin/bash

# omarchy:summary=Allow Chromium to sign in to Google accounts by adding OAuth credentials
# omarchy:group=install

set -euo pipefail

# Credentials used to be hardcoded in this script (#9118). Keep the shipped
# defaults in default/chromium/google-oauth.env so they can be overridden or
# rotated without editing the installer. Prefer admin/user drop-ins.
load_oauth_env() {
  local file

  for file in \
    "${OMARCHY_CHROMIUM_OAUTH_ENV:-}" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/chromium-google-oauth.env" \
    /etc/omarchy/chromium-google-oauth.env \
    "${OMARCHY_PATH:-/usr/share/omarchy}/default/chromium/google-oauth.env"; do
    [[ -n $file && -f $file ]] || continue
    # shellcheck disable=SC1090
    source "$file"
    return 0
  done

  return 1
}

# Match omarchy-refresh-chromium and the Chromium account menu.
CONF="$HOME/.config/chromium-flags.conf"

if [[ ! -f $CONF ]]; then
  echo "No $CONF yet — run omarchy-refresh-chromium, then re-run this command." >&2
  exit 1
fi

if ! load_oauth_env; then
  echo "No Chromium Google OAuth config found." >&2
  exit 1
fi

if [[ -z ${OAUTH2_CLIENT_ID:-} || -z ${OAUTH2_CLIENT_SECRET:-} ]]; then
  echo "Chromium Google OAuth config is missing OAUTH2_CLIENT_ID or OAUTH2_CLIENT_SECRET." >&2
  exit 1
fi

echo "Installing Chromium Google account support..."

# Chromium keeps the last occurrence of a repeated switch. Drop any prior
# OAuth pair before appending so credential rotation or revert takes effect.
# Preserve dotfile symlinks and prepare the complete replacement beside its
# target. A failed read or write must leave the previous flags untouched.
if [[ -L $CONF ]]; then
  CONF=$(readlink -f "$CONF")
fi
tmp=$(mktemp "$CONF.tmp.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
filter_status=0
grep -Ev -- '^--oauth2-client-(id|secret)=' "$CONF" >"$tmp" || filter_status=$?
# grep returns 1 when every old line was an OAuth flag (or the file is empty).
if (( filter_status > 1 )); then
  exit "$filter_status"
fi
printf '%s\n' "--oauth2-client-id=$OAUTH2_CLIENT_ID" "--oauth2-client-secret=$OAUTH2_CLIENT_SECRET" >>"$tmp"

# Flags file can hold a client secret; prefer owner-readable only. The packaged
# default credentials remain world-readable under default/chromium/.
chmod 600 "$tmp"
mv -- "$tmp" "$CONF"

echo "Now you can login to your Google Account in Chromium."

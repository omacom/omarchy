#!/usr/bin/python3
# omarchy:summary=Print the Grok usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Grok CLI usage into one display-ready JSON record.

Local stats come from the usage.json files Grok writes under
$GROK_HOME/sessions (default ~/.grok/sessions). Weekly credit limits come
from the same CLI billing endpoint the Grok TUI uses
(`/v1/billing?format=credits`). SuperGrok is a shared weekly pool across
Chat, Imagine, Voice, and Build — there is no separate 5-hour session
window — so the panel shows that weekly meter and Grok Build's share of
it. The agents panel only ever reads the JSON this prints.
"""

from __future__ import annotations

import argparse
import base64
import fcntl
import hashlib
import json
import os
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Iterator

AGENT_ID = "grok"
AGENT_NAME = "Grok"
AUTH_HELP = "Run `grok` and sign in to start recording usage."
BILLING_ENDPOINT = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
TOKEN_ENDPOINT = "https://auth.x.ai/oauth2/token"
CLIENT_VERSION = "1.0.41"
PROBE_MIN_INTERVAL_SECONDS = 15

# JWT `tier` on the Grok CLI access token. Same numbering the CLI and
# xAI's billing UI use for the plan line.
TIER_LABELS = {
  0: "Free",
  1: "SuperGrok",
  2: "X Basic",
  3: "X Premium",
  4: "X Premium+",
  5: "SuperGrok Heavy",
  6: "SuperGrok Lite",
  7: "SuperGrok+",
}

# A scan this recent is only reused to dedup concurrent collector runs (the
# update command backgrounds one per agent while the panel refreshes on its
# own); every periodic widget refresh lands a real rescan, however low
# refreshIntervalSec is set. --limits-only promises only fresh limits, so it
# may reuse a scan for up to 15 minutes.
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900


def grok_home() -> Path:
  raw = os.environ.get("GROK_HOME") or str(Path.home() / ".grok")
  return Path(os.path.expandvars(os.path.expanduser(raw))).resolve()


def number(value: Any) -> int:
  try:
    n = float(value or 0)
    return round(n) if n == n else 0
  except (TypeError, ValueError):
    return 0


def local_date_string() -> str:
  return datetime.now().strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = datetime.now().date()
  return [(today - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]


def local_day(value: Any) -> str:
  if value is None:
    return local_date_string()
  if isinstance(value, (int, float)):
    try:
      seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
      return datetime.fromtimestamp(seconds).strftime("%Y-%m-%d")
    except (OSError, OverflowError, ValueError):
      return local_date_string()

  raw = str(value).strip()
  if not raw:
    return local_date_string()
  try:
    parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    if parsed.tzinfo is not None:
      parsed = parsed.astimezone()
    return parsed.strftime("%Y-%m-%d")
  except ValueError:
    return local_date_string()


def empty_bucket() -> dict[str, int]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
  }


def empty_stats() -> dict[str, Any]:
  today = local_date_string()
  recent_dates = recent_date_strings()
  return {
    "todayPrompts": 0,
    "todaySessions": 0,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates],
    "totalPrompts": 0,
    "totalSessions": 0,
    "activeDays": 0,
    "activeDates": [],
    "modelUsage": {},
    "_today": today,
    "_recent_dates": recent_dates,
  }


def split_tokens(usage: dict[str, Any]) -> tuple[int, int, int, int]:
  # Grok reports inputTokens including cached reads (the cache hit is still
  # input) and cachedReadTokens as that subset. Subtract so the four panel
  # buckets stay mutually exclusive, matching the Claude and Codex collectors.
  cache_read = number(usage.get("cachedReadTokens", usage.get("cacheReadInputTokens")))
  cache_write = number(usage.get("cacheCreationTokens", usage.get("cacheCreationInputTokens")))
  input_raw = number(usage.get("inputTokens"))
  output_tokens = number(usage.get("outputTokens"))
  input_tokens = max(0, input_raw - cache_read) if cache_read <= input_raw else input_raw
  return input_tokens, output_tokens, cache_read, cache_write


def model_name(raw: Any) -> str:
  name = str(raw or "grok").strip()
  return name if name else "grok"


def iter_events(payload: dict[str, Any], path: Path) -> Iterator[tuple[str, str, dict[str, Any]]]:
  session_id = str(payload.get("sessionId") or path.parent.name)
  turns = payload.get("turns")
  if isinstance(turns, list) and turns:
    for turn in turns:
      if not isinstance(turn, dict):
        continue
      day = local_day(turn.get("endedAt") or payload.get("updatedAt") or path.stat().st_mtime)
      yield session_id, day, turn
    return

  session = payload.get("session")
  if isinstance(session, dict):
    day = local_day(payload.get("updatedAt") or path.stat().st_mtime)
    yield session_id, day, session


def iter_model_buckets(event: dict[str, Any]) -> Iterator[tuple[str, tuple[int, int, int, int]]]:
  models = event.get("modelUsage")
  if isinstance(models, dict) and models:
    emitted = False
    for name, bucket in models.items():
      if not isinstance(bucket, dict):
        continue
      tokens = split_tokens(bucket)
      if not any(tokens):
        continue
      yield model_name(name), tokens
      emitted = True
    if emitted:
      return
  tokens = split_tokens(event)
  if any(tokens):
    yield model_name(event.get("primaryModelId")), tokens


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def scan_cache_paths(home: Path) -> tuple[Path, Path]:
  digest = hashlib.sha1(str(home).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"grok-scan-{digest}.json", root / f"grok-scan-{digest}.lock"


def write_json(path: Path, payload: dict[str, Any]) -> None:
  # A temp name unique to this writer, not derived from the target: several
  # collectors can run at once (the update command backgrounds one per agent,
  # the panel refreshes on its own), and a shared temp path means the second
  # replace finds the first one's file already moved away.
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      payload = json.loads(path.read_text(encoding="utf-8"))
      return payload if isinstance(payload, dict) else None
  except Exception:
    return None
  return None


def read_cached_stats(cache_file: Path, max_age_seconds: float) -> dict[str, Any] | None:
  cached = read_fresh_json(cache_file, max_age_seconds)
  if not isinstance(cached, dict) or cached.get("schemaVersion") != 1:
    return None
  if cached.get("scanDate") != local_date_string():
    return None
  stats = cached.get("stats")
  if not isinstance(stats, dict):
    return None
  required = ("todayPrompts", "todayTotalTokens", "recentDays", "activeDates", "modelUsage")
  if not all(key in stats for key in required):
    return None
  return stats


def write_cached_stats(cache_file: Path, stats: dict[str, Any]) -> None:
  try:
    write_json(cache_file, {"schemaVersion": 1, "scanDate": local_date_string(), "stats": stats})
  except Exception as exc:
    print(f"omarchy-agent-usage-grok: could not write usage cache ({exc})", file=sys.stderr)


def public_stats(stats: dict[str, Any]) -> dict[str, Any]:
  return {key: value for key, value in stats.items() if not str(key).startswith("_")}


def scan_sessions(home: Path) -> dict[str, Any]:
  stats = empty_stats()
  today = stats["_today"]
  recent_dates: list[str] = stats["_recent_dates"]
  recent = {day: {"date": day, "messageCount": 0} for day in recent_dates}
  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0

  sessions_root = home / "sessions"
  files = sessions_root.rglob("usage.json") if sessions_root.is_dir() else []
  for path in files:
    if not path.is_file():
      continue
    try:
      payload = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
      print(f"Ignoring unreadable Grok usage file {path}: {exc}", file=sys.stderr)
      continue
    if not isinstance(payload, dict):
      continue

    try:
      for session_id, day, event in iter_events(payload, path):
        buckets = list(iter_model_buckets(event))
        if not buckets:
          continue
        session_key = str(session_id)
        prompts += 1
        sessions.add(session_key)
        active_days.add(day)
        if day == today:
          today_prompt_count += 1
          today_sessions.add(session_key)

        for model, (input_tokens, output_tokens, cache_read, cache_write) in buckets:
          total = input_tokens + output_tokens + cache_read + cache_write
          if total <= 0:
            continue
          bucket = usage_by_model.setdefault(model, empty_bucket())
          bucket["inputTokens"] += input_tokens
          bucket["outputTokens"] += output_tokens
          bucket["cacheReadInputTokens"] += cache_read
          bucket["cacheCreationInputTokens"] += cache_write
          if day in recent:
            recent[day]["messageCount"] += total
          if day == today:
            today_token_total += total
            today_tokens[model] = today_tokens.get(model, 0) + total
    except OSError as exc:
      print(f"Ignoring unreadable Grok usage file {path}: {exc}", file=sys.stderr)

  stats.update({
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [recent[day] for day in recent_dates],
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "modelUsage": usage_by_model,
  })
  return public_stats(stats)


def cached_scan(home: Path, max_age_seconds: float) -> dict[str, Any]:
  try:
    return _cached_scan(home, max_age_seconds)
  except Exception as exc:
    print(f"omarchy-agent-usage-grok: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    return scan_sessions(home)


def _cached_scan(home: Path, max_age_seconds: float) -> dict[str, Any]:
  cache_file, lock_file = scan_cache_paths(home)
  cached = read_cached_stats(cache_file, max_age_seconds)
  if cached is not None:
    return cached

  lock_file.parent.mkdir(parents=True, exist_ok=True)
  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    cached = read_cached_stats(cache_file, max_age_seconds)
    if cached is not None:
      return cached
    stats = scan_sessions(home)
    write_cached_stats(cache_file, stats)
    return stats


def signed_in(home: Path) -> bool:
  return (home / "auth.json").is_file()


# ------------------------------------------------------------------- limits


def jwt_claims(token: str) -> dict[str, Any]:
  try:
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    data = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
    return data if isinstance(data, dict) else {}
  except Exception:
    return {}


def tier_label_from_token(token: str) -> str:
  claims = jwt_claims(token)
  named = str(claims.get("subscription_tier") or claims.get("subscriptionTier") or claims.get("plan") or "").strip()
  if named:
    return display_plan(named)
  try:
    return TIER_LABELS.get(int(claims.get("tier")), "")
  except (TypeError, ValueError):
    return ""


def display_plan(value: str) -> str:
  words = value.strip().replace("_", " ").replace("-", " ").split()
  mapped = []
  for word in words:
    key = word.lower()
    if key == "supergrok":
      mapped.append("SuperGrok")
    elif key in ("supergrokpro", "heavy"):
      mapped.append("Heavy")
    elif key in ("supergroklite", "lite"):
      mapped.append("Lite")
    elif key in ("supergrokplus", "plus"):
      mapped.append("SuperGrok+")
    else:
      mapped.append(word[:1].upper() + word[1:].lower() if word else word)
  return " ".join(mapped)


def parse_expires_at_ms(value: Any) -> int:
  if value is None or value == "":
    return 0
  if isinstance(value, (int, float)):
    n = float(value)
    return int(n if n > 10_000_000_000 else n * 1000)
  raw = str(value).strip()
  if raw.isdigit():
    return parse_expires_at_ms(int(raw))
  try:
    parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    if parsed.tzinfo is None:
      parsed = parsed.replace(tzinfo=timezone.utc)
    return int(parsed.timestamp() * 1000)
  except ValueError:
    return 0


def oauth_login(home: Path) -> dict[str, Any]:
  empty = {
    "access_token": "",
    "expires_at_ms": 0,
    "refresh_token": "",
    "user_id": "",
    "client_id": "",
    "principal_type": "",
    "principal_id": "",
    "tier_label": "",
  }
  try:
    data = json.loads((home / "auth.json").read_text(encoding="utf-8"))
  except Exception:
    return empty
  if not isinstance(data, dict):
    return empty

  chosen: dict[str, Any] | None = None
  for value in data.values():
    if not isinstance(value, dict) or not value.get("key"):
      continue
    chosen = value
    expires = parse_expires_at_ms(value.get("expires_at"))
    if expires == 0 or expires > time.time() * 1000:
      break
  if chosen is None:
    return empty

  token = str(chosen.get("key") or "")
  return {
    "access_token": token,
    "expires_at_ms": parse_expires_at_ms(chosen.get("expires_at")),
    "refresh_token": str(chosen.get("refresh_token") or ""),
    "user_id": str(chosen.get("user_id") or chosen.get("principal_id") or ""),
    "client_id": str(chosen.get("oidc_client_id") or ""),
    "principal_type": str(chosen.get("principal_type") or ""),
    "principal_id": str(chosen.get("principal_id") or ""),
    "tier_label": tier_label_from_token(token),
  }


def refresh_access_token(login: dict[str, Any]) -> str:
  refresh = login.get("refresh_token") or ""
  if not refresh:
    return ""
  body = {
    "grant_type": "refresh_token",
    "refresh_token": refresh,
    "client_id": login.get("client_id") or "b1a00492-073a-47ea-816f-4c329264a828",
  }
  if login.get("principal_type"):
    body["principal_type"] = login["principal_type"]
  if login.get("principal_id"):
    body["principal_id"] = login["principal_id"]
  request = urllib.request.Request(
    TOKEN_ENDPOINT,
    data=urllib.parse.urlencode(body).encode("utf-8"),
    headers={
      "Accept": "application/json",
      "Content-Type": "application/x-www-form-urlencoded",
      "x-grok-client-version": CLIENT_VERSION,
    },
    method="POST",
  )
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except Exception:
    return ""
  if not isinstance(payload, dict):
    return ""
  return str(payload.get("access_token") or "")


def parse_utilization(value: Any) -> float:
  try:
    return float(str(value).strip().replace("%", ""))
  except Exception:
    return float("nan")


def normalize_utilization(value: Any, percent_scale: bool) -> float:
  n = parse_utilization(value)
  if not (n >= 0):
    return -1.0
  if percent_scale or n > 1:
    return min(1.0, n / 100.0)
  return min(1.0, n)


def normalize_reset_at(value: Any) -> str:
  if value is None:
    return ""
  raw = str(value).strip()
  if raw == "":
    return ""
  try:
    parsed = datetime.fromisoformat(raw.replace("Z", "+00:00"))
    return parsed.isoformat()
  except Exception:
    return raw


def period_window(period: dict[str, Any] | None, config: dict[str, Any]) -> tuple[str, str]:
  period = period if isinstance(period, dict) else {}
  kind = str(period.get("type") or "").upper()
  start = period.get("start") or config.get("billingPeriodStart") or config.get("billing_period_start")
  end = period.get("end") or config.get("billingPeriodEnd") or config.get("billing_period_end")
  resets = normalize_reset_at(end)
  duration_minutes = 0
  try:
    if start and end:
      begin = datetime.fromisoformat(str(start).replace("Z", "+00:00"))
      finish = datetime.fromisoformat(str(end).replace("Z", "+00:00"))
      duration_minutes = max(0, int((finish - begin).total_seconds() / 60))
  except Exception:
    duration_minutes = 0
  weekly = "WEEKLY" in kind or (9000 <= duration_minutes <= 11000)
  monthly = "MONTHLY" in kind or (38000 <= duration_minutes <= 46000)
  if weekly:
    return "Weekly (7-day)", resets
  if monthly:
    return "Monthly", resets
  return "Weekly (7-day)", resets


def product_percent(config: dict[str, Any], name: str) -> Any:
  rows = config.get("productUsage") or config.get("product_usage")
  if not isinstance(rows, list):
    return None
  for row in rows:
    if not isinstance(row, dict):
      continue
    if str(row.get("product") or "") != name:
      continue
    if "usagePercent" in row:
      return row.get("usagePercent")
    if "usage_percent" in row:
      return row.get("usage_percent")
  return None


def parse_billing(payload: dict[str, Any]) -> list[dict[str, Any]]:
  config = payload.get("config")
  if not isinstance(config, dict):
    return []
  period = config.get("currentPeriod") or config.get("current_period")
  label, resets = period_window(period if isinstance(period, dict) else None, config)
  overall = config.get("creditUsagePercent", config.get("credit_usage_percent"))
  build = product_percent(config, "GrokBuild")
  raw = [overall, build]
  percent_scale = any(parse_utilization(v) >= 1 for v in raw if v is not None)

  limits: list[dict[str, Any]] = []
  weekly = normalize_utilization(overall, percent_scale)
  if weekly >= 0:
    limits.append({"label": label, "percent": weekly, "resetsAt": resets})
  build_percent = normalize_utilization(build, percent_scale)
  if build_percent >= 0:
    limits.append({"label": "Grok Build", "percent": build_percent, "resetsAt": resets})
  return limits


def probe_limits(access_token: str, user_id: str) -> dict[str, Any]:
  request = urllib.request.Request(
    BILLING_ENDPOINT,
    headers={
      "Authorization": "Bearer " + access_token,
      "Accept": "application/json",
      "x-xai-token-auth": "xai-grok-cli",
      "x-userid": user_id,
      "x-grok-client-version": CLIENT_VERSION,
      "x-grok-client-mode": "headless",
    },
  )
  try:
    with urllib.request.urlopen(request, timeout=10) as response:
      payload = json.loads(response.read().decode("utf-8", errors="replace"))
  except urllib.error.HTTPError as error:
    if error.code == 429:
      help_text = "Grok's billing endpoint is rate limiting checks right now. Local Grok stats are still shown."
    else:
      help_text = f"Grok's billing endpoint returned status {error.code}. Local Grok stats are still shown."
    return {"ok": False, "helpText": help_text}
  except Exception:
    return {
      "ok": False,
      "transport": True,
      "helpText": "Couldn't reach Grok's billing endpoint. Retrying shortly. Local Grok stats are still shown.",
    }

  if not isinstance(payload, dict):
    return {"ok": False, "helpText": "Grok's billing endpoint returned no limits. Local Grok stats are still shown."}
  limits = parse_billing(payload)
  if not limits:
    return {"ok": False, "helpText": "Grok's billing endpoint returned no limits. Local Grok stats are still shown."}
  return {"ok": True, "limits": limits}


def limit_window_open(entry: dict[str, Any], now: datetime) -> bool:
  raw = str(entry.get("resetsAt") or "")
  if raw == "":
    return True
  try:
    resets_at = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=timezone.utc)
  return resets_at > now


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = datetime.now(timezone.utc)
  return [entry for entry in entries if isinstance(entry, dict) and limit_window_open(entry, now)]


def collect_limits(login: dict[str, Any], force: bool) -> dict[str, Any]:
  result = {"limits": [], "usageStatusText": "", "authHelpText": AUTH_HELP, "tierLabel": login.get("tier_label") or ""}
  try:
    probe_cache: Path | None = cache_root() / "grok-limits.json"
    cached = read_fresh_json(probe_cache, float("inf")) or {}
  except Exception:
    probe_cache = None
    cached = {}
  fallback = usable_cached_limits(cached)

  token = login.get("access_token") or ""
  expires_at_ms = number(login.get("expires_at_ms"))
  if token == "":
    result["limits"] = fallback
    result["usageStatusText"] = "Waiting for auth"
    return result

  expired = expires_at_ms > 0 and expires_at_ms <= time.time() * 1000
  if expired:
    refreshed = refresh_access_token(login)
    if refreshed:
      token = refreshed
      login = dict(login, access_token=refreshed)
      if not result["tierLabel"]:
        result["tierLabel"] = tier_label_from_token(refreshed)
      expired = False
  if expired:
    result["limits"] = fallback
    result["usageStatusText"] = "Sign-in expired"
    result["authHelpText"] = (
      "Grok's saved sign-in expired"
      + (" — showing the last known limits." if fallback else ".")
      + " Start Grok, or run `grok login`, to refresh it."
    )
    return result

  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    result["limits"] = fallback
    result["authHelpText"] = ""
    return result

  probe = probe_limits(token, str(login.get("user_id") or ""))
  if probe["ok"]:
    result["limits"] = probe["limits"]
    result["authHelpText"] = ""
    if probe_cache is not None:
      try:
        write_json(probe_cache, {"fetchedAtMs": round(time.time() * 1000), "limits": probe["limits"]})
      except Exception as exc:
        print(f"omarchy-agent-usage-grok: could not write limits cache ({exc})", file=sys.stderr)
    return result

  if probe.get("transport"):
    result["retryAdvised"] = True
  if fallback:
    result["limits"] = fallback
    result["authHelpText"] = ""
  else:
    result["usageStatusText"] = "Grok limits unavailable"
    result["authHelpText"] = probe["helpText"]
  return result


def main() -> int:
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan sessions and re-probe limits, ignoring caches")
  parser.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the limits probe must be fresh")
  args = parser.parse_args()

  home = grok_home()
  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  stats = cached_scan(home, max_age)
  login = oauth_login(home)
  limits = collect_limits(login, args.force)
  prompts = number(stats.get("totalPrompts"))
  sessions = number(stats.get("totalSessions"))
  has_usage = prompts > 0 or sessions > 0
  has_limits = len(limits["limits"]) > 0

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": has_usage or has_limits,
    "hasLocalStats": True,
    "tierLabel": limits.get("tierLabel") or "",
    "usageStatusText": limits["usageStatusText"],
    "authHelpText": limits["authHelpText"],
    "limits": limits["limits"],
  }
  if limits.get("retryAdvised"):
    record["retryAdvised"] = True
  record.update(stats)
  print(json.dumps(record, separators=(",", ":"), sort_keys=True))
  return 0


if __name__ == "__main__":
  raise SystemExit(main())

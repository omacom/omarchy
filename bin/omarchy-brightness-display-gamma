#!/bin/bash

# omarchy:summary=Manage hyprsunset gamma for the display brightness range below 1%.
# omarchy:args=<get|active|can-dim|set percentage|cleanup>
# omarchy:hidden=true

# Hyprsunset gamma is global: dimming the internal panel also dims other outputs.

state_file="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.hyprsunset"
gamma_state_file="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.gamma"

running_pid() {
  pgrep -n -x hyprsunset 2>/dev/null
}

current_gamma() {
  local gamma
  gamma=$(hyprctl hyprsunset gamma 2>/dev/null) || return 1
  [[ $gamma =~ ^[0-9]+([.][0-9]+)?$ ]] || return 1
  printf '%s\n' "$gamma"
}

owned_pid() {
  local pid
  [[ -r $state_file ]] || return 1
  read -r pid <"$state_file"
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ $(running_pid) == "$pid" ]] || return 1
  printf '%s\n' "$pid"
}

gamma_owned() {
  local pid value
  [[ -r $gamma_state_file ]] || return 1
  read -r pid value <"$gamma_state_file"
  [[ $pid =~ ^[0-9]+$ && $value =~ ^[0-9]+$ && $(running_pid) == "$pid" && $(current_gamma) == "$value" ]]
}

cleanup() {
  local pid gamma temperature config profile_count
  pid=$(owned_pid) || {
    rm -f -- "$state_file"
    return 0
  }
  gamma=$(current_gamma) || return 0
  [[ $gamma == "100" || $gamma == "100.0" ]] || return 0
  temperature=$(hyprctl hyprsunset temperature 2>/dev/null) || return 0
  [[ $temperature =~ ^[0-9]+$ ]] || return 0
  (( temperature >= 6000 )) || return 0

  # A configured schedule still needs this process after brightness recovers.
  config="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprsunset.conf"
  if [[ -r $config ]]; then
    profile_count=$(awk '/^[[:space:]]*profile[[:space:]]*[{=]/ { count++ } END { print count+0 }' "$config")
    (( profile_count <= 1 )) || return 0
  fi

  kill "$pid" 2>/dev/null || return 0
  rm -f -- "$state_file"
}

case ${1:-} in
get)
  if [[ -n $(running_pid) ]]; then
    current_gamma
  else
    printf '100\n'
  fi
  ;;
active)
  gamma_owned
  ;;
can-dim)
  if gamma_owned || [[ -z $(running_pid) ]]; then
    exit 0
  fi
  gamma=$(current_gamma) || exit 1
  [[ $gamma == "100" || $gamma == "100.0" ]]
  ;;
set)
  value=${2:-}
  [[ $value =~ ^[0-9]+$ ]] && (( value >= 25 && value <= 100 )) || exit 1

  if (( value == 100 )); then
    gamma_owned || exit 0
  elif ! gamma_owned && [[ -n $(running_pid) ]]; then
    gamma=$(current_gamma) || exit 1
    [[ $gamma == "100" || $gamma == "100.0" ]] || exit 1
  fi

  if [[ -z $(running_pid) ]]; then
    setsid uwsm-app -- hyprsunset >/dev/null 2>&1 &
    for _ in {1..10}; do
      pid=$(running_pid) && break
      sleep 0.2
    done
    [[ -n ${pid:-} ]] || exit 1
    printf '%s\n' "$pid" >"$state_file"
  fi

  for _ in {1..10}; do
    if hyprctl hyprsunset gamma "$value" >/dev/null 2>&1 && [[ $(current_gamma) == "$value" ]]; then
      if (( value == 100 )); then
        rm -f -- "$gamma_state_file"
        cleanup
      else
        printf '%s %s\n' "$(running_pid)" "$value" >"$gamma_state_file"
      fi
      exit 0
    fi
    sleep 0.2
  done
  exit 1
  ;;
cleanup)
  cleanup
  ;;
*)
  exit 1
  ;;
esac

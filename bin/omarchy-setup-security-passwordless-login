#!/bin/bash

# omarchy:summary=Enable or disable passwordless boot and wake from sleep
# omarchy:args=[1|3|always|--active|--disable]
# omarchy:requires-sudo=true

# Passphrases live in variables; never trace them.
set +x
set -euo pipefail

SCRIPT_SELF=$(readlink -e -- "${BASH_SOURCE[0]}")
SCRIPT_DIR=${SCRIPT_SELF%/*}

# Allow redirecting system paths in non-root unit tests only. When running as
# real root, all paths stay anchored at the real filesystem root.
TEST_ROOT=""
if (( EUID != 0 )) && [[ -n ${OMARCHY_PASSWORDLESS_LOGIN_TEST_ROOT:-} ]]; then
  TEST_ROOT=${OMARCHY_PASSWORDLESS_LOGIN_TEST_ROOT%/}
fi

readonly KEYFILE="${TEST_ROOT}/crypto_keyfile.bin"
readonly MKINITCPIO_DROPIN="${TEST_ROOT}/etc/mkinitcpio.conf.d/99-omarchy-passwordless-login.conf"
readonly GREETD_CONFIG="${TEST_ROOT}/etc/greetd/config.toml"
readonly STATE_DIR="${TEST_ROOT}/var/lib/omarchy"
readonly STATE_FILE="${STATE_DIR}/passwordless-login"
readonly SYSTEMD_DIR="${TEST_ROOT}/etc/systemd/system"
readonly EXPIRE_UNIT_NAME="omarchy-passwordless-login-expire.service"
readonly EXPIRE_UNIT="${SYSTEMD_DIR}/${EXPIRE_UNIT_NAME}"
readonly EXPIRE_WANT="${SYSTEMD_DIR}/multi-user.target.wants/${EXPIRE_UNIT_NAME}"
readonly EXPIRE_GRAPHICAL_WANT="${SYSTEMD_DIR}/graphical.target.wants/${EXPIRE_UNIT_NAME}"
readonly PROVISION_ONCE_UNIT_NAME="omarchy-provision-autologin-once.service"
readonly PROVISION_ONCE_UNIT="${SYSTEMD_DIR}/${PROVISION_ONCE_UNIT_NAME}"
readonly PROVISION_ONCE_WANT="${SYSTEMD_DIR}/graphical.target.wants/${PROVISION_ONCE_UNIT_NAME}"
readonly LOCK_FILE="${TEST_ROOT}/run/lock/omarchy-passwordless-login.lock"
readonly CMDLINE_GROUP="omarchy-passwordless-login"
readonly PROC_CMDLINE="${TEST_ROOT:+${TEST_ROOT}/proc/cmdline}"

usage() {
  echo "Usage: omarchy-setup-security-passwordless-login [1|3|always|--active|--disable]" >&2
  exit 2
}

valid_mode() {
  case "$1" in
    1|3|always) return 0 ;;
    *) return 1 ;;
  esac
}

setup_root_path() {
  if [[ -z $TEST_ROOT ]]; then
    export PATH="$SCRIPT_DIR:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
  else
    export PATH="$PATH:$SCRIPT_DIR"
  fi
}

with_lock() (
  local lock_dir=${LOCK_FILE%/*}
  mkdir -p "$lock_dir"
  exec 9>"$LOCK_FILE"
  flock 9
  "$@"
)

# The LUKS partition beneath /, or nothing when / is not encrypted. Fails when
# it cannot tell, including a crypt layer whose LUKS partition lsblk cannot name.
root_luks_device() {
  local root_source ancestry device
  root_source=$(findmnt -no SOURCE /) && [[ -n $root_source ]] || return 1
  ancestry=$(lsblk -nsrpo NAME,TYPE,FSTYPE "${root_source%%[*}") || return 1
  device=$(awk '$3 == "crypto_LUKS" { print $1; exit }' <<<"$ancestry")
  if [[ -n $device ]]; then
    readlink -f "$device"
  elif awk '$2 == "crypt" { found = 1 } END { exit !found }' <<<"$ancestry"; then
    return 1
  fi
}

detect_initramfs_hook() {
  local cmdline_path=${PROC_CMDLINE:-/proc/cmdline}
  local cmdline=""
  [[ -r $cmdline_path ]] && cmdline=$(<"$cmdline_path")

  if [[ " $cmdline " == *" rd.luks."* ]]; then
    echo "sd-encrypt"
  elif [[ " $cmdline " == *" cryptdevice="* ]]; then
    echo "encrypt"
  elif grep -Eq '\bsd-encrypt\b' "${TEST_ROOT}/etc/mkinitcpio.conf" "${TEST_ROOT}/etc/mkinitcpio.conf.d/"*.conf 2>/dev/null; then
    echo "sd-encrypt"
  else
    echo "encrypt"
  fi
}

# Print the enabled key slots on a LUKS device, one per line.
luks_enabled_slots() {
  local dev=$1 dump
  dump=$(cryptsetup luksDump "$dev") || return 1
  awk '
    /^[^ \t]/ { keyslots = ($0 == "Keyslots:") }
    keyslots && /^ +[0-9]+: luks2/ { sub(":", "", $1); print $1 }
    /^Key Slot [0-9]+: ENABLED/ { sub(":", "", $3); print $3 }
  ' <<<"$dump"
}

# Print the key slot that KEYFILE opens. Returns 2 if it opens none.
keyfile_slot() {
  local dev=$1 keyfile=$2 out status=0
  out=$(LC_ALL=C cryptsetup open --test-passphrase --verbose --token-type passphrase-only --key-file "$keyfile" "$dev" 2>&1) || status=$?
  (( status == 0 )) || return "$status"
  grep -o 'Key slot [0-9]* unlocked' <<<"$out" | grep -o '[0-9]*' | head -1
}

STATE_TYPE=""
STATE_MODE=""
STATE_REMAINING=""
STATE_UUID=""
STATE_SLOT=""
STATE_HOOK=""
STATE_USER=""

read_state() {
  STATE_TYPE=""
  STATE_MODE=""
  STATE_REMAINING=""
  STATE_UUID=""
  STATE_SLOT=""
  STATE_HOOK=""
  STATE_USER=""

  [[ -f $STATE_FILE && ! -L $STATE_FILE ]] || return 1
  if [[ -z $TEST_ROOT ]]; then
    local owner
    owner=$(stat -Lc '%u' -- "$STATE_FILE" 2>/dev/null) || return 1
    [[ $owner == "0" ]] || return 1
  fi

  local key value
  while IFS='=' read -r key value || [[ -n $key ]]; do
    case "$key" in
      TYPE) STATE_TYPE=$value ;;
      MODE) STATE_MODE=$value ;;
      REMAINING) STATE_REMAINING=$value ;;
      DEVICE_UUID) STATE_UUID=$value ;;
      KEY_SLOT) STATE_SLOT=$value ;;
      INITRAMFS_HOOK) STATE_HOOK=$value ;;
      LOGIN_USER) STATE_USER=$value ;;
    esac
  done <"$STATE_FILE"

  if [[ -z $STATE_TYPE ]]; then
    if [[ -n $STATE_UUID || -n $STATE_SLOT || -n $STATE_HOOK ]]; then
      STATE_TYPE="luks"
    elif [[ -n $STATE_USER ]]; then
      STATE_TYPE="autologin"
    fi
  fi

  case "$STATE_TYPE:$STATE_MODE" in
    luks:always) return 0 ;;
    luks:count) [[ $STATE_REMAINING =~ ^[0-9]+$ ]] && return 0 ;;
    autologin:always) [[ -n $STATE_USER ]] && return 0 ;;
    autologin:count) [[ -n $STATE_USER && $STATE_REMAINING =~ ^[0-9]+$ ]] && return 0 ;;
  esac
  return 1
}

write_atomic_file() {
  local dest=$1 mode=$2 content=$3
  local dir=${dest%/*} stage
  mkdir -p "$dir"
  stage=$(mktemp "${dir}/.${dest##*/}.new.XXXXXX")
  printf '%s' "$content" >"$stage"
  chmod "$mode" "$stage"
  [[ -n $TEST_ROOT ]] || chown root:root "$stage"
  mv -Tf -- "$stage" "$dest"
}

write_luks_state() {
  local mode=$1 remaining=$2 uuid=$3 slot=$4 hook=$5
  local body
  body=$(printf 'TYPE=luks\nMODE=%s\nREMAINING=%s\nDEVICE_UUID=%s\nKEY_SLOT=%s\nINITRAMFS_HOOK=%s' \
    "$mode" "$remaining" "$uuid" "$slot" "$hook")
  write_atomic_file "$STATE_FILE" 0644 "${body}"$'\n'
}

write_autologin_state() {
  local mode=$1 remaining=$2 user=$3
  local body
  body=$(printf 'TYPE=autologin\nMODE=%s\nREMAINING=%s\nLOGIN_USER=%s' \
    "$mode" "$remaining" "$user")
  write_atomic_file "$STATE_FILE" 0644 "${body}"$'\n'
}

greetd_autologin_enabled() {
  [[ -f $GREETD_CONFIG && ! -L $GREETD_CONFIG ]] &&
    grep -Eq '^\[initial_session\][[:space:]]*$' "$GREETD_CONFIG"
}

greetd_configured_user() {
  [[ -f $GREETD_CONFIG ]] || return 0
  sed -n 's|^command = "/usr/share/omarchy/default/splash/greeter \([^"]*\)"$|\1|p' "$GREETD_CONFIG" | head -n 1
}

user_exists() {
  local user=$1
  [[ $user =~ ^[a-z_][a-z0-9_-]*[$]?$ ]] || return 1
  if [[ -n $TEST_ROOT ]]; then
    grep -q "^${user}:" "${TEST_ROOT}/etc/passwd" 2>/dev/null
  else
    getent passwd "$user" >/dev/null
  fi
}

first_regular_user() {
  if [[ -n $TEST_ROOT ]]; then
    [[ -r ${TEST_ROOT}/etc/passwd ]] || return 0
    awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { print $1; exit }' "${TEST_ROOT}/etc/passwd"
  else
    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { print $1; exit }'
  fi
}

resolve_login_user() {
  local candidate=""
  if [[ -z $TEST_ROOT ]]; then
    if [[ -n ${SUDO_USER:-} && $SUDO_USER != "root" ]] && user_exists "$SUDO_USER"; then
      printf '%s\n' "$SUDO_USER"
      return 0
    fi
    if (( EUID != 0 )); then
      candidate=$(id -un)
      if [[ $candidate != "root" ]] && user_exists "$candidate"; then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  fi

  candidate=$(greetd_configured_user)
  if [[ -n $candidate ]] && user_exists "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  candidate=$(first_regular_user)
  if [[ -n $candidate ]] && user_exists "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

check_greetd_ready() {
  [[ -z $TEST_ROOT ]] || return 0
  if ! systemctl is-enabled --quiet greetd.service 2>/dev/null; then
    if systemctl is-enabled --quiet sddm.service 2>/dev/null; then
      echo "Passwordless login on unencrypted drives requires greetd. Run omarchy-migrate first." >&2
    else
      echo "Could not verify an enabled greetd display manager service." >&2
    fi
    return 1
  fi
}

run_system_login() {
  if [[ -n $TEST_ROOT ]]; then
    omarchy-system-login --root "$TEST_ROOT" "$@"
  else
    omarchy-system-login "$@"
  fi
}

is_active() {
  read_state || return 1
  if [[ $STATE_MODE == "count" ]] && (( 10#$STATE_REMAINING == 0 )); then
    return 1
  fi
  case "$STATE_TYPE" in
    luks) [[ -f $MKINITCPIO_DROPIN ]] ;;
    autologin) greetd_autologin_enabled ;;
    *) return 1 ;;
  esac
}

install_mkinitcpio_dropin() {
  local body
  body=$(cat <<'EOF'
# Managed by omarchy-setup-security-passwordless-login.
if [[ -f /crypto_keyfile.bin && ! -L /crypto_keyfile.bin ]]; then
  FILES+=(/crypto_keyfile.bin)
fi
EOF
)
  write_atomic_file "$MKINITCPIO_DROPIN" 0644 "${body}"$'\n'
}

install_expire_service() {
  local target_type=${1:-luks}
  local unit_extra="" wants_target="multi-user.target" want_link=$EXPIRE_WANT drop_link=$EXPIRE_GRAPHICAL_WANT
  if [[ $target_type == "autologin" ]]; then
    # Run Before=display-manager.service so greetd never races config.toml edits.
    unit_extra=$'Before=display-manager.service\n'
    wants_target="graphical.target"
    want_link=$EXPIRE_GRAPHICAL_WANT
    drop_link=$EXPIRE_WANT
  fi

  local service_section
  service_section=$(cat <<'EOF'
[Service]
Type=oneshot
ExecStart=/usr/bin/bash -c 'omarchy_path=/usr/share/omarchy; if [[ -f /etc/omarchy.conf && ! -L /etc/omarchy.conf && $(stat -c %%u /etc/omarchy.conf) == 0 ]]; then source /etc/omarchy.conf; fi; if [[ -x "${OMARCHY_PATH:-}/bin/omarchy-setup-security-passwordless-login" ]]; then exec "$OMARCHY_PATH/bin/omarchy-setup-security-passwordless-login" __boot-tick; elif [[ -x "$omarchy_path/bin/omarchy-setup-security-passwordless-login" ]]; then exec "$omarchy_path/bin/omarchy-setup-security-passwordless-login" __boot-tick; else exec /usr/bin/omarchy-setup-security-passwordless-login __boot-tick; fi'
EOF
)

  local body
  body=$(printf '[Unit]\nDescription=Decrement or revoke Omarchy passwordless login boot grant\nAfter=local-fs.target\n%sConditionPathExists=/var/lib/omarchy/passwordless-login\n\n%s\n\n[Install]\nWantedBy=%s\n' \
    "$unit_extra" "$service_section" "$wants_target")
  mkdir -p "${want_link%/*}" || return 1
  write_atomic_file "$EXPIRE_UNIT" 0644 "$body" || return 1
  rm -f -- "$drop_link" || return 1
  ln -sf "../${EXPIRE_UNIT_NAME}" "$want_link" || return 1
  [[ -f $EXPIRE_UNIT && ! -L $EXPIRE_UNIT && -L $want_link ]] || return 1
  if [[ -z $TEST_ROOT ]]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
}

remove_expire_service() {
  rm -f -- "$EXPIRE_WANT" "$EXPIRE_GRAPHICAL_WANT" "$EXPIRE_UNIT"
  if [[ -z $TEST_ROOT ]]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
}

remove_provision_autologin_once() {
  if [[ -e $PROVISION_ONCE_WANT || -L $PROVISION_ONCE_WANT || -e $PROVISION_ONCE_UNIT || -L $PROVISION_ONCE_UNIT ]]; then
    rm -f -- "$PROVISION_ONCE_WANT" "$PROVISION_ONCE_UNIT"
    if [[ -z $TEST_ROOT ]]; then
      systemctl daemon-reload >/dev/null 2>&1 || true
    fi
  fi
}

create_keyfile() {
  local dir=${KEYFILE%/*} stage
  [[ -n $dir ]] || dir="/"
  stage=$(mktemp "${dir}/.crypto_keyfile.bin.new.XXXXXX")
  chmod 0600 "$stage"
  dd if=/dev/urandom of="$stage" bs=64 count=1 status=none
  if [[ -z $TEST_ROOT ]]; then
    chown root:root "$stage"
    chmod 0000 "$stage"
  fi
  mv -Tf -- "$stage" "$KEYFILE"
}

revoke_keyfile_slot() {
  local dev=$1
  [[ -f $KEYFILE && ! -L $KEYFILE ]] || return 0
  [[ -n $dev ]] || return 0

  local slot status=0
  slot=$(keyfile_slot "$dev" "$KEYFILE") || status=$?
  if (( status == 2 )); then
    # Keyfile does not open any slot (already revoked manually).
    return 0
  elif (( status != 0 )); then
    echo "Could not verify the passwordless login key slot on $dev." >&2
    return 1
  fi

  local -a slots=()
  mapfile -t slots < <(luks_enabled_slots "$dev")
  if (( ${#slots[@]} < 2 )); then
    echo "Refusing to remove the only remaining LUKS key slot on $dev." >&2
    return 1
  fi

  cryptsetup luksRemoveKey -q "$dev" "$KEYFILE"
}

slot_is_enabled() {
  local dev=$1 target=$2 slots s
  [[ -n $dev ]] || return 2
  slots=$(luks_enabled_slots "$dev") || return 2
  while IFS= read -r s; do
    [[ $s == "$target" ]] && return 0
  done <<<"$slots"
  return 1
}

disable_locked() {
  setup_root_path
  local dev="" had_state=0 has_luks_artifacts=0 is_luks=0

  if read_state; then
    had_state=1
  fi

  if [[ -e $MKINITCPIO_DROPIN || -L $MKINITCPIO_DROPIN ]]; then
    has_luks_artifacts=1
  fi

  if (( had_state == 0 && has_luks_artifacts == 0 )) &&
    [[ ! -e $EXPIRE_UNIT && ! -L $EXPIRE_UNIT && ! -e $STATE_FILE && ! -L $STATE_FILE ]]; then
    return 0
  fi

  if [[ $STATE_TYPE == "luks" ]] || (( has_luks_artifacts )); then
    is_luks=1
  elif (( had_state == 0 )) && [[ -n $(root_luks_device 2>/dev/null || true) ]]; then
    is_luks=1
  fi

  if (( is_luks == 0 )); then
    run_system_login --no-autologin || return 1
    rm -f -- "$STATE_FILE"
    remove_expire_service
    return 0
  fi

  dev=$(root_luks_device 2>/dev/null || true)
  if [[ -z $dev && -n $STATE_UUID && -e "${TEST_ROOT}/dev/disk/by-uuid/${STATE_UUID}" ]]; then
    dev=$(readlink -f "${TEST_ROOT}/dev/disk/by-uuid/${STATE_UUID}")
  fi

  # Revoke the LUKS key slot first so even an interrupted boot-image rebuild
  # cannot leave the embedded initramfs key accepted by the disk. Never clear
  # state if the enrolled slot cannot be confirmed revoked (e.g. if the
  # keyfile was deleted or replaced while copies remain in boot images).
  if [[ -f $KEYFILE && ! -L $KEYFILE ]]; then
    revoke_keyfile_slot "$dev" || return 1
    if [[ -n $STATE_SLOT ]]; then
      local slot_status=0
      slot_is_enabled "$dev" "$STATE_SLOT" || slot_status=$?
      if (( slot_status != 1 )); then
        echo "LUKS key slot $STATE_SLOT on ${dev:-root device} is still enabled (or could not be verified) because $KEYFILE did not match it." >&2
        echo "Revoke it manually with: sudo cryptsetup luksKillSlot ${dev:-<luks-device>} $STATE_SLOT" >&2
        echo "Then run: omarchy-setup-security-passwordless-login --disable" >&2
        return 1
      fi
    fi
    rm -f -- "$KEYFILE"
  elif [[ -n $STATE_SLOT ]]; then
    local slot_status=0
    slot_is_enabled "$dev" "$STATE_SLOT" || slot_status=$?
    if (( slot_status != 1 )); then
      echo "Cannot revoke LUKS key slot $STATE_SLOT on ${dev:-root device} because $KEYFILE is missing; copies in boot images or elsewhere could still unlock the disk." >&2
      echo "Revoke it manually with: sudo cryptsetup luksKillSlot ${dev:-<luks-device>} $STATE_SLOT" >&2
      echo "Then run: omarchy-setup-security-passwordless-login --disable" >&2
      return 1
    fi
  fi

  rm -f -- "$MKINITCPIO_DROPIN" "$STATE_FILE"
  remove_expire_service

  omarchy-boot-cmdline unset "$CMDLINE_GROUP" || return 1
  omarchy-boot-rebuild || return 1
}

enable_luks_locked() (
  local dev=$1 mode=$2 remaining=$3 uuid hook

  uuid=$(lsblk -dno UUID "$dev") && [[ -n $uuid ]] || {
    echo "Could not read the UUID of $dev." >&2
    return 1
  }
  hook=$(detect_initramfs_hook)

  # If already active with a valid enrolled keyfile, updating the boot count or
  # switching between timed and Always only requires updating state and unit.
  if read_state && [[ $STATE_TYPE == "luks" && -f $KEYFILE && ! -L $KEYFILE && -f $MKINITCPIO_DROPIN ]]; then
    local existing_slot=""
    if existing_slot=$(keyfile_slot "$dev" "$KEYFILE"); then
      if [[ $mode == "count" ]]; then
        install_expire_service luks || return 1
        if ! write_luks_state "$mode" "$remaining" "$uuid" "$existing_slot" "$hook"; then
          if [[ $STATE_MODE == "always" ]]; then
            remove_expire_service
          fi
          return 1
        fi
      else
        write_luks_state "$mode" "$remaining" "$uuid" "$existing_slot" "$hook" || return 1
        remove_expire_service
      fi
      return 0
    fi
  fi

  if [[ -L $KEYFILE || ( -e $KEYFILE && ! -f $KEYFILE ) ]]; then
    echo "Refusing to use $KEYFILE because it is not a regular file." >&2
    return 1
  fi
  if [[ -e $KEYFILE ]] && ! read_state; then
    echo "$KEYFILE already exists and is not managed by Omarchy. Remove it first if you want Omarchy to manage passwordless login." >&2
    return 1
  fi

  local -a existing_slots=()
  mapfile -t existing_slots < <(luks_enabled_slots "$dev")
  if (( ${#existing_slots[@]} < 1 )); then
    echo "Could not read enabled LUKS key slots on $dev." >&2
    return 1
  fi

  local passphrase=""
  if [[ ! -t 0 ]]; then
    IFS= read -r -d '' passphrase || true
  fi

  local key_added=0 dropin_written=0 cmdline_written=0 state_written=0 unit_written=0 keyfile_created=0
  rollback_luks() {
    local rc=$?
    trap - EXIT HUP INT TERM
    if (( rc != 0 )); then
      echo "Rolling back passwordless login changes..." >&2
      if (( key_added )); then
        revoke_keyfile_slot "$dev" >/dev/null 2>&1 || true
      fi
      if (( keyfile_created )); then
        rm -f -- "$KEYFILE"
      fi
      if (( dropin_written )); then
        rm -f -- "$MKINITCPIO_DROPIN"
      fi
      if (( cmdline_written )); then
        omarchy-boot-cmdline unset "$CMDLINE_GROUP" >/dev/null 2>&1 || true
      fi
      if (( unit_written )); then
        remove_expire_service
      fi
      if (( state_written )); then
        rm -f -- "$STATE_FILE"
      fi
    fi
    exit "$rc"
  }
  trap rollback_luks EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  create_keyfile || return 1
  keyfile_created=1

  if [[ -n $passphrase ]]; then
    printf '%s' "$passphrase" | cryptsetup luksAddKey --iter-time 10 --key-file - "$dev" "$KEYFILE" || return 1
  else
    echo "Enter your current disk encryption password to enroll the boot unlock key..."
    cryptsetup luksAddKey --iter-time 10 "$dev" "$KEYFILE" || return 1
  fi
  key_added=1

  local slot
  slot=$(keyfile_slot "$dev" "$KEYFILE") || {
    echo "The enrolled boot key could not unlock $dev." >&2
    return 1
  }

  install_mkinitcpio_dropin || return 1
  dropin_written=1

  if [[ $hook == "sd-encrypt" ]]; then
    omarchy-boot-cmdline set "$CMDLINE_GROUP" "rd.luks.key=${uuid}=/crypto_keyfile.bin" || return 1
    cmdline_written=1
  fi

  write_luks_state "$mode" "$remaining" "$uuid" "$slot" "$hook" || return 1
  state_written=1

  if [[ $mode == "count" ]]; then
    install_expire_service luks || return 1
    unit_written=1
  else
    remove_expire_service
  fi

  echo "Rebuilding boot images..."
  omarchy-boot-rebuild || return 1

  trap - EXIT HUP INT TERM
)

enable_autologin_locked() (
  local mode=$1 remaining=$2 login_user=""

  check_greetd_ready || return 1

  login_user=$(resolve_login_user) || {
    echo "Could not determine which user account to enable passwordless login for." >&2
    return 1
  }

  # If already active for the same user, updating the duration only needs to
  # update state and the expiry unit.
  if is_active && [[ $STATE_TYPE == "autologin" && $STATE_USER == $login_user ]]; then
    if [[ $mode == "count" ]]; then
      install_expire_service autologin || return 1
      if ! write_autologin_state "$mode" "$remaining" "$login_user"; then
        if [[ $STATE_MODE == "always" ]]; then
          remove_expire_service
        fi
        return 1
      fi
    else
      write_autologin_state "$mode" "$remaining" "$login_user" || return 1
      remove_expire_service
    fi
    remove_provision_autologin_once
    return 0
  fi

  local had_autologin=0
  if greetd_autologin_enabled; then
    if ! { read_state && [[ $STATE_TYPE == "autologin" && $STATE_MODE == "count" ]] && (( 10#$STATE_REMAINING == 0 )); }; then
      had_autologin=1
    fi
  fi

  local autologin_written=0 state_written=0 unit_written=0
  rollback_autologin() {
    local rc=$?
    trap - EXIT HUP INT TERM
    if (( rc != 0 )); then
      echo "Rolling back passwordless login changes..." >&2
      if (( unit_written )); then
        remove_expire_service
      fi
      if (( state_written )); then
        rm -f -- "$STATE_FILE"
      fi
      if (( autologin_written && had_autologin == 0 )); then
        run_system_login --no-autologin >/dev/null 2>&1 || true
      fi
    fi
    exit "$rc"
  }
  trap rollback_autologin EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  run_system_login "$login_user" --autologin || return 1
  autologin_written=1

  write_autologin_state "$mode" "$remaining" "$login_user" || return 1
  state_written=1

  if [[ $mode == "count" ]]; then
    install_expire_service autologin || return 1
    unit_written=1
  else
    remove_expire_service
  fi

  remove_provision_autologin_once

  trap - EXIT HUP INT TERM
)

enable_locked() (
  local target=$1
  setup_root_path

  local mode remaining
  if [[ $target == "always" ]]; then
    mode="always"
    remaining="0"
  else
    mode="count"
    remaining=$target
  fi

  local dev
  dev=$(root_luks_device) || {
    echo "Could not determine the root LUKS device." >&2
    return 1
  }

  if [[ -n $dev ]]; then
    enable_luks_locked "$dev" "$mode" "$remaining"
  else
    enable_autologin_locked "$mode" "$remaining"
  fi
)

boot_tick_locked() {
  setup_root_path
  read_state || {
    remove_expire_service
    return 0
  }

  if [[ $STATE_MODE == "always" ]]; then
    remove_expire_service
    return 0
  fi

  local current=$((10#$STATE_REMAINING))
  if [[ $STATE_TYPE == "autologin" ]]; then
    # For autologin, the expire service runs Before=display-manager.service.
    # On the final allowed boot (1 -> 0), keep autologin for THIS boot and
    # leave REMAINING=0 so the next boot revokes it before greetd starts.
    if (( current > 0 )); then
      write_autologin_state "count" "$((current - 1))" "$STATE_USER"
      return 0
    fi
    disable_locked
    return
  fi

  local next=$((current - 1))
  if (( next > 0 )); then
    write_luks_state "count" "$next" "$STATE_UUID" "$STATE_SLOT" "$STATE_HOOK"
    return 0
  fi

  # The final allowed boot has started: revoke immediately so the next boot
  # requires the disk encryption password again.
  disable_locked
}

format_status() {
  if [[ $STATE_MODE == "always" ]]; then
    echo "Always"
  elif (( 10#$STATE_REMAINING == 1 )); then
    echo "Next boot"
  else
    echo "Next ${STATE_REMAINING} boots"
  fi
}

show_enabled_summary() {
  case "$1" in
    1) echo "Passwordless login has been ENABLED for the next boot. Your password will be required again after that." ;;
    3) echo "Passwordless login has been ENABLED for the next 3 boots. Your password will be required again after that." ;;
    always) echo "Passwordless login has been ENABLED permanently. Run Setup > Security > Passwordless Login again to disable it." ;;
  esac
}

run_privileged() {
  sudo "$SCRIPT_SELF" "$@"
}

ensure_sudo() {
  if [[ -z $TEST_ROOT ]]; then
    sudo -v
  fi
}

refresh_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
}

disable_spin_title() {
  if [[ $STATE_TYPE == "luks" || -e $MKINITCPIO_DROPIN || -L $MKINITCPIO_DROPIN ]] ||
    { [[ -z $STATE_TYPE ]] && [[ -n $(root_luks_device 2>/dev/null || true) ]]; }; then
    echo "Disabling passwordless login and rebuilding boot images (this can take a moment)..."
  else
    echo "Disabling passwordless login..."
  fi
}

disable_interactive() {
  echo "Disabling passwordless login..."
  echo ""
  ensure_sudo
  local status=0
  run_with_spinner "$(disable_spin_title)" run_privileged __disable || status=$?
  refresh_indicator
  (( status == 0 )) || exit "$status"
  echo ""
  echo "Passwordless login has been DISABLED. Your password will be required on boot and wake from sleep."
}

run_with_spinner() {
  local title=$1
  shift
  local log status=0 pid
  log=$(mktemp)
  "$@" >"$log" 2>&1 &
  pid=$!
  if [[ -t 1 ]]; then
    gum spin --spinner dot --title "$title" -- bash -c 'while kill -0 "$1" 2>/dev/null; do sleep 0.1; done' _ "$pid" </dev/null || true
  else
    echo "$title"
  fi
  wait "$pid" || status=$?
  if (( status != 0 )) && [[ -s $log ]]; then
    cat "$log" >&2
  fi
  rm -f "$log"
  return "$status"
}

# Internal privileged entrypoints (invoked via sudo or systemd boot unit).
case "${1:-}" in
  __enable)
    (($# == 2)) && valid_mode "$2" || usage
    if [[ -z $TEST_ROOT ]] && (( EUID != 0 )); then
      echo "omarchy-setup-security-passwordless-login: __enable requires root." >&2
      exit 1
    fi
    with_lock enable_locked "$2"
    exit
    ;;
  __disable)
    (($# == 1)) || usage
    if [[ -z $TEST_ROOT ]] && (( EUID != 0 )); then
      echo "omarchy-setup-security-passwordless-login: __disable requires root." >&2
      exit 1
    fi
    with_lock disable_locked
    exit
    ;;
  __boot-tick)
    (($# == 1)) || usage
    if [[ -z $TEST_ROOT ]] && (( EUID != 0 )); then
      echo "omarchy-setup-security-passwordless-login: __boot-tick requires root." >&2
      exit 1
    fi
    with_lock boot_tick_locked
    exit
    ;;
esac

if [[ ${1:-} == "--active" ]]; then
  (($# == 1)) || usage
  is_active
  exit
fi

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: omarchy-setup-security-passwordless-login [1|3|always|--active|--disable]"
  echo ""
  echo "Enables or disables automatic login at boot and passwordless wake from sleep."
  echo "Options: 1 (Next boot), 3 (Next 3 boots), always (Always), --active, --disable."
  exit 0
fi

(($# <= 1)) || usage
arg=${1:-}
if (($# == 1)) && [[ $arg != "--disable" ]] && ! valid_mode "$arg"; then
  usage
fi

# Check current state before taking action.
active=0
if is_active; then
  active=1
fi

if [[ $arg == "--disable" ]]; then
  if (( active == 0 )) && [[ ! -e $MKINITCPIO_DROPIN && ! -e $EXPIRE_UNIT && ! -e $STATE_FILE && ! -L $STATE_FILE ]]; then
    refresh_indicator
    echo "Passwordless login is already DISABLED."
    exit 0
  fi
  disable_interactive
  exit 0
fi

if (( active == 1 )) && [[ -z $arg ]]; then
  echo "Passwordless login is currently ENABLED ($(format_status))."
  disable_interactive
  exit 0
fi

# Enabling (or changing duration while already enabled): detect LUKS vs unencrypted root.
root_dev=$(root_luks_device) || {
  echo "Could not determine the root drive encryption state." >&2
  exit 1
}
if [[ -z $root_dev ]]; then
  check_greetd_ready || exit 1
  resolve_login_user >/dev/null || {
    echo "Could not determine which user account to enable passwordless login for." >&2
    exit 1
  }
fi

mode=$arg
if [[ -z $mode ]]; then
  choice=$(gum choose --header "How long should passwordless login stay enabled?" "Next boot" "Next 3 boots" "Always") || exit 130
  case "$choice" in
    "Next boot") mode=1 ;;
    "Next 3 boots") mode=3 ;;
    "Always") mode=always ;;
    *) exit 130 ;;
  esac
fi

case "$mode" in
  1) duration="for the next boot" ;;
  3) duration="for the next 3 boots" ;;
  always) duration="always" ;;
esac

echo ""
if [[ -n $root_dev ]]; then
  echo "⚠️  WARNING: This places an unencrypted LUKS unlock key inside your boot"
  echo "image so this machine boots straight to your desktop without asking for"
  echo "your disk encryption password ($duration), and skips locking the screen"
  echo "on sleep so waking from sleep is also passwordless."
  echo ""
  echo "Anyone with physical access to this machine (or its boot partition) can"
  echo "boot into your system and read your disk while this is enabled."
  confirm_prompt="Enable passwordless login ($duration)? This weakens disk encryption!"
else
  echo "⚠️  WARNING: This enables automatic login so this machine boots straight to"
  echo "your desktop without asking for your login password ($duration), and skips"
  echo "locking the screen on sleep so waking from sleep is also passwordless."
  echo ""
  echo "Anyone with physical access to this machine can boot or wake into your"
  echo "account without a password while this is enabled."
  confirm_prompt="Enable passwordless login ($duration)? Anyone with physical access can sign in without a password!"
fi
echo ""
case "$mode" in
  1)
    echo "Passwordless login will automatically revoke itself on the next boot,"
    echo "so the boot after that will require your password again."
    ;;
  3)
    echo "Passwordless login will automatically revoke itself after 3 boots,"
    echo "so the 4th boot will require your password again."
    ;;
  always)
    echo "Passwordless login will remain enabled across all reboots until you disable it."
    ;;
esac
echo "Run Setup > Security > Passwordless Login again to disable it at any time."
echo ""

if gum confirm "$confirm_prompt"; then
  ensure_sudo
  passphrase=""
  if [[ -n $root_dev ]] && (( active == 0 )); then
    passphrase=$(gum input --password --header "Enter your disk encryption password") || exit 130
    if [[ -z $passphrase ]]; then
      echo "Password cannot be empty." >&2
      exit 1
    fi
    spin_title="Enabling passwordless login and rebuilding boot images (this can take a moment)..."
  elif (( active == 0 )); then
    spin_title="Enabling passwordless login..."
  else
    spin_title="Updating passwordless login..."
  fi
  run_enable_with_passphrase() {
    if [[ -n $passphrase ]]; then
      printf '%s' "$passphrase" | run_privileged __enable "$mode"
    else
      run_privileged __enable "$mode" </dev/null
    fi
  }
  status=0
  run_with_spinner "$spin_title" run_enable_with_passphrase || status=$?
  refresh_indicator
  (( status == 0 )) || exit "$status"
  echo ""
  show_enabled_summary "$mode"
else
  echo "Aborted. No changes made."
fi

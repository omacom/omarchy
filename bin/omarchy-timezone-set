#!/bin/bash

# omarchy:summary=Set the system timezone and remember it for the current Wi-Fi network
# omarchy:args=[--detected <wifi|ip|network> | --undo] <zone>
# omarchy:hidden=true

# The one place the clock is moved from, by hand (the timezone menu), by the
# automatic-timezone watcher (--detected), or by the Undo button on the
# watcher's notification (--undo). Each remembers the zone for the access
# point Wi-Fi is on, so the watcher knows that network's zone from then on
# and never argues with a choice made there.
#
# Goes through the passwordless `timedatectl set-timezone` rule
# (etc/sudoers.d/omarchy-tzupdate) with sudo -n: none of the callers has a
# terminal to type a password into, so a missing rule fails instead of
# waiting on a prompt nobody can see.

set -uo pipefail

readonly STATE_DIR="$HOME/.local/state/omarchy/timezone"

# nf-cod-globe (the timezone menu's glyph), escaped so this file reads without a Nerd Font.
readonly GLOBE_GLYPH=$'\ueb01'

usage() {
  echo "Usage: omarchy-timezone-set [--detected <wifi|ip|network> | --undo] <zone>" >&2
  exit 1
}

detected=
undo=0
case ${1:-} in
  --detected)
    detected=${2:-}
    [[ $detected == "wifi" || $detected == "ip" || $detected == "network" ]] || usage
    shift 2
    ;;
  --undo)
    undo=1
    shift
    ;;
esac

zone=${1:-}
(($# == 1)) || usage
if [[ ! $zone =~ ^[A-Za-z0-9_+][A-Za-z0-9_+.-]*(/[A-Za-z0-9_+][A-Za-z0-9_+.-]*)*$ || ! -f /usr/share/zoneinfo/$zone ]]; then
  echo "Unknown timezone: $zone" >&2
  exit 1
fi

previous=$(timedatectl show --property=Timezone --value 2>/dev/null)

if [[ $zone != "$previous" ]]; then
  if ! sudo -n timedatectl set-timezone "$zone"; then
    omarchy-notification-send -g "$GLOBE_GLYPH" "$(omarchy-i18n timezone.changeFailed "$zone")"
    exit 1
  fi
  omarchy-shell -q omarchy.clock refresh >/dev/null 2>&1 || true
fi

mkdir -p "$STATE_DIR/networks"
rm -f "$STATE_DIR/candidate"

if network=$(omarchy-timezone-detect --network); then
  printf '%s\n' "$zone" >"$STATE_DIR/networks/$network"
fi

if ((undo)); then
  # Off any remembered network (Ethernet, a hotspot) there is nowhere to pin
  # the choice, so remember the zone that was turned down instead: the
  # watcher leaves it alone until it detects somewhere else.
  printf '%s\n' "$previous" >"$STATE_DIR/declined"
else
  rm -f "$STATE_DIR/declined"
fi

if [[ -n $detected && $zone != "$previous" ]]; then
  case $detected in
    wifi) reason=$(omarchy-i18n timezone.detectedFromWifi) ;;
    ip) reason=$(omarchy-i18n timezone.detectedFromIp) ;;
    network) reason=$(omarchy-i18n timezone.detectedFromNetwork) ;;
  esac

  # The previous zone is the only argument and rides after --with, so it is
  # never reparsed as one of the button's own words.
  omarchy-notification-send -g "$GLOBE_GLYPH" \
    "$(omarchy-i18n timezone.detected "$zone")" \
    "$reason" \
    --action "$(omarchy-i18n timezone.undo)" omarchy-timezone-set --undo \
    --with "$previous"
elif [[ -z $detected ]]; then
  omarchy-notification-send -g "$GLOBE_GLYPH" "$(omarchy-i18n timezone.changed "$zone")"
fi

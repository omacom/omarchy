#!/usr/bin/python3
# omarchy:summary=Record and read shared usage frecency
# omarchy:args=(record <kind> <target> [title] [--via pick|view] [--query <query>] | top [--kind <kind>] [--via pick|view|all] [--limit <n>] | search [<query>] [--kind <kind>] [--limit <n>] [--stream] [--query-id <id>] [--worker] | rank [--kind <kind>] [--via pick|view|all] [--limit <n>] | rank-files [--via pick|view|all] [--limit <n>] | forget <target> [--kind <kind>] | pin <target> [--kind <kind>] | unpin <target> [--kind <kind>] | stats | import-frecency <file> | import-xbel [file] | import-zoxide [file] | import-agents)
# omarchy:examples=omarchy activity record app firefox | omarchy activity top --kind app | omarchy activity rank --kind project
"""Shared usage journal for the shell.

Every consumer (menu, file app, launchers) records what the user picked
here, and ranks with what it reads back. One SQLite database under
~/.local/share/omarchy, scored Firefox-style: each target keeps its most
recent visits, so ranking weighs frequency and recency together.

Writes are single short transactions (WAL + busy timeout, three attempts on
a locked database) because recorders fire and forget; reads hydrate the
caller's common-item cache once, while large scoped collections use the
read-only FTS search path without rerunning schema setup per keystroke.
"""

import argparse
import hashlib
import json
import os
import queue
import re
import sqlite3
import sys
import threading
import time
from pathlib import Path
from urllib.parse import quote

DB_RELATIVE = Path(".local/share/omarchy/activity.db")
MAX_VISITS_PER_TARGET = 10
DEFAULT_TOP_LIMIT = 1000
# Single-visit targets older than this are dropped on record: one accidental
# pick years ago is noise, while anything revisited even once is history.
PRUNE_AFTER_DAYS = 90
MS_PER_DAY = 86400 * 1000

# Firefox frecency buckets: recency weight per visit by age, newest first.
# Score is the weight sum plus the item bonus (picks over passive views),
# so ranking weighs frequency and recency together with no decay job.
BUCKET_WEIGHTS = ((4, 100), (14, 70), (31, 50), (90, 30))
BUCKET_DEFAULT_WEIGHT = 10
# Passive sightings count toward the blended score at this fraction of an
# explicit pick: history accumulates from views, decisions come from picks.
VIEW_WEIGHT = 0.25
SEARCH_PROTOCOL_VERSION = 1
SEARCH_BATCH_SIZE = 8
MAX_QUERY_CHOICES_PER_TARGET = 50

SCHEMA = """
CREATE TABLE IF NOT EXISTS items(
  kind TEXT NOT NULL DEFAULT 'app',
  target TEXT NOT NULL,
  title TEXT NOT NULL DEFAULT '',
  bonus INTEGER NOT NULL DEFAULT 0,
  icon TEXT NOT NULL DEFAULT '',
  icon_font TEXT NOT NULL DEFAULT '',
  detail TEXT NOT NULL DEFAULT '',
  action TEXT NOT NULL DEFAULT '',
  PRIMARY KEY (kind, target)
);
CREATE INDEX IF NOT EXISTS idx_items_target ON items(target);
CREATE TABLE IF NOT EXISTS visits(
  kind TEXT NOT NULL DEFAULT 'app',
  target TEXT NOT NULL,
  at INTEGER NOT NULL,
  via TEXT NOT NULL DEFAULT 'pick'
);
CREATE INDEX IF NOT EXISTS idx_visits_lookup ON visits(kind, target, at DESC);
CREATE INDEX IF NOT EXISTS idx_visits_at ON visits(at);
CREATE TABLE IF NOT EXISTS query_choices(
  kind TEXT NOT NULL,
  query_hash TEXT NOT NULL,
  target TEXT NOT NULL,
  count INTEGER NOT NULL DEFAULT 1,
  last_used INTEGER NOT NULL,
  PRIMARY KEY (kind, query_hash, target)
);
CREATE INDEX IF NOT EXISTS idx_query_choices_target ON query_choices(kind, target, last_used DESC);

CREATE VIRTUAL TABLE IF NOT EXISTS items_fts USING fts5(
  kind UNINDEXED,
  target,
  title,
  detail,
  content='items',
  content_rowid='rowid',
  tokenize='porter unicode61'
);

CREATE TRIGGER IF NOT EXISTS items_ai AFTER INSERT ON items BEGIN
  INSERT INTO items_fts(rowid, kind, target, title, detail) VALUES (new.rowid, new.kind, new.target, new.title, new.detail);
END;

CREATE TRIGGER IF NOT EXISTS items_ad AFTER DELETE ON items BEGIN
  INSERT INTO items_fts(items_fts, rowid, kind, target, title, detail) VALUES('delete', old.rowid, old.kind, old.target, old.title, old.detail);
END;

CREATE TRIGGER IF NOT EXISTS items_au AFTER UPDATE ON items BEGIN
  INSERT INTO items_fts(items_fts, rowid, kind, target, title, detail) VALUES('delete', old.rowid, old.kind, old.target, old.title, old.detail);
  INSERT INTO items_fts(rowid, kind, target, title, detail) VALUES (new.rowid, new.kind, new.target, new.title, new.detail);
END;
"""


def db_path() -> Path:
    return Path(os.environ.get("HOME", str(Path.home()))) / DB_RELATIVE


def connect(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(path), timeout=5)
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    conn.execute("PRAGMA busy_timeout=2000")
    conn.execute("PRAGMA temp_store=MEMORY")
    conn.execute("PRAGMA mmap_size=33554432")

    # Clean up redundant or legacy indexes
    conn.execute("DROP INDEX IF EXISTS idx_items_kind_target")
    conn.execute("DROP INDEX IF EXISTS idx_visits_target_at")

    # Migrate legacy single-target schemas to composite (kind, target)
    items_exists = conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='items'").fetchone()
    if items_exists:
        items_pks = [row[1] for row in conn.execute("PRAGMA table_info(items)").fetchall() if row[5] > 0]
        visits_cols = [row[1] for row in conn.execute("PRAGMA table_info(visits)").fetchall()]
        if "via" not in visits_cols:
            conn.execute("ALTER TABLE visits ADD COLUMN via TEXT NOT NULL DEFAULT 'pick'")
        if "kind" not in visits_cols:
            conn.execute("ALTER TABLE visits ADD COLUMN kind TEXT NOT NULL DEFAULT 'app'")
            conn.execute("UPDATE visits SET kind = COALESCE((SELECT kind FROM items WHERE items.target = visits.target), 'app')")
        if items_pks == ["target"]:
            conn.execute("CREATE TABLE items_v2(kind TEXT NOT NULL DEFAULT 'app', target TEXT NOT NULL, title TEXT NOT NULL DEFAULT '', bonus INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (kind, target))")
            conn.execute("INSERT OR IGNORE INTO items_v2(kind, target, title, bonus) SELECT kind, target, title, bonus FROM items")
            conn.execute("DROP TABLE items")
            conn.execute("ALTER TABLE items_v2 RENAME TO items")

        items_cols = [row[1] for row in conn.execute("PRAGMA table_info(items)").fetchall()]
        for col in ("icon", "icon_font", "detail", "action"):
            if col not in items_cols:
                conn.execute(f"ALTER TABLE items ADD COLUMN {col} TEXT NOT NULL DEFAULT ''")

    fts_exists = conn.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='items_fts'").fetchone()
    conn.executescript(SCHEMA)
    if not fts_exists and items_exists:
        try:
            conn.execute("INSERT INTO items_fts(items_fts) VALUES('rebuild')")
        except sqlite3.Error:
            pass

    return conn


def connect_search(path: Path) -> sqlite3.Connection | None:
    """Open the activity database without running migrations on the search hot path."""
    if not path.exists():
        return None
    uri = f"file:{quote(str(path))}?mode=ro"
    # interrupt() is intentionally called by the worker's stdin thread when a
    # newer request supersedes active SQL.
    conn = sqlite3.connect(uri, uri=True, timeout=0.25, check_same_thread=False)
    conn.execute("PRAGMA query_only=ON")
    conn.execute("PRAGMA busy_timeout=250")
    conn.execute("PRAGMA temp_store=MEMORY")
    conn.execute("PRAGMA mmap_size=33554432")
    return conn


def bucket_weight_case(now_ms: int, at_column: str = "at") -> str:
    """SQL CASE returning a visit's bucket weight for its age in ms."""
    arms = " ".join(
        f"WHEN ({now_ms} - {at_column}) <= {days * MS_PER_DAY} THEN {weight}"
        for days, weight in BUCKET_WEIGHTS
    )
    return f"CASE {arms} ELSE {BUCKET_DEFAULT_WEIGHT} END"


def query_fingerprint(query: str) -> str:
    normalized = " ".join(re.findall(r"\w+", query.casefold()))
    return hashlib.sha256(normalized.encode()).hexdigest() if normalized else ""


def prune_stale(conn: sqlite3.Connection, now_ms: int) -> None:
    cutoff = now_ms - PRUNE_AFTER_DAYS * MS_PER_DAY
    # Ultra-fast index check: skip expensive prune query if no visits older than cutoff exist
    if not conn.execute("SELECT 1 FROM visits WHERE at < ? LIMIT 1", (cutoff,)).fetchone():
        return
    conn.execute(
        "DELETE FROM visits WHERE (kind, target) IN "
        "(SELECT i.kind, i.target FROM items i LEFT JOIN visits v ON v.kind = i.kind AND v.target = i.target "
        "GROUP BY i.kind, i.target HAVING COUNT(v.at) <= 1 AND COALESCE(MAX(v.at), 0) < ?)",
        (cutoff,),
    )
    conn.execute(
        "DELETE FROM items WHERE (kind, target) NOT IN (SELECT DISTINCT kind, target FROM visits)"
    )


def cmd_record(args) -> int:
    now_ms = int(time.time() * 1000)
    icon = getattr(args, "icon", "") or ""
    icon_font = getattr(args, "icon_font", "") or ""
    detail = getattr(args, "detail", "") or ""
    action = getattr(args, "action", "") or ""
    # Fire-and-forget recorders overlap (menu pick + window open + dmenu),
    # so a write can meet a locked database. WAL + busy timeout absorbs
    # bursts, and a short retry covers the straggler instead of dropping it.
    last_error = "unknown error"
    for attempt in range(3):
        try:
            with connect(db_path()) as conn:
                conn.execute(
                    "INSERT INTO items(kind, target, title, icon, icon_font, detail, action) VALUES(?, ?, ?, ?, ?, ?, ?) "
                    "ON CONFLICT(kind, target) DO UPDATE SET "
                    "title=CASE WHEN excluded.title = '' THEN items.title ELSE excluded.title END, "
                    "icon=CASE WHEN excluded.icon = '' THEN items.icon ELSE excluded.icon END, "
                    "icon_font=CASE WHEN excluded.icon_font = '' THEN items.icon_font ELSE excluded.icon_font END, "
                    "detail=CASE WHEN excluded.detail = '' THEN items.detail ELSE excluded.detail END, "
                    "action=CASE WHEN excluded.action = '' THEN items.action ELSE excluded.action END",
                    (args.kind, args.target, args.title or "", icon, icon_font, detail, action),
                )
                conn.execute(
                    "INSERT INTO visits(kind, target, at, via) VALUES(?, ?, ?, ?)",
                    (args.kind, args.target, now_ms, args.via),
                )
                conn.execute(
                    "DELETE FROM visits WHERE kind = ? AND target = ? AND rowid NOT IN "
                    "(SELECT rowid FROM visits WHERE kind = ? AND target = ? ORDER BY at DESC LIMIT ?)",
                    (args.kind, args.target, args.kind, args.target, MAX_VISITS_PER_TARGET),
                )
                query_hash = query_fingerprint(getattr(args, "query", "") or "")
                if query_hash:
                    conn.execute(
                        "INSERT INTO query_choices(kind, query_hash, target, count, last_used) VALUES(?, ?, ?, 1, ?) "
                        "ON CONFLICT(kind, query_hash, target) DO UPDATE SET count = count + 1, last_used = excluded.last_used",
                        (args.kind, query_hash, args.target, now_ms),
                    )
                    conn.execute(
                        "DELETE FROM query_choices WHERE kind = ? AND target = ? AND query_hash NOT IN "
                        "(SELECT query_hash FROM query_choices WHERE kind = ? AND target = ? ORDER BY last_used DESC LIMIT ?)",
                        (args.kind, args.target, args.kind, args.target, MAX_QUERY_CHOICES_PER_TARGET),
                    )
                prune_stale(conn, now_ms)
            return 0
        except sqlite3.OperationalError as e:
            last_error = e
            if "locked" not in str(e).lower():
                break
            time.sleep(0.1 * (attempt + 1))
    print(f"omarchy-activity: database error: {last_error}", file=sys.stderr)
    return 1


def score_case(now_ms: int, blended: bool) -> str:
    """SQL expression for a target's score: bucket weights, bonus, blend."""
    weights = bucket_weight_case(now_ms)
    if blended:
        weights = f"CASE WHEN v.via = 'pick' THEN {weights} ELSE {VIEW_WEIGHT} * ({weights}) END"
    return f"SUM({weights}) + MAX(i.bonus)"


def cmd_top(args) -> int:
    now_ms = int(time.time() * 1000)
    blended = args.via == "blended"
    query = (
        "SELECT i.target, i.kind, i.title, i.icon, i.icon_font, i.detail, i.action, i.bonus, COUNT(v.at) AS uses, MAX(v.at) AS last_used, "
        f"{score_case(now_ms, blended)} AS score "
        "FROM items i JOIN visits v ON v.kind = i.kind AND v.target = i.target "
    )
    clauses: list = []
    params: list = []
    if args.kind:
        clauses.append("i.kind = ?")
        params.append(args.kind)
    if args.via in ("pick", "view"):
        clauses.append("v.via = ?")
        params.append(args.via)
    if clauses:
        query += "WHERE " + " AND ".join(clauses) + " "
    query += "GROUP BY i.kind, i.target ORDER BY score DESC, last_used DESC LIMIT ?"
    params.append(args.limit)
    with connect(db_path()) as conn:
        conn.row_factory = sqlite3.Row
        rows = conn.execute(query, params).fetchall()
    out = {}
    for r in rows:
        item_obj = {
            "count": r["uses"],
            "lastUsed": r["last_used"],
            "pinned": r["bonus"] > 0,
            "score": r["score"],
            "kind": r["kind"],
            "title": r["title"] or "",
        }
        if r["icon"]:
            item_obj["icon"] = r["icon"]
        if r["icon_font"]:
            item_obj["iconFont"] = r["icon_font"]
        if r["detail"]:
            item_obj["detail"] = r["detail"]
        if r["action"]:
            item_obj["action"] = r["action"]
        out[r["target"]] = item_obj
    print(json.dumps(out))
    return 0


def search_event(event_type: str, query_id: str, **payload) -> dict:
    return {
        "version": SEARCH_PROTOCOL_VERSION,
        "source": "activity",
        "queryId": str(query_id),
        "type": event_type,
        **payload,
    }


def search_rows(query: str, kind: str, limit: int, conn: sqlite3.Connection | None = None) -> list[dict]:
    """Return globally ranked FTS and infix candidates for one scoped query."""
    words = re.findall(r"\w+", query)
    if not words:
        return []

    owns_conn = conn is None
    if conn is None:
        conn = connect_search(db_path())
    if conn is None:
        return []
    conn.row_factory = sqlite3.Row
    has_query_choices = conn.execute(
        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'query_choices'"
    ).fetchone() is not None
    query_score = (
        "COALESCE((SELECT count FROM query_choices qc WHERE qc.kind = i.kind "
        "AND qc.query_hash = ? AND qc.target = i.target), 0)"
        if has_query_choices else "0"
    )

    fts_q = " AND ".join(f'"{w}"*' for w in words)
    where = ["items_fts MATCH ?"]
    query_hash = query_fingerprint(query)
    params = ([query_hash] if has_query_choices else []) + [fts_q]
    if kind:
        where.append("i.kind = ?")
        params.append(kind)

    now_ms = int(time.time() * 1000)
    visit_weight = bucket_weight_case(now_ms, "v.at")
    blended_visit_weight = f"CASE WHEN v.via = 'pick' THEN {visit_weight} ELSE {VIEW_WEIGHT} * ({visit_weight}) END"
    frecency = (
        "COALESCE((SELECT SUM(" + blended_visit_weight + ") FROM visits v "
        "WHERE v.kind = i.kind AND v.target = i.target), 0) + i.bonus"
    )
    # FTS has four columns, including the UNINDEXED kind column. BM25 weights
    # are positional even for UNINDEXED columns, so the leading zero matters:
    # title matches rank well above detail and target matches.
    sql = f"""
    SELECT i.target, i.kind, i.title, i.icon, i.icon_font, i.detail, i.action,
           bm25(items_fts, 0.0, 0.5, 10.0, 1.5) AS score,
           i.bonus,
           {query_score} AS query_score,
           {frecency} AS frecency,
           (SELECT at FROM visits WHERE kind = i.kind AND target = i.target ORDER BY at DESC LIMIT 1) AS last_used,
           (SELECT COUNT(at) FROM visits WHERE kind = i.kind AND target = i.target) AS uses
    FROM items_fts f
    JOIN items i ON i.rowid = f.rowid
    WHERE {' AND '.join(where)}
    ORDER BY i.bonus DESC, score ASC, query_score DESC, frecency DESC, last_used DESC, i.title COLLATE NOCASE, i.target
    LIMIT ?
    """
    # Pull a bounded relevance set from each matcher, then merge and apply the
    # global pin/relevance/frecency order. This preserves useful infix matches
    # even when FTS also found rows, without materializing an unbounded result.
    candidate_limit = max(limit * 3, limit)
    params.append(candidate_limit)
    candidates: dict[tuple[str, str], tuple[sqlite3.Row, int]] = {}
    fts_error = None
    like_error = None
    try:
        for row in conn.execute(sql, params):
            candidates[(row["kind"], row["target"])] = (row, 0)
    except sqlite3.Error as error:
        fts_error = error

    like_clauses = ["(i.title LIKE ? OR i.detail LIKE ? OR i.target LIKE ?)" for _ in words]
    like_params = []
    for word in words:
        pattern = f"%{word}%"
        like_params.extend([pattern, pattern, pattern])
    if kind:
        like_clauses.append("i.kind = ?")
        like_params.append(kind)
    # Ordinary infix matches rank after every FTS match, so a full substring
    # scan cannot affect a filled result page. Pinned infix matches are the
    # exception and are cheap to check independently.
    include_all_infix = len(candidates) < limit
    if not include_all_infix:
        like_clauses.append("i.bonus > 0")
    like_params.append(candidate_limit if include_all_infix else limit)
    like_sql = f"""
        SELECT i.target, i.kind, i.title, i.icon, i.icon_font, i.detail, i.action,
               0 AS score,
               i.bonus,
               {query_score} AS query_score,
               {frecency} AS frecency,
               (SELECT at FROM visits WHERE kind = i.kind AND target = i.target ORDER BY at DESC LIMIT 1) AS last_used,
               (SELECT COUNT(at) FROM visits WHERE kind = i.kind AND target = i.target) AS uses
        FROM items i
        WHERE {' AND '.join(like_clauses)}
        ORDER BY i.bonus DESC, query_score DESC, frecency DESC, last_used DESC, uses DESC, i.title COLLATE NOCASE, i.target
        LIMIT ?
    """
    if has_query_choices:
        like_params.insert(0, query_hash)
    try:
        for row in conn.execute(like_sql, like_params):
            candidates.setdefault((row["kind"], row["target"]), (row, 1))
    except sqlite3.Error as error:
        like_error = error

    if owns_conn:
        conn.close()
    if fts_error is not None and like_error is not None:
        raise sqlite3.OperationalError(f"FTS search failed: {fts_error}; infix search failed: {like_error}")

    ranked = sorted(
        candidates.values(),
        key=lambda candidate: (
            -candidate[0]["bonus"],
            candidate[1],
            float(candidate[0]["score"] or 0.0) if candidate[1] == 0 else 0.0,
            -int(candidate[0]["query_score"] or 0),
            -float(candidate[0]["frecency"] or 0.0),
            -int(candidate[0]["last_used"] or 0),
            (candidate[0]["title"] or "").casefold(),
            candidate[0]["target"],
        ),
    )[:limit]
    results = []
    for r, _match_tier in ranked:
        rk = r["kind"]
        rt = r["target"]
        result = {
            "itemId": f"{rk}.{rt}",
            "disabled": False,
            "kind": rk,
            "icon": r["icon"] or "",
            "iconFont": r["icon_font"] or "",
            "appIcon": "",
            "appId": "",
            "label": r["title"] or rt,
            "target": rt,
            "detail": r["detail"] or rt,
            "path": "",
            "childCount": 0,
            "action": r["action"] or "",
            "provider": "",
            "score": float(r["score"]) if r["score"] is not None else 0.0,
            "section": "",
            "lastUsed": int(r["last_used"] or 0),
            "useCount": int(r["uses"] or 0),
            "pinned": int(r["bonus"] or 0) > 0,
        }
        results.append(result)
    return results


def emit_search(rows: list[dict], query_id: str) -> None:
    for offset in range(0, len(rows), SEARCH_BATCH_SIZE):
        print(json.dumps(search_event("rows", query_id, rows=rows[offset:offset + SEARCH_BATCH_SIZE])), flush=True)
    print(json.dumps(search_event("done", query_id)), flush=True)


def cmd_search_worker() -> int:
    """Serve only the latest NDJSON request, interrupting superseded SQL."""
    requests: queue.Queue = queue.Queue(maxsize=1)
    state = {"conn": None, "sequence": 0}
    state_lock = threading.Lock()

    def read_requests() -> None:
        for line in sys.stdin:
            with state_lock:
                state["sequence"] += 1
                sequence = state["sequence"]
                active_conn = state["conn"]
                if active_conn is not None:
                    active_conn.interrupt()
            try:
                requests.get_nowait()
            except queue.Empty:
                pass
            requests.put((sequence, line))
        requests.put(None)

    reader = threading.Thread(target=read_requests, name="activity-search-input", daemon=True)
    reader.start()
    conn = None
    while True:
        queued = requests.get()
        if queued is None:
            break
        sequence, line = queued
        query_id = ""
        try:
            request = json.loads(line)
            if not isinstance(request, dict):
                raise ValueError("search request must be an object")
            query_id = str(request.get("queryId", ""))
            if request.get("version") != SEARCH_PROTOCOL_VERSION:
                raise ValueError("unsupported search request")
            query = str(request.get("query", ""))
            kind = str(request.get("kind", ""))
            limit = max(1, min(int(request.get("limit", 15)), 1000))
            if conn is None:
                conn = connect_search(db_path())
                with state_lock:
                    state["conn"] = conn
            rows = search_rows(query, kind, limit, conn)
        except (ValueError, TypeError, json.JSONDecodeError, sqlite3.Error) as error:
            with state_lock:
                superseded = state["sequence"] > sequence
            interrupted = isinstance(error, sqlite3.OperationalError) and "interrupt" in str(error).lower()
            if conn is not None and not (superseded and interrupted):
                with state_lock:
                    state["conn"] = None
                    conn.close()
                    conn = None
            if superseded:
                continue
            print(json.dumps(search_event("error", query_id, message=str(error))), flush=True)
            continue

        with state_lock:
            superseded = state["sequence"] > sequence
        if not superseded:
            emit_search(rows, query_id)
    if conn is not None:
        with state_lock:
            state["conn"] = None
            conn.close()
    reader.join(timeout=0.1)
    return 0


def cmd_search(args) -> int:
    if args.worker:
        return cmd_search_worker()

    query_id = getattr(args, "query_id", "") or ""
    try:
        results = search_rows(args.query or "", args.kind or "", max(1, args.limit or 15))
    except sqlite3.Error as error:
        if args.stream:
            print(json.dumps(search_event("error", query_id, message=str(error))), flush=True)
        else:
            print(f"omarchy-activity: search error: {error}", file=sys.stderr)
        return 1

    if args.stream:
        emit_search(results, query_id)
    else:
        print(json.dumps(results))
    return 0


def cmd_rank(args) -> int:
    """Sort stdin lines: scored first by score, unknowns keep input order."""
    kind = getattr(args, "kind", "file") or "file"
    try:
        with connect(db_path()) as conn:
            conn.row_factory = sqlite3.Row
            scores = {
                r["target"]: r["score"]
                for r in conn.execute(
                    "SELECT i.target AS target, "
                    f"{score_case(int(time.time() * 1000), args.via == 'blended')} AS score "
                    "FROM items i JOIN visits v ON v.kind = i.kind AND v.target = i.target "
                    "WHERE i.kind = ? AND (? IN ('all', 'blended') OR v.via = ?) "
                    "GROUP BY i.kind, i.target",
                    (kind, args.via, args.via),
                ).fetchall()
            }
    except sqlite3.Error:
        scores = {}
    seen = set()
    ranked = []
    rest = []
    for line in sys.stdin:
        target = line.rstrip("\n")
        if not target or target in seen:
            continue
        seen.add(target)
        (ranked if target in scores else rest).append(target)
    ranked.sort(key=lambda t: scores[t], reverse=True)
    for target in (ranked + rest)[: args.limit]:
        print(target)
    return 0


def cmd_rank_files(args) -> int:
    return cmd_rank(args)


def cmd_forget(args) -> int:
    with connect(db_path()) as conn:
        if getattr(args, "kind", None) and args.kind:
            conn.execute("DELETE FROM visits WHERE kind = ? AND target = ?", (args.kind, args.target))
            conn.execute("DELETE FROM query_choices WHERE kind = ? AND target = ?", (args.kind, args.target))
            conn.execute("DELETE FROM items WHERE kind = ? AND target = ?", (args.kind, args.target))
        else:
            conn.execute("DELETE FROM visits WHERE target = ?", (args.target,))
            conn.execute("DELETE FROM query_choices WHERE target = ?", (args.target,))
            conn.execute("DELETE FROM items WHERE target = ?", (args.target,))
    print(f"forgot {args.target}")
    return 0


def cmd_pin(args) -> int:
    with connect(db_path()) as conn:
        if getattr(args, "kind", None) and args.kind:
            updated = conn.execute(
                "UPDATE items SET bonus = ? WHERE kind = ? AND target = ?",
                (100 if args.verb == "pin" else 0, args.kind, args.target),
            ).rowcount
        else:
            updated = conn.execute(
                "UPDATE items SET bonus = ? WHERE target = ?",
                (100 if args.verb == "pin" else 0, args.target),
            ).rowcount
    if updated:
        print(f"{args.verb}ned {args.target}")
    else:
        print(f"omarchy-activity: unknown target '{args.target}'", file=sys.stderr)
    return 0 if updated else 1


def cmd_stats(args) -> int:
    with connect(db_path()) as conn:
        conn.row_factory = sqlite3.Row
        kinds = {
            r["kind"]: {
                "targets": r["targets"],
                "visits": r["visits"],
                "newest": r["newest"],
            }
            for r in conn.execute(
                "SELECT i.kind AS kind, COUNT(DISTINCT i.target) AS targets, "
                "COUNT(v.at) AS visits, MAX(v.at) AS newest "
                "FROM items i LEFT JOIN visits v ON v.kind = i.kind AND v.target = i.target "
                "GROUP BY i.kind"
            ).fetchall()
        }
        vias = {
            r["via"]: {"targets": r["targets"], "visits": r["visits"]}
            for r in conn.execute(
                "SELECT via, COUNT(DISTINCT target) AS targets, COUNT(*) AS visits "
                "FROM visits GROUP BY via"
            ).fetchall()
        }
        totals = conn.execute(
            "SELECT COUNT(*) AS targets, "
            "(SELECT COUNT(*) FROM visits) AS visits FROM items"
        ).fetchone()
    print(json.dumps({
        "kinds": kinds,
        "vias": vias,
        "targets": totals["targets"],
        "visits": totals["visits"],
    }))
    return 0


def cmd_import_xbel(args) -> int:
    """Seed file frecency from the Gtk recent manager (one visit each)."""
    import urllib.parse
    import xml.etree.ElementTree as ET
    from datetime import datetime

    path = Path(args.file) if args.file else (
        Path(os.environ.get("HOME", str(Path.home()))) / ".local/share/recently-used.xbel"
    )
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError) as e:
        print(f"omarchy-activity: cannot read {path}: {e}", file=sys.stderr)
        return 1

    def stamp(value: str) -> int:
        try:
            return int(datetime.fromisoformat(value).timestamp() * 1000)
        except (TypeError, ValueError):
            return 0

    seen: dict = {}
    for bookmark in root.iter("bookmark"):
        href = bookmark.get("href", "")
        if not href.startswith("file://"):
            continue
        target = urllib.parse.unquote(href[len("file://"):])
        if not target.startswith("/") or target in seen:
            continue
        at = max(
            stamp(bookmark.get("visited", "")),
            stamp(bookmark.get("modified", "")),
            stamp(bookmark.get("added", "")),
        )
        if at > 0:
            seen[target] = at
    now_ms = int(time.time() * 1000)
    with connect(db_path()) as conn:
        for target, at in seen.items():
            conn.execute(
                "INSERT INTO items(kind, target, title, detail, icon) VALUES('file', ?, ?, ?, '') "
                "ON CONFLICT(kind, target) DO UPDATE SET title = excluded.title, detail = excluded.detail, icon = ''",
                (target, Path(target).name, str(Path(target).parent)),
            )
            if conn.execute(
                "SELECT COUNT(*) FROM visits WHERE kind = 'file' AND target = ?", (target,)
            ).fetchone()[0] == 0:
                conn.execute(
                    "INSERT INTO visits(kind, target, at, via) VALUES('file', ?, ?, 'pick')",
                    (target, min(at, now_ms)),
                )
    print(f"imported {len(seen)} files")
    return 0


def cmd_import_frecency(args) -> int:
    """One-shot migration from the menu's legacy launcher-frecency.json."""
    try:
        legacy = json.loads(Path(args.file).read_text())
    except (OSError, ValueError) as e:
        print(f"omarchy-activity: cannot read {args.file}: {e}", file=sys.stderr)
        return 1
    if not isinstance(legacy, dict):
        print(f"omarchy-activity: {args.file} is not an object", file=sys.stderr)
        return 1
    imported = 0
    with connect(db_path()) as conn:
        for target, record in legacy.items():
            if not isinstance(target, str) or not target or not isinstance(record, dict):
                continue
            try:
                count = max(0, int(record.get("count", 0)))
                last_used = int(record.get("lastUsed", 0))
            except (TypeError, ValueError):
                continue
            if count <= 0 or last_used <= 0:
                continue
            conn.execute(
                "INSERT INTO items(kind, target) VALUES(?, ?) "
                "ON CONFLICT(kind, target) DO NOTHING",
                (args.default_kind, target),
            )
            seed = min(count, MAX_VISITS_PER_TARGET)
            conn.executemany(
                "INSERT INTO visits(kind, target, at) VALUES(?, ?, ?)",
                [(args.default_kind, target, last_used)] * seed,
            )
            imported += 1
    print(f"imported {imported} targets")
    return 0


def cmd_import_zoxide(args) -> int:
    """Seed project frecency from zoxide."""
    lines = []
    if getattr(args, "file", None) and args.file and args.file != "-":
        p = Path(args.file)
        if not p.exists():
            print(f"omarchy-activity: cannot read {p}", file=sys.stderr)
            return 1
        try:
            lines = p.read_text(errors="replace").splitlines()
        except OSError as e:
            print(f"omarchy-activity: cannot read {p}: {e}", file=sys.stderr)
            return 1
    elif getattr(args, "file", None) == "-" or (not sys.stdin.isatty() and not getattr(args, "file", None)):
        lines = sys.stdin.read().splitlines()
    else:
        import shutil
        import subprocess
        if not shutil.which("zoxide"):
            print("omarchy-activity: zoxide not found", file=sys.stderr)
            return 1
        res = subprocess.run(["zoxide", "query", "-l", "-s"], capture_output=True, text=True)
        if res.returncode != 0:
            print(f"omarchy-activity: zoxide query failed: {res.stderr.strip()}", file=sys.stderr)
            return 1
        lines = res.stdout.splitlines()

    now_ms = int(time.time() * 1000)
    imported = 0
    with connect(db_path()) as conn:
        for line in lines:
            line = line.strip()
            if not line:
                continue
            parts = line.split(None, 1)
            score = 1.0
            if len(parts) == 2:
                try:
                    score = float(parts[0])
                    path_str = parts[1]
                except ValueError:
                    path_str = line
            else:
                path_str = line

            target = os.path.abspath(os.path.expanduser(path_str))
            title = Path(target).name or target
            conn.execute(
                "INSERT INTO items(kind, target, title, detail, icon) VALUES('project', ?, ?, ?, '') "
                "ON CONFLICT(kind, target) DO UPDATE SET title = excluded.title, detail = excluded.detail, icon = ''",
                (target, title, target),
            )
            if conn.execute(
                "SELECT COUNT(*) FROM visits WHERE kind = 'project' AND target = ?", (target,)
            ).fetchone()[0] == 0:
                seed_visits = min(max(1, int(score)), MAX_VISITS_PER_TARGET)
                conn.executemany(
                    "INSERT INTO visits(kind, target, at, via) VALUES('project', ?, ?, 'view')",
                    [(target, now_ms)] * seed_visits,
                )
                imported += 1
    print(f"imported {imported} projects from zoxide")
    return 0


def cmd_import_agents(args) -> int:
    """Seed project workspaces and agent sessions from Antigravity and Codex."""
    from datetime import datetime

    home = Path(os.environ.get("HOME", str(Path.home())))
    ag_path = Path(args.antigravity) if getattr(args, "antigravity", None) else (
        home / ".gemini/antigravity-cli/history.jsonl"
    )
    codex_idx_path = Path(args.codex) if getattr(args, "codex", None) else (
        home / ".codex/session_index.jsonl"
    )
    codex_conf_path = home / ".codex/config.toml"

    projects: dict[str, int] = {}
    sessions: dict[str, dict] = {}

    def prompt_text(value) -> str:
        """Extract readable prompt text from the common agent message shapes."""
        if isinstance(value, str):
            return value
        if isinstance(value, dict):
            return prompt_text(value.get("content") or value.get("text") or "")
        if isinstance(value, list):
            parts = [prompt_text(part) for part in value]
            return " ".join(part for part in parts if part)
        return ""

    # 1. Parse Antigravity conversation summaries database if available
    ag_db_path = ag_path.parent / "conversation_summaries.db"
    ag_summaries: dict[str, dict] = {}
    if ag_db_path.exists():
        try:
            with sqlite3.connect(str(ag_db_path)) as c_db:
                c_db.row_factory = sqlite3.Row
                for row in c_db.execute(
                    "SELECT conversation_id, title, preview, last_modified_time, last_user_input_time FROM conversation_summaries"
                ):
                    cid = row["conversation_id"]
                    title = (row["title"] or "").strip()
                    if not title and row["preview"]:
                        title = row["preview"].strip().splitlines()[0][:80]
                    ts = 0
                    time_str = row["last_modified_time"] or row["last_user_input_time"]
                    if time_str and not str(time_str).startswith("0001"):
                        try:
                            ts = int(datetime.fromisoformat(str(time_str)).timestamp() * 1000)
                        except (ValueError, TypeError):
                            pass
                    if cid:
                        ag_summaries[cid] = {"title": title, "ts": ts}
        except (sqlite3.Error, OSError):
            pass

    # 1b. Parse Antigravity history
    if ag_path.exists():
        try:
            for line in ag_path.read_text(errors="replace").splitlines():
                if not line.strip():
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                ws = obj.get("workspace")
                ts = int(obj.get("timestamp") or 0)
                if ws and isinstance(ws, str) and ws.startswith("/"):
                    ws = os.path.abspath(ws)
                    projects[ws] = max(projects.get(ws, 0), ts)
                cid = obj.get("conversationId")
                disp = obj.get("display") or ""
                if cid and isinstance(cid, str):
                    prompt_title = disp.strip().splitlines()[0][:80] if disp else cid
                    prev = sessions.get(cid)
                    # Prefer AI summary title from conversation_summaries.db if available,
                    # else use the first prompt (which describes the session goal)
                    title = ag_summaries.get(cid, {}).get("title")
                    if not title:
                        title = prev["title"] if prev and prev.get("title") else prompt_title
                    max_ts = max(ts, prev["ts"] if prev else 0, ag_summaries.get(cid, {}).get("ts", 0))
                    sessions[cid] = {
                        "title": title,
                        "ts": max_ts,
                        "icon": "󰫢",
                        "icon_font": "",
                        "detail": f"Antigravity • {cid[:8]}",
                        "action": f"omarchy agent --agent agy --resume '{cid}'",
                    }
        except OSError:
            pass

    for cid, s_info in ag_summaries.items():
        if cid not in sessions and s_info.get("title"):
            sessions[cid] = {
                "title": s_info["title"],
                "ts": s_info.get("ts", 0),
                "icon": "󰫢",
                "icon_font": "",
                "detail": f"Antigravity • {cid[:8]}",
                "action": f"omarchy agent --agent agy --resume '{cid}'",
            }

    # 2. Parse Codex session index
    if codex_idx_path.exists():
        try:
            for line in codex_idx_path.read_text(errors="replace").splitlines():
                if not line.strip():
                    continue
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                cid = obj.get("id")
                name = obj.get("thread_name") or ""
                up = obj.get("updated_at")
                ts = 0
                if up:
                    try:
                        if up.endswith("Z"):
                            up = up[:-1] + "+00:00"
                        ts = int(datetime.fromisoformat(up).timestamp() * 1000)
                    except (ValueError, TypeError):
                        pass
                if cid and isinstance(cid, str):
                    title = name.strip() or cid
                    prev = sessions.get(cid)
                    if not prev or ts > prev["ts"]:
                        sessions[cid] = {
                            "title": title,
                            "ts": ts,
                            "icon": "",
                            "icon_font": "omarchy",
                            "detail": f"Codex • {cid[:8]}",
                            "action": f"omarchy agent --agent codex --resume '{cid}'",
                        }
        except OSError:
            pass

    # 3. Parse Codex config.toml for trusted projects
    if codex_conf_path.exists():
        try:
            for line in codex_conf_path.read_text(errors="replace").splitlines():
                line = line.strip()
                if line.startswith('[projects."') and line.endswith('"]'):
                    p = line[len('[projects."') : -2]
                    if p.startswith("/"):
                        p = os.path.abspath(p)
                        if p not in projects:
                            projects[p] = int(time.time() * 1000)
        except OSError:
            pass

    # 4. Parse OpenCode session database
    opencode_db = home / ".local/share/opencode/opencode.db"
    if opencode_db.exists():
        try:
            with sqlite3.connect(str(opencode_db)) as o_db:
                o_db.row_factory = sqlite3.Row
                tables = [r[0] for r in o_db.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()]
                target_table = "session_v2" if "session_v2" in tables else ("session" if "session" in tables else None)
                if target_table:
                    query = f"SELECT id, title, directory, time_updated FROM {target_table} WHERE parent_id IS NULL OR parent_id = ''"
                    for row in o_db.execute(query):
                        sid = row["id"]
                        title = (row["title"] or "").strip() or sid
                        ts = int(row["time_updated"] or 0)
                        directory = row["directory"]
                        if directory and os.path.isabs(directory):
                            projects[directory] = max(projects.get(directory, 0), ts)
                        if sid:
                            sessions[sid] = {
                                "title": title,
                                "ts": ts,
                                "icon": "",
                                "icon_font": "omarchy",
                                "detail": f"OpenCode • {sid[:8]}",
                                "action": f"omarchy agent --agent opencode --resume '{sid}'",
                            }
        except (sqlite3.Error, OSError):
            pass

    # 5. Parse Claude Code sessions if present
    claude_projects = home / ".claude/projects"
    if claude_projects.exists() and claude_projects.is_dir():
        try:
            for proj_dir in claude_projects.iterdir():
                if not proj_dir.is_dir():
                    continue
                for sess_file in proj_dir.glob("*.json*"):
                    try:
                        sid = sess_file.stem
                        ts = int(sess_file.stat().st_mtime * 1000)
                        title = sid
                        text = sess_file.read_text(errors="replace")
                        if sess_file.suffix == ".jsonl":
                            for line in text.splitlines():
                                if not line.strip():
                                    continue
                                obj = json.loads(line)
                                if obj.get("type") == "user" or "prompt" in obj:
                                    p = prompt_text(obj.get("prompt") or obj.get("message") or "")
                                    if p:
                                        title = p.strip().splitlines()[0][:80]
                                        break
                        elif sess_file.suffix == ".json":
                            obj = json.loads(text)
                            if isinstance(obj, dict):
                                title = obj.get("title") or obj.get("name") or sid
                        sessions[sid] = {
                            "title": title,
                            "ts": ts,
                            "icon": "󰛄",
                            "icon_font": "",
                            "detail": f"Claude • {sid[:8]}",
                            "action": f"omarchy agent --agent claude --resume '{sid}'",
                        }
                    except (OSError, ValueError):
                        pass
        except OSError:
            pass

    now_ms = int(time.time() * 1000)
    p_imported = 0
    s_imported = 0
    with connect(db_path()) as conn:
        for p, ts in projects.items():
            at = ts if ts > 0 else now_ms
            conn.execute(
                "INSERT INTO items(kind, target, title) VALUES('project', ?, ?) "
                "ON CONFLICT(kind, target) DO NOTHING",
                (p, Path(p).name or p),
            )
            if conn.execute(
                "SELECT COUNT(*) FROM visits WHERE kind = 'project' AND target = ?", (p,)
            ).fetchone()[0] == 0:
                conn.execute(
                    "INSERT INTO visits(kind, target, at, via) VALUES('project', ?, ?, 'view')",
                    (p, min(at, now_ms)),
                )
                p_imported += 1

        for sid, s in sessions.items():
            at = s["ts"] if s["ts"] > 0 else now_ms
            conn.execute(
                "INSERT INTO items(kind, target, title, icon, icon_font, detail, action) VALUES('agent-session', ?, ?, ?, ?, ?, ?) "
                "ON CONFLICT(kind, target) DO UPDATE SET "
                "title=excluded.title, icon=excluded.icon, icon_font=excluded.icon_font, detail=excluded.detail, action=excluded.action",
                (sid, s["title"], s["icon"], s["icon_font"], s["detail"], s["action"]),
            )
            if conn.execute(
                "SELECT COUNT(*) FROM visits WHERE kind = 'agent-session' AND target = ?", (sid,)
            ).fetchone()[0] == 0:
                conn.execute(
                    "INSERT INTO visits(kind, target, at, via) VALUES('agent-session', ?, ?, 'view')",
                    (sid, min(at, now_ms)),
                )
                s_imported += 1

    print(f"imported {p_imported} projects and {s_imported} agent sessions")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="omarchy activity")
    sub = parser.add_subparsers(dest="verb", required=True)

    record = sub.add_parser("record", help="log one use of a target")
    record.add_argument("kind", help="target namespace: app, file, menu, ...")
    record.add_argument("target", help="stable target id, e.g. a desktop id or menu id")
    record.add_argument("title", nargs="?", default="", help="human-readable label")
    record.add_argument("--via", choices=("pick", "view"), default="pick",
                        help="explicit picks outrank passive views")
    record.add_argument("--icon", default="", help="optional icon glyph")
    record.add_argument("--icon-font", default="", help="optional icon font family")
    record.add_argument("--detail", default="", help="optional secondary text")
    record.add_argument("--action", default="", help="optional custom command template")
    record.add_argument("--query", default="", help="optional search query to learn for this pick")
    record.set_defaults(func=cmd_record)

    top = sub.add_parser("top", help="print {target: {count, lastUsed, score}} as JSON")
    top.add_argument("--kind", default="", help="only include this namespace")
    top.add_argument("--via", choices=("pick", "view", "all", "blended"), default="blended",
                     help="which provenance to rank (blended weights views at a fraction)")
    top.add_argument("--limit", type=int, default=DEFAULT_TOP_LIMIT)
    top.set_defaults(func=cmd_top)

    search = sub.add_parser("search", help="fast SQLite FTS5 search across indexed items")
    search.add_argument("query", nargs="?", default="", help="search terms")
    search.add_argument("--kind", default="", help="optional namespace (e.g. agent-session, file, project)")
    search.add_argument("--limit", type=int, default=15)
    search.add_argument("--stream", action="store_true", help="emit newline-delimited result batches")
    search.add_argument("--query-id", default="", help="correlation id included in stream events")
    search.add_argument("--worker", action="store_true", help="serve versioned NDJSON search requests on stdin")
    search.set_defaults(func=cmd_search)

    rank = sub.add_parser("rank", help="sort stdin lines by item score")
    rank.add_argument("--kind", default="file", help="target namespace (defaults to file)")
    rank.add_argument("--via", choices=("pick", "view", "all", "blended"), default="blended",
                      help="which provenance to rank by")
    rank.add_argument("--limit", type=int, default=DEFAULT_TOP_LIMIT)
    rank.set_defaults(func=cmd_rank)

    rank_files = sub.add_parser("rank-files", help="sort stdin paths by file score")
    rank_files.add_argument("--via", choices=("pick", "view", "all", "blended"), default="blended",
                            help="which provenance to rank by")
    rank_files.add_argument("--limit", type=int, default=DEFAULT_TOP_LIMIT)
    rank_files.set_defaults(func=cmd_rank_files)

    forget = sub.add_parser("forget", help="delete one target and its visits")
    forget.add_argument("target", help="target id to erase")
    forget.add_argument("--kind", default="", help="only delete within this namespace")
    forget.set_defaults(func=cmd_forget)

    pin = sub.add_parser("pin", help="float a target above scored results")
    pin.add_argument("target", help="target id to pin")
    pin.add_argument("--kind", default="", help="target namespace")
    pin.set_defaults(func=cmd_pin)

    unpin = sub.add_parser("unpin", help="release a pinned target")
    unpin.add_argument("target", help="target id to unpin")
    unpin.add_argument("--kind", default="", help="target namespace")
    unpin.set_defaults(func=cmd_pin)

    stats = sub.add_parser("stats", help="print per-kind counts as JSON")
    stats.set_defaults(func=cmd_stats)

    imp = sub.add_parser("import-frecency", help="one-shot import of launcher-frecency.json")
    imp.add_argument("file", help="path to the legacy JSON file")
    imp.add_argument("--default-kind", default="app")
    imp.set_defaults(func=cmd_import_frecency)

    xbel = sub.add_parser("import-xbel", help="seed file frecency from Gtk recently-used.xbel")
    xbel.add_argument("file", nargs="?", default="", help="xbel path (defaults to the Gtk one)")
    xbel.set_defaults(func=cmd_import_xbel)

    zo = sub.add_parser("import-zoxide", help="seed project frecency from zoxide")
    zo.add_argument("file", nargs="?", default="", help="optional zoxide query export or path list")
    zo.set_defaults(func=cmd_import_zoxide)

    agents = sub.add_parser("import-agents", help="seed project and session frecency from coding agents")
    agents.add_argument("--antigravity", default="", help="custom path to antigravity history.jsonl")
    agents.add_argument("--codex", default="", help="custom path to codex session_index.jsonl")
    agents.set_defaults(func=cmd_import_agents)

    args = parser.parse_args(argv)
    try:
        return args.func(args)
    except sqlite3.Error as e:
        print(f"omarchy-activity: database error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())

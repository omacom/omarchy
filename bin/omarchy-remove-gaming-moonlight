#!/bin/bash

# omarchy:summary=Remove the Moonlight game streaming client along with its paired hosts and settings.
# omarchy:requires-sudo=true

set -e

while (( $# > 0 )); do
  case "$1" in
  -h | --help | help)
    echo "Usage: omarchy-remove-gaming-moonlight"
    echo
    echo "Remove the Moonlight game streaming client along with its paired hosts and settings."
    exit 0
    ;;
  *)
    echo "omarchy-remove-gaming-moonlight: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
  shift
done

omarchy-pkg-drop moonlight-qt

rm -rf \
  "$HOME/.config/Moonlight Game Streaming Project" \
  "$HOME/.cache/Moonlight Game Streaming Project"

echo ""
echo "Moonlight and its settings have been removed."

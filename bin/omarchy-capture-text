#!/bin/bash

# omarchy:summary=Extract text from a screenshot region with OCR
# omarchy:group=capture
# omarchy:examples=omarchy capture text

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
}
trap cleanup_freeze EXIT

capture() {
  hyprpicker -r -z >/dev/null 2>&1 9>&- &
  PID=$!
  sleep .1
  SELECTION=$(slurp 2>/dev/null)

  [[ -z $SELECTION ]] && exit 0

  TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "${OMARCHY_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1

  # The screen is live again, so the next capture may start. wl-copy stays
  # behind to own the clipboard and must not hold the lock while it does.
  cleanup_freeze
  PID=""
  exec 9>&-

  [[ -z $TEXT ]] && exit 1

  printf "%s" "$TEXT" | wl-copy
  omarchy-notification-send -g 󰴑 "$(omarchy-i18n capture.textCopied)"
}

# A capture already under way owns the frozen screen; another one would stack a
# second freeze over it. The lock is this session's and is held from before the
# freeze starts until the screen is live again.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-capture-text.lock"
if flock -n 9; then
  capture
fi

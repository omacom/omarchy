#!/bin/bash

# omarchy:summary=Extract text from a screenshot region with OCR
# omarchy:group=capture
# omarchy:examples=omarchy capture text

# Keep hyprpicker alive until after grim captures so the screenshot sees the
# frozen overlay rather than live content shifting during teardown.
cleanup_freeze() {
  [[ -n $PID ]] && kill $PID 2>/dev/null
}
trap cleanup_freeze EXIT

hyprpicker -r -z >/dev/null 2>&1 &
PID=$!
sleep .1
SELECTION=$(slurp 2>/dev/null)

[[ -z $SELECTION ]] && exit 0

# OMARCHY_OCR_LANGS still wins, for a one-off. Otherwise the languages chosen
# in the menu (or written by omarchy-capture-ocr-languages) are what Tesseract
# is asked for. The default stays English.
if [[ -n ${OMARCHY_OCR_LANGS:-} ]]; then
  ocr_langs=$OMARCHY_OCR_LANGS
else
  ocr_langs=$(omarchy-capture-ocr-languages)
fi

TEXT=$(grim -g "$SELECTION" - | tesseract stdin stdout --oem 1 --psm 6 -l "$ocr_langs" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null) || exit 1

[[ -z $TEXT ]] && exit 1

printf "%s" "$TEXT" | wl-copy
omarchy-notification-send -g 󰴑 "$(omarchy-i18n capture.textCopied)"

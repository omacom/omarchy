#!/usr/bin/python3
# omarchy:summary=Turn Remote Control back on in Claude sessions whose login a switch moved
# omarchy:args=<home>...
# omarchy:hidden=true
"""Reconnect Remote Control after an account switch moved running sessions.

Trading logins between Claude homes changes the account every session in
those homes runs as, and Claude drops a session's Remote Control link when
that happens ("Remote Control disconnected — signed-in claude.ai account or
organization changed on this machine"). Running /remote-control in the session
connects it again as the new account.

omarchy-agent-account-state starts this in the background after a trade, with
the homes whose login changed. It finds the herdr panes running Claude in
those homes, and for each one whose pane shows that disconnect, waits until
the session is idle at an empty prompt, types /remote-control, accepts only
Claude's own "Enable Remote Control" confirmation, and checks it says
"/remote-control is active". It types into nothing else: a session that is
working, has a menu or a question open, or a draft in its prompt is waited
for, and anything unexpected ends the attempt with a notification and no
further keys.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

# How long a session may take to show the disconnect after the switch before
# it's taken to have had no Remote Control, and how long one that did may stay
# busy before this gives up on it.
NOTICE_SECONDS = float(os.environ.get("OMARCHY_RECONNECT_NOTICE_SECONDS", "300"))
TIMEOUT_SECONDS = float(os.environ.get("OMARCHY_RECONNECT_TIMEOUT_SECONDS", "1800"))
POLL_SECONDS = float(os.environ.get("OMARCHY_RECONNECT_POLL_SECONDS", "2"))
# How long Claude has to show what /remote-control did.
ANSWER_SECONDS = float(os.environ.get("OMARCHY_RECONNECT_ANSWER_SECONDS", "15"))
# Claude takes a few seconds to switch the dropped link off. /remote-control
# typed before that opens a "Remote Control isn't connected" dialog asking to
# wait about 10 seconds, so a session is left this long after its disconnect.
SETTLE_SECONDS = float(os.environ.get("OMARCHY_RECONNECT_SETTLE_SECONDS", "15"))

DISCONNECTED = "signed-in claude.ai account or organization changed"
ACTIVE = "/remote-control is active"
COMMAND = "/remote-control"
PROMPTS = ("❯", ">")
DECLINE = "Never mind"
# The dialog for a link still switching off. Esc is its own default
# ("Esc to continue"), the same as its preselected Continue; its other choice
# disconnects the session for good, so only Esc is ever sent to it.
NOT_YET = ("Remote Control isn't connected", "wait about 10 seconds for Remote Control to switch off", "Esc to continue")
# A session that picks up the link it had before reconnects without a word.
# /remote-control in a connected session opens this dialog instead, which is
# how a silent reconnect is confirmed; Esc (its default, Continue) closes it.
CONNECTED = ("This session is available in the Claude mobile app", "Disconnect this session", "Esc to continue")
# Words a footer shows only while a menu, dialog or picker is open.
MENU_HINTS = ("esc to", "enter to", "↑↓", "tab to select")


def herdr(*args: str) -> dict[str, Any] | None:
  try:
    out = subprocess.run(["herdr", *args], capture_output=True, text=True, timeout=20, check=True).stdout
    return (json.loads(out) or {}).get("result")
  except (OSError, subprocess.SubprocessError, ValueError):
    return None


def read(pane: str, source: str = "recent-unwrapped", lines: int = 400) -> str:
  try:
    return subprocess.run(["herdr", "pane", "read", pane, "--source", source, "--lines", str(lines)], capture_output=True, text=True, timeout=20, check=True).stdout
  except (OSError, subprocess.SubprocessError):
    return ""


# The visible screen with its styling, which tells a suggestion in an empty
# prompt (drawn dim) from text someone typed.
def screen(pane: str) -> str:
  try:
    return subprocess.run(["herdr", "pane", "read", pane, "--source", "visible", "--lines", "60", "--format", "ansi"], capture_output=True, text=True, timeout=20, check=True).stdout
  except (OSError, subprocess.SubprocessError):
    return ""


def tr(lookup: str, english: str, *args: Any) -> str:
  key = lookup.split()[1]
  values = [str(arg) for arg in args]
  try:
    text = subprocess.run(["omarchy-i18n", key, *values], capture_output=True, text=True, check=True).stdout
  except (OSError, subprocess.CalledProcessError):
    text = ""
  if not text or text == key:
    text = english
    for index in range(len(values), 0, -1):
      text = text.replace(f"%{index}", values[index - 1])
  return text


def notify(title: str, body: str) -> None:
  subprocess.run(["omarchy-notification-send", "--app-name", "Omarchy Agents", "-g", "󰚩", title, body], check=False)


# ---------------------------------------------------------------- sessions


def environ(pid: int) -> dict[str, str]:
  try:
    entries = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
  except OSError:
    return {}
  values = {}
  for entry in entries:
    key, _, value = entry.decode(errors="replace").partition("=")
    if key:
      values[key] = value
  return values


# The home a Claude process reads its login from. One started without
# CLAUDE_CONFIG_DIR uses ~/.claude under its own HOME, not ours.
def session_home(pid: int) -> Path | None:
  env = environ(pid)
  if env.get("CLAUDE_CONFIG_DIR"):
    return Path(env["CLAUDE_CONFIG_DIR"]).resolve()
  if env.get("HOME"):
    return (Path(env["HOME"]) / ".claude").resolve()
  return None


def claude_pid(pane: str) -> int | None:
  info = (herdr("pane", "process-info", "--pane", pane) or {}).get("process_info") or {}
  for process in info.get("foreground_processes") or []:
    if process.get("name") == "claude" and isinstance(process.get("pid"), int):
      return process["pid"]
  return None


def sessions(homes: set[Path]) -> list[dict[str, Any]]:
  found = []
  for agent in (herdr("agent", "list") or {}).get("agents") or []:
    if agent.get("agent") != "claude" or not agent.get("pane_id"):
      continue
    pid = claude_pid(agent["pane_id"])
    if pid is not None and session_home(pid) in homes:
      found.append({"pane": agent["pane_id"], "title": agent.get("terminal_title_stripped") or agent["pane_id"]})
  return found


# ------------------------------------------------------------------ screen


ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
# An input that is all one dim run: the suggestion Claude shows in an empty
# prompt ("Try ..."), not something typed.
SUGGESTION = re.compile(r"(\x1b\[0?m)*\x1b\[2m[^\x1b]*(\x1b\[0?m)?\s*")


def lines_of(text: str) -> list[str]:
  return [ANSI.sub("", line).replace("\xa0", " ").rstrip() for line in text.splitlines()]


def is_rule(line: str) -> bool:
  stripped = line.strip()
  return len(stripped) >= 10 and set(stripped) == {"─"}


# The prompt box at the bottom of the screen: a rule, the input line, a rule,
# then the footer. Returns what's typed in it, or None when the bottom of the
# screen isn't a bare prompt box (a dialog, a menu, a question).
def prompt_input(screen: str) -> str | None:
  raw = [line.replace("\xa0", " ").rstrip("\r") for line in screen.splitlines()]
  lines = lines_of(screen)
  while lines and not lines[-1].strip():
    lines.pop()
  rules = [i for i, line in enumerate(lines) if is_rule(line)]
  if len(rules) < 2 or rules[-1] - rules[-2] != 2:
    return None
  footer = lines[rules[-1] + 1:]
  # The footer may list background tasks under the box; a menu says how to
  # leave it.
  if any(hint in line.lower() for line in footer for hint in MENU_HINTS):
    return None
  line = lines[rules[-2] + 1].strip()
  for prompt in PROMPTS:
    if line == prompt:
      return ""
    if line.startswith(prompt + " "):
      typed = raw[rules[-2] + 1].split(prompt, 1)[1][1:]
      if SUGGESTION.fullmatch(typed):
        return ""
      return line[len(prompt) + 1:].strip()
  return None


# Whether the session's Remote Control is down because its account changed:
# the last disconnect for that reason comes after the last time it said it
# was active.
def disconnected(text: str) -> bool:
  last_drop = text.rfind(DISCONNECTED)
  return last_drop >= 0 and last_drop > text.rfind(ACTIVE)


# What Claude said after the /remote-control we sent: the text after the last
# line echoing it.
def answer(text: str) -> str | None:
  lines = lines_of(text)
  echoes = [i for i, line in enumerate(lines) if re.fullmatch(r"\s*(❯|>)\s+/remote-control\s*", line)]
  if not echoes:
    return None
  return "\n".join(lines[echoes[-1] + 1:])


# Nothing but blank lines between the echoed command and the prompt box.
def said_nothing(after: str | None) -> bool:
  if after is None:
    return False
  for line in after.splitlines():
    if is_rule(line):
      return True
    if line.strip():
      return False
  return True


def confirming(after: str) -> bool:
  lines = [line.strip() for line in after.splitlines()]
  return any(re.fullmatch(r"(❯|>)\s*1\. Enable Remote Control", line) for line in lines) and any(DECLINE in line for line in lines)


def idle(pane: str) -> bool:
  agent = (herdr("agent", "get", pane) or {}).get("agent") or {}
  return agent.get("agent") == "claude" and agent.get("agent_status") in ("idle", "done")


# ------------------------------------------------------------------ typing


def wait_for(check, seconds: float) -> Any:
  deadline = time.monotonic() + seconds
  while True:
    result = check()
    if result or time.monotonic() >= deadline:
      return result
    time.sleep(min(POLL_SECONDS, 0.5))


def dialog(text: str, phrases: tuple[str, ...]) -> bool:
  tail = "\n".join(lines_of(text)[-15:])
  return all(phrase in tail for phrase in phrases)


# One attempt at a pane that is idle at an empty prompt. Returns "active";
# "not-yet" after dismissing the switching-off dialog with Esc; "silent" when
# the command ran and said nothing, to be confirmed by another attempt; or
# why it stopped. Once anything doesn't look exactly as expected, no further key is
# sent.
def reconnect(pane: str) -> str:
  if subprocess.run(["herdr", "pane", "send-text", pane, COMMAND], capture_output=True, check=False).returncode != 0:
    return "unsent"
  if wait_for(lambda: prompt_input(screen(pane)) == COMMAND, 5) is not True:
    return "untyped"
  # Still idle, still nothing else open: only then is Enter ours to press.
  if not idle(pane):
    return "untyped"
  subprocess.run(["herdr", "pane", "send-keys", pane, "enter"], capture_output=True, check=False)

  def outcome() -> str | None:
    shown = screen(pane)
    if dialog(shown, NOT_YET):
      return "not-yet"
    if dialog(shown, CONNECTED):
      return "connected"
    after = answer(read(pane))
    if after is None:
      return None
    if ACTIVE in after:
      return "active"
    if confirming(after):
      return "confirm"
    return None

  result = wait_for(outcome, ANSWER_SECONDS)
  if result == "confirm":
    subprocess.run(["herdr", "pane", "send-keys", pane, "enter"], capture_output=True, check=False)
    result = wait_for(lambda: "active" if ACTIVE in (answer(read(pane)) or "") else None, ANSWER_SECONDS)
  elif result in ("not-yet", "connected"):
    subprocess.run(["herdr", "pane", "send-keys", pane, "esc"], capture_output=True, check=False)
    if result == "connected":
      result = "active"
  elif result is None and said_nothing(answer(read(pane))) and idle(pane):
    result = "silent"
  return result or "unanswered"


def pane_lock(pane: str):
  runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp")
  handle = open(runtime / f"omarchy-remote-control-{re.sub(r'[^A-Za-z0-9]+', '-', pane)}.lock", "w")
  try:
    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
  except BlockingIOError:
    handle.close()
    return None
  return handle


def run(homes: set[Path]) -> int:
  if not shutil.which("herdr"):
    return 0
  started = time.monotonic()
  pending = {s["pane"]: s | {"seen": None, "tries": 0} for s in sessions(homes)}
  done, failed = [], []
  while pending:
    elapsed = time.monotonic() - started
    for pane, session in list(pending.items()):
      if session["seen"] is None:
        if disconnected(read(pane)):
          session["seen"] = time.monotonic()
        elif elapsed >= NOTICE_SECONDS:
          # No disconnect: this session had no Remote Control to restore.
          del pending[pane]
          continue
      if session["seen"] is None or time.monotonic() - session["seen"] < SETTLE_SECONDS:
        continue
      if elapsed >= TIMEOUT_SECONDS:
        failed.append((session, "busy"))
        del pending[pane]
        continue
      if not idle(pane) or prompt_input(screen(pane)) != "":
        continue
      # Another reconnect run already has this pane; leave it to that one.
      lock = pane_lock(pane)
      if lock is None:
        del pending[pane]
        continue
      with lock:
        # Check again under the lock, right before typing.
        if not disconnected(read(pane)):
          del pending[pane]
          continue
        if not idle(pane) or prompt_input(screen(pane)) != "":
          continue
        result = reconnect(pane)
      if result in ("not-yet", "silent") and session["tries"] < 2:
        # Too soon after all, or connected without saying so: try again, after
        # the settling time if Claude asked for it.
        session["tries"] += 1
        session["seen"] = time.monotonic() - (SETTLE_SECONDS if result == "silent" else 0)
        continue
      del pending[pane]
      (done if result == "active" else failed).append((session, result))
    if pending:
      time.sleep(POLL_SECONDS)

  if done:
    notify(tr("omarchy-i18n agents.remoteControlBack", "Remote Control reconnected"), ", ".join(s["title"] for s, _ in done))
  for session, reason in failed:
    if reason == "busy":
      body = tr("omarchy-i18n agents.remoteControlBusy", "%1 stayed busy. Run /remote-control there to reconnect it.", session["title"])
    else:
      body = tr("omarchy-i18n agents.remoteControlUnexpected", "%1 didn't answer as expected, so nothing more was typed. Check it and run /remote-control there.", session["title"])
    notify(tr("omarchy-i18n agents.remoteControlLost", "Remote Control didn't reconnect"), body)
  return 0 if not failed else 1


def main(argv: list[str]) -> int:
  if not argv:
    print("Usage: omarchy-agent-account-reconnect <home>...", file=sys.stderr)
    return 1
  return run({Path(home).resolve() for home in argv})


if __name__ == "__main__":
  raise SystemExit(main(sys.argv[1:]))

#!/bin/bash

# omarchy:summary=Run Claude, Codex, or Grok as the selected subscription account
# omarchy:args=<claude|codex|grok> [args...]
# omarchy:hidden=true

set -euo pipefail

case "${1:-}" in
  claude) account_env="CLAUDE_CONFIG_DIR" ;;
  codex) account_env="CODEX_HOME" ;;
  grok) account_env="GROK_HOME" ;;
  *)
    echo "Usage: omarchy-agent-account-exec <claude|codex|grok> [args...]" >&2
    exit 1
    ;;
esac

provider=$1
shift

# Pin the resolved home for children, including an implicit Main account.
# Explicit provider homes still take precedence.
if [[ -z ${!account_env:-} ]]; then
  account_home=$(omarchy-agent-account-home "$provider")
  export "OMARCHY_AGENT_${provider^^}_HOME=$account_home"
  if [[ -n $account_home ]]; then
    export "$account_env=$account_home"
  fi
fi

# The real CLI is whatever PATH finds past the dispatchers, the directory this
# was started from. A dispatcher exists only while its CLI is installed, so one
# left by a CLI removed outside Omarchy takes itself away and answers the way
# a shell would.
dispatchers="$HOME/.local/share/omarchy/agent-accounts/bin"
cli_path=""
IFS=: read -r -a dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  [[ $dir == "$dispatchers" ]] || cli_path+="${cli_path:+:}$dir"
done
if ! agent_binary=$(PATH=$cli_path type -P "$provider"); then
  rm -f "$dispatchers/$provider"
  echo "$provider: command not found" >&2
  exit 127
fi

# A mise shim, a link to mise itself, that mise cannot resolve here or that is
# set to the system copy searches PATH, finds this dispatcher again and gives
# up, so run the next CLI past every mise shim.
mise_binary=$(readlink -f "$agent_binary")
if [[ ${mise_binary##*/} == "mise" ]]; then
  version=$(MISE_OFFLINE=1 "$mise_binary" current "$provider" 2>/dev/null || true)
  if [[ $version == "system" ]] || { [[ -z $version ]] && ! MISE_OFFLINE=1 "$mise_binary" which "$provider" >/dev/null 2>&1; }; then
    past_shims=""
    for dir in "${dirs[@]}"; do
      shim_target=$(readlink -f "$dir/$provider" 2>/dev/null || true)
      [[ $dir == "$dispatchers" || ${shim_target##*/} == "mise" ]] || past_shims+="${past_shims:+:}$dir"
    done
    # With nothing past the shims, the shim still runs: mise may fall back to an
    # installed version, and otherwise says to set one.
    if past_binary=$(PATH=$past_shims type -P "$provider"); then
      agent_binary=$past_binary
    fi
  fi
fi

# The agent's own subprocesses dispatch too, so another provider they start
# runs as its selected account.
export PATH="$dispatchers:$cli_path"
exec "$agent_binary" "$@"

#!/bin/bash

# omarchy:summary=Run Claude, Codex, or Grok as the selected subscription account
# omarchy:args=[--binary <path>] <claude|codex|grok> [args...]
# omarchy:hidden=true

set -euo pipefail

# omarchy-agent passes the CLI it already chose, such as the user's own install.
agent_binary=""
if [[ ${1:-} == "--binary" ]]; then
  agent_binary=${2:-}
  shift 2 || true
fi

case "${1:-}" in
  claude) account_env="CLAUDE_CONFIG_DIR" ;;
  codex) account_env="CODEX_HOME" ;;
  grok) account_env="GROK_HOME" ;;
  *)
    echo "Usage: omarchy-agent-account-exec [--binary <path>] <claude|codex|grok> [args...]" >&2
    exit 1
    ;;
esac

provider=$1
shift

# mise removes its wrapper dispatch directories before calling us, and a direct
# call from omarchy-agent looks past them, so exec finds the real CLI (or its
# first-run installer) rather than this wrapper. Resolve before restoring
# dispatch on PATH: the agent's subprocesses need it for other providers.
mise_data_dir=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
lookup_path=:$PATH:
lookup_path=${lookup_path//:$mise_data_dir\/command-wrappers\/bin:/:}
lookup_path=${lookup_path#:}
lookup_path=${lookup_path%:}
if [[ -z $agent_binary ]] && ! agent_binary=$(PATH=$lookup_path; type -P "$provider"); then
  # A mise dispatcher can exist before its CLI or first-run installer does.
  # Omarchy declares these agents, so installing one leaves the user's config
  # alone. A user who removed the preinstalls selects it in their own config.
  export MISE_MINIMUM_RELEASE_AGE=0
  if omarchy-mise-default-tools declares "$provider"; then
    mise install --quiet "$provider"
  else
    mise use -g --quiet "$provider"
  fi
  agent_binary=$(mise which "$provider")
fi
# mise also drops its shims, leaving only the tools installed at launch. A
# long-lived agent needs them back to find tools installed after it started.
PATH="$mise_data_dir/command-wrappers/bin:$PATH"
if [[ :$PATH: != *":$mise_data_dir/shims:"* ]]; then
  PATH="$PATH:$mise_data_dir/shims"
fi
export PATH
account_pin="OMARCHY_AGENT_${provider^^}_HOME"
registry="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/accounts/$provider.json"
if [[ -f $registry || -n ${!account_env:-} || -n ${!account_pin:-} ]]; then
  # Resolve and protect the home together, immediately before the real CLI.
  exec omarchy-agent-account-state exec "$provider" "$agent_binary" "$@"
fi
# No registry and no explicit home: preserve the cheap implicit Main path.
export "$account_pin="
exec "$agent_binary" "$@"

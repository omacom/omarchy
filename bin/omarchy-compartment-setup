#!/bin/bash

# omarchy:summary=Apply host hardening for AI compartments (sysctl, auditd, ufw, usbguard)
# omarchy:hidden=true

# Re-runs safely (idempotent). Installs compartment host configs from
# $OMARCHY_PATH/compartment/host into /etc, expands __HOME__/__COMPARTMENT__.

set -euo pipefail

if [[ ${EUID} -ne 0 ]]; then
  exec sudo env OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}" \
    COMPARTMENT_HOME="$HOME" SUDO_USER_NAME="${SUDO_USER:-$USER}" bash "$0" "$@"
fi

OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
OMARCHY_PATH="${OMARCHY_PATH%/}"
COMP="$OMARCHY_PATH/compartment"
REAL_HOME="${COMPARTMENT_HOME:-/root}"
LEDGER_DIR="/var/lib/omarchy-compartment/ledger"

echo "[1/8] sysctl hardening"
install -m644 "$COMP/host/sysctl/90-compartment-ai.conf" /etc/sysctl.d/90-compartment-ai.conf
sysctl --system >/dev/null 2>&1 || true

echo "[2/8] auditd watchpoints"
pacman -Q audit >/dev/null 2>&1 || pacman -S --noconfirm audit
sed -e "s|__HOME__|$REAL_HOME|g" -e "s|__COMPARTMENT__|$COMP|g" \
  "$COMP/host/audit/compartment-ai.rules" > /etc/audit/rules.d/compartment-ai.rules
chmod 640 /etc/audit/rules.d/compartment-ai.rules
systemctl enable --now auditd 2>/dev/null || true
augenrules --load 2>/dev/null || true

echo "[3/8] AIDE (file integrity) — init DB on first run"
pacman -Q aide >/dev/null 2>&1 || pacman -S --noconfirm aide || echo "install aide manually"

echo "[4/8] usbguard — generates policy from CURRENT devices; review before enabling"
pacman -Q usbguard >/dev/null 2>&1 || pacman -S --noconfirm usbguard || echo "install usbguard manually"
install -m644 "$COMP/host/usbguard/compartment-ai.conf" /etc/usbguard/rules.d/compartment-ai.conf 2>/dev/null || true

echo "[5/8] ufw: deny whonix-int -> host NEW connections"
ufw deny in on virbr-whx comment 'whonix compartments cannot initiate to host' 2>/dev/null || true
ufw allow in on virbr-whx to any port 53 proto udp comment 'dnsmasq for whonix' 2>/dev/null || true
ufw allow in on virbr-whx to any port 67 proto udp comment 'dhcp for whonix' 2>/dev/null || true

echo "[6/8] host-seal.sh (Wazuh AR target) + ledger dir"
install -m755 "$COMP/payload/bin/host-seal.sh" /usr/local/bin/host-seal.sh
install -d -m755 /var/lib/omarchy-compartment
if [ -n "${SUDO_USER_NAME:-}" ] && [ "$SUDO_USER_NAME" != "root" ]; then
  install -d -m755 -o "$SUDO_USER_NAME" -g "$SUDO_USER_NAME" "$LEDGER_DIR"
else
  install -d -m755 "$LEDGER_DIR"
fi

echo "[7/8] AppArmor — REQUIRES BOOT PARAM; add 'lsm=landlock,lockdown,yama,integrity,apparmor,bpf' to kernel cmdline, then enable:"
echo "    sudo systemctl enable --now apparmor; sudo aa-status"
pacman -Q apparmor >/dev/null 2>&1 || pacman -S --noconfirm apparmor || true

echo "[8/8] wazuh-agent AR snippets (merge manually if wazuh-agent installed)"
# host/wazuh/ossec-ar-snippets.conf is reference config — see docs/compartments.md

echo "done. Remaining manual steps in docs/compartments.md"

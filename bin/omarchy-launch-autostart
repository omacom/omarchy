#!/bin/bash

# omarchy:summary=Launch an autostart app once the shell's notification service is on the bus
# omarchy:hidden=true

# Autostart apps fire on hyprland.start, the same event that launches the shell,
# and the shell needs a few seconds before it claims org.freedesktop.Notifications.
# Apps that probe for that name once at process start (Chromium and every web
# app, Electron) keep a missing answer for their whole lifetime: Chromium draws
# its own bare popup windows for the rest of the session. Wait for the name,
# bounded, before the launch.
#
# --activate starts a D-Bus-activatable daemon (mako, dunst, swaync all ship a
# service file for this name) for someone who turned the shell's plugin off;
# when the shell owns the name it changes nothing, and when nothing is
# activatable the wait runs out as usual.
#
# Past the deadline the app launches anyway: a disabled notifications plugin
# must cost a delay, never a missing app. Leave one journal line saying why
# login was slower, so the wait can be traced back to the missing service.
#
# Only correct at session start. Keybind launches go through o.launch directly.
# A daemon that will claim the name itself must not go through here or it waits
# for itself; autostart it with o.exec_on_start(o.launch(...)).

timeout=15
name=org.freedesktop.Notifications

if ! gdbus wait --session --activate --timeout "$timeout" "$name" >/dev/null 2>&1; then
  logger -t omarchy-autostart "$name was not available after waiting up to ${timeout}s; launching $1 without it."
fi

exec uwsm-app -- "$@"

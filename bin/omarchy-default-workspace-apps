
#!/bin/bash
# omarchy:summary=Configure default apps assigned to workspaces

set -euo pipefail

CONF="$HOME/.config/omarchy/workspace-apps.conf"
mkdir -p "$(dirname "$CONF")"
touch "$CONF"

# SUPER+0 maps to workspace 10 by default in Omarchy.
display_to_internal() { [[ $1 == 0 ]] && echo 10 || echo "$1"; }
internal_to_display() { [[ $1 == 10 ]] && echo 0 || echo "$1"; }

current_label_for() {
  awk -F '\t' -v ws="$1" '$1 == ws { print $2; exit }' "$CONF"
}

remove_ws_line() {
  awk -F '\t' -v ws="$1" '$1 != ws' "$CONF" > "$CONF.tmp"
  mv "$CONF.tmp" "$CONF"
}

# Show installed desktop applications by name and desktop-file path.
list_desktop_apps() {
  local dirs=(
    /usr/share/applications
    /usr/local/share/applications
    /var/lib/flatpak/exports/share/applications
    "$HOME/.local/share/applications"
    "$HOME/.local/share/flatpak/exports/share/applications"
  )

  local dir f name

  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue

    for f in "$dir"/*.desktop; do
      [[ -f $f ]] || continue
      grep -q '^NoDisplay=true' "$f" && continue
      grep -q '^Hidden=true' "$f" && continue

      name=$(sed -n 's/^Name=//p' "$f" | head -n 1)
      [[ -n $name ]] || continue

      printf '\t%s\t%s\n' "$name" "$f"
    done
  done | sort -u -t $'\t' -k3,3
}

# 1. Pick a workspace.
rows=""

for n in 1 2 3 4 5 6 7 8 9 0; do
  internal=$(display_to_internal "$n")
  current=$(current_label_for "$internal")
  label="Workspace $n"

  [[ -n $current ]] && label="$label  —  currently: $current"
  rows+=$'\t'"$label"$'\t'"$internal"$'\n'
done

selection=$(omarchy-menu-select "Set app for workspace" <<< "$rows") || exit 0
ws=$(cut -f2 <<< "$selection")
display=$(internal_to_display "$ws")

# 2. Choose what to launch.
action=$(omarchy-menu-select "Workspace $display" \
  "Pick an installed app" \
  "Enter a website URL" \
  "Clear this workspace") || exit 0

case "$action" in
  "Clear this workspace")
    remove_ws_line "$ws"
    omarchy-notification-send -u low "Workspace $display cleared"
    exit 0
    ;;

  "Pick an installed app")
    app_selection=$(omarchy-menu-select "Choose an app" <<< "$(list_desktop_apps)") || exit 0
    label=$(cut -f1 <<< "$app_selection")
    target=$(cut -f2 <<< "$app_selection")
    [[ -f $target && $target == *.desktop ]] || exit 0
    launch_type="app"
    ;;

  "Enter a website URL")
    url=$(omarchy-menu-input "Website URL (e.g. https://chatgpt.com)") || exit 0
    [[ -n $url ]] || exit 0

    if [[ ! $url =~ ^https?://[^[:space:]]+$ ]]; then
      omarchy-notification-send -u low "Enter a valid http:// or https:// URL"
      exit 0
    fi

    label=$(omarchy-menu-input "Label for this shortcut") || true
    [[ -n $label ]] || label="$url"

    launch_type="web"
    target="$url"
    ;;

  *)
    exit 0
    ;;
esac

# 3. Save structured data, never a shell command string.
remove_ws_line "$ws"
printf '%s\t%s\t%s\t%s\n' \
  "$ws" "$label" "$launch_type" "$target" >> "$CONF"

sort -t $'\t' -k1,1n -o "$CONF" "$CONF"
omarchy-notification-send -u low "Workspace $display → $label"

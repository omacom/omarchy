#!/bin/bash

# omarchy:summary=Sync the generated Omarchy theme to running Slack windows
# omarchy:hidden=true

set -euo pipefail

state="$HOME/.local/state/omarchy/slack"
theme="$HOME/.local/state/omarchy/current/theme/slack.json"
[[ -f $state/enabled && -f $theme ]] || exit 0

pending=$(mktemp "$state/theme.XXXXXX")
trap 'rm -f "$pending"' EXIT
if jq -e 'select(.mode == "light" or .mode == "dark") |
  select([.background, .accent, .green, .red] | all(type == "string" and test("^#[0-9a-fA-F]{6}$"))) |
  {mode, background, accent, green, red}' "$theme" >"$pending"; then
  mv "$pending" "$state/theme.json"
else
  echo "Skipping invalid Slack theme." >&2
fi

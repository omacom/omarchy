#!/bin/bash

# omarchy:summary=Ask for an encrypted drive's password in the shell and unlock it
# omarchy:args=<device>
# omarchy:hidden=true

# Invoked by omarchy-drive-automount when an external LUKS drive appears. The
# shell asks for the password and unlocks the drive itself, so a wrong password
# shakes the card and is asked again, and omarchy-drive-automount mounts the
# cleartext volume as it appears unlocked.

device=${1:?Usage: omarchy-drive-unlock <device>}
disk=$(lsblk -dno PKNAME "$device")
name=$(lsblk -dno LABEL "$device")
[[ -n $name ]] || name=$(lsblk -dno MODEL "/dev/${disk:-${device#/dev/}}" | sed 's/ *$//')
size=$(lsblk -dno SIZE "$device" | tr -d ' ')

omarchy-shell -q omarchy.polkit unlockDrive "$device" "${name:+$name · }$size"

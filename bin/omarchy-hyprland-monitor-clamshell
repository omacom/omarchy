#!/bin/bash

# omarchy:summary=Apply clamshell display state to Hyprland monitors
# omarchy:hidden=true

TOGGLES_DIR="$HOME/.local/state/omarchy/toggles/hypr"
CLAMSHELL_FLAG="$TOGGLES_DIR/internal-monitor-clamshell.lua"
MANUAL_DISABLE_FLAG="$TOGGLES_DIR/internal-monitor-disable.lua"
SCALE_STATE="$TOGGLES_DIR/internal-monitor-scale"
POSITION_PENDING="$TOGGLES_DIR/internal-monitor-position-pending"
POSITION_STATE="$TOGGLES_DIR/internal-monitor-position"
POSITION_FLAG="$TOGGLES_DIR/internal-monitor-position.lua"
POSITION_LAYOUT="$TOGGLES_DIR/internal-monitor-layout"
MONITOR_LUA="$HOME/.config/hypr/monitors.lua"

# Lid bindings, wake recovery and the watcher can reconcile at the same time.
# Lock here so every caller shares the same capture/reload/restore transaction.
mkdir -p "$TOGGLES_DIR"
exec 8>"$TOGGLES_DIR/internal-monitor-clamshell.lock"
flock 8

INTERNAL=$(omarchy-hyprland-monitor-laptop)

# INTERNAL is written into generated Lua and hyprctl eval/dispatch below, so a
# name that is not a plain connector string could execute on the next reload.
# Names come from hyprctl; a user-created headless output can carry anything.
if [[ -n $INTERNAL && ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "Refusing unsafe internal monitor name" >&2
  exit 1
fi

valid_scale() {
  [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]]
}

scales_match() {
  local left="$1"
  local right="$2"

  valid_scale "$left" && valid_scale "$right" || return 1
  awk -v left="$left" -v right="$right" 'BEGIN {
    diff = left - right
    if (diff < 0) diff = -diff
    exit(diff < 0.001 ? 0 : 1)
  }'
}

lua_identifier() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]
}

# Value assigned by `local <name> = ...`, without its quotes or trailing comment.
# Only a lone scalar counts: an expression like `1080 / 720` must stay unresolved
# so the caller falls back rather than applying the first half of the sum.
lua_local_value() {
  local name="$1" value
  lua_identifier "$name" && [[ -f $MONITOR_LUA ]] || return 0

  value=$(sed -nE 's/^[[:space:]]*local[[:space:]]+'"$name"'[[:space:]]*=[[:space:]]*("[^"]*"|[^"[:space:]]+)[[:space:]]*(--.*)?$/\1/p' "$MONITOR_LUA" | head -1)
  [[ $value == \"*\" ]] && value="${value:1:-1}"
  printf '%s\n' "$value"
}

# A quoted capture is a Lua string and stands for itself; a bare word may instead
# name a local the rule refers to, as the shipped scale = omarchy_monitor_scale
# does. A bare word naming no local is left alone to fail validation.
lua_scalar() {
  local value="$1" resolved

  if [[ $value == \"*\" ]]; then
    printf '%s\n' "${value:1:-1}"
    return
  fi

  resolved=$(lua_local_value "$value")
  printf '%s\n' "${resolved:-$value}"
}

# The config with its comments cut away, so commented-out text can pose neither
# as a rule nor as one of its keys.
monitor_rules() {
  [[ -f $MONITOR_LUA ]] || return 0

  sed -E -e 's/--\[\[[^]]*\]\]//g' -e 's/--.*$//' "$MONITOR_LUA"
}

monitor_rule_regex() {
  printf '^[[:space:]]*hl\\.monitor\\(\\{.*output[[:space:]]*=[[:space:]]*"%s"' "$1"
}

# A key is preceded by a table separator, so a longer key cannot stand in for it,
# and its value is the whole of what sits between the `=` and the next separator.
# Anything else is an expression this cannot evaluate.
configured_monitor_value() {
  local output="$1" key="$2" value

  value=$(monitor_rules | sed -nE '/'"$(monitor_rule_regex "$output")"'/s/.*[{,;[:space:]]'"$key"'[[:space:]]*=[[:space:]]*("[^"]*"|[^,;}[:space:]]+)[[:space:]]*([,;}].*)?$/\1/p' | head -1)
  lua_scalar "$value"
}

configured_internal_monitor_value() {
  [[ -n $INTERNAL ]] || return 0

  configured_monitor_value "$INTERNAL" "$1"
}

configured_monitor_scale() {
  local scale
  scale=$(configured_internal_monitor_value scale)
  # An internal rule that names a scale settles it, even when the name resolves
  # to nothing usable. Only a rule that names none at all defers to the catch-all,
  # which is the scale Omarchy has always applied for that config.
  [[ -n $scale ]] || scale=$(configured_monitor_value "" scale)
  # No rule carries a scale at all: fall back to Omarchy's own knob.
  [[ -n $scale ]] || scale=$(lua_local_value omarchy_monitor_scale)

  printf '%s\n' "$scale"
}

current_internal_scale() {
  [[ -n $INTERNAL ]] || return 0
  hyprctl monitors all -j | jq -r --arg internal "$INTERNAL" '.[] | select(.name == $internal and .disabled != true) | .scale' | head -1
}

# Hyprland's FALLBACK stands in once nothing is left, so it is not somewhere to
# run; a headless output is, and is invisible to the DRM check.
other_output_enabled() {
  hyprctl monitors all -j | jq -e --arg internal "$INTERNAL" 'any(.[]; .name != $internal and .name != "FALLBACK" and .disabled == false)' >/dev/null 2>&1
}

store_internal_scale() {
  local scale="$1"
  valid_scale "$scale" || return 0

  mkdir -p "$TOGGLES_DIR"
  printf '%s\n' "$scale" >"$SCALE_STATE"
}

remember_internal_scale() {
  local scale
  scale=$(current_internal_scale)
  store_internal_scale "$scale"
}

current_internal_position() {
  [[ -n $INTERNAL ]] || return 0
  hyprctl monitors all -j | jq -r --arg internal "$INTERNAL" '.[] | select(.name == $internal and .disabled != true) | "\(.x)x\(.y)"' | head -1
}

# Whether the panel, put at $1, would stay clear of every enabled external.
# $2 is the scale to measure it at, when it is not the panel's current one.
# Sizes are in layout pixels: the mode divided by the scale, with width and
# height swapped for a transform that rotates by a quarter turn. A live scale is
# rounded, since 5/3 is reported as a float a hair past the edge; a requested
# one is not, since Hyprland may still snap it larger.
internal_fits_at() {
  [[ -n $INTERNAL ]] || return 1

  hyprctl monitors all -j | jq -e --arg internal "$INTERNAL" --arg position "$1" --argjson scale "${2:-null}" '
    def size: if (.transform // 0) % 2 == 1 then [.height, .width] else [.width, .height] end;
    . as $all
    | ($position | split("x") | map(tonumber)) as [$x, $y]
    | ([$all[] | select(.name == $internal and .disabled != true)] | .[0]) as $panel
    | $panel != null
    and ($panel | size
      | if $scale then map(. / $scale) else map(. / $panel.scale | round) end as [$pw, $ph]
      | [$all[] | select(.name != $internal and .disabled != true) | size as [$w, $h]
        | select($x < .x + ($w / .scale | round) and .x < $x + $pw and $y < .y + ($h / .scale | round) and .y < $y + $ph)]
      | length == 0)' >/dev/null 2>&1
}

# Capture every enabled output before disabling the panel. Restoring the same
# absolute arrangement needs no anchor, including for identical externals.
remember_internal_position() {
  local monitors temporary
  monitors=$(hyprctl monitors all -j | jq -er --arg internal "$INTERNAL" '
    [.[] | select(.disabled != true)]
    | select(length > 1 and length <= 64 and any(.[]; .name == $internal))
    | select(all(.[];
        (.name | test("^[A-Za-z0-9._-]+$")) and
        all(.width, .height, .scale, (.transform // 0), .x, .y, .refreshRate; type == "number") and
        (.x | floor) == .x and (.y | floor) == .y))
    | sort_by(.name == $internal)') || return 0

  temporary=$(mktemp "$TOGGLES_DIR/.internal-monitor-position.XXXXXX") || return 0
  if ! {
    printf '2\n%s\n%s\n' "$INTERNAL" "$(jq 'length' <<<"$monitors")"
    jq -r '.[] | [.name, ((.serial // "") | gsub("[^A-Za-z0-9._:-]"; "_")),
      ((.description // "") | gsub("[^A-Za-z0-9._:-]"; "_")),
      .width, .height, .scale, (.transform // 0), .x, .y, .refreshRate] | map(tostring) | join("\t")' <<<"$monitors"
    cat "$MONITOR_LUA"
  } >"$temporary" || ! mv "$temporary" "$POSITION_PENDING"; then
    rm -f "$temporary"
  fi
}

position_config_matches() {
  local version internal count
  [[ -f $POSITION_LAYOUT ]] || return 1
  { read -r version; read -r internal; read -r count; } <"$POSITION_LAYOUT" 2>/dev/null || return 1
  [[ $version == "2" && $internal == "$INTERNAL" && $count =~ ^[1-9][0-9]?$ ]] && (( count >= 2 && count <= 64 )) || return 1
  cmp -s "$MONITOR_LUA" <(tail -n "+$((count + 4))" "$POSITION_LAYOUT")
}

# $1 is the configured scale when the caller has already read it, so one sync
# does not parse the config twice.
read_monitor_scale() {
  local scale

  if (( $# )); then
    scale="$1"
  else
    scale=$(configured_monitor_scale)
  fi

  if valid_scale "$scale"; then
    echo "$scale"
    return
  fi

  if [[ -f $SCALE_STATE ]]; then
    scale=$(<"$SCALE_STATE")
    if valid_scale "$scale"; then
      echo "$scale"
      return
    fi
  fi

  echo 2
}

read_monitor_position() {
  local position
  position=$(configured_internal_monitor_value position)
  if [[ $position =~ ^[-[:alnum:]_.+]+$ ]]; then
    echo "$position"
    return
  fi

  echo auto
}

apply_internal_output() {
  local enable=""
  # Preserve the Display panel's runtime disable while another output is
  # available, but recover the panel after the last external is unplugged.
  omarchy-hw-external-monitors || other_output_enabled || enable="disabled = false, "
  # A new per-output rule does not inherit the catch-all's mode or transform.
  # Carry the enabled panel's values so the fit check measures what we apply.
  hyprctl eval "local panel = hl.get_monitor(\"$INTERNAL\")
    hl.monitor({ output = \"$INTERNAL\", ${enable}position = \"$1\", scale = $2,
      mode = panel and string.format(\"%dx%d@%.5f\", panel.width, panel.height, panel.refresh_rate) or \"preferred\",
      transform = panel and panel.transform })" >/dev/null 2>&1 || true
}

enable_internal_output() {
  [[ -n $INTERNAL ]] || return 0
  local scale="${1:-}"
  local position preserve_position=0
  [[ -n $scale ]] || scale=$(read_monitor_scale)
  position=$(read_monitor_position)
  # A panel that is already on holds a place of its own. Re-applying it with
  # "auto" would send it to the end of the layout, so a scale correction keeps
  # it where it is.
  # The same scale change can widen it into a neighbor, though, and then
  # "auto" is the safer place.
  if [[ $position == "auto" ]]; then
    position=$(current_internal_position)
    if internal_fits_at "$position" "$scale"; then
      preserve_position=1
    else
      position=auto
    fi
  fi
  apply_internal_output "$position" "$scale"
  # A requested scale can snap to a smaller value and grow the panel. Check
  # the compositor's applied geometry instead of duplicating its scale rules.
  if (( preserve_position )) && ! internal_fits_at "$position"; then
    apply_internal_output auto "$scale"
  fi
}

sync_internal_scale() {
  [[ -n $INTERNAL ]] || return 0
  local configured_scale
  local desired_scale
  local active_scale

  configured_scale=$(configured_monitor_scale)
  active_scale=$(current_internal_scale)

  # A config without a usable number -- the default "auto", or an expression
  # only Hyprland's Lua can evaluate -- delegates the scale to the compositor,
  # so whatever it resolved for the enabled panel IS the configured scale.
  # There is no number to correct it toward: substituting one makes the scale
  # flap between that number and the compositor's own value on every idle-wake.
  # Only a panel that is off altogether still gets a hand below, from the
  # remembered scale.
  if ! valid_scale "$configured_scale" && valid_scale "$active_scale"; then
    return 0
  fi

  desired_scale=$(read_monitor_scale "$configured_scale")
  scales_match "$active_scale" "$desired_scale" && return 0

  enable_internal_output "$desired_scale"
}

# The fixed toggle validates the captured config and outputs before its first
# application, then requires their positions to match on subsequent reloads.
restore_internal_position() {
  [[ -n $INTERNAL && -f $POSITION_PENDING ]] || return 0
  if [[ $(read_monitor_position) != "auto" ]]; then
    rm -f "$POSITION_PENDING"
    return 0
  fi

  local temporary
  temporary=$(mktemp "$TOGGLES_DIR/.internal-monitor-position.XXXXXX") || return 0
  # An old toggle can run during capture. Only arm the snapshot after the
  # clamshell reload and scale sync, when it is ready to be restored.
  if cp "$OMARCHY_PATH/default/hypr/toggles/internal-monitor-position.lua" "$temporary" &&
    mv "$POSITION_PENDING" "$POSITION_STATE" && mv "$temporary" "$POSITION_FLAG"; then
    hyprctl eval 'dofile(os.getenv("HOME") .. "/.local/state/omarchy/toggles/hypr/internal-monitor-position.lua")' >/dev/null 2>&1 || true
  else
    rm -f "$temporary"
  fi
}

dpms_internal() {
  local action="$1"

  [[ -n $INTERNAL ]] || return 0
  hyprctl dispatch "hl.dsp.dpms({ action = \"$action\", monitor = \"$INTERNAL\" })" >/dev/null 2>&1 || true
}

enable_internal() {
  local changed=0 reload=0

  if [[ -f $POSITION_FLAG ]] && ! position_config_matches; then
    rm -f "$POSITION_FLAG" "$POSITION_LAYOUT"
    reload=1
  fi

  if [[ -f $CLAMSHELL_FLAG ]]; then
    rm -f "$CLAMSHELL_FLAG" "$POSITION_FLAG" "$POSITION_LAYOUT" "$POSITION_STATE"
    changed=1
    reload=1
  fi

  if (( reload )); then
    hyprctl reload >/dev/null 2>&1 || true
  fi

  [[ -f $MANUAL_DISABLE_FLAG ]] && omarchy-hyprland-monitor-external-active && return 0
  sync_internal_scale

  if (( changed )); then
    restore_internal_position
    dpms_internal enable
  fi
}

disable_internal() {
  [[ -n $INTERNAL ]] || exit 0
  [[ -f $MANUAL_DISABLE_FLAG ]] && return 0

  local config
  config=$(printf 'hl.monitor({ output = "%s", disabled = true })' "$INTERNAL")

  if [[ ! -f $CLAMSHELL_FLAG ]] || [[ $(< "$CLAMSHELL_FLAG") != $config ]]; then
    remember_internal_scale
    remember_internal_position
    rm -f "$POSITION_FLAG" "$POSITION_LAYOUT" "$POSITION_STATE"
    printf '%s\n' "$config" >"$CLAMSHELL_FLAG"
    hyprctl reload >/dev/null 2>&1 || true
  fi
}

omarchy-hyprland-monitor-internal recover >/dev/null 2>&1 || true
omarchy-hyprland-monitor-internal-mirror recover >/dev/null 2>&1 || true

if omarchy-hw-clamshell && omarchy-hyprland-monitor-external-active; then
  disable_internal
else
  enable_internal
fi

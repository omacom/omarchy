#!/bin/bash

# omarchy:summary=Show an installed bundle's introduction
# omarchy:group=bundle
# omarchy:args=<id>

set -euo pipefail

BUNDLE_CMD=omarchy-bundle-introduction
# shellcheck source=omarchy-bundle-lib
source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/omarchy-bundle-lib"

id=""
while (( $# > 0 )); do
  case "$1" in
  --)
    shift
    ;;
  -h | --help)
    echo "Usage: omarchy bundle introduction <id>"
    exit 0
    ;;
  -*)
    bundle_fail "unknown introduction option: $1"
    ;;
  *)
    [[ -z $id ]] || bundle_fail "unexpected argument: $1"
    id="$1"
    shift
    ;;
  esac
done

[[ -n $id ]] || bundle_fail "a bundle id is required"
bundle_valid_id "$id" || bundle_fail "invalid bundle id '$id'"

dest="$(bundle_data_root)/$id"
manifest="$dest/bundle.json"
[[ -f $manifest ]] || bundle_fail "bundle '$id' is not installed"

introduction=$(jq -r 'if has("introduction") then .introduction else "" end' "$manifest")
[[ -n $introduction ]] || bundle_fail "bundle '$id' has no introduction"
bundle_safe_rel "$introduction" || bundle_fail "introduction path must be a safe relative path: '$introduction'"

dest_real=$(realpath -- "$dest")
file="$dest/$introduction"
[[ -f $file ]] || bundle_fail "introduction file not found: '$introduction'"
file_real=$(realpath -- "$file")
[[ $file_real == "$dest_real"/* ]] || bundle_fail "introduction path leaves the bundle: '$introduction'"

hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1 || true
}

float_introduction() {
  local before now addr floating window attempt
  before=$(hyprctl clients -j 2>/dev/null || true)
  [[ -n $before ]] || before='[]'
  setsid -f omawrite "$file_real" >/dev/null 2>&1 || bundle_fail "could not open $file_real in omawrite"
  for (( attempt = 0; attempt < 40; attempt++ )); do
    now=$(hyprctl clients -j 2>/dev/null || true)
    [[ -n $now ]] || now='[]'
    addr=$(jq -nr --argjson before "$before" --argjson now "$now" '
      ($before | map(.address)) as $seen
      | [$now[] | select(.class == "omawrite") | select(.address as $a | $seen | index($a) | not) | .address]
      | first // empty
    ' || true)
    [[ -n $addr ]] && break
    sleep 0.05
  done
  [[ -n $addr ]] || return 0
  floating=$(jq -nr --argjson now "$now" --arg addr "$addr" '
    [$now[] | select(.address == $addr) | .floating] | first // false
  ' || true)
  window="address:$addr"
  if [[ $floating != "true" ]]; then
    hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"toggle\" })" togglefloating "$window"
  fi
  hypr_dispatch "hl.dsp.window.resize({ window = \"$window\", x = 1100, y = 780 })" resizewindowpixel "exact 1100 780,$window"
  hypr_dispatch "hl.dsp.window.center({ window = \"$window\" })" centerwindow "$window"
  hypr_dispatch "hl.dsp.focus({ window = \"$window\" })" focuswindow "$window"
}

float_introduction

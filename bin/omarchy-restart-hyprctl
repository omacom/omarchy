#!/bin/bash

# omarchy:summary=Reload hyprland configuration (used by the Omarchy theme switching).

# Outside the session (ssh, a remotely started herdr) there is no instance
# signature, so reach the running Hyprland directly.
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null
else
  hyprctl --instance 0 reload >/dev/null
fi

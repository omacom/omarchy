#!/bin/bash

# omarchy:summary=Reboot after closing application windows
# omarchy:examples=omarchy reboot | omarchy system reboot
# omarchy:aliases=omarchy reboot

# Close apps and reboot from the user manager, so neither closing the
# terminal's systemd scope nor a caller's timeout can stop it midway. The fixed
# unit name keeps a second press from starting a parallel run.
systemd-run --user --collect --quiet --unit=omarchy-system-exit "$OMARCHY_PATH/bin/omarchy-system-exit" reboot

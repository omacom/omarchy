#!/bin/bash

# omarchy:summary=Remove the ChatGPT desktop app along with its configuration and caches.
# omarchy:requires-sudo=true

set -e

while (( $# > 0 )); do
  case "$1" in
  -h | --help | help)
    echo "Usage: omarchy-remove-ai-chatgpt"
    echo
    echo "Remove the ChatGPT desktop app along with its configuration and caches."
    exit 0
    ;;
  *)
    echo "omarchy-remove-ai-chatgpt: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
  shift
done

# The app rewrites ~/.config/Codex for as long as it runs, so a removal that
# leaves it running deletes the directory and watches it come straight back.
pkill -x ChatGPT || true

omarchy-pkg-drop openai-codex-desktop

# Not ~/.cache/codex-runtimes: the Codex CLI resolves its own runtime under
# there, and it ships in a different package that survives this one.
rm -rf \
  "$HOME/.config/Codex" \
  "$HOME/.cache/Codex"

echo ""
echo "ChatGPT has been removed."

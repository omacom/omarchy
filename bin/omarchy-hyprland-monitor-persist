#!/bin/bash

# omarchy:summary=Save a monitor's scale, and optionally its mode and position, for that monitor
# omarchy:args=OUTPUT SCALE [MODE] [POSITION]
# omarchy:hidden=true

# Saves the settings by the physical monitor rather than its connector, since a
# dock renames connectors between plugs: one line per monitor in
# $XDG_STATE_HOME/omarchy/monitors/settings, which default/hypr/monitor-settings.lua
# applies whenever the config loads or the monitor arrives. An empty MODE or
# POSITION keeps the saved one. hypr/monitors.lua is the user's and is never
# written here.

output="${1:-}"
scale="${2:-}"
mode="${3:-}"
position="${4:-}"

if [[ -z $output || -z $scale ]]; then
  echo "Usage: omarchy-hyprland-monitor-persist OUTPUT SCALE [MODE] [POSITION]" >&2
  exit 1
fi

# The file is read back as config, so a value out of place would leave the
# monitor misconfigured on every load.
if [[ ! $output =~ ^[A-Za-z0-9._-]+$ || ! $scale =~ ^[0-9]+([.][0-9]+)?$ ]] ||
  [[ -n $mode && ! $mode =~ ^[0-9]+x[0-9]+(@[0-9.]+)?$ ]] ||
  [[ -n $position && ! $position =~ ^-?[0-9]+x-?[0-9]+$ ]]; then
  echo "Refusing to save an unsafe monitor setting: $*" >&2
  exit 1
fi

settings="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/monitors/settings"
identity=$(omarchy-hyprland-monitor-identity "$output")

mkdir -p "${settings%/*}"
touch "$settings"
tmp=$(mktemp "$settings.XXXXXX")
awk -F'\t' -v OFS='\t' -v identity="$identity" -v mode="$mode" -v position="$position" -v scale="$scale" '
  $4 == identity {
    if (mode == "") mode = $1
    if (position == "") position = $2
    next
  }
  { print }
  END { print mode, position, scale, identity }
' "$settings" >"$tmp"
mv "$tmp" "$settings"

# The running session already shows the change; this brings GDK_SCALE up to
# date for apps launched from here on. Only this monitor's settings are
# replayed, and those it already runs: a layout saves its monitors one at a
# time, and replaying another's older saved position would pull it back.
hyprctl eval 'if o.monitor_settings then o.monitor_settings.apply(false, "'"$output"'") end' >/dev/null 2>&1 || true

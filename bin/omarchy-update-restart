#!/bin/bash

# omarchy:summary=Prompt for required reboot or service restarts after updates
# omarchy:args=[--services-only|--reboot-only]

kernel_modules_path="${OMARCHY_KERNEL_MODULES_PATH:-/usr/lib/modules}"
proc_root="${OMARCHY_PROC_ROOT:-/proc}"
systemctl_bin="${SYSTEMCTL:-systemctl}"

# A package upgrade unlinks the running binary. systemctl still reports the
# old process as active, and its MainPID's exe link ends in " (deleted)".
restart_replaced_user_service() {
  local unit="$1"
  local pid exe

  pid=$("$systemctl_bin" --user show -p MainPID --value "$unit" 2>/dev/null || true)
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 0
  exe=$(readlink "$proc_root/$pid/exe" 2>/dev/null || true)
  if [[ $exe == *"(deleted)"* ]]; then
    echo "Restarting $unit"
    "$systemctl_bin" --user restart "$unit" || true
  fi
}

mode="${1:-all}"
case "$mode" in
  all|--services-only|--reboot-only) ;;
  *) echo "Unknown restart phase: $mode" >&2; exit 2 ;;
esac

echo
confirm_reboot() {
  if [[ ${OMARCHY_UPDATE_UNATTENDED:-0} == "1" ]]; then
    echo "$1 Run omarchy-system reboot when ready."
  elif gum confirm --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$1"; then
    omarchy-system reboot
    exit 0
  fi
}

if [[ $mode != "--services-only" ]]; then
  running_kernel=$(uname -r)
  kernel_updated=true

  # Every kernel package owns modules.builtin; Arch Linux ARM's ships no vmlinuz here (#12440).
  for kernel in "$kernel_modules_path"/*/modules.builtin; do
    if [[ -f $kernel ]] && pacman -Qo "$kernel" &>/dev/null; then
      installed_kernel=$(basename "$(dirname "$kernel")")

      if [[ $installed_kernel == $running_kernel ]]; then
        kernel_updated=false
        break
      fi
    fi
  done

  if [[ $kernel_updated == "true" ]]; then
    confirm_reboot "$(omarchy-i18n update.kernelReboot)"
  elif [[ -f $HOME/.local/state/omarchy/reboot-required ]]; then
    confirm_reboot "$(omarchy-i18n update.rebootRequired)"
  fi

  running_hyprland=$(readlink /proc/$(pgrep -x Hyprland)/exe 2>/dev/null)
  if [[ $running_hyprland == *"(deleted)"* ]]; then
    confirm_reboot "$(omarchy-i18n update.hyprlandReboot)"
  fi
fi

if [[ $mode != "--reboot-only" ]]; then
  for file in "$HOME"/.local/state/omarchy/restart-*-required; do
    if [[ -f $file ]]; then
      filename=$(basename "$file")
      service=$(echo "$filename" | sed 's/restart-\(.*\)-required/\1/')
      echo "Restarting $service"
      omarchy-state clear "$filename"
      omarchy-restart-"$service"
    fi
  done

  # Updates routinely replace the shell's QML, and a stale process can lazy-load
  # new files into old code. A restart failure (locked session, ssh, TTY) only
  # prints its reason: the next update or login gets a fresh shell anyway.
  # The desktop portal is the same kind of long-lived process. Replacing its
  # binary and then starting a new shell leaves the shell unable to register,
  # so panels stay dead until the next login. Restart a replaced portal first.
  restart_replaced_user_service xdg-desktop-portal-hyprland.service
  restart_replaced_user_service xdg-desktop-portal.service
  echo -e "\e[32m\nRestarting shell\e[0m"
  echo "All plugins have been reloaded"
  omarchy-restart-shell || true
fi

#!/bin/bash

# omarchy:summary=Remove an installed theme or hide a bundled theme
# omarchy:args=[--restore] [theme-name]
# omarchy:examples=omarchy theme remove "My Theme"

THEMES_DIR="$HOME/.config/omarchy/themes"
STOCK_DIR="$OMARCHY_PATH/themes"
HIDDEN_DIR="$HOME/.config/omarchy/hidden-themes"
RESTORE=false

if [[ $1 == "--restore" ]]; then
  RESTORE=true
  shift
fi

if (( $# > 1 )); then
  echo "Usage: omarchy-theme-remove [--restore] [theme-name]" >&2
  exit 1
fi

if [[ -z $1 ]]; then
  if [[ $RESTORE == "true" ]]; then
    TITLE=$(omarchy-i18n theme.restoreBundledTitle)
    mapfile -t THEMES < <(find "$HIDDEN_DIR" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' 2>/dev/null | sort)
  else
    TITLE=$(omarchy-i18n theme.removeTitle)
    mapfile -t THEMES < <(
      {
        find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null
        find "$STOCK_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
      } | sort -u | while IFS= read -r name; do
        [[ -f $HIDDEN_DIR/$name ]] || printf '%s\n' "$name"
      done
    )
  fi
  if (( ${#THEMES[@]} == 0 )); then
    echo "No matching themes."
    exit 1
  fi
  THEME_NAME=$(omarchy-menu-select "$TITLE" "${THEMES[@]}" -- --width 520 --maxheight 520) || exit $?
else
  THEME_NAME="$1"
fi

# The name omarchy-theme-list shows (My Theme) finds its folder (my-theme) when no folder has that exact name.
if [[ ! -d $THEMES_DIR/$THEME_NAME && ! -d $OMARCHY_PATH/themes/$THEME_NAME ]]; then
  THEME_NAME=$(echo "$THEME_NAME" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
fi
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Ensure a theme was set, and that the name cannot climb out of THEMES_DIR
# on its way into the rm below.
if [[ -z $THEME_NAME || $THEME_NAME == .* || $THEME_NAME == */* ]]; then
  exit 1
fi

if [[ $RESTORE == "true" ]]; then
  if [[ ! -f $HIDDEN_DIR/$THEME_NAME ]]; then
    echo "Error: Theme '$THEME_NAME' is not hidden." >&2
    exit 1
  fi
  rm -- "$HIDDEN_DIR/$THEME_NAME" || exit 1
  echo "Restored $THEME_NAME"
elif [[ -d $STOCK_DIR/$THEME_NAME ]]; then
  mkdir -p "$HIDDEN_DIR" && touch -- "$HIDDEN_DIR/$THEME_NAME" || exit 1
  omarchy-notification-send "$(omarchy-i18n theme.hidden)" "$THEME_NAME" || true
  echo "Hidden $THEME_NAME"
elif [[ -d $THEME_PATH ]]; then
  rm -rf -- "$THEME_PATH" || exit 1
  omarchy-notification-send "$(omarchy-i18n theme.removed)" "$THEME_NAME" || true
  echo "Removed $THEME_NAME"
else
  echo "Error: Theme '$THEME_NAME' not found." >&2
  exit 1
fi

#!/bin/bash

# omarchy:summary=Play the current background's matching theme intro
# omarchy:hidden=true

set -euo pipefail

state_home="$HOME/.local/state"
current_dir="$state_home/omarchy/current"
current_background_link="$current_dir/background"
marker="$state_home/omarchy/background-intro.session-id"
toggle="$state_home/omarchy/toggles/background-intros-off"
video_extensions=(mp4 m4v mov webm mkv avi)
intros_commit=25d3a0f276d93db4fe84da4a376a3d21fcbafaa4
intro_host=${OMARCHY_BACKGROUND_INTROS_URL:-https://raw.githubusercontent.com/yamz8/omarchy-intros/$intros_commit}
intro_cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/background-intros"
intro_cache="$intro_cache_root/${intro_host//[^A-Za-z0-9._-]/_}"

# Only each theme's default intro ships with Omarchy. The others are hosted in
# the same layout, themes/<theme>/backgrounds/intros/<name>.mp4, and are
# downloaded on demand. Only a wallpaper that is the very file an official
# theme ships has one, so a same-named image of the user's own never does.
# Sets hosted to the intro's path on the host.
hosted_intro() {
  local name=${1##*/} official
  hosted=""
  for official in "$OMARCHY_PATH"/themes/*/backgrounds/"$name"; do
    if [[ -f $official ]] && cmp -s "$official" "$1"; then
      hosted=${official#"$OMARCHY_PATH"/}
      hosted="${hosted%/*}/intros/${name%.*}.mp4"
      return 0
    fi
  done
  return 1
}

resolve_intro() {
  local background
  local stem
  local extension
  local intro

  background=$(readlink -f "${1:-$current_background_link}" 2>/dev/null) || return 1
  [[ -f $background ]] || return 1
  case ${background,,} in
  *.jpg | *.jpeg | *.png | *.bmp | *.webp) ;;
  *) return 1 ;;
  esac

  stem=${background##*/}
  stem=${stem%.*}
  for extension in "${video_extensions[@]}"; do
    intro="${background%/*}/intros/$stem.$extension"
    if [[ -f $intro ]]; then
      printf '%s\n' "$intro"
      return 0
    fi
  done

  hosted_intro "$background" || return 1
  intro="$intro_cache/$hosted"
  [[ -f $intro ]] || return 1
  printf '%s\n' "$intro"
}

# Download a chosen wallpaper's hosted intro, so it plays the next time that
# wallpaper arrives with its theme or at login. Nothing waits for this.
fetch_intro() {
  local background staged code cached

  [[ ! -f $toggle ]] || return 0
  background=$(readlink -f "${1:-}" 2>/dev/null) || return 0
  [[ -f $background ]] || return 0
  [[ -z $(resolve_intro "$background" || true) ]] || return 0
  hosted_intro "$background" || return 0
  ! animations_off || return 0

  # Intros cached from another host or commit are never played again.
  for cached in "$intro_cache_root"/*/; do
    [[ $cached == "$intro_cache/" ]] || rm -rf "$cached"
  done

  # Remember a wallpaper the host has no intro for, so it is asked only once.
  [[ ! -e $intro_cache/$hosted.missing ]] || return 0
  mkdir -p "$intro_cache/${hosted%/*}"
  # Choosing a wallpaper again while its intro downloads shares that download.
  exec 8>"$intro_cache/$hosted.lock"
  flock -n 8 || return 0
  [[ ! -f $intro_cache/$hosted && ! -e $intro_cache/$hosted.missing ]] || return 0
  staged=$(mktemp "$intro_cache/${hosted%/*}/.intro.XXXXXX")
  trap 'rm -f "$staged"' EXIT
  if code=$(curl -fsSL --proto '=https,file' --connect-timeout 10 --max-time 600 --retry 2 \
    --max-filesize 104857600 -w '%{http_code}' -o "$staged" "$intro_host/$hosted"); then
    if [[ -s $staged ]]; then
      chmod 644 "$staged"
      mv -f "$staged" "$intro_cache/$hosted"
    fi
  elif (( $? == 37 )) || [[ $code == "404" ]]; then
    touch "$intro_cache/$hosted.missing"
  fi
  rm -f "$staged"
  trap - EXIT
}

# Preparation is speculative: the selected staged clip is compared again by OWE.
prepare_theme_intro() {
  local theme="$1" background remembered name source intro
  local -a names=()
  [[ -n $theme && $theme != .* && $theme != */* ]] || return 0
  [[ ! -f $toggle ]] && ! animations_off || return 0
  owe warm >/dev/null 2>&1 || return 0
  [[ $(cat "$current_dir/theme.name" 2>/dev/null) != "$theme" ]] || return 0
  remembered=$(cat "$state_home/omarchy/theme-backgrounds/$theme" 2>/dev/null || true)
  if [[ ${remembered%/*} == "$current_dir/theme/backgrounds" ]]; then
    name=${remembered##*/}
  elif [[ -f $remembered ]]; then
    background="$remembered"
  else
    mapfile -d '' -t names < <(
      find -L "$HOME/.config/omarchy/backgrounds/$theme" -maxdepth 1 -type f -print0 2>/dev/null | sort -z
    )
    if (( ${#names[@]} > 0 )); then
      background=${names[0]}
    else
      mapfile -d '' -t names < <(
        find -L "$OMARCHY_PATH/themes/$theme/backgrounds" "$HOME/.config/omarchy/themes/$theme/backgrounds" -maxdepth 1 -type f \
          \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.bmp' -o -iname '*.webp' \) -printf '%f\0' 2>/dev/null | sort -zu
      )
      (( ${#names[@]} > 0 )) || return 0
      name=${names[0]}
    fi
  fi
  if [[ -n ${name:-} ]]; then
    for source in "$HOME/.config/omarchy/themes/$theme" "$OMARCHY_PATH/themes/$theme"; do
      if [[ -f $source/backgrounds/$name ]]; then
        background="$source/backgrounds/$name"
        break
      fi
    done
  fi
  [[ -n ${background:-} ]] || return 0
  intro=$(resolve_intro "$background" || true)
  [[ -z $intro ]] || owe intro-prepare "$intro" >/dev/null 2>&1 || true
}

animations_off() {
  [[ $(hyprctl -j getoption animations:enabled 2>/dev/null | jq -r '.bool' 2>/dev/null) == "false" ]]
}

theme_switch=false
intro_prepared=false
expected_background=""
expected_theme=""
case ${1:-} in
  "") ;;
  --prepare-theme)
    prepare_theme_intro "${2:-}"
    exit 0
    ;;
  --resolve-only)
    resolve_intro "${2:-}" || true
    exit 0
    ;;
  --fetch)
    fetch_intro "${2:-}"
    exit 0
    ;;
  --resolve-startup)
    if [[ ! -f $toggle ]] && ! animations_off; then
      resolve_intro || true
    fi
    exit 0
    ;;
  --theme-switch)
    theme_switch=true
    expected_background=$(readlink -f "${2:-}" 2>/dev/null) || exit 1
    expected_theme=${3:-}
    intro_prepared=${4:-false}
    [[ -n $expected_theme ]] || exit 1
    ;;
  *)
    echo "Usage: omarchy-theme-bg-boot-intro [--resolve-only [background]|--fetch background|--resolve-startup|--prepare-theme theme|--theme-switch background theme-id [prepared]]" >&2
    exit 1
    ;;
esac

if [[ $theme_switch == false ]]; then
  mkdir -p "$(dirname "$marker")"
  exec 9>"$state_home/omarchy/background-intro.lock"
  flock 9

  session_id=${OMARCHY_SESSION_ID:-${HYPRLAND_INSTANCE_SIGNATURE:-}}
  [[ -n $session_id ]] || exit 0
  if [[ -f $marker && $(<"$marker") == "$session_id" ]]; then
    exit 0
  fi

  marker_staged=$(mktemp "$state_home/omarchy/.background-intro.session-id.XXXXXX")
  trap 'rm -f "$marker_staged"' EXIT
  printf '%s\n' "$session_id" >"$marker_staged"
  mv -f "$marker_staged" "$marker"
  trap - EXIT
  exec 9>&-
fi

selection_current() {
  [[ $(readlink -f "$current_background_link") == "$expected_background" &&
    $(stat -Lc '%d:%i' "$current_dir/theme" 2>/dev/null) == "$expected_theme" ]]
}

if [[ $theme_switch == true ]] && ! selection_current; then
  exit 0
fi

if [[ -f $toggle ]] || animations_off; then
  [[ $theme_switch == false ]] || exit 1
  exit 0
fi

intro=$(resolve_intro || true)
if [[ -z $intro ]]; then
  [[ $theme_switch == false ]] || exit 1
  exit 0
fi

if [[ $theme_switch == true && $intro_prepared != "true" ]]; then
  owe refresh >/dev/null || exit 1
elif [[ $theme_switch == false ]]; then
  deadline=$((SECONDS + 5))
  while ! timeout 1 owe status >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      exit 0
    fi
    sleep 0.2
  done
  (( SECONDS < deadline )) || exit 0
fi

# The asynchronous outgoing cover must reach the compositor before playback
# can hide the shell background. Older shells have no readiness method.
if [[ $theme_switch == true ]]; then
  deadline=$((SECONDS + 3))
  while true; do
    cover_status=$(omarchy-shell shell themeIntroCoverStatus "$expected_theme" 2>/dev/null || true)
    case $cover_status in
      loading)
        (( SECONDS < deadline )) || exit 1
        sleep 0.01
        ;;
      error) exit 1 ;;
      superseded) exit 0 ;;
      *) break ;;
    esac
  done
fi

if [[ $theme_switch == true ]] && ! selection_current; then
  exit 0
fi

# A selection or setting changed while OWE was starting no longer permits this intro.
if [[ ! -f $toggle && $intro == "$(resolve_intro || true)" ]] && ! animations_off; then
  if [[ $theme_switch == true && $intro_prepared == "true" ]]; then
    owe intro --start first-frame --refresh "$intro"
  else
    owe intro --start first-frame "$intro"
  fi
elif [[ $theme_switch == true ]]; then
  exit 1
fi

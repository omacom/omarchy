#!/bin/bash

# omarchy:summary=Play the current background's matching theme intro
# omarchy:hidden=true

set -euo pipefail

state_home="$HOME/.local/state"
current_dir="$state_home/omarchy/current"
current_background_link="$current_dir/background"
marker="$state_home/omarchy/background-intro.boot-id"
toggle="$state_home/omarchy/toggles/background-intros-off"
video_extensions=(mp4 m4v mov webm mkv avi)

resolve_intro() {
  local background
  local stem
  local extension
  local intro

  background=$(readlink -f "${1:-$current_background_link}" 2>/dev/null) || return 1
  [[ -f $background ]] || return 1
  case ${background,,} in
  *.jpg | *.jpeg | *.png | *.bmp | *.webp) ;;
  *) return 1 ;;
  esac

  stem=${background##*/}
  stem=${stem%.*}
  for extension in "${video_extensions[@]}"; do
    intro="${background%/*}/intros/$stem.$extension"
    if [[ -f $intro ]]; then
      printf '%s\n' "$intro"
      return 0
    fi
  done
  return 1
}

animations_off() {
  [[ $(hyprctl -j getoption animations:enabled 2>/dev/null | jq -r '.bool' 2>/dev/null) == "false" ]]
}

theme_switch=false
expected_background=""
expected_theme=""
case ${1:-} in
  "") ;;
  --resolve-only)
    resolve_intro "${2:-}" || true
    exit 0
    ;;
  --theme-switch)
    theme_switch=true
    expected_background=$(readlink -f "${2:-}" 2>/dev/null) || exit 1
    expected_theme=${3:-}
    [[ -n $expected_theme ]] || exit 1
    ;;
  *)
    echo "Usage: omarchy-theme-bg-boot-intro [--resolve-only [background]|--theme-switch background theme-id]" >&2
    exit 1
    ;;
esac

if [[ $theme_switch == false ]]; then
  mkdir -p "$(dirname "$marker")"
  exec 9>"$state_home/omarchy/background-intro.lock"
  flock 9

  boot_id=${OMARCHY_BOOT_ID:-$(< /proc/sys/kernel/random/boot_id)}
  if [[ -f $marker && $(<"$marker") == "$boot_id" ]]; then
    exit 0
  fi

  marker_staged=$(mktemp "$state_home/omarchy/.background-intro.boot-id.XXXXXX")
  trap 'rm -f "$marker_staged"' EXIT
  printf '%s\n' "$boot_id" >"$marker_staged"
  mv -f "$marker_staged" "$marker"
  trap - EXIT
  exec 9>&-
fi

selection_current() {
  [[ $(readlink -f "$current_background_link") == "$expected_background" &&
    $(stat -Lc '%d:%i' "$current_dir/theme" 2>/dev/null) == "$expected_theme" ]]
}

if [[ $theme_switch == true ]] && ! selection_current; then
  exit 0
fi

if [[ -f $toggle ]] || animations_off; then
  [[ $theme_switch == false ]] || exit 1
  exit 0
fi

intro=$(resolve_intro || true)
if [[ -z $intro ]]; then
  [[ $theme_switch == false ]] || exit 1
  exit 0
fi

if [[ $theme_switch == true ]]; then
  owe refresh >/dev/null || exit 1
else
  deadline=$((SECONDS + 5))
  while ! timeout 1 owe status >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      exit 0
    fi
    sleep 0.2
  done
  (( SECONDS < deadline )) || exit 0
fi

if [[ $theme_switch == true ]] && ! selection_current; then
  exit 0
fi

# A selection or setting changed while OWE was starting no longer permits this intro.
if [[ ! -f $toggle && $intro == "$(resolve_intro || true)" ]] && ! animations_off; then
  owe intro --start first-frame "$intro"
elif [[ $theme_switch == true ]]; then
  exit 1
fi

#!/bin/bash

# omarchy:summary=Set the system monospace font
# omarchy:args=<font-name>
# omarchy:examples=omarchy font list | omarchy font set "CaskaydiaMono Nerd Font"

usage() {
  echo "Usage: omarchy-font-set <font-name>"
}

font_name="${1:-}"

case "$font_name" in
  -h|--help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
esac

if ! fc-list | grep -Fqi -- "$font_name"; then
  echo "Font '$font_name' not found."
  exit 1
fi

if [[ -f ~/.config/alacritty/alacritty.toml ]]; then
  sed -i "s/family = \".*\"/family = \"$font_name\"/g" ~/.config/alacritty/alacritty.toml
fi

if [[ -f ~/.config/kitty/kitty.conf ]] || omarchy-cmd-present kitty; then
  mkdir -p ~/.config/kitty
  if grep -qE '^[[:space:]]*font_family[[:space:]]+' ~/.config/kitty/kitty.conf 2>/dev/null; then
    kitty_font_name=$(printf '%s' "$font_name" | sed 's/[\\&/]/\\&/g')
    sed --follow-symlinks -i -E "s/^[[:space:]]*font_family[[:space:]]+.*/font_family $kitty_font_name/" ~/.config/kitty/kitty.conf
  else
    printf '\nfont_family %s\n' "$font_name" >>~/.config/kitty/kitty.conf
  fi
  pkill -USR1 kitty
fi

if [[ -f ~/.config/ghostty/config ]]; then
  sed -i "s/font-family = \".*\"/font-family = \"$font_name\"/g" ~/.config/ghostty/config
  pkill -SIGUSR2 ghostty
fi

if [[ -f ~/.config/foot/foot.ini ]]; then
  sed -i "s/^font=.*/font=$font_name:size=9/g" ~/.config/foot/foot.ini
fi

# fontconfig is the canonical source of truth — the omarchy shell, Qt apps,
# and anything resolving "monospace" all read from here. Write a drop-in under
# conf.d so the user's own ~/.config/fontconfig/fonts.conf is never truncated.
# prepend_first puts the chosen family at the head of the list so it wins over
# the family that the package default prefers.
fontconfig_file="$HOME/.config/fontconfig/conf.d/50-omarchy-monospace.conf"
mkdir -p "$(dirname "$fontconfig_file")"
cat >"$fontconfig_file" <<XML
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "fonts.dtd">
<fontconfig>
  <match target="pattern">
    <test name="family" qual="any">
      <string>monospace</string>
    </test>
    <edit name="family" mode="prepend_first" binding="strong">
      <string>$font_name</string>
    </edit>
  </match>
</fontconfig>
XML

# conf.d loads before fonts.conf, so a match block written by earlier versions
# of this command would still win over the drop-in. Surgically remove every
# <match target="pattern"> block that carries both the monospace test and
# prepend_first — whatever font it names — and keep the rest of the file
# byte-for-byte. A file left with nothing but the XML skeleton is deleted.
legacy_fontconfig="$HOME/.config/fontconfig/fonts.conf"
if [[ -f $legacy_fontconfig ]]; then
  legacy_tmp=$(mktemp "$legacy_fontconfig.XXXXXX")
  awk '
    /<match[^>]*>.*<\/match>/ {
      if (!($0 ~ /<match target="pattern">/ && $0 ~ /<string>monospace<\/string>/ && $0 ~ /mode="prepend_first"/)) print
      next
    }
    /<match[^>]*>/ { inmatch = 1; buf = $0 "\n"; next }
    inmatch {
      buf = buf $0 "\n"
      if (/<\/match>/) {
        if (!(buf ~ /<match target="pattern">/ && buf ~ /<string>monospace<\/string>/ && buf ~ /mode="prepend_first"/)) printf "%s", buf
        buf = ""
        inmatch = 0
      }
      next
    }
    { print }
  ' "$legacy_fontconfig" >"$legacy_tmp"

  if cmp -s "$legacy_tmp" "$legacy_fontconfig"; then
    rm -f "$legacy_tmp"
  elif ! grep -vE '^[[:space:]]*$|<\?xml[^?]*\?>|<!DOCTYPE[^>]*>|</?fontconfig>' "$legacy_tmp" | grep -q .; then
    rm -f "$legacy_tmp" "$legacy_fontconfig"
  else
    mv "$legacy_tmp" "$legacy_fontconfig"
  fi
fi

omarchy-restart-shell

if pgrep -x ghostty; then
  omarchy-notification-send -g  "You must restart Ghostty to see font change"
fi

if pgrep -x foot; then
  omarchy-notification-send -g  "You must restart Foot to see font change"
fi

omarchy-hook font-set "$font_name"

#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

installed=()
declare -A installed_exact=()
declare -A selected=()

# Callers may remove user data after this helper succeeds. A failed database
# query is not evidence that the package is absent.
package_names=$(pacman -Qq) || {
  echo "Could not read installed packages; refusing package removal." >&2
  exit 1
}
while IFS= read -r package_name; do
  [[ -n $package_name ]] || continue
  installed_exact[$package_name]=1
done <<< "$package_names"

for pkg in "$@"; do
  if [[ -n ${installed_exact[$pkg]} && -z ${selected[$pkg]} ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  sudo pacman -Rns --noconfirm "${installed[@]}"
fi

#!/bin/bash

# omarchy:summary=Apply an icon set
# omarchy:args=<icon-set-name>
# omarchy:examples=omarchy icons list | omarchy icons set "Original"

if [[ -z $1 ]]; then
  echo "Usage: omarchy-icons-set <icon-set-name>"
  exit 1
fi

CURRENT="$HOME/.local/state/omarchy/current"

# A set is named as omarchy-icons-list prints it or as its directory is.
SET_NAME=$(tr '[:upper:]' '[:lower:]' <<<"$1" | tr ' ' '-')

# The name is joined into paths, so it is held to what a set name needs.
if ! (LC_ALL=C; [[ $SET_NAME =~ ^[a-z0-9_][a-z0-9._+-]*$ ]]); then
  echo "Error: '$1' is not an icon set name."
  exit 1
fi

if [[ $SET_NAME != "original" && ! -d $HOME/.config/omarchy/icons/$SET_NAME && ! -d $OMARCHY_PATH/icons/$SET_NAME ]]; then
  echo "Icon set '$SET_NAME' does not exist"
  exit 1
fi

# Written beside its old value and renamed, so a draw already under way reads
# one name or the other.
mkdir -p "$CURRENT"
printf '%s\n' "$SET_NAME" >"$CURRENT/icons.name.next"
mv -f "$CURRENT/icons.name.next" "$CURRENT/icons.name"

# The theme in use supplies the colors the set is drawn in.
omarchy-theme-set-icons

#!/bin/bash

# omarchy:summary=Open a clipboard history entry
# omarchy:group=clipboard
# omarchy:args=--history-index <index>|--history-id <id>
# omarchy:hidden=true

history_index=""
history_id=""
history_path="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-history.json"

while (( $# > 0 )); do
  case "$1" in
    --history-index)
      (( $# >= 2 )) && [[ $2 =~ ^[0-9]+$ ]] || exit 1
      history_index="${2:-}"
      shift 2
      ;;
    --history-id)
      (( $# >= 2 )) && [[ $2 =~ ^[0-9a-f]{64}$ ]] || exit 1
      history_id="${2:-}"
      shift 2
      ;;
    *)
      echo "Usage: omarchy-clipboard-open --history-index <index> | --history-id <id>" >&2
      exit 1
      ;;
  esac
done

[[ -r $history_path ]] || exit 1

if [[ -n $history_id ]]; then
  [[ $history_id =~ ^[0-9a-f]{64}$ ]] || exit 1
  entry=$(python3 "$OMARCHY_PATH/shell/plugins/clipboard/storage.py" get "$history_id") || exit 1
else
  [[ $history_index =~ ^[0-9]+$ ]] || exit 1
  entry=$(python3 "$OMARCHY_PATH/shell/plugins/clipboard/storage.py" get-index "$history_index") || exit 1
fi
entry_type=$(jq -er '.type' <<<"$entry") || exit 1

open_image() {
  local path="$1"

  [[ -r $path ]] || exit 1
  exec omasnap "$path"
}

open_text() {
  local text="$1"
  local url=""
  local open_dir=""
  local open_file=""

  url=$(grep -Eom1 'https?://[^[:space:]"'\''<>]+' <<<"$text" || true)
  if [[ -z $url && $text =~ ^[[:space:]]*([[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,})(/[^[:space:]]*)?[[:space:]]*$ ]]; then
    url="https://${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  fi

  if [[ -n $url ]]; then
    exec omarchy-launch-browser "$url"
  fi

  open_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-open"
  mkdir -p "$open_dir"
  open_file=$(mktemp --tmpdir="$open_dir" clipboard.XXXXXX.txt) || exit 1
  printf '%s' "$text" >"$open_file"
  exec omarchy-launch-editor "$open_file"
}

case "$entry_type" in
  image)
    path=$(jq -er '.path' <<<"$entry") || exit 1
    open_image "$path"
    ;;
  text)
    text=$(jq -er '.text' <<<"$entry") || exit 1
    open_text "$text"
    ;;
  *)
    exit 1
    ;;
esac

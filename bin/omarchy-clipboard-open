#!/bin/bash

# omarchy:summary=Open a clipboard history entry
# omarchy:group=clipboard
# omarchy:args=--stdin|--history-index <index>
# omarchy:hidden=true

history_index=""
from_stdin=false
history_path="$HOME/.local/state/omarchy/clipboard-history.json"

while (( $# > 0 )); do
  case "$1" in
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    --stdin)
      from_stdin=true
      shift
      ;;
    *)
      echo "Usage: omarchy-clipboard-open --stdin|--history-index <index>" >&2
      exit 1
      ;;
  esac
done

if [[ $from_stdin == "true" ]]; then
  entry=$(head -c 2097152)
else
  [[ $history_index =~ ^[0-9]+$ ]] || exit 1
  [[ -r $history_path ]] || exit 1
  entry=$(jq -ec --argjson index "$history_index" '.[$index]' "$history_path") || exit 1
fi
entry_type=$(jq -er '.type' <<<"$entry") || exit 1

open_image() {
  local path="$1"

  [[ -r $path ]] || exit 1
  exec omasnap "$path"
}

open_text() {
  local text="$1"
  local url=""
  local open_dir=""
  local open_file=""

  url=$(grep -Eom1 'https?://[^[:space:]"'\''<>]+' <<<"$text" || true)
  if [[ -z $url && $text =~ ^[[:space:]]*([[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,})(/[^[:space:]]*)?[[:space:]]*$ ]]; then
    url="https://${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  fi

  if [[ -n $url ]]; then
    exec omarchy-launch-browser "$url"
  fi

  open_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-open"
  mkdir -p "$open_dir"
  open_file=$(mktemp --tmpdir="$open_dir" clipboard.XXXXXX.txt) || exit 1
  printf '%s' "$text" >"$open_file"
  exec omarchy-launch-editor "$open_file"
}

case "$entry_type" in
  image)
    path=$(jq -er '.path' <<<"$entry") || exit 1
    open_image "$path"
    ;;
  text)
    text=$(jq -er '.text' <<<"$entry") || exit 1
    open_text "$text"
    ;;
  *)
    exit 1
    ;;
esac

#!/bin/bash

# omarchy:summary=Open a clipboard history entry
# omarchy:group=clipboard
# omarchy:args=[--request-file <path>|--history-index <index>]
# omarchy:hidden=true

request_file=""
history_index=""
history_path="$HOME/.local/state/omarchy/clipboard-history.json"

while (( $# > 0 )); do
  case "$1" in
    --request-file)
      request_file="${2:-}"
      shift 2
      ;;
    --history-index)
      history_index="${2:-}"
      shift 2
      ;;
    *)
      echo "Usage: omarchy-clipboard-open [--request-file <path>|--history-index <index>]" >&2
      exit 1
      ;;
  esac
done

open_image() {
  local path="$1"

  [[ -r $path ]] || exit 1
  exec omasnap "$path"
}

open_text() {
  local text="$1"
  local url=""
  local open_dir=""
  local open_file=""

  url=$(grep -Eom1 'https?://[^[:space:]"'\''<>]+' <<<"$text" || true)
  if [[ -z $url && $text =~ ^[[:space:]]*([[:alnum:]][[:alnum:].-]+\.[[:alpha:]]{2,})(/[^[:space:]]*)?[[:space:]]*$ ]]; then
    url="https://${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
  fi

  if [[ -n $url ]]; then
    exec omarchy-launch-browser "$url"
  fi

  open_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-open"
  mkdir -p "$open_dir"
  open_file=$(mktemp --tmpdir="$open_dir" clipboard.XXXXXX.txt) || exit 1
  printf '%s' "$text" >"$open_file"
  exec omarchy-launch-editor "$open_file"
}

# Resolves the entry the picker showed against the history, newest-first. The
# request carries the text as displayed: the full text for entries up to the
# display cap, a prefix for longer ones. Resolving a positional index instead
# would race history rewrites that land between opening the picker and running
# this command: a re-copied entry dedups to the front and every index after it
# shifts by one, making the open act on a different entry than the one on
# screen.
resolved_history_text() {
  local prefix="$1"
  local resolved

  [[ -n $prefix ]] || exit 1
  resolved=$(jq -er --arg prefix "$prefix" \
    '[.[] | select(.type == "text" and (.text | type == "string") and (.text | startswith($prefix))) | .text] | first // empty' \
    "$history_path") || exit 1
  printf '%s' "$resolved"
}

if [[ -n $request_file ]]; then
  # The picker writes the exact entry it showed; see Clipboard.qml.
  entry_type=$(jq -er '.type' "$request_file" 2>/dev/null) || exit 1
  if [[ $entry_type == "image" ]]; then
    path=$(jq -er '.path' "$request_file") || exit 1
  elif [[ $entry_type == "text" ]]; then
    shown=$(jq -ej 'select(.type == "text") | .text' "$request_file" 2>/dev/null) || exit 1
    text=$(resolved_history_text "$shown") || exit 1
  else
    exit 1
  fi
  rm -f -- "$request_file"
elif [[ -n $history_index ]]; then
  [[ $history_index =~ ^[0-9]+$ ]] || exit 1
  [[ -r $history_path ]] || exit 1

  entry_type=$(jq -er --argjson index "$history_index" '.[$index].type' "$history_path") || exit 1
  if [[ $entry_type == "image" ]]; then
    path=$(jq -er --argjson index "$history_index" '.[$index].path' "$history_path") || exit 1
  elif [[ $entry_type == "text" ]]; then
    text=$(jq -er --argjson index "$history_index" '.[$index].text' "$history_path") || exit 1
  fi
fi

case "$entry_type" in
  image)
    open_image "$path"
    ;;
  text)
    open_text "$text"
    ;;
  *)
    exit 1
    ;;
esac

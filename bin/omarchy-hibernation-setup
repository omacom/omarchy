#!/bin/bash

# omarchy:summary=Set up hibernation with swap and boot resume configuration
# omarchy:requires-sudo=true
# omarchy:args=[--force] [--no-rebuild] [--size <SIZE>]

FORCE=false
NO_REBUILD=false
SWAPSIZE=""
for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    --no-rebuild) NO_REBUILD=true ;;
    --size) shift; SWAPSIZE="$1" ;;
    --size=*) SWAPSIZE="${arg#--size=}" ;;
  esac
done

if [[ ! -f /sys/power/image_size ]]; then
  echo -e "Hibernation is not supported on your system" >&2
  exit 0
fi

# When --no-rebuild is set, the caller is responsible for the UKI rebuild
# (e.g. running before limine-mkinitcpio-hook is installed during initial
# install), so we only require limine-mkinitcpio when we'd invoke it ourselves.
if ! $NO_REBUILD && omarchy-cmd-missing limine-mkinitcpio; then
  echo "Skipping hibernation setup (requires Limine bootloader)"
  exit 0
fi

MKINITCPIO_CONF="/etc/mkinitcpio.conf.d/omarchy_resume.conf"
SWAP_FILE="/swap/swapfile"
RESUME_DROP_IN="/etc/limine-entry-tool.d/resume.conf"

install_root_file() {
  local source="$1"
  local destination="$2"
  local mode="$3"
  local stage

  stage=$(sudo /usr/bin/mktemp -- "${destination%/*}/.${destination##*/}.omarchy.XXXXXX") || return 1
  safe_stage_path "$stage" "$destination" || return 1

  if sudo /usr/bin/install -m "$mode" -o root -g root -T "$source" "$stage" &&
    sudo /usr/bin/mv -Tf -- "$stage" "$destination"; then
    return 0
  else
    safe_stage_path "$stage" "$destination" && sudo /usr/bin/rm -f -- "$stage"
    return 1
  fi
}

safe_stage_path() {
  local stage="$1"
  local destination="$2"
  local prefix suffix

  prefix="${destination%/*}/.${destination##*/}.omarchy."
  [[ $stage == "$prefix"* ]] || return 1
  suffix=${stage#"$prefix"}
  [[ $suffix =~ ^[[:alnum:]]{6}$ ]]
}

# Check if hibernation is already configured. Skip this guard entirely under
# --force so a half-configured or stale state can always be rebuilt (see #7619).
if ! $FORCE && [[ -f $MKINITCPIO_CONF ]] && grep -q "^HOOKS+=(resume)$" "$MKINITCPIO_CONF"; then
  # The mkinitcpio resume hook exists, so either the setup is complete or a
  # previous run failed after writing the hook but before writing (or correctly
  # populating) the resume drop-in. Self-heal the incomplete cases rather than
  # claiming "already set up" while resume= is absent from the boot cmdline.
  needs_resume=true
  if [[ -f $RESUME_DROP_IN ]] && grep -qE 'resume_offset=[0-9]+' "$RESUME_DROP_IN" && [[ -f $SWAP_FILE ]]; then
    # Drop-in present with a numeric offset and the swapfile exists: verify the
    # offset still matches the file's current physical layout before trusting it.
    RESUME_OFFSET=$(sudo btrfs inspect-internal map-swapfile -r "$SWAP_FILE" 2>/dev/null)
    if [[ -n $RESUME_OFFSET ]] && grep -q "resume_offset=$RESUME_OFFSET" "$RESUME_DROP_IN"; then
      needs_resume=false
    fi
  fi
  if $needs_resume; then
    echo "Repairing incomplete hibernation resume configuration"
  else
    echo "Hibernation is already set up"
    exit 0
  fi
fi

if ! $FORCE; then
  MEM_TOTAL_HUMAN=$(free --human | awk '/Mem/ {print $2}')
  if ! gum confirm "Use $MEM_TOTAL_HUMAN on boot drive to make hibernation available?"; then
    exit 0
  fi
fi

SWAP_SUBVOLUME="@swap"
SWAP_MOUNT="${SWAP_FILE%/swapfile}"    # /swap

# Detect the top-level btrfs device backing the mount.
ROOT_DEVICE="$(findmnt -no SOURCE / | sed 's/\[.*\]//')"
ROOT_UUID="$(findmnt -no UUID /)"

# Create the swap subvolume as a TOP-LEVEL btrfs subvolume (its own subvolume id
# under subvolid 5), NOT nested inside the root @. systemd >= 259 refuses to
# hibernate into a btrfs swapfile that lives on the root subvolume tree (it
# reports CanHibernate as unavailable), so the swapfile must sit on its own
# top-level subvolume. Creating it via `btrfs subvolume create /swap` while the
# root @ is mounted nests it as @/swap, which is exactly the broken layout.
BTRFS_TOP="$(mktemp -d)"
# Mount only long enough to (re)create or clean up subvolumes.
sudo mount -t btrfs -o subvolid=5 "$ROOT_DEVICE" "$BTRFS_TOP"
if ! sudo btrfs subvolume show "$BTRFS_TOP/$SWAP_SUBVOLUME" &>/dev/null; then
  echo "Creating top-level Btrfs subvolume '$SWAP_SUBVOLUME'"
  sudo btrfs subvolume create "$BTRFS_TOP/$SWAP_SUBVOLUME"
fi
# Remove a stale nested @/swap left by a previous (broken) installer run.
if sudo btrfs subvolume show "$BTRFS_TOP/@/swap" &>/dev/null; then
  echo "Removing stale nested @/swap (broken layout)"
  sudo btrfs subvolume delete "$BTRFS_TOP/@/swap"
fi
sudo umount "$BTRFS_TOP" && rmdir "$BTRFS_TOP"

# Ensure @swap is mounted at /swap (nodatacow is required for a swapfile).
if ! findmnt -n "$SWAP_MOUNT" &>/dev/null; then
  echo "Mounting $SWAP_MOUNT"
  sudo install -d -m 0755 "$SWAP_MOUNT"
  sudo mount -t btrfs -o subvol=${SWAP_SUBVOLUME},nodatacow "$ROOT_DEVICE" "$SWAP_MOUNT"
fi
# Persist the @swap mount in fstab.
if ! grep -q "subvol=${SWAP_SUBVOLUME}[ ,]" /etc/fstab 2>/dev/null && \
   ! grep -qE "[[:space:]]${SWAP_MOUNT}[[:space:]]" /etc/fstab 2>/dev/null; then
  echo "Adding $SWAP_MOUNT mount to /etc/fstab"
  printf "\n# @swap subvolume for hibernation\nUUID=%s %s btrfs subvol=%s,nodatacow 0 0\n" "$ROOT_UUID" "$SWAP_MOUNT" "$SWAP_SUBVOLUME" | sudo tee -a /etc/fstab >/dev/null
fi

# Create swapfile
if ! sudo swaplabel "$SWAP_FILE" &>/dev/null; then
  echo "Creating swapfile in Btrfs subvolume"
  if [[ -n $SWAPSIZE ]]; then
    MEM_TOTAL_ARG="$SWAPSIZE"
  else
    # Size to RAM rounded up to the next GiB, plus 2 GiB of headroom so the
    # suspend image (plus page-cache flush overhead) always fits.
    RAM_KIB="$(awk '/^MemTotal:/{print $2}' /proc/meminfo)"
    RAM_GIB=$(( (RAM_KIB + 1048575) / 1048576 ))
    MEM_TOTAL_ARG="$(( RAM_GIB + 2 ))G"
  fi
  echo "  Swap size: $MEM_TOTAL_ARG"
  sudo btrfs filesystem mkswapfile -s "$MEM_TOTAL_ARG" "$SWAP_FILE"
fi

# Add swapfile to fstab
if ! grep -Fq "$SWAP_FILE" /etc/fstab; then
  echo "Adding swapfile to /etc/fstab"
  sudo cp -a /etc/fstab "/etc/fstab.$(date +%Y%m%d%H%M%S).back"
  printf "\n# Btrfs swapfile for system hibernation\n%s none swap defaults,pri=0 0 0\n" "$SWAP_FILE" | sudo tee -a /etc/fstab >/dev/null
fi

# Enable swap
if ! swapon --show | grep -q "$SWAP_FILE"; then
  echo "Enabling swap on $SWAP_FILE"
  sudo swapon -p 0 "$SWAP_FILE"
fi

# Ensure keyboard backlight doesn't prevent sleep
# Install this before writing the resume marker so a failed install remains
# retryable through the normal setup command.
if ! install_root_file "$OMARCHY_PATH/default/systemd/system-sleep/keyboard-backlight" \
  /usr/lib/systemd/system-sleep/keyboard-backlight 0755; then
  echo "Could not install the keyboard-backlight system-sleep hook" >&2
  exit 1
fi

# Add resume hook to mkinitcpio
sudo mkdir -p /etc/mkinitcpio.conf.d
echo "Adding resume hook to $MKINITCPIO_CONF"
echo "HOOKS+=(resume)" | sudo tee "$MKINITCPIO_CONF" >/dev/null

# Add resume= kernel parameters so the initramfs resume hook knows where to find the
# hibernation image. Without these, resume happens late (after GPU drivers load) and fails.
if [[ ! -f $RESUME_DROP_IN ]]; then
  echo "Adding resume kernel parameters"
  sudo swapon -p 0 "$SWAP_FILE" 2>/dev/null
  RESUME_DEVICE=$(findmnt -no SOURCE -T "$SWAP_FILE" | sed 's/\[.*\]//')
  RESUME_OFFSET=$(sudo btrfs inspect-internal map-swapfile -r "$SWAP_FILE")
  if [[ -n $RESUME_OFFSET ]]; then
    sudo mkdir -p /etc/limine-entry-tool.d
    echo "KERNEL_CMDLINE[default]+=\" resume=$RESUME_DEVICE resume_offset=$RESUME_OFFSET\"" | sudo tee "$RESUME_DROP_IN" >/dev/null
  else
    echo "Warning: Could not determine resume offset for $SWAP_FILE" >&2
  fi
fi

# Use ACPI alarm for RTC wakeup on s2idle systems (needed for suspend-then-hibernate)
if grep -q "\[s2idle\]" /sys/power/mem_sleep 2>/dev/null; then
  LIMINE_DROP_IN="/etc/limine-entry-tool.d/rtc-alarm.conf"
  if [[ ! -f $LIMINE_DROP_IN ]]; then
    echo "Enabling ACPI RTC alarm for s2idle suspend"
    sudo mkdir -p /etc/limine-entry-tool.d
    echo 'KERNEL_CMDLINE[default]+=" rtc_cmos.use_acpi_alarm=1"' | sudo tee "$LIMINE_DROP_IN" >/dev/null
  fi
fi

if ! $NO_REBUILD; then
  # limine-mkinitcpio rebuilds initramfs/UKI for all kernels and updates the
  # /boot/limine.conf entries via limine-entry-tool. The limine bootloader
  # binary on the ESP doesn't change here, so we don't need limine-update
  # (which would also re-deploy the binary and rebuild a second time).
  echo "Regenerating initramfs..."
  sudo limine-mkinitcpio
  echo
fi

if ! $FORCE && ! $NO_REBUILD && gum confirm "Reboot to enable hibernation?"; then
  omarchy-system-reboot
fi

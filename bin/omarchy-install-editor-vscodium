#!/bin/bash

# omarchy:summary=Install VSCodium and configure Omarchy defaults for secrets, updates, and theme

echo "Installing VSCodium..."
if pacman -Si vscodium-bin &>/dev/null; then
  omarchy-pkg-add vscodium-bin
else
  omarchy-pkg-aur-add vscodium-bin
fi

mkdir -p ~/.vscode-oss ~/.config/VSCodium/User

cat > ~/.vscode-oss/argv.json << 'EOF'
// This configuration file allows you to pass permanent command line arguments to VSCodium.
// Only a subset of arguments is currently supported to reduce the likelihood of breaking
// the installation.
//
// PLEASE DO NOT CHANGE WITHOUT UNDERSTANDING THE IMPACT
//
// NOTE: Changing this file requires a restart of VSCodium.
{
  "password-store":"gnome-libsecret"
}
EOF

# Ensure VSC's own auto-update feature is turned off
printf '{\n  "update.mode": "none"\n}\n' > ~/.config/VSCodium/User/settings.json

# Apply Omarchy theme to VSCodium
omarchy-theme-set-vscode

setsid uwsm-app -- gtk-launch codium >/dev/null 2>&1 &

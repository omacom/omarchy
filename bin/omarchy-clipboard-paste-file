#!/bin/bash

# omarchy:summary=Copy a file to the clipboard and paste it
# omarchy:group=clipboard
# omarchy:args=[--copy-only] <mime-type> <path> [window-address]
# omarchy:examples=omarchy clipboard paste file image/png /tmp/screenshot.png
# omarchy:hidden=true

copy_only=false

if [[ ${1:-} == "--copy-only" ]]; then
  copy_only=true
  shift
fi

mime=${1:-}
path=${2:-}
target=${3:-}

if [[ -z $mime || -z $path ]]; then
  echo "Usage: omarchy-clipboard-paste-file [--copy-only] <mime-type> <path> [window-address]" >&2
  exit 1
fi

[[ -r $path ]] || exit 1

wl-copy --type "$mime" < "$path"

if [[ $copy_only == "true" ]]; then
  exit
fi

focus_window() {
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$1\" })" >/dev/null 2>&1 ||
    hyprctl dispatch focuswindow "address:$1" >/dev/null 2>&1
}

active_address() {
  hyprctl activewindow -j 2>/dev/null | jq -r '.address // ""'
}

if [[ -n $target ]]; then
  [[ $target == 0x* ]] || target="0x$target"

  # Same follow_mouse race as omarchy-clipboard-paste-text: wait for the
  # overlay to close, then re-focus the origin window before Shift+Insert.
  sleep 0.15
  focused=false
  for _ in {1..15}; do
    if [[ $(active_address) == "$target" ]]; then
      focused=true
      break
    fi
    focus_window "$target"
    sleep 0.04
  done
  [[ $focused == "true" || $(active_address) == "$target" ]] || exit 0
else
  sleep 0.15
fi

wtype -M shift -k Insert -m shift 2>/dev/null || true

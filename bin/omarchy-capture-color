#!/bin/bash
# omarchy:summary=Pick a color and copy it to the clipboard

if pkill hyprpicker; then
  exit 0
fi

if ! COLOR_HEX=$(hyprpicker --autocopy --no-fancy); then
  exit 0
fi

if [[ -z $COLOR_HEX ]]; then
  exit 0
fi

omarchy-notification-send "$(omarchy-i18n capture.colorCopied)" "$(omarchy-i18n capture.colorCopiedBody "$COLOR_HEX")" || true

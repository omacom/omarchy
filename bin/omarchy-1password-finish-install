#!/bin/bash

# omarchy:summary=Finish 1Password install steps the package skipped (polkit owners, MCP setgid).
# omarchy:requires-sudo=true

# The [omarchy] 1password package ships after-install.sh but never runs it, and
# deletes com.1password.1Password.policy.tpl so the vendor script cannot repair
# itself (#11830 / #12030). Port the two install-time steps that matter:
# rewrite polkit owners to local human users, and setgid the BrowserSupport /
# MCP binaries onto their dedicated groups.
#
# Package upgrades restore the shipped policy/binaries, so also drop an alpm
# PostTransaction hook that re-runs this helper after every 1password upgrade.

set -euo pipefail

POLICY=/usr/share/polkit-1/actions/com.1password.1Password.policy
OPT_DIR=/opt/1Password
SUDO=${OMARCHY_SUDO:-sudo}
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
HOOK_SRC="$OMARCHY_PATH/default/libalpm/hooks/90-omarchy-1password-finish.hook"
HOOK_DST=/etc/pacman.d/hooks/90-omarchy-1password-finish.hook

policy_owners() {
  cut -d: -f1,3 /etc/passwd |
    grep -E ':[0-9]{4}$' |
    cut -d: -f1 |
    head -n 10 |
    sed 's/^/unix-user:/' |
    tr '\n' ' ' |
    sed 's/[[:space:]]*$//'
}

ensure_group() {
  local group=$1
  getent group "$group" >/dev/null 2>&1 && return 0
  "$SUDO" groupadd --system "$group"
}

rewrite_polkit_owners() {
  [[ -f $POLICY ]] || return 0

  local owners
  owners=$(policy_owners)
  [[ -n $owners ]] || {
    echo "omarchy-1password-finish-install: no four-digit UID users to own the polkit policy" >&2
    return 1
  }

  local tmp
  tmp=$(mktemp)
  # Replace unresolved templates and any existing owner annotation value
  # (including a build-host "unix-user:builder" baked in at package time).
  OWNER_LIST=$owners perl -0pe '
    s/\$\{POLICY_OWNERS\}/$ENV{OWNER_LIST}/g;
    s/(org\.freedesktop\.policykit\.owner">)[^<]*/$1$ENV{OWNER_LIST}/g;
  ' "$POLICY" >"$tmp"

  "$SUDO" install -Dm0644 "$tmp" "$POLICY"
  rm -f "$tmp"
}

setup_browser_support() {
  local bin=$OPT_DIR/1Password-BrowserSupport
  [[ -e $bin ]] || return 0
  ensure_group onepassword
  "$SUDO" chgrp onepassword -- "$bin"
  "$SUDO" chmod g+s -- "$bin"
}

link_mcp_convenience() {
  local bin=$1
  local link=$2

  if [[ ! -e $link ]]; then
    "$SUDO" ln -sfn "$bin" "$link"
    return 0
  fi

  if [[ -L $link ]]; then
    local current intended
    current=$(readlink -f -- "$link" 2>/dev/null || true)
    intended=$(readlink -f -- "$bin" 2>/dev/null || true)
    if [[ -n $current && -n $intended && $current == "$intended" ]]; then
      return 0
    fi
  fi

  echo "omarchy-1password-finish-install: leaving $link (already managed locally)" >&2
}

setup_mcp() {
  local bin=""
  for candidate in "$OPT_DIR/1password-mcp" "$OPT_DIR/onepassword-mcp"; do
    if [[ -e $candidate ]]; then
      bin=$candidate
      break
    fi
  done
  [[ -n $bin ]] || return 0

  ensure_group onepassword-mcp
  "$SUDO" chgrp onepassword-mcp -- "$bin"
  "$SUDO" chmod g+s -- "$bin"

  if [[ $bin == "$OPT_DIR/1password-mcp" && ! -e $OPT_DIR/onepassword-mcp ]]; then
    "$SUDO" ln -sfn 1password-mcp "$OPT_DIR/onepassword-mcp"
  fi
  if [[ -d /usr/local/bin ]]; then
    link_mcp_convenience "$bin" /usr/local/bin/1password-mcp
  fi
}

# Survive later 1password package upgrades that restore the shipped policy and
# drop setgid. /etc/pacman.d/hooks is the local hook path and is not owned by
# the omarchy package, so the repair keeps firing after the one-time migration.
ensure_upgrade_hook() {
  local tmp

  if [[ -f $HOOK_SRC ]]; then
    if [[ -f $HOOK_DST ]] && cmp -s -- "$HOOK_SRC" "$HOOK_DST"; then
      return 0
    fi
    "$SUDO" install -Dm0644 "$HOOK_SRC" "$HOOK_DST"
    return 0
  fi

  [[ -f $HOOK_DST ]] && return 0

  tmp=$(mktemp)
  cat >"$tmp" <<'EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = 1password

[Action]
Description = Repairing 1Password polkit owners and MCP setgid...
When = PostTransaction
Depends = omarchy
Exec = /usr/bin/omarchy-1password-finish-install
EOF
  "$SUDO" install -Dm0644 "$tmp" "$HOOK_DST"
  rm -f "$tmp"
}

if [[ ! -d $OPT_DIR ]]; then
  echo "omarchy-1password-finish-install: $OPT_DIR is not installed; nothing to do"
  exit 0
fi

rewrite_polkit_owners
setup_browser_support
setup_mcp
ensure_upgrade_hook

echo "1Password install finish: polkit owners and helper groups applied."

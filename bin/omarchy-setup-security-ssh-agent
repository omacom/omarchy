#!/bin/bash

# omarchy:summary=Enable an SSH agent (gcr-ssh-agent) that prompts for key passphrases graphically.

set -e

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
systemd_env_file="$config_home/environment.d/90-gcr-ssh-agent.conf"
session_env_file="$config_home/uwsm/env.d/90-omarchy-ssh-agent"

systemctl --user enable --now gcr-ssh-agent.socket

# UWSM sources this on every session start and exports its result to the
# systemd user manager. Keeping it in the session environment also lets a
# later `unset` override a socket path restored from an earlier login.
mkdir -p "$(dirname "$session_env_file")"
printf '%s\n' 'export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"' >"$session_env_file"

# Retire the old manager-start-only setting. Existing user managers do not
# reread environment.d on an autologin relogin.
rm -f "$systemd_env_file"

echo ""
echo "SSH agent has been enabled. Log out and back in to make it available everywhere."
echo "The first use of a passphrase-protected key opens a dialog, with the option to"
echo "remember the passphrase in the keyring."

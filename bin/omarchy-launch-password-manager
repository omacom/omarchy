#!/bin/bash

# omarchy:summary=Launch the installed password manager or start the 1Password installer when none is.

if omarchy-cmd-present 1password; then
  omarchy-launch-1password
elif omarchy-cmd-present bitwarden-desktop; then
  omarchy-launch-bitwarden
else
  omarchy-launch-floating-terminal-with-presentation omarchy-install-service-1password
fi

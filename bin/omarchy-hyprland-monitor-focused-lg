#!/bin/bash

# omarchy:summary=Return success if the focused or named Hyprland monitor is an LG UltraFine display.
# omarchy:args=[monitor]

monitor="${1:-}"

hyprctl monitors -j | jq -e --arg monitor "$monitor" '
  .[]
  | select(if $monitor == "" then .focused == true else .name == $monitor end)
  | select(.make == "LG Electronics" and (.model | test("UltraFine")))
' >/dev/null

#!/bin/bash

# omarchy:summary=Detect whether the computer has an NVIDIA GPU with GSP firmware (Turing or newer)
# omarchy:args=<exit 0 if the GPU is Turing or newer>

# Wrapper over omarchy-hw-nvidia-arch so the device-ID ranges live in one place.
# See that helper for why 0x1e00 is the Turing boundary.
[[ $(omarchy-hw-nvidia-arch) == modern ]]

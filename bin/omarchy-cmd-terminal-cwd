#!/bin/bash

# omarchy:summary=Print the current working directory of the active terminal or Files window
# omarchy:args=[terminal-pid] [window-tag]
# omarchy:hidden=true

terminal_pid=$1
window_tag=${2:-}
if [[ -z $terminal_pid ]]; then
  active=$(hyprctl activewindow)
  terminal_pid=$(awk '/^[[:space:]]*pid:/ {print $2}' <<<"$active")
  window_tag=$(awk '/^[[:space:]]*xdgTag:/ {print $2}' <<<"$active")
fi
kitty_socket="$XDG_RUNTIME_DIR/omarchy-kitty-$terminal_pid"
cwd=""

# Files keeps its working directory on the folder it shows, so a terminal
# opened over it starts there.
if [[ $(readlink "/proc/$terminal_pid/exe" 2>/dev/null) == */folio ]]; then
  cwd=$(readlink -f "/proc/$terminal_pid/cwd" 2>/dev/null)
elif [[ -S $kitty_socket ]]; then
  cwd=$(kitten @ --to "unix:$kitty_socket" ls --match "state:focused" 2>/dev/null |
    jq -r '.[].tabs[].windows[].cwd // empty')
else
  # The newest child, as pgrep -P | tail -n1 found it, read from the kernel's
  # child lists: pgrep scans all of /proc on every new terminal. One Foot server
  # owns every footclient window, so its newest shell need not be the focused
  # one: omarchy-launch-foot tags each window and puts the same tag in its
  # shell's environment, so a tagged window picks the shell that carries it.
  shell_pid=""
  tagged_pid=""
  for children_file in /proc/"$terminal_pid"/task/*/children; do
    [[ -r $children_file ]] || continue
    read -ra children <"$children_file" || true
    for child in "${children[@]}"; do
      (( child > ${shell_pid:-0} )) && shell_pid=$child
      if [[ $window_tag == omarchy-foot-* && -z $tagged_pid ]] &&
        tr '\0' '\n' <"/proc/$child/environ" 2>/dev/null | grep -Fqx "OMARCHY_FOOT_WINDOW=$window_tag"; then
        tagged_pid=$child
      fi
    done
  done
  [[ -n $tagged_pid ]] && shell_pid=$tagged_pid

  # A terminal's shell leads its own session on the terminal's pty. A shell any other app
  # spawned, like a browser's download helper, does not, so that app gets a terminal in HOME.
  if [[ -n $shell_pid ]] && read -r stat 2>/dev/null <"/proc/$shell_pid/stat"; then
    read -r _ _ _ session tty_nr _ <<<"${stat##*) }"
    if (( session == shell_pid && tty_nr != 0 )); then
      cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null)
      shell=$(readlink -f "/proc/$shell_pid/exe" 2>/dev/null)
      grep -Fqsx "$shell" /etc/shells || cwd=""
    fi
  fi
fi

if [[ -d $cwd ]]; then
  echo "$cwd"
else
  echo "$HOME"
fi

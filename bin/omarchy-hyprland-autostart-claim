#!/bin/bash

# omarchy:summary=Claim Hyprland session startup
# omarchy:hidden=true

set -euo pipefail

[[ -n ${XDG_RUNTIME_DIR:-} && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || exit 1

instance_dir="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE"
[[ -d $instance_dir ]] || exit 1

claim="$instance_dir/omarchy-autostart"

# Before this guard existed, Omarchy's shell was launched directly from the
# compositor config. On an update-triggered reload, adopt that shell instead
# of replaying post-boot hooks while it is still starting. Other Quickshell
# instances may belong to another compositor or a preview, so match both the
# current Hyprland instance and Omarchy's shell path.
if [[ ! -e $claim ]]; then
  proc_root=${OMARCHY_PROC_ROOT:-/proc}
  for pid in $(pgrep -u "$UID" -x quickshell 2>/dev/null); do
    process_dir="$proc_root/$pid"
    if [[ -r $process_dir/environ && -r $process_dir/cmdline ]] &&
      tr '\0' '\n' <"$process_dir/environ" | grep -Fxq "HYPRLAND_INSTANCE_SIGNATURE=$HYPRLAND_INSTANCE_SIGNATURE" &&
      tr '\0' '\n' <"$process_dir/cmdline" | grep -Fxq "$OMARCHY_PATH/shell"; then
      mkdir -- "$claim" 2>/dev/null || true
      exit 1
    fi
  done
fi

mkdir -- "$claim" 2>/dev/null

#!/bin/bash

# omarchy:summary=Install Spotify, as its web player where Spotify has no Linux client.
# omarchy:requires-sudo=true

set -e

if omarchy-hw-x86; then
  echo "Installing Spotify..."
  omarchy-pkg-add spotify

  # Spotify's bundled Chromium crashes its GPU process under XWayland (an
  # upstream Spotify/CEF bug since 1.3.4.258); native Wayland avoids it. Give
  # it the same Wayland default the browsers get, keeping the user's own flags.
  spotify_flags_file="$HOME/.config/spotify-flags.conf"

  if [[ ! -f $spotify_flags_file ]]; then
    mkdir -p "$HOME/.config"
    cp "$OMARCHY_PATH/config/spotify-flags.conf" "$spotify_flags_file"
  elif ! grep -q -- '^--ozone-platform=' "$spotify_flags_file"; then
    [[ -n $(tail -c1 "$spotify_flags_file") ]] && echo >>"$spotify_flags_file"
    echo '--ozone-platform=wayland' >>"$spotify_flags_file"
  fi

  echo "Opening Spotify..."
  setsid uwsm-app -- /usr/bin/spotify >/dev/null 2>&1 &
else
  # Spotify builds its Linux client for x86_64 only (its repository serves amd64
  # and i386), so ARM gets the web player, which Chromium plays with the Widevine
  # module it fetches itself.
  echo "Installing Spotify as a web app..."
  omarchy-webapp-install "Spotify" "https://open.spotify.com/" "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/spotify.png"

  echo "Opening Spotify..."
  setsid omarchy-launch-webapp "https://open.spotify.com/" >/dev/null 2>&1 &
fi

echo ""
echo "Spotify has been installed."

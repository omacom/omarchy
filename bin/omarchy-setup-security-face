#!/bin/bash

# omarchy:summary=Set up Howdy face recognition authentication for lock screen
# omarchy:requires-sudo=true

set -e

HOWDY_DIR="/lib/security/howdy"
PAM_FILE="/etc/pam.d/omarchy-lock-howdy"
CAMERA_DEVICE=""
TARGET_USER="${SUDO_USER:-$USER}"

configure_ir_emitter() {
  # If an IR emitter tool is present or installable, ensure it is configured.
  # Only track management if we are enabling a service that was not already enabled.
  if omarchy-cmd-present linux-enable-ir-emitter; then
    echo "Configuring hardware IR emitter..."
    sudo linux-enable-ir-emitter configure || true
    if systemctl list-unit-files 2>/dev/null | grep -q linux-enable-ir-emitter; then
      if ! systemctl is-enabled linux-enable-ir-emitter.service &>/dev/null; then
        sudo mkdir -p /var/lib/omarchy
        sudo touch /var/lib/omarchy/face-ir-emitter-enabled
        omarchy-state set face-ir-emitter-enabled 2>/dev/null || true
        sudo systemctl enable --now linux-enable-ir-emitter.service || true
      fi
    fi
  fi
}

resolve_howdy_config() {
  # The config home moved between Howdy builds: master (r592+) uses
  # /etc/howdy, the older packaged layout used /lib/security/howdy, and the
  # beta was seen writing to /usr/local/etc/howdy. Probe all three and return
  # whichever config this build actually created — the CLI and its PAM module
  # always agree with each other.
  local config
  for config in /etc/howdy/config.ini "$HOWDY_DIR/config.ini" /usr/local/etc/howdy/config.ini; do
    if [[ -f $config ]]; then
      echo "$config"
      return 0
    fi
  done
  return 1
}

configure_howdy_settings() {
  local config_file
  config_file=$(resolve_howdy_config)
  if [[ -z $config_file ]]; then
    echo "Howdy config not found; skipping tuning."
    return 0
  fi

  echo "Optimizing Howdy settings for lock screen responsiveness..."
  # Clean up notices and synthetic inputs that glitch GUI lock screens, keep
  # the dark-frame threshold IR-friendly, and never store face snapshots.
  sudo sed -i -E \
    -e 's/^[# ]*detection_notice\s*=.*/detection_notice = false/' \
    -e 's/^[# ]*timeout_notice\s*=.*/timeout_notice = false/' \
    -e 's/^[# ]*no_confirmation\s*=.*/no_confirmation = true/' \
    -e 's/^[# ]*suppress_unknown\s*=.*/suppress_unknown = true/' \
    -e 's/^[# ]*dark_threshold\s*=.*/dark_threshold = 90/' \
    -e 's/^[# ]*max_height\s*=.*/max_height = 320/' \
    -e 's/^[# ]*timeout\s*=.*/timeout = 3/' \
    -e 's/^[# ]*capture_failed\s*=.*/capture_failed = false/' \
    -e 's/^[# ]*capture_successful\s*=.*/capture_successful = false/' \
    "$config_file"

  # Find stable IR camera path if not already configured
  local ir_device
  ir_device=$(find_ir_device) || ir_device=""
  if [[ -n $ir_device ]]; then
    CAMERA_DEVICE="$ir_device"
    echo "Found IR camera device: $ir_device"
    sudo sed -i -E "s|^[# ]*device_path\s*=.*|device_path = $ir_device|" "$config_file"
  fi
}

is_ir_device() {
  local dev="$1"
  [[ -e $dev ]] || return 1

  # Resolve sysfs directory for this node
  local real_node real_sys
  if [[ -d $dev && -r $dev/name ]]; then
    real_sys="$dev"
  else
    real_node=$(readlink -f "$dev" 2>/dev/null || echo "$dev")
    real_sys="${V4L_SYSFS:-/sys/class/video4linux}/${real_node##*/}"
  fi

  local has_ir_identity=false
  if [[ -d $real_sys ]]; then
    if [[ -r $real_sys/device/interface ]]; then
      local interface
      interface=$(<"$real_sys/device/interface")
      if [[ ${interface,,} =~ (^|[^a-z0-9])(ir|infrared|realsense)([^a-z0-9]|$) ]]; then
        has_ir_identity=true
      fi
    fi
    if [[ -r $real_sys/name ]]; then
      local name
      name=$(<"$real_sys/name")
      local name_lower=${name,,}
      if [[ $name_lower =~ (^|[^a-z0-9])(ir|infrared|realsense)([^a-z0-9]|$) ]] || [[ $name_lower == *hm1092* || $name_lower == *ov01a1s* ]]; then
        has_ir_identity=true
      fi
    fi
  fi

  local formats="" active_fmt=""
  if command -v v4l2-ctl &>/dev/null; then
    formats=$(v4l2-ctl --device="$dev" --list-formats 2>/dev/null || true)
    active_fmt=$(v4l2-ctl --device="$dev" --get-fmt-video 2>/dev/null | grep -i 'Pixel Format' || true)
  fi

  # Active capture stream check: if the driver defaults to visible color (MJPG/YUYV/RGB),
  # OpenCV will ingest visible frames, defeating IR-only protection. The active capture
  # format must be a verified infrared or depth format.
  if [[ -n $active_fmt ]] && ! echo "$active_fmt" | grep -qE "'(GREY|Z16 |INVZ|INVR|INVO|Y10P|Y10 |Y12 |Y16 )'"; then
    return 1
  fi

  # 1. Affirmative IR identity: accepted when node supports an IR format or when formats are unprobed.
  if [[ $has_ir_identity == true ]]; then
    if [[ -z $formats ]] || echo "$formats" | grep -qE "'(GREY|Z16 |INVZ|INVR|INVO|Y10P|Y10 |Y12 |Y16 )'"; then
      return 0
    fi
    return 1
  fi

  # 2. Dedicated raw depth and infrared sensor formats that visible webcams do not expose.
  if [[ -n $formats ]] && echo "$formats" | grep -qE "'(Z16 |INVZ|INVR|INVO|Y10P|Y10 |Y12 |Y16 )'"; then
    return 0
  fi

  # 3. For generic devices lacking explicit IR identity: reject consumer RGB/color video formats.
  if [[ -n $formats ]] && echo "$formats" | grep -qE "'(MJPG|RGB3|BGR3|NV12|RGB4|BGR4)'"; then
    return 1
  fi

  # 4. Standard GREY format on generic nodes requires hardware IR corroboration (e.g. UVC Extension units).
  if [[ -n $formats ]] && echo "$formats" | grep -qE "'GREY'"; then
    if command -v v4l2-ctl &>/dev/null && v4l2-ctl --device="$dev" --all 2>/dev/null | grep -qiE 'Extension|infrared|(\b|_)ir(\b|_)'; then
      return 0
    fi
  fi

  return 1
}
find_ir_device() {
  local dev
  # /dev/v4l/by-path is the stable naming (ArchWiki), and the same path the
  # IR emitter tool expects.
  if [[ -d /dev/v4l/by-path ]]; then
    for dev in /dev/v4l/by-path/*; do
      [[ -e $dev ]] || continue
      if is_ir_device "$dev" && can_capture_device "$dev"; then
        echo "$dev"
        return 0
      fi
    done
  fi

  # Fallback to direct video nodes if by-path symlinks are unavailable
  for dev in /dev/video*; do
    [[ -e $dev ]] || continue
    if is_ir_device "$dev" && can_capture_device "$dev"; then
      echo "$dev"
      return 0
    fi
  done

  return 1
}

# Copy config and enrolled models to the path the PAM module reads, in case
# this build's CLI wrote them to /usr/local/etc/howdy instead.
normalize_howdy_paths() {
  [[ -d /usr/local/etc/howdy ]] || return 0
  sudo mkdir -p "$HOWDY_DIR"
  if [[ -f /usr/local/etc/howdy/config.ini && ! -f $HOWDY_DIR/config.ini ]]; then
    sudo cp -a /usr/local/etc/howdy/config.ini "$HOWDY_DIR/config.ini"
  fi
  if [[ -d /usr/local/etc/howdy/models && ! -d $HOWDY_DIR/models ]]; then
    sudo cp -a /usr/local/etc/howdy/models "$HOWDY_DIR/models"
  fi
}

can_capture_device() {
  local dev="$1"
  [[ -e $dev ]] || return 1
  if command -v v4l2-ctl &>/dev/null; then
    local active_fmt
    active_fmt=$(v4l2-ctl --device="$dev" --get-fmt-video 2>/dev/null | grep -i 'Pixel Format' || true)
    if [[ -n $active_fmt ]] && ! echo "$active_fmt" | grep -qE "'(GREY|Z16 |INVZ|INVR|INVO|Y10P|Y10 |Y12 |Y16 )'"; then
      return 1
    fi
  fi
  timeout 5 v4l2-ctl --device="$dev" --stream-mmap --stream-count=1 --stream-to=/dev/null >/dev/null 2>&1
}

verify_camera_capture() {
  # Detection only proves an IR sensor exists, not that it can deliver frames.
  # Grab one frame from the IR device Howdy is configured to read.
  # If that device cannot stream, search for a working alternate IR device and update Howdy's
  # configured device_path. Plain RGB webcams are strictly rejected.
  local config_file working_dev=""
  config_file=$(resolve_howdy_config) || config_file=""

  local configured_dev="$CAMERA_DEVICE"
  if [[ -z $configured_dev && -n $config_file && -f $config_file ]]; then
    configured_dev=$(grep -E '^[# ]*device_path\s*=' "$config_file" | head -1 | sed -E 's/^[# ]*device_path\s*=\s*//')
    [[ $configured_dev == "none" ]] && configured_dev=""
  fi

  if [[ -n $configured_dev ]] && is_ir_device "$configured_dev" && can_capture_device "$configured_dev"; then
    CAMERA_DEVICE="$configured_dev"
    return 0
  fi

  # Search for a functioning Windows Hello IR camera.
  working_dev=$(find_ir_device) || working_dev=""

  if [[ -n $working_dev ]]; then
    CAMERA_DEVICE="$working_dev"
    if [[ -n $config_file && -f $config_file ]]; then
      echo "Configured working IR camera device: $working_dev"
      sudo sed -i -E "s|^[# ]*device_path\s*=.*|device_path = $working_dev|" "$config_file"
    fi
    return 0
  fi

  return 1
}

verify_enrollment() {
  # Enrollment must leave a model specifically for TARGET_USER behind;
  # an empty models directory or other users' models cannot satisfy this user's enrollment.
  local config dir
  config=$(resolve_howdy_config) || config=""
  if [[ -n $config ]]; then
    dir="$(dirname "$config")/models"
    if [[ -d $dir && -s "$dir/${TARGET_USER}.dat" ]]; then
      return 0
    fi
  fi
  for dir in /etc/howdy/models "$HOWDY_DIR/models" /usr/local/etc/howdy/models; do
    if [[ -d $dir && -s "$dir/${TARGET_USER}.dat" ]]; then
      return 0
    fi
  done
  return 1
}

setup_lock_howdy_pam() {
  # Only ever write a PAM file that points at a module that exists.
  if [[ ! -f /lib/security/pam_howdy.so ]]; then
    echo -e "\e[31m/lib/security/pam_howdy.so is missing; refusing to enable face PAM.\e[0m"
    exit 1
  fi
  echo "Configuring lock screen for face authentication..."
  sudo tee "$PAM_FILE" >/dev/null <<'EOF'
#%PAM-1.0
auth       sufficient  /lib/security/pam_howdy.so
account    include     system-local-login
EOF
}

run_setup() {
  echo -e "\e[32mSetting up face recognition for lock screen authentication.\n\e[0m"

  # Install v4l-utils first so pixel format and hardware validation can inspect camera nodes
  echo "Checking hardware dependencies..."
  if ! omarchy-pkg-add v4l-utils; then
    echo -e "\e[31mFailed to install v4l-utils.\e[0m"
    exit 1
  fi

  # Bail before installing Howdy if there is no Windows Hello compatible IR sensor
  if ! omarchy-hw-face; then
    echo -e "\e[31mNo Windows Hello compatible IR face sensor detected.\e[0m"
    echo -e "\e[31mHowdy face authentication requires an infrared (IR) sensor to prevent photo spoofing.\e[0m"
    exit 1
  fi

  # Install Howdy from the AUR — ArchWiki notes the plain howdy package is
  # outdated; howdy-git ships the compiled /lib/security/pam_howdy.so module.
  # Building its python-dlib/OpenCV dependency chain can take several minutes.
  echo "Installing Howdy face authentication (AUR build, this can take a while)..."
  if ! omarchy-pkg-aur-add howdy-git; then
    echo -e "\e[31mHowdy installation failed. Run 'omarchy remove security face' to clean up partial installation.\e[0m"
    exit 1
  fi

  configure_ir_emitter
  configure_howdy_settings

  # Verify the camera delivers frames before asking for a face.
  echo "Verifying the camera can capture frames..."
  if ! verify_camera_capture; then
    echo -e "\e[31mCamera check failed: no Windows Hello compatible IR camera produced video frames.\e[0m"
    echo -e "\e[31mHowdy face authentication requires an infrared (IR) sensor to prevent photo spoofing.\e[0m"
    echo -e "\e[31mHowdy packages were installed but face authentication was not enabled.\e[0m"
    echo -e "\e[31mRun 'omarchy remove security face' to clean up partial installation.\e[0m"
    exit 1
  fi

  # Enroll the baseline model, unless this build already has one for TARGET_USER
  if verify_enrollment; then
    echo -e "\e[32mExisting face model found for $TARGET_USER; skipping enrollment.\e[0m"
  else
    echo -e "\e[32m\nStep 1: Baseline Face Model\e[0m"
    echo -e "Look straight at the camera with normal lighting.\n"

    if sudo howdy -U "$TARGET_USER" add; then
      if ! verify_enrollment; then
        echo -e "\e[31mEnrollment completed but no face model was stored for $TARGET_USER. Please try again.\e[0m"
        echo -e "\e[31mRun 'omarchy remove security face' to clean up.\e[0m"
        exit 1
      fi
      echo -e "\e[32m\nBaseline model enrolled successfully!\e[0m"
    else
      echo -e "\e[31m\nFace enrollment failed. Please try again.\e[0m"
      echo -e "\e[31mRun 'omarchy remove security face' to clean up partial installation.\e[0m"
      exit 1
    fi
  fi

  normalize_howdy_paths
  setup_lock_howdy_pam

  # Offer optional multi-angle / lighting enrollment
  echo -e "\n\e[34mTip: Enrolling a second angle (e.g. low-light or slouched posture) ensures instant unlock in all conditions.\e[0m"
  read -r -p "Would you like to enroll an additional face angle now? (y/N) " -n 1 || true
  echo ""

  if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo -e "\e[32m\nStep 2: Secondary Face Model\e[0m"
    echo -e "Look at the camera from a slight angle, with glasses, or in dimmer light.\n"
    sudo howdy -U "$TARGET_USER" add || true
    normalize_howdy_paths
  fi

  echo -e "\e[32m\nPerfect! Face authentication is now completely configured.\e[0m"
  echo "You can unlock your lock screen (Super + L) instantly by looking at the camera."
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  run_setup "$@"
fi

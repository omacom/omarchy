#!/bin/bash

# omarchy:summary=List the games in ~/Games/vibes under the Game Vibes launcher

# Game Vibes lists the games Omarchy ships, in default/games/vibes, and the
# ones made here, in ~/Games/vibes/<name>/index.html. This writes
# ~/Games/vibes/index.html, the page that lists them, and the one Game Vibes
# launcher that opens it, so a new game needs no launcher of its own.

set -euo pipefail

vibes="$HOME/Games/vibes"
mkdir -p "$vibes" "$HOME/.local/share/applications"

# A game is a folder named like a command, holding an index.html. One made
# here replaces the shipped game of its name, as a copy to keep working on
# does. Its title is the page's <title>.
declare -A games=()
for page in "$OMARCHY_PATH/default/games/vibes"/*/index.html "$vibes"/*/index.html; do
  [[ -f $page ]] || continue
  dir=${page%/index.html}
  name=${dir##*/}
  [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] && games[$name]=$dir
done

# The list goes into the page as JSON with every < escaped, so a title can't
# end the script it sits in. Each game is linked by its folder's file URL.
for name in "${!games[@]}"; do
  dir=${games[$name]}
  title=$(sed -n 's:.*<title>\(.*\)</title>.*:\1:p' "$dir/index.html" | head -1 | tr -d '\t')
  icon=false
  [[ -f $dir/icon.svg ]] && icon=true
  printf '%s\t%s\t%s\t%s\n' "$name" "${title:-$name}" "$icon" "$dir"
done | sort | jq -Rrn --rawfile page "$OMARCHY_PATH/default/games/vibes.html" '
  [inputs | split("\t") | {name: .[0], title: .[1], icon: (.[2] == "true"),
    url: ("file://" + (.[3] | split("/") | map(@uri) | join("/")))}]
  | tojson | gsub("<"; "\\u003c") as $games
  | $page | sub("/\\*GAMES\\*/\\[\\]"; $games)' >"$vibes/index.html"

url="file://$(jq -rn --arg path "$vibes/index.html" '$path | split("/") | map(@uri) | join("/")')"
cat >"$HOME/.local/share/applications/Game Vibes.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Game Vibes
Comment=Little games to play, and to keep making with an agent
Exec=omarchy-games-vibes-launch
Icon=omarchy-game-vibes
Categories=Game;
Terminal=false
StartupNotify=true
StartupWMClass=$(omarchy-webapp-window-class "$url")
EOF

echo "Game Vibes in the app launcher (Super + Space) has ${#games[@]} games."

#!/bin/bash

# omarchy:summary=Returns true when the compositor holds a session lock no other locker is alive to own
# omarchy:args=<own-pid>
# omarchy:hidden=true

# Hyprland lets any client take over a held lock (misc:allow_session_lock_restore),
# so a shell that recovers a lock it merely sees can take the live lock screen of
# another shell, and strand it when it exits. A lock is stranded only while no
# other Omarchy shell or hyprlock is running; until then the answer is undetermined,
# so the caller keeps asking until that locker exits or it gives up.
#
# An Omarchy shell is one whose config sits in an Omarchy tree, this checkout's or
# another's. Any other Quickshell config, like a dictation overlay, never takes the
# lock, and counting it would leave a stranded lock waiting on it for good.
#
# Exits 0 stranded, 1 unlocked, 2 undetermined. The caller passes its own pid,
# as a crash re-execs the shell in place.
omarchy-hyprland-session-locked || exit

if ! instances=$(quickshell list -a -j 2>/dev/null); then
  exit 2
fi

if [[ $instances == "No running instances." ]]; then
  instances="[]"
fi

# Empty output parses as no input at all, which would read as no locker alive.
if ! jq -e 'type == "array"' <<<"$instances" >/dev/null 2>&1; then
  exit 2
fi

if ! shells=$(jq -r '.[] | select(.config_path | endswith("/shell/shell.qml")) | "\(.pid) \(.config_path | rtrimstr("/shell/shell.qml"))"' <<<"$instances" 2>/dev/null); then
  exit 2
fi

while read -r pid tree; do
  if [[ -n $pid && $pid != "$1" && -x $tree/bin/omarchy-launch-shell ]]; then
    exit 2
  fi
done <<<"$shells"

if pgrep -u "$UID" -x hyprlock >/dev/null; then
  exit 2
fi

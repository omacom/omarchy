#!/bin/bash

# omarchy:summary=Open the Omarchy Server home menu
# omarchy:group=server
# omarchy:examples=omarchy server menu

set -uo pipefail

if ! omarchy-edition server; then
  printf 'omarchy-server-menu is for the server edition.\n' >&2
  exit 1
fi

while true; do
  choice=$(gum choose "Status" "Docker" "Services" "Update" "Logs" "Network" "Shell") || exit 0

  case $choice in
  Status) btop ;;
  Docker) lazydocker ;;
  Services) systemctl list-units --type=service --state=running | less ;;
  Update) omarchy-update ;;
  Logs)
    if omarchy-cmd-present lazyjournal; then
      lazyjournal
    else
      journalctl -xe | less
    fi
    ;;
  Network)
    echo "hostname: $(hostname)"
    ip -br addr
    printf '%s\n' "firewall: run omarchy setup security"
    read -r -p "Enter to return..."
    ;;
  "Shell" | "") exit 0 ;;
  esac
done

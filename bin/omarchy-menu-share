#!/bin/bash

# omarchy:summary=Share text, clipboard, files, or folders with LocalSend
# omarchy:group=share
# omarchy:name=
# omarchy:args=<text|clipboard|file|folder> [message|path...]
# omarchy:examples=omarchy share text | omarchy share text "Hello" | omarchy share clipboard | omarchy share file ~/Downloads/example.txt

if (($# == 0)); then
  echo "Usage: omarchy-menu-share [text|clipboard|file|folder] [message|path...]"
  exit 1
fi

MODE="$1"
shift

if [[ $MODE == "text" ]]; then
  if (($# > 0)); then
    text="$*"
  else
    text=$(/usr/bin/python3 "$OMARCHY_PATH/default/localsend/share-text.py") || status=$?
    if ((${status:-0} > 1)); then
      omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNotText)" "$(omarchy-i18n share.composerClosed)"
      exit 1
    fi
    if ((${status:-0} == 1)); then
      exit 0
    fi
  fi

  [[ -n ${text//[[:space:]]/} ]] || exit 0
elif [[ $MODE == "clipboard" ]]; then
  # LocalSend 1.18+ stages clipboard content as native text, without a temp file.
  if ! text=$(wl-paste); then
    omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNot)" "$(omarchy-i18n share.clipboardReadFailed)"
    exit 1
  fi
elif (($# > 0)); then
  FILE_ARRAY=("$@")
else
  if [[ $MODE == "folder" ]]; then
    select_args=(--title "$(omarchy-i18n share.folderTitle)" --directory)
  else
    select_args=(--title "$(omarchy-i18n share.filesTitle)" --multiple)
  fi

  # Command substitution so the chooser's exit status survives: reading it
  # through a process substitution reports success for a chooser that never
  # opened, which is indistinguishable here from someone deciding not to share.
  picked=$(omarchy-file-select "${select_args[@]}") || status=$?

  if ((${status:-0} > 1)); then
    omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNot)" "$(omarchy-i18n share.chooserClosed)"
    exit 1
  fi

  [[ -n $picked ]] || exit 0
  readarray -t FILE_ARRAY <<<"$picked"
fi

# Run LocalSend in its own systemd service (detached from terminal)
if [[ $MODE == "text" || $MODE == "clipboard" ]]; then
  # Linux limits a single argument to 128 KiB on 4 KiB-page systems. Leave
  # room for the protective space/NUL and use a private file from 64 KiB.
  # Count bytes, not characters, so multibyte clipboard text is safe too.
  text_needs_file() {
    local LC_ALL=C
    ((${#text} >= 64 * 1024))
  }

  text_dir=""
  if text_needs_file; then
    text_dir=$(umask 077; mktemp -d "${TMPDIR:-/tmp}/omarchy-share-text.XXXXXX") || status=$?
    if [[ -z $text_dir ]] || ! (umask 077; printf '%s' "$text" > "$text_dir/message.txt"); then
      if [[ -n $text_dir ]]; then
        rm -f -- "$text_dir/message.txt"
        rmdir -- "$text_dir"
      fi
      omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNotText)" "$(omarchy-i18n share.localsendNotOpened)"
      exit 1
    fi
    share_command=(localsend --headless send "$text_dir/message.txt")
  else
    # LocalSend checks flags before consuming --text, then trims its value.
    share_command=(localsend --text " $text")
  fi

  # Successful scheduling does not mean LocalSend itself can start. Keep its
  # exit check and private-file cleanup inside the detached service. Fixed
  # descriptions exclude text from systemd's start/stop descriptions, but
  # native text arguments can still appear in process lists/journal _CMDLINE.
  # shellcheck disable=SC2016 # The service shell expands its own arguments.
  systemd-run --user --quiet --collect --expand-environment=no --description="Share text with LocalSend" /bin/bash -c '
    text_dir=$1
    shift
    cleanup_text_file() {
      if [[ -n $text_dir ]]; then
        rm -f -- "$text_dir/message.txt"
        rmdir -- "$text_dir"
      fi
    }
    trap cleanup_text_file EXIT
    if "$@"; then
      exit 0
    else
      status=$?
      omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNotText)" "$(omarchy-i18n share.localsendExited)"
      exit "$status"
    fi
  ' omarchy-share-text "$text_dir" "${share_command[@]}" || status=$?
  if ((${status:-0} > 0)); then
    if [[ -n $text_dir ]]; then
      rm -f -- "$text_dir/message.txt"
      rmdir -- "$text_dir"
    fi
    omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNotText)" "$(omarchy-i18n share.localsendNotOpened)"
    exit "$status"
  fi
else
  if ! systemd-run --user --quiet --collect localsend --headless send "${FILE_ARRAY[@]}"; then
    omarchy-notification-send -g "" -u critical "$(omarchy-i18n share.couldNot)" "$(omarchy-i18n share.localsendFailed)"
    exit 1
  fi
fi

exit 0

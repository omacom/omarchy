#!/bin/bash

# omarchy:summary=Show, list, or set how much RAM the firmware sets aside as AMD GPU VRAM
# omarchy:args=[list|set]
# omarchy:requires-sudo=true

set -euo pipefail

# An AMD APU's firmware carves dedicated VRAM out of RAM before Linux boots.
# Omarchy shrinks it to the smallest option, so the GPU can map the rest of RAM
# on demand for large local models; see omarchy-apply-amd-gpu-memory. If that
# leaves a game or driver short of VRAM, pick a larger carveout here from the
# options the firmware offers; it accepts no other size. Only firmware that
# lets amdgpu change it has uma/carveout, and a new size, along with the GPU
# memory cap sized for it, applies from the next boot.

pci_devices_path="${OMARCHY_PCI_DEVICES_PATH:-/sys/bus/pci/devices}"

usage() {
  echo "Usage: omarchy-device-gpu-vram [list|set]" >&2
  exit 1
}

shopt -s nullglob
gpu_device=""
for device in "$pci_devices_path"/*; do
  if [[ -f $device/uma/carveout && -f $device/uma/carveout_options ]]; then
    gpu_device=$device
    break
  fi
done

if [[ -z $gpu_device ]]; then
  echo "This machine's firmware doesn't let Linux change the GPU's dedicated VRAM." >&2
  exit 1
fi

# The firmware's options, from lines like "0: Minimum (512 MB)", as parallel
# lists of index and size; only these can be written to uma/carveout.
indexes=() sizes=()
while read -r option_index option_size; do
  indexes+=("$option_index")
  sizes+=("$option_size")
done < <(awk 'match($0, /\([0-9]+ (MB|GB)\)/) { print $1 + 0, substr($0, RSTART + 1, RLENGTH - 2) }' "$gpu_device/uma/carveout_options")

# The size of an option index, or nothing for one the firmware doesn't list.
option_size() {
  local i
  for i in "${!indexes[@]}"; do
    if [[ ${indexes[i]} == "$1" ]]; then
      echo "${sizes[i]}"
    fi
  done
}

current=$(< "$gpu_device/uma/carveout")
current_size=$(option_size "$current")

case ${1:-} in
  "")
    (( $# == 0 )) || usage
    echo "Dedicated VRAM this boot: $(( $(< "$gpu_device/mem_info_vram_total") / 1024 / 1024 )) MB"
    echo "Dedicated VRAM from the next boot: ${current_size:-unknown}"
    ;;
  list)
    (( $# == 1 )) || usage
    for size in "${sizes[@]}"; do
      if [[ $size == "$current_size" ]]; then
        echo "* $size"
      else
        echo "  $size"
      fi
    done
    ;;
  set)
    (( $# == 1 )) || usage
    choice=$(gum choose --header "Dedicated VRAM from the next boot" --selected "$current_size" "${sizes[@]}") || exit 1

    index=""
    for i in "${!sizes[@]}"; do
      if [[ ${sizes[i]} == "$choice" ]]; then
        index=${indexes[i]}
      fi
    done
    [[ -n $index ]] || exit 1

    sudo env PATH="$PATH" omarchy-apply-amd-gpu-memory "$index"

    log=$(mktemp)
    trap 'rm -f "$log"' EXIT
    rebuilt=true
    sudo limine-mkinitcpio 2>&1 | tee "$log" || rebuilt=false

    # limine-mkinitcpio reports a kernel it could not rebuild and still exits 0.
    if [[ $rebuilt == "false" ]] || grep -q 'mkinitcpio failed for kernel' "$log"; then
      echo "Could not rebuild the boot image; run omarchy-device-gpu-vram set again once that is fixed." >&2
      exit 1
    fi

    omarchy-state set reboot-required
    echo "The GPU gets $choice of dedicated VRAM from the next boot."

    if gum confirm "Reboot to apply new VRAM limit?"; then
      omarchy-system reboot
    fi
    ;;
  *) usage ;;
esac

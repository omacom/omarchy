#!/bin/bash

# omarchy:summary=Keep YouTube on H.264 in Chromium on computers whose GPU can't decode AV1

set -euo pipefail

# YouTube serves AV1 when the browser says it can play it, and a GPU without AV1
# decoding then plays it on the CPU. The enhanced-h264ify extension hides AV1,
# VP9 and VP8 from YouTube, so it sends H.264, which those GPUs decode in hardware.
# Other machines keep YouTube's choice.
extension="$OMARCHY_PATH/default/chromium/hardware-extensions/enhanced-h264ify"
conf=~/.config/chromium-flags.conf

# Chromium's launcher splits each line into arguments, so a switch can share a
# line with others or end in a comment. Look for switches with comments removed.
chromium_args() {
  sed -E 's/(^|[[:space:]])#.*$//' "$1"
}

# Google Chrome ignores --load-extension, so it isn't set up here.
setup_chromium() {
  [[ -f $conf ]] || return 0

  if chromium_args "$conf" | grep -F -- "$extension" >/dev/null; then
    return 0
  fi

  if chromium_args "$conf" | grep -E -- '(^|[[:space:]])--load-extension=' >/dev/null; then
    # Extend the list itself, ahead of any neighbouring switch or comment.
    sed -i --follow-symlinks -E \
      -e "s|^(([^#]*[[:space:]])?--load-extension=[^[:space:]#]*)|\1,$extension|" \
      -e "s|--load-extension=,$extension|--load-extension=$extension|" "$conf"
  else
    # Start a new line first if the file doesn't end in a newline.
    if [[ -n $(tail -c1 "$conf") ]]; then
      echo >>"$conf"
    fi
    printf '%s\n' "--load-extension=$extension" >>"$conf"
  fi
}

if omarchy-hw-intel-no-av1-decode; then
  setup_chromium
fi

#!/bin/bash

# omarchy:summary=Print the boot loader whose boot images Omarchy manages: systemd-boot, limine or none
# omarchy:args=[--managed]
# omarchy:hidden=true

# systemd-boot once omarchy-boot-switch made it the loader the firmware starts,
# limine on a machine still booting Limine. --managed prints every loader whose
# boot images have to be kept current: both while a switch is on trial, when
# the firmware still starts Limine but systemd-boot is staged next to it.

state=${OMARCHY_BOOT_STORE:-/var/lib/omarchy/boot}/state
phase=$(sed -n 's/^phase=//p' "$state" 2>/dev/null | tail -1)
has_limine() { omarchy-cmd-present limine-entry-tool; }

case $phase in
promoted | active)
  echo systemd-boot
  ;;
staged | trial | trial-failed)
  if [[ ${1:-} == --managed ]]; then
    has_limine && echo limine
    echo systemd-boot
  elif has_limine; then
    echo limine
  else
    echo none
  fi
  ;;
*)
  if has_limine; then
    echo limine
  else
    echo none
  fi
  ;;
esac

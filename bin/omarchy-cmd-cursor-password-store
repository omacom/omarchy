#!/bin/bash

# omarchy:summary=Pin Cursor's password store to gnome-libsecret in argv.json
# omarchy:args=[--if-installed] [argv.json]
# omarchy:hidden=true

set -euo pipefail

# Cursor reads ~/.cursor/argv.json on every architecture. On x86_64 its Arch
# launcher also reads electron flags; on aarch64 cursor-bin keeps the bundled
# launcher, which does not. This is the pin that covers both.
# --if-installed creates a missing file only when Cursor itself is installed.
# An argv.json that already exists, including as a symlink, is still updated.
if_installed=false
if [[ ${1:-} == "--if-installed" ]]; then
  if_installed=true
  shift
fi

argv=${1:-$HOME/.cursor/argv.json}

if [[ $if_installed == "true" && ! -e $argv && ! -L $argv ]]; then
  if ! omarchy-pkg-present cursor-bin && ! omarchy-cmd-present cursor; then
    exit 0
  fi
fi

if [[ ! -L $argv && -e $argv && ! -f $argv ]]; then
  echo "Cursor password store: $argv is not a regular file" >&2
  exit 1
fi

python3 - "$argv" <<'PY'
import json
import os
import re
import sys
from pathlib import Path

path = Path(sys.argv[1])
key_line = '"password-store": "gnome-libsecret"'
template = """// This configuration file allows you to pass permanent command line arguments to VS Code.
// Only a subset of arguments is currently supported to reduce the likelihood of breaking
// the installation.
//
// PLEASE DO NOT CHANGE WITHOUT UNDERSTANDING THE IMPACT
//
// NOTE: Changing this file requires a restart of VS Code.
{
  "password-store": "gnome-libsecret"
}
"""


def fail(message):
    print(f"Cursor password store: {message}", file=sys.stderr)
    raise SystemExit(1)


def tokenize(text):
    tokens = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if c in " \t\r\n":
            i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            i += 2
            while i < n and text[i] != "\n":
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            i += 2
            while i + 1 < n and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            if i + 1 >= n:
                return None
            i += 2
            continue
        if c == '"':
            start = i
            i += 1
            while i < n:
                if text[i] == "\\":
                    i += 2
                    continue
                if text[i] == '"':
                    i += 1
                    tokens.append(("string", text[start:i], start, i))
                    break
                if text[i] == "\n":
                    return None
                i += 1
            else:
                return None
            continue
        if c in "{}[],:":
            tokens.append((c, c, i, i + 1))
            i += 1
            continue
        if c == "-" or c.isdigit():
            start = i
            i += 1
            while i < n and text[i] in "0123456789.eE+-":
                i += 1
            if not re.fullmatch(r"-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?", text[start:i]):
                return None
            tokens.append(("number", text[start:i], start, i))
            continue
        matched = False
        for word in ("true", "false", "null"):
            end = i + len(word)
            if text.startswith(word, i) and (end >= n or not (text[end].isalnum() or text[end] == "_")):
                tokens.append(("literal", word, i, end))
                i = end
                matched = True
                break
        if not matched:
            return None
    return tokens


def string_value(token):
    try:
        value = json.loads(token)
    except json.JSONDecodeError:
        return None
    if not isinstance(value, str):
        return None
    return value


def analyze(tokens):
    """Return 'set', ('absent', close_index), 'empty', or 'invalid'.

    'set' means the root object already has a password-store key. A key inside
    a comment, a string, or a nested object does not count.
    """
    if not tokens:
        return "empty"
    if tokens[0][0] != "{":
        return "invalid"

    # The opening brace is tokens[0]; the stack already accounts for it.
    stack = ["obj"]
    expects = ["key_or_end"]
    key_set = False
    i = 1
    while i < len(tokens):
        kind, value, _start, _end = tokens[i]
        container = stack[-1]
        expect = expects[-1]

        if container == "obj" and expect == "key_or_end":
            if kind == "}":
                stack.pop()
                expects.pop()
                if not stack:
                    if i != len(tokens) - 1:
                        return "invalid"
                    if key_set:
                        return "set"
                    return ("absent", i)
                expects[-1] = "comma_or_end"
                i += 1
                continue
            if kind != "string":
                return "invalid"
            if len(stack) == 1 and string_value(value) == "password-store":
                key_set = True
            expects[-1] = "colon"
            i += 1
            continue

        if container == "obj" and expect == "colon":
            if kind != ":":
                return "invalid"
            expects[-1] = "value"
            i += 1
            continue

        if expect == "value" or (container == "arr" and expect == "value_or_end" and kind != "]"):
            if kind == "{":
                stack.append("obj")
                expects.append("key_or_end")
                i += 1
                continue
            if kind == "[":
                stack.append("arr")
                expects.append("value_or_end")
                i += 1
                continue
            if kind in ("string", "number", "literal"):
                expects[-1] = "comma_or_end"
                i += 1
                continue
            return "invalid"

        if container == "arr" and expect == "value_or_end" and kind == "]":
            stack.pop()
            expects.pop()
            if not stack:
                return "invalid"
            expects[-1] = "comma_or_end"
            i += 1
            continue

        if expect == "comma_or_end":
            if kind == ",":
                expects[-1] = "key_or_end" if container == "obj" else "value_or_end"
                i += 1
                continue
            # A closer after a value is the same closer key_or_end / value_or_end
            # handles. Revisit this token in that state instead of popping here.
            if container == "obj" and kind == "}":
                expects[-1] = "key_or_end"
                continue
            if container == "arr" and kind == "]":
                expects[-1] = "value_or_end"
                continue
            return "invalid"

        return "invalid"

    return "invalid"


def newline_of(text):
    if "\r\n" in text:
        return "\r\n"
    return "\n"


def indent_of(text):
    for line in text.splitlines():
        if line.startswith("\t"):
            return "\t"
        if line.startswith("  "):
            return "  "
    return "  "


def insert_key(text, tokens, close_index):
    brace_at = tokens[close_index][2]
    prev_end = tokens[close_index - 1][3]
    prev_kind = tokens[close_index - 1][0]
    needs_comma = prev_kind not in ("{", ",")
    nl = newline_of(text)
    line = indent_of(text) + key_line
    between = text[prev_end:brace_at]
    if between.strip() == "":
        prefix = text[:prev_end]
        if needs_comma:
            prefix += ","
        return prefix + nl + line + nl + text[brace_at:]
    prefix = "," if needs_comma else ""
    return text[:brace_at] + prefix + nl + line + nl + text[brace_at:]


def write_target():
    # os.replace on the path itself would swap a symlink for a regular file
    # and detach a managed dotfile. Write the file the link points at.
    if path.is_symlink():
        try:
            return path.resolve()
        except RuntimeError:
            fail(f"could not resolve {path}")
    return path


def write_text(new):
    dest = write_target()
    if dest.exists() and not dest.is_file():
        print(f"Cursor password store: left {path} unchanged because it is not a file", file=sys.stderr)
        raise SystemExit(0)
    dest.parent.mkdir(parents=True, exist_ok=True)
    mode = 0o644
    if dest.exists():
        mode = dest.stat().st_mode & 0o777
    tmp = dest.with_name(dest.name + ".omarchy-tmp")
    try:
        tmp.write_text(new, encoding="utf-8")
        os.chmod(tmp, mode)
        os.replace(tmp, dest)
    except Exception:
        tmp.unlink(missing_ok=True)
        raise


if path.is_symlink() or path.exists():
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        print(f"Cursor password store: left {path} unchanged because it is not JSONC", file=sys.stderr)
        raise SystemExit(0)
    except IsADirectoryError:
        print(f"Cursor password store: left {path} unchanged because it is not a file", file=sys.stderr)
        raise SystemExit(0)
    except FileNotFoundError:
        text = None
else:
    text = None

if text is None or text.strip() == "":
    write_text(template)
    raise SystemExit(0)

tokens = tokenize(text)
if tokens is None:
    print(f"Cursor password store: left {path} unchanged because it is not JSONC", file=sys.stderr)
    raise SystemExit(0)

found = analyze(tokens)
if found == "set":
    raise SystemExit(0)
if found == "invalid":
    print(f"Cursor password store: left {path} unchanged because it is not JSONC", file=sys.stderr)
    raise SystemExit(0)
if found == "empty":
    nl = newline_of(text)
    suffix = "" if text.endswith(("\n", "\r")) else nl
    new = text + suffix + "{\n  " + key_line + "\n}\n"
else:
    new = insert_key(text, tokens, found[1])

check = tokenize(new)
if check is None or analyze(check) != "set":
    fail(f"refused to rewrite {path}")
write_text(new)
PY

#!/usr/bin/python3

# omarchy:summary=Run the agent seat broker, the Wayland proxy that gives agents their own seat
# omarchy:args=[serve | call <json>]
# omarchy:hidden=true

# Apps started with omarchy-agent-seat-run connect to this broker instead of
# Hyprland. It forwards their windows to Hyprland untouched, so they are real
# windows in the user's session, but it owns their input:
#
# - The agent gets its own pointer and keyboard, delivered by the broker, which
#   reach nothing but agent apps. The user's own mouse and keyboard still work
#   on agent windows too, at the same time: the broker moves each app's focus
#   between the two as they act. Every app still sees exactly one ordinary
#   seat, so apps that only ever bind the first seat (Chromium, Electron,
#   Kitty) work.
# - Only an allowlist of globals is advertised. Agent apps cannot inject
#   input, capture the screen, list windows, draw overlays or steal focus, and
#   binding a hidden global disconnects the app.
# - The clipboard is the user's. An app reads it only while the user's keyboard
#   is in it and the user acted last, and sets it only from the user's own
#   input since the agent last acted in it, never the agent's.
# - Every agent window gets the class "agent-<n>.<app id>", so Hyprland rules
#   can put it on the agent seat's workspace and outline it.
# - Apps get no GPU. They draw into shared memory, which the broker reads for
#   screenshots.
#
# The agent drives the seat through a control socket that only this user can
# reach and that is never mounted into the sandbox.

import array
import collections
import ctypes
import ctypes.util
import errno
import functools
import glob
import json
import operator
import os
import re
import selectors
import socket
import stat
import struct
import subprocess
import sys
import threading
import time
import weakref
import xml.etree.ElementTree as ET
import zlib

RUNTIME_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "omarchy", "agent-seat")
WAYLAND_SOCKET = os.path.join(RUNTIME_DIR, "wayland-0")
CONTROL_SOCKET = os.path.join(RUNTIME_DIR, "control")
MAX_FDS_PER_MESSAGE = 28  # libwayland's receive limit
MAX_QUEUED_FDS = 4 * MAX_FDS_PER_MESSAGE  # received but not yet claimed by a message
# Each connection costs the broker and Hyprland a descriptor, and each shared
# memory pool one more in each, so both are capped per sandbox (see
# sandbox_of) and for the whole seat, under a 1024 descriptor limit.
MAX_CLIENTS_PER_SANDBOX = 16
MAX_CLIENTS = 64
MAX_POOLS_PER_SANDBOX = 256
MAX_POOLS = 640
# Each object an app makes costs the broker an entry in its tables (a surface
# most, near 1 KiB), so live objects are capped per connection, per sandbox
# and for the seat (see check_objects). A real app holds hundreds.
MAX_APP_OBJECTS = 4096
MAX_OBJECTS_PER_SANDBOX = 16384
MAX_OBJECTS = 40960
# An input region is kept as rectangles (see set_region); each costs the
# broker memory, so they are capped in one region, and across an app's
# regions and the input regions its surfaces keep, per app and per sandbox.
MAX_REGION_RECTANGLES = 1024
MAX_APP_REGION_RECTANGLES = 4096
MAX_REGION_RECTANGLES_PER_SANDBOX = 16384
LISTENER_PAUSE_SECONDS = 1  # how long to stop accepting when out of descriptors
PAUSE_READING_BYTES = 256 << 10  # stop reading one side while this much waits for the other
MAX_UNSENT_BYTES = 16 << 20  # and drop the app if its queue grows past this anyway
MAX_REQUEST_BYTES = 1 << 20  # one control request
REQUEST_SECONDS = 5  # to send one
HYPRCTL_SECONDS = 5  # for Hyprland to list its windows
DEBUG = bool(os.environ.get("OMARCHY_AGENT_SEAT_DEBUG"))

# Everything an app needs to draw windows. Anything not listed is hidden,
# including GPU buffers: agent apps draw into shared memory, which keeps the GPU
# out of the sandbox and lets the broker read every surface for screenshots.

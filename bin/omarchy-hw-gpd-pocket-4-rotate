#!/usr/bin/python3
# omarchy:summary=Rotate the screen with the GPD Pocket 4 accelerometer (iio-sensor-proxy)
# omarchy:hidden=true

"""Automatic screen rotation for the GPD Pocket 4 on Hyprland.

Watches AccelerometerOrientation on iio-sensor-proxy (system bus) and applies
matching monitor + touchscreen transforms via `hyprctl eval`. The touch device
transform is set explicitly alongside the monitor transform; inheriting the
monitor transform is not reliable (hyprwm/Hyprland#3538).

The panel is natively portrait and sits at transform 3 in laptop pose.
Empirically calibrated on a GPD Pocket 4 (2026-08-30): laptop pose reports
"right-up", giving the default mapping normal=0, left-up=1, bottom-up=2,
right-up=3. Units whose accelerometer anchors differently can shift the whole
table with an offset: write 0-3 into ~/.config/omarchy/gpd-pocket-4-orientation.
"""

import json
import os
import re
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

DEFAULT_TOUCH_DEVICE = "nvtk0603:00-0603:f001"
DEFAULT_MONITOR = "eDP-1"
ORIENTATION_TO_TRANSFORM = {
    "normal": 0,
    "left-up": 1,
    "bottom-up": 2,
    "right-up": 3,  # laptop pose on a stock GPD Pocket 4
}


def load_offset():
    path = os.path.expanduser("~/.config/omarchy/gpd-pocket-4-orientation")
    try:
        with open(path) as handle:
            return int(handle.read().strip()) % 4
    except (OSError, ValueError):
        return 0


def detect_monitor():
    try:
        monitors = json.loads(subprocess.run(
            ["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True
        ).stdout)
        internal = [m["name"] for m in monitors if m.get("name", "").startswith(("eDP", "DSI"))]
        if internal:
            return internal[0]
    except (subprocess.SubprocessError, ValueError, KeyError):
        pass
    return DEFAULT_MONITOR


def detect_touch_device():
    try:
        devices = json.loads(subprocess.run(
            ["hyprctl", "devices", "-j"], capture_output=True, text=True, check=True
        ).stdout)
        names = [d["name"] for d in devices.get("touch", []) + devices.get("tablets", [])]
        preferred = [n for n in names if "nvtk0603" in n.lower()]
        if preferred:
            return preferred[0]
        if names:
            return names[0]
    except (subprocess.SubprocessError, ValueError, KeyError):
        pass
    return DEFAULT_TOUCH_DEVICE


def lua_escape(value):
    # Device and monitor names come from `hyprctl` descriptors and are
    # interpolated into a Lua expression for `hyprctl eval`. Escape them the
    # way omarchy-toggle-input-device does so a crafted name stays data and
    # cannot change what gets evaluated. Control characters never occur in
    # real names; strip them rather than aborting rotation.
    text = re.sub(r"[\x00-\x1f\x7f]", "", value)
    return text.replace("\\", "\\\\").replace('"', '\\"')


def current_monitor_transform(monitor):
    try:
        monitors = json.loads(subprocess.run(
            ["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True
        ).stdout)
        for entry in monitors:
            if entry.get("name") == monitor:
                transform = entry.get("transform")
                return transform if isinstance(transform, int) else None
    except (subprocess.SubprocessError, ValueError, AttributeError):
        pass
    return None


def ensure_hyprland_env():
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    hypr_dir = os.path.join(runtime, "hypr")
    try:
        candidates = sorted(
            (d, os.path.getmtime(os.path.join(hypr_dir, d)))
            for d in os.listdir(hypr_dir)
            if os.path.isdir(os.path.join(hypr_dir, d))
        )
    except OSError:
        return
    if candidates:
        os.environ["HYPRLAND_INSTANCE_SIGNATURE"] = candidates[-1][0]


def apply_transform(monitor, touch_device, transform):
    exprs = [f'hl.monitor({{ output = "{lua_escape(monitor)}", transform = {transform} }})']
    if touch_device:
        exprs.append(f'hl.device({{ name = "{lua_escape(touch_device)}", transform = {transform} }})')
    for expr in exprs:
        result = subprocess.run(["hyprctl", "eval", expr], capture_output=True, text=True)
        if "ok" not in result.stdout.lower():
            print(f"hyprctl eval failed: {expr!r}: {result.stdout}{result.stderr}", file=sys.stderr, flush=True)
    print(f"applied transform {transform}", flush=True)


def dbus_unpack(value):
    # g-properties-changed hands PyGObject either a Variant or an already
    # unpacked Python value depending on GI version. Calling .unpack() on a
    # str raises AttributeError and rotation silently dies.
    if value is None:
        return None
    unpack = getattr(value, "unpack", None)
    return unpack() if callable(unpack) else value


SENSOR_WAIT_SECONDS = 60


def wait_for_sensor(timeout=SENSOR_WAIT_SECONDS):
    # iio-sensor-proxy can lag behind the graphical session: the daemon may
    # start before the proxy is reachable or before it exposes the
    # accelerometer. Wait for it instead of exiting successfully, which would
    # leave autorotation dead for the session (the unit only restarts on
    # failure). Returns the proxy, or None on timeout.
    deadline = time.monotonic() + timeout
    while True:
        try:
            proxy = Gio.DBusProxy.new_for_bus_sync(
                Gio.BusType.SYSTEM,
                Gio.DBusProxyFlags.NONE,
                None,
                "net.hadess.SensorProxy",
                "/net/hadess/SensorProxy",
                "net.hadess.SensorProxy",
            )
        except GLib.Error:
            proxy = None
        if proxy is not None and dbus_unpack(proxy.get_cached_property("HasAccelerometer")):
            return proxy
        if time.monotonic() >= deadline:
            return None
        time.sleep(2)


def main():
    ensure_hyprland_env()
    monitor = detect_monitor()
    touch_device = detect_touch_device()
    offset = load_offset()
    last = {"transform": None}

    def apply(monitor_name, device_name, transform):
        apply_transform(monitor_name, device_name, transform)
        last["transform"] = transform

    def reconcile():
        # `hyprctl reload` (monitor/clamshell watchers) re-reads a monitor
        # configuration with no rotation, wiping the applied transform while
        # the pose is unchanged, so no orientation event restores it. Heal
        # that drift back to the last applied transform.
        if last["transform"] is None:
            return True
        current = current_monitor_transform(monitor)
        if current is not None and current != last["transform"]:
            apply(monitor, touch_device, last["transform"])
        return True

    def on_properties_changed(proxy, changed, invalidated):
        props = dbus_unpack(changed) or {}
        orientation = dbus_unpack(props.get("AccelerometerOrientation"))
        if orientation is None:
            return
        base = ORIENTATION_TO_TRANSFORM.get(orientation)
        if base is not None:
            apply(monitor, touch_device, (base + offset) % 4)

    proxy = wait_for_sensor()
    if proxy is None:
        print("iio-sensor-proxy exposed no accelerometer", file=sys.stderr, flush=True)
        return 1

    proxy.connect("g-properties-changed", on_properties_changed)
    try:
        proxy.call_sync("ClaimAccelerometer", None, Gio.DBusCallFlags.NONE, -1)
    except GLib.Error as error:
        print(f"ClaimAccelerometer failed: {error.message}", file=sys.stderr, flush=True)
        return 1
    initial = dbus_unpack(proxy.get_cached_property("AccelerometerOrientation"))
    if initial is not None:
        base = ORIENTATION_TO_TRANSFORM.get(initial)
        if base is not None:
            apply(monitor, touch_device, (base + offset) % 4)
    print("watching accelerometer orientation...", flush=True)
    GLib.timeout_add_seconds(10, reconcile)
    GLib.MainLoop().run()


if __name__ == "__main__":
    sys.exit(main())

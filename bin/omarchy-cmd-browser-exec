#!/bin/bash

# omarchy:summary=Shared desktop-entry Exec parsing for browser commands (source this file)
# omarchy:hidden=true

# Undo the escapes every desktop entry string carries.
desktop_string() {
  local string=$1 char i
  REPLY=""
  for (( i = 0; i < ${#string}; i++ )); do
    char=${string:i:1}
    if [[ $char == "\\" ]]; then
      (( i++ ))
      case ${string:i:1} in
      s) char=" " ;;
      n) char=$'\n' ;;
      t) char=$'\t' ;;
      r) char=$'\r' ;;
      "\\") char="\\" ;;
      *) char="\\${string:i:1}" ;;
      esac
    fi
    REPLY+=$char
  done
}

desktop_exec_argv() {
  local desktop=$1
  local file="" line="" name="" data_dir entry_line exec_found=0 name_found=0
  desktop_exec_argv=()
  desktop_exec_file=""
  desktop_exec_class=""
  # Read Exec= from the same data dirs omarchy-cmd-default-browser searched, in
  # the same order, so the command always comes from the entry that was checked.
  local -a data_dirs
  IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for data_dir in "${data_dirs[@]}"; do
    file="$data_dir/applications/$desktop"
    [[ -f $file ]] || continue
    while IFS= read -r entry_line || [[ -n $entry_line ]]; do
      entry_line=${entry_line%$'\r'}
      if (( ! exec_found )) && [[ $entry_line == Exec=* ]]; then
        line=${entry_line#Exec=}
        exec_found=1
      elif (( ! name_found )) && [[ $entry_line == Name=* ]]; then
        name=${entry_line#Name=}
        name_found=1
      elif [[ -z $desktop_exec_class && $entry_line == StartupWMClass=* ]]; then
        desktop_exec_class=${entry_line#StartupWMClass=}
      fi
    done <"$file"
    break
  done
  [[ -n $line ]] || return 1
  desktop_exec_file=$file
  desktop_string "$name"
  name=$REPLY

  # Split the Exec line by its own quoting, expanding %c and %k, keeping %% as
  # %, and dropping the other field codes. A standalone -- goes too, or the
  # launcher's own options after it would be read as operands.
  desktop_string "$line"
  local value=$REPLY arg="" char i quoted=0 started=0
  for (( i = 0; i < ${#value}; i++ )); do
    char=${value:i:1}
    if [[ $char == '"' ]]; then
      (( quoted = !quoted, started = 1 ))
    elif [[ $char == "\\" ]] && (( quoted )); then
      (( i++ ))
      arg+=${value:i:1}
    elif [[ $char == "%" ]]; then
      (( i++ ))
      case ${value:i:1} in
      "%") arg+="%" started=1 ;;
      c) arg+=$name started=1 ;;
      k) arg+=$file started=1 ;;
      esac
    elif [[ $char == " " ]] && (( ! quoted )); then
      if (( started )) && [[ $arg != "--" ]]; then
        desktop_exec_argv+=("$arg")
      fi
      arg="" started=0
    else
      arg+=$char started=1
    fi
  done
  if (( started )) && [[ $arg != "--" ]]; then
    desktop_exec_argv+=("$arg")
  fi

  (( ${#desktop_exec_argv[@]} > 0 ))
}

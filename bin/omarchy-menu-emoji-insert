#!/bin/bash

# omarchy:summary=Insert an emoji into the focused application
# omarchy:group=menu
# omarchy:args=<emoji>
# omarchy:hidden=true

emoji="${1:-}"
copy_pid=""

[[ -n $emoji ]] || exit

printf '%s' "$emoji" | wl-copy --type text/plain --sensitive --foreground &
copy_pid=$!

sleep 0.15
# GTK3 and WebKitGTK skip the highest keycode when matching bindings, so a keymap holding only
# Insert never pastes. Releasing VoidSymbol, never pressed, adds a higher key without typing it.
wtype -M shift -k Insert -m shift -p VoidSymbol 2>/dev/null || true
sleep 0.2

kill "$copy_pid" 2>/dev/null || true

#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages from the current channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default Omarchy packages from the current channel, or the
# platform's default when it can't be read, and downgrade any packages that are
# too new.

# The refresh keeps a known current channel and falls back to the platform's
# default when it can't be read.
omarchy-refresh-pacman

# Downgrade any packages to that channel's setup
omarchy-update-pacman -Suu --noconfirm

# Ensure this platform's default packages are installed
default_packages=$(omarchy-pkg-defaults)
mapfile -t packages <<<"$default_packages"
# --ask 4 accepts removing a stock package a default replaces, such as
# power-profiles-daemon for omarchy-power-profiles-daemon.
omarchy-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"

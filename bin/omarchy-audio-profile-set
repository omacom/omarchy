#!/bin/bash

# omarchy:summary=Set an audio card profile and switch output to its sink
# omarchy:args=<card-name> <profile-name>
# omarchy:group=audio
# omarchy:examples=omarchy audio profile set alsa_card.pci-0000_00_1f.3 output:hdmi-stereo+input:analog-stereo

set -uo pipefail

card=${1:-}
profile=${2:-}

if [[ -z $card || -z $profile ]]; then
  echo "Usage: omarchy-audio-profile-set <card-name> <profile-name>" >&2
  exit 1
fi

timeout 2 pactl set-card-profile "$card" "$profile" 2>/dev/null || exit 1

# The old sink dies before the new one appears. Poll for a sink owned by this
# card, then make it default and move streams like output-set-default does.
new_sink=""
new_index=""
attempt=0
while (( attempt < 6 )); do
  (( attempt++ )) || true
  sleep 0.5
  row=$(timeout 2 pactl -f json list sinks 2>/dev/null | jq -r --arg card "$card" '
    .[] | select(.properties."device.name" == $card) | "\(.index)\t\(.name)"
  ' 2>/dev/null | head -n 1)
  if [[ -n $row ]]; then
    new_index=$(cut -f1 <<<"$row")
    new_sink=$(cut -f2 <<<"$row")
    break
  fi
done

if [[ -z $new_sink ]]; then
  echo "Timed out waiting for output after profile switch to $profile" >&2
  omarchy-osd -m "Output not ready after profile switch" 2>/dev/null || true
  exit 1
fi

# A speaker tuning is a virtual sink in front of the real speakers. Both exist
# in the graph, but selecting the physical one would bypass the tuning, so
# route through it the way output-switch does by keeping the physical sink out
# of the rotation.
target_sink="$new_sink"
target_index="$new_index"
fronted=$(omarchy-audio-tuning fronted-sink 2>/dev/null || true)
if [[ -n $fronted && $new_sink == "$fronted" ]]; then
  tuning_index=$(timeout 2 pactl list sinks short 2>/dev/null | awk '$2 == "omarchy_speaker_tuning" {print $1; exit}')
  if [[ -n $tuning_index ]]; then
    target_sink="omarchy_speaker_tuning"
    target_index="$tuning_index"
  fi
fi

omarchy-audio-output-set-default "$target_index" "$target_sink" 2>/dev/null || true

description=$(timeout 2 pactl -f json list sinks 2>/dev/null | jq -r --arg name "$new_sink" '.[] | select(.name == $name) | .description // .name' 2>/dev/null)
[[ -n $description ]] || description="$new_sink"
omarchy-osd -m "$description" 2>/dev/null || true

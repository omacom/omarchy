#!/usr/bin/python3

# omarchy:summary=Bring back files deleted from your home folder, from its hourly snapshots
# omarchy:subcommand=deleted [--json] [--budget <seconds>] [folder] — List deleted files a snapshot still holds, latest first
# omarchy:subcommand=restore [--json] <path> — Put a deleted file or folder back where it was
# omarchy:examples=omarchy snapshot files deleted ~/Documents | omarchy snapshot files restore ~/Documents/taxes.pdf

# Python rather than bash: telling a deleted file from a moved one is set logic
# over the inode numbers of every name in two trees.

import argparse
import calendar
import ctypes
import errno
import fnmatch
import json
import os
import re
import secrets
import shutil
import stat
import subprocess
import sys
import time

SNAPSHOTS = os.environ.get("OMARCHY_SNAPSHOTS_DIR", "/home/.snapshots")
SUBVOLUME = os.environ.get("OMARCHY_SNAPSHOTS_SUBVOLUME", "/home")
CACHE_VERSION = 3

# Churn rather than anything a person deleted: dependencies and bytecode come
# back on their own, hidden folders are mostly caches, and editors and office
# suites delete their backups, swap and lock files all day.
SKIPPED_FOLDERS = {"node_modules", "__pycache__"}
SKIPPED_FILES = ["*~", ".*.sw?", ".#*", ".~lock.*#", ".goutputstream-*", "*.restoring-*"]


class Failure(Exception):
  pass


def skipped(name, is_dir):
  if is_dir:
    return name.startswith(".") or name in SKIPPED_FOLDERS
  return any(fnmatch.fnmatchcase(name, pattern) for pattern in SKIPPED_FILES)


def home():
  return os.path.realpath(os.path.expanduser("~"))


def home_in_snapshots():
  relative = os.path.relpath(home(), os.path.realpath(SUBVOLUME))
  if relative == ".." or relative.startswith("../"):
    raise Failure(f"{home()} is not on {SUBVOLUME}, which is what gets snapshotted")
  return relative


class Snapshot:
  def __init__(self, number, root, taken):
    self.number = number
    self.root = root
    self.taken = taken

  # Snapper gives a deleted newest snapshot's number to the next one, so the
  # number alone doesn't name a snapshot.
  def key(self):
    return f"{self.number}.{self.taken}"


def snapshots():
  relative = home_in_snapshots()
  found = []
  try:
    entries = list(os.scandir(SNAPSHOTS))
  except OSError:
    return found

  for entry in entries:
    if not entry.name.isdigit() or entry.name == "0":
      continue
    try:
      with open(os.path.join(entry.path, "info.xml")) as info:
        date = re.search(r"<date>([^<]+)</date>", info.read())
      taken = calendar.timegm(time.strptime(date.group(1), "%Y-%m-%d %H:%M:%S"))
    except (OSError, AttributeError, ValueError):
      continue
    root = os.path.join(entry.path, "snapshot", relative)
    # A snapshot from before this home existed holds nothing of it.
    if os.path.isdir(root) and not os.path.islink(root):
      found.append(Snapshot(int(entry.name), root, taken))

  return sorted(found, key=lambda snapshot: snapshot.number)


def listing(path):
  return {entry.name: entry for entry in os.scandir(path)}


def walk(path):
  """os.walk on one filesystem, leaving out what the comparison leaves out: a
  mount or another subvolume in home isn't in its snapshots, and its inode
  numbers mean something else."""
  try:
    device = os.lstat(path).st_dev
  except OSError:
    return
  for root, folders, files in os.walk(path):
    if "CACHEDIR.TAG" in files:
      folders[:] = []
      continue
    kept = []
    for name in folders:
      try:
        if not skipped(name, True) and os.lstat(os.path.join(root, name)).st_dev == device:
          kept.append(name)
      except OSError:
        pass
    folders[:] = kept
    try:
      yield list(os.scandir(root))
    except OSError:
      pass


class Comparison:
  """What older holds that newer doesn't, a folder as one entry. Folders are
  paired by inode, so a renamed or moved one is compared where it is now, and a
  file whose inode newer still has under any name was moved, not deleted."""

  def __init__(self, older, newer):
    self.older = older
    self.newer = newer
    self.complete = True
    self.gone = []
    self.gone_folders = {}
    self.new_folders = {}
    self.nested = {}
    self.gained = set()
    self.device = None

  def run(self):
    try:
      self.device = os.lstat(self.newer).st_dev
    except OSError:
      self.complete = False
      return []

    pending = [("", "")]
    while pending:
      while pending:
        self.compare(*pending.pop(), pending)
      self.pair(pending)
      if not pending:
        # A new folder that isn't a renamed one came from somewhere, and may
        # hold a folder moved in from elsewhere.
        for inode in list(self.new_folders):
          self.gather(self.new_folders.pop(inode))
        self.pair(pending)

    entries = [(path, False) for path, inode in self.gone if inode not in self.gained]
    for path in self.gone_folders.values():
      full = os.path.join(self.older, path)
      if not os.path.lexists(os.path.join(full, "CACHEDIR.TAG")) and not self.emptied(full):
        entries.append((path, True))
    return sorted(entries)

  def pair(self, pending):
    # A folder gone under one name and new under another was renamed or moved.
    for found in (self.new_folders, self.nested):
      for inode in self.gone_folders.keys() & found.keys():
        pending.append((self.gone_folders.pop(inode), found.pop(inode)))

  def compare(self, a_path, b_path, pending):
    a = os.path.join(self.older, a_path)
    b = os.path.join(self.newer, b_path)
    try:
      a_stat = os.lstat(a)
      a_entries = listing(a)
    except OSError:
      self.complete = False
      return
    try:
      b_stat = os.lstat(b)
    except OSError:
      return

    if "CACHEDIR.TAG" in a_entries or b_stat.st_dev != self.device:
      return

    # A folder's mtime and ctime move whenever a name is added or removed, and
    # btrfs keeps inode numbers across snapshots, so a pair alike in all three
    # lists the same names. ctime, unlike mtime, can't be set back.
    unchanged = (a_stat.st_ino, a_stat.st_mtime_ns, a_stat.st_ctime_ns) == (b_stat.st_ino, b_stat.st_mtime_ns, b_stat.st_ctime_ns)
    b_entries = {}
    if not unchanged:
      try:
        b_entries = listing(b)
      except OSError:
        return
      for name, entry in b_entries.items():
        is_dir = entry.is_dir(follow_symlinks=False)
        if not is_dir:
          # Under any name, a new one or one it was renamed over.
          self.gained.add(entry.inode())
        elif not skipped(name, True) and not (name in a_entries and a_entries[name].is_dir(follow_symlinks=False)):
          self.new_folders[entry.inode()] = os.path.join(b_path, name)

    for name, a_entry in a_entries.items():
      is_dir = a_entry.is_dir(follow_symlinks=False)
      if skipped(name, is_dir):
        continue
      if unchanged:
        if is_dir:
          pending.append((os.path.join(a_path, name), os.path.join(b_path, name)))
        continue
      b_entry = b_entries.get(name)
      if b_entry is not None and b_entry.is_dir(follow_symlinks=False) == is_dir:
        if is_dir:
          pending.append((os.path.join(a_path, name), os.path.join(b_path, name)))
      elif is_dir:
        self.gone_folders[a_entry.inode()] = os.path.join(a_path, name)
      else:
        self.gone.append((os.path.join(a_path, name), a_entry.inode()))

  def gather(self, path):
    """What a new folder holds: files that came from somewhere, and folders
    that may have been moved in whole."""
    for entries in walk(os.path.join(self.newer, path)):
      for entry in entries:
        if not entry.is_dir(follow_symlinks=False):
          self.gained.add(entry.inode())
        elif not skipped(entry.name, True):
          self.nested[entry.inode()] = os.path.relpath(entry.path, self.newer)

  def emptied(self, path):
    """Whether a gone folder's files all turn up on the newer side, moved out
    before it went. A hidden file left behind (.DS_Store) doesn't count."""
    for entries in walk(path):
      for entry in entries:
        if entry.is_dir(follow_symlinks=False) or entry.name.startswith(".") or skipped(entry.name, False):
          continue
        if entry.inode() not in self.gained:
          return False
    return True


def cache_dir():
  base = os.environ.get("XDG_CACHE_HOME") or os.path.join(home(), ".cache")
  return os.path.join(base, "omarchy", "snapshot-files")


def cache_name(older, newer):
  return f"{older.key()}-{newer.key()}.json"


def cached_removed(older, newer):
  try:
    with open(os.path.join(cache_dir(), cache_name(older, newer))) as cached:
      data = json.load(cached)
    if data.get("version") == CACHE_VERSION and data.get("home") == home_in_snapshots():
      return [tuple(entry) for entry in data["removed"]]
  except (OSError, ValueError, KeyError, TypeError):
    pass
  return None


def store_removed(older, newer, entries):
  directory = cache_dir()
  os.makedirs(directory, exist_ok=True)
  path = os.path.join(directory, cache_name(older, newer))
  partial = f"{path}.{os.getpid()}"
  with open(partial, "w") as cached:
    json.dump({"version": CACHE_VERSION, "home": home_in_snapshots(), "removed": entries}, cached)
  os.replace(partial, path)


def prune_cache(pairs):
  keep = {cache_name(older, newer) for older, newer in pairs}
  try:
    for entry in os.scandir(cache_dir()):
      if entry.name.endswith(".json") and entry.name not in keep:
        os.unlink(entry.path)
  except OSError:
    pass


def inside(folder, relative):
  return folder == "." or relative == folder or relative.startswith(folder + "/")


# Each snapshot is compared with the next, and the newest with the live home, so
# whatever is gone now turns up in one comparison; only the live one isn't cached.
def deleted(folder, budget):
  started = time.monotonic()
  found = snapshots()
  pairs = list(zip(found, found[1:]))
  lost = {}
  complete = True

  def note(entries, older, newer_taken):
    for relative, is_dir in entries:
      # Newest comparison first, so the latest copy is the one kept. A folder
      # holding the one asked about counts too, in case it's back but not whole.
      if relative not in lost and (inside(folder, relative) or is_dir and inside(relative, folder)):
        lost[relative] = (is_dir, older, newer_taken)

  if found:
    note(Comparison(found[-1].root, home()).run(), found[-1], None)

  for older, newer in reversed(pairs):
    entries = cached_removed(older, newer)
    if entries is None:
      if budget is not None and time.monotonic() - started > budget:
        complete = False
        continue
      comparison = Comparison(older.root, newer.root)
      entries = comparison.run()
      # A snapshot cleaned up mid-walk, say, leaves a comparison to redo.
      if comparison.complete:
        store_removed(older, newer, entries)
    note(entries, older, newer.taken)

  prune_cache(pairs)

  files = {}

  def add(relative, is_dir, older, until):
    if inside(folder, relative) and (relative not in files or files[relative]["seen"] < older.taken):
      files[relative] = {"path": os.path.join(home(), relative), "folder": is_dir, "snapshot": older.number, "seen": older.taken, "until": until}

  for relative, (is_dir, older, until) in sorted(lost.items()):
    path = os.path.join(home(), relative)
    if not os.path.lexists(path):
      add(relative, is_dir, older, until)
    elif is_dir and os.path.isdir(path) and not os.path.islink(path):
      # Back, but maybe not whole: one file restored out of it, say.
      for inner, inner_is_dir in Comparison(os.path.join(older.root, relative), path).run():
        add(os.path.join(relative, inner), inner_is_dir, older, until)

  files = sorted(files.values(), key=lambda file: (-file["seen"], file["path"]))
  return {"snapshots": len(found), "complete": complete, "files": files}


def shown(path):
  base = home()
  return "~" + path[len(base):] if path == base or path.startswith(base + "/") else path


def print_deleted(result, as_json):
  # Times are Unix seconds: seen is the last snapshot that held it, until the
  # first that didn't (null when it went after the newest).
  if as_json:
    json.dump(result, sys.stdout)
    print()
    return

  if result["snapshots"] == 0:
    if os.path.isdir(SNAPSHOTS) and not os.access(SNAPSHOTS, os.R_OK | os.X_OK):
      print(f"Can't read {SNAPSHOTS}, so its snapshots can't be searched.")
    else:
      print(f"No snapshots of your home folder in {SNAPSHOTS} yet.")
    return
  if not result["files"]:
    print("Nothing deleted that a snapshot still holds.")
  for file in result["files"]:
    seen = time.strftime("%Y-%m-%d %H:%M", time.localtime(file["seen"]))
    print(f"{seen}  {shown(file['path'])}{'/' if file['folder'] else ''}")
  if not result["complete"]:
    print("Older snapshots weren't compared yet; run it again for the rest.", file=sys.stderr)


def through_link(root, relative):
  """Whether a folder on the way to relative under root is a symbolic link,
  which would take a restore somewhere else than it says."""
  path = root
  for part in os.path.dirname(relative).split("/") if os.path.dirname(relative) else []:
    path = os.path.join(path, part)
    if os.path.islink(path):
      return True
  return False


def rename_noreplace(source, target):
  libc = ctypes.CDLL(None, use_errno=True)
  renameat2 = getattr(libc, "renameat2", None)
  if renameat2 is not None:
    at_fdcwd, rename_noreplace = -100, 1
    if renameat2(at_fdcwd, os.fsencode(source), at_fdcwd, os.fsencode(target), rename_noreplace) == 0:
      return
    error = ctypes.get_errno()
    if error not in (errno.ENOSYS, errno.EINVAL):
      raise OSError(error, os.strerror(error), target)
  if os.path.lexists(target):
    raise OSError(errno.EEXIST, os.strerror(errno.EEXIST), target)
  os.rename(source, target)


def remove(path):
  """Removes a partial copy, read-only folders and all."""
  if os.path.isdir(path) and not os.path.islink(path):
    for root, folders, files in os.walk(path):
      os.chmod(root, 0o700)
    shutil.rmtree(path, ignore_errors=True)
  elif os.path.lexists(path):
    os.unlink(path)


def restore(path, as_json):
  target = os.path.normpath(os.path.abspath(os.path.expanduser(path)))
  base = home()
  if not target.startswith(base + "/"):
    raise Failure(f"{shown(target)} is not in your home folder")
  if os.path.lexists(target):
    raise Failure(f"{shown(target)} is already there")

  relative = os.path.relpath(target, base)
  if through_link(base, relative):
    raise Failure(f"{shown(target)} is through a symbolic link, so it isn't restored")

  source = next((snapshot for snapshot in reversed(snapshots())
                 if os.path.lexists(os.path.join(snapshot.root, relative)) and not through_link(snapshot.root, relative)), None)
  if source is None:
    raise Failure(f"No snapshot holds {shown(target)}")

  # Folders it was in that are gone too come back, with their permissions set
  # once it's in place, since a read-only one would keep it out.
  parent = os.path.dirname(target)
  missing = []
  while not os.path.lexists(parent):
    missing.append(parent)
    parent = os.path.dirname(parent)
  for folder in reversed(missing):
    os.mkdir(folder, 0o700)
  parent = os.path.dirname(target)

  # Copied beside it under a hidden name and renamed into place, so a half
  # copied folder never looks restored. Reflinks make it instant, and free.
  copied = os.path.join(parent, f".{os.path.basename(target)}.restoring-{secrets.token_hex(4)}")
  try:
    copy = subprocess.run(["cp", "-a", "--reflink=auto", "--", os.path.join(source.root, relative), copied], stderr=subprocess.PIPE, text=True)
    if copy.returncode != 0:
      raise Failure(copy.stderr.strip() or f"Couldn't copy {shown(target)} out of its snapshot")
    try:
      rename_noreplace(copied, target)
    except FileExistsError:
      raise Failure(f"{shown(target)} is already there")
  finally:
    remove(copied)

  for folder in missing:
    os.chmod(folder, stat.S_IMODE(os.stat(os.path.join(source.root, os.path.relpath(folder, base))).st_mode))

  if as_json:
    json.dump({"path": target, "snapshot": source.number, "seen": source.taken}, sys.stdout)
    print()
  else:
    seen = time.strftime("%Y-%m-%d %H:%M", time.localtime(source.taken))
    print(f"Restored {shown(target)} from the snapshot of {seen}.")


def main():
  parser = argparse.ArgumentParser(prog="omarchy-snapshot-files")
  commands = parser.add_subparsers(dest="command", required=True)

  listing_command = commands.add_parser("deleted", help="list deleted files a snapshot still holds, latest first")
  listing_command.add_argument("folder", nargs="?", default="~")
  listing_command.add_argument("--json", action="store_true")
  listing_command.add_argument("--budget", type=float, help="stop comparing uncached snapshots after this many seconds")

  bring_back = commands.add_parser("restore", help="put a deleted file or folder back where it was")
  bring_back.add_argument("path")
  bring_back.add_argument("--json", action="store_true")

  args = parser.parse_args()
  try:
    if args.command == "deleted":
      folder = os.path.normpath(os.path.abspath(os.path.expanduser(args.folder)))
      if folder != home() and not folder.startswith(home() + "/"):
        raise Failure(f"{shown(folder)} is not in your home folder")
      print_deleted(deleted(os.path.relpath(folder, home()), args.budget), args.json)
    else:
      restore(args.path, args.json)
  except Failure as failure:
    print(f"omarchy-snapshot-files: {failure}", file=sys.stderr)
    sys.exit(1)
  except OSError as error:
    print(f"omarchy-snapshot-files: {error.strerror}: {shown(error.filename or '')}", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
  main()

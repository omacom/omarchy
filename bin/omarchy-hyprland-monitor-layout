#!/bin/bash

# omarchy:summary=Arrange monitors by placing each at a position in the layout
# omarchy:args=NAME=XxY [NAME=XxY...] | --resized NAME OLD_MODE OLD_SCALE NEW_MODE NEW_SCALE
# omarchy:examples=omarchy hyprland monitor layout eDP-1=0x0 DP-1=1280x0 | omarchy hyprland monitor layout --resized DP-1 6016x3384 2 5120x2880 2
# omarchy:hidden=true

# Positions are in Hyprland's layout space: logical pixels, after each
# monitor's scale. Every position is applied in one eval, so the monitors never
# pass through a half-moved arrangement, and then saved for each monitor. On
# some Hyprland versions a position change commits before the resized monitor's
# new size does, so a neighbour a growth would cover moves out in a first eval
# and a neighbour closing in on a shrink moves in a last one, each waited
# for, so no committed arrangement ever overlaps and Hyprland stays quiet.

usage() {
  echo "Usage: omarchy-hyprland-monitor-layout NAME=XxY [NAME=XxY...]"
  echo "       omarchy-hyprland-monitor-layout --resized NAME OLD_SIZE OLD_SCALE NEW_SIZE NEW_SCALE [MODE [TRANSFORM]]"
}

monitors_json=$(hyprctl monitors -j)
resized_name=""
resized_scale=""
resized_mode=""
resized_transform=""

# A monitor whose mode or scale changed keeps its corner, and every monitor to
# its right or below it shifts by however much it grew or shrank, so the
# monitors that touched it still do. Otherwise a smaller monitor leaves a gap
# beside it, and a larger one overlaps its neighbour. Shifting sideways and
# down at once can push two neighbours onto each other, so while any overlap
# remains, a shifted monitor goes back where it was whenever that spot is free,
# the overlapping ones first and then any whose return frees the way for them;
# a gap is better than a pile-up. If overlaps still remain, the monitors keep
# their old places when those are clear.
#
# Given the MODE, the resized monitor takes its new mode and scale in the same
# eval as its neighbours move, ordered so no step overlaps: the ones moving away
# from it first, farthest first, then it, then the ones closing in, nearest
# first, so none moves into a spot another hasn't left. Resized on its own first, a
# monitor that grew would sit over a neighbour until it moved, and Hyprland
# warns about the overlap. Given a TRANSFORM too, it turns in the same eval; a
# quarter turn's swapped size comes in as its NEW_SIZE.
if [[ ${1:-} == "--resized" ]]; then
  if (( $# < 6 || $# > 8 )) || [[ ! $3 =~ ^[0-9]+x[0-9]+$ || ! $5 =~ ^[0-9]+x[0-9]+$ ]] ||
    [[ ! $4 =~ ^[0-9]+([.][0-9]+)?$ || ! $6 =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    [[ -n ${7:-} && ! $7 =~ ^[0-9]+x[0-9]+(@[0-9.]+)?$ ]] ||
    [[ -n ${8:-} && ! $8 =~ ^[0-7]$ ]]; then
    usage >&2
    exit 1
  fi
  resized_mode="${7:-}"
  resized_transform="${8:-}"
  mapfile -t positions < <(jq -r --arg name "$2" \
    --argjson ow "${3%x*}" --argjson oh "${3#*x}" --argjson os "$4" \
    --argjson nw "${5%x*}" --argjson nh "${5#*x}" --argjson ns "$6" '
    def logical($w; $h; $s; $t): [($w / $s | round), ($h / $s | round)] | if ($t % 2) == 1 then reverse else . end;
    def overlaps($a; $b): $a.x < $b.x + $b.w and $b.x < $a.x + $a.w and $a.y < $b.y + $b.h and $b.y < $a.y + $a.h;
    def piled: . as $r | any(range(0; length) as $i | range($i + 1; $r | length) as $j | overlaps($r[$i]; $r[$j]));
    def unpile:
      . as $r
      | if ($r | piled | not) then $r else
        [range(0; $r | length) as $i | $r[$i] as $a
         | select($a.x != $a.ox or $a.y != $a.oy)
         | ($a | .x = .ox | .y = .oy) as $back
         | select(all($r[]; .name == $a.name or (overlaps($back; .) | not)))
         | {i: $i, overlapping: any($r[]; .name != $a.name and overlaps($a; .))}]
        | (map(select(.overlapping)) + map(select(.overlapping | not))) as $movable
        | if ($movable | length) == 0 then $r else ($r | .[$movable[0].i] |= (.x = .ox | .y = .oy) | unpile) end
      end;
    (map(select(.name == $name))[0]) as $m
    | if $m == null then empty else
      logical($ow; $oh; $os; $m.transform // 0) as $osize
      | logical($nw; $nh; $ns; $m.transform // 0) as $new
      | [.[] | select((.mirrorOf // "none") == "none")
        | (if .name == $name then $new else logical(.width; .height; .scale; .transform // 0) end) as $size
        | {name, ox: .x, oy: .y, w: $size[0], h: $size[1],
           x: (if .name != $name and .x >= $m.x + $osize[0] then .x + $new[0] - $osize[0] else .x end),
           y: (if .name != $name and .y >= $m.y + $osize[1] then .y + $new[1] - $osize[1] else .y end)}]
      | unpile
      | (map(.x = .ox | .y = .oy)) as $old
      | if piled and ($old | piled | not) then $old else . end
      | sort_by(if .name == $name then [1, 0]
          elif .x > .ox or .y > .oy then [0, -(.ox + .oy)]
          else [2, .ox + .oy] end)
      # The compositor commits a position change before the new size of the
      # resized monitor, so a neighbour moving away out of that new size sits under
      # the growth until it leaves, and a neighbour closing in on the space a
      # shrink frees sits over the old size until the shrink commits. The
      # first is marked "!" and leaves in a first eval, the second "+" and
      # waits for the new size; @RESIZED carries that new size for the wait.
      | ["@RESIZED=\($new[0])x\($new[1])"]
      + [ .[] | (if .name != $name and ((.x > .ox or .y > .oy))
                 and overlaps({x: $m.x, y: $m.y, w: $new[0], h: $new[1]}; {x: .ox, y: .oy, w, h})
                then "!"
              elif .name != $name and ((.x != .ox or .y != .oy))
                 and (.x >= $m.x and .x < $m.x + $osize[0] and .y >= $m.y and .y < $m.y + $osize[1])
                then "+"
              else "" end) + "\(.name)=\(.x)x\(.y)" ] | .[]
    end' <<<"$monitors_json")
  resized_name="$2"
  resized_scale="$6"

  # Move the "!" neighbours out first and wait for the move to land, so the
  # growth fills a gap instead of covering a neighbour. The "+" neighbours
  # close in on the space the shrink frees, which only exists once the new
  # size has committed, so they move in a final eval after it. A move or size
  # that can't be confirmed gets the old one-eval behaviour rather than a
  # blocked layout.
  target_wh=""
  stripped=()
  prepark=()
  postpark=()
  for pos in "${positions[@]}"; do
    if [[ $pos == @RESIZED=* ]]; then
      target_wh="${pos#@RESIZED=}"
    elif [[ $pos == \!* ]]; then
      prepark+=("${pos:1}")
      stripped+=("${pos:1}")
    elif [[ $pos == \+* ]]; then
      postpark+=("${pos:1}")
    else
      stripped+=("$pos")
    fi
  done

  if (( ${#prepark[@]} > 0 )); then
    prepark_expr=""
    for pos in "${prepark[@]}"; do
      name="${pos%%=*}"
      position="${pos#*=}"
      # Same guard as the one-eval path below: these names go into a Lua
      # string eval'd as root of the compositor.
      [[ $name =~ ^[A-Za-z0-9._-]+$ && $position =~ ^-?[0-9]+x-?[0-9]+$ ]] || continue
      prepark_expr+="hl.monitor({ output = \"$name\", position = \"$position\" }) "
    done
    if [[ -n $prepark_expr ]] && hyprctl eval "$prepark_expr" >/dev/null 2>&1; then
      want=$(printf '%s\n' "${prepark[@]}" | jq -Rn '
        [inputs | select(length > 0) | split("=")
         | {(.[0]): {x: (.[1] | split("x")[0] | tonumber), y: (.[1] | split("x")[1] | tonumber)}}]
        | add // {}')
      # The compositor applies the move asynchronously, and a rotation still
      # settling from the turn that brought us here can hold it for a couple
      # of seconds, so the wait is long enough for that to finish; a move that
      # never lands still gets the old one-eval behaviour.
      poll_max=${OMARCHY_LAYOUT_WAIT_TRIES:-50}
      for (( i = 0; i < poll_max; i++ )); do
        if hyprctl monitors -j 2>/dev/null | jq -e --argjson want "$want" '
            . as $mon | [ $want | to_entries[]
              | .key as $n | .value as $p
              | ($mon | map(select(.name == $n)) | .[0]) as $m
              | $m != null and $m.x == $p.x and $m.y == $p.y ] | all' >/dev/null; then
          break
        fi
        sleep 0.1
      done
    fi
  fi

  set -- "${stripped[@]}"
fi

if (( $# == 0 )); then
  usage >&2
  exit 1
fi

names=()
positions=()
expr=""

for arg in "$@"; do
  # The name is written into the Lua string eval'd below, so only a plain
  # connector name may pass; a hostile one could execute otherwise.
  if [[ ! $arg =~ ^([A-Za-z0-9._-]+)=(-?[0-9]+x-?[0-9]+)$ ]]; then
    usage >&2
    exit 1
  fi
  name="${BASH_REMATCH[1]}"
  position="${BASH_REMATCH[2]}"

  if ! jq -e --arg name "$name" 'any(.[]; .name == $name)' <<<"$monitors_json" >/dev/null; then
    echo "No such monitor: $name" >&2
    exit 1
  fi

  names+=("$name")
  positions+=("$position")
  if [[ $name == "$resized_name" && -n $resized_mode ]]; then
    turn=""
    [[ -n $resized_transform ]] && turn=", transform = $resized_transform"
    expr+="hl.monitor({ output = \"$name\", mode = \"$resized_mode\", position = \"$position\", scale = $resized_scale$turn }) "
  else
    expr+="hl.monitor({ output = \"$name\", position = \"$position\" }) "
  fi
done

hyprctl eval "$expr" >/dev/null

# A neighbour closing in sits over the resized monitor's old size until the
# new one commits, so wait for the size before it moves in; a size that never
# commits still lets the layout finish rather than hang. A rule without a mode
# or transform changes no size in this eval, so nothing waits for it.
if (( ${#postpark[@]} > 0 )); then
  if [[ -n $target_wh && ( -n $resized_mode || -n $resized_transform ) ]]; then
    tw="${target_wh%x*}"
    th="${target_wh#*x}"
    poll_max=${OMARCHY_LAYOUT_WAIT_TRIES:-50}
      for (( i = 0; i < poll_max; i++ )); do
      if hyprctl monitors -j 2>/dev/null | jq -e --arg name "$resized_name" \
          --argjson tw "$tw" --argjson th "$th" '
          . as $mon | ($mon | map(select(.name == $name)) | .[0]) as $m
          | $m != null
            and ((($m.width / $m.scale | round) == $tw and ($m.height / $m.scale | round) == $th)
              or (($m.width / $m.scale | round) == $th and ($m.height / $m.scale | round) == $tw))' >/dev/null; then
        break
      fi
      sleep 0.1
    done
  fi
  postpark_expr=""
  for pos in "${postpark[@]}"; do
    name="${pos%%=*}"
    position="${pos#*=}"
    [[ $name =~ ^[A-Za-z0-9._-]+$ && $position =~ ^-?[0-9]+x-?[0-9]+$ ]] || continue
    postpark_expr+="hl.monitor({ output = \"$name\", position = \"$position\" }) "
    names+=("$name")
    positions+=("$position")
  done
  if [[ -n $postpark_expr ]]; then
    hyprctl eval "$postpark_expr" >/dev/null 2>&1
  fi
fi

for i in "${!names[@]}"; do
  # The resized monitor saves the scale it was given, not one read back from
  # Hyprland, so it can't race the change it follows.
  if [[ ${names[i]} == "$resized_name" ]]; then
    scale="$resized_scale"
  else
    scale=$(jq -r --arg name "${names[i]}" '.[] | select(.name == $name) | .scale' <<<"$monitors_json")
  fi
  omarchy-hyprland-monitor-persist "${names[i]}" "$scale" "" "${positions[i]}"
done

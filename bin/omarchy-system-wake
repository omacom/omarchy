#!/bin/bash

# omarchy:summary=Wake displays and restore brightness after idle
# omarchy:group=system
# omarchy:name=wake
# omarchy:examples=omarchy system wake

# On dual-GPU Macs, gmux resets the panel backlight (typically to 80%) when the
# panel powers down after suspend, leaving the kernel's requested brightness
# unchanged because apple-gmux is not tied to the GPU's DPMS power sequence.
# Re-apply the requested level on wake when the hardware level has diverged.
restore_gmux_backlight() {
  local dir="${OMARCHY_BACKLIGHT_PATH:-/sys/class/backlight}/gmux_backlight"
  local requested actual lock_fd

  [[ -r $dir/brightness && -r $dir/actual_brightness ]] || return 0
  read -r requested <"$dir/brightness" || return 0
  read -r actual <"$dir/actual_brightness" || return 0
  [[ $requested =~ ^[0-9]+$ && $actual =~ ^[0-9]+$ ]] || return 0
  (( requested == actual )) && return 0

  # Coordinate with omarchy-brightness-display and use a +0 delta so
  # brightnessctl re-reads the current requested level instead of writing a
  # stale value if a brightness key ran concurrently.
  exec {lock_fd}>"${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"
  if flock "$lock_fd"; then
    brightnessctl -q -d gmux_backlight set +0 >/dev/null 2>&1 || true
  fi
  exec {lock_fd}>&-
}

omarchy-brightness-display on
restore_gmux_backlight
omarchy-brightness-keyboard restore
omarchy-hyprland-monitor-clamshell >/dev/null 2>&1 || true

#!/bin/bash

# omarchy:summary=Install a coding agent's CLI
# omarchy:args=[--check|--package] <agent>
# omarchy:examples=omarchy install ai cli claude | omarchy install ai cli --check codex
# omarchy:requires-sudo=true

# Every coding agent ships as a package in Omarchy's repository, on the fast
# ring, so `omarchy update` keeps it current. Only Pi comes with the base
# install; the others are installed from Install > AI > CLI, or by picking one
# in the agents panel. --check answers whether the agent is installed, and
# --package names its package.

mode=install
if [[ ${1:-} == "--check" || ${1:-} == "--package" ]]; then
  mode=${1#--}
  shift
fi

agent=${1:-}
case "$agent" in
claude) package=claude-code ;;
codex) package=openai-codex ;;
grok) package=grok-cli ;;
opencode) package=opencode ;;
copilot) package=github-copilot-cli ;;
crush) package=crush-bin ;;
cursor-agent) package=cursor-cli ;;
agy) package=antigravity-cli ;;
muse) package=muse-code ;;
omp) package=oh-my-pi ;;
ori) package=openrouter-ori ;;
kimi) package=kimi-code ;;
qwen) package=qwen-code ;;
dsh) package=deepseek-dsh ;;
mcode) package=minimax-code ;;
freebuff) package=freebuff ;;
kilo) package=kilocode-cli ;;
devin) package=devin-cli ;;
amp) package=amp-cli ;;
*)
  echo "Usage: omarchy-install-ai-cli [--check|--package] <agent>" >&2
  exit 1
  ;;
esac

if [[ $mode == "package" ]]; then
  echo "$package"
  exit 0
fi

# Installed is the command on PATH: Omarchy's package, or an install of the
# user's own, such as the link Cursor's installer leaves in ~/.local/bin. The
# account dispatchers stand in for claude, codex and grok whether or not
# anything is behind them, so they don't count (nor mise's old command wrappers
# a long-running session may still have), and neither does anything mise puts on
# PATH: its shims everywhere, its install directories only in a shell that
# activated it, so the panel and a terminal would disagree.
mise_data=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
agent_path=""
IFS=: read -r -a dirs <<<"$PATH"
for dir in "${dirs[@]}"; do
  if [[ $dir != "${OMARCHY_PATH%/}/default/agent-accounts/bin" && $dir != "$mise_data/command-wrappers/bin" && $dir != "$mise_data/shims" && $dir != "$mise_data/installs/"* ]]; then
    agent_path+="${agent_path:+:}$dir"
  fi
done
installed() {
  PATH=$agent_path type -P "$agent"
}

if location=$(installed); then
  # The menu offers the package whenever it's missing, so a copy of the user's
  # own explains why nothing happens.
  if [[ $mode == "install" ]] && ! omarchy-pkg-present "$package"; then
    echo "$agent is already installed at $location, so the $package package isn't needed"
  fi
  exit 0
elif [[ $mode == "check" ]]; then
  exit 1
fi

# The agents panel installs with no terminal to ask for a password in, so
# polkit asks instead. pkexec's 126 is the dialog dismissed, passed on as is.
if [[ -t 0 ]]; then
  omarchy-pkg-add "$package" || exit 1
else
  pkexec /usr/bin/pacman -S --noconfirm --needed -- "$package"
  status=$?
  if (( status != 0 )); then
    exit "$status"
  fi
  installed >/dev/null || exit 1
fi

# An installed agent gets herdr's hooks, a launcher of its own beside Agent,
# and the shared ~/.agents/AGENTS.md from its first session.
omarchy-agent-integrate-herdr "$agent"
omarchy-agent-launcher "$agent" || true
omarchy-agent-instructions "$agent" >/dev/null || true

#!/bin/bash

# omarchy:summary=Send the low battery warning notification and run battery-low hooks.
# omarchy:args=<percentage>
# omarchy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: omarchy-battery-low <percentage>" >&2
  exit 1
fi

level=$1

headline=$(omarchy-i18n "Time to recharge!")
description=$(omarchy-i18n "Battery is down to %1%" "Battery is down to %1%" "$level")

omarchy-notification-send -g 󱐋 -u critical "$headline" "$description" -i battery-caution -t 30000
omarchy-hook battery-low "$level"

#!/bin/bash

# omarchy:summary=Send or dismiss the low battery warning notification.
# omarchy:args=<percentage|--dismiss>
# omarchy:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: omarchy-battery-low <percentage|--dismiss>" >&2
  exit 1
fi

title=$(omarchy-i18n battery.lowTitle)
if [[ $1 == "--dismiss" ]]; then
  omarchy-notification-dismiss "$title"
else
  level=$1
  omarchy-notification-send -g 󱐋 -u normal "$title" "$(omarchy-i18n battery.lowBody "$level")" -i battery-caution -t 30000
  omarchy-hook battery-low "$level"
fi

#!/bin/bash

# omarchy:summary=Set up private AI compartments on Omarchy (idempotent)
# omarchy:args=
# omarchy:examples=omarchy install compartment-ai

# Mirrors omarchy-install-* convention: idempotent, explains each step.

set -euo pipefail
P="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
echo "==> compartment-ai setup"
echo "    bases:    Whonix-CLI (verified) + Whonix-AI template"
echo "    weights:  llm-weights-data/verity (dm-verity RO)"
echo "    intents:  forced-command vm-exec + host policy gate"
echo
echo "==> [1/5] host hardening"
sudo bash "$P/scripts/deploy-host-hardening.sh"
echo "==> [2/5] weights disk (model + manifest + verity)"
sudo bash "$P/scripts/mk-weights-disk.sh" || echo "weights disk exists"
echo "==> [3/5] AI template (Whonix-CLI base + payload)"
sudo bash "$P/scripts/mk-ai-template-vc.sh"
echo "==> [4/5] first compartment (hermes-coding)"
sudo bash "$P/scripts/mk-ai-vm.sh" coding || echo "hermes-coding exists"
echo "==> [5/5] boot + register"
bash "$P/scripts/vm-ai-up.sh" hermes-coding || true

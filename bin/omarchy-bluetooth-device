#!/bin/bash

# omarchy:summary=Control a Bluetooth device
# omarchy:group=bluetooth
# omarchy:args=[pair|connect|disconnect|forget] <address>
# omarchy:examples=omarchy bluetooth device connect 00:11:22:33:44:55

set -e

usage() {
  echo "Usage: omarchy-bluetooth-device [pair|connect|disconnect|forget] <address>" >&2
  exit 1
}

action=${1:-}
address=${2:-}

[[ $action == "pair" || $action == "connect" || $action == "disconnect" || $action == "forget" ]] || usage
[[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage

power_on() {
  [[ $(timeout 2s bluetoothctl show 2>/dev/null) == *"Powered: yes"* ]] && return
  # Not bluetoothctl directly: Bluetooth is turned off by an rfkill soft block,
  # and BlueZ refuses to power an adapter up while one is set.
  omarchy-bluetooth-power on || true
}

device_error() {
  local message="$1"
  echo "$message" >&2
  omarchy-notification-send --app-name Bluetooth -u normal "Bluetooth $action failed" "$message" || true
  exit 1
}

run_device_command() {
  local seconds="$1" command="$2" output
  if output=$(timeout "$seconds" bluetoothctl "$command" "$address" 2>&1); then
    # bluetoothctl can print a failure while returning success.
    if [[ $output == *"Failed to "* || $output == *"not available"* ]]; then
      device_error "$output"
    fi
  else
    device_error "${output:-Bluetooth $command timed out or failed for $address}"
  fi
}

device_has_state() {
  local info
  info=$(timeout 3s bluetoothctl info "$address" 2>/dev/null) || return 1
  [[ $info == *"$1: yes"* ]]
}

connect_device() {
  if ! device_has_state Connected; then
    run_device_command 20s connect
    device_has_state Connected || device_error "Connection did not complete for $address"
  fi
}

case "$action" in
  pair)
    power_on
    run_device_command 20s pair
    device_has_state Paired || device_error "Pairing did not complete for $address"
    run_device_command 10s trust
    connect_device
    ;;
  connect)
    power_on
    run_device_command 10s trust
    connect_device
    ;;
  disconnect)
    run_device_command 10s disconnect
    ;;
  forget)
    power_on
    # An already disconnected device can still be forgotten.
    if device_has_state Connected; then
      run_device_command 10s disconnect
    fi
    run_device_command 10s remove
    ;;
esac

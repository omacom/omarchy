#!/bin/bash

# omarchy:summary=Control a Bluetooth device
# omarchy:group=bluetooth
# omarchy:args=[pair|connect|disconnect|forget] <address>
# omarchy:examples=omarchy bluetooth device connect 00:11:22:33:44:55

set -e

usage() {
  echo "Usage: omarchy-bluetooth-device [pair|connect|disconnect|forget] <address>" >&2
  exit 1
}

action=${1:-}
address=${2:-}

[[ $action == "pair" || $action == "connect" || $action == "disconnect" || $action == "forget" ]] || usage
[[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage

power_on() {
  [[ $(timeout 2s bluetoothctl show 2>/dev/null) == *"Powered: yes"* ]] && return
  # Not bluetoothctl directly: Bluetooth is turned off by an rfkill soft block,
  # and BlueZ refuses to power an adapter up while one is set.
  omarchy-bluetooth-power on || true
}

trust_device() {
  bluetoothctl trust "$address" >/dev/null 2>&1 || true
}

# The panel runs this detached, so only a notification tells anyone it failed.
# The message is fixed: bluetoothctl's output carries chatter about nearby devices.
pair_failed() {
  local message
  if (( $1 == 124 )); then
    message="Pairing timed out after 20 seconds. Is the device in pairing mode?"
  else
    message="Pairing failed. Put the device in pairing mode and try again."
  fi
  echo "$message" >&2
  omarchy-notification-send --app-name Bluetooth -u normal "Bluetooth pairing failed" "$message" || true
}

case "$action" in
  pair)
    power_on
    # Trust is not a bond. A failed pair that still trusts the address makes the
    # panel treat the device as already paired and skip pairing on later clicks.
    status=0
    timeout 20s bluetoothctl pair "$address" >/dev/null 2>&1 || status=$?
    if (( status == 0 )); then
      trust_device
      timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    else
      pair_failed "$status"
      exit 1
    fi
    ;;
  connect)
    power_on
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  disconnect)
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    ;;
  forget)
    power_on
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    timeout 10s bluetoothctl remove "$address" >/dev/null 2>&1 || true
    ;;
esac

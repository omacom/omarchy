#!/bin/bash

# omarchy:summary=Control a Bluetooth device
# omarchy:group=bluetooth
# omarchy:args=[pair|connect|disconnect|forget] <address>
# omarchy:examples=omarchy bluetooth device connect 00:11:22:33:44:55

set -e

usage() {
  echo "Usage: omarchy-bluetooth-device [pair|connect|disconnect|forget] <address>" >&2
  exit 1
}

action=${1:-}
address=${2:-}

[[ $action == "pair" || $action == "connect" || $action == "disconnect" || $action == "forget" ]] || usage
[[ $address =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]] || usage

power_on() {
  [[ $(timeout 2s bluetoothctl show 2>/dev/null) == *"Powered: yes"* ]] && return
  # Not bluetoothctl directly: Bluetooth is turned off by an rfkill soft block,
  # and BlueZ refuses to power an adapter up while one is set.
  omarchy-bluetooth-power on || true
}

trust_device() {
  bluetoothctl trust "$address" >/dev/null 2>&1 || true
}

# The shell keeps the adapter pairable only while the Bluetooth panel is open,
# since the pairing agent auto-accepts. A pairing this command starts needs it
# on as well, or a Low Energy device pairs without bonding and is forgotten at
# disconnect. The shell owns the property, so it is asked to hold pairing for
# the length of this command. Without a shell to ask, commands share the
# property through a lock: each holds it shared while pairing, the first one
# to find it off leaves a marker, and the last one out (the only one able to
# take it exclusively) turns it back off.
pairing_lock_dir="${XDG_RUNTIME_DIR:-/tmp}"
pairing_lock="$pairing_lock_dir/omarchy-bluetooth-pairable.lock"
pairing_restore_marker="$pairing_lock_dir/omarchy-bluetooth-pairable.restore"
pairing_token=""
holding_lock=0

hold_pairing() {
  # The shell answers a hold with a token for that hold alone, so the release
  # below cannot take another pairing's hold away. A request that got no
  # answer leaves nothing to release; the shell expires such a hold itself.
  if pairing_token=$(omarchy-shell omarchy.bluetooth holdPairing 2>/dev/null) &&
    [[ $pairing_token =~ ^[0-9a-f]{32}$ ]]; then
    return
  fi
  pairing_token=""
  exec 8>>"$pairing_lock" || return 0
  flock -s 8 || return 0
  holding_lock=1
  if [[ $(timeout 2s bluetoothctl show 2>/dev/null) != *"Pairable: yes"* ]]; then
    : >"$pairing_restore_marker"
    timeout 5s bluetoothctl pairable on >/dev/null 2>&1 || true
  fi
}

release_pairing() {
  if [[ -n $pairing_token ]]; then
    omarchy-shell -q omarchy.bluetooth releasePairing "$pairing_token" >/dev/null 2>&1 || true
  fi
  (( holding_lock )) || return 0
  flock -u 8 || true
  if flock -x -n 8 && [[ -e $pairing_restore_marker ]]; then
    rm -f "$pairing_restore_marker"
    timeout 5s bluetoothctl pairable off >/dev/null 2>&1 || true
  fi
  exec 8>&-
}

case "$action" in
  pair)
    power_on
    trap release_pairing EXIT
    hold_pairing
    timeout 20s bluetoothctl pair "$address" >/dev/null 2>&1 || true
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  connect)
    power_on
    trust_device
    timeout 20s bluetoothctl connect "$address" >/dev/null 2>&1 || true
    ;;
  disconnect)
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    ;;
  forget)
    power_on
    timeout 10s bluetoothctl disconnect "$address" >/dev/null 2>&1 || true
    timeout 10s bluetoothctl remove "$address" >/dev/null 2>&1 || true
    ;;
esac

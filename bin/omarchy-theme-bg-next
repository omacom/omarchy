#!/bin/bash

# omarchy:summary=Cycle to the next background for the current theme
# omarchy:examples=omarchy theme bg next

THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
THEME_BACKGROUNDS_PATH="$HOME/.local/state/omarchy/current/theme/backgrounds/"
SHARED_BACKGROUNDS_PATH="$HOME/.config/omarchy/backgrounds/"
CURRENT_BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"

# Without a theme name the user folder is the shared one, which is listed below.
THEME_BACKGROUND_PATHS=("$THEME_BACKGROUNDS_PATH")
if [[ -n $THEME_NAME ]]; then
  THEME_BACKGROUND_PATHS+=("$SHARED_BACKGROUNDS_PATH$THEME_NAME/")
fi

MEDIA_FILTER=(
  -maxdepth 1 -type f
  \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp'
     -o -iname '*.mp4' -o -iname '*.m4v' -o -iname '*.mov' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.avi' \)
  -print0
)

# Shared backgrounds follow the theme's own, so they never become its default.
mapfile -d '' -t BACKGROUNDS < <(
  find -L "${THEME_BACKGROUND_PATHS[@]}" "${MEDIA_FILTER[@]}" 2>/dev/null | sort -z
  find -L "$SHARED_BACKGROUNDS_PATH" "${MEDIA_FILTER[@]}" 2>/dev/null | sort -z
)
TOTAL=${#BACKGROUNDS[@]}

if (( TOTAL == 0 )); then
  omarchy-notification-send "No background was found for theme" -t 2000
else
  # Get current background from symlink
  if [[ -L $CURRENT_BACKGROUND_LINK ]]; then
    CURRENT_BACKGROUND=$(readlink "$CURRENT_BACKGROUND_LINK")
  else
    # Default to first background if no symlink exists
    CURRENT_BACKGROUND=""
  fi

  # Find current background index
  INDEX=-1
  for i in "${!BACKGROUNDS[@]}"; do
    if [[ ${BACKGROUNDS[$i]} == "$CURRENT_BACKGROUND" ]]; then
      INDEX=$i
      break
    fi
  done

  # Get next background (wrap around)
  if (( INDEX == -1 )); then
    # Use the first background when no match was found
    NEW_BACKGROUND="${BACKGROUNDS[0]}"
  else
    NEXT_INDEX=$(((INDEX + 1) % TOTAL))
    NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
  fi

  omarchy-theme-bg-set "$NEW_BACKGROUND"
fi

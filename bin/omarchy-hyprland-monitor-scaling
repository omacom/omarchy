#!/bin/bash

# omarchy:summary=Show, set, or adjust Hyprland monitor scaling
# omarchy:args=[--monitor NAME] [--mode WIDTHxHEIGHT@RATE] [up|down|SCALE]
# omarchy:examples=omarchy hyprland monitor scaling | omarchy hyprland monitor scaling 1.6 | omarchy hyprland monitor scaling up | omarchy hyprland monitor scaling --monitor DP-1 2

SCALES=(1 1.25 1.6 2 2.5 3 4)
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
SCALE_LOG="$STATE_DIR/monitor-scaling.log"
TARGET_MONITOR=""
TARGET_MODE=""

usage() {
  echo "Usage: omarchy-hyprland-monitor-scaling [--monitor NAME] [--mode WIDTHxHEIGHT@RATE] [up|down|SCALE]"
}

# The monitor to act on: the one named with --monitor, else the focused one.
target_monitor_info() {
  if [[ -n $TARGET_MONITOR ]]; then
    hyprctl monitors -j | jq -e -c --arg name "$TARGET_MONITOR" '.[] | select(.name == $name)'
  else
    hyprctl monitors -j | jq -e -c '.[] | select(.focused == true)'
  fi
}

target_monitor_scale() {
  target_monitor_info | jq -er '.scale'
}

cmdline_for_pid() {
  local pid="$1"

  [[ -r /proc/$pid/cmdline ]] || return 0
  tr '\0\t\n' '   ' <"/proc/$pid/cmdline" | sed -E 's/[[:space:]]+/ /g; s/[[:space:]]+$//'
}

audit_scale_change() {
  local requested="$1"
  local active_monitor="$2"
  local current_scale="$3"
  local new_scale="$4"
  local parent_pid="$PPID"
  local grandparent_pid
  local parent_cmd
  local grandparent_cmd

  mkdir -p "$STATE_DIR" || return 0

  grandparent_pid=$(ps -o ppid= -p "$parent_pid" 2>/dev/null | tr -d ' ')
  parent_cmd=$(cmdline_for_pid "$parent_pid")
  grandparent_cmd=$(cmdline_for_pid "$grandparent_pid")

  printf 'at=%s\trequested=%s\tcurrent=%s\tnew=%s\tmonitor=%s\tpid=%s\tppid=%s\tparent=%s\tgppid=%s\tgrandparent=%s\n' \
    "$(date --iso-8601=seconds)" \
    "$requested" \
    "$current_scale" \
    "$new_scale" \
    "$active_monitor" \
    "$$" \
    "$parent_pid" \
    "$parent_cmd" \
    "$grandparent_pid" \
    "$grandparent_cmd" >>"$SCALE_LOG"
}

normalize_scale() {
  awk 'NR == 1 { printf "%g\n", $0 }'
}

set_scale() {
  local requested_scale="$1"
  local requested="${2:-$requested_scale}"
  local monitors_json monitor_info active_monitor current_scale new_scale
  monitors_json=$(hyprctl monitors -j) || return 1
  monitor_info=$(jq -e -c --arg name "$TARGET_MONITOR" \
    '.[] | select(if $name == "" then .focused == true else .name == $name end)' <<<"$monitors_json") || return 1
  active_monitor=$(jq -r '.name' <<<"$monitor_info")
  current_scale=$(jq -r '.scale' <<<"$monitor_info")

  new_scale=$(python3 "$OMARCHY_PATH/default/hypr/monitor-layout.py" \
    "$active_monitor" "$requested_scale" "$HOME/.config/hypr/monitors.lua" "$TARGET_MODE" \
    <<<"$monitors_json") || return 1
  audit_scale_change "$requested" "$active_monitor" "$current_scale" "$new_scale"
}

scale_from_current() {
  local direction="${1:-}"
  local width="${2:-}"
  local height="${3:-}"

  awk -v direction="$direction" -v list="${SCALES[*]}" -v width="$width" -v height="$height" '
    function gcd(a, b, t) { while (b) { t = a % b; a = b; b = t } return a }
    function clean(scale,    g, k) {
      g = gcd(width * 120, height * 120)
      k = int(scale * 120 + 0.5)
      if (k > g) k = g
      while (g % k != 0) k++
      return k / 120
    }
    NR == 1 { scale = $0; found = 1 }
    END {
      if (!found) exit 1

      preset_count = split(list, presets, " ")
      for (i = 1; i <= preset_count; i++) {
        effective = clean(presets[i])
        key = sprintf("%.8f", effective)
        distance = presets[i] - effective
        if (distance < 0) distance = -distance

        # Multiple presets can collapse to the same clean scale. Keep only the
        # closest label so stepping always moves to a distinct effective value.
        if (!(key in effective_index)) {
          effective_index[key] = ++n
          effective_scales[n] = effective
          scales[n] = presets[i]
          distances[n] = distance
        } else {
          idx = effective_index[key]
          if (distance < distances[idx]) {
            scales[idx] = presets[i]
            distances[idx] = distance
          }
        }
      }

      # Snap to the nearest effective scale first. Hyprland reports floating
      # point values, so exact comparisons can otherwise get stuck.
      best = 1; best_diff = 1e9
      for (i = 1; i <= n; i++) {
        diff = scale - effective_scales[i]; if (diff < 0) diff = -diff
        if (diff < best_diff) { best_diff = diff; best = i }
      }

      if (direction == "next") {
        print scales[(best < n ? best + 1 : n)]
      } else if (direction == "previous") {
        print scales[(best > 1 ? best - 1 : 1)]
      } else {
        print scales[best]
      }
    }'
}

while [[ ${1:-} == "--monitor" || ${1:-} == "--mode" ]]; do
  if [[ -z ${2:-} ]]; then
    usage >&2
    exit 1
  fi
  if [[ $1 == "--monitor" ]]; then
    TARGET_MONITOR="$2"
  else
    TARGET_MODE="$2"
  fi
  shift 2
done

case "${1:-}" in
"")
  if [[ -n $TARGET_MODE ]]; then
    set_scale "$(target_monitor_scale)"
  else
    target_monitor_scale | normalize_scale
  fi
  ;;
-h | --help)
  usage
  ;;
up)
  monitor_info=$(target_monitor_info)
  set_scale "$(echo "$monitor_info" | jq -r '.scale' | scale_from_current next \
    "$(echo "$monitor_info" | jq -r '.width')" "$(echo "$monitor_info" | jq -r '.height')")" "up"
  ;;
down)
  monitor_info=$(target_monitor_info)
  set_scale "$(echo "$monitor_info" | jq -r '.scale' | scale_from_current previous \
    "$(echo "$monitor_info" | jq -r '.width')" "$(echo "$monitor_info" | jq -r '.height')")" "down"
  ;;
1 | 1.25 | 1.6 | 2 | 2.5 | 3 | 4)
  set_scale "$1" "$1"
  ;;
*)
  if [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]] &&
    awk -v scale="$1" 'BEGIN { exit !(scale >= 1 && scale <= 4) }'; then
    set_scale "$1" "$1"
  else
    usage >&2
    exit 1
  fi
  ;;
esac

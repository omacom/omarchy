#!/bin/bash -p

# omarchy:summary=Keep installed Thunderbolt protection recoverable until its removal migration
# omarchy:hidden=true

# Existing boot units need a protected entrypoint until installed policy has been retired.
if [[ $- != *p* ]]; then exit 126; fi
source /usr/bin/omarchy-security-functions || exit 126
omarchy_security_require_privileged_bash_startup || exit 126
omarchy_security_sanitize_bash_environment "$0" "$@"
(( EUID == 0 )) || exit 126
(( $# == 0 )) || exit 2
exec /bin/bash -p /usr/share/omarchy/migrations/retired-device-authorization/rollback.sh daemon

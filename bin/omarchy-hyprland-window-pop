#!/bin/bash

# omarchy:summary=Toggle to pop-out a tile to stay fixed on a display basis.
# omarchy:args=[width height x y]

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

active=$(hyprctl activewindow -j)
pinned=$(jq -r '.pinned // false' <<<"$active")
floating=$(jq -r '.floating // false' <<<"$active")
addr=$(jq -r '.address // empty' <<<"$active")
monitor_id=$(jq -r '.monitor // empty' <<<"$active")
window="address:$addr"

safe_path_component() {
  local value="$1"
  [[ -n $value && $value != "." && $value != ".." && $value =~ ^[0-9A-Za-z._-]+$ ]]
}

dir_matches_mode_mask() {
  local dir="$1"
  local forbidden_mask="$2"
  local owner="" mode="" type=""

  [[ -d $dir && ! -L $dir ]] || return 1
  read -r owner mode type < <(LC_ALL=C stat -c '%u %a %F' -- "$dir" 2>/dev/null) || return 1
  [[ $type == "directory" && $owner == "$EUID" && $mode =~ ^[0-7]+$ ]] || return 1
  (( (8#$mode & 8#$forbidden_mask) == 0 ))
}

geometry_dirs_safe() {
  local dir=""
  (( ${#geometry_dirs[@]} > 0 )) || return 1
  for dir in "${geometry_dirs[@]}"; do
    dir_matches_mode_mask "$dir" 022 || return 1
  done
}

ensure_geometry_dirs() {
  local dir=""
  (( ${#geometry_dirs[@]} > 0 )) || return 1
  for dir in "${geometry_dirs[@]}"; do
    if [[ ! -e $dir && ! -L $dir ]]; then
      mkdir -m 700 -- "$dir" 2>/dev/null || true
    fi
    dir_matches_mode_mask "$dir" 022 || return 1
  done
}

# Only store session geometry under a private, user-owned XDG_RUNTIME_DIR.
# Never fall back to shared /tmp where another local user could pre-create paths or symlinks.
runtime_dir="${XDG_RUNTIME_DIR:-}"
while [[ $runtime_dir == */ && $runtime_dir != "/" ]]; do
  runtime_dir="${runtime_dir%/}"
done

geometry_dirs=()
geometry_dir=""
geometry_file=""

if [[ -n $runtime_dir && $runtime_dir == /* ]] && safe_path_component "$addr" && dir_matches_mode_mask "$runtime_dir" 077; then
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    geometry_dirs=("$runtime_dir/omarchy" "$runtime_dir/omarchy/windows")
    geometry_dir="$runtime_dir/omarchy/windows"
    geometry_file="$geometry_dir/pop-${addr}-geometry"
  elif safe_path_component "$HYPRLAND_INSTANCE_SIGNATURE"; then
    geometry_dirs=(
      "$runtime_dir/omarchy"
      "$runtime_dir/omarchy/windows"
      "$runtime_dir/omarchy/windows/$HYPRLAND_INSTANCE_SIGNATURE"
    )
    geometry_dir="$runtime_dir/omarchy/windows/$HYPRLAND_INSTANCE_SIGNATURE"
    geometry_file="$geometry_dir/pop-${addr}-geometry"
  fi
fi

hypr_dispatch() {
  local lua="$1"
  shift

  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

monitor_rect() {
  local id="$1"
  [[ $id =~ ^-?[0-9]+$ ]] || return 1

  hyprctl monitors -j 2>/dev/null | jq -r --argjson id "$id" '
    first(.[] | select(.id == $id)) // empty
    | ((.transform // 0) % 2 == 1) as $rotated
    | (((if $rotated then .height else .width end) / (.scale // 1)) | floor) as $w
    | (((if $rotated then .width else .height end) / (.scale // 1)) | floor) as $h
    | (.reserved // [0, 0, 0, 0]) as $r
    | "\(.x // 0) \(.y // 0) \($w) \($h) \($r[0] // 0) \($r[1] // 0) \($r[2] // 0) \($r[3] // 0)"
  ' 2>/dev/null
}

if [[ $pinned == "true" ]]; then
  hypr_dispatch "hl.dsp.window.pin({ window = \"$window\" })" pin "$window"
  hypr_dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"-pop\" })" tagwindow -pop "$window"

  if [[ -n $geometry_file ]] && geometry_dirs_safe && [[ -f $geometry_file && ! -L $geometry_file ]]; then
    read -r saved_width saved_height offset_x offset_y saved_monitor <"$geometry_file" || true
    rm -f -- "$geometry_file"

    if [[ $saved_width =~ ^[0-9]+$ && $saved_height =~ ^[0-9]+$ && $offset_x =~ ^-?[0-9]+$ && $offset_y =~ ^-?[0-9]+$ ]]; then
      target_width=$saved_width
      target_height=$saved_height
      target_x=$offset_x
      target_y=$offset_y

      if current_rect=$(monitor_rect "$monitor_id") && [[ -n $current_rect ]]; then
        read -r cur_x cur_y cur_w cur_h res_l res_t res_r res_b <<<"$current_rect"
        target_x=$((cur_x + offset_x))
        target_y=$((cur_y + offset_y))

        if [[ -z $saved_monitor || $monitor_id != "$saved_monitor" ]]; then
          area_x=$((cur_x + res_l))
          area_y=$((cur_y + res_t))
          area_w=$((cur_w - res_l - res_r))
          area_h=$((cur_h - res_t - res_b))

          if (( area_w > 0 )); then
            (( target_width > area_w )) && target_width=$area_w
            max_x=$((area_x + area_w - target_width))
            (( target_x < area_x )) && target_x=$area_x
            (( target_x > max_x )) && target_x=$max_x
          fi

          if (( area_h > 0 )); then
            (( target_height > area_h )) && target_height=$area_h
            max_y=$((area_y + area_h - target_height))
            (( target_y < area_y )) && target_y=$area_y
            (( target_y > max_y )) && target_y=$max_y
          fi
        fi
      fi

      if [[ $floating != "true" ]]; then
        hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"on\" })" togglefloating "$window"
      fi
      hypr_dispatch "hl.dsp.window.resize({ window = \"$window\", x = $target_width, y = $target_height })" resizewindowpixel "exact $target_width $target_height,$window"
      hypr_dispatch "hl.dsp.window.move({ window = \"$window\", x = $target_x, y = $target_y })" movewindowpixel "exact $target_x $target_y,$window"
    else
      hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"off\" })" togglefloating "$window"
    fi
  else
    hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"off\" })" togglefloating "$window"
  fi
elif [[ -n $addr ]]; then
  if [[ $floating == "true" ]]; then
    saved_width=$(jq -r '.size[0] // empty' <<<"$active")
    saved_height=$(jq -r '.size[1] // empty' <<<"$active")
    saved_x=$(jq -r '.at[0] // empty' <<<"$active")
    saved_y=$(jq -r '.at[1] // empty' <<<"$active")

    if [[ -n $geometry_file && $saved_width =~ ^[0-9]+$ && $saved_height =~ ^[0-9]+$ && $saved_x =~ ^-?[0-9]+$ && $saved_y =~ ^-?[0-9]+$ ]]; then
      mon_x=0
      mon_y=0
      if origin_rect=$(monitor_rect "$monitor_id") && [[ -n $origin_rect ]]; then
        read -r mon_x mon_y _ <<<"$origin_rect"
      fi
      offset_x=$((saved_x - mon_x))
      offset_y=$((saved_y - mon_y))

      if ensure_geometry_dirs; then
        tmp_file=$(mktemp "$geometry_dir/.pop-${addr}-geometry.XXXXXX" 2>/dev/null) || tmp_file=""
        if [[ -n $tmp_file ]]; then
          if chmod 600 -- "$tmp_file" &&
            printf '%s %s %s %s %s\n' "$saved_width" "$saved_height" "$offset_x" "$offset_y" "$monitor_id" >"$tmp_file" &&
            mv -f -- "$tmp_file" "$geometry_file"; then
            :
          else
            rm -f -- "$tmp_file"
          fi
        fi
      fi
    fi
  else
    if [[ -n $geometry_file ]] && geometry_dirs_safe; then
      rm -f -- "$geometry_file"
    fi
  fi

  if [[ $floating != "true" ]]; then
    hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"on\" })" togglefloating "$window"
  fi
  hypr_dispatch "hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })" resizewindowpixel "exact $width $height,$window"

  if [[ -n $x && -n $y ]]; then
    hypr_dispatch "hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })" movewindowpixel "exact $x $y,$window"
  else
    hypr_dispatch "hl.dsp.window.center({ window = \"$window\" })" centerwindow "$window"
  fi

  hypr_dispatch "hl.dsp.window.pin({ window = \"$window\" })" pin "$window"
  hypr_dispatch "hl.dsp.window.alter_zorder({ window = \"$window\", mode = \"top\" })" alterzorder top "$window"
  hypr_dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"+pop\" })" tagwindow +pop "$window"
fi

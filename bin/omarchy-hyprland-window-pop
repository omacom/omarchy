#!/bin/bash

# omarchy:summary=Toggle to pop-out a tile to stay fixed on a display basis.
# omarchy:args=[width height x y]

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

active=$(hyprctl activewindow -j)
pinned=$(echo "$active" | jq ".pinned")
addr=$(echo "$active" | jq -r ".address")
window="address:$addr"

commands=()

if [[ $pinned == "true" ]]; then
  commands+=("dispatch hl.dsp.window.pin({ window = \"$window\" })")
  commands+=("dispatch hl.dsp.window.float({ window = \"$window\", action = \"toggle\" })")
  commands+=("dispatch hl.dsp.window.tag({ window = \"$window\", tag = \"-pop\" })")
elif [[ -n $addr ]]; then
  commands+=("dispatch hl.dsp.window.float({ window = \"$window\", action = \"toggle\" })")
  commands+=("dispatch hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })")

  if [[ -n $x && -n $y ]]; then
    commands+=("dispatch hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })")
  else
    commands+=("dispatch hl.dsp.window.center({ window = \"$window\" })")
  fi

  commands+=("dispatch hl.dsp.window.pin({ window = \"$window\" })")
  commands+=("dispatch hl.dsp.window.alter_zorder({ window = \"$window\", mode = \"top\" })")
  commands+=("dispatch hl.dsp.window.tag({ window = \"$window\", tag = \"+pop\" })")
fi

if (( ${#commands[@]} > 0 )); then
  printf -v batch '%s ; ' "${commands[@]}"
  hyprctl --batch "${batch% ; }" >/dev/null
fi

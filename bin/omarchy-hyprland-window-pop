#!/bin/bash

# omarchy:summary=Toggle to pop-out a tile to stay fixed on a display basis.
# omarchy:args=[width height x y]

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

active=$(hyprctl activewindow -j) || exit 1
pinned=$(jq -r ".pinned // false" <<<"$active")
addr=$(jq -r '.address // ""' <<<"$active")
[[ $addr =~ ^0x[[:xdigit:]]+$ ]] || exit 0
workspace=$(jq -r ".workspace.id // 0" <<<"$active")
mode=
if (( workspace > 0 )); then
  mode=$(omarchy-hyprland-workspace-layout-current "$workspace")
fi
window="address:$addr"

hypr_dispatch() {
  local lua="$1"
  shift

  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null
}

hypr_batch() {
  local joined="" cmd out line total=0 ok_count=0
  for cmd in "$@"; do
    joined+="${joined:+ ; }dispatch $cmd"
  done
  out=$(hyprctl --batch "$joined" 2>/dev/null) || return 1
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    (( ++total ))
    [[ $line == "ok" ]] && (( ++ok_count ))
  done <<<"$out"
  if (( total == $# && ok_count == $# )); then
    return 0
  elif (( ok_count == 0 )); then
    return 1
  fi
  return 2
}

if [[ $pinned == "true" ]]; then
  actions=("hl.dsp.window.pin({ window = \"$window\", action = \"off\" })")
  if [[ $mode != "floating" ]]; then
    actions+=("hl.dsp.window.float({ window = \"$window\", action = \"off\" })")
  fi
  actions+=("hl.dsp.window.tag({ window = \"$window\", tag = \"-pop\" })")

  status=0
  hypr_batch "${actions[@]}" || status=$?
  if (( status == 1 )); then
    hypr_dispatch "hl.dsp.window.pin({ window = \"$window\", action = \"off\" })" pin "$window"
    if [[ $mode != "floating" ]]; then
      hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"off\" })" settiled "$window"
    fi
    hypr_dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"-pop\" })" tagwindow -pop "$window"
  elif (( status != 0 )); then
    exit 1
  fi
else
  if (( workspace > 0 )) && [[ $mode != "floating" ]]; then
    exit 0
  fi

  if [[ -n $x && -n $y ]]; then
    move_lua="hl.dsp.window.move({ window = \"$window\", x = $x, y = $y })"
  else
    move_lua="hl.dsp.window.center({ window = \"$window\" })"
  fi

  status=0
  hypr_batch \
    "hl.dsp.window.float({ window = \"$window\", action = \"on\" })" \
    "hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })" \
    "$move_lua" \
    "hl.dsp.window.pin({ window = \"$window\", action = \"on\" })" \
    "hl.dsp.window.alter_zorder({ window = \"$window\", mode = \"top\" })" \
    "hl.dsp.window.tag({ window = \"$window\", tag = \"+pop\" })" || status=$?
  if (( status == 1 )); then
    hypr_dispatch "hl.dsp.window.float({ window = \"$window\", action = \"on\" })" setfloating "$window"
    hypr_dispatch "hl.dsp.window.resize({ window = \"$window\", x = $width, y = $height })" resizeactive exact "$width" "$height" "$window"

    if [[ -n $x && -n $y ]]; then
      hypr_dispatch "$move_lua" moveactive "$x" "$y" "$window"
    else
      hypr_dispatch "$move_lua" centerwindow "$window"
    fi

    hypr_dispatch "hl.dsp.window.pin({ window = \"$window\", action = \"on\" })" pin "$window"
    hypr_dispatch "hl.dsp.window.alter_zorder({ window = \"$window\", mode = \"top\" })" alterzorder top "$window"
    hypr_dispatch "hl.dsp.window.tag({ window = \"$window\", tag = \"+pop\" })" tagwindow +pop "$window"
  elif (( status != 0 )); then
    exit 1
  fi
fi

#!/bin/bash

# omarchy:summary=Keep WirePlumber off the Bluetooth adapter while it resets
# omarchy:group=system
# omarchy:hidden=true

# PipeWire before 1.6.11 frees Bluetooth device and node objects asynchronously
# once WirePlumber 0.5.17 is in use, then still dereferences them. The crash is
# in libspa-bluez5, during adapter removal: S3/S4 resume while the controller
# reloads firmware, and an rfkill that drops hci while a headset is connected.
# systemd restarts WirePlumber at once, which is during that reload, and
# Bluetooth audio stays down afterwards.
#
# https://github.com/omacom/omarchy/issues/11280
# https://github.com/PipeWire/pipewire/commit/b7246d0d5ddc79cbab06e7e55f6dda37c446118d
#
# Until a fixed PipeWire is installed, pause WirePlumber before sleep when a
# paired audio device is present, and start it again only after the adapter is
# powered (or clearly not coming back). The shipped bluez5.auto-connect rule is
# left in place: the monitor hits this path with or without that property.
#
# This is an ordering workaround. It has not been reproduced on hardware here.

set -u

STATE_FILE=${OMARCHY_WIREPLUMBER_SLEEP_STATE:-/run/omarchy-wireplumber-sleep/uids}
USER_RUN=${OMARCHY_WIREPLUMBER_SLEEP_USER_RUN:-/run/user}
POLL=${OMARCHY_WIREPLUMBER_SLEEP_POLL:-0.5}
TRIES=${OMARCHY_WIREPLUMBER_SLEEP_TRIES:-16}
STATE_LOCKED=0
HOLD_GENERATION=
HOLD_UIDS=()

lock_state() {
  local dir
  dir=$(dirname -- "$STATE_FILE")
  mkdir -p -- "$dir" || return 1
  exec 9>"$dir/lock" || return 1
  flock -w 5 9 || return 1
  STATE_LOCKED=1
}

unlock_state() {
  if (( STATE_LOCKED )); then
    flock -u 9 || true
    STATE_LOCKED=0
  fi
}

generation_of() {
  local line
  HOLD_GENERATION=
  HOLD_UIDS=()
  [[ -f $STATE_FILE ]] || return 1
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^generation\ ([0-9]+)$ ]]; then
      HOLD_GENERATION=${BASH_REMATCH[1]}
    elif [[ $line =~ ^uid\ ([0-9]+)$ ]]; then
      HOLD_UIDS+=("${BASH_REMATCH[1]}")
    fi
  done <"$STATE_FILE"
  [[ -n $HOLD_GENERATION ]]
}

write_generation() {
  local tmp gen
  gen=$(date +%s%N)
  tmp="${STATE_FILE}.tmp"
  printf 'generation %s\n' "$gen" >"$tmp" || return 1
  mv -f -- "$tmp" "$STATE_FILE" || return 1
  HOLD_GENERATION=$gen
  HOLD_UIDS=()
}

append_uid() {
  printf 'uid %s\n' "$1" >>"$STATE_FILE" || return 1
  HOLD_UIDS+=("$1")
}

pipewire_fixed() {
  local output
  # 1.6.11 is the release whose notes include the async device-removal fix.
  # Anything we cannot parse keeps the workaround.
  output=$(timeout 2s pipewire --version 2>/dev/null || true)
  [[ $output =~ ([0-9]+)\.([0-9]+)\.([0-9]+) ]] || return 1
  if (( BASH_REMATCH[1] > 1 )); then
    return 0
  fi
  if (( BASH_REMATCH[1] < 1 )); then
    return 1
  fi
  if (( BASH_REMATCH[2] > 6 )); then
    return 0
  fi
  if (( BASH_REMATCH[2] < 6 )); then
    return 1
  fi
  (( BASH_REMATCH[3] >= 11 ))
}

bluez_tree() {
  local output
  if output=$(timeout 2s busctl tree org.bluez --list 2>/dev/null); then
    printf '%s\n' "$output"
    return 0
  fi
  if output=$(timeout 2s busctl tree org.bluez 2>/dev/null); then
    printf '%s\n' "$output"
    return 0
  fi
  return 1
}

bluez_tokens() {
  local tree
  tree=$(bluez_tree) || return 1
  printf '%s\n' "$tree" | tr -s '[:space:]' '\n'
}

uuids_are_audio() {
  local uuids=${1,,}
  [[ $uuids == *0000110a-* || $uuids == *0000110b-* || $uuids == *0000110d-* || $uuids == *00001108-* || $uuids == *00001112-* || $uuids == *0000111e-* || $uuids == *0000111f-* ]]
}

has_paired_audio() {
  local token path value uuids
  local -A seen=()
  while IFS= read -r token; do
    [[ $token =~ (/org/bluez/hci[0-9]+/dev_[0-9A-Fa-f_]+) ]] || continue
    path=${BASH_REMATCH[1]}
    [[ -n ${seen[$path]:-} ]] && continue
    seen[$path]=1
    value=$(timeout 2s busctl get-property org.bluez "$path" org.bluez.Device1 Paired 2>/dev/null || true)
    [[ $value == "b true" ]] || continue
    uuids=$(timeout 2s busctl get-property org.bluez "$path" org.bluez.Device1 UUIDs 2>/dev/null || true)
    if uuids_are_audio "$uuids"; then
      return 0
    fi
  done < <(bluez_tokens || true)
  return 1
}

adapter_state() {
  local token path value tree
  local -A seen=()
  local powered=0 present=0
  if ! tree=$(bluez_tree); then
    printf 'down\n'
    return 0
  fi
  while IFS= read -r token; do
    [[ $token =~ (/org/bluez/hci[0-9]+) ]] || continue
    path=${BASH_REMATCH[1]}
    [[ -n ${seen[$path]:-} ]] && continue
    seen[$path]=1
    present=1
    value=$(timeout 2s busctl get-property org.bluez "$path" org.bluez.Adapter1 Powered 2>/dev/null || true)
    if [[ $value == "b true" ]]; then
      powered=1
      break
    fi
  done < <(printf '%s\n' "$tree" | tr -s '[:space:]' '\n')
  if (( powered )); then
    printf 'powered\n'
  elif (( present )); then
    printf 'present\n'
  else
    printf 'waiting\n'
  fi
}

bluetooth_radio_blocked() {
  local line seen=0 unblocked=0 output
  output=$(rfkill -rn -o TYPE,SOFT,HARD 2>/dev/null) || return 1
  while IFS= read -r line; do
    [[ $line == bluetooth\ * ]] || continue
    seen=1
    if [[ $line == *unblocked* ]]; then
      unblocked=1
    fi
  done <<<"$output"
  (( seen && ! unblocked ))
}

wait_for_adapter() {
  local i state
  for (( i = 1; i <= TRIES; i++ )); do
    state=$(adapter_state)
    if [[ $state == "powered" || $state == "down" ]]; then
      return 0
    fi
    # A blocked radio with no controller node is not reloading firmware.
    # An adapter that exists but is not powered yet still gets the full wait:
    # resume brings the node back before Powered flips, and that is the crash.
    if [[ $state == "waiting" ]] && (( i >= 4 )) && bluetooth_radio_blocked; then
      return 0
    fi
    sleep "$POLL"
  done
}

user_wireplumber_active() {
  timeout 3s systemctl --user --machine="$1@" is-active --quiet wireplumber.service
}

mask_user() {
  timeout 3s systemctl --user --machine="$1@" mask --runtime wireplumber.service
}

stop_user() {
  if ! timeout 3s systemctl --user --machine="$1@" stop wireplumber.service; then
    timeout 3s systemctl --user --machine="$1@" kill --kill-whom=all --signal=KILL wireplumber.service || true
  fi
}

unmask_user() {
  timeout 3s systemctl --user --machine="$1@" unmask --runtime wireplumber.service || true
}

restart_user() {
  timeout 15s systemctl --user --machine="$1@" restart wireplumber.service
}

copy_uids() {
  COPIED_UIDS=()
  if (( ${#HOLD_UIDS[@]} > 0 )); then
    COPIED_UIDS=("${HOLD_UIDS[@]}")
  fi
}

restart_copied() {
  local uid attempt ok
  if (( ${#COPIED_UIDS[@]} == 0 )); then
    return 0
  fi
  for (( attempt = 1; attempt <= 10; attempt++ )); do
    ok=1
    for uid in "${COPIED_UIDS[@]}"; do
      if ! restart_user "$uid"; then
        ok=0
      fi
    done
    if (( ok )); then
      return 0
    fi
    sleep "$POLL"
  done
  printf 'omarchy-system-sleep-wireplumber: WirePlumber did not restart; it will be tried again on the next suspend\n' >&2
  return 1
}

restore_hold_if_unchanged() {
  local expected="$1"
  local uid
  COPIED_UIDS=()
  lock_state || return 1
  if generation_of && [[ $HOLD_GENERATION == "$expected" ]]; then
    copy_uids
    for uid in "${COPIED_UIDS[@]}"; do
      unmask_user "$uid"
    done
    rm -f -- "$STATE_FILE"
  fi
  unlock_state
}

rewrite_copied_hold() {
  local uid tmp
  if (( ${#COPIED_UIDS[@]} == 0 )); then
    return 0
  fi
  lock_state || return 1
  if [[ -f $STATE_FILE ]]; then
    unlock_state
    return 0
  fi
  tmp="${STATE_FILE}.tmp"
  printf 'generation %s\n' "$(date +%s%N)" >"$tmp" || true
  for uid in "${COPIED_UIDS[@]}"; do
    printf 'uid %s\n' "$uid" >>"$tmp" || true
  done
  mv -f -- "$tmp" "$STATE_FILE" || true
  unlock_state
}

release_previous() {
  local uid
  COPIED_UIDS=()
  lock_state || return 1
  if generation_of; then
    copy_uids
    for uid in "${COPIED_UIDS[@]}"; do
      unmask_user "$uid"
    done
    rm -f -- "$STATE_FILE"
  fi
  unlock_state
}

on_pre() {
  local need_hold=0
  if ! release_previous; then
    printf 'omarchy-system-sleep-wireplumber: could not take the sleep lock\n' >&2
    return 0
  fi
  if ! pipewire_fixed && has_paired_audio; then
    need_hold=1
  fi
  # A previous resume can leave these users unmasked but stopped. Bring them
  # back before deciding whether this sleep pauses them again.
  if ! restart_copied; then
    rewrite_copied_hold || true
  fi
  if (( need_hold )); then
    hold_active_users || printf 'omarchy-system-sleep-wireplumber: could not pause wireplumber\n' >&2
  fi
}

hold_active_users() {
  local dir uid
  local -a stopping=()
  lock_state || return 1
  write_generation || {
    unlock_state
    return 1
  }
  for dir in "$USER_RUN"/*; do
    [[ -d $dir && -S $dir/bus ]] || continue
    uid=${dir##*/}
    [[ $uid =~ ^[0-9]+$ ]] || continue
    if user_wireplumber_active "$uid"; then
      if append_uid "$uid"; then
        printf 'omarchy-system-sleep-wireplumber: pausing wireplumber for uid %s\n' "$uid" >&2
        mask_user "$uid" || printf 'omarchy-system-sleep-wireplumber: could not mask wireplumber for uid %s\n' "$uid" >&2
      fi
    fi
  done
  if (( ${#HOLD_UIDS[@]} == 0 )); then
    rm -f -- "$STATE_FILE"
  else
    stopping=("${HOLD_UIDS[@]}")
  fi
  unlock_state
  for uid in "${stopping[@]}"; do
    stop_user "$uid"
  done
}

on_post() {
  local gen count
  lock_state || return 0
  if ! generation_of; then
    unlock_state
    return 0
  fi
  gen=$HOLD_GENERATION
  count=${#HOLD_UIDS[@]}
  unlock_state
  if (( count == 0 )); then
    return 0
  fi
  # user.slice is still frozen until this hook returns, and systemd kills
  # anything left in the sleep service cgroup. A transient timer survives both.
  systemd-run --quiet --no-block --collect \
    --on-active=1s --timer-property=AccuracySec=100ms \
    "$0" recover "$gen" ||
    printf 'omarchy-system-sleep-wireplumber: could not schedule the resume restart\n' >&2
}

on_recover() {
  local expected="${1:-}"
  [[ $expected =~ ^[0-9]+$ ]] || return 0
  lock_state || return 0
  if ! generation_of || [[ $HOLD_GENERATION != "$expected" ]]; then
    unlock_state
    return 0
  fi
  unlock_state
  wait_for_adapter
  restore_hold_if_unchanged "$expected" || return 0
  if ! restart_copied; then
    rewrite_copied_hold || true
  fi
}

case ${1:-} in
  pre) on_pre ;;
  post) on_post ;;
  recover) on_recover "${2:-}" ;;
esac

exit 0

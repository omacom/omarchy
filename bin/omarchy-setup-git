#!/bin/bash

# omarchy:summary=Set the name and email for your git commits, and sign in to GitHub

set -e

name=$(git config --global user.name || true)
email=$(git config --global user.email || true)

echo "Set the name and email used for your git commits."
echo
name=$(gum input --value "$name" --placeholder "Your full name" --prompt "Full name> ")
email=$(gum input --value "$email" --placeholder "you@example.com" --prompt "Email address> ")

# Fill the Compose shortcuts (Compose, Space, n/e) the install used to seed,
# leaving the rest of a hand-edited ~/.XCompose alone.
set_compose_identity() {
  local key=$1 value=$2
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}

  local file
  [[ -f ~/.XCompose ]] || return 0
  # Write through a symlink, so a dotfiles-managed ~/.XCompose stays managed.
  file=$(readlink -f ~/.XCompose)

  KEY="<Multi_key> <space> <$key> :" LINE="<Multi_key> <space> <$key> : \"$value\"" \
    awk 'index($0, ENVIRON["KEY"]) == 1 { print ENVIRON["LINE"]; found = 1; next } { print } END { if (!found) print ENVIRON["LINE"] }' \
    "$file" >"$file.new"
  # Copy back over the original rather than renaming, so it keeps its permissions.
  cat "$file.new" >"$file"
  rm "$file.new"
}

if [[ -n ${name//[[:space:]]/} ]]; then
  git config --global user.name "$name"
  set_compose_identity n "$name"
fi

if [[ -n ${email//[[:space:]]/} ]]; then
  git config --global user.email "$email"
  set_compose_identity e "$email"
fi

if [[ -f ~/.XCompose ]]; then
  omarchy-restart-xcompose || true
fi

echo
if omarchy-cmd-missing gh; then
  echo "The GitHub CLI (gh) is not installed, so skipping GitHub sign-in."
# gh's own record of sign-ins, read directly: running gh would install it first.
elif grep -qs "^github.com:" "${GH_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/gh}/hosts.yml"; then
  echo "Already signed in to GitHub."
elif gum confirm "Sign in to GitHub?"; then
  gh auth login
fi

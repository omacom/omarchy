#!/bin/bash

# omarchy:summary=List available icon sets
# omarchy:examples=omarchy icons list | omarchy icons set "Original"

# The sets that came with Omarchy or another package, the user's own, and
# Original, the set with nothing in it: every app shows its own icon.
{
  find ~/.config/omarchy/icons/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  omarchy-icons-dir
  echo original
} | sort -u | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'

#!/bin/bash

# omarchy:summary=Returns true when Hyprland has an active external monitor
# omarchy:hidden=true

# Physical outputs only. Hyprland's own fallback output is created *because*
# the last display went away, so counting it here would report an external
# monitor precisely when there is none left to drive.
omarchy-hyprland-monitor-physical | grep -qvE '^(eDP|LVDS|DSI)-'

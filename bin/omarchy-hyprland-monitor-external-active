#!/bin/bash

# omarchy:summary=Returns true when Hyprland has an active external monitor
# omarchy:hidden=true

# Hyprland synthesizes an enabled FALLBACK output when every real output is
# disabled or unplugged, and user or remote-desktop session headless outputs
# arrive named HEADLESS-*. Neither is an external monitor: counting them leaves
# a laptop with its panel off and nothing plugged in reading as docked, so the
# internal display is never recovered.
hyprctl monitors all -j | jq -e '.[] | select(.name | test("^(eDP|LVDS|DSI)-|^FALLBACK$|^HEADLESS-") | not) | select(.disabled == false)' >/dev/null 2>&1

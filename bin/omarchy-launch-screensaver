#!/bin/bash

# omarchy:summary=Launch the Omarchy screensaver in the default terminal on the system with the correct font configuration.

# Keep concurrent idle/manual launches from saving each other's screensaver.
exec 9>"$XDG_RUNTIME_DIR/omarchy-screensaver-$HYPRLAND_INSTANCE_SIGNATURE.lock"
flock -n 9 || exit 0

# Exit early if screensaver is already running
pgrep -f '[o]rg.omarchy.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  omarchy-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"

  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# The screensaver's fullscreen rule displaces the previous fullscreen window
# before openwindow is emitted. Save both compositor and client state now.
clients=$(hyprctl clients -j) || exit 1
fullscreen_windows=$(jq -c '[.[] | select(.mapped and (.fullscreen != 0 or .fullscreenClient != 0))
  | {address, pid, stableId, fullscreen, fullscreenClient, fullscreenHandler}]' <<<"$clients") || exit 1

# Open Hyprland's event stream before spawning anything, so a terminal that maps
# quickly can't emit its openwindow event before we are listening for it.
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET" 9>&-)
events_pid=$!
trap 'kill "$events_pid" 2>/dev/null; wait "$events_pid" 2>/dev/null' EXIT

# hypr_exec is async and a new window maps on whatever monitor is focused at that
# moment. Block until this monitor's screensaver actually opens before moving
# focus on -- otherwise slow-starting terminals all pile onto the last monitor.
# The deadline is a safety net in case the window never appears.
wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.omarchy.screensaver,* ]] && return 0
  done
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"

  case $terminal in
  *Alacritty*)
    hypr_exec alacritty --class=org.omarchy.screensaver --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" -e omarchy-screensaver
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.omarchy.screensaver --config-file="$OMARCHY_PATH/default/ghostty/screensaver" --font-size=18 -e omarchy-screensaver
    ;;
  *foot*)
    hypr_exec foot --app-id=org.omarchy.screensaver --config="$OMARCHY_PATH/default/foot/screensaver.ini" -e omarchy-screensaver
    ;;
  *kitty*)
    hypr_exec kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e omarchy-screensaver
    ;;
  esac

  wait_for_screensaver_window
done

hypr_focus_monitor "$focused"

if [[ $fullscreen_windows != "[]" ]]; then
  # All monitors must be clear before restoring: another screensaver closing
  # can otherwise displace the restored window again. Reconcile on close events
  # and timeouts, so an already-closed window cannot leave us waiting forever.
  unanswered=0
  while true; do
    if ! clients=$(hyprctl clients -j); then
      (( ++unanswered >= 3 )) && exit 1
      sleep 1
      continue
    fi
    unanswered=0
    # Keep the class out of jq's argv: the screensaver exits with pkill -f.
    # A failed query is not evidence that every screensaver has closed.
    screensaver_running=$(SCREENSAVER_CLASS=org.omarchy.screensaver \
      jq 'any(.[]; .mapped and .class == env.SCREENSAVER_CLASS)' <<<"$clients") || exit 1
    if [[ $screensaver_running == "false" ]]; then
      break
    fi
    while IFS= read -r -t 1 -u "$events" event; do
      [[ $event == closewindow\>\>* ]] && break
    done
    # A disconnected event stream returns immediately instead of timing out.
    kill -0 "$events_pid" 2>/dev/null || exit 1
  done

  # Address alone can be reused after a window closes. Restore only surviving,
  # changed windows, without focusing them or changing the current workspace.
  while IFS= read -r command; do
    hyprctl dispatch "$command" >/dev/null
  done < <(jq -r --argjson saved "$fullscreen_windows" '
    $saved[] as $before | .[]
    | select(.mapped and .address == $before.address and .pid == $before.pid and .stableId == $before.stableId)
    | select(.fullscreen != $before.fullscreen or .fullscreenClient != $before.fullscreenClient)
    | "hl.dsp.window.fullscreen_state({ window = \"address:\(.address)\", action = \"set\", internal = \($before.fullscreen), client = \($before.fullscreenClient), layout_aware = \($before.fullscreenHandler != "default") })"
  ' <<<"$clients")
fi

#!/bin/bash

# omarchy:summary=Cycle the current active workspace through the dwindle, scrolling, and floating layouts
# omarchy:args=[back]

# Layout changes replace one notification instead of stacking a new one for
# each press, so cycling through the layouts leaves a single, current one.
notify_layout() {
  local state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layout-notification"
  local last id
  [[ -r $state ]] && read -r last <"$state"
  if id=$(omarchy-notification-send -p -r "${last:-0}" -g 󱂬 "$1") && [[ $id =~ ^[0-9]+$ ]]; then
    mkdir -p "$(dirname "$state")" && printf '%s\n' "$id" >"$state"
  fi
}

DIRECTION=${1:-next}
if [[ $DIRECTION != "next" && $DIRECTION != "back" ]]; then
  echo "Usage: omarchy-hyprland-workspace-layout-toggle [back]" >&2
  exit 1
fi

# The compositor can reassign negative IDs. Keep named and special workspaces
# on their two tiled modes and persist their rules by name.
toggle_named_layout() {
  local name="$1" current="$2" selector key layout command applied
  [[ -n $name ]] || return 1
  if [[ $name == special:* ]]; then
    selector=$name
  else
    selector="name:$name"
  fi
  key=$(printf '%s' "$name" | od -An -tx1 | tr -d ' \n')
  selector=${selector//\\/\\\\}
  selector=${selector//\"/\\\"}
  selector=${selector//$'\n'/\\n}
  selector=${selector//$'\r'/\\r}
  selector=${selector//$'\t'/\\t}

  local set_message unsaved_message
  if [[ $current == dwindle ]]; then
    layout=scrolling
    set_message=$(omarchy-i18n layout.workspaceScrolling)
    unsaved_message=$(omarchy-i18n layout.workspaceScrollingUnsaved)
  else
    layout=dwindle
    set_message=$(omarchy-i18n layout.workspaceTiling)
    unsaved_message=$(omarchy-i18n layout.workspaceTilingUnsaved)
  fi
  command="hl.workspace_rule({ workspace = \"$selector\", layout = \"$layout\" })"
  applied=$(hyprctl eval "$command" >/dev/null 2>&1 && hyprctl workspaces -j |
    jq -r --arg name "$name" 'first(.[] | select(.name == $name) | .tiledLayout) // empty')
  if [[ $applied != "$layout" ]]; then
    notify_layout "$(omarchy-i18n layout.needsReload)"
    return 1
  fi
  local layouts_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts"
  if ! mkdir -p "$layouts_dir" || ! printf '%s\n' "$command" >"$layouts_dir/name-$key.lua"; then
    notify_layout "$unsaved_message"
    return 1
  fi
  notify_layout "$set_message"
  omarchy-shell -q omarchy.workspaces refresh
}

ACTIVE_INFO=$(hyprctl activeworkspace -j)
ACTIVE_WORKSPACE=$(jq -r '.id // empty' <<<"$ACTIVE_INFO")
if [[ $ACTIVE_WORKSPACE =~ ^-[0-9]+$ ]]; then
  toggle_named_layout "$(jq -r '.name // empty' <<<"$ACTIVE_INFO")" \
    "$(jq -r '.tiledLayout // empty' <<<"$ACTIVE_INFO")"
  exit $?
fi
[[ $ACTIVE_WORKSPACE =~ ^[0-9]+$ ]] || exit 1
MODES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts"
MODE_FILE="$MODES_DIR/$ACTIVE_WORKSPACE.lua"

CURRENT_MODE=$(omarchy-hyprland-workspace-layout-current)

if [[ $DIRECTION == "back" ]]; then
  case "$CURRENT_MODE" in
    dwindle) NEW_MODE=floating ;;
    floating) NEW_MODE=scrolling ;;
    *) NEW_MODE=dwindle ;;
  esac
else
  case "$CURRENT_MODE" in
    dwindle) NEW_MODE=scrolling ;;
    scrolling) NEW_MODE=floating ;;
    *) NEW_MODE=dwindle ;;
  esac
fi

APPLY="o.workspace_mode({ workspace = \"$ACTIVE_WORKSPACE\", mode = \"$NEW_MODE\" })"

# Dwindle is Hyprland's name for it; the menu and the bar call it tiling.
# Each layout has whole sentences of its own, so a translation can inflect it.
case $NEW_MODE in
  dwindle)
    SET_MESSAGE=$(omarchy-i18n layout.workspaceTiling)
    UNSAVED_MESSAGE=$(omarchy-i18n layout.workspaceTilingUnsaved)
    ;;
  scrolling)
    SET_MESSAGE=$(omarchy-i18n layout.workspaceScrolling)
    UNSAVED_MESSAGE=$(omarchy-i18n layout.workspaceScrollingUnsaved)
    ;;
  *)
    SET_MESSAGE=$(omarchy-i18n layout.workspaceFloating)
    UNSAVED_MESSAGE=$(omarchy-i18n layout.workspaceFloatingUnsaved)
    ;;
esac

# Saving a mode that did not apply would leave the file naming one layout while
# the screen shows another, and restore it at the next login.
APPLIED=0
if hyprctl eval "$APPLY" >/dev/null 2>&1; then
  APPLIED=1
fi

if (( ! APPLIED )); then
  notify_layout "$(omarchy-i18n layout.needsReload)"
elif [[ $NEW_MODE == "$(omarchy-hyprland-workspace-layout-default)" ]] && rm -f "$MODE_FILE"; then
  # Cycled onto the default, a workspace goes back to following it, so a later
  # change of the default reaches it too.
  notify_layout "$SET_MESSAGE"
elif mkdir -p "$MODES_DIR" && printf '%s\n' "$APPLY" >"$MODE_FILE"; then
  notify_layout "$SET_MESSAGE"
else
  # The mode is on screen but nothing will bring it back, and the next press
  # reads the mode from this file, so say so rather than counting it as set.
  notify_layout "$UNSAVED_MESSAGE"
fi

# The bar shows the focused workspace's layout, and the dock shows on floating ones.
if (( APPLIED )); then
  omarchy-shell -q omarchy.workspaces refresh
  omarchy-shell -q omarchy.dock refresh
fi

# A workspace starting to float sets up its titlebars as the mode applies. The
# titlebar plugin itself is only loaded while the config loads, so the first
# floating workspace of a session still needs a reload to bring it in.
if (( APPLIED )) && [[ $NEW_MODE == "floating" ]] && ! hyprctl plugin list -j 2>/dev/null | jq -e 'any(.[]?; .name == "hyprbars")' >/dev/null 2>&1; then
  omarchy-restart-hyprctl
fi

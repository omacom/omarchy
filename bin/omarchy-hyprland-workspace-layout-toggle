#!/bin/bash

# omarchy:summary=Toggle the layout on the current active workspace between dwindle and scrolling

WS=$(hyprctl activeworkspace -j)
ID=$(jq -r '.id' <<<"$WS")
NAME=$(jq -r '.name | strings | select(test("[[:cntrl:]]") | not)' <<<"$WS")

case "$ID" in
  -*|"")
    [[ -n $NAME ]] || exit 1
    SELECTOR="name:$NAME"
    ;;
  *)
    [[ $ID =~ ^[0-9]+$ ]] || exit 1
    SELECTOR="$ID"
    ;;
esac

CURRENT_LAYOUT=$(jq -r '.tiledLayout' <<<"$WS")
LAYOUTS_DIR="$HOME/.local/state/omarchy/workspace-layouts"

# The loader require()s each file by its basename, which reads a dot as a directory
LAYOUT_NAME=${SELECTOR//%/%25}
LAYOUT_NAME=${LAYOUT_NAME//./%2E}
LAYOUT_NAME=${LAYOUT_NAME//\//%2F}
LAYOUT_FILE="$LAYOUTS_DIR/$LAYOUT_NAME.lua"

LUA_SELECTOR=${SELECTOR//\\/\\\\}
LUA_SELECTOR=${LUA_SELECTOR//\"/\\\"}

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  *) NEW_LAYOUT=dwindle ;;
esac

mkdir -p "$LAYOUTS_DIR"
printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$LUA_SELECTOR" "$NEW_LAYOUT" >"$LAYOUT_FILE"

hyprctl eval "hl.workspace_rule({ workspace = \"$LUA_SELECTOR\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1
omarchy-notification-send -g 󱂬 "Workspace layout set to $NEW_LAYOUT"

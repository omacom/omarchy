#!/bin/bash

# omarchy:summary=Toggle the layout on the current active workspace between dwindle and scrolling

WS=$(hyprctl activeworkspace -j)
ID=$(jq -r '.id' <<<"$WS")
NAME=$(jq -r '.name' <<<"$WS")

case "$ID" in
  -*|"")
    [[ -n $NAME && $NAME != null ]] || exit 1
    SELECTOR="name:$NAME"
    ;;
  *)
    [[ $ID =~ ^[0-9]+$ ]] || exit 1
    SELECTOR="$ID"
    ;;
esac

CURRENT_LAYOUT=$(jq -r '.tiledLayout' <<<"$WS")
LAYOUTS_DIR="$HOME/.local/state/omarchy/workspace-layouts"
LAYOUT_FILE="$LAYOUTS_DIR/$SELECTOR.lua"

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  *) NEW_LAYOUT=dwindle ;;
esac

mkdir -p "$LAYOUTS_DIR"
printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$SELECTOR" "$NEW_LAYOUT" >"$LAYOUT_FILE"

hyprctl eval "hl.workspace_rule({ workspace = \"$SELECTOR\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1
omarchy-notification-send -g 󱂬 "Workspace layout set to $NEW_LAYOUT"

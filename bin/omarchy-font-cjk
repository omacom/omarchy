#!/bin/bash

# omarchy:summary=Show or set the glyph forms for Chinese, Japanese, and Korean text
# omarchy:args=[jp|kr|sc|tc|hk|default]
# omarchy:examples=omarchy font cjk | omarchy font cjk jp | omarchy font cjk default

set -euo pipefail

# Also seeded by the first CJK input method or language chosen. Tagged text and
# a CJK session language keep their own forms regardless.
preference=${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/50-omarchy-input-method.conf

case "${1:-}" in
"")
  variant=""
  if [[ -f $preference ]]; then
    variant=$(LC_ALL=C sed -n 's|.*<family>Noto Sans CJK \([A-Z]*\)</family>.*|\1|p' "$preference" | head -n 1)
  fi
  variant=${variant,,}
  echo "${variant:-default}"
  ;;
jp | kr | sc | tc | hk | default)
  /usr/bin/python3 "$OMARCHY_PATH/default/input-methods/configure.py" font "$1"
  omarchy-restart-shell
  omarchy-notification-send -g  "$(omarchy-i18n font.cjkChanged)" "$(omarchy-i18n font.restartAppsToSeeChange)"
  ;;
*)
  echo "Usage: omarchy-font-cjk [jp|kr|sc|tc|hk|default]" >&2
  exit 1
  ;;
esac

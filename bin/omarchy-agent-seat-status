#!/bin/bash

# omarchy:summary=Show whether the agent seat is running and what is on it
# omarchy:args=[--json]

# Exits non-zero when the seat is stopped, so it can guard menu entries.

# The broker answers status at once. One that holds its socket open but never
# answers would hang this call, and with it the menu's guard batch, so a call
# that takes longer than two seconds counts as a stopped seat.
if ! status=$(timeout 2 omarchy-agent-seat-broker call '{"command":"status"}' 2>/dev/null); then
  status='{"running": false}'
else
  status=$(jq '. + {running: true}' <<<"$status")
fi

if [[ $1 == "--json" ]]; then
  echo "$status"
elif [[ $(jq -r '.running' <<<"$status") == "true" ]]; then
  jq -r '"Agent seat: running\n  apps:     \(.apps)\n  windows:  \(.windows)"' <<<"$status"
else
  echo "Agent seat: stopped"
fi

[[ $(jq -r '.running' <<<"$status") == "true" ]]

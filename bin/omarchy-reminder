#!/bin/bash

# omarchy:summary=Set and show lightweight desktop notification reminders
# omarchy:args=[-i|--interactive] | <minutes|time> [message] | show [-j|--json] | clear
# omarchy:examples=omarchy reminder -i | omarchy reminder 5 | omarchy reminder 30 "Check the oven" | omarchy reminder 3:30pm "Call mom" | omarchy reminder "tomorrow 9am" | omarchy reminder show | omarchy reminder show --json | omarchy reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    echo "${minutes}m ${remainder}s"
  elif ((minutes > 0)); then
    echo "${minutes}m"
  else
    echo "${remainder}s"
  fi
}

# Normalize a clock time like 3pm, 3:30 p.m., 15:30, noon, or "tomorrow at 9am"
# to "HH:MM" or "tomorrow HH:MM". Fails for anything else, so GNU date never
# gets to read input like "1h" as a timezone.
normalize_clock_time() {
  local words when prefix=""

  read -r -a words <<<"${1,,}"
  when="${words[*]}"

  if [[ $when =~ ^tomorrow\ (.+)$ ]] || [[ $when =~ ^(.+)\ tomorrow$ ]]; then
    prefix="tomorrow "
    when=${BASH_REMATCH[1]}
  fi
  when=${when#at }

  case $when in
  noon) when="12:00" ;;
  midnight) when="00:00" ;;
  esac

  if [[ $when =~ ^([0-9]{1,2}(:[0-9]{2})?)\ ?([ap])\.?m?\.?$ ]]; then
    when="${BASH_REMATCH[1]} ${BASH_REMATCH[3]}m"
  elif [[ ! $when =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then
    return 1
  fi

  when=$(TZ=UTC date -d "2000-01-01 $when" +%H:%M 2>/dev/null) || return 1
  echo "$prefix$when"
}

next_day() {
  date -d "$1 12:00 tomorrow" +%F
}

# UTC offset a day before <day> <HH:MM>, i.e. before any daylight-saving change on that day.
offset_before_day() {
  date -d "@$(($(TZ=UTC date -d "$1 $2" +%s) - 86400))" +%z
}

# Epoch for a wall-clock HH:MM on a calendar day, resolving daylight-saving
# edges the way JavaScript dates do so the timer matches the prompt's preview:
# a skipped time is read at the offset in force before the jump, and a
# repeated time takes its first occurrence (GNU date picks either, by zone).
local_time_epoch() {
  local day=$1 clock=$2 at_earlier_offset as_parsed

  at_earlier_offset=$(date -d "$day $clock $(offset_before_day "$day" "$clock")" +%s 2>/dev/null) || return 1

  if ! as_parsed=$(date -d "$day $clock" +%s 2>/dev/null); then
    echo "$at_earlier_offset"
  elif ((at_earlier_offset < as_parsed)) && [[ $(date -d "@$at_earlier_offset" '+%F %H:%M') == "$day $clock" ]]; then
    echo "$at_earlier_offset"
  else
    echo "$as_parsed"
  fi
}

# Epoch for a clock time at or after <now>, rolling a time that has already
# passed today over to tomorrow.
clock_time_epoch() {
  local now=$1 clock day target

  clock=$(normalize_clock_time "$2") || return 1
  day=$(date -d "@$now" +%F)

  if [[ $clock == tomorrow\ * ]]; then
    local_time_epoch "$(next_day "$day")" "${clock#tomorrow }"
    return
  fi

  target=$(local_time_epoch "$day" "$clock") || return 1
  if ((target <= now)); then
    local_time_epoch "$(next_day "$day")" "$clock"
  else
    echo "$target"
  fi
}

active_reminder_timers() {
  local now=${1:-$(date +%s)}
  local timer next

  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue

    next=$((next / 1000000))
    ((next <= now)) && continue

    printf "%s\t%s\n" "$timer" "$next"
  done < <(systemctl --user list-timers --all --output=json "omarchy-reminder-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')
}

refresh_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
}

open_interactive() {
  omarchy-shell shell summon omarchy.reminders "{}"
}

show_reminders() {
  local timer next remaining reminder reminder_minutes body=""
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
  local reminder_message=""
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    remaining=$((next - now))
    reminder=${timer%.timer}
    reminder=${reminder#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    reminder_message=""
    [[ -f $reminder_dir/${timer%.timer}.message ]] && reminder_message=$(<"$reminder_dir/${timer%.timer}.message")

    if [[ -n $reminder_message ]]; then
      body+="$reminder_message in $(format_remaining $remaining) ($(date -d "@$next" +%-H:%M))"$'\n'
    else
      body+="${reminder_minutes}-min reminder in $(format_remaining $remaining) ($(date -d "@$next" +%-H:%M))"$'\n'
    fi
  done < <(active_reminder_timers "$now")

  if [[ -z $body ]]; then
    omarchy-notification-send -g 󰢌 "Upcoming reminders" "No outstanding reminders"
  else
    omarchy-notification-send -g 󰢌 "Upcoming reminders" "${body%$'\n'}"
  fi
}

show_json() {
  local timer next remaining reminder reminder_minutes unit reminder_message label item_json reminders_json="[]"
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
  local now=$(date +%s)
  local count=0
  local tooltip="Set Reminder"

  while IFS=$'\t' read -r timer next; do
    count=$((count + 1))

    unit=${timer%.timer}
    reminder=${unit#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    [[ ! $reminder_minutes =~ ^[0-9]+$ ]] && reminder_minutes=0
    remaining=$((next - now))
    reminder_message=""
    [[ -f $reminder_dir/$unit.message ]] && reminder_message=$(<"$reminder_dir/$unit.message")

    if [[ -n $reminder_message ]]; then
      label=$reminder_message
    else
      label="${reminder_minutes}-min reminder"
    fi

    item_json=$(jq -cn \
      --arg unit "$unit" \
      --arg timer "$timer" \
      --arg label "$label" \
      --arg message "$reminder_message" \
      --arg remaining "$(format_remaining "$remaining")" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" \
      --argjson minutes "$reminder_minutes" \
      --argjson at "$next" \
      --argjson remainingSeconds "$remaining" \
      '{unit:$unit,timer:$timer,minutes:$minutes,message:$message,label:$label,remaining:$remaining,remainingSeconds:$remainingSeconds,at:$at,atTime:$atTime}')
    reminders_json=$(jq -cn --argjson reminders "$reminders_json" --argjson item "$item_json" '$reminders + [$item]')
  done < <(active_reminder_timers "$now")

  if ((count == 1)); then
    tooltip="1 reminder"
  elif ((count > 1)); then
    tooltip="$count reminders"
  fi

  jq -cn --argjson count "$count" --arg tooltip "$tooltip" --argjson reminders "$reminders_json" '{count:$count,active:($count > 0),tooltip:$tooltip,reminders:$reminders}'
}

clear_reminders() {
  local units
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

  units=$(systemctl --user list-timers --all --no-legend --no-pager "omarchy-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/omarchy-reminder-*.message 2>/dev/null || true
  refresh_indicator
  omarchy-notification-send -g 󰢌 "All reminders have been cleared"
}

usage() {
  echo "Usage: omarchy-reminder [-i|--interactive]"
  echo "       omarchy-reminder <minutes|time> [message]"
  echo "       omarchy-reminder show [-j|--json]"
  echo "       omarchy-reminder clear"
}

case ${1:-} in
-i | --interactive)
  open_interactive
  exit 0
  ;;
show | list)
  case ${2:-} in
  -j | --json)
    show_json
    ;;
  "")
    show_reminders
    ;;
  *)
    usage
    exit 1
    ;;
  esac
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

when=${1:-}
shift || true
message="$*"
custom_message="$message"
set_at=$(date +%s)

if [[ $when =~ ^[0-9]+$ ]] && ((10#$when > 0)); then
  minutes=$((10#$when))
  timer_spec="--on-active=${minutes}m"
  confirmation="You'll be reminded at $(date -d "@$((set_at + minutes * 60))" +%H:%M)"
  confirmation_title="Reminder set for ${minutes} minutes"
  default_message="Your ${minutes} minutes are up"
  scheduled="in ${minutes} minutes"
elif [[ -n $when ]] && target=$(clock_time_epoch "$set_at" "$when"); then
  minutes=$(((target - set_at + 59) / 60))
  timer_spec="--on-calendar=$(TZ=UTC date -d "@$target" '+%F %T UTC')"
  remind_clock=$(date -d "@$target" '+%-I:%M %p')
  if [[ $(date -d "@$target" +%F) == $(date -d "@$set_at" +%F) ]]; then
    confirmation="You'll be reminded today at $remind_clock"
  else
    confirmation="You'll be reminded tomorrow at $remind_clock"
  fi
  confirmation_title="Reminder set for $remind_clock"
  default_message="It's $remind_clock"
  scheduled="at $remind_clock"
else
  usage
  exit 1
fi

if [[ -z $message ]]; then
  message=$default_message
fi

unit="omarchy-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
message_file="$reminder_dir/$unit.message"

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title="$custom_message $scheduled"
fi

systemd-run --user --quiet --collect "$timer_spec" --unit="$unit" \
  bash -c 'omarchy-notification-send -g 󰢌 "Reminder" "$1"; rm -f "$2"; omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true' bash "$message" "$message_file"

refresh_indicator
omarchy-notification-send -g 󰢌 "$confirmation_title" "$confirmation"

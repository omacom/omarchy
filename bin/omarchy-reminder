#!/bin/bash

# omarchy:summary=Set and show lightweight desktop notification reminders
# omarchy:args=[-i|--interactive] | <minutes> [message] | show [-j|--json] | clear | restore
# omarchy:examples=omarchy reminder -i | omarchy reminder 5 | omarchy reminder 30 "Check the oven" | omarchy reminder show | omarchy reminder show --json | omarchy reminder clear

set -euo pipefail

# Each pending reminder keeps its absolute due time and minutes (and custom
# message) here, so the transient timer that fires it can be re-armed after a
# reboot or logout without depending on the unit name format.
reminder_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/reminders"

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    omarchy-i18n reminder.durationMinutesSeconds "$minutes" "$remainder"
  elif ((minutes > 0)); then
    omarchy-i18n battery.durationMinutes "$minutes"
  else
    omarchy-i18n reminder.durationSeconds "$remainder"
  fi
  echo
}

active_reminder_timers() {
  local now=${1:-$(date +%s)}
  local timer next

  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue

    next=$((next / 1000000))
    ((next <= now)) && continue

    printf "%s\t%s\n" "$timer" "$next"
  done < <(systemctl --user list-timers --all --output=json "omarchy-reminder-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')
}

# Restore and clear take this lock so a clear can't miss a timer that restore is
# re-arming at the same moment.
lock_reminders() {
  mkdir -p "$reminder_dir"
  exec 9>"$reminder_dir/.lock"
  flock 9
}

refresh_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
}

open_interactive() {
  omarchy-shell shell summon omarchy.reminders "{}"
}

show_reminders() {
  local timer next remaining reminder reminder_minutes body=""
  local reminder_message=""
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    remaining=$((next - now))
    reminder=${timer%.timer}
    reminder=${reminder#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    reminder_message=""
    [[ -f $reminder_dir/${timer%.timer}.message ]] && reminder_message=$(<"$reminder_dir/${timer%.timer}.message")

    [[ -n $reminder_message ]] || reminder_message=$(omarchy-i18n reminder.minuteLabel "$reminder_minutes")
    body+="$(omarchy-i18n reminder.inRemaining "$reminder_message" "$(format_remaining $remaining)" "$(date -d "@$next" +%-H:%M)")"$'\n'
  done < <(active_reminder_timers "$now")

  if [[ -z $body ]]; then
    omarchy-notification-send -g 󰢌 "$(omarchy-i18n reminder.upcoming)" "$(omarchy-i18n reminder.none)"
  else
    omarchy-notification-send -g 󰢌 "$(omarchy-i18n reminder.upcoming)" "${body%$'\n'}"
  fi
}

show_json() {
  local timer next remaining reminder reminder_minutes unit reminder_message label item_json reminders_json="[]"
  local now=$(date +%s)
  local count=0
  local tooltip
  tooltip=$(omarchy-i18n reminder.setTooltip)

  while IFS=$'\t' read -r timer next; do
    count=$((count + 1))

    unit=${timer%.timer}
    reminder=${unit#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    [[ ! $reminder_minutes =~ ^[0-9]+$ ]] && reminder_minutes=0
    remaining=$((next - now))
    reminder_message=""
    [[ -f $reminder_dir/$unit.message ]] && reminder_message=$(<"$reminder_dir/$unit.message")

    if [[ -n $reminder_message ]]; then
      label=$reminder_message
    else
      label=$(omarchy-i18n reminder.minuteLabel "$reminder_minutes")
    fi

    item_json=$(jq -cn \
      --arg unit "$unit" \
      --arg timer "$timer" \
      --arg label "$label" \
      --arg message "$reminder_message" \
      --arg remaining "$(format_remaining "$remaining")" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" \
      --argjson minutes "$reminder_minutes" \
      --argjson at "$next" \
      --argjson remainingSeconds "$remaining" \
      '{unit:$unit,timer:$timer,minutes:$minutes,message:$message,label:$label,remaining:$remaining,remainingSeconds:$remainingSeconds,at:$at,atTime:$atTime}')
    reminders_json=$(jq -cn --argjson reminders "$reminders_json" --argjson item "$item_json" '$reminders + [$item]')
  done < <(active_reminder_timers "$now")

  if ((count > 0)); then
    tooltip=$(omarchy-i18n --count "$count" reminder.count "$count")
  fi

  jq -cn --argjson count "$count" --arg tooltip "$tooltip" --argjson reminders "$reminders_json" '{count:$count,active:($count > 0),tooltip:$tooltip,reminders:$reminders}'
}

clear_reminders() {
  local units

  lock_reminders
  units=$(systemctl --user list-timers --all --no-legend --no-pager "omarchy-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/omarchy-reminder-*.{due,message} 2>/dev/null || true
  refresh_indicator
  omarchy-notification-send -g 󰢌 "$(omarchy-i18n reminder.cleared)"
}

# Start the timer that fires a stored reminder after delay seconds. The payload
# drops the stored record, so a reminder fires once even if it was overdue.
arm_reminder() {
  local unit=$1 delay=$2 message=$3

  systemd-run --user --quiet --collect --on-active="${delay}s" --unit="$unit" \
    bash -c 'omarchy-notification-send -g 󰢌 "$(omarchy-i18n reminder.title)" "$1"; rm -f "$2.due" "$2.message"; omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true' bash "$message" "$reminder_dir/$unit"
}

# Re-arm stored reminders whose timers did not survive a reboot or logout.
# Overdue reminders fire right away.
restore_reminders() {
  local due_file unit due delay minutes message
  local now=$(date +%s)

  lock_reminders
  for due_file in "$reminder_dir"/omarchy-reminder-*.due; do
    [[ -f $due_file ]] || continue
    unit=$(basename "$due_file" .due)
    systemctl --user is-active --quiet "$unit.timer" && continue

    due="" minutes=""
    read -r due minutes <"$due_file" || true
    if [[ ! $due =~ ^[0-9]+$ ]] || [[ ! $minutes =~ ^[0-9]+$ ]]; then
      rm -f "$due_file" "$reminder_dir/$unit.message"
      continue
    fi

    if [[ -f $reminder_dir/$unit.message ]]; then
      message=$(<"$reminder_dir/$unit.message")
    else
      message=$(omarchy-i18n --count "$minutes" reminder.minutesUp "$minutes")
    fi

    delay=$((due - now))
    ((delay < 1)) && delay=1
    arm_reminder "$unit" "$delay" "$message"
  done

  refresh_indicator
}

usage() {
  echo "Usage: omarchy-reminder [-i|--interactive]"
  echo "       omarchy-reminder <minutes> [message]"
  echo "       omarchy-reminder show [-j|--json]"
  echo "       omarchy-reminder clear"
  echo "       omarchy-reminder restore"
}

case ${1:-} in
-i | --interactive)
  open_interactive
  exit 0
  ;;
show | list)
  case ${2:-} in
  -j | --json)
    show_json
    ;;
  "")
    show_reminders
    ;;
  *)
    usage
    exit 1
    ;;
  esac
  exit 0
  ;;
clear)
  clear_reminders
  exit 0
  ;;
restore)
  restore_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]]; then
  usage
  exit 1
fi

# Read the minutes as base 10, so "010" means ten minutes and not octal eight.
minutes=$((10#$minutes))
if ((minutes == 0)); then
  usage
  exit 1
fi

if [[ -z $message ]]; then
  message=$(omarchy-i18n --count "$minutes" reminder.minutesUp "$minutes")
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="omarchy-reminder-${minutes}m-$set_at"
message_file="$reminder_dir/$unit.message"
confirmation=$(omarchy-i18n reminder.willRemindAt "$remind_at")
confirmation_title=$(omarchy-i18n --count "$minutes" reminder.setForMinutes "$minutes")

mkdir -p "$reminder_dir"
echo "$((set_at + minutes * 60)) $minutes" >"$reminder_dir/$unit.due"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title=$(omarchy-i18n --count "$minutes" reminder.customInMinutes "$custom_message" "$minutes")
fi

arm_reminder "$unit" $((minutes * 60)) "$message"

refresh_indicator
omarchy-notification-send -g 󰢌 "$confirmation_title" "$confirmation"

#!/bin/bash

# omarchy:summary=Set and show lightweight desktop notification reminders
# omarchy:args=[-i|--interactive] | <minutes> [message] | show [-j|--json] | cancel <unit> | clear
# omarchy:examples=omarchy reminder -i | omarchy reminder 5 | omarchy reminder 30 "Check the oven" | omarchy reminder show | omarchy reminder show --json | omarchy reminder clear

set -euo pipefail

format_remaining() {
  local seconds=$1
  local minutes=$((seconds / 60))
  local remainder=$((seconds % 60))

  if ((minutes > 0 && remainder > 0)); then
    omarchy-i18n reminder.durationMinutesSeconds "$minutes" "$remainder"
  elif ((minutes > 0)); then
    omarchy-i18n battery.durationMinutes "$minutes"
  else
    omarchy-i18n reminder.durationSeconds "$remainder"
  fi
  echo
}

active_reminder_timers() {
  local now=${1:-$(date +%s)}
  local timer next

  while IFS=$'\t' read -r timer next; do
    [[ -z $timer || -z $next ]] && continue

    next=$((next / 1000000))
    ((next <= now)) && continue

    printf "%s\t%s\n" "$timer" "$next"
  done < <(systemctl --user list-timers --all --output=json "omarchy-reminder-*.timer" 2>/dev/null | jq -r '.[] | [.unit, .next] | @tsv')
}

refresh_indicator() {
  omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true
}

open_interactive() {
  omarchy-shell shell summon omarchy.reminders "{}"
}

# Cards shown before the rest are summed up in one "3 more reminders" card.
SHOW_CARDS=5

# One card per reminder, with when it's due as the headline and its message
# below, so a long message is never cut off by the others. Cards stack newest
# on top, so the "more" card is sent first and the soonest reminder last.
# Transient keeps a status check out of notification history. Clicking a card
# runs its first button, so that one is Keep, which does nothing, and Cancel
# comes second.
show_reminders() {
  local timer next reminder reminder_minutes reminder_message lines=() i
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
  local now=$(date +%s)

  while IFS=$'\t' read -r timer next; do
    reminder=${timer%.timer}
    reminder=${reminder#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    reminder_message=""
    [[ -f $reminder_dir/${timer%.timer}.message ]] && reminder_message=$(<"$reminder_dir/${timer%.timer}.message")
    [[ -n $reminder_message ]] || reminder_message=$(omarchy-i18n reminder.minuteLabel "$reminder_minutes")

    lines+=("${timer%.timer}"$'\t'"$(omarchy-i18n reminder.dueInAt "$(format_remaining $((next - now)))" "$(date -d "@$next" +%-H:%M)")"$'\t'"$reminder_message")
  done < <(active_reminder_timers "$now")

  if ((${#lines[@]} == 0)); then
    omarchy-notification-send -g 󰢌 --transient "$(omarchy-i18n reminder.upcoming)" "$(omarchy-i18n reminder.none)"
    return
  fi

  local shown=${#lines[@]} rest
  if ((shown > SHOW_CARDS)); then
    rest=$((shown - SHOW_CARDS))
    omarchy-notification-send -g 󰢌 --transient "$(omarchy-i18n --count "$rest" reminder.andMore "$rest")"
    shown=$SHOW_CARDS
  fi

  local unit label message
  for ((i = shown - 1; i >= 0; i--)); do
    IFS=$'\t' read -r unit label message <<<"${lines[i]}"
    omarchy-notification-send -g 󰢌 --transient "$label" "$message" \
      --action "$(omarchy-i18n reminder.keep)" true \
      --action "$(omarchy-i18n reminder.cancel)" omarchy-reminder cancel \
      --with "$unit"
  done
}

show_json() {
  local timer next remaining reminder reminder_minutes unit reminder_message label item_json reminders_json="[]"
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
  local now=$(date +%s)
  local count=0
  local tooltip
  tooltip=$(omarchy-i18n reminder.setTooltip)

  while IFS=$'\t' read -r timer next; do
    count=$((count + 1))

    unit=${timer%.timer}
    reminder=${unit#omarchy-reminder-}
    reminder_minutes=${reminder%%m-*}
    [[ ! $reminder_minutes =~ ^[0-9]+$ ]] && reminder_minutes=0
    remaining=$((next - now))
    reminder_message=""
    [[ -f $reminder_dir/$unit.message ]] && reminder_message=$(<"$reminder_dir/$unit.message")

    if [[ -n $reminder_message ]]; then
      label=$reminder_message
    else
      label=$(omarchy-i18n reminder.minuteLabel "$reminder_minutes")
    fi

    item_json=$(jq -cn \
      --arg unit "$unit" \
      --arg timer "$timer" \
      --arg label "$label" \
      --arg message "$reminder_message" \
      --arg remaining "$(format_remaining "$remaining")" \
      --arg atTime "$(date -d "@$next" +%-H:%M)" \
      --argjson minutes "$reminder_minutes" \
      --argjson at "$next" \
      --argjson remainingSeconds "$remaining" \
      '{unit:$unit,timer:$timer,minutes:$minutes,message:$message,label:$label,remaining:$remaining,remainingSeconds:$remainingSeconds,at:$at,atTime:$atTime}')
    reminders_json=$(jq -cn --argjson reminders "$reminders_json" --argjson item "$item_json" '$reminders + [$item]')
  done < <(active_reminder_timers "$now")

  if ((count > 0)); then
    tooltip=$(omarchy-i18n --count "$count" reminder.count "$count")
  fi

  jq -cn --argjson count "$count" --arg tooltip "$tooltip" --argjson reminders "$reminders_json" '{count:$count,active:($count > 0),tooltip:$tooltip,reminders:$reminders}'
}

# Stop one pending reminder and drop its message.
cancel_reminder() {
  local unit=${1:-} message
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

  if [[ ! $unit =~ ^omarchy-reminder-[0-9]+m-[0-9]+$ ]]; then
    echo "Usage: omarchy-reminder cancel <unit>" >&2
    return 1
  fi

  message=""
  [[ -f $reminder_dir/$unit.message ]] && message=$(<"$reminder_dir/$unit.message")
  rm -f "$reminder_dir/$unit.message"

  if ! systemctl --user is-active --quiet "$unit.timer"; then
    omarchy-notification-send -g 󰢌 --transient "$(omarchy-i18n reminder.alreadyGone)"
    return 1
  fi

  [[ -n $message ]] || message=$(omarchy-i18n reminder.minuteLabel "$(sed -E 's/^omarchy-reminder-([0-9]+)m-.*/\1/' <<<"$unit")")
  systemctl --user stop "$unit.timer" 2>/dev/null || true
  refresh_indicator
  omarchy-notification-send -g 󰢌 --transient "$(omarchy-i18n reminder.cancelled)" "$message"
}

clear_reminders() {
  local units
  local reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"

  units=$(systemctl --user list-timers --all --no-legend --no-pager "omarchy-reminder-*.timer" 2>/dev/null | awk '{ print $(NF - 1), $NF }')

  if [[ -n $units ]]; then
    xargs -r systemctl --user stop <<<"$units" || true
  fi

  rm -f "$reminder_dir"/omarchy-reminder-*.message 2>/dev/null || true
  refresh_indicator
  omarchy-notification-send -g 󰢌 "$(omarchy-i18n reminder.cleared)"
}

usage() {
  echo "Usage: omarchy-reminder [-i|--interactive]"
  echo "       omarchy-reminder <minutes> [message]"
  echo "       omarchy-reminder show [-j|--json]"
  echo "       omarchy-reminder cancel <unit>"
  echo "       omarchy-reminder clear"
}

case ${1:-} in
-i | --interactive)
  open_interactive
  exit 0
  ;;
show | list)
  case ${2:-} in
  -j | --json)
    show_json
    ;;
  "")
    show_reminders
    ;;
  *)
    usage
    exit 1
    ;;
  esac
  exit 0
  ;;
cancel)
  cancel_reminder "${2:-}"
  exit $?
  ;;
clear)
  clear_reminders
  exit 0
  ;;
esac

minutes=${1:-}
shift || true
message="$*"
custom_message="$message"

if [[ -z $minutes ]] || [[ ! $minutes =~ ^[0-9]+$ ]] || ((minutes == 0)); then
  usage
  exit 1
fi

if [[ -z $message ]]; then
  message=$(omarchy-i18n --count "$minutes" reminder.minutesUp "$minutes")
fi

set_at=$(date +%s)
remind_at=$(date -d "+${minutes} minutes" +%H:%M)
unit="omarchy-reminder-${minutes}m-$set_at"
reminder_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-reminders"
message_file="$reminder_dir/$unit.message"
confirmation=$(omarchy-i18n reminder.willRemindAt "$remind_at")
confirmation_title=$(omarchy-i18n --count "$minutes" reminder.setForMinutes "$minutes")

mkdir -p "$reminder_dir"

if [[ -n $custom_message ]]; then
  printf "%s" "$custom_message" >"$message_file"
  confirmation_title=$(omarchy-i18n --count "$minutes" reminder.customInMinutes "$custom_message" "$minutes")
fi

systemd-run --user --quiet --collect --on-active="${minutes}m" --unit="$unit" \
  bash -c 'omarchy-notification-send -g 󰢌 "$(omarchy-i18n reminder.title)" "$1"; rm -f "$2"; omarchy-shell -q omarchy.indicators refresh >/dev/null 2>&1 || true' bash "$message" "$message_file"

refresh_indicator
omarchy-notification-send -g 󰢌 "$confirmation_title" "$confirmation"

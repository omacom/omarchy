#!/bin/bash

# omarchy:summary=Install Slack Desktop with live Omarchy theme support
# omarchy:requires-sudo=true

set -euo pipefail

omarchy-pkg-add slack-desktop
if omarchy-setup-slack; then
  omarchy-launch-after-done uwsm-app -- gtk-launch slack
else
  echo "Slack theme setup failed; opening packaged Slack." >&2
  omarchy-launch-after-done uwsm-app -- gio launch /usr/share/applications/slack.desktop
fi

#!/bin/bash

# omarchy:summary=Print the active Omarchy mirror and package channel

# Arch Linux ARM's mirrors are the same hosts with an arm- prefix.
if grep -Eq '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://(arm-)?stable-mirror\.omarchy\.org/' /etc/pacman.d/mirrorlist; then
  mirror="stable"
elif grep -Eq '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://(arm-)?rc-mirror\.omarchy\.org/' /etc/pacman.d/mirrorlist; then
  mirror="rc"
elif grep -Eq '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://(arm-)?mirror\.omarchy\.org/' /etc/pacman.d/mirrorlist; then
  mirror="edge"
else
  mirror="unknown"
fi

if grep -Eq '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://pkgs\.omarchy\.org/stable/' /etc/pacman.conf; then
  pkgs="stable"
elif grep -Eq '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://pkgs\.omarchy\.org/rc/' /etc/pacman.conf; then
  pkgs="rc"
elif grep -Eq '^[[:space:]]*Server[[:space:]]*=[[:space:]]*https://pkgs\.omarchy\.org/edge/' /etc/pacman.conf; then
  pkgs="edge"
else
  pkgs="unknown"
fi

if [[ $mirror == $pkgs ]]; then
  echo $mirror
else
  echo "$mirror / $pkgs"
fi

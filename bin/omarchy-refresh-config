#!/bin/bash

# omarchy:summary=Copy a shipped user config from $OMARCHY_PATH/config into ~/.config (backs up your version).
# omarchy:args=<config-path>

config_file=${1:-}

if [[ -z $config_file ]]; then
  cat <<USAGE
  Usage: $0 [config_file]

  Must provide a file path relative to .config to be refreshed.
  To copy $OMARCHY_PATH/config/hypr/hyprland.lua to ~/.config/hypr/hyprland.lua:

    $0 hypr/hyprland.lua
USAGE
  exit 1
fi

if [[ $config_file == /* || "/$config_file/" == *"/../"* ]]; then
  echo "Config path must stay inside .config: $config_file" >&2
  exit 1
fi

config_source_root=$(realpath -e -- "$OMARCHY_PATH/config") || {
  echo "Omarchy config directory not found: $OMARCHY_PATH/config" >&2
  exit 1
}
default_config_file=$(realpath -e -- "$config_source_root/$config_file") || {
  echo "Not a shipped user config: $config_file" >&2
  exit 1
}

if [[ $default_config_file != "$config_source_root/"* || ! -f $default_config_file ]]; then
  echo "Not a shipped user config: $config_file" >&2
  exit 1
fi

user_config_root=$(realpath -m -- "$HOME/.config") || {
  echo "Could not resolve user config directory: $HOME/.config" >&2
  exit 1
}
user_config_file=$(realpath -m -- "$user_config_root/$config_file") || {
  echo "Could not resolve user config path: $config_file" >&2
  exit 1
}

if [[ $user_config_file != "$user_config_root/"* ]]; then
  echo "Config path must stay inside .config: $config_file" >&2
  exit 1
fi

backup_config_file="$user_config_file.bak.$(date +%s)"

mkdir -p "$(dirname "$user_config_file")"

if [[ -f $user_config_file ]]; then
  cp -f "$user_config_file" "$backup_config_file"
  cp -f "$default_config_file" "$user_config_file"

  if cmp -s "$user_config_file" "$backup_config_file"; then
    rm "$backup_config_file"
  else
    echo -e "\e[31mReplaced $user_config_file with new Omarchy default.\nSaved backup as ${backup_config_file}.\n\n\e[32mChanges:\e[0m"
    diff "$user_config_file" "$backup_config_file" || true
  fi
else
  cp -f "$default_config_file" "$user_config_file"
fi

#!/bin/bash

# omarchy:summary=Check that every disk swap a hibernation image can go to is encrypted

swaps=$(swapon --show=NAME --noheadings --raw | grep -v '^/dev/zram')
[[ -n $swaps ]] || exit 1

while read -r swap; do
  device=$swap
  [[ -f $swap ]] && device=$(findmnt -no SOURCE -T "$swap" | sed 's/\[.*//')

  # Every path from the swap down to a disk has to pass through a crypt mapping.
  lsblk -J -s -p -o NAME,TYPE "$device" 2>/dev/null | jq -e '
    def encrypted: .type == "crypt" or ((.children // []) as $below | $below != [] and all($below[]; encrypted));
    .blockdevices != [] and all(.blockdevices[]; encrypted)' >/dev/null || exit 1
done <<<"$swaps"

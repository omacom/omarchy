#!/bin/bash

# omarchy:summary=Ensure default application launchers are installed.
# omarchy:args=[--restore]

# Copy .desktop declarations
mkdir -p ~/.local/share/applications
for desktop in "$OMARCHY_PATH"/applications/*.desktop; do
  # Defaults added after release reach new users through /etc/skel; a refresh only updates
  # them, unless the user asked to --restore the preinstalls.
  if [[ $1 != --restore && ${desktop##*/} == Netflix.desktop && ! -f ~/.local/share/applications/Netflix.desktop ]]; then
    continue
  fi
  cp "$desktop" ~/.local/share/applications/
done

if omarchy-cmd-present alacritty; then
  cp "$OMARCHY_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

update-desktop-database ~/.local/share/applications

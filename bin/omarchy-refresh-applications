#!/bin/bash

# omarchy:summary=Ensure default application launchers are installed.
# omarchy:args=[--first-install]

# The region's list names the launchers it installs (docs/regions.md).
region=$(cat "${OMARCHY_REGION_FILE:-/etc/omarchy/region}" 2>/dev/null)
list="$OMARCHY_PATH/default/regions/$region/applications"
if [[ ! $region =~ ^[a-z]{2}$ || ! -f $list ]]; then
  list="$OMARCHY_PATH/default/regions/global/applications"
fi
mapfile -t launchers < <(sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$list")

mkdir -p ~/.local/share/applications

# /etc/skel seeds every shipped launcher before the region is known, so a
# brand-new home drops the ones its region doesn't list.
if [[ ${1:-} == "--first-install" ]]; then
  for launcher in "$OMARCHY_PATH"/applications/*.desktop; do
    name=$(basename "$launcher" .desktop)
    if ! printf '%s\n' "${launchers[@]}" | grep -qxF -- "$name"; then
      rm -f ~/.local/share/applications/"$name.desktop"
    fi
  done
fi

for name in "${launchers[@]}"; do
  cp "$OMARCHY_PATH/applications/$name.desktop" ~/.local/share/applications/
done

if omarchy-cmd-present alacritty; then
  cp "$OMARCHY_PATH/default/alacritty/Alacritty.desktop" ~/.local/share/applications/
fi

update-desktop-database ~/.local/share/applications

#!/bin/bash

# omarchy:summary=Display a "Done!" or "Failed!" message and wait for user to press any key.
# omarchy:args=[exit-code]

code="${1:-0}"

# (( )) evaluates its operands as arithmetic, so a hostile $1 like
# 'a[$(touch /tmp/pwned)]' would run command substitution. Accept only what a
# real exit status can be: ASCII digits forced to base 10 (so a leading zero
# like 010 means decimal 10, not octal, and 08 is valid), within the 0-255
# exit-status range. Anything else is a caller bug: fail loudly on stderr
# rather than printing a misleading "Done!".
case $code in
  '' | *[!0-9]*)
    printf 'omarchy-show-done: invalid exit code: %s\n' "${1-}" >&2
    exit 2
    ;;
esac
if ((${#code} > 3)) || ((10#$code > 255)); then
  printf 'omarchy-show-done: exit code out of range (0-255): %s\n' "${1-}" >&2
  exit 2
fi
code=$((10#$code))

# The device node is there whether or not a terminal is behind it, so opening
# it is the only test that means anything.
: 2>/dev/null <>/dev/tty || exit 0

# gum 2.0 no longer lets a spun command read the terminal, so the wait has to
# happen here. Its own query replies are still queued on the tty; drop those or
# they answer the keypress for the user.
while read -rsn 1 -t 0.1 _ </dev/tty; do :; done

# Prompt on the terminal rather than stdout, or a caller that redirects us
# leaves the user waiting on a prompt they were never shown.
if (( code == 0 )); then
  printf '\n\033[32m● \033[0mDone! Press any key to close...' >/dev/tty
else
  printf '\n\033[31m● \033[0mFailed (exit code %d)! Press any key to close...' "$code" >/dev/tty
fi
read -rsn 1 </dev/tty
echo >/dev/tty

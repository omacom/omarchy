#!/bin/bash

# omarchy:summary=Record dictation using Hex
# omarchy:args=<start|stop|toggle>

# Hex's control commands exit 3 when no Hex is running and never launch it.
not_running=3
no_speech=4

hex_recording() {
  [[ $(hex status --json 2>/dev/null | jq -r '.capture.recording // empty') == "dictation" ]]
}

start() {
  hex dictation start
  local result=$?
  if (( result == not_running )); then
    hex start >/dev/null && hex dictation start
  else
    return "$result"
  fi
}

# Hex pastes with a bare Ctrl+V, which terminals ignore, so take the transcript
# and paste it with Shift+Insert, which terminals and other apps both accept,
# like Omarchy's clipboard history. Always send the stop: Hex
# runs commands in order, but its status reports a recording only ~150ms after
# it starts, so a quick push-to-talk tap would otherwise leave it recording.
stop() {
  local text result error
  if omarchy-cmd-missing hex; then
    return 0
  fi
  # Hold Hex's message back until it turns out to be a real failure.
  error=$(mktemp)
  text=$(hex dictation stop --print 2>"$error")
  result=$?
  if (( result == 0 )); then
    omarchy-clipboard-paste-text --shift-insert "$text"
  elif (( result == no_speech || result == not_running )) || ! hex_recording; then
    # Nothing heard, Hex not running, or nothing was recording: stopping succeeded.
    result=0
  else
    cat "$error" >&2
  fi
  rm -f "$error"
  return "$result"
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  toggle)
    if hex_recording; then
      stop
    else
      start
    fi
    ;;
  *) echo "Usage: omarchy dictation hex <start|stop|toggle>" >&2; exit 1 ;;
esac

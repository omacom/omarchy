#!/bin/bash

# omarchy:summary=Record dictation using Hex
# omarchy:args=<start|stop|toggle>

# Hex's control commands exit 3 when no Hex is running and never launch it.
not_running=3
no_speech=4

# `hex status` prints JSON only with --json, and the dictation state moved from
# `.desktop.activity.state` (3.1 and older, "dictating") to `.capture.state`
# (3.2 and newer, "recording"), so read whichever field the running Hex has.
hex_state() {
  hex status --json 2>/dev/null | jq -r '.capture.state // .desktop.activity.state // empty'
}

hex_dictating() {
  local state
  state=$(hex_state)
  [[ $state == "recording" || $state == "dictating" ]]
}

start() {
  hex dictation start
  local result=$?
  if (( result == not_running )); then
    hex start >/dev/null && hex dictation start
  else
    return "$result"
  fi
}

# Hex pastes with a bare Ctrl+V, which terminals ignore, so take the transcript
# and let Omarchy type it into whatever is focused.
stop() {
  local text result
  if omarchy-cmd-missing hex || ! hex_dictating; then
    return 0
  fi
  text=$(hex dictation stop --print)
  result=$?
  if (( result == 0 )); then
    omarchy-clipboard-paste-text "$text"
  elif (( result != no_speech )); then
    return "$result"
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  toggle)
    if hex_dictating; then
      stop
    else
      start
    fi
    ;;
  *) echo "Usage: omarchy dictation hex <start|stop|toggle>" >&2; exit 1 ;;
esac

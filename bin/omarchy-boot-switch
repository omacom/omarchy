#!/bin/bash

# omarchy:summary=Move this machine from the Limine boot loader to systemd-boot, the boot loader Secure Boot needs
# omarchy:args=[--check] [--yes] | status | revert
# omarchy:examples=omarchy-boot-switch --check | omarchy-boot-switch | omarchy-boot-switch status
# omarchy:requires-sudo=true

# The switch happens in stages, each recorded in the boot store, so it can be
# re-run, finished or reverted from wherever it stopped:
#
#   staged     The boot store exists, the kernel command line moved out of
#              Limine's config, boot images are built and systemd-boot is on
#              the ESP next to Limine. Nothing the firmware starts has changed.
#   trial      The firmware boots systemd-boot once (BootNext). Limine stays
#              first in the boot order, so a boot that fails or hangs comes
#              back up on Limine after a reset.
#   promoted   The trial boot came up: systemd-boot moves to the front of the
#              boot order. Limine stays installed as the fallback.
#   active     The next boot proved the firmware starts systemd-boot from its
#              boot order. Limine's packages, files and boot entry go; a fresh
#              snapshot is taken so a rollback point exists on the new loader.
#
# confirm (run at every boot by omarchy-boot-confirm.service) moves trial to
# promoted and promoted to active. revert puts Limine back up to active.
#
# Snapshots taken before the switch stay on disk but can't be booted from
# systemd-boot: their roots expect Limine.

set -euo pipefail

STORE=${OMARCHY_BOOT_STORE:-/var/lib/omarchy/boot}
ESP=${OMARCHY_BOOT_ESP:-/boot}
# The EFI architecture names the loader and the firmware's fallback path.
if omarchy-hw-aarch64; then
  EFI_ARCH=aa64
else
  EFI_ARCH=x64
fi
LOADER_SOURCE=/usr/lib/systemd/boot/efi/systemd-boot$EFI_ARCH.efi
LOADER_PATH="\\EFI\\systemd\\systemd-boot$EFI_ARCH.efi"
FALLBACK=EFI/BOOT/BOOT${EFI_ARCH^^}.EFI
LOADER_LABEL="Omarchy Boot"
BOOT_DEFAULTS=${OMARCHY_PATH:-/usr/share/omarchy}/default/boot
LOADER_GUID=4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
TOP=/run/omarchy-boot/top

die() {
  echo -e "\e[31m$*\e[0m" >&2
  exit 1
}

say() {
  echo -e "$*"
}

kv_get() {
  [[ -f $1 ]] || return 0
  sed -n "s/^$2=//p" "$1" | tail -1
}

kv_set() {
  local file=$1 key=$2 value=$3 tmp
  tmp=$(mktemp "$file.XXXXXX")
  [[ -f $file ]] && { grep -v "^$key=" "$file" >"$tmp" || true; }
  printf '%s=%s\n' "$key" "$value" >>"$tmp"
  chmod 0644 "$tmp"
  mv -f "$tmp" "$file"
  sync -f "$file" 2>/dev/null || true
}

state_get() { kv_get "$STORE/state" "$1"; }
state_set() { kv_set "$STORE/state" "$1" "$2"; }
phase() { state_get phase; }

# Shown at the next login by omarchy-boot-notify.
notice() {
  state_set notice_id "$(date +%s)"
  state_set notice_title "$1"
  state_set notice_body "$2"
}

as_root() {
  if ((EUID == 0)); then
    "$@"
  else
    sudo "$@"
  fi
}

efivar_string() {
  local file=/sys/firmware/efi/efivars/$1-$LOADER_GUID
  [[ -r $file ]] && tail -c +5 "$file" | tr -d '\0'
  return 0
}

boot_current() {
  efibootmgr | sed -n 's/^BootCurrent: //p'
}

boot_order() {
  efibootmgr | sed -n 's/^BootOrder: //p'
}

# The NVRAM entry whose loader is on this ESP at the given path.
boot_entry_for() {
  local path=$1 partuuid
  partuuid=$(lsblk -no PARTUUID "$(findmnt -n -o SOURCE --mountpoint "$ESP")")
  # Through ENVIRON: awk -v would read the backslashes in the path as escapes.
  [[ -n $partuuid ]] || return 0
  # awk reads to the end: leaving early could kill efibootmgr with SIGPIPE,
  # which pipefail turns into a silent exit of the whole switch.
  efibootmgr -v | OMARCHY_UUID=${partuuid,,} OMARCHY_LOADER=${path,,} awk '
    !found && $1 ~ /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]\*?$/ &&
      index(tolower($0), ENVIRON["OMARCHY_UUID"]) && index(tolower($0), ENVIRON["OMARCHY_LOADER"]) {
      sub(/^Boot/, "", $1); sub(/\*$/, "", $1); print $1; found = 1
    }'
}

started_by_systemd_boot() {
  [[ $(efivar_string LoaderInfo) == systemd-boot* ]]
}

# --- preflight -----------------------------------------------------------------

problems=()
notes=()

problem() { problems+=("$1"); }
note() { notes+=("$1"); }

# Every Limine-config line that touches the command line has to be the plain
# KERNEL_CMDLINE[default]+="..." form; anything else (other entries, fallback
# command lines, = instead of +=) is a configuration this switch can't carry
# over faithfully, so it stops instead of guessing.
cmdline_values() {
  local file=$1 line
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *KERNEL_CMDLINE* ]] || continue
    [[ $line =~ ^[[:space:]]*# ]] && continue
    if [[ $line =~ ^[[:space:]]*KERNEL_CMDLINE\[default\]\+=\"([^\"]*)\"[[:space:]]*$ ]]; then
      echo "${BASH_REMATCH[1]}"
    else
      echo "UNSUPPORTED: $line"
    fi
  done <"$file"
}

# Equal as a set of parameters, and every parameter given more than once in
# the same relative order (the kernel and mkinitcpio take the last one;
# ro/rw count as one parameter).
cmdline_equivalent() {
  python3 -I - "$1" "$2" <<'EOF'
import collections, sys
a, b = sys.argv[1].split(), sys.argv[2].split()
if collections.Counter(a) != collections.Counter(b):
    sys.exit(1)
key = lambda t: "ro/rw" if t in ("ro", "rw") else t.split("=", 1)[0]
for k in {key(t) for t in a}:
    if [t for t in a if key(t) == k] != [t for t in b if key(t) == k]:
        sys.exit(1)
EOF
}

preferred_limine_kernel() {
  local pkgbase
  for pkgbase in /usr/lib/modules/*/pkgbase; do
    [[ -f $pkgbase ]] && cat "$pkgbase"
  done | grep -x linux-omarchy || cat /usr/lib/modules/*/pkgbase 2>/dev/null | sed -n 1p
}

preflight() {
  omarchy-hw-x86 || problem "Only x86 machines move to systemd-boot; this one keeps Limine."
  [[ -d /sys/firmware/efi ]] || problem "This machine boots in BIOS mode; systemd-boot needs UEFI."
  if grep -qi apple /sys/class/dmi/id/sys_vendor 2>/dev/null || omarchy-pkg-present linux-t2; then
    problem "Intel Macs keep Limine: their firmware needs testing with systemd-boot first."
  fi

  case $(phase) in
  promoted | active) problem "This machine already boots systemd-boot." ;;
  esac
  omarchy-cmd-present limine-entry-tool || problem "This machine doesn't boot Limine through limine-entry-tool, which the switch starts from."

  local fstype fsroot
  read -r fstype fsroot < <(findmnt -n -o FSTYPE,FSROOT --mountpoint /)
  [[ $fstype == btrfs && $fsroot == /@ ]] || problem "The root filesystem isn't the btrfs @ subvolume Omarchy installs."
  [[ $(findmnt -n -o FSTYPE --mountpoint "$ESP") == vfat ]] || problem "The EFI system partition isn't mounted at $ESP."
  [[ -f /etc/snapper/configs/root ]] || problem "Snapper isn't set up, so there would be no snapshots to boot."
  [[ -f $LOADER_SOURCE ]] || problem "systemd-boot isn't installed ($LOADER_SOURCE)."
  [[ ! -e /etc/omarchy/provisioning.key ]] || problem "Finish setting up the machine's owner first."
  [[ ! -e /var/lib/pacman/db.lck ]] || problem "A package transaction is running."

  if ! grep -q 'omarchy-restore' /etc/mkinitcpio.conf.d/00-omarchy-hooks.conf 2>/dev/null; then
    problem "This Omarchy version's initramfs hooks aren't installed yet. Run omarchy update first."
  fi

  # Room for a boot image per kernel plus staging copies on the ESP, and the
  # stored images on the root.
  local uki_size=0 file free
  for file in "$ESP"/EFI/Linux/*.efi; do
    [[ -f $file ]] && ((uki_size < $(stat -c %s "$file"))) && uki_size=$(stat -c %s "$file")
  done
  ((uki_size)) || uki_size=$((80 * 1024 * 1024))
  free=$(df --output=avail -B1 "$ESP" | tail -1)
  ((free > 3 * uki_size + 32 * 1024 * 1024)) ||
    problem "The EFI system partition needs $(((3 * uki_size + 32 * 1024 * 1024) / 1024 / 1024)) MB free; it has $((free / 1024 / 1024)) MB."
  free=$(df --output=avail -B1 / | tail -1)
  ((free > 2 * 1024 * 1024 * 1024)) || problem "The root filesystem needs 2 GB free for boot images."

  # Other operating systems Limine starts. systemd-boot finds Windows on this
  # ESP by itself; anything else moves to the firmware's boot menu.
  local entry
  while IFS= read -r entry; do
    [[ -n $entry ]] || continue
    if [[ $entry == *Windows* && -f $ESP/EFI/Microsoft/Boot/bootmgfw.efi ]]; then
      note "Windows stays in the boot menu."
    else
      note "\"$entry\" won't be in systemd-boot's menu; start it from the firmware's boot menu instead."
    fi
  done < <(sed -n 's#^/+\{0,1\}\([^/].*\)$#\1#p' "$ESP/limine.conf" 2>/dev/null | grep -vxE 'Omarchy|Snapshots|EFI fallback' || true)

  check_cmdline
}

# The command line the switch will write, checked against what Limine boots.
check_cmdline() {
  local kernel effective base values file stem converted=() out
  kernel=$(preferred_limine_kernel)
  effective=$(limine-entry-tool --get-cmdline "$kernel" 2>/dev/null | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//') || true
  if [[ -z $effective || $effective != *root=* ]]; then
    problem "Limine reports no command line for $kernel."
    return
  fi
  if [[ $(tr -s '[:space:]' ' ' </proc/cmdline) != "$effective"* ]]; then
    problem "This boot didn't start with Limine's current command line; reboot into Omarchy normally first."
  fi

  base=$(cmdline_values /etc/default/limine)
  for file in /usr/share/limine-entry-tool.d/*.conf /etc/limine-entry-tool.conf /etc/limine-entry-tool.d/*.conf; do
    [[ -f $file ]] || continue
    values=$(cmdline_values "$file")
    [[ -n $values ]] || continue
    stem=$(basename "$file" .conf)
    converted+=("$stem")
    base+=$'\n'"#$stem"$'\n'"$values"
  done
  if [[ $base == *UNSUPPORTED:* ]]; then
    problem "Limine's config sets the command line in a way the switch can't carry over:"$'\n'"$(grep '^UNSUPPORTED: ' <<<"$base" | sed 's/^UNSUPPORTED: /  /')"
    return
  fi

  out=$(awk '/^#/ { next } { printf "%s ", $0 }' <<<"$base" | tr -s ' ' | sed 's/^ //; s/ $//')
  cmdline_equivalent "$out" "$effective" ||
    problem "Limine's command line doesn't match its config files:"$'\n'"  Limine: $effective"$'\n'"  config: $out"
}

# --- staging --------------------------------------------------------------------

root_device() {
  local device
  device=$(findmnt -n -o SOURCE --mountpoint /)
  echo "${device%%\[*}"
}

create_store() {
  local device fstab_line
  device=$(root_device)
  mkdir -p "$TOP"
  mountpoint -q "$TOP" || mount -t btrfs -o subvolid=5 "$device" "$TOP"
  [[ -d $TOP/@omarchy-boot ]] || btrfs -q subvolume create "$TOP/@omarchy-boot" >/dev/null

  if ! grep -qE '[[:space:]]/var/lib/omarchy/boot[[:space:]]' /etc/fstab; then
    fstab_line=$(awk '$2 == "/" && $3 == "btrfs"' /etc/fstab | sed -n 1p)
    [[ -n $fstab_line ]] || die "/etc/fstab has no btrfs root line to copy the store's mount from."
    fstab_line=$(awk 'BEGIN { OFS = "\t" } { $2 = "/var/lib/omarchy/boot"; gsub(/subvol=\/?@(,|$)/, "subvol=/@omarchy-boot,", $4); sub(/,$/, "", $4); $6 = 0; print }' <<<"$fstab_line")
    printf '# Omarchy boot images (omarchy-boot-switch)\n%s\n' "$fstab_line" >>/etc/fstab
    systemctl daemon-reload
  fi
  mkdir -p "$STORE"
  mountpoint -q "$STORE" || mount "$STORE"
  chmod 0755 "$STORE"
  mkdir -p "$STORE/keys" "$STORE/backup"
  chmod 0700 "$STORE/keys"
}

convert_cmdline() {
  local file stem values
  [[ -f $STORE/backup/kernel-cmdline ]] || cp -a /etc/kernel/cmdline "$STORE/backup/kernel-cmdline" 2>/dev/null || true

  cmdline_values /etc/default/limine | paste -sd' ' - | tr -s ' ' | sed 's/^ //; s/ $//' >/etc/kernel/cmdline.new
  mv -f /etc/kernel/cmdline.new /etc/kernel/cmdline

  mkdir -p /etc/cmdline.d
  local created=()
  for file in /usr/share/limine-entry-tool.d/*.conf /etc/limine-entry-tool.conf /etc/limine-entry-tool.d/*.conf; do
    [[ -f $file ]] || continue
    values=$(cmdline_values "$file" | paste -sd' ' - | tr -s ' ' | sed 's/^ //; s/ $//')
    [[ -n $values ]] || continue
    stem=$(basename "$file" .conf)
    # Omarchy's own defaults come with the package (default/boot/cmdline-defaults.conf);
    # the comparison below catches a locally edited copy.
    [[ $stem == omarchy-defaults ]] && continue
    printf '%s\n' "$values" >"/etc/cmdline.d/$stem.conf"
    created+=("/etc/cmdline.d/$stem.conf")
  done
  state_set created_cmdline "${created[*]}"

  local assembled effective
  assembled=$(omarchy-boot-sync cmdline)
  effective=$(limine-entry-tool --get-cmdline "$(preferred_limine_kernel)" | tr -s '[:space:]' ' ' | sed 's/^ //; s/ $//')
  if ! cmdline_equivalent "$assembled" "$effective"; then
    die "The converted command line doesn't match Limine's:\n  Limine:    $effective\n  converted: $assembled\nNothing that boots has changed; run omarchy-boot-switch revert to clean up."
  fi
}

stage_package() {
  # The package that replaces Limine's at the end conflicts with them, so it
  # can only be installed then; fetch it now, while the network is up.
  if [[ -n ${OMARCHY_BOOT_SYSTEMD_PACKAGE:-} ]]; then
    install -Dm644 "$OMARCHY_BOOT_SYSTEMD_PACKAGE" "$STORE/packages/$(basename "$OMARCHY_BOOT_SYSTEMD_PACKAGE")"
  else
    mkdir -p "$STORE/packages"
    pacman -Sw --noconfirm --cachedir "$STORE/packages" omarchy-boot-systemd >/dev/null
  fi
  omarchy-pkg-add systemd-ukify
}

install_loader() {
  install -Dm644 "$LOADER_SOURCE" "$ESP/EFI/systemd/systemd-boot$EFI_ARCH.efi"
  mkdir -p "$ESP/loader"
  if [[ ! -f $ESP/loader/loader.conf ]] || ! grep -q omarchy-boot-switch "$ESP/loader/loader.conf"; then
    cp "$BOOT_DEFAULTS/loader.conf" "$ESP/loader/loader.conf"
  fi

  install -Dm644 "$BOOT_DEFAULTS/pacman/95-omarchy-boot-trial.hook" /etc/pacman.d/hooks/95-omarchy-boot-trial.hook

  # kernel-install would publish UKIs of its own next to Omarchy's.
  mkdir -p /etc/kernel/install.d
  local plugin
  for plugin in 50-mkinitcpio.install 90-uki-copy.install; do
    [[ -e /etc/kernel/install.d/$plugin ]] || ln -s /dev/null "/etc/kernel/install.d/$plugin"
  done
}

register_trial() {
  local num esp_device disk part order
  num=$(boot_entry_for "$LOADER_PATH")
  if [[ -z $num ]]; then
    order=$(boot_order)
    esp_device=$(findmnt -n -o SOURCE --mountpoint "$ESP")
    disk=/dev/$(lsblk -no PKNAME "$esp_device")
    part=$(cat "/sys/class/block/$(basename "$esp_device")/partition")
    efibootmgr --quiet --create --disk "$disk" --part "$part" --label "$LOADER_LABEL" --loader "$LOADER_PATH" ||
      die "The firmware refused a new boot entry. Nothing that boots has changed; run omarchy-boot-switch revert to clean up."
    num=$(boot_entry_for "$LOADER_PATH")
    [[ -n $num ]] || die "The firmware didn't keep the new boot entry. Run omarchy-boot-switch revert to clean up."
  fi
  state_set loader_entry "$num"
  # efibootmgr puts a new entry first. Until the trial has booted, the boot
  # order stays the one the machine had, Limine first, also on a rerun after
  # an interrupted one.
  order=$(state_get boot_order)
  [[ -n $order ]] && efibootmgr --quiet --bootorder "$order"
  efibootmgr --quiet --bootnext "$num"
}

stage() {
  local current
  current=$(boot_current)
  create_store

  state_set backend limine
  [[ -n $(state_get boot_order) ]] || state_set boot_order "$(boot_order)"
  [[ -n $(state_get limine_entry) ]] || state_set limine_entry "$current"
  [[ -n $(state_get limine_fallback_sha) ]] ||
    state_set limine_fallback_sha "$(sha256sum <"$ESP/$FALLBACK" 2>/dev/null | cut -d' ' -f1)"
  state_set signing "$(state_get signing | grep -x required || echo off)"

  say "Fetching packages"
  stage_package
  say "Moving the kernel command line out of Limine's config"
  convert_cmdline
  state_set phase staged

  say "Building boot images"
  install_loader
  omarchy-boot-rebuild || die "Building the boot images failed. Nothing that boots has changed; fix the error above and run omarchy-boot-switch again, or revert."
  omarchy-boot-sync verify || die "The boot images don't match the installed kernels."

  systemctl enable omarchy-boot-confirm.service >/dev/null 2>&1
  systemctl --global enable omarchy-boot-notify.service >/dev/null 2>&1 || true
  register_trial
  state_set phase trial
  state_set trial_started "$(date +%s)"
}

# --- confirm (every boot) -----------------------------------------------------------

live_root() {
  [[ $(findmnt -n -o FSROOT --mountpoint /) == /@ ]]
}

confirm() {
  [[ -f $STORE/state ]] || return 0
  local loader_entry current
  loader_entry=$(state_get loader_entry)
  current=$(boot_current)

  case $(phase) in
  trial)
    if started_by_systemd_boot && [[ $current == "$loader_entry" ]] && live_root && omarchy-boot-sync verify >/dev/null; then
      efibootmgr --quiet --bootorder "$loader_entry,$(boot_order | tr ',' '\n' | grep -vx "$loader_entry" | paste -sd, -)"
      state_set phase promoted
      notice "Omarchy started with systemd-boot" "Reboot once more to finish the switch. Limine stays as the fallback until then."
    elif ! started_by_systemd_boot; then
      state_set phase trial-failed
      notice "The systemd-boot trial didn't come up" "This boot came from Limine, which keeps working. Run omarchy-boot-switch to try again, or omarchy-boot-switch revert."
    fi
    ;;
  promoted)
    if started_by_systemd_boot && [[ $current == "$loader_entry" ]] && live_root; then
      finalize
    elif ! started_by_systemd_boot; then
      efibootmgr --quiet --bootorder "$(state_get boot_order)"
      state_set phase trial-failed
      notice "The firmware kept starting Limine" "This machine's firmware ignored the new boot order, so Omarchy stays on Limine. Run omarchy-boot-switch revert to clean up."
    fi
    ;;
  active)
    local result
    result=$(omarchy-boot-sync restore-commit || true)
    case $result in
    restored:*) notice "Snapshot restored" "Omarchy is running the restored snapshot ${result#restored: }. The system as it was before is kept as \"Before restore\" in the boot menu." ;;
    failed:*) notice "The snapshot restore failed" "Nothing changed: ${result#failed: }" ;;
    esac
    ;;
  esac
}

finalize() {
  local step
  step=$(state_get final_step)

  if [[ -z $step ]]; then
    local package
    package=$(ls -t "$STORE"/packages/omarchy-boot-systemd-*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | sed -n 1p)
    [[ -n $package ]] || { notice "Finishing the switch failed" "The omarchy-boot-systemd package isn't in the boot store. Run omarchy-boot-switch again."; return 1; }
    # Installing it removes the Limine packages it conflicts with; their
    # pacman hook is replaced by the one this package owns.
    if ! pacman -U --noconfirm --ask=4 "$package"; then
      notice "Finishing the switch failed" "Installing omarchy-boot-systemd failed; Limine stays as the fallback. See journalctl -u omarchy-boot-confirm."
      return 1
    fi
    if omarchy-pkg-present limine && ! pacman -Qi limine | grep -q '^Required By *: [^N]'; then
      pacman -R --noconfirm limine >/dev/null || true
    fi
    rm -f /etc/pacman.d/hooks/95-omarchy-boot-trial.hook /etc/pacman.d/hooks/99-omarchy-limine.hook
    state_set backend systemd-boot
    state_set final_step packages
    step=packages
  fi

  if [[ $step == packages ]]; then
    # A rollback point on the new loader before Limine's goes away.
    local number
    number=$(snapper -c root create -c number -p -d "Boot loader switched to systemd-boot")
    omarchy-boot-sync pin "$number"
    omarchy-boot-sync sync
    grep -q "^snapshot-$number	" "$STORE/entries" || {
      notice "Finishing the switch failed" "The recovery snapshot $number has no boot entry; Limine stays as the fallback."
      return 1
    }
    state_set final_step snapshot
    step=snapshot
  fi

  if [[ $step == snapshot ]]; then
    rm -rf "$ESP/EFI/limine" "$ESP/limine.conf" "$ESP/limine.conf.old" "$ESP/limine.conf.bak" "$ESP/limine_history"
    # limine-snapper-sync's copies of boot files, per machine.
    rm -rf "$ESP/$(cat /etc/machine-id)/limine_history"
    rmdir "$ESP/$(cat /etc/machine-id)" 2>/dev/null || true
    rm -f "$ESP"/EFI/Linux/omarchy_*.efi "$ESP/EFI/Linux/$(cat /etc/machine-id)"_*.efi
    if [[ -f $ESP/$FALLBACK && $(sha256sum <"$ESP/$FALLBACK" | cut -d' ' -f1) == "$(state_get limine_fallback_sha)" ]]; then
      install -m644 "$LOADER_SOURCE" "$ESP/$FALLBACK"
    fi
    local limine_entry
    limine_entry=$(boot_entry_for '\EFI\limine\')
    [[ -n $limine_entry ]] && efibootmgr --quiet --delete-bootnum --bootnum "$limine_entry"
    state_set final_step esp
    step=esp
  fi

  state_set phase active
  state_set finished "$(date +%s)"
  notice "Omarchy now boots with systemd-boot" "Snapshots are in the boot menu (hold Space while starting) and under System > Snapshots."
}

# --- revert ---------------------------------------------------------------------------

revert() {
  [[ -f $STORE/state ]] || die "No switch to revert."
  [[ $(phase) != active ]] || die "The switch is finished and Limine is gone. It can't be reverted."

  local entry order
  entry=$(state_get loader_entry)
  order=$(state_get boot_order)
  efibootmgr --quiet --delete-bootnext 2>/dev/null || true
  [[ -n $entry ]] && efibootmgr --quiet --delete-bootnum --bootnum "$entry" 2>/dev/null || true
  [[ -n $order ]] && efibootmgr --quiet --bootorder "$order" || true

  rm -rf "$ESP/EFI/systemd"
  rm -f "$ESP/loader/loader.conf" "$ESP"/EFI/Linux/omarchy-"$(head -c 8 /etc/machine-id)"-*.efi
  rm -f /etc/pacman.d/hooks/95-omarchy-boot-trial.hook
  local plugin file
  for plugin in 50-mkinitcpio.install 90-uki-copy.install; do
    [[ $(readlink "/etc/kernel/install.d/$plugin" 2>/dev/null) == /dev/null ]] && rm -f "/etc/kernel/install.d/$plugin"
  done
  for file in $(state_get created_cmdline); do
    rm -f "$file"
  done
  [[ -f $STORE/backup/kernel-cmdline ]] && cp -a "$STORE/backup/kernel-cmdline" /etc/kernel/cmdline
  systemctl disable omarchy-boot-confirm.service >/dev/null 2>&1 || true

  umount "$STORE" 2>/dev/null || true
  sed -i '/^# Omarchy boot images (omarchy-boot-switch)$/d; /[[:space:]]\/var\/lib\/omarchy\/boot[[:space:]]/d' /etc/fstab
  systemctl daemon-reload
  mkdir -p "$TOP"
  mountpoint -q "$TOP" || mount -t btrfs -o subvolid=5 "$(root_device)" "$TOP"
  [[ -d $TOP/@omarchy-boot ]] && btrfs -q subvolume delete "$TOP/@omarchy-boot" >/dev/null
  umount "$TOP" 2>/dev/null || true
  say "Omarchy boots with Limine again."
}

status() {
  if [[ ! -f $STORE/state ]]; then
    echo "Boot loader: $(omarchy-boot-backend)"
    return
  fi
  echo "Boot loader: $(omarchy-boot-backend)"
  echo "Switch: $(phase)"
  [[ -n $(state_get final_step) && $(phase) != active ]] && echo "Finishing step: $(state_get final_step)"
  return 0
}

# --- main -------------------------------------------------------------------------

run_preflight() {
  preflight
  local line
  for line in "${notes[@]}"; do say "  • $line"; done
  if ((${#problems[@]})); then
    say "\e[33mThis machine can't move to systemd-boot yet:\e[0m"
    for line in "${problems[@]}"; do say "  • $line"; done
    return 1
  fi
}

case ${1:-} in
--check)
  if ((EUID != 0)); then exec sudo "$0" --check; fi
  run_preflight && say "This machine can move to systemd-boot."
  ;;
--apply)
  ((EUID == 0)) || die "--apply runs as root"
  case $(phase) in staged | trial | trial-failed | "") ;; *) die "Nothing to stage: the switch is $(phase)." ;; esac
  run_preflight || exit 1
  stage
  ;;
confirm)
  ((EUID == 0)) || die "confirm runs as root"
  confirm
  ;;
revert)
  if ((EUID != 0)); then exec sudo "$0" revert; fi
  revert
  ;;
status)
  status
  ;;
"" | --yes)
  if [[ ${1:-} != --yes ]]; then
    cat <<EOF
Omarchy moves to systemd-boot, the boot loader a Secure Boot machine needs.
Snapshots work as before: pick one from the boot menu (hold Space while the
machine starts) or from System > Snapshots, and restore it from there.

The switch is careful about it: systemd-boot starts once on trial while Limine
stays the fallback, and Limine is only removed after a second boot proves the
firmware starts systemd-boot on its own. Snapshots taken before the switch stay
on disk but can no longer be booted.

EOF
    as_root "$0" --check || exit 1
    gum confirm "Switch to systemd-boot?" || exit 0
  fi
  as_root "$0" --apply
  say "\nsystemd-boot is ready for its trial boot. Reboot to start it; if it doesn't come up, a reset brings back Limine."
  if [[ ${1:-} != --yes ]] && gum confirm "Reboot now?"; then
    omarchy-system reboot
  fi
  ;;
*)
  echo "Usage: omarchy-boot-switch [--check] [--yes] | status | revert" >&2
  exit 2
  ;;
esac

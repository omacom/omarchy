#!/bin/bash

# omarchy:summary=Configure the app dock
# omarchy:group=dock
# omarchy:subcommand=position [top|bottom|left|right] — Set the dock position, or print it when given none
# omarchy:subcommand=autohide [on|off|toggle] — Hide the dock on floating workspaces until the pointer reaches its edge, or print the setting
# omarchy:subcommand=tiling [on|off|toggle] — Show the dock, auto-hidden, on tiled workspaces too, or print the setting
# omarchy:subcommand=pinned [<desktop-id>...] — Set the pinned apps in dock order, or print them
# omarchy:subcommand=pin <desktop-id> — Keep an app in the dock
# omarchy:subcommand=unpin <desktop-id> — Remove an app from the dock
# omarchy:examples=omarchy dock position left | omarchy dock pin folio

set -euo pipefail

source omarchy-shell-config

usage() {
  cat <<USAGE
Usage: omarchy dock <command> [args...]

  position [top|bottom|left|right]     Dock position; prints the current one
                                       when given none
  autohide [on|off|toggle]             Hide the dock on floating workspaces
                                       until the pointer reaches its edge;
                                       prints on or off when given none
  tiling [on|off|toggle]               Show the dock, always auto-hidden, on
                                       tiled workspaces too; prints on or off
                                       when given none
  pinned [<desktop-id>...]             Pinned desktop ids in dock order; prints
                                       them one per line when given none
  pin <desktop-id>                     Keep an app in the dock
  unpin <desktop-id>                   Remove an app from the dock
USAGE
}

# A shell.json without pins of its own uses the default pins, so pinning or
# unpinning starts from those rather than from an empty dock.
PINNED='(.dock.pinned // $defaults[0].dock.pinned // [])'

cmd_position() {
  if (( $# == 0 )); then
    jq -r '.dock.position // "right"' "$(source_file)"
    return
  fi

  local position="$1"
  (( $# == 1 )) || fail "position takes a single value"
  [[ $position =~ ^(top|bottom|left|right)$ ]] || fail "position must be top, bottom, left, or right"
  commit "$NORMALIZE | .dock.position = \$position" --arg position "$position"
  echo "Dock position set to $position"
}

# An on/off dock setting: prints it when given no value, and takes on, off, or
# toggle. A shell.json without the key has the default.
flag() {
  jq -r --arg key "$1" --argjson default "$2" \
    '.dock[$key] as $value | if (if $value == null then $default else $value end) == true then "on" else "off" end' "$(source_file)"
}

cmd_flag() {
  local name="$1" key="$2" default="$3" label="$4"
  shift 4

  if (( $# == 0 )); then
    flag "$key" "$default"
    return
  fi

  local value="$1"
  (( $# == 1 )) || fail "$name takes a single value"
  if [[ $value == "toggle" ]]; then
    if [[ $(flag "$key" "$default") == "on" ]]; then
      value=off
    else
      value=on
    fi
  fi
  [[ $value =~ ^(on|off)$ ]] || fail "$name must be on, off, or toggle"
  commit "$NORMALIZE | .dock[\$key] = (\$value == \"on\")" --arg key "$key" --arg value "$value"
  echo "$label turned $value"
}

cmd_pinned() {
  if (( $# == 0 )); then
    jq -r --slurpfile defaults "$DEFAULTS_FILE" "$PINNED | .[]" "$(source_file)"
    return
  fi

  local ids=() id
  for id in "$@"; do
    ids+=("$(desktop_id "$id")")
  done
  commit "$NORMALIZE | .dock.pinned = (\$ids | reduce .[] as \$id ([]; if index([\$id]) then . else . + [\$id] end))" \
    --argjson ids "$(printf '%s\n' "${ids[@]}" | jq -R . | jq -s .)"
  echo "Set the apps pinned to the dock"
}

desktop_id() {
  (( $# == 1 )) || fail "takes a single desktop id"
  local id="${1%.desktop}"
  [[ -n $id ]] || fail "desktop id must not be empty"
  printf '%s\n' "$id"
}

cmd_pin() {
  local id
  id=$(desktop_id "$@")
  commit "$NORMALIZE | .dock.pinned = ($PINNED | if index([\$id]) then . else . + [\$id] end)" \
    --arg id "$id" --slurpfile defaults "$DEFAULTS_FILE"
  echo "Pinned $id to the dock"
}

cmd_unpin() {
  local id
  id=$(desktop_id "$@")
  commit "$NORMALIZE | .dock.pinned = ($PINNED | map(select(. != \$id)))" \
    --arg id "$id" --slurpfile defaults "$DEFAULTS_FILE"
  echo "Unpinned $id from the dock"
}

command="${1:-}"
(( $# > 0 )) && shift

case "$command" in
  position) cmd_position "$@" ;;
  autohide) cmd_flag autohide autohide false "Dock auto-hide" "$@" ;;
  tiling) cmd_flag tiling tiling true "Dock on tiled workspaces" "$@" ;;
  pinned) cmd_pinned "$@" ;;
  pin) cmd_pin "$@" ;;
  unpin) cmd_unpin "$@" ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac

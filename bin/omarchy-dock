#!/bin/bash

# omarchy:summary=Configure the app dock
# omarchy:group=dock
# omarchy:subcommand=position [top|bottom|left|right] — Set the dock position, or print it when given none
# omarchy:subcommand=visibility [always|first-app|hidden] — Keep the dock out always, until the workspace has a window, or only while the pointer is at its edge; prints the setting when given none
# omarchy:subcommand=tiling [on|off|toggle] — Show the dock on tiled workspaces too, or print the setting
# omarchy:subcommand=pinned [<desktop-id>...] — Set the pinned apps in dock order, or print them
# omarchy:subcommand=pin <desktop-id> — Keep an app in the dock
# omarchy:subcommand=unpin <desktop-id> — Remove an app from the dock
# omarchy:examples=omarchy dock position left | omarchy dock visibility always | omarchy dock pin folio

set -euo pipefail

source omarchy-shell-config

usage() {
  cat <<USAGE
Usage: omarchy dock <command> [args...]

  position [top|bottom|left|right]     Dock position; prints the current one
                                       when given none
  visibility [always|first-app|hidden] When the dock is out: always, until the
                                       workspace has a window, or only while
                                       the pointer is at its edge; prints the
                                       setting when given none
  tiling [on|off|toggle]               Show the dock on tiled workspaces too;
                                       prints on or off when given none
  pinned [<desktop-id>...]             Pinned desktop ids in dock order; prints
                                       them one per line when given none
  pin <desktop-id>                     Keep an app in the dock
  unpin <desktop-id>                   Remove an app from the dock
USAGE
}

# A shell.json without pins of its own uses the default pins, so pinning or
# unpinning starts from those rather than from an empty dock.
PINNED='(.dock.pinned // $defaults[0].dock.pinned // [])'

cmd_position() {
  if (( $# == 0 )); then
    jq -r '.dock.position // "bottom"' "$(source_file)"
    return
  fi

  local position="$1"
  (( $# == 1 )) || fail "position takes a single value"
  [[ $position =~ ^(top|bottom|left|right)$ ]] || fail "position must be top, bottom, left, or right"
  commit "$NORMALIZE | .dock.position = \$position" --arg position "$position"
  echo "Dock position set to $position"
}

# A shell.json from before this setting said autohide, which hid the dock
# always; without either, the dock hides once its workspace has a window.
cmd_visibility() {
  if (( $# == 0 )); then
    jq -r '.dock.visibility // (if .dock.autohide == true then "hidden" else "first-app" end)' "$(source_file)"
    return
  fi

  local visibility="$1"
  (( $# == 1 )) || fail "visibility takes a single value"
  [[ $visibility =~ ^(always|first-app|hidden)$ ]] || fail "visibility must be always, first-app, or hidden"
  commit "$NORMALIZE | .dock.visibility = \$visibility | del(.dock.autohide)" --arg visibility "$visibility"
  echo "Dock visibility set to $visibility"
}

# On unless turned off, so a shell.json without the key has the tiled dock.
current_tiling() {
  jq -r 'if .dock.tiling == false then "off" else "on" end' "$(source_file)"
}

cmd_tiling() {
  if (( $# == 0 )); then
    current_tiling
    return
  fi

  local value="$1"
  (( $# == 1 )) || fail "tiling takes a single value"
  if [[ $value == "toggle" ]]; then
    if [[ $(current_tiling) == "on" ]]; then
      value=off
    else
      value=on
    fi
  fi
  [[ $value =~ ^(on|off)$ ]] || fail "tiling must be on, off, or toggle"
  commit "$NORMALIZE | .dock.tiling = (\$value == \"on\")" --arg value "$value"
  echo "Dock on tiled workspaces turned $value"
}

cmd_pinned() {
  if (( $# == 0 )); then
    jq -r --slurpfile defaults "$DEFAULTS_FILE" "$PINNED | .[]" "$(source_file)"
    return
  fi

  local ids=() id
  for id in "$@"; do
    ids+=("$(desktop_id "$id")")
  done
  commit "$NORMALIZE | .dock.pinned = (\$ids | reduce .[] as \$id ([]; if index([\$id]) then . else . + [\$id] end))" \
    --argjson ids "$(printf '%s\n' "${ids[@]}" | jq -R . | jq -s .)"
  echo "Set the apps pinned to the dock"
}

desktop_id() {
  (( $# == 1 )) || fail "takes a single desktop id"
  local id="${1%.desktop}"
  [[ -n $id ]] || fail "desktop id must not be empty"
  printf '%s\n' "$id"
}

cmd_pin() {
  local id
  id=$(desktop_id "$@")
  commit "$NORMALIZE | .dock.pinned = ($PINNED | if index([\$id]) then . else . + [\$id] end)" \
    --arg id "$id" --slurpfile defaults "$DEFAULTS_FILE"
  echo "Pinned $id to the dock"
}

cmd_unpin() {
  local id
  id=$(desktop_id "$@")
  commit "$NORMALIZE | .dock.pinned = ($PINNED | map(select(. != \$id)))" \
    --arg id "$id" --slurpfile defaults "$DEFAULTS_FILE"
  echo "Unpinned $id from the dock"
}

command="${1:-}"
(( $# > 0 )) && shift

case "$command" in
  position) cmd_position "$@" ;;
  visibility) cmd_visibility "$@" ;;
  tiling) cmd_tiling "$@" ;;
  pinned) cmd_pinned "$@" ;;
  pin) cmd_pin "$@" ;;
  unpin) cmd_unpin "$@" ;;
  -h | --help | help) usage ;;
  *)
    usage >&2
    exit 1
    ;;
esac

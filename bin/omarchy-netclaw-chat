#!/bin/bash
# omarchy:summary=Talk to NetClaw in the terminal, setting it up on first launch
# omarchy:args=[--message <text>]
# omarchy:examples=omarchy netclaw chat --message "Investigate interface errors in my testbed"

set -euo pipefail
# shellcheck source=default/netclaw/runtime.sh
source "$OMARCHY_PATH/default/netclaw/runtime.sh"
if [[ ! -f $netclaw_state/configured ]]; then
  omarchy-netclaw-setup
fi
exec omarchy-launch-openclaw --tui --session netclaw "$@"

#!/bin/bash

# omarchy:summary=Set up what the welcome tour picked: workspace layout, dictation, Tailscale, a local model and an agent
# omarchy:args=[--install] [--layout <dwindle|scrolling|floating>] [--dictation <backend>] [--tailscale] [--local-ai <recipe>] [--agent]
# omarchy:hidden=true

usage() {
  cat <<USAGE
Usage: omarchy-setup-essentials [--install] [--layout <dwindle|scrolling|floating>]
                                [--dictation <backend>] [--tailscale]
                                [--local-ai <recipe>] [--agent]

Sets up each thing named, one after another. The layout changes at once. The
rest install, so they are handed to a floating terminal, where they wait for
a connection first. --agent opens the agents panel, where an agent is added,
once everything else is done.

  --install  Run the installs here instead: this is that terminal.
USAGE
}

needs_value() {
  if [[ -z ${2:-} || $2 == -* ]]; then
    echo "$1 needs a value" >&2
    usage >&2
    exit 1
  fi
}

layout="" dictation="" local_ai=""
tailscale=0 agent=0 here=0

while (($#)); do
  case "$1" in
    --install)
      here=1
      ;;
    --layout)
      needs_value "$@"
      layout=$2
      shift
      ;;
    --dictation)
      needs_value "$@"
      dictation=$2
      shift
      ;;
    --local-ai)
      needs_value "$@"
      local_ai=$2
      shift
      ;;
    --agent)
      agent=1
      ;;
    --tailscale)
      tailscale=1
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

if [[ -n $layout && ! $layout =~ ^(dwindle|scrolling|floating)$ ]]; then
  echo "Unknown workspace layout: $layout" >&2
  exit 1
fi

# This names a command, and goes on to a terminal's command line.
if [[ -n $dictation && ! $dictation =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "Invalid name: $dictation" >&2
  exit 1
fi

# A recipe as omarchy-local-ai names them, which goes the same way.
if [[ -n $local_ai && ! $local_ai =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "Invalid recipe: $local_ai" >&2
  exit 1
fi

installs=()
[[ -z $dictation ]] || installs+=(--dictation "$dictation")
(( ! tailscale )) || installs+=(--tailscale)
[[ -z $local_ai ]] || installs+=(--local-ai "$local_ai")

if [[ -z $layout ]] && (( ${#installs[@]} == 0 && ! agent )); then
  usage >&2
  exit 1
fi

failed=()
declined=()

heading() {
  printf '\n\033[1m%s\033[0m\n' "$1"
}

# What did not get set up: what failed, and what was turned down part way.
report() {
  local summary

  if (( ${#failed[@]} > 0 )); then
    printf -v summary '%s, ' "${failed[@]}"
    printf '\nCould not set up: %s\n' "${summary%, }" >&2
  fi
  if (( ${#declined[@]} > 0 )); then
    printf -v summary '%s, ' "${declined[@]}"
    printf '\nLeft as it was: %s\n' "${summary%, }" >&2
  fi
}

install_all() {
  # As first run does for its own prompts: a connection still coming up is
  # waited for, and a machine with none is told what it is waiting on.
  if ! nm-online -q -x -t 30; then
    heading "Waiting for an internet connection"
    echo "Connect from the network panel in the bar, and this carries on by itself."
    # nm-online has no "forever", and where NetworkManager is not running it
    # gives up at once.
    until nm-online -q -t 86400; do
      sleep 1
    done
  fi

  if [[ -n $dictation ]]; then
    heading "Setting up dictation with $dictation"
    if omarchy-cmd-present "omarchy-install-dictation-$dictation"; then
      if "omarchy-install-dictation-$dictation"; then
        # An installer whose confirmation is turned down ends without an
        # error, so what counts is the backend now in use.
        [[ $(omarchy-default-dictation 2>/dev/null) == "$dictation" ]] || declined+=("dictation")
      else
        failed+=("dictation")
      fi
    else
      echo "No installer available for dictation backend: $dictation" >&2
      failed+=("dictation")
    fi
  fi

  if (( tailscale )); then
    heading "Setting up Tailscale"
    omarchy-install-service-tailscale || failed+=("Tailscale")
  fi

  if [[ -n $local_ai ]]; then
    heading "Setting up a local model"
    # Handed to the background, as the agents panel hands it over, and what
    # it needs installed first is asked for by polkit, as from that panel.
    # Whatever goes wrong before the engine lists the model is said here. From
    # then on the panel has it to add, with its download on show.
    omarchy-models use --detach "$local_ai" || failed+=("the local model")
  fi
}

if [[ -n $layout ]]; then
  omarchy-hyprland-workspace-layout-default "$layout" || failed+=("the workspace layout")
fi

# The installs ask for a password and show their progress, which takes a
# terminal. The layout is set by then, so only they are passed on to one, and
# the agents panel with them, to open once they are through. A layout that
# could not be set goes too, to be tried where the reason shows.
if (( ${#installs[@]} > 0 && ! here )); then
  if (( ${#failed[@]} > 0 )); then
    installs=(--layout "$layout" "${installs[@]}")
  fi
  if (( agent )); then
    installs+=(--agent)
  fi
  exec omarchy-launch-floating-terminal-with-presentation "omarchy-setup-essentials --install ${installs[*]@Q}"
else
  (( ${#installs[@]} == 0 )) || install_all

  # An agent is added in the agents panel, which first run's own invitation
  # and the agent hotkey open the same way. It comes last, so a terminal
  # opening after it does not take the screen from it. Once open it has
  # answered that invitation: none is sent later, and one already on screen is
  # taken down where it can be found, which is by its title in the language
  # in use now. A panel that would not open leaves the invitation as it was.
  # On first run the tour's reply has answered it by then, before that toast
  # could be sent, which this would be too late for.
  if (( agent )); then
    if omarchy-shell omarchy.agents open; then
      omarchy-done mark agent-setup-invitation
      omarchy-notification-dismiss "$(omarchy-i18n firstRun.agentTitle)" >/dev/null 2>&1 || true
    else
      failed+=("the agents panel")
    fi
  fi

  report
  if (( ${#failed[@]} > 0 )); then
    exit 1
  fi
fi

#!/bin/bash

# omarchy:summary=Remove Grok Bot along with its settings and data.
# omarchy:requires-sudo=true

set -e

while (( $# > 0 )); do
  case "$1" in
  -h | --help | help)
    echo "Usage: omarchy-remove-ai-grok-bot"
    echo
    echo "Remove Grok Bot along with its settings and data."
    exit 0
    ;;
  *)
    echo "omarchy-remove-ai-grok-bot: unknown option '$1'. Try --help." >&2
    exit 2
    ;;
  esac
  shift
done

omarchy-pkg-drop grok-bot

# Not ~/.grok: that is the Grok CLI, which is installed and used on its own.
rm -rf \
  "$HOME/.config/Grok Bot" \
  "$HOME/.grokbot"

echo ""
echo "Grok Bot has been removed."

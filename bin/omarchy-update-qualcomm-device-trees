#!/bin/bash

# omarchy:summary=List the kernel's Snapdragon device trees for the UKI
# omarchy:args=[--install]
# omarchy:hidden=true
# omarchy:requires-sudo=true

# systemd-stub picks a device tree from the UKI by SMBIOS identity, out of the
# trees DeviceTreeAuto names. DeviceTreeAuto takes literal paths, so the list
# has to follow the trees the kernel package installs. --install writes the
# list during setup. Without it the command refreshes a list it wrote earlier
# and leaves any other configuration alone, such as the Surface Pro 11's single
# pinned tree. limine runs it that way before every boot image build, from
# /etc/boot/hooks/pre.d, so a kernel update that adds or moves a tree builds
# an image that carries it.

install=0
if [[ ${1:-} == "--install" ]]; then
  install=1
fi

managed_begin="# BEGIN OMARCHY QUALCOMM DEVICE TREES"
managed_end="# END OMARCHY QUALCOMM DEVICE TREES"
uki_config=${OMARCHY_QUALCOMM_UKI_CONFIG:-/etc/kernel/uki.conf}

# Arch Linux ARM's kernel keeps every board's device trees in /boot/dtbs.
# Omarchy's own kernel keeps its Snapdragon ones under its package name, and
# those come first, so the trees match the kernel that boots. linux-omarchy
# itself is named ahead of the pattern, which sorts another kernel's
# linux-omarchy-<name>/qcom before linux-omarchy/qcom.
dtb_root=${OMARCHY_QUALCOMM_DTB_ROOT:-/boot/dtbs}
dtb_dir=$dtb_root/qcom
for kernel_dtb_dir in "$dtb_root"/linux-omarchy/qcom "$dtb_root"/linux-omarchy*/qcom; do
  if [[ -d $kernel_dtb_dir ]]; then
    dtb_dir=$kernel_dtb_dir
    break
  fi
done
dtb_dir=${OMARCHY_QUALCOMM_DTB_DIR:-$dtb_dir}

dtbs=()
for dtb in "$dtb_dir"/x1*.dtb "$dtb_dir"/hamoa*.dtb \
  "$dtb_dir"/glymur*.dtb "$dtb_dir"/mahua*.dtb "$dtb_dir"/sc8280xp*.dtb; do
  if [[ -f $dtb && $dtb != *-el2.dtb ]]; then
    dtbs+=("$dtb")
  fi
done

# An installed machine also gets the tree it runs on as DeviceTree, which
# systemd-stub uses when no tree in the list matches the SMBIOS data. So a
# machine whose hardware IDs systemd-stub doesn't know yet still boots, and
# one whose IDs it knows follows them, also to another tree once an update
# names one. The running device tree's root compatible is that tree's byte
# for byte, so the one file that holds the same list is it. Without a running
# device tree, or without exactly one match, the UKI gets the list alone.
# A tree file holds a property as its token, length and name offset, then
# the value, so matching the length too takes only the whole property, never
# a longer list that ends the same way. od writes each byte as " xx", which
# keeps a match on byte boundaries and the newline bytes out of grep's way.
own_dtb=""
running_compatible=${OMARCHY_PROC_ROOT:-/proc}/device-tree/compatible
if (( ${#dtbs[@]} > 0 )) && [[ -s $running_compatible ]]; then
  length=$(wc -c <"$running_compatible")
  pattern=$(printf ' 00 00 00 03 %02x %02x %02x %02x' $((length >> 24 & 255)) \
    $((length >> 16 & 255)) $((length >> 8 & 255)) $((length & 255)))
  pattern+="( [0-9a-f]{2}){4}$(od -An -v -tx1 "$running_compatible" | tr -d '\n')"
  matches=()
  for dtb in "${dtbs[@]}"; do
    if grep -qE "$pattern" <(od -An -v -tx1 "$dtb" | tr -d '\n'); then
      matches+=("$dtb")
    fi
  done
  if (( ${#matches[@]} == 1 )); then
    own_dtb=${matches[0]}
  fi
fi

if (( ! install )) && ! grep -Fqx "$managed_begin" "$uki_config" 2>/dev/null; then
  # Nothing of ours to refresh.
  exit 0
elif (( ${#dtbs[@]} == 0 )); then
  # A kernel without trees keeps the last list rather than an empty one.
  echo "No Windows-on-ARM device trees under $dtb_dir; the UKI gets no .dtbauto sections" >&2
  exit 0
fi

# A boot image build must not stop on this, so any failure leaves the
# configuration as it was and still exits 0. Every write to the copy is
# checked: a full disk must not put a cut-off copy in place of the signing
# settings and paths the configuration holds.
mkdir -p "$(dirname "$uki_config")" || exit 0
uki_tmp=$(mktemp "${uki_config}.XXXXXX") || exit 0

written=1
if [[ -f $uki_config ]]; then
  cp -p "$uki_config" "$uki_tmp" &&
    awk -v begin="$managed_begin" -v end="$managed_end" '
      $0 == begin { managed = 1; next }
      managed && $0 == end { managed = 0; next }
      !managed { print }
    ' "$uki_config" >"$uki_tmp" || written=0
else
  chmod 0644 "$uki_tmp" || written=0
fi

if (( written )) && [[ -n $own_dtb ]]; then
  printf '%s\n' \
    "$managed_begin" \
    "# Generated by Omarchy for Qualcomm Snapdragon devices." \
    "# systemd-stub selects a device tree from SMBIOS data, and takes this machine's" \
    "# own, matched by its running compatible, when none fits. limine refreshes" \
    "# both before every boot image build (omarchy-update-qualcomm-device-trees)." \
    "[UKI]" \
    "DeviceTree=$own_dtb" \
    "DeviceTreeAuto=${dtbs[*]}" \
    "$managed_end" >>"$uki_tmp" || written=0
elif (( written )); then
  printf '%s\n' \
    "$managed_begin" \
    "# Generated by Omarchy for Qualcomm Snapdragon devices." \
    "# systemd-stub selects a device tree from SMBIOS data. limine refreshes" \
    "# this list before every boot image build (omarchy-update-qualcomm-device-trees)." \
    "[UKI]" \
    "DeviceTreeAuto=${dtbs[*]}" \
    "$managed_end" >>"$uki_tmp" || written=0
fi

if (( ! written )); then
  rm -f "$uki_tmp"
  echo "Could not refresh the device tree list in $uki_config; it stays as it was" >&2
elif [[ -f $uki_config ]] && cmp -s "$uki_tmp" "$uki_config"; then
  rm -f "$uki_tmp"
elif mv -f "$uki_tmp" "$uki_config"; then
  # The UKI carries the trees once it is rebuilt. An image's first boot
  # rebuilds after its last step, but does not watch this file.
  if [[ -n ${OMARCHY_IMAGE_BOOT_REBUILD:-} ]]; then
    : >"$OMARCHY_IMAGE_BOOT_REBUILD"
  fi
  if [[ -n $own_dtb ]]; then
    echo "Listed ${#dtbs[@]} device trees in $uki_config, with this machine's own, $own_dtb, to fall back on"
  else
    echo "Listed ${#dtbs[@]} device trees in $uki_config"
  fi
else
  rm -f "$uki_tmp"
fi

exit 0

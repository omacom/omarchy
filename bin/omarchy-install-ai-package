#!/bin/bash

# omarchy:summary=Install the package behind a coding agent's CLI, as root
# omarchy:args=<agent>
# omarchy:hidden=true

# omarchy-install-ai-cli runs this through pkexec when there's no terminal for
# sudo, such as signing in from the agents panel. Each agent has a polkit action
# of its own (default/polkit/org.omarchy.install-ai-cli.policy), matched on this
# path and the agent's name, so the prompt says what it's for: "Authorize to
# install Claude Code". The caller names an agent, never a package: the packaged
# installer's own map turns it into one, so nothing else can be installed here.

set -euo pipefail

if (( EUID != 0 )); then
  echo "omarchy-install-ai-package runs as root, through pkexec" >&2
  exit 1
fi

package=$(/usr/bin/omarchy-install-ai-cli --package "${1:-}") || exit 1
/usr/bin/pacman -S --noconfirm --needed -- "$package"

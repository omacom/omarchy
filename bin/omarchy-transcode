#!/bin/bash

# omarchy:group=transcode
# omarchy:name=
# omarchy:summary=Transcode pictures and videos for sharing
# omarchy:args=[--path path] [input] [format] [resolution]
# omarchy:examples=omarchy transcode|omarchy transcode --path ~/Downloads|omarchy transcode ~/Videos/demo.mov mp4 1080p|omarchy transcode ~/Pictures/background.heic jpg medium

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  omarchy transcode [--path path] [input] [format] [resolution]

With no input, pick a picture or video from ~/Pictures and ~/Videos,
or only from --path when provided. Then pick the output format and resolution.

Options:
  --path path  Limit interactive fuzzy file selection to this path

Formats:
  Pictures: jpg, png
  Videos: mp4, gif

Resolutions:
  Pictures: high, medium, low
  Videos: 4k, 1080p, 720p
EOF
}

media_type() {
  local mime
  mime=$(file -b --mime-type "$1")

  case "$mime" in
  image/*) echo picture ;;
  video/*) echo video ;;
  *)
    echo "Unsupported file type: $mime" >&2
    return 1
    ;;
  esac
}

output_path() {
  local input="$1"
  local format="$2"
  local resolution="$3"
  local dir base stem

  dir=$(dirname -- "$input")
  base=$(basename -- "$input")
  stem="${base%.*}"

  printf '%s/%s-%s.%s' "$dir" "$stem" "$resolution" "$format"
}

transcode_picture() {
  local input="$1" format="$2" resolution="$3" output="$4"
  local resize

  case "$resolution" in
  high) resize='3160x>' ;;
  medium) resize='2160x>' ;;
  low) resize='1080x>' ;;
  *)
    echo "Invalid picture resolution: $resolution" >&2
    return 1
    ;;
  esac

  case "$format" in
  jpg)
    magick "$input" -resize "$resize" -quality 85 -strip "$output"
    ;;
  png)
    magick "$input" -resize "$resize" -strip -define png:compression-filter=5 \
      -define png:compression-level=9 \
      -define png:compression-strategy=1 \
      -define png:exclude-chunk=all \
      "$output"
    ;;
  *)
    echo "Invalid picture format: $format" >&2
    return 1
    ;;
  esac
}

# iPhone recordings mark spatial audio (apple_apac) as the default track and
# keep a stereo AAC track beside it. FFmpeg has no decoder for apple_apac, so
# taking the default track aborts the whole transcode. Prefer the default
# track when it can be decoded, otherwise the first track that can.
# Prints the stream index. Returns 2 when every audio track is undecodable,
# 3 when the file has no audio, and 1 when probing fails.
decodable_audio_index() {
  local input="$1"
  local -A decoders=()
  local probe name index codec is_default chosen="" fallback=""
  local saw_audio=0

  probe=$(ffprobe -v error -select_streams a \
    -show_entries stream=index,codec_name:stream_disposition=default \
    -of csv=p=0 -- "$input") || return 1

  while read -r name; do
    [[ -n $name ]] || continue
    decoders[$name]=1
  # The flag field is six characters: V, A, S, and F, X, B, D. AAC's line ends
  # in D, so a class of only V, A, S and "." would treat it as undecodable.
  done < <(ffmpeg -hide_banner -decoders | awk '$1 ~ /^[VASFXBD.]{6}$/ { print $2 }')

  while IFS=',' read -r index codec is_default; do
    [[ -n $index ]] || continue
    saw_audio=1
    if [[ -z ${decoders[$codec]:-} ]]; then
      continue
    fi
    if [[ -z $chosen && $is_default == "1" ]]; then
      chosen=$index
    fi
    if [[ -z $fallback ]]; then
      fallback=$index
    fi
  done <<<"$probe"

  if [[ -n $chosen ]]; then
    printf '%s\n' "$chosen"
  elif [[ -n $fallback ]]; then
    printf '%s\n' "$fallback"
  elif (( saw_audio == 1 )); then
    return 2
  else
    return 3
  fi
}

transcode_video() {
  local input="$1" format="$2" resolution="$3" output="$4"
  local scale audio_index="" audio_status=0
  local -a args

  case "$resolution" in
  4k) scale='scale=-2:2160' ;;
  1080p) scale='scale=-2:1080' ;;
  720p) scale='scale=-2:720' ;;
  *)
    echo "Invalid video resolution: $resolution" >&2
    return 1
    ;;
  esac

  case "$format" in
  mp4)
    audio_index=$(decodable_audio_index "$input") || audio_status=$?
    if (( audio_status == 1 )); then
      return 1
    fi
    if (( audio_status == 2 )); then
      echo "No decodable audio track: $input" >&2
      return 1
    fi

    args=(ffmpeg -i "$input" -map 0:v:0)
    if [[ -n $audio_index ]]; then
      args+=(-map "0:$audio_index")
    fi
    args+=(-vf "$scale")
    if [[ $resolution == "4k" ]]; then
      args+=(-c:v libx265 -preset slow -crf 24)
    else
      args+=(-c:v libx264 -preset fast -crf 23)
    fi
    if [[ -n $audio_index ]]; then
      args+=(-c:a aac -b:a 192k)
    fi
    args+=(-movflags +faststart "$output")
    "${args[@]}"
    ;;
  gif)
    ffmpeg -i "$input" -vf "fps=10,$scale:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" "$output"
    ;;
  *)
    echo "Invalid video format: $format" >&2
    return 1
    ;;
  esac
}

copy_to_clipboard() {
  local output="$1"
  local uri

  uri="file://$(realpath -- "$output")"
  printf '%s\n' "$uri" | wl-copy --type text/uri-list
}

main() {
  local input="" format="" resolution="" search_path=""
  local type output positional=()

  while (( $# > 0 )); do
    case "$1" in
    --path)
      shift
      (( $# > 0 )) || { echo "Missing value for --path" >&2; return 2; }
      search_path="$1"
      ;;
    --help | -h)
      usage
      return 0
      ;;
    --)
      shift
      positional+=("$@")
      break
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage >&2
      return 2
      ;;
    *)
      positional+=("$1")
      ;;
    esac
    shift
  done

  input="${positional[0]:-}"
  format="${positional[1]:-}"
  resolution="${positional[2]:-}"
  search_path="${search_path:-$HOME/Pictures:$HOME/Videos}"

  if [[ -z $input ]]; then
    input=$(omarchy-menu-file "$(omarchy-i18n transcode.pickInput)" "$search_path" "jpg jpeg png webp gif heic avif mp4 mov m4v mkv webm avi")
  fi

  [[ -n $input ]] || return 1
  [[ -f $input ]] || { echo "File not found: $input" >&2; return 1; }

  type=$(media_type "$input")

  if [[ -z $format ]]; then
    if [[ $type == "picture" ]]; then
      format=$(omarchy-menu-select "$(omarchy-i18n transcode.selectFormat)" jpg png)
    else
      format=$(omarchy-menu-select "$(omarchy-i18n transcode.selectFormat)" mp4 gif)
    fi
  fi

  # Picture qualities are words, so the menu shows them in the Omarchy language
  # and maps the pick back to the value the transcoder takes.
  local high medium low choice
  high=$(omarchy-i18n transcode.qualityHigh)
  medium=$(omarchy-i18n transcode.qualityMedium)
  low=$(omarchy-i18n transcode.qualityLow)

  if [[ -z $resolution ]]; then
    if [[ $type == "picture" ]]; then
      choice=$(omarchy-menu-select "$(omarchy-i18n transcode.selectResolution)" "$high" "$medium" "$low")
      case $choice in
        "$high") resolution=high ;;
        "$medium") resolution=medium ;;
        "$low") resolution=low ;;
      esac
    else
      resolution=$(omarchy-menu-select "$(omarchy-i18n transcode.selectResolution)" 4k 1080p 720p)
    fi
  fi

  output=$(output_path "$input" "$format" "$resolution")

  local resolution_label=$resolution
  case $resolution in
    high) resolution_label=$high ;;
    medium) resolution_label=$medium ;;
    low) resolution_label=$low ;;
  esac

  if [[ $type == "video" ]]; then
    omarchy-notification-send -g  "$(omarchy-i18n transcode.working)" "$(omarchy-i18n transcode.workingBody "$(basename -- "$input")" "$format" "$resolution")"
    transcode_video "$input" "$format" "$resolution" "$output"
    copy_to_clipboard "$output"
    omarchy-notification-send -g  "$(omarchy-i18n transcode.done "$resolution" "$format")" "$(omarchy-i18n transcode.saved)"
  else
    transcode_picture "$input" "$format" "$resolution" "$output"
    copy_to_clipboard "$output"
    omarchy-notification-send -g  "$(omarchy-i18n transcode.done "$resolution_label" "$format")" "$(omarchy-i18n transcode.saved)"
  fi
}

main "$@"

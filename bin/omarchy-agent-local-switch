#!/bin/bash

# omarchy:summary=Start a local model from the agents panel, setting it up first if needed
# omarchy:args=<recipe>
# omarchy:hidden=true

# The agents panel starts a model without a terminal. A failed start records
# its reason, which the panel shows on the model's line, so nothing more is
# reported here.
recipe=${1:?Usage: omarchy-agent-local-switch <recipe>}

exec omarchy-agent-local-start --setup "$recipe"

#!/bin/bash

# omarchy:summary=Set the default password manager for Omarchy
# omarchy:args=[1password|bitwarden]
# omarchy:examples=omarchy default password-manager | omarchy default password-manager bitwarden

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

default_file="$HOME/.config/omarchy/defaults/password-manager"

if (($# == 0)); then
  if [[ -f $default_file ]]; then
    read -r manager <"$default_file"
  fi

  if [[ ${manager:-} != "1password" && ${manager:-} != "bitwarden" ]]; then
    # Nothing chosen yet, or the choice isn't a manager Omarchy knows: answer
    # the way the hotkey always has — 1Password when it is installed, Bitwarden
    # when it is the only one, and 1Password, whose launcher starts its
    # installer, when neither is.
    if omarchy-cmd-present 1password; then
      manager="1password"
    elif omarchy-cmd-present bitwarden-desktop; then
      manager="bitwarden"
    else
      manager="1password"
    fi
  fi

  echo "$manager"
  exit 0
fi

case "$1" in
1password) manager="1password"; command="1password"; name="1Password"; glyph=󰢁 ;;
bitwarden) manager="bitwarden"; command="bitwarden-desktop"; name="Bitwarden"; glyph=󰟵 ;;
*)
  echo "Usage: omarchy-default-password-manager <1password|bitwarden>"
  exit 1
  ;;
esac

if omarchy-cmd-missing "$command"; then
  if [[ $installing == "false" ]]; then
    exec omarchy-launch-floating-terminal-with-presentation omarchy-default-password-manager --install "$manager"
  else
    case "$manager" in
    1password) omarchy-install-service-1password ;;
    bitwarden) omarchy-install-service-bitwarden ;;
    esac || exit 1
  fi
fi

mkdir -p "$(dirname "$default_file")" || exit 1
printf '%s\n' "$manager" >"$default_file" || exit 1

omarchy-notification-send -g $glyph "$name is now the default password manager"

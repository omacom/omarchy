#!/bin/bash

# omarchy:summary=Index screenshots and find one by color, words, or day
# omarchy:args=<index|search|index-latest|tag|ignore|save|saved> [options]
# omarchy:examples=omarchy ml shot search red error from Tuesday | omarchy ml shot tag shot.png login bug | omarchy ml shot save login-bug red error from Tuesday

set -euo pipefail

if [[ ${1:-} == "search" && $# -eq 1 ]]; then
  query=""
  if [[ -t 0 ]] && omarchy-cmd-present gum; then
    query=$(gum input --placeholder "red error from Tuesday")
  elif [[ ! -t 0 ]]; then
    IFS= read -r query || true
  fi
  if [[ -z $query ]]; then
    echo "Say what the screenshot looked like." >&2
    exit 1
  fi
  set -- search "$query"
fi

exec python3 - "$@" <<'PY'
import datetime
import fcntl
import json
import os
import re
import struct
import shutil
import subprocess
import sys
import tempfile
import zlib

WEEKDAYS = ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
STOP = {"the", "a", "an", "to", "on", "of", "my", "that", "this", "from", "and"}
NAMED = {
  "red": (220, 40, 40),
  "orange": (230, 120, 30),
  "yellow": (230, 210, 40),
  "green": (40, 160, 60),
  "blue": (40, 80, 220),
  "purple": (140, 40, 180),
  "white": (245, 245, 245),
  "black": (15, 15, 15),
  "gray": (140, 140, 140),
}

def state_dir():
  root = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
  path = os.path.join(root, "omarchy", "ml")
  os.makedirs(path, exist_ok=True)
  return path

def index_path():
  return os.environ.get("OMARCHY_ML_SHOT_INDEX") or os.path.join(state_dir(), "shots.jsonl")

def shot_config_path():
  root = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
  directory = os.path.join(root, "omarchy", "ml")
  os.makedirs(directory, exist_ok=True)
  return os.path.join(directory, "shots.json")

def load_shot_config():
  path = shot_config_path()
  if not os.path.isfile(path):
    return {"ignore": [], "tags": {}, "saved": {}}
  with open(path, encoding="utf-8") as handle:
    data = json.load(handle)
  if not isinstance(data, dict):
    return {"ignore": [], "tags": {}, "saved": {}}
  data.setdefault("ignore", [])
  data.setdefault("tags", {})
  data.setdefault("saved", {})
  return data

def update_shot_config(mutator):
  path = shot_config_path()
  lock_path = path + ".lock"
  with open(lock_path, "a+", encoding="utf-8") as lock:
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    data = load_shot_config()
    mutator(data)
    directory = os.path.dirname(path)
    handle = tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=directory, prefix=".shots-", delete=False)
    try:
      json.dump(data, handle, indent=2)
      handle.write("\n")
      handle.flush()
      os.fsync(handle.fileno())
      tmp = handle.name
    finally:
      handle.close()
    os.replace(tmp, path)

def ignored(path, config):
  real = os.path.abspath(os.path.expanduser(path))
  for raw in config.get("ignore") or []:
    folder = os.path.abspath(os.path.expanduser(str(raw)))
    if real == folder or real.startswith(folder + os.sep):
      return True
  return False

def nearest(rgb):
  best = None
  best_distance = None
  for name, color in NAMED.items():
    distance = sum((rgb[i] - color[i]) ** 2 for i in range(3))
    if best_distance is None or distance < best_distance:
      best = name
      best_distance = distance
  return best

def paeth(left, up, up_left):
  estimate = left + up - up_left
  distances = (abs(estimate - left), abs(estimate - up), abs(estimate - up_left))
  return (left, up, up_left)[distances.index(min(distances))]

def png_colors(path):
  try:
    with open(path, "rb") as handle:
      if handle.read(8) != b"\x89PNG\r\n\x1a\n":
        return []
      width = height = color_type = None
      data = b""
      while True:
        header = handle.read(8)
        if len(header) < 8:
          break
        length, kind = struct.unpack(">I4s", header)
        chunk = handle.read(length)
        handle.read(4)
        if kind == b"IHDR":
          width, height, depth, color_type = struct.unpack(">IIBB", chunk[:10])
          if depth != 8 or color_type not in (2, 6) or chunk[12] != 0:
            return []
        elif kind == b"IDAT":
          data += chunk
        elif kind == b"IEND":
          break
    channels = 4 if color_type == 6 else 3
    raw = zlib.decompress(data)
    stride = width * channels
    rows = []
    index = 0
    previous = bytearray(stride)
    for _ in range(height):
      filter_type = raw[index]
      index += 1
      row = bytearray(raw[index:index + stride])
      index += stride
      if filter_type == 1:
        for i in range(stride):
          left = row[i - channels] if i >= channels else 0
          row[i] = (row[i] + left) & 255
      elif filter_type == 2:
        for i in range(stride):
          row[i] = (row[i] + previous[i]) & 255
      elif filter_type == 3:
        for i in range(stride):
          left = row[i - channels] if i >= channels else 0
          row[i] = (row[i] + ((left + previous[i]) // 2)) & 255
      elif filter_type == 4:
        for i in range(stride):
          left = row[i - channels] if i >= channels else 0
          up_left = previous[i - channels] if i >= channels else 0
          row[i] = (row[i] + paeth(left, previous[i], up_left)) & 255
      previous = row
      rows.append(row)
    step_x = max(1, width // 32)
    step_y = max(1, height // 32)
    counts = {}
    reds = 0
    samples = 0
    total = [0, 0, 0]
    for y in range(0, height, step_y):
      row = rows[y]
      for x in range(0, width, step_x):
        offset = x * channels
        rgb = (row[offset], row[offset + 1], row[offset + 2])
        name = nearest(rgb)
        counts[name] = counts.get(name, 0) + 1
        samples += 1
        total[0] += rgb[0]
        total[1] += rgb[1]
        total[2] += rgb[2]
        if rgb[0] > 140 and rgb[0] > rgb[1] + 40 and rgb[0] > rgb[2] + 40:
          reds += 1
    if samples == 0:
      return []
    colors = [name for name, count in counts.items() if count / samples >= 0.08]
    average = nearest(tuple(channel // samples for channel in total))
    if average not in colors:
      colors.append(average)
    if reds / samples >= 0.02 and "red" not in colors:
      colors.append("red")
    return colors[:4]
  except Exception:
    return []

def ocr(path):
  try:
    result = subprocess.run(["tesseract", path, "stdout"], capture_output=True, text=True, timeout=30)
  except (OSError, subprocess.TimeoutExpired):
    return ""
  return result.stdout.strip()

def record(path, text, colors, mtime):
  if mtime is None:
    mtime = os.path.getmtime(path)
  mtime = float(mtime)
  if colors is None:
    colors = png_colors(path)
  if text is None:
    text = ocr(path)
  row = {
    "path": os.path.abspath(path),
    "mtime": mtime,
    "weekday": datetime.datetime.fromtimestamp(mtime).strftime("%A"),
    "colors": colors,
    "text": text or "",
  }
  with open(index_path(), "a", encoding="utf-8") as handle:
    handle.write(json.dumps(row) + "\n")
  print(row["path"])

def load_rows():
  path = index_path()
  if not os.path.isfile(path):
    return []
  newest = {}
  order = []
  with open(path, encoding="utf-8") as handle:
    for line in handle:
      line = line.strip()
      if not line:
        continue
      row = json.loads(line)
      key = row.get("path")
      previous = newest.get(key)
      if previous is None:
        order.append(key)
        newest[key] = row
        continue
      if float(row.get("mtime") or 0) >= float(previous.get("mtime") or 0):
        newest[key] = row
  return [newest[key] for key in order]

def score(row, query, tags):
  lowered = query.lower()
  points = 0
  weekday = str(row.get("weekday") or "").lower()
  colors = [str(color).lower() for color in row.get("colors") or []]
  extra = tags.get(row.get("path")) or []
  if isinstance(extra, str):
    extra = [extra]
  tag_words = set()
  for item in extra:
    tag_words.update(re.findall(r"[a-z0-9]+", str(item).lower()))
  text = str(row.get("text") or "").lower()
  for word in re.findall(r"[a-z0-9]+", lowered):
    if word in tag_words:
      points += 1
      continue
    if word in STOP:
      continue
    if word in WEEKDAYS:
      if weekday == word:
        points += 3
      continue
    if word in NAMED:
      if word in colors:
        points += 2
      continue
    if word in text:
      points += 1
  return points

def search(query):
  config = load_shot_config()
  tags = config.get("tags") or {}
  rows = load_rows()
  known = {row.get("path") for row in rows}
  for path, words in tags.items():
    if path in known or ignored(path, config) or not os.path.isfile(path):
      continue
    try:
      mtime = os.path.getmtime(path)
    except OSError:
      continue
    rows.append({
      "path": path,
      "mtime": mtime,
      "weekday": datetime.datetime.fromtimestamp(mtime).strftime("%A"),
      "colors": [],
      "text": "",
    })
  best = None
  best_score = 0
  for row in rows:
    path = row.get("path") or ""
    if ignored(path, config) or not os.path.isfile(path):
      continue
    points = score(row, query, tags)
    if points > best_score:
      best = row
      best_score = points
  if not best:
    print("No matching screenshot.", file=sys.stderr)
    sys.exit(1)
  print(best["path"])
  if sys.stdout.isatty():
    subprocess.Popen(["xdg-open", best["path"]])

def newest_png():
  config = load_shot_config()
  roots = []
  for key in ("OMASNAP_SCREENSHOT_DIR", "XDG_PICTURES_DIR"):
    if os.environ.get(key):
      roots.append(os.environ[key])
  home = os.path.expanduser("~")
  roots.extend([os.path.join(home, "Pictures"), os.path.join(home, "Pictures", "Screenshots")])
  newest = None
  newest_mtime = -1
  for root in roots:
    if not os.path.isdir(root):
      continue
    for dirpath, _, files in os.walk(root):
      for name in files:
        if not name.lower().endswith(".png"):
          continue
        path = os.path.join(dirpath, name)
        if ignored(path, config):
          continue
        try:
          mtime = os.path.getmtime(path)
        except OSError:
          continue
        if mtime > newest_mtime:
          newest = path
          newest_mtime = mtime
  return newest

def parse_index(args):
  path = text = None
  colors = None
  mtime = None
  index = 0
  while index < len(args):
    arg = args[index]
    if arg == "--path":
      path = args[index + 1]
      index += 2
    elif arg == "--text":
      text = args[index + 1]
      index += 2
    elif arg == "--colors":
      colors = [item for item in args[index + 1].split(",") if item]
      index += 2
    elif arg == "--mtime":
      mtime = args[index + 1]
      index += 2
    else:
      print("Unknown option: " + arg, file=sys.stderr)
      sys.exit(1)
  if not path:
    print("Usage: omarchy ml shot index --path FILE", file=sys.stderr)
    sys.exit(1)
  record(path, text, colors, mtime)

def prompt(placeholder):
  if not sys.stdin.isatty() or not shutil.which("gum"):
    return ""
  result = subprocess.run(["gum", "input", "--placeholder", placeholder], capture_output=True, text=True)
  return result.stdout.strip()

args = sys.argv[1:]
if not args:
  print("Usage: omarchy ml shot <index|search|index-latest|tag|ignore|save|saved>", file=sys.stderr)
  sys.exit(1)
command = args[0]
if command == "index":
  parse_index(args[1:])
elif command == "search":
  if len(args) >= 3 and args[1] == "--saved":
    name = " ".join(args[2:])
    query = (load_shot_config().get("saved") or {}).get(name)
    if not query:
      print("No saved search named " + name + ".", file=sys.stderr)
      sys.exit(1)
    search(query)
  elif len(args) < 2:
    print("Say what the screenshot looked like.", file=sys.stderr)
    sys.exit(1)
  else:
    search(" ".join(args[1:]))
elif command == "index-latest":
  path = newest_png()
  if not path:
    sys.exit(0)
  record(path, None, None, None)
elif command == "tag":
  if len(args) < 3:
    file_name = prompt("screenshot.png")
    words = prompt("login bug")
    args = ["tag", file_name, *words.split()]
  if len(args) < 3 or not args[1]:
    print("Usage: omarchy ml shot tag FILE WORDS...", file=sys.stderr)
    sys.exit(1)
  real = os.path.abspath(os.path.expanduser(args[1]))
  words = args[2:]

  def add_tags(data):
    tags = data.get("tags") or {}
    current = [str(item) for item in tags.get(real) or []]
    for word in words:
      if word not in current:
        current.append(word)
    tags[real] = current
    data["tags"] = tags

  update_shot_config(add_tags)
  print(real)
elif command == "ignore":
  if len(args) != 2:
    folder = prompt("~/Pictures/Screenshots/scratch")
    args = ["ignore", folder]
  if len(args) != 2 or not args[1]:
    print("Usage: omarchy ml shot ignore DIRECTORY", file=sys.stderr)
    sys.exit(1)
  real = os.path.abspath(os.path.expanduser(args[1]))

  def add_ignore(data):
    folders = [str(item) for item in data.get("ignore") or []]
    if real not in folders:
      folders.append(real)
    data["ignore"] = folders

  update_shot_config(add_ignore)
  print(real)
elif command == "save":
  if len(args) < 3:
    print("Usage: omarchy ml shot save NAME QUERY...", file=sys.stderr)
    sys.exit(1)
  name = args[1]
  query = " ".join(args[2:])

  def add_saved(data):
    saved = data.get("saved") or {}
    saved[name] = query
    data["saved"] = saved

  update_shot_config(add_saved)
  print(name)
elif command == "saved":
  saved = load_shot_config().get("saved") or {}
  if len(args) == 1 and sys.stdin.isatty() and shutil.which("gum") and saved:
    result = subprocess.run(["gum", "choose", *saved.keys()], capture_output=True, text=True)
    picked = result.stdout.strip()
    if not picked or picked not in saved:
      sys.exit(1)
    search(saved[picked])
    sys.exit(0)
  if len(args) == 1:
    if not saved:
      print("No saved searches.", file=sys.stderr)
      sys.exit(1)
    for name, query in saved.items():
      print(f"{name}\t{query}")
  else:
    name = " ".join(args[1:])
    query = saved.get(name)
    if not query:
      print("No saved search named " + name + ".", file=sys.stderr)
      sys.exit(1)
    search(query)
else:
  print("Usage: omarchy ml shot <index|search|index-latest|tag|ignore|save|saved>", file=sys.stderr)
  sys.exit(1)
PY

#!/bin/bash

# omarchy:summary=Install VS Code and configure Omarchy defaults for secrets, updates, and theme

echo "Installing VSCode..."
omarchy-pkg-add visual-studio-code-bin

mkdir -p ~/.vscode ~/.config/Code/User

# A reinstall, or dotfiles restored before it, finds both files already there,
# so a default joins what they hold and a key they set stays as set. They are
# JSONC, edited in place as omarchy-theme-set-vscode does: a strict JSON parser
# would reject the comments.
add_default() {
  local file=$1 key=$2 value=$3 comma=""

  [[ -s $file ]] || printf '{\n}\n' >"$file"
  if ! grep -v '^[[:space:]]*//' "$file" | grep -Fq "\"$key\""; then
    # A comma only when the object already holds a key to separate it from.
    grep -v '^[[:space:]]*//' "$file" | grep -Eq '"[^"]+"[[:space:]]*:' && comma=","
    sed -i --follow-symlinks -E "0,/^[[:space:]]*\{/s/^([[:space:]]*)\{/\1{\n  \"$key\": \"$value\"$comma/" "$file"
  fi
}

[[ -s ~/.vscode/argv.json ]] || cat > ~/.vscode/argv.json << 'EOF'
// This configuration file allows you to pass permanent command line arguments to VS Code.
// Only a subset of arguments is currently supported to reduce the likelihood of breaking
// the installation.
//
// PLEASE DO NOT CHANGE WITHOUT UNDERSTANDING THE IMPACT
//
// NOTE: Changing this file requires a restart of VS Code.
{
  "password-store":"gnome-libsecret"
}
EOF
add_default ~/.vscode/argv.json password-store gnome-libsecret

# VSC's own auto-update is off unless the settings already choose a mode
add_default ~/.config/Code/User/settings.json update.mode none

# Apply Omarchy theme to VSCode
omarchy-theme-set-vscode

setsid uwsm-app -- gtk-launch code >/dev/null 2>&1 &

#!/bin/bash

# omarchy:summary=Point model and dataset caches at a second drive mounted on /data
# omarchy:args=[--print|apply]

set -euo pipefail

root="${OMARCHY_ML_DATA_ROOT:-/data}"
mode="${1:-apply}"

print_plan() {
  cat <<EOF
HF_HOME=$root/huggingface
HF_HUB_CACHE=$root/huggingface/hub
TORCH_HOME=$root/torch
PIP_CACHE_DIR=$root/pip
UV_CACHE_DIR=$root/uv
OLLAMA_MODELS=$root/models/ollama
EOF
}

if [[ ! -d $root ]]; then
  print_plan
  echo "Mount a second drive at $root, then run this again."
  echo "  sudo mkdir -p $root"
  echo "  sudo mount /dev/disk/by-label/data $root"
  exit 1
fi

print_plan
if [[ $mode == "--print" ]]; then
  exit 0
fi
if [[ -z ${OMARCHY_OLLAMA_DROPIN:-} && $root != "/data" ]]; then
  echo "Mount the drive at /data to configure the Ollama system service." >&2
  exit 1
fi
if [[ $root != /* || $root == *[!a-zA-Z0-9_./-]* ]]; then
  echo "The dataset directory must be a plain absolute path." >&2
  exit 1
fi

mkdir -p \
  "$root/huggingface/hub" \
  "$root/torch" \
  "$root/pip" \
  "$root/uv" \
  "$root/models/ollama"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/environment.d"
mkdir -p "$config_dir"
cat > "$config_dir/omarchy-ml-data.conf" <<EOF
HF_HOME=$root/huggingface
HF_HUB_CACHE=$root/huggingface/hub
TORCH_HOME=$root/torch
PIP_CACHE_DIR=$root/pip
UV_CACHE_DIR=$root/uv
OLLAMA_MODELS=$root/models/ollama
EOF

chmod 755 "$root/models" "$root/models/ollama"
if id ollama >/dev/null 2>&1; then
  if ! chown ollama:ollama "$root/models/ollama" 2>/dev/null && [[ -z ${OMARCHY_OLLAMA_DROPIN:-} ]]; then
    sudo chown ollama:ollama "$root/models/ollama"
  fi
fi

system_dropin() {
  cat <<'EOF'
[Service]
Environment=OLLAMA_MODELS=/data/models/ollama
EOF
}

if [[ -n ${OMARCHY_OLLAMA_DROPIN:-} ]]; then
  mkdir -p "$(dirname "$OMARCHY_OLLAMA_DROPIN")"
  printf '[Service]\nEnvironment=OLLAMA_MODELS=%s/models/ollama\n' "$root" > "$OMARCHY_OLLAMA_DROPIN"
else
  dropin="/etc/systemd/system/ollama.service.d/omarchy-models.conf"
  if [[ $(id -u) -eq 0 ]]; then
    mkdir -p "$(dirname "$dropin")"
    system_dropin > "$dropin"
    systemctl daemon-reload
    systemctl try-restart ollama || true
  elif sudo -n true 2>/dev/null; then
    sudo mkdir -p "$(dirname "$dropin")"
    system_dropin | sudo tee "$dropin" >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl try-restart ollama || true
  else
    echo "Run this with sudo so ollama.service uses $root/models/ollama." >&2
    exit 1
  fi
fi

echo "Caches will use $root. Ollama reads $root/models/ollama after its service restarts."

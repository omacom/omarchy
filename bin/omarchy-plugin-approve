#!/bin/bash

# omarchy:summary=Approve a Ward plugin revision and its selected permissions
# omarchy:args=<id> --revision <sha256> [--read <name>] [--write <name>] [--read-setting <key>] [--write-setting <key>] [--http <scope>] [--exec <name:leaf>] [--allow-media] [--allow-network] [--allow-network-proxy] [--allow-notifications] [--allow-open-urls] [--allow-storage] [--allow-desktop-geometry] [--allow-audio-playback] [--allow-microphone] [--allow-audio-capture] [--yes]
# omarchy:examples=omarchy plugin approve acme.weather --revision <sha256> --allow-network

set -euo pipefail

fail() { echo "omarchy-plugin-approve: $*" >&2; exit 1; }
if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  echo "Usage: omarchy plugin approve <id> --revision <sha256> [--read <name>] [--write <name>] [--read-setting <key>] [--write-setting <key>] [--http <scope>] [--exec <name:leaf>] [--allow-media] [--allow-network] [--allow-network-proxy] [--allow-notifications] [--allow-open-urls] [--allow-storage] [--allow-desktop-geometry] [--allow-audio-playback] [--allow-microphone] [--allow-audio-capture] [--yes]"
  echo "All permissions default to denied. Approval does not start the plugin."
  echo "--read and --write select a named file or folder declared by the plugin, not a replacement path."
  echo "--write allows reading and changing the declared files. Revoking permission cannot undo completed changes."
  echo "--allow-media selects the exact media player declared by the plugin."
  echo "--http selects one reviewed HTTP scope. It cannot be combined with unrestricted --allow-network."
  echo "--allow-network-proxy selects public-destination HTTP/CONNECT streaming, including opaque TCP tunnels and data transmission; no local services. Cannot be combined with --allow-network."
  echo "--exec selects one command-tree leaf for a host executable, including its existing account and file access."
  echo "--allow-storage permits private plugin data to persist across restarts. Revocation retains saved data."
  echo "--allow-desktop-geometry reveals output/workspace layout and all window rectangles, without titles or window control."
  echo "--allow-audio-playback plays audio on the default output; it permits no recording."
  echo "--allow-microphone records the default input, including a virtual input if selected by the user."
  echo "--allow-audio-capture records the default output monitor, including other applications' audio."
  echo "Audio permissions are independent. Revocation stops streams but cannot retract audio already captured."
  exit 0
fi
id="${1:-}"
[[ -n $id ]] || fail "plugin id is required"
shift
revision=""
selections='{"read":[],"write":[],"network":false,"http":[],"media":false,"notifications":false,"settings":{"read":[],"write":[]},"openUrls":false,"storage":false,"desktopGeometry":false}'
assume_yes=0
while (( $# > 0 )); do
  case "$1" in
    --revision)
      [[ -n ${2:-} && -z $revision ]] || fail "--revision requires one reviewed digest"
      revision="$2"
      shift 2
      ;;
    --read | --write)
      [[ ${2:-} =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && ${2:-} != *".."* ]] || fail "$1 requires a filesystem permission name declared by the plugin, not a path"
      if [[ $1 == "--write" ]]; then
        access="write"
      else
        access="read"
      fi
      selections=$(jq -c --arg access "$access" --arg name "$2" '.[$access] += [$name] | .[$access] |= unique' <<<"$selections")
      shift 2
      ;;
    --http)
      [[ -n ${2:-} ]] || fail "--http requires one reviewed scope name"
      selections=$(jq -c --arg name "$2" '.http += [$name] | .http |= unique' <<<"$selections")
      shift 2
      ;;
    --exec)
      [[ ${2:-} == *:* && -n ${2%%:*} && -n ${2#*:} ]] || fail "--exec requires name:leaf"
      selections=$(jq -c --arg name "${2%%:*}" --arg leaf "${2#*:}" '.exec[$name] = ((.exec[$name] // []) + [$leaf] | unique)' <<<"$selections")
      shift 2
      ;;
    --allow-media)
      selections=$(jq -c '.media = true' <<<"$selections")
      shift
      ;;
    --allow-network)
      selections=$(jq -c '.network = true' <<<"$selections")
      shift
      ;;
    --allow-network-proxy)
      selections=$(jq -c '.networkProxy = true' <<<"$selections")
      shift
      ;;
    --allow-notifications)
      selections=$(jq -c '.notifications = true' <<<"$selections")
      shift
      ;;
    --allow-audio-playback)
      selections=$(jq -c '.audioPlayback = true' <<<"$selections")
      shift
      ;;
    --allow-microphone)
      selections=$(jq -c '.microphone = true' <<<"$selections")
      shift
      ;;
    --allow-audio-capture)
      selections=$(jq -c '.audioCapture = true' <<<"$selections")
      shift
      ;;
    --read-setting | --write-setting)
      [[ -n ${2:-} ]] || fail "$1 requires one exact own-setting key"
      if [[ $1 == "--read-setting" ]]; then
        access="read"
      else
        access="write"
      fi
      selections=$(jq -c --arg access "$access" --arg key "$2" '.settings[$access] += [$key] | .settings[$access] |= unique' <<<"$selections")
      shift 2
      ;;
    --allow-open-urls)
      selections=$(jq -c '.openUrls = true' <<<"$selections")
      shift
      ;;
    --allow-storage)
      selections=$(jq -c '.storage = true' <<<"$selections")
      shift
      ;;
    --allow-desktop-geometry)
      selections=$(jq -c '.desktopGeometry = true' <<<"$selections")
      shift
      ;;
    --yes | -y)
      assume_yes=1
      shift
      ;;
    *) fail "unknown approval option: $1" ;;
  esac
done
[[ $revision =~ ^[0-9a-f]{64}$ ]] || fail "--revision must be the exact SHA-256 from omarchy plugin review"
if (( ! assume_yes )); then
  [[ -t 0 && -t 1 ]] || fail "refusing approval without confirmation; pass --yes with explicit grants"
  printf 'Plugin: %s\nRevision: %s\nSelected permissions:\n' "$id" "$revision"
  jq . <<<"$selections"
  if jq -e '.write | length > 0' <<<"$selections" >/dev/null; then
    echo "Writable folders expose real host data for reading and changes. Revocation cannot undo completed writes."
  fi
  if jq -e '.exec // {} | length > 0' <<<"$selections" >/dev/null; then
    echo "Selected commands run with host files, network and existing account access. Revocation cannot undo completed actions."
  fi
  gum confirm "Approve this revision and only these permissions?" || fail "aborted"
fi
jq -cn --arg id "$id" --arg revision "$revision" --argjson selections "$selections" \
  '{operation: "approve", id: $id, revision: $revision, selections: $selections}' | omarchy-ward-runtime >/dev/null
omarchy-shell -q shell rescanPlugins >/dev/null 2>&1 || true
echo "Approved $id at $revision. No plugin was started."

#!/bin/bash

# omarchy:summary=Sign in to an agent subscription
# omarchy:args=[--check] [--events] [--reauth <account>] [claude|codex|grok|agy|muse|opencode|fireworks] [label]
# omarchy:examples=omarchy agent account add claude | omarchy agent account add Work | omarchy agent account add codex Side | omarchy agent account add muse

set -uo pipefail

# --check prints, per provider, whether adding one now would be its first
# sign-in, an additional account, or not possible yet. --events is for the
# agents panel: progress arrives as `@@omarchy <event> <detail>` lines mixed
# into the CLI's own output (which carries codes the panel shows), nothing
# waits on a terminal, and the result also lands as a notification in case
# the panel has closed.
# --reauth <account> signs an account that's already here in again, in its
# own home, for when its sign-in has lapsed.
check=false
events=false
reauth=""
while [[ ${1:-} == --* ]]; do
  case "$1" in
  --check) check=true ;;
  --events) events=true ;;
  --reauth)
    reauth="${2:-}"
    if [[ -z $reauth || $reauth == --* ]]; then
      echo "Usage: omarchy-agent-account-add --reauth <account> [claude|codex|grok|agy|muse|opencode|fireworks]" >&2
      exit 1
    fi
    shift
    ;;
  *) break ;;
  esac
  shift
done

# Whether a provider's own home (~/.claude, ~/.codex, ~/.grok) is signed in.
# For Claude that's whichever account sessions use, not always the primary.
primary_signed_in() {
  omarchy-agent-account-state list "$1" | jq -e --arg home "$HOME/.$1" '.[0].accounts | any(.home == $home and .signedIn)' >/dev/null
}

if [[ $check == "true" ]]; then
  for p in claude codex grok; do
    if primary_signed_in "$p"; then
      echo "$p additional"
    else
      echo "$p first"
    fi
  done
  # The rest keep one sign-in each, which signing in again replaces.
  printf '%s first\n' agy muse opencode fireworks
  exit 0
fi

# The provider can be left out when it's your default agent:
# `omarchy agent account add Work`.
if [[ ! ${1:-} =~ ^(claude|codex|grok|agy|gemini|muse|opencode|fireworks)$ ]]; then
  default=$(omarchy-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" ]] && set -- "$default" "$@"
fi

# Claude, Codex, and Grok can hold several accounts, each in a home of its
# own. The rest keep the one sign-in their CLI does.
accounts=false
case "${1:-}" in
claude) provider="claude"; name="Claude"; app="Claude Code"; site="claude.ai"; package="claude"; home_env="CLAUDE_CONFIG_DIR"; accounts=true ;;
codex) provider="codex"; name="Codex"; app="Codex"; site="chatgpt.com"; package="codex"; home_env="CODEX_HOME"; accounts=true ;;
grok) provider="grok"; name="Grok"; app="Grok Build"; site="x.ai"; package="grok"; home_env="GROK_HOME"; accounts=true ;;
# Antigravity signs in with the Google account a Gemini subscription is on.
agy | gemini) provider="agy"; name="Antigravity"; app="Antigravity"; package="antigravity-cli"; login_command=(agy acp --login) ;;
muse) provider="muse"; name="Muse"; app="Muse Code"; package="muse"; login_command=(muse login) ;;
# One OpenCode Console sign-in covers Zen and Go.
opencode) provider="opencode"; name="OpenCode"; app="OpenCode"; package="opencode"; login_command=(opencode auth login opencode --method device) ;;
# No CLI or harness of its own: pi and opencode are what use the key.
fireworks) provider="fireworks"; name="Fireworks"; app=""; package=""; login_command=(fireworks_login) ;;
*)
  echo "Usage: omarchy-agent-account-add [--check] [--events] [--reauth <account>] [claude|codex|grok|agy|muse|opencode|fireworks] [label]" >&2
  exit 1
  ;;
esac
label="${2:-}"

say() {
  if [[ $events == "true" ]]; then
    printf '@@omarchy status %s\n' "$*"
  else
    echo "$*"
  fi
}

# A signed-in agent gets a launcher of its own beside Agent, drawn by the
# icon set: Claude Code, Codex, or Grok Build, whatever the default agent is.
install_launcher() {
  omarchy-agent-launcher "$provider"
}

# A first sign-in announces the agent as ready, and an added account that it's
# ready for more; clicking either starts one. Any other says which account it was.
finish() {
  install_launcher
  if [[ $events == "true" ]]; then
    printf '@@omarchy done %s\n' "$1"
    if [[ ${2:-} == "ready" ]]; then
      omarchy-notification-send -g 󰚩 --image "$(omarchy-agent-logo "$provider")" \
        "$(omarchy-i18n agents.readyToCode "$app")" "$(omarchy-i18n agents.readyToCodeBody)" \
        --exec omarchy-agent --agent "$provider" --app-id="org.omarchy.$provider"
    elif [[ ${2:-} == "more" ]]; then
      omarchy-notification-send -g 󰚩 --image "$(omarchy-agent-logo "$provider")" \
        "$(omarchy-i18n agents.readyForMore "$app")" "$(omarchy-i18n agents.readyForMoreBody "$3")" \
        --exec omarchy-agent --agent "$provider" --app-id="org.omarchy.$provider"
    else
      omarchy-notification-send -g 󰚩 --image "$(omarchy-agent-logo "$provider")" "$1"
    fi
  else
    echo
    echo "$1"
  fi
}

# Accounts just added, fresh or recovered, are the ones you want tokens from
# next, so sessions switch to the newest: running Claude sessions too, and new
# ones for the others. If the choice can't be saved, the accounts are still
# added and say so.
announce_added() {
  local added newest used
  added=$(jq -r 'map(.label + (if .email != "" then " (" + .email + ")" else "" end)) | join(", ")' <<<"$1")
  newest=$(jq -c 'last' <<<"$1")
  if used=$(omarchy-agent-account-state use "$provider" "$(jq -r .id <<<"$newest")"); then
    omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    finish "$(omarchy-i18n agents.added "$added")" more "$(jq -r .label <<<"$newest")"
    if [[ $events != "true" ]]; then
      if [[ $(jq -r .seated <<<"$used") == "true" ]]; then
        echo "$name sessions now use $(jq -r .label <<<"$newest"), running ones included."
      else
        echo "New $name sessions now use $(jq -r .label <<<"$newest")."
      fi
    fi
  else
    omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    finish "$(omarchy-i18n agents.addedNotSelected "$added")"
  fi
}

fail() {
  if [[ $events == "true" ]]; then
    printf '@@omarchy error %s\n' "$1"
    omarchy-notification-send -g 󰚩 --image "$(omarchy-agent-logo "$provider")" -u critical "$(omarchy-i18n agents.addFailed "$name")" "$1"
  else
    echo "$1" >&2
  fi
  exit 1
}

# Cancelling from the panel stops the CLI's login too, and leaves no
# half-made home behind.
home=""
browser=""
cleanup() {
  [[ -n $browser ]] && rm -f "$browser"
  [[ -n $home && -d $home && $home == */.pending/* ]] && rm -rf "$home"
}
trap cleanup EXIT
trap 'pkill -TERM -P $$; exit 130' TERM INT

# Bash holds a trap until a foreground command finishes, and a login waits on
# the browser for as long as it takes. Running it in the background behind a
# `wait` lets Cancel stop it at once. It keeps this script's stdin, where the
# panel sends a pasted code.
interruptible() {
  "$@" <&0 &
  wait $!
}

# The panel follows a CLI's download as `@@omarchy progress <done> <total>
# <rate>` lines, in bytes and bytes a second, read off mise's own progress,
# which it keeps printing every few seconds without a terminal too, as
# `… 12.3/166.8 MB · 6.1 MB/s`.
# Nothing between mise and awk may buffer, or the lines all arrive at the end.
# The install runs in the background behind a `wait`, like a login, so Cancel
# stops it at once; the parser is waited for so its last line lands before
# the next status does.
install_cli() {
  if [[ $events != "true" ]]; then
    "$@"
    return
  fi

  local progress progress_pid status
  printf '@@omarchy progress 0 0 0\n'
  exec {progress}> >(awk -v RS='[\r\n]+' '
    function bytes(n, unit) {
      return n * (unit == "GB" ? 1e9 : unit == "MB" ? 1e6 : unit ~ /^[kK]B$/ ? 1e3 : 1)
    }
    match($0, /[0-9.]+( [kKMG]?B)?\/[0-9.]+ [kKMG]?B/) {
      n = split(substr($0, RSTART, RLENGTH), part, /[\/ ]/)
      unit = part[n]
      done = n == 4 ? bytes(part[1], part[2]) : bytes(part[1], unit)
      total = bytes(part[n - 1], unit)
      rate = 0
      if (match($0, /[0-9.]+ [kKMG]?B\/s/)) {
        split(substr($0, RSTART, RLENGTH), speed, /[ \/]/)
        rate = bytes(speed[1], speed[2])
      }
      printf "@@omarchy progress %d %d %d\n", done, total, rate
      fflush()
    }')
  progress_pid=$!
  "$@" >&"$progress" 2>&1 </dev/null &
  wait $!
  status=$?
  exec {progress}>&-
  wait "$progress_pid"
  return "$status"
}

# Omarchy declares the agent CLIs as lazy mise tools, and wraps their commands
# to run the selected account, so a command on PATH says nothing about whether
# the CLI is there: the first run of a lazy tool downloads it, silently. Left
# to the login, that download looks like the sign-in hanging, so it happens
# here, where the panel can show it. A CLI counts as there when mise has it,
# or when one is on PATH outside mise's wrappers and shims (installed some
# other way). Installing a declared tool leaves the user's config alone; a
# user who opted out of the defaults selects it instead.
cli_missing() {
  mise where "$package" &>/dev/null && return 1

  local mise_data=${MISE_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/mise}
  local dir path=""
  local IFS=:
  for dir in $PATH; do
    if [[ $dir != "$mise_data/command-wrappers/bin" && $dir != "$mise_data/shims" ]]; then
      path+="${path:+:}$dir"
    fi
  done
  ! PATH=$path type -P "$provider" >/dev/null
}

if [[ -n $package ]] && cli_missing; then
  say "$(omarchy-i18n agents.installingCli "$name")"
  if omarchy-mise-default-tools declares "$package"; then
    install_cli env MISE_MINIMUM_RELEASE_AGE=0 mise install "$package"
  else
    install_cli env MISE_MINIMUM_RELEASE_AGE=0 mise use -g "$package"
  fi || fail "$(omarchy-i18n agents.installCliFailed "$name")"
fi

# Your main browser is almost certainly signed in to the account you already
# have, and a login would quietly reuse it. The CLIs open their login page
# through $BROWSER, so this points it at a private window instead.
private_browser() {
  browser=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-account-browser.XXXXXX") || fail "$(omarchy-i18n agents.homeFailed)"
  printf '#!/bin/bash\nexec omarchy-launch-browser --private "$1"\n' >"$browser" || fail "$(omarchy-i18n agents.homeFailed)"
  chmod +x "$browser" || fail "$(omarchy-i18n agents.homeFailed)"
}

# Fireworks has no login to run: an API key made in its console is the
# sign-in. It's saved where pi keeps keys, and in opencode when that's
# installed, since those are the agents that run on it. The key only travels
# through the environment, never a command line. A key Fireworks refuses is
# not saved.
fireworks_login() {
  local key auth saved id
  omarchy-launch-browser "https://app.fireworks.ai/settings/users/api-keys"
  if [[ $events == "true" ]]; then
    read -r key
  else
    key=$(gum input --password --prompt "Fireworks API key: ")
  fi
  [[ -n $key ]] || return 1
  FIREWORKS_API_KEY=$key omarchy-agent-usage-fireworks --force | jq -e '.usageStatusText != "Sign-in expired"' >/dev/null || return 1

  auth="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/auth.json"
  mkdir -p "${auth%/*}" || return 1
  [[ -s $auth ]] || echo '{}' >"$auth"
  saved=$(KEY=$key jq '.fireworks = {type: "api_key", key: env.KEY}' "$auth") || return 1
  (umask 077 && printf '%s\n' "$saved" >"$auth.new") && mv "$auth.new" "$auth" || return 1

  # opencode imports a credential as inactive when it already has one.
  if mise where opencode &>/dev/null; then
    id="omarchy-$EPOCHSECONDS"
    KEY=$key jq -n --arg id "$id" '[{id: $id, integrationID: "fireworks-ai", label: "Fireworks AI", active: true, value: {type: "key", key: env.KEY}}]' |
      opencode auth import >/dev/null 2>&1 && opencode auth switch fireworks-ai "$id" >/dev/null 2>&1
  fi
  return 0
}

# One sign-in, where the CLI always keeps it, through your normal browser:
# adding it and signing in again are the same login. The CLI's whole output
# goes to the panel, which shows the code it prints to confirm in the browser.
if [[ $accounts == "false" ]]; then
  say "$(omarchy-i18n agents.signInBrowser "$name")"
  # Antigravity's page ends on a code to paste back, and Fireworks on a key;
  # the panel shows a field for it, under what to paste.
  if [[ $events == "true" && $provider == "agy" ]]; then
    printf '@@omarchy paste %s\n' "$(omarchy-i18n agents.pasteSignInCode)"
  elif [[ $events == "true" && $provider == "fireworks" ]]; then
    printf '@@omarchy paste %s\n' "$(omarchy-i18n agents.pasteApiKey)"
  fi
  interruptible "${login_command[@]}" 2>&1 || fail "$(omarchy-i18n agents.signInFailed "$name")"

  omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
  if [[ -n $app ]]; then
    # As with the first Claude, Codex, or Grok sign-in below.
    if [[ -z $(omarchy-default-agent) ]]; then
      mkdir -p "$HOME/.config/omarchy/defaults"
      printf '%s\n' "$provider" >"$HOME/.config/omarchy/defaults/agent"
    fi
    finish "$(omarchy-i18n agents.signedIn "$name")" ready
  else
    finish "$(omarchy-i18n agents.signedIn "$name")"
  fi
  exit 0
fi

case "$provider" in
claude) login_command=(claude auth login) ;;
codex) login_command=(codex login) ;;
grok) login_command=(grok login) ;;
esac

# The CLI's own home, whatever this shell has pointed it at.
login() {
  interruptible env -u CLAUDE_CONFIG_DIR -u CODEX_HOME -u GROK_HOME "OMARCHY_AGENT_${provider^^}_HOME=" "${login_command[@]}"
}

# Signing an account that's already here in again: the primary through the
# normal browser, an added one through a private window. Its home is never
# recreated or removed.
if [[ -n $reauth ]]; then
  found=$(omarchy-agent-account-state homes "$provider" | awk -F'\t' -v id="$reauth" '$1 == id || (id == ":primary" && $4 == "1")' | head -1)
  account_home=$(cut -f2 <<<"$found")
  [[ -n $account_home ]] || fail "$(omarchy-i18n agents.noAccountNamed "$name" "$reauth")"

  # A Claude login can move while the browser is open, so it signs in to a
  # scratch home and is installed wherever the account's login is by then.
  if [[ $provider == "claude" ]]; then
    home=$(omarchy-agent-account-state begin "$provider" "" "$$") || fail "$(omarchy-i18n agents.homeFailed)"
    target="$home"
  else
    target="$account_home"
  fi
  where=(env -u CLAUDE_CONFIG_DIR -u CODEX_HOME -u GROK_HOME "OMARCHY_AGENT_${provider^^}_HOME=")
  [[ $target != "$HOME/.$provider" ]] && where+=("$home_env=$target")

  if [[ $(cut -f4 <<<"$found") == "1" ]]; then
    say "$(omarchy-i18n agents.signInAgainBrowser "$name")"
    interruptible "${where[@]}" "${login_command[@]}" || fail "$(omarchy-i18n agents.signInFailed "$name")"
  else
    say "$(omarchy-i18n agents.signInAgainPrivate)"
    private_browser
    interruptible "${where[@]}" BROWSER="$browser" "${login_command[@]}" || fail "$(omarchy-i18n agents.signInFailed "$name")"
  fi
  if [[ $provider == "claude" ]]; then
    installed=$(omarchy-agent-account-state relogin "$provider" "$(cut -f1 <<<"$found")" "$home" 2>&1) || fail "$installed"
  fi

  omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
  finish "$(omarchy-i18n agents.signedInAgain "$name")"
  exit 0
fi

# The first subscription signs in where the CLI always looks, through your
# normal browser: nothing is signed in there yet that it could be mistaken for.
if ! primary_signed_in "$provider"; then
  say "$(omarchy-i18n agents.signInBrowser "$name")"
  if login && primary_signed_in "$provider"; then
    # The first agent signed in on a machine with none chosen becomes the
    # default, so `omarchy agent` and the panel's starter prompts have one to
    # run. A default someone already picked is never touched.
    if [[ -z $(omarchy-default-agent) ]]; then
      mkdir -p "$HOME/.config/omarchy/defaults"
      printf '%s\n' "$provider" >"$HOME/.config/omarchy/defaults/agent"
    fi
    omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    finish "$(omarchy-i18n agents.signedIn "$name")" ready
  else
    fail "$(omarchy-i18n agents.signInFailed "$name")"
  fi
else
  # Retry the final registration of a completed, interrupted sign-in before
  # asking for another browser login. Live sign-ins are never recovered.
  if recovered=$(omarchy-agent-account-state recover "$provider"); then
    if [[ $(jq 'length' <<<"$recovered") != "0" ]]; then
      announce_added "$recovered"
      exit 0
    fi
  else
    fail "$recovered"
  fi

  if [[ -z $label && $events == "false" && -t 0 ]]; then
    label=$(gum input --placeholder "Work" --prompt "Name this $name account: ") || exit 130
  fi

  if [[ $events == "true" ]]; then
    say "$(omarchy-i18n agents.signInPrivate)"
  else
    cat <<EOF

Sign in as the account you're adding in the private window that opens.
If a private window was already open, close it first, or $site may reuse whoever it has signed in.

Don't log out of the $name CLI to do this: logging out revokes the saved sign-in.

EOF
  fi

  home=$(omarchy-agent-account-state begin "$provider" "$label" "$$") || fail "$(omarchy-i18n agents.homeFailed)"

  private_browser
  interruptible env BROWSER="$browser" "$home_env=$home" "${login_command[@]}"

  if account=$(omarchy-agent-account-state register "$provider" "$label" "$home" 2>&1); then
    home=""
    announce_added "[$account]"
  else
    registration_status=$?
    # Keep the home for cleanup when registration was explicitly interrupted.
    # Storage failures preserve the sign-in and receipt for the next refresh.
    if (( registration_status != 130 )); then
      home=""
    fi
    fail "$account"
  fi
fi

#!/bin/bash

# omarchy:summary=Sign in to a Claude, Codex, Grok, or OpenCode Go subscription
# omarchy:args=[--check] [--events] [--reauth <account>] [claude|codex|grok|opencode] [label]
# omarchy:examples=omarchy agent account add claude | omarchy agent account add Work | omarchy agent account add codex Side | omarchy agent account add opencode oc_sk_…

set -uo pipefail

# --check prints, per provider, whether adding one now would be its first
# sign-in, an additional account, or not possible yet. --events is for the
# agents panel: progress arrives as `@@omarchy <event> <detail>` lines mixed
# into the CLI's own output (which carries codes the panel shows), nothing
# waits on a terminal, and the result also lands as a notification in case
# the panel has closed.
# --reauth <account> signs an account that's already here in again, in its
# own home, for when its sign-in has lapsed.
check=false
events=false
reauth=""
while [[ ${1:-} == --* ]]; do
  case "$1" in
  --check) check=true ;;
  --events) events=true ;;
  --reauth)
    reauth="${2:-}"
    shift
    ;;
  *) break ;;
  esac
  shift
done

# Whether a provider's own home (~/.claude, ~/.codex, ~/.grok) is signed in.
primary_signed_in() {
  omarchy-agent-account-state list "$1" | jq -e '.[0].accounts | any(.primary and .signedIn)' >/dev/null
}

if [[ $check == "true" ]]; then
  for p in claude codex grok; do
    if primary_signed_in "$p"; then
      echo "$p additional"
    else
      echo "$p first"
    fi
  done
  # OpenCode Go holds one API key, not a set of accounts; re-adding replaces it.
  echo "opencode first"
  exit 0
fi

# The provider can be left out when it's your default agent:
# `omarchy agent account add Work`.
if [[ ${1:-} != "claude" && ${1:-} != "codex" && ${1:-} != "grok" && ${1:-} != "opencode" ]]; then
  default=$(omarchy-default-agent)
  [[ $default == "claude" || $default == "codex" || $default == "grok" || $default == "opencode" ]] && set -- "$default" "$@"
fi

case "${1:-}" in
claude) provider="claude"; name="Claude"; site="claude.ai"; package="claude"; home_env="CLAUDE_CONFIG_DIR" ;;
codex) provider="codex"; name="Codex"; site="chatgpt.com"; package="codex"; home_env="CODEX_HOME" ;;
grok) provider="grok"; name="Grok"; site="x.ai"; package="grok"; home_env="GROK_HOME" ;;
opencode) provider="opencode"; name="OpenCode Go"; site="opencode.ai/console"; package="opencode"; home_env="" ;;
*)
  echo "Usage: omarchy-agent-account-add [--check] [--events] [--reauth <account>] [claude|codex|grok|opencode] [label]" >&2
  exit 1
  ;;
esac
label="${2:-}"

say() {
  if [[ $events == "true" ]]; then
    printf '@@omarchy status %s\n' "$*"
  else
    echo "$*"
  fi
}

finish() {
  if [[ $events == "true" ]]; then
    printf '@@omarchy done %s\n' "$1"
    omarchy-notification-send -g 󰚩 "$1"
  else
    echo
    echo "$1"
  fi
}

fail() {
  if [[ $events == "true" ]]; then
    printf '@@omarchy error %s\n' "$1"
    omarchy-notification-send -g 󰚩 -u critical "$(omarchy-i18n agents.addFailed "$name")" "$1"
  else
    echo "$1" >&2
  fi
  exit 1
}

# Cancelling from the panel stops the CLI's login too, and leaves no
# half-made home behind.
home=""
browser=""
header_file=""
cleanup() {
  [[ -n $browser ]] && rm -f "$browser"
  [[ -n $header_file ]] && rm -f "$header_file"
  [[ -n $home && -d $home && $home == */.pending/* ]] && rm -rf "$home"
}
trap cleanup EXIT
trap 'pkill -TERM -P $$; exit 130' TERM INT

# Bash holds a trap until a foreground command finishes, and a login waits on
# the browser for as long as it takes. Running it in the background behind a
# `wait` lets Cancel stop it at once. It keeps this script's stdin, where the
# panel sends a pasted code.
interruptible() {
  "$@" <&0 &
  wait $!
}

if omarchy-cmd-missing "$provider"; then
  say "$(omarchy-i18n agents.installingCli "$name")"
  if [[ $events == "true" ]]; then
    mise use -g "$package" >/dev/null 2>&1 || fail "$(omarchy-i18n agents.installCliFailed "$name")"
  else
    mise use -g "$package" || exit 1
  fi
fi

# Your main browser is almost certainly signed in to the account you already
# have, and a login would quietly reuse it. The CLIs open their login page
# through $BROWSER, so this points it at a private window instead.
private_browser() {
  browser=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-account-browser.XXXXXX") || fail "$(omarchy-i18n agents.homeFailed)"
  printf '#!/bin/bash\nexec omarchy-launch-browser --private "$1"\n' >"$browser" || fail "$(omarchy-i18n agents.homeFailed)"
  chmod +x "$browser" || fail "$(omarchy-i18n agents.homeFailed)"
}

case "$provider" in
claude) login_command=(claude auth login) ;;
codex) login_command=(codex login) ;;
grok) login_command=(grok login) ;;
esac

# The CLI's own home, whatever this shell has pointed it at.
login() {
  interruptible env -u CLAUDE_CONFIG_DIR -u CODEX_HOME -u GROK_HOME "OMARCHY_AGENT_${provider^^}_HOME=" "${login_command[@]}"
}

# OpenCode Go has no login command: a Go workspace's Console API key is the
# sign-in, pasted here and checked against the gateway's usage endpoint before
# it lands in opencode's auth.json. One key per machine; re-running replaces
# it. The console page opens in the normal browser — that is where the user
# is already signed in to the Console.
if [[ $provider == "opencode" ]]; then
  console_url="https://opencode.ai/console"
  say "$(omarchy-i18n agents.goConsoleOpened)"
  # The panel lifts the first URL out of the output for its reopen link.
  echo "$console_url"
  omarchy-launch-browser "$console_url" >/dev/null 2>&1 &

  # The key may be passed as the argument (`account add opencode oc_sk_…`);
  # otherwise it is asked for. The panel's paste field writes it to stdin.
  key="$label"
  if [[ -z $key ]]; then
    if [[ $events == "true" ]]; then
      read -r key || fail "$(omarchy-i18n agents.loginUnfinished)"
    elif [[ -t 0 ]]; then
      key=$(gum input --password --placeholder "oc_sk_…" --prompt "OpenCode Go API key: ") || exit 130
    else
      read -r key || fail "$(omarchy-i18n agents.loginUnfinished)"
    fi
  fi
  key=${key//[[:space:]]/}
  [[ -n $key ]] || fail "$(omarchy-i18n agents.loginUnfinished)"

  say "$(omarchy-i18n agents.goCheckingKey)"
  # The key never enters a child process's arguments, where another local
  # user could read it: curl takes the header from a private file instead.
  header_file=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omarchy-go-auth.XXXXXX") || fail "$(omarchy-i18n agents.homeFailed)"
  printf 'Authorization: Bearer %s\n' "$key" >"$header_file" || fail "$(omarchy-i18n agents.homeFailed)"
  status=$(curl -sS -o /dev/null -w "%{http_code}" -m 15 \
    -H @"$header_file" -H "Accept: application/json" \
    "https://opencode.ai/inference/go/v1/usage" 2>/dev/null) || status="000"
  if [[ $status == "404" ]]; then
    status=$(curl -sS -o /dev/null -w "%{http_code}" -m 15 \
      -H @"$header_file" -H "Accept: application/json" \
      "https://opencode.ai/zen/go/v1/usage" 2>/dev/null) || status="000"
  fi
  rm -f "$header_file"
  header_file=""
  case "$status" in
  200) ;;
  401) fail "$(omarchy-i18n agents.goKeyRejected)" ;;
  403) fail "$(omarchy-i18n agents.goKeyNoSubscription)" ;;
  *) fail "$(omarchy-i18n agents.goKeyUnreachable)" ;;
  esac

  # Merge the key into opencode's auth.json, keeping the other providers, and
  # write it the way a credential file is written: private, one atomic rename.
  auth_dir="${XDG_DATA_HOME:-$HOME/.local/share}/opencode"
  mkdir -p "$auth_dir" || fail "$(omarchy-i18n agents.homeFailed)"
  OPENCODE_AUTH_DIR="$auth_dir" OPENCODE_GO_KEY="$key" python3 - <<'EOF' || fail "$(omarchy-i18n agents.homeFailed)"
import json, os, tempfile
from pathlib import Path

auth_dir = Path(os.environ["OPENCODE_AUTH_DIR"])
auth_file = auth_dir / "auth.json"
try:
    auth = json.loads(auth_file.read_text())
    if not isinstance(auth, dict):
        auth = {}
except (OSError, json.JSONDecodeError):
    auth = {}
auth["opencode-go"] = {"type": "api", "key": os.environ["OPENCODE_GO_KEY"]}
fd, tmp = tempfile.mkstemp(prefix="auth.json.", dir=auth_dir)
try:
    with os.fdopen(fd, "w") as handle:
        json.dump(auth, handle, indent=2)
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(tmp, 0o600)
    os.replace(tmp, auth_file)
finally:
    Path(tmp).unlink(missing_ok=True)
EOF

  # The first agent signed in on a machine with none chosen becomes the
  # default, so `omarchy agent` and the panel's starter prompts have one to
  # run. A default someone already picked is never touched.
  if [[ -z $(omarchy-default-agent) ]]; then
    mkdir -p "$HOME/.config/omarchy/defaults"
    printf '%s\n' "$provider" >"$HOME/.config/omarchy/defaults/agent"
  fi
  omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
  finish "$(omarchy-i18n agents.signedIn "$name")"
  exit 0
fi

# Signing an account that's already here in again, where it lives: the
# primary home through the normal browser, an added one through a private
# window. Its home is never recreated or removed.
if [[ -n $reauth ]]; then
  if [[ $reauth == ":primary" ]]; then
    account_home="$HOME/.$provider"
  else
    account_home=$(omarchy-agent-account-state homes "$provider" | awk -F'\t' -v id="$reauth" '$1 == id { print $2 }')
  fi
  [[ -n $account_home ]] || fail "$(omarchy-i18n agents.noAccountNamed "$name" "$reauth")"

  if [[ $account_home == "$HOME/.$provider" ]]; then
    say "$(omarchy-i18n agents.signInAgainBrowser "$name")"
    login || fail "$(omarchy-i18n agents.signInFailed "$name")"
  else
    say "$(omarchy-i18n agents.signInAgainPrivate)"
    private_browser
    interruptible env BROWSER="$browser" "$home_env=$account_home" "${login_command[@]}" || fail "$(omarchy-i18n agents.signInFailed "$name")"
  fi

  omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
  finish "$(omarchy-i18n agents.signedInAgain "$name")"
  exit 0
fi

# The first subscription signs in where the CLI always looks, through your
# normal browser: nothing is signed in there yet that it could be mistaken for.
if ! primary_signed_in "$provider"; then
  say "$(omarchy-i18n agents.signInBrowser "$name")"
  if login && primary_signed_in "$provider"; then
    # The first agent signed in on a machine with none chosen becomes the
    # default, so `omarchy agent` and the panel's starter prompts have one to
    # run. A default someone already picked is never touched.
    if [[ -z $(omarchy-default-agent) ]]; then
      mkdir -p "$HOME/.config/omarchy/defaults"
      printf '%s\n' "$provider" >"$HOME/.config/omarchy/defaults/agent"
    fi
    omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    finish "$(omarchy-i18n agents.signedIn "$name")"
  else
    fail "$(omarchy-i18n agents.signInFailed "$name")"
  fi
else
  # Retry the final registration of a completed, interrupted sign-in before
  # asking for another browser login. Live sign-ins are never recovered.
  if recovered=$(omarchy-agent-account-state recover "$provider"); then
    if [[ $(jq 'length' <<<"$recovered") != "0" ]]; then
      added=$(jq -r 'map(.label + (if .email != "" then " (" + .email + ")" else "" end)) | join(", ")' <<<"$recovered")
      omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
      finish "$(omarchy-i18n agents.added "$added")"
      exit 0
    fi
  else
    fail "$recovered"
  fi

  if [[ -z $label && $events == "false" && -t 0 ]]; then
    label=$(gum input --placeholder "Work" --prompt "Name this $name account: ") || exit 130
  fi

  if [[ $events == "true" ]]; then
    say "$(omarchy-i18n agents.signInPrivate)"
  else
    cat <<EOF

Sign in as the account you're adding in the private window that opens.
If a private window was already open, close it first, or $site may reuse whoever it has signed in.

Don't log out of the $name CLI to do this: logging out revokes the saved sign-in.

EOF
  fi

  home=$(omarchy-agent-account-state begin "$provider" "$label" "$$") || fail "$(omarchy-i18n agents.homeFailed)"

  private_browser
  interruptible env BROWSER="$browser" "$home_env=$home" "${login_command[@]}"

  if account=$(omarchy-agent-account-state register "$provider" "$label" "$home" 2>&1); then
    home=""
    added=$(jq -r '.label + (if .email != "" then " (" + .email + ")" else "" end)' <<<"$account")
    omarchy-agent-usage-update --force "$provider" >/dev/null 2>&1 &
    if [[ $events == "true" ]]; then
      finish "$(omarchy-i18n agents.added "$added")"
    else
      finish "$(omarchy-i18n agents.added "$added")"
      echo "Switch to it with: omarchy agent account use $provider $(jq -r .id <<<"$account")"
    fi
  else
    registration_status=$?
    # Keep the home for cleanup when registration was explicitly interrupted.
    # Storage failures preserve the sign-in and receipt for the next refresh.
    if (( registration_status != 130 )); then
      home=""
    fi
    fail "$account"
  fi
fi

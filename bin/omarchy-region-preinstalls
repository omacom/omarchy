#!/bin/bash

# omarchy:summary=Apply a region's preinstalled launchers, dock pins and bindings for this user
# omarchy:args=<region>
# omarchy:hidden=true

set -euo pipefail

region=${1:-}
if [[ ! $region =~ ^[a-z]{2}$ ]]; then
  echo "Usage: omarchy-region-preinstalls <region>" >&2
  exit 1
fi

profile="$OMARCHY_PATH/default/regions/$region"
if [[ -r $profile/apps-skip || -d $profile/applications || -r $profile/bindings.lua ]]; then
  # Persist the install's choice, not the current region: switching download
  # sources later must not change which applications this user has.
  state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
  applications="$HOME/.local/share/applications"
  mkdir -p "$state_dir" "$applications"

  if [[ -r $profile/apps-skip ]]; then
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' -e '/\//d' "$profile/apps-skip" >"$state_dir/preinstalls-skipped"

    pinned=$(omarchy-dock pinned)
    while IFS= read -r name; do
      rm -f "$applications/$name.desktop"
      if grep -qxF -- "$name" <<<"$pinned"; then
        omarchy-dock unpin "$name" >/dev/null
      fi
    done <"$state_dir/preinstalls-skipped"
  fi

  # The region's replacement launchers and bindings, which Restore Preinstalls
  # takes back out along with this record.
  if [[ -d $profile/applications || -r $profile/bindings.lua ]]; then
    printf '%s\n' "$region" >"$state_dir/preinstalls-region"
    if compgen -G "$profile/applications/*.desktop" >/dev/null; then
      cp "$profile"/applications/*.desktop "$applications/"
    fi
  fi

  update-desktop-database "$applications"

  # Additional users finalize after Hyprland loaded its initial bindings.
  # Do not reload Hyprland from install chroots or first-boot owner setup.
  if [[ ${OMARCHY_SETUP_CONTEXT:-runtime} == "runtime" ]]; then
    hyprctl reload >/dev/null 2>&1 || true
  fi
fi

#!/bin/bash

# omarchy:summary=Lock before suspend and wait for the session lock to become secure
# omarchy:group=system
# omarchy:hidden=true

# Overrunning the budget is the failure this whole path exists to prevent:
# logind stops honouring the inhibitor and suspends mid-lock. Every call below
# is bounded by what is left of the budget, so the deadline enforces itself
# rather than depending on an estimate of how long a step ought to take.
budget_cap_ms=12000
lock_timeout_ms=1000
status_timeout_ms=500
poll_interval=0.1
notification_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy"
notification_id_file="$notification_state_dir/sleep-lock-notification-id"
notification_lock_file="$notification_state_dir/sleep-lock-notification.lock"
notification_lock_timeout=24
notification_send_timeout=${OMARCHY_NOTIFICATION_SEND_TIMEOUT:-5}
notification_proc_root=${OMARCHY_PROC_ROOT:-/proc}
[[ $notification_send_timeout =~ ^(0\.[0-9]*[1-9][0-9]*|[1-4](\.[0-9]+)?|5(\.0+)?)$ ]] || notification_send_timeout=5

# logind decides how long a delay inhibitor may hold the machine, and the
# shipped drop-in only counts once logind has reloaded it, so ask rather than
# assume. Leaving logind a fifth of its own window to deliver PrepareForSleep
# and act on the release gives 4s at the 5s default and 12s at the shipped 15s.
# The cap keeps a hand-raised window from stranding a closed laptop in a bag.
derive_budget_ms() {
  local window
  window=$(timeout --kill-after=0.1s 1s busctl get-property \
    org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null)
  window=${window##* }

  # An unreadable window means we cannot know, so assume logind's own default.
  [[ $window =~ ^[0-9]+$ ]] && (( window > 0 )) || window=5000000
  window=$((window / 1000))

  # Never leave logind less than a second, however small its window is.
  window=$((window - (window / 5 > 1000 ? window / 5 : 1000)))

  (( window < budget_cap_ms )) && echo "$window" || echo "$budget_cap_ms"
}

report_mode_reason=""
if [[ ${1:-} == --report-unsecured ]]; then
  report_mode_reason=${2:-unknown}
  budget_ms=1
else
  budget_ms=${1:-$(derive_budget_ms)}
  if [[ ! $budget_ms =~ ^[0-9]+$ ]] || (( budget_ms < 1 || budget_ms > budget_cap_ms )); then
    budget_ms=$(derive_budget_ms)
  fi
fi

# EPOCHREALTIME renders with the locale's decimal separator, so drop every
# non-digit rather than assuming a period. A comma would otherwise read as
# bash's comma operator and silently void the deadline.
deadline_ms=$((10#${EPOCHREALTIME//[!0-9]/} / 1000 + budget_ms))

remaining_ms() {
  echo $((deadline_ms - 10#${EPOCHREALTIME//[!0-9]/} / 1000))
}

# Clamping to what is left as well as to the call's own limit is what lets the
# loop below stay a plain "while there is time" without predicting step costs.
lock_ipc() {
  local limit=$1 remaining seconds
  shift

  remaining=$(remaining_ms)
  (( remaining > 0 )) || return 1
  (( limit < remaining )) || limit=$remaining
  printf -v seconds '%d.%03d' $((limit / 1000)) $((limit % 1000))

  OMARCHY_SHELL_IPC_TIMEOUT="$seconds" \
    timeout --kill-after=0.1s "$seconds" omarchy-shell "$@"
}

# The shell answers refusals on stdout with a zero exit, so the reply is the
# only way to spot a lock it can never perform. Nothing else needs inspecting:
# the status poll is what confirms success, and re-requesting is idempotent, so
# a request that may not have landed costs nothing to repeat.
request_lock() {
  case $(lock_ipc "$lock_timeout_ms" lock lock 2>/dev/null) in
    missing-pam) report_unsecured "no lock screen is configured" ;;
  esac
}

# secure: done. locking: the shell has the request and is working on it, so
# leave it alone. Anything else, unreadable replies included, means ask again.
lock_state() {
  jq -r 'if .secure == true then "secure"
         elif .requested == true then "locking"
         else "idle" end' \
    <<<"$(lock_ipc "$status_timeout_ms" lock status 2>/dev/null)" 2>/dev/null
}

sync_clamshell() {
  # Lid transitions can temporarily stall Hyprland IPC. This is best-effort:
  # the lid binding and monitor watcher also reconcile clamshell state.
  timeout --kill-after=0.1s 0.4s \
    omarchy-hyprland-monitor-clamshell >/dev/null 2>&1 || true
}

# Each notification server numbers its ids from 1 and lets any sender replace
# any live id, so a saved id is only safe to reuse with the server that issued it.
notification_server() {
  local owner pid stat start_time
  local -a stat_fields

  owner=$(timeout --kill-after=0.1s 0.5s busctl --user call \
    org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetNameOwner s \
    org.freedesktop.Notifications 2>/dev/null) || return 1
  owner=${owner#* }
  owner=${owner#\"}
  owner=${owner%\"}
  [[ $owner =~ ^:[0-9]+(\.[0-9]+)+$ ]] || return 1

  pid=$(timeout --kill-after=0.1s 0.5s busctl --user call \
    org.freedesktop.DBus /org/freedesktop/DBus \
    org.freedesktop.DBus GetConnectionUnixProcessID s \
    "$owner" 2>/dev/null) || return 1
  pid=${pid##* }
  [[ $pid =~ ^[0-9]+$ ]] || return 1

  [[ -r $notification_proc_root/$pid/stat &&
    -r $notification_proc_root/sys/kernel/random/boot_id ]] || return 1
  stat=$(<"$notification_proc_root/$pid/stat")
  stat=${stat##*) }
  read -ra stat_fields <<<"$stat"
  ((${#stat_fields[@]} >= 20)) || return 1
  start_time=${stat_fields[19]}
  [[ $start_time =~ ^[0-9]+$ ]] || return 1

  printf '%s %s-%s-%s\n' "$owner" \
    "$(<"$notification_proc_root/sys/kernel/random/boot_id")" "$pid" "$start_time"
}

send_fresh_warning() {
  local _

  # A timeout may mean Notify reached the server but its reply did not. Retrying
  # can therefore produce two ids, which the shell collapses by full content;
  # losing the only warning is worse than that short-lived duplicate.
  for _ in 1 2; do
    if timeout --kill-after=0.1s "$notification_send_timeout" \
      omarchy-notification-send -u critical -g 󰌾 -r 0 \
      "Screen did not lock before suspend" \
      "The session was left unlocked ($1)." >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

# logind suspends whether or not this wait succeeded, so a failure here means
# the machine slept with the session exposed. The notification is the only way
# anyone finds out, and it lands on the screen they unlock into.
report_unsecured_now() {
  local replaces_id=0 returned_id notification_lock_fd notification_id_tmp
  local server_owner server saved_server saved_id
  local -a bus_name_args=()

  if mkdir -p "$notification_state_dir" 2>/dev/null &&
    exec {notification_lock_fd}>"$notification_lock_file" 2>/dev/null; then
    # The 24s wait plus bounded identity lookup and fresh-warning fallback fits
    # inside the transient worker's 50s lifetime. Direct report-mode calls get
    # the same bounded wait even without systemd's outer lifetime guarantee.
    if flock -x -w "$notification_lock_timeout" -E 75 "$notification_lock_fd" 2>/dev/null; then
      if ! read -r server_owner server < <(notification_server); then
        server_owner=""
        server=""
      fi
      # A corrupt id too long for Notify's uint32 would fail every send after it.
      if [[ -n $server && -r $notification_id_file ]] &&
        read -r saved_server saved_id <"$notification_id_file" &&
        [[ $saved_server == "$server" && $saved_id =~ ^[0-9]{1,9}$ ]]; then
        replaces_id=$saved_id
      fi
      [[ -z $server_owner ]] || bus_name_args=(--bus-name "$server_owner")

      if returned_id=$(timeout --kill-after=0.1s "$notification_send_timeout" \
        omarchy-notification-send -u critical -g 󰌾 \
        "${bus_name_args[@]}" \
        -r "$replaces_id" -p \
        "Screen did not lock before suspend" \
        "The session was left unlocked ($1)." 2>/dev/null); then
        if [[ -n $server && $returned_id =~ ^[0-9]+$ ]] &&
          notification_id_tmp=$(mktemp "$notification_id_file.XXXXXX" 2>/dev/null); then
          if ! printf '%s %s\n' "$server" "$returned_id" >"$notification_id_tmp" 2>/dev/null ||
            ! mv -f "$notification_id_tmp" "$notification_id_file" 2>/dev/null; then
            rm -f "$notification_id_tmp"
          fi
        fi
      else
        # The resolved owner may have exited, or Notify may have timed out.
        # Retry fresh through the well-known name so no stale id can reach a
        # replacement server and an unlocked suspend still gets a warning.
        send_fresh_warning "$1" || true
      fi
    else
      # An unusable state lock must not suppress the warning. Avoid shared
      # replacement state because it could not be protected.
      send_fresh_warning "$1" || true
    fi
    exec {notification_lock_fd}>&-
  else
    [[ -z ${notification_lock_fd:-} ]] || exec {notification_lock_fd}>&-
    send_fresh_warning "$1" || true
  fi
}

report_unsecured() {
  local unit

  printf 'omarchy-system-sleep-lock: suspending without a secure lock (%s)\n' \
    "$1" >&2

  # Release logind's delay inhibitor immediately. The warning belongs to a
  # separate transient user service, so a slow notification server can finish
  # after resume without spending the reserve logind needs to suspend safely.
  # A reporter can spend up to 24s waiting for the state lock, then still
  # needs enough time for its bounded fresh-warning fallback (at most three
  # 5s sends plus bounded identity lookups). Give that complete path 50s;
  # if the process is actually wedged, force-kill it after a 1s stop grace.
  unit="omarchy-sleep-lock-warning-${BASHPID}-${EPOCHREALTIME//[!0-9]/}"
  if ! timeout --kill-after=0.05s 0.3s systemd-run --user --quiet --collect \
    --no-block --property=RuntimeMaxSec=50s --property=TimeoutStopSec=1s \
    --property=SendSIGKILL=yes --unit="$unit" \
    "$0" --report-unsecured "$1" >/dev/null 2>&1; then
    # If the user manager cannot queue the worker, retain one short best-effort
    # send while staying within the minimum one-second logind reserve.
    timeout --kill-after=0.05s 0.3s \
      omarchy-notification-send -u critical -g 󰌾 \
      "Screen did not lock before suspend" \
      "The session was left unlocked ($1)." >/dev/null 2>&1 || true
  fi

  exit 1
}

if [[ -n $report_mode_reason ]]; then
  report_unsecured_now "$report_mode_reason"
  exit 0
fi

# Request the lock before touching monitor state, so a stuck Hyprland IPC call
# cannot consume the window before Quickshell has begun securing the session.
request_lock
sync_clamshell

# The trailing sleep can overshoot the deadline by one interval, which is well
# inside the reserve derive_budget_ms already held back for logind.
while (( $(remaining_ms) > 0 )); do
  case $(lock_state) in
    secure) exit 0 ;;
    locking) ;;
    *) request_lock ;;
  esac

  sleep "$poll_interval"
done

report_unsecured "the shell did not secure the session within ${budget_ms}ms"

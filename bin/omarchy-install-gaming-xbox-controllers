#!/bin/bash

# omarchy:summary=Install support for using Xbox controllers with Steam/RetroArch/etc.
# omarchy:group=install
# omarchy:name=gaming xbox-controllers
# omarchy:requires-sudo=true

set -e

echo "Installing Xbox controller Bluetooth support..."

# Install xpadneo to ensure controllers work out of the box
omarchy-pkg-add xpadneo-dkms

# Prevent xpad/xpadneo driver conflict
echo blacklist xpad | sudo tee /etc/modprobe.d/blacklist-xpad.conf >/dev/null
echo hid_xpadneo | sudo tee /etc/modules-load.d/xpadneo.conf >/dev/null

# No input-group grant. systemd's 70-uaccess.rules tags every device udev
# classifies as ID_INPUT_JOYSTICK, so logind puts an ACL for the seat's active
# user on the controller itself — read and write, on that device, for as long as
# they are logged in. That is exactly what a controller needs.
#
# Membership of `input` is the blunt version of the same thing: read access to
# every /dev/input/event*, the keyboard included, permanently and for every
# session. Migration 1787865477 removed that grant from the default install
# because it let any process running as the user capture keystrokes. Re-adding
# it here would hand it back to anyone who owns a controller.
needs_reboot=false

# Swap drivers in the running kernel so a reboot isn't needed otherwise
if lsmod | grep -q '^xpad '; then
  sudo modprobe -r xpad 2>/dev/null || needs_reboot=true
fi

if $needs_reboot; then
  gum confirm "Reboot needed to finish setup. Reboot now?" && sudo reboot now
  exit 0
fi

sudo modprobe hid_xpadneo

echo ""
echo "Now you can pair your Xbox controller with Bluetooth using Super + Ctrl + B."

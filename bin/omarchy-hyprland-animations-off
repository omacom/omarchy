#!/bin/bash

# omarchy:summary=Check whether Hyprland's animations are off, by the toggle or because the session renders on the CPU
# omarchy:hidden=true

# A session that renders on the CPU turns them off by itself
# (default/hypr/software-rendering.lua) until Appearance turns them back on.
omarchy-hyprland-toggle-enabled no-animations ||
  {
    [[ -e $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/omarchy-software-rendering ]] &&
      ! omarchy-toggle-enabled animations-without-gpu
  }

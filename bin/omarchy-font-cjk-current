#!/bin/bash

# omarchy:summary=Show current CJK font variant preference
# omarchy:examples=omarchy font cjk current

# The CJK variant marker lives in conf.d/50-omarchy-cjk.conf, owned
# outright by `omarchy font cjk set`. Removing it is `cjk unset`.
cjk_file="$HOME/.config/fontconfig/conf.d/50-omarchy-cjk.conf"

if [[ ! -f "$cjk_file" ]]; then
  echo "unset"
  exit 0
fi

# The variant is read from the sans rule family (e.g. "Noto Sans CJK TC"),
# which is what fontconfig itself reads, so the answer cannot drift from
# the effective rules even if the marker comment is edited by hand.
current=$(sed -n 's/.*Noto Sans CJK \([A-Z]*\).*/\1/p' "$cjk_file" | tr '[:upper:]' '[:lower:]' | tail -n1)

if [[ -z "$current" ]]; then
  echo "unset"
else
  echo "$current"
fi

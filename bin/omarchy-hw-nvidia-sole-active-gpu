#!/bin/bash

# omarchy:summary=Print the NVIDIA DRM device path when it is the only GPU driving a display.

# On a desktop with an idle iGPU still on the PCI bus and an NVIDIA card driving
# every monitor, Aquamarine opens a DRM backend for both GPUs. That makes
# Hyprland treat the system as multi-GPU and fall back to software cursors on
# NVIDIA (hyprwm/Hyprland Monitor.cpp: shouldUseSoftwareCursors() checks
# isNvidia() && isMgpu()), which also blocks direct scanout whenever the
# cursor is visible. Pinning Aquamarine to the sole active GPU via
# AQ_DRM_DEVICES restores both.
#
# AQ_DRM_DEVICES is fixed when Hyprland starts and Aquamarine never opens the
# other GPU afterwards, so this only fires on machines that can't gain a display
# on it later: no other GPU may have an internal panel connector (eDP/LVDS/DSI)
# whatever its status (some drivers report it disconnected with the lid shut),
# nor any connected connector. A monitor plugged into the iGPU's own ports after
# login stays dark until the next logout.
#
# Read sysfs directly rather than lspci, which reads PCI config space and
# resumes a runtime-suspended GPU.

drm_path="${OMARCHY_DRM_PATH:-/sys/class/drm}"

shopt -s nullglob

nvidia_cards=()
other_cards=()

for card in "$drm_path"/card[0-9]*; do
  # The glob above also matches connector directories like card0-DP-1; keep
  # only the GPU device nodes themselves.
  [[ $card =~ /card[0-9]+$ ]] || continue
  vendor_file="$card/device/vendor"
  if [[ -f $vendor_file ]] && [[ $(< "$vendor_file") == "0x10de" ]]; then
    nvidia_cards+=("$card")
  else
    # No vendor file (e.g. a USB/DisplayLink GPU) can't be confirmed as NVIDIA,
    # so treat it as "other" rather than dropping it from both arrays — it
    # still gets checked for a connected display below.
    other_cards+=("$card")
  fi
done

# Ambiguous (no NVIDIA, or more than one) or nothing to fix (NVIDIA is already
# the only GPU, so Aquamarine only ever finds the one card).
(( ${#nvidia_cards[@]} == 1 )) || exit 1
(( ${#other_cards[@]} > 0 )) || exit 1

for other in "${other_cards[@]}"; do
  for connector in "$other"-*; do
    [[ $connector == *-eDP-* || $connector == *-LVDS-* || $connector == *-DSI-* ]] && exit 1
    [[ -e $connector/status && $(< "$connector/status") == connected ]] && exit 1
  done
done

# Pinning an NVIDIA card that drives no display would leave the session with no
# output at all, so it must have a connected connector of its own.
for connector in "${nvidia_cards[0]}"-*; do
  if [[ -e $connector/status && $(< "$connector/status") == connected ]]; then
    printf '/dev/dri/%s\n' "$(basename "${nvidia_cards[0]}")"
    exit 0
  fi
done

exit 1

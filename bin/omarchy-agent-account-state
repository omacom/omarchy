#!/usr/bin/python3
# omarchy:summary=Read and change the registry of Claude, Codex, and Grok subscription accounts
# omarchy:args=<registry|home|homes|list|refresh|begin|register|recover|use|rename|remove|mode|link|autoswitch> [provider] [args...]
# omarchy:hidden=true
"""The account registry behind `omarchy agent account`.

An account is a Claude Code, Codex, or Grok login Omarchy keeps a home for.
The login you already have stays where the CLI put it (~/.claude, ~/.codex,
~/.grok) and
is the primary account; added accounts get a home of their own under
~/.local/state/omarchy/agents/accounts/<provider>/<id>/ that holds only that
account's credentials and links everything else back to the primary home, so
conversation history, settings and skills stay one set across accounts.

Each provider's registry is one JSON file beside those homes. It records which
account is active — the one new sessions start as — how switching happens, and
display-safe identity. Tokens never enter it and never leave this process.
"""

from __future__ import annotations

import base64
import datetime as dt
import fcntl
import json
import os
import pty
import re
import select
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

PROVIDERS = {
  "claude": {
    "name": "Claude",
    "home_env": "CLAUDE_CONFIG_DIR",
    # Everything a session reads or writes that isn't tied to the login. A
    # missing directory is created in the primary home first; a missing file
    # is linked anyway, so whichever account writes it first writes it there.
    "shared_dirs": ["projects", "skills", "agents", "commands", "plugins", "hooks", "themes", "output-styles", "file-history", "todos", "plans"],
    "shared_files": ["settings.json", "CLAUDE.md", "history.jsonl", "keybindings.json"],
    # Keys copied from the primary's ~/.claude.json into a new account's, so a
    # second login keeps MCP servers, folder trust and onboarding choices.
    "carried_keys": ["mcpServers", "projects", "theme", "hasCompletedOnboarding", "lastOnboardingVersion", "editorMode"],
  },
  "codex": {
    "name": "Codex",
    "home_env": "CODEX_HOME",
    "shared_dirs": ["sessions", "archived_sessions", "prompts", "skills", "rules", "plugins"],
    "shared_files": ["config.toml", "AGENTS.md", "history.jsonl", "hooks.json"],
    "carried_keys": [],
  },
  "grok": {
    "name": "Grok",
    "home_env": "GROK_HOME",
    "shared_dirs": ["sessions", "skills", "agents", "plugins", "installed-plugins", "marketplace-cache", "hooks", "memory", "memory-v2", "rules", "commands", "workflows", "personas", "worktrees"],
    "shared_files": ["config.toml", "AGENTS.md", "settings.json", "lsp.json", "pager.toml", "sandbox.toml", "trusted_folders.toml", "statusline.sh", "worktrees.db"],
    "carried_keys": [],
  },
  "agy": {
    "name": "Antigravity",
    "home_env": "AGY_DIR",
    "shared_dirs": ["conversations", "brain", "cache", "mcp", "bin", "builtin", "knowledge", "plugin_data", "presence"],
    "shared_files": ["history.jsonl", "conversation_summaries.db", "conversation_summaries.db-shm", "conversation_summaries.db-wal", "settings.json", "installation_id"],
    "carried_keys": [],
  },
}

DEFAULT_THRESHOLD = 95
# Ids an account can't take because something else already answers to them:
# `use next` cycles, a provider name is read as the provider when it comes
# first, and the menu's Add Account row is `.add`.
RESERVED_IDS = {"next", "add", "claude", "codex", "grok", "agy", "primary"}
SWITCH_MODES = ("manual", "auto")
LOGIN_RECEIPT = ".omarchy-login.json"


class AccountError(Exception):
  pass


# ------------------------------------------------------------------- paths


def state_root() -> Path:
  return Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "omarchy" / "agents"


def accounts_root() -> Path:
  return state_root() / "accounts"


def registry_path(provider: str) -> Path:
  return accounts_root() / f"{provider}.json"


def usage_record_path(provider: str) -> Path:
  return state_root() / "usage" / f"{provider}.json"


# The primary home is where the CLI keeps a login when nothing tells it
# otherwise. It is deliberately not read from CLAUDE_CONFIG_DIR / CODEX_HOME /
# GROK_HOME / AGY_DIR:
# those are how an added account is selected, so honoring them here would make
# whichever account launched this command look like the primary.
def primary_home(provider: str) -> Path:
  if provider == "agy":
    return Path.home() / ".gemini" / "antigravity-cli"
  return Path.home() / f".{provider}"


def account_home(provider: str, account: dict[str, Any]) -> Path:
  home = str(account.get("home") or "")
  return Path(home) if home else primary_home(provider)


# Claude keeps its account file beside the config dir for the default home
# (~/.claude.json) and inside it for any other.
def claude_account_file(home: Path) -> Path:
  if home == primary_home("claude"):
    return Path.home() / ".claude.json"
  return home / ".claude.json"


# --------------------------------------------------------------- identity


def read_json(path: Path) -> Any:
  try:
    return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None


def plan_label(tier: str, subscription: str) -> str:
  match = re.search(r"max_(\d+x)", tier or "", re.IGNORECASE)
  if match:
    return "Max " + match.group(1)
  if subscription:
    return subscription[0].upper() + subscription[1:]
  return ""


def jwt_claims(token: str) -> dict[str, Any]:
  try:
    payload = token.split(".")[1]
    payload += "=" * (-len(payload) % 4)
    claims = json.loads(base64.urlsafe_b64decode(payload.encode("ascii")))
    return claims if isinstance(claims, dict) else {}
  except Exception:
    return {}


# Who a home is signed in as, from files the CLI wrote at login. Only
# display-safe fields come out; an empty accountId means nobody is signed in.
def identity(provider: str, home: Path) -> dict[str, str]:
  if provider == "claude":
    account = (read_json(claude_account_file(home)) or {}).get("oauthAccount") or {}
    login = (read_json(home / ".credentials.json") or {}).get("claudeAiOauth") or {}
    return {
      "accountId": str(account.get("accountUuid") or ""),
      "email": str(account.get("emailAddress") or ""),
      "org": str(account.get("organizationName") or ""),
      "plan": plan_label(str(login.get("rateLimitTier") or ""), str(login.get("subscriptionType") or "")),
    }

  if provider == "grok":
    return grok_identity(home)

  if provider == "agy":
    return agy_identity(home)

  auth = read_json(home / "auth.json") or {}
  tokens = auth.get("tokens") or {}
  claims = jwt_claims(str(tokens.get("id_token") or ""))
  openai = claims.get("https://api.openai.com/auth") or {}
  plan = str(openai.get("chatgpt_plan_type") or "")
  return {
    "accountId": str(tokens.get("account_id") or openai.get("chatgpt_account_id") or ""),
    "email": str(claims.get("email") or ""),
    "org": "",
    "plan": plan[0].upper() + plan[1:] if plan else "",
  }


# Grok keeps one login per issuer in auth.json, and the plan only in the
# settings it caches from xAI, as a JSON string inside that file.
def grok_identity(home: Path) -> dict[str, str]:
  auth = read_json(home / "auth.json") or {}
  login = next((v for v in auth.values() if isinstance(v, dict)), {}) if isinstance(auth, dict) else {}
  try:
    settings = json.loads((read_json(home / "settings_cache.json") or {}).get("payload") or "{}").get("settings") or {}
  except Exception:
    settings = {}
  return {
    "accountId": str(login.get("user_id") or ""),
    "email": str(login.get("email") or ""),
    "org": "",
    "plan": str((settings if isinstance(settings, dict) else {}).get("subscription_tier_display") or ""),
  }


def email_of(id_token: Any) -> str:
  if not id_token or not isinstance(id_token, str):
    return ""
  return str(jwt_claims(id_token).get("email") or "")


def agy_identity_from_data(data: dict[str, Any] | None) -> str:
  if not isinstance(data, dict):
    return ""
  token_dict = data.get("token") if isinstance(data.get("token"), dict) else {}
  return str(data.get("id_token_email") or token_dict.get("id_token_email") or email_of(data.get("id_token") or token_dict.get("id_token")) or data.get("email") or token_dict.get("email") or token_dict.get("refresh_token") or data.get("refresh_token") or "")


def agy_identity_from_token_data(data: dict[str, Any]) -> dict[str, str]:
  token_dict = data.get("token") if isinstance(data.get("token"), dict) else {}
  email = str(data.get("id_token_email") or token_dict.get("id_token_email") or email_of(data.get("id_token") or token_dict.get("id_token")) or data.get("email") or token_dict.get("email") or "")
  account_id = email or str(token_dict.get("refresh_token") or data.get("refresh_token") or "")
  auth_method = str(data.get("auth_method") or "consumer").lower()
  plan = ""
  if auth_method == "enterprise":
    plan = "Enterprise"
  elif auth_method in ("cloud", "vertex"):
    plan = "Cloud"
  return {
    "accountId": account_id,
    "email": email,
    "org": "",
    "plan": plan,
  }


def agy_identity(home: Path) -> dict[str, str]:
  data = None
  token_file = home / "antigravity-oauth-token"
  if token_file.is_file():
    data = read_json(token_file)
  if (not isinstance(data, dict) or not data) and home == primary_home("agy"):
    data = read_keyring_token()
  if not isinstance(data, dict):
    return {"accountId": "", "email": "", "org": "", "plan": ""}
  return agy_identity_from_token_data(data)


def read_keyring_token() -> dict[str, Any] | None:
  try:
    res = subprocess.run(
      ["secret-tool", "lookup", "service", "gemini", "username", "antigravity"],
      capture_output=True, text=True, timeout=3, check=False,
    )
    if res.returncode == 0 and res.stdout.strip():
      data = json.loads(res.stdout)
      return data if isinstance(data, dict) else None
  except Exception:
    pass
  return None


def write_keyring_token(data: dict[str, Any]) -> bool:
  try:
    res = subprocess.run(
      ["secret-tool", "store", "--label=Antigravity CLI OAuth", "service", "gemini", "username", "antigravity"],
      input=json.dumps(data), text=True, capture_output=True, timeout=5, check=False,
    )
    return res.returncode == 0
  except Exception:
    return False


def clear_keyring_token() -> bool:
  try:
    res = subprocess.run(
      ["secret-tool", "clear", "service", "gemini", "username", "antigravity"],
      capture_output=True, text=True, timeout=3, check=False,
    )
    return res.returncode == 0
  except Exception:
    return False


def token_expiry(data: dict[str, Any] | None) -> float:
  if not isinstance(data, dict):
    return 0.0
  token = data.get("token") if isinstance(data.get("token"), dict) else {}
  exp = token.get("expiry") or data.get("expiry")
  if exp is None:
    return 0.0
  try:
    if isinstance(exp, (int, float)):
      return float(exp)
    parsed = dt.datetime.fromisoformat(str(exp).replace("Z", "+00:00"))
    return parsed.timestamp()
  except Exception:
    return 0.0


def agy_main_token_path() -> Path:
  return accounts_root() / "agy" / ".main-token.json"


def current_primary_token(provider: str) -> dict[str, Any] | None:
  if provider != "agy":
    return None
  file_data = None
  token_file = primary_home("agy") / "antigravity-oauth-token"
  if token_file.is_file():
    file_data = read_json(token_file)
  keyring_data = read_keyring_token()
  if isinstance(file_data, dict) and isinstance(keyring_data, dict):
    return keyring_data if token_expiry(keyring_data) >= token_expiry(file_data) else file_data
  if isinstance(keyring_data, dict):
    return keyring_data
  if isinstance(file_data, dict):
    return file_data
  return None


def write_token_file(path: Path, data: dict[str, Any]) -> None:
  path.parent.mkdir(parents=True, exist_ok=True)
  fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(data, handle, indent=2)
      handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
  finally:
    Path(tmp).unlink(missing_ok=True)


def account_identity(provider: str, registry: dict[str, Any], account: dict[str, Any]) -> dict[str, str]:
  if provider == "agy" and account.get("primary") and registry.get("active") != account.get("id"):
    backup = agy_main_token_path()
    if backup.is_file():
      data = read_json(backup)
      if isinstance(data, dict):
        return agy_identity_from_token_data(data)
  return identity(provider, account_home(provider, account))


def apply_token_to_primary(provider: str, data: dict[str, Any]) -> None:
  if provider != "agy":
    return
  write_token_file(primary_home("agy") / "antigravity-oauth-token", data)
  write_keyring_token(data)


def backup_main(provider: str) -> None:
  if provider != "agy":
    return
  token = current_primary_token(provider)
  if token:
    write_token_file(agy_main_token_path(), token)


def switch_credentials(provider: str, from_account: dict[str, Any] | None, to_account: dict[str, Any]) -> None:
  if provider != "agy":
    return
  if from_account is not None:
    curr_primary = current_primary_token(provider)
    if from_account.get("primary"):
      backup_main(provider)
    else:
      from_home = account_home(provider, from_account)
      if from_home.is_dir() and curr_primary:
        from_token_file = from_home / "antigravity-oauth-token"
        saved_token = read_json(from_token_file) if from_token_file.is_file() else None
        curr_id = agy_identity_from_data(curr_primary)
        saved_id = agy_identity_from_data(saved_token) if saved_token else from_account.get("email") or from_account.get("accountId")
        if (not saved_id or curr_id == saved_id) and token_expiry(curr_primary) >= token_expiry(saved_token):
          write_token_file(from_token_file, curr_primary)

  target_token = None
  if to_account.get("primary"):
    backup_file = agy_main_token_path()
    if backup_file.is_file():
      target_token = read_json(backup_file)
    if not target_token:
      target_token = current_primary_token(provider)
  else:
    to_home = account_home(provider, to_account)
    to_token_file = to_home / "antigravity-oauth-token"
    if to_token_file.is_file():
      target_token = read_json(to_token_file)

  if target_token:
    apply_token_to_primary(provider, target_token)


def sync_credentials(provider: str) -> None:
  if provider != "agy":
    return
  with Locked(provider, save_on_exit=False) as registry:
    curr_account = active(registry)
    if curr_account.get("primary"):
      keyring_tok = read_keyring_token()
      file_tok = read_json(primary_home("agy") / "antigravity-oauth-token")
      if keyring_tok and file_tok:
        if token_expiry(keyring_tok) > token_expiry(file_tok):
          write_token_file(primary_home("agy") / "antigravity-oauth-token", keyring_tok)
        elif token_expiry(file_tok) > token_expiry(keyring_tok):
          write_keyring_token(file_tok)
      backup_main(provider)
      return

    home = account_home(provider, curr_account)
    token_file = home / "antigravity-oauth-token"
    saved_token = read_json(token_file) if token_file.is_file() else None
    curr_token = current_primary_token(provider)

    saved_exp = token_expiry(saved_token)
    curr_exp = token_expiry(curr_token)

    curr_id = agy_identity_from_data(curr_token)
    saved_id = agy_identity_from_data(saved_token) or curr_account.get("email") or curr_account.get("accountId")

    if curr_token and (not saved_id or curr_id == saved_id) and curr_exp > saved_exp:
      write_token_file(token_file, curr_token)
      apply_token_to_primary(provider, curr_token)
    elif saved_token and (saved_exp > curr_exp or curr_token != saved_token):
      apply_token_to_primary(provider, saved_token)


def make_login_browser(desktop_env: dict[str, str], status_pipe: str | None = None) -> Path:
  runtime_dir = Path(desktop_env.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
  fd, path = tempfile.mkstemp(prefix="omarchy-agy-browser-", suffix=".sh", dir=str(runtime_dir))
  with os.fdopen(fd, "w", encoding="utf-8") as handle:
    handle.write("#!/bin/bash\n")
    handle.write('url="${1:-}"\n')
    if status_pipe:
      handle.write(f'printf "URL %s\\n" "$url" >"{status_pipe}" 2>/dev/null || true\n')
    for key in ("HOME", "DBUS_SESSION_BUS_ADDRESS", "PATH", "XDG_RUNTIME_DIR", "XDG_DATA_DIRS", "XDG_CONFIG_DIRS", "XDG_CURRENT_DESKTOP"):
      val = desktop_env.get(key)
      if val:
        handle.write(f'export {key}="{val}"\n')
      else:
        handle.write(f'unset {key}\n')
    handle.write("unset AGY_DIR\n")
    handle.write("unset BROWSER\n")
    handle.write('exec omarchy-launch-browser --private "$url"\n')
  os.chmod(path, 0o755)
  return Path(path)


def run_agy_login(provider: str, pending_home: Path, events: bool = False) -> None:
  desktop_env = {
    "HOME": os.environ.get("HOME", str(Path.home())),
    "DBUS_SESSION_BUS_ADDRESS": os.environ.get("DBUS_SESSION_BUS_ADDRESS", ""),
    "PATH": os.environ.get("PATH", ""),
    "XDG_RUNTIME_DIR": os.environ.get("XDG_RUNTIME_DIR", ""),
    "XDG_DATA_DIRS": os.environ.get("XDG_DATA_DIRS", ""),
    "XDG_CONFIG_DIRS": os.environ.get("XDG_CONFIG_DIRS", ""),
    "XDG_CURRENT_DESKTOP": os.environ.get("XDG_CURRENT_DESKTOP", ""),
  }
  clean_path = ":".join(p for p in desktop_env["PATH"].split(":") if "command-wrappers" not in p)
  agy_bin = shutil.which("agy", path=clean_path) or shutil.which("agy")
  if not agy_bin:
    raise AccountError("Antigravity CLI (agy) is not installed")

  pipe_dir = Path(desktop_env.get("XDG_RUNTIME_DIR") or tempfile.gettempdir())
  pipe_path = pipe_dir / f"omarchy-agy-login-{os.getpid()}.pipe"
  try:
    os.mkfifo(str(pipe_path), 0o600)
  except OSError:
    pipe_path = None

  browser_script = make_login_browser(desktop_env, str(pipe_path) if pipe_path else None)

  child_env = dict(os.environ)
  child_env["HOME"] = str(pending_home)
  child_env["AGY_DIR"] = str(pending_home)
  child_env["DBUS_SESSION_BUS_ADDRESS"] = "unix:path=/dev/null"
  child_env["OMARCHY_AGENT_LOGIN"] = "1"
  child_env["BROWSER"] = str(browser_script)
  child_env["PATH"] = clean_path

  token_file = pending_home / "antigravity-oauth-token"
  master_fd, slave_fd = pty.openpty()

  pipe_fd = None
  if pipe_path:
    try:
      pipe_fd = os.open(str(pipe_path), os.O_RDONLY | os.O_NONBLOCK)
    except OSError:
      pipe_fd = None

  proc = None
  try:
    proc = subprocess.Popen(
      [agy_bin],
      stdin=slave_fd,
      stdout=slave_fd,
      stderr=slave_fd,
      env=child_env,
      close_fds=True,
    )
    os.close(slave_fd)
    slave_fd = -1

    prompt_sent = False
    start_time = time.time()
    url_found = ""

    flags = fcntl.fcntl(master_fd, fcntl.F_GETFL)
    fcntl.fcntl(master_fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)

    try:
      stdin_flags = fcntl.fcntl(sys.stdin.fileno(), fcntl.F_GETFL)
      fcntl.fcntl(sys.stdin.fileno(), fcntl.F_SETFL, stdin_flags | os.O_NONBLOCK)
    except OSError:
      pass

    while True:
      if token_file.is_file() and token_file.stat().st_size > 0:
        try:
          data = json.loads(token_file.read_text(encoding="utf-8"))
          if isinstance(data, dict) and (data.get("token") or data.get("access_token")):
            break
        except Exception:
          pass

      if proc.poll() is not None:
        if token_file.is_file() and token_file.stat().st_size > 0:
          break
        if proc.returncode != 0:
          raise AccountError(f"Antigravity sign-in exited with code {proc.returncode}")
        break

      rlist = [master_fd]
      if pipe_fd is not None:
        rlist.append(pipe_fd)
      if not sys.stdin.closed:
        try:
          rlist.append(sys.stdin.fileno())
        except Exception:
          pass

      readable, _, _ = select.select(rlist, [], [], 0.2)

      if pipe_fd in readable:
        try:
          pipe_chunk = os.read(pipe_fd, 4096).decode("utf-8", errors="replace")
          for line in pipe_chunk.splitlines():
            if line.startswith("URL "):
              url = line[4:].strip()
              if url and not url_found:
                url_found = url
                if events:
                  print(f"@@omarchy status Opening browser to sign in...", flush=True)
                  print(url, flush=True)
        except OSError:
          pass

      if master_fd in readable:
        try:
          chunk = os.read(master_fd, 4096).decode("utf-8", errors="replace")
          if chunk:
            url_match = re.search(r"(https://[^\s\"'>]+)", chunk)
            if url_match and not url_found:
              url_found = url_match.group(1)
              if events:
                print(f"@@omarchy status Opening browser to sign in...", flush=True)
                print(url_found, flush=True)

            if not prompt_sent and re.search(r"(sign in|continue|select|press enter)", chunk, re.IGNORECASE):
              try:
                os.write(master_fd, b"\n")
                prompt_sent = True
              except OSError:
                pass

            if events:
              clean = re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", chunk)
              code_match = re.search(r"\b([A-Z0-9]{4}-[A-Z0-9]{4})\b", clean)
              if code_match:
                print(code_match.group(1), flush=True)
            else:
              sys.stdout.write(chunk)
              sys.stdout.flush()
        except OSError:
          pass

      if not sys.stdin.closed and sys.stdin.fileno() in readable:
        try:
          user_in = os.read(sys.stdin.fileno(), 1024)
          if user_in:
            os.write(master_fd, user_in)
        except OSError:
          pass

      if time.time() - start_time > 600:
        raise AccountError("Antigravity sign-in timed out")

  finally:
    if slave_fd != -1:
      try:
        os.close(slave_fd)
      except OSError:
        pass
    try:
      os.close(master_fd)
    except OSError:
      pass
    if pipe_fd is not None:
      try:
        os.close(pipe_fd)
      except OSError:
        pass
    if pipe_path:
      pipe_path.unlink(missing_ok=True)
    browser_script.unlink(missing_ok=True)
    if proc and proc.poll() is None:
      proc.terminate()
      try:
        proc.wait(timeout=2)
      except subprocess.TimeoutExpired:
        proc.kill()


# ---------------------------------------------------------------- registry


def slug(label: str) -> str:
  return re.sub(r"[^a-z0-9]+", "-", label.lower()).strip("-")


def empty_registry(provider: str) -> dict[str, Any]:
  return {"active": "main", "switch": "manual", "threshold": DEFAULT_THRESHOLD, "alert": "", "accounts": []}


def primary_entry(provider: str) -> dict[str, Any]:
  entry = {"id": "main", "label": "Main", "home": "", "primary": True}
  entry.update(identity(provider, primary_home(provider)))
  return entry


def normalized(provider: str, data: Any) -> dict[str, Any]:
  registry = empty_registry(provider)
  if isinstance(data, dict):
    registry.update({key: data[key] for key in registry if key in data})
  accounts = [a for a in registry["accounts"] if isinstance(a, dict) and a.get("id")]
  if not any(a.get("primary") for a in accounts):
    accounts.insert(0, primary_entry(provider))
  registry["accounts"] = accounts
  if registry["switch"] not in SWITCH_MODES:
    registry["switch"] = "manual"
  try:
    registry["threshold"] = max(50, min(100, int(registry["threshold"])))
  except Exception:
    registry["threshold"] = DEFAULT_THRESHOLD
  if not find(registry, registry["active"]):
    registry["active"] = accounts[0]["id"]
  return registry


def load(provider: str) -> dict[str, Any]:
  return normalized(provider, read_json(registry_path(provider)))


def save(provider: str, registry: dict[str, Any]) -> None:
  path = registry_path(provider)
  path.parent.mkdir(parents=True, exist_ok=True)
  os.chmod(path.parent, 0o700)
  fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(registry, handle, indent=2)
      handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
  except Exception:
    Path(tmp).unlink(missing_ok=True)
    raise


# Every change is read-modify-write under one lock per provider, so the panel,
# the autoswitch run after each usage update, and a command typed at a prompt
# can't interleave and drop each other's edits.
class Locked:
  def __init__(self, provider: str, save_on_exit: bool = True):
    self.provider = provider
    self.save_on_exit = save_on_exit

  def __enter__(self) -> dict[str, Any]:
    accounts_root().mkdir(parents=True, exist_ok=True)
    self.handle = open(accounts_root() / f".{self.provider}.lock", "w")
    fcntl.flock(self.handle, fcntl.LOCK_EX)
    self.registry = load(self.provider)
    return self.registry

  def __exit__(self, kind, value, traceback) -> None:
    try:
      if kind is None and self.save_on_exit:
        save(self.provider, self.registry)
    finally:
      fcntl.flock(self.handle, fcntl.LOCK_UN)
      self.handle.close()


def find(registry: dict[str, Any], account_id: str) -> dict[str, Any] | None:
  for account in registry["accounts"]:
    if account.get("id") == account_id:
      return account
  # `primary` names the login that was there first, whatever it's called now.
  if account_id == "primary":
    for account in registry["accounts"]:
      if account.get("primary"):
        return account
  return None


def active(registry: dict[str, Any]) -> dict[str, Any]:
  return find(registry, registry["active"]) or registry["accounts"][0]


# ------------------------------------------------------------------- homes


# Lay the links that make an added account share everything but its login
# with the primary home. Safe to repeat: an existing link or real file is left
# as it is, so nothing an account wrote for itself is ever replaced.
def link_shared(provider: str, home: Path) -> None:
  spec = PROVIDERS[provider]
  primary = primary_home(provider)
  home.mkdir(parents=True, exist_ok=True)
  os.chmod(home, 0o700)
  for name in spec["shared_dirs"]:
    shared = primary / name
    # A dangling symlink is the person's own setup, such as a dotfiles link
    # whose target hasn't synced yet, so leave it for its target to appear.
    # mkdir would fail on it. A link to a file or a loop still fails here.
    if shared.is_symlink() and not shared.exists():
      try:
        shared.resolve(strict=True)
      except FileNotFoundError:
        continue
    shared.mkdir(parents=True, exist_ok=True)
  for name in spec["shared_dirs"] + spec["shared_files"]:
    target = home / name
    if target.exists() or target.is_symlink():
      continue
    target.symlink_to(primary / name)


def carry_settings(provider: str, home: Path) -> None:
  keys = PROVIDERS[provider]["carried_keys"]
  if not keys:
    return
  source = read_json(claude_account_file(primary_home(provider))) or {}
  path = claude_account_file(home)
  data = read_json(path) or {}
  for key in keys:
    if key in source and key not in data:
      data[key] = source[key]
  fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=str(path.parent))
  with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
  os.chmod(tmp, 0o600)
  os.replace(tmp, path)


# A login in progress gets a scratch home beside the real ones. Its receipt
# lets a completed login survive interruption without exposing credentials.
def process_start(pid: int) -> str:
  try:
    # The command name can contain spaces and parentheses.
    return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
  except (OSError, IndexError):
    return ""


def write_receipt(home: Path, receipt: dict[str, Any]) -> None:
  path = home / LOGIN_RECEIPT
  fd, tmp = tempfile.mkstemp(prefix=LOGIN_RECEIPT, dir=str(home))
  try:
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
      json.dump(receipt, handle)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
  finally:
    Path(tmp).unlink(missing_ok=True)


def begin(provider: str, label: str = "", owner: int = 0) -> Path:
  pending = accounts_root() / provider / ".pending"
  pending.mkdir(parents=True, exist_ok=True)
  os.chmod(pending.parent, 0o700)
  home = Path(tempfile.mkdtemp(prefix="login-", dir=str(pending)))
  try:
    link_shared(provider, home)
    write_receipt(home, {"label": label, "owner": owner, "started": process_start(owner) if owner else ""})
  except Exception:
    shutil.rmtree(home, ignore_errors=True)
    raise
  return home


def register(provider: str, label: str, pending: Path) -> dict[str, Any]:
  pending = pending.resolve()
  if pending.parent != (accounts_root() / provider / ".pending").resolve():
    raise AccountError(f"{pending} is not a pending {PROVIDERS[provider]['name']} login")

  found = identity(provider, pending)
  if not found["accountId"] or (provider == "claude" and not (read_json(pending / ".credentials.json") or {}).get("claudeAiOauth")):
    shutil.rmtree(pending, ignore_errors=True)
    raise AccountError(tr("omarchy-i18n agents.loginUnfinished", "The login didn't finish, so no account was added."))

  with Locked(provider, save_on_exit=False) as registry:
    # Each home is asked who it is now, not trusted from when it was added: a
    # `claude auth login` run by hand in ~/.claude changes the primary.
    for account in registry["accounts"]:
      account.update(account_identity(provider, registry, account))
    for account in registry["accounts"]:
      if account.get("accountId") == found["accountId"]:
        shutil.rmtree(pending, ignore_errors=True)
        if found["email"]:
          raise AccountError(tr("omarchy-i18n agents.sameAccountEmail", "That's %1 (%2). Try again, and sign in as the other account in the private window.", account["label"], found["email"]))
        raise AccountError(tr("omarchy-i18n agents.sameAccount", "That's %1 (already added). Try again, and sign in as the other account in the private window.", account["label"]))

    label = label.strip() or found["email"].split("@")[0] or "Account"
    account_id = unique_id(provider, registry, label)

    # A failed write goes back to pending for recovery. The receipt also
    # covers abrupt death between moving the home and saving the registry.
    carry_settings(provider, pending)
    home = accounts_root() / provider / account_id
    entry = {"id": account_id, "label": label, "home": str(home), "primary": False}
    entry.update(found)
    receipt = read_json(pending / LOGIN_RECEIPT) or {}
    receipt["entry"] = entry
    write_receipt(pending, receipt)
    pending.rename(home)
    registry["accounts"].append(entry)
    try:
      save(provider, registry)
    except BaseException:
      registry["accounts"].pop()
      home.rename(pending)
      raise
    (home / LOGIN_RECEIPT).unlink(missing_ok=True)
    return entry


def recover_home(provider: str, home: Path) -> dict[str, Any] | None:
  root = accounts_root() / provider
  receipt = read_json(home / LOGIN_RECEIPT)
  if not isinstance(receipt, dict):
    return None
  owner = receipt.get("owner")
  if owner and receipt.get("started") and process_start(owner) == receipt["started"]:
    return None
  # A surviving CLI may still be writing credentials after its parent died.
  if home_in_use(provider, home):
    return None
  if not identity(provider, home)["accountId"]:
    return None
  # Claude writes its identity and credentials separately. An identity
  # alone does not mean the OAuth exchange finished.
  if provider == "claude" and not (read_json(home / ".credentials.json") or {}).get("claudeAiOauth"):
    return None
  if home.parent == root / ".pending":
    try:
      return register(provider, str(receipt.get("label") or ""), home)
    except AccountError:
      # Duplicate and unfinished logins are removed by register itself.
      if home.exists():
        raise
      return None

  # A crash between moving the home and saving the registry is also
  # recoverable: the receipt holds the exact entry prepared before moving.
  with Locked(provider, save_on_exit=False) as registry:
    # Another recovery or removal may have changed the home while we waited.
    receipt = read_json(home / LOGIN_RECEIPT)
    found = identity(provider, home)
    if not home.is_dir() or not isinstance(receipt, dict) or not found["accountId"]:
      return None
    if home_in_use(provider, home):
      return None
    if any(account_home(provider, a) == home for a in registry["accounts"]):
      # A committed account may have been renamed since the crash.
      (home / LOGIN_RECEIPT).unlink(missing_ok=True)
      return None
    entry = receipt.get("entry")
    if not isinstance(entry, dict) or entry.get("home") != str(home) or entry.get("id") != home.name:
      return None
    if any(account_identity(provider, registry, a)["accountId"] == found["accountId"] for a in registry["accounts"]):
      # A retry may already have registered this login under another home.
      shutil.rmtree(home)
      return None
    if find(registry, entry["id"]) is not None:
      # Preserve the login, but choose a free name rather than blocking adds.
      entry["id"] = unique_id(provider, registry, entry["label"])
    entry.update(found)
    registry["accounts"].append(entry)
    save(provider, registry)
    (home / LOGIN_RECEIPT).unlink(missing_ok=True)
    return entry


def recover(provider: str) -> list[dict[str, Any]]:
  recovered = []
  root = accounts_root() / provider
  candidates = sorted((root / ".pending").glob("login-*")) + sorted(root.glob("*/"))
  for home in candidates:
    try:
      entry = recover_home(provider, home)
      if entry is not None:
        recovered.append(entry)
    except (AccountError, OSError) as error:
      # Keep the receipt for another attempt; one failed candidate must not
      # prevent other accounts and providers from refreshing.
      print(f"Could not recover {provider} account {home.name}: {error}", file=sys.stderr)
  return recovered


# The id an account answers to, from its label. It can't clash with another
# account, a routing keyword, or a home left under that name by an account
# that has since been renamed.
def unique_id(provider: str, registry: dict[str, Any], label: str, keep: dict[str, Any] | None = None) -> str:
  base = slug(label) or "account"
  account_id, n = base, 2
  while True:
    taken = find(registry, account_id)
    if account_id not in RESERVED_IDS and (taken is None or taken is keep):
      if keep is not None or not (accounts_root() / provider / account_id).exists():
        return account_id
    account_id, n = f"{base}-{n}", n + 1


# A new label, and the id that follows from it. The home stays where it is:
# sessions already running in it hold that path.
def rename(provider: str, target: str, label: str) -> dict[str, Any]:
  label = label.strip()
  if not label:
    raise AccountError("Give the account a name")
  with Locked(provider) as registry:
    account = find(registry, target)
    if not account:
      raise AccountError(f"No {PROVIDERS[provider]['name']} account named {target}")
    new_id = unique_id(provider, registry, label, keep=account)
    if not account.get("primary") and not account.get("home"):
      account["home"] = str(account_home(provider, account))
    if registry["active"] == account["id"]:
      registry["active"] = new_id
    registry["alert"] = ""
    account["id"] = new_id
    account["label"] = label
    return dict(account)


# Save who each home is signed in as now. A login run in a home, through the
# panel or the CLI, changes it, and the usage records take their names and
# emails from here.
def refresh(provider: str) -> None:
  recover(provider)
  with Locked(provider) as registry:
    for account in registry["accounts"]:
      account.update(account_identity(provider, registry, account))


def use(provider: str, target: str) -> tuple[dict[str, Any], dict[str, Any]]:
  with Locked(provider) as registry:
    previous = active(registry)
    if target == "next":
      ids = [a["id"] for a in registry["accounts"]]
      target = ids[(ids.index(previous["id"]) + 1) % len(ids)]
    account = find(registry, target)
    if not account:
      raise AccountError(f"No {PROVIDERS[provider]['name']} account named {target}")
    registry["active"] = account["id"]
    registry["alert"] = ""
    if not account.get("primary"):
      link_shared(provider, account_home(provider, account))
    if provider == "agy":
      switch_credentials(provider, previous, account)
    return previous, account


# Whether a running session was started in this home. Removing it would pull
# the login out from under that session, which must never be touched.
def home_in_use(provider: str, home: Path) -> bool:
  wanted = f"{PROVIDERS[provider]['home_env']}=".encode()
  resolved = home.resolve()
  for environ in Path("/proc").glob("[0-9]*/environ"):
    try:
      entries = environ.read_bytes().split(b"\0")
    except OSError:
      continue
    for entry in entries:
      if entry.startswith(wanted) and Path(entry[len(wanted):].decode(errors="replace")).resolve() == resolved:
        return True
  return False


def remove(provider: str, target: str) -> dict[str, Any]:
  with Locked(provider) as registry:
    account = find(registry, target)
    if not account:
      raise AccountError(f"No {PROVIDERS[provider]['name']} account named {target}")
    if account.get("primary"):
      raise AccountError(f"{account['label']} is the login in {primary_home(provider)}; it can't be removed here.")
    home = account_home(provider, account)
    if home_in_use(provider, home):
      raise AccountError(f"A running {PROVIDERS[provider]['name']} session uses {account['label']}. Quit it first, then remove the account.")
    was_active = registry["active"] == account["id"]
    registry["accounts"] = [a for a in registry["accounts"] if a["id"] != account["id"]]
    if was_active:
      registry["active"] = registry["accounts"][0]["id"]
      if provider == "agy":
        switch_credentials(provider, from_account=None, to_account=registry["accounts"][0])
    # Only the account's own directory goes. Its links point into the primary
    # home, and rmtree removes a link without following it.
    if home.resolve().parent == (accounts_root() / provider).resolve():
      shutil.rmtree(home, ignore_errors=True)
    return account


def set_mode(provider: str, mode: str, threshold: str | None) -> dict[str, Any]:
  if mode not in SWITCH_MODES:
    raise AccountError("Switch mode is manual or auto")
  with Locked(provider) as registry:
    registry["switch"] = mode
    if threshold is not None:
      try:
        registry["threshold"] = max(50, min(100, int(threshold)))
      except ValueError:
        raise AccountError("The threshold is a percentage between 50 and 100")
    registry["alert"] = ""
    return dict(registry)


# ------------------------------------------------------------- autoswitch


def window_open(limit: dict[str, Any], now: dt.datetime) -> bool:
  raw = str(limit.get("resetsAt") or "")
  if not raw:
    return True
  try:
    resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
  return resets_at > now


# How spent an account is: its fullest window that hasn't reset yet, in
# percent. A window whose reset has passed counts as empty even when the
# numbers are stale, since that's exactly what a reset means. None when
# nothing is known at all.
def peak(limits: Any, now: dt.datetime) -> float | None:
  if not isinstance(limits, list):
    return None
  known = [l for l in limits if isinstance(l, dict) and isinstance(l.get("percent"), (int, float))]
  if not known:
    return None
  primary_known = [l for l in known if not l.get("auxiliary") and not str(l.get("label", "")).startswith("Claude/GPT")]
  candidates = primary_known if primary_known else known
  open_windows = [float(l["percent"]) * 100 for l in candidates if window_open(l, now)]
  return max(open_windows) if open_windows else 0.0


def next_reset(limits: Any, now: dt.datetime) -> dt.datetime | None:
  times = []
  for limit in limits if isinstance(limits, list) else []:
    try:
      when = dt.datetime.fromisoformat(str(limit.get("resetsAt") or "").replace("Z", "+00:00"))
    except Exception:
      continue
    if when.tzinfo is None:
      when = when.replace(tzinfo=dt.timezone.utc)
    if when > now:
      times.append(when)
  return min(times) if times else None


# When an account over the threshold drops back under it: once every window
# holding it there has reset, which is the latest of those resets. A 10%
# session resetting in an hour doesn't help an account whose weekly window is
# full for six more days. None when a blocking window never says.
def available_at(limits: Any, threshold: float, now: dt.datetime) -> dt.datetime | None:
  latest = None
  known = [l for l in limits if isinstance(l, dict) and isinstance(l.get("percent"), (int, float))] if isinstance(limits, list) else []
  primary_known = [l for l in known if not l.get("auxiliary") and not str(l.get("label", "")).startswith("Claude/GPT")]
  candidates = primary_known if primary_known else known
  for limit in candidates:
    if float(limit["percent"]) * 100 < threshold or not window_open(limit, now):
      continue
    try:
      when = dt.datetime.fromisoformat(str(limit.get("resetsAt") or "").replace("Z", "+00:00"))
    except Exception:
      return None
    if when.tzinfo is None:
      when = when.replace(tzinfo=dt.timezone.utc)
    latest = when if latest is None or when > latest else latest
  return latest


def duration(delta: dt.timedelta) -> str:
  minutes = max(1, int(delta.total_seconds() // 60))
  hours, minutes = divmod(minutes, 60)
  days, hours = divmod(hours, 24)
  if days:
    return tr("omarchy-i18n agents.durationDaysHours", "%1d %2h", days, hours)
  if hours:
    return tr("omarchy-i18n battery.durationHoursMinutes", "%1h %2m", hours, minutes)
  return tr("omarchy-i18n battery.durationMinutes", "%1m", minutes)


# The whole switching policy, with no I/O: given the registry and the per
# account limits from the usage record, what should happen. Returns None when
# nothing should, or {"action": "switch"|"notify"|"exhausted", ...}.
#
# Only the active account crossing the threshold starts anything, so auto
# mode never flaps back to an account that just reset. `alert` remembers the
# last thing said, so a shell restart or the next refresh doesn't repeat it.
#
# Numbers kept from an earlier check may be out of date, but a parked account's
# sign-in lapses within hours and can't be checked again until a session runs
# in it. So a stale account is still a candidate: among accounts with room, one
# checked just now wins, but room comes first. An account within 15 points of
# the threshold (where the panel starts checking more often) is near its limit
# however fresh its numbers are.
def decide(registry: dict[str, Any], usage: dict[str, Any], now: dt.datetime, stale: frozenset[str] = frozenset()) -> dict[str, Any] | None:
  threshold = float(registry["threshold"])
  current = active(registry)
  current_peak = peak(usage.get(current["id"]), now)
  if current_peak is None or current_peak < threshold:
    return {"action": "clear"} if registry.get("alert") else None

  candidates = []
  for account in registry["accounts"]:
    if account["id"] == current["id"]:
      continue
    level = peak(usage.get(account["id"]), now)
    if level is None or level >= threshold:
      continue
    reset = next_reset(usage.get(account["id"]), now) or dt.datetime.max.replace(tzinfo=dt.timezone.utc)
    candidates.append((level >= threshold - 15, account["id"] in stale, level, reset, account))
  candidates.sort(key=lambda c: c[:4])

  if candidates:
    _, _, level, _, target = candidates[0]
    action = "switch" if registry["switch"] == "auto" else "notify"
    alert = f"{action}:{current['id']}:{target['id']}"
    if registry.get("alert") == alert:
      return None
    return {"action": action, "alert": alert, "from": current, "to": target, "fromPeak": current_peak, "toPeak": level}

  alert = f"exhausted:{current['id']}"
  if registry.get("alert") == alert or len(registry["accounts"]) < 2:
    return None
  # Only when every account is known to be over. One that's signed out or
  # couldn't be checked might have room, so there's nothing honest to say.
  if any(peak(usage.get(a["id"]), now) is None for a in registry["accounts"]):
    return None
  soonest = None
  for account in registry["accounts"]:
    reset = available_at(usage.get(account["id"]), threshold, now)
    if reset and (soonest is None or reset < soonest[0]):
      soonest = (reset, account)
  return {"action": "exhausted", "alert": alert, "from": current, "fromPeak": current_peak, "soonest": soonest}


# Limits per account id. An account nobody is signed in to is left out, so it
# is never a candidate: its cached headroom is no use to a session that can't
# start. One whose token merely expired stays in, since a session refreshes it.
def usage_by_account(provider: str) -> tuple[dict[str, Any], frozenset[str]]:
  record = read_json(usage_record_path(provider)) or {}
  accounts = [
    a for a in record.get("accounts") or []
    if isinstance(a, dict) and a.get("id") and a.get("usageStatusText") != "Waiting for auth"
  ]
  return (
    {str(a["id"]): a.get("limits") for a in accounts},
    frozenset(str(a["id"]) for a in accounts if a.get("stale") is True),
  )


# What a person reads, in the Omarchy language. Each lookup is written as
# "omarchy-i18n <key>", the form the catalog check finds references by, and
# carries its English, which stands in when the lookup can't run (as in tests
# that leave OMARCHY_PATH unset) or the key isn't in the catalog yet.
def tr(lookup: str, english: str, *args: Any) -> str:
  key = lookup.split()[1]
  values = [str(arg) for arg in args]
  try:
    text = subprocess.run(["omarchy-i18n", key, *values], capture_output=True, text=True, check=True).stdout
  except (OSError, subprocess.CalledProcessError):
    text = ""
  if not text or text == key:
    text = english
    for index in range(len(values), 0, -1):
      text = text.replace(f"%{index}", values[index - 1])
  return text


def notify(title: str, body: str, action: list[str] | None = None) -> None:
  command = ["omarchy-notification-send", "--app-name", "Omarchy Agents", "-g", "󰚩", title, body]
  if action:
    command += ["--exec"] + action
  subprocess.run(command, check=False)


# Returns True when the active account changed.
def autoswitch(provider: str, now: dt.datetime | None = None) -> bool:
  now = now or dt.datetime.now(dt.timezone.utc)
  name = PROVIDERS[provider]["name"]
  with Locked(provider) as registry:
    if len(registry["accounts"]) < 2:
      return False
    usage, stale = usage_by_account(provider)
    decision = decide(registry, usage, now, stale)
    if decision is None:
      return False
    if decision["action"] == "clear":
      registry["alert"] = ""
      return False

    registry["alert"] = decision["alert"]
    source = decision["from"]
    threshold = registry["threshold"]
    if decision["action"] == "exhausted":
      soonest = decision["soonest"]
      if soonest:
        body = tr("omarchy-i18n agents.stayingOnUntil", "Staying on %1. %2 resets in %3.", source["label"], soonest[1]["label"], duration(soonest[0] - now))
      else:
        body = tr("omarchy-i18n agents.stayingOn", "Staying on %1.", source["label"])
      notify(tr("omarchy-i18n agents.allOver", "All %1 accounts are over %2%", name, threshold), body)
      return False

    target = decision["to"]
    headline = tr("omarchy-i18n agents.atLimit", "%1 is at %2% of a %3 limit", source["label"], round(decision["fromPeak"]), name)
    if decision["action"] == "switch":
      registry["active"] = target["id"]
      if not target.get("primary"):
        link_shared(provider, account_home(provider, target))
      if provider == "agy":
        switch_credentials(provider, source, target)
      notify(headline, tr("omarchy-i18n agents.switchedBody", "New %1 sessions now use %2 (%3%).\nRunning sessions stay on %4.", name, target["label"], round(decision["toPeak"]), source["label"]))
      return True
    notify(
      headline,
      tr("omarchy-i18n agents.offerSwitch", "%1 is at %2%. Click to switch new sessions to it.", target["label"], round(decision["toPeak"])),
      ["omarchy-agent-account-use", provider, target["id"]],
    )
    return False


# --------------------------------------------------------------------- CLI


def provider_arg(args: list[str]) -> str:
  if not args or args[0] not in PROVIDERS:
    raise AccountError("Name a provider: claude, codex, grok, or agy")
  return args[0]


def summary(provider: str, registry: dict[str, Any]) -> dict[str, Any]:
  # Identity is re-read from each home rather than trusted from the registry:
  # a `claude auth login` run by hand in a home changes who it is.
  for account in registry["accounts"]:
    account.update(account_identity(provider, registry, account))
  return {
    "provider": provider,
    "name": PROVIDERS[provider]["name"],
    "active": registry["active"],
    "switch": registry["switch"],
    "threshold": registry["threshold"],
    "accounts": [
      {key: account.get(key, "") for key in ("id", "label", "email", "org", "plan", "primary")}
      | {
        "home": str(account_home(provider, account)),
        "active": account["id"] == registry["active"],
        "signedIn": bool(account.get("accountId")),
      }
      for account in registry["accounts"]
    ],
  }


def main(argv: list[str]) -> int:
  if not argv:
    print(__doc__.strip().splitlines()[0], file=sys.stderr)
    return 1
  command, args = argv[0], argv[1:]
  try:
    if command == "registry":
      provider = provider_arg(args)
      print(json.dumps(summary(provider, load(provider))))
    elif command == "list":
      providers = [provider_arg(args)] if args else list(PROVIDERS)
      print(json.dumps([summary(p, load(p)) for p in providers]))
    elif command == "home":
      # Empty for the primary, so launching it needs no environment at all.
      provider = provider_arg(args)
      registry = read_json(registry_path(provider))
      if registry:
        account = active(normalized(provider, registry))
        if not account.get("primary"):
          print(account_home(provider, account))
    elif command == "homes":
      provider = provider_arg(args)
      registry = load(provider)
      for account in registry["accounts"]:
        print("\t".join([
          account["id"],
          str(account_home(provider, account)),
          "1" if account["id"] == registry["active"] else "0",
          "1" if account.get("primary") else "0",
        ]))
    elif command == "login":
      provider = provider_arg(args)
      if len(args) < 2:
        raise AccountError("login <provider> <pending-home> [--events]")
      home = Path(args[1])
      events = "--events" in args[2:]
      if provider == "agy":
        run_agy_login(provider, home, events)
      print(home)
    elif command == "backup-main":
      provider = provider_arg(args)
      if provider == "agy":
        with Locked(provider, save_on_exit=False):
          backup_main(provider)
    elif command == "sync":
      provider = provider_arg(args)
      if provider == "agy":
        sync_credentials(provider)
    elif command == "refresh":
      for provider in ([provider_arg(args)] if args else list(PROVIDERS)):
        if registry_path(provider).exists() or (accounts_root() / provider).is_dir():
          refresh(provider)
    elif command == "begin":
      print(begin(provider_arg(args), args[1] if len(args) > 1 else "", int(args[2]) if len(args) > 2 else 0))
    elif command == "recover":
      print(json.dumps(recover(provider_arg(args))))
    elif command == "register":
      provider = provider_arg(args)
      if len(args) < 3:
        raise AccountError("register <provider> <label> <pending-home>")
      print(json.dumps(register(provider, args[1], Path(args[2]))))
    elif command == "use":
      provider = provider_arg(args)
      previous, account = use(provider, args[1] if len(args) > 1 else "next")
      print(json.dumps({"previous": previous, "active": account}))
    elif command == "remove":
      provider = provider_arg(args)
      if len(args) < 2:
        raise AccountError("remove <provider> <account>")
      print(json.dumps(remove(provider, args[1])))
    elif command == "rename":
      provider = provider_arg(args)
      if len(args) < 3:
        raise AccountError("rename <provider> <account> <label>")
      print(json.dumps(rename(provider, args[1], " ".join(args[2:]))))
    elif command == "mode":
      provider = provider_arg(args)
      if len(args) < 2:
        raise AccountError("mode <provider> <manual|auto> [threshold]")
      set_mode(provider, args[1], args[2] if len(args) > 2 else None)
    elif command == "link":
      provider = provider_arg(args)
      link_shared(provider, Path(args[1]))
    elif command == "autoswitch":
      # Prints each provider whose active account changed, so the caller
      # knows which usage records to collect again.
      for provider in ([provider_arg(args)] if args else list(PROVIDERS)):
        if registry_path(provider).exists() and autoswitch(provider):
          print(provider)
    else:
      raise AccountError(f"Unknown command: {command}")
  except (AccountError, OSError) as error:
    print(error, file=sys.stderr)
    return 1
  return 0


if __name__ == "__main__":
  raise SystemExit(main(sys.argv[1:]))

#!/bin/bash

# omarchy:summary=Set and launch the default coding agent
# omarchy:args=[harness]
# omarchy:examples=omarchy default agent | omarchy default agent acme-agent

set -euo pipefail

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi
agent_file="$HOME/.config/omarchy/defaults/agent"

if (($# == 0)); then
  [[ -f $agent_file ]] && cat "$agent_file"
  exit 0
fi

selection=$1
harness=$(omarchy-agent-catalog | jq -cer --arg selection "$selection" '.[] | select(.id == $selection or ((.aliases // []) | index($selection)))' | head -n1) || {
  echo "Usage: omarchy-default-agent <harness>" >&2
  echo "Unknown coding-agent harness: $selection" >&2
  echo "Install its integration with: omarchy plugin add <git-url>" >&2
  exit 1
}
id=$(jq -r '.id' <<<"$harness")
name=$(jq -r '.name' <<<"$harness")
agent=$(jq -r '.install.command' <<<"$harness")
agent_package=$(jq -r '.install.package // empty' <<<"$harness")
# Only a harness declared as an installer may run one; a third-party harness
# installs through mise, whatever else its manifest carries.
agent_installer=$(jq -r 'if .install.type == "installer" then (.install.installer // empty) else empty end' <<<"$harness")
# Omarchy declares a tool that takes backend options under its bare name, with
# the options inside the declaration's table, because mise drops bracket options
# from a table-valued key. The bracketed package is only for the user's config.
agent_tool=$(jq -r 'if .firstParty then (.install.tool // empty) else empty end' <<<"$harness")
agent_tool=${agent_tool:-$agent_package}
agent_prereleases=$(jq -r 'if .firstParty then (.install.prereleases // false) else false end' <<<"$harness")

# Hermes and OpenClaw are not mise tools: each is installed and managed by its
# dedicated integration. Their installers follow the same --check/--now
# contract mise-backed agents get from mise.
if [[ -n $agent_installer ]]; then
  # Not omarchy-cmd-present: a command on PATH says nothing about whether the
  # install behind it finished or runs the sessions omarchy-agent starts.
  # Treating it as installed would skip the floating terminal and run a
  # minutes-long install inside the menu action instead.
  agent_present() { "$agent_installer" --check; }
  agent_install() { "$agent_installer" --now; }
else
  # omarchy-mise-install's wrappers run `mise use` and `mise x`, current ones on
  # lines of their own and older ones after an inline variable; either way
  # running one installs the tool it wraps. A symlink is the user's own install.
  mise_wrapper() {
    [[ ! -L $1 ]] && head -c 4096 "$1" | grep -qaE 'mise (use|x) '
  }

  # Anything at the wrapper's path other than the wrapper is the user's own
  # install, such as the symlink Cursor's installer leaves. A mise copy would
  # only shadow it, since the mise shims precede ~/.local/bin on PATH.
  user_install() {
    [[ -x $HOME/.local/bin/$agent ]] && ! mise_wrapper "$HOME/.local/bin/$agent"
  }
  agent_present() { user_install || mise where "$agent_tool" &>/dev/null; }
  # Omarchy declares the default agents as mise tools, so installing one is
  # enough and leaves the user's config alone. A user who removed the
  # preinstalls, like one without Omarchy's declarations, selects it instead.
  # An npm-backed agent needs node, itself a lazy tool where Omarchy declares
  # it, and mise won't install it as the agent's dependency while it's missing.
  npm_backed() {
    [[ $1 == npm:* || $(mise tool "${1%%\[*}" --backend 2>/dev/null) == npm:* ]]
  }
  agent_install() {
    user_install && return
    if omarchy-mise-default-tools declares "$agent_tool"; then
      if npm_backed "$agent_tool"; then
        mise install node "$agent_tool"
      else
        mise install "$agent_tool"
      fi
    else
      if npm_backed "$agent_package" && ! mise where node &>/dev/null; then
        mise install node || return 1
      fi
      if [[ $agent_prereleases == "true" ]]; then
        MISE_PRERELEASES=true mise use -g "$agent_package"
      else
        mise use -g "$agent_package"
      fi
    fi
  }
fi

if [[ $installing == "false" ]] && ! agent_present; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-default-agent --install "$id"
fi

if ! agent_install; then
  if [[ $installing == "true" && -n $agent_installer ]]; then
    echo "Could not install $name" >&2
  elif [[ $installing == "true" ]]; then
    echo "Could not install $name with mise" >&2
  else
    echo "Could not set $name as the default coding agent" >&2
  fi
  exit 1
fi

if [[ $agent == "claude" ]]; then
  omarchy-install-chromium-claude 2>/dev/null || true
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' "$id" >"$agent_file"
if [[ $installing == "true" ]]; then
  # The installer's own window: the nearest ancestor Hyprland knows as a client.
  # Every probe here is best-effort — an unknown window only means the agent
  # opens inline as it would outside the console — so none may end the launch
  # under this script's `set -e` when Hyprland IPC or a process lookup fails.
  installer=""
  clients=$(hyprctl clients -j 2>/dev/null || true)
  pid=$PPID
  while [[ -n $clients && -z $installer ]] && (( pid > 1 )); do
    installer=$(jq -r --argjson pid "$pid" '.[]? | select(.pid == $pid) | "\(.address) \(.workspace.name)"' <<<"$clients" 2>/dev/null || true)
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null || true)
  done

  # A terminal that serves every window from one process (foot's server, a
  # single-instance Ghostty or Kitty) matches them all. A title only this
  # window carries picks it out. Terminals apply a title on their next frame,
  # so give it a moment; if it never shows, the installer stays unknown and the
  # agent opens here as it would outside the console.
  if [[ $installer == *$'\n'* ]]; then
    title="omarchy-default-agent-$$"
    printf '\033]2;%s\007' "$title"
    installer=""
    for _ in {1..20}; do
      installer=$(hyprctl clients -j 2>/dev/null | jq -r --arg title "$title" '[.[]? | select(.title == $title)][0] // empty | "\(.address) \(.workspace.name)"' 2>/dev/null || true)
      [[ -n $installer ]] && break
      sleep 0.05
    done
    printf '\033]2;Omarchy\007'
  fi
fi

# An install started from the Quake console floats only while it installs. The
# agent then takes its place in the console as the tiled window the console is
# shaped around, rather than running inline in a floating terminal over it.
if [[ $installing == "true" && ${installer#* } == "special:qconsole" ]]; then
  hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-agent --prefer-local", { workspace = "special:qconsole silent" })' >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:${installer%% *}\" })" >/dev/null 2>&1 || true
elif [[ $installing == "true" ]]; then
  printf '\033[2J\033[3J\033[H'
  exec omarchy-agent --inline
else
  exec omarchy-agent
fi
#!/bin/bash

# omarchy:summary=Enable, disable, toggle, or recover mirroring the internal display to every external monitor
# omarchy:args=<on|off|toggle|recover>

TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="$HOME/.local/state/omarchy/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

INTERNAL=$(omarchy-hyprland-monitor-laptop)
# Every active external monitor shows the internal display, as a Mac mirrors
# all its displays.
# Each name is read from its own JSON field: a name carrying a newline would
# otherwise become two array entries, and both halves would pass the guard below
# as if they were monitors.
externals_json=$(hyprctl monitors -j | jq -c '[.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name]')
external_count=$(jq 'length' <<<"$externals_json")
EXTERNALS=()
for ((i = 0; i < external_count; i++)); do
  EXTERNALS+=("$(jq -r --argjson index "$i" '.[$index]' <<<"$externals_json")")
done

on() {
  if (( ${#EXTERNALS[@]} == 0 )); then
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.noExternalForMirror)"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.noLaptopToMirror)"
    exit 1
  fi

  # The names are written into generated Lua below, so only plain connector
  # names may pass; a user-created headless output can carry any name.
  for output in "$INTERNAL" "${EXTERNALS[@]}"; do
    if [[ ! $output =~ ^[A-Za-z0-9._-]+$ ]]; then
      omarchy-notification-send -g 󰍹 "$(omarchy-i18n monitor.unsafeName)"
      exit 1
    fi
  done

  omarchy-hyprland-toggle $DISABLE_TOGGLE off

  if omarchy-hyprland-toggle-disabled $TOGGLE; then
    for external in "${EXTERNALS[@]}"; do
      printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$external" "$INTERNAL"
    done >"$TOGGLE_FLAG"
    omarchy-restart-hyprctl
  fi
}

off() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
  fi
}

toggle() {
  if omarchy-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! omarchy-hyprland-monitor-external-active && omarchy-hyprland-toggle-enabled $TOGGLE; then
    omarchy-hyprland-toggle $TOGGLE off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac

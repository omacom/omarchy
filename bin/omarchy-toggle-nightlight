#!/bin/bash

# omarchy:summary=Toggle nightlight screen temperature
# omarchy:args=[--status|--setup|--reset]
# omarchy:examples=omarchy toggle nightlight | omarchy toggle nightlight --setup
#
# Bare invocation flips day/night temperature on the running hyprsunset.
# --setup writes sunrise/sunset profiles for your location to
# ~/.config/hypr/hyprsunset.conf and starts hyprsunset at login. The times are
# fixed on the day it runs, so run it again to follow the seasons. --reset
# returns to Omarchy's default of no automatic tint.

ON_TEMP=4000
OFF_TEMP=6500
IDENTITY_TEMP=6000

NL_LOC_FILE="$HOME/.local/state/omarchy/settings/weather.json"
NL_CONF="$HOME/.config/hypr/hyprsunset.conf"
NL_AUTOSTART="$HOME/.config/hypr/autostart.lua"
NL_MARK="omarchy toggle nightlight --setup"
NL_COORD='^-?[0-9]+(\.[0-9]+)?$'

current_temp() {
  local output

  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  grep -oE '[0-9]+' <<<"$output" | head -n1
}

status_json() {
  local temp enabled

  temp=$(current_temp)
  if [[ -n $temp ]] && (( temp < IDENTITY_TEMP )); then
    enabled=true
  else
    enabled=false
  fi

  jq -cn --argjson enabled "$enabled" --arg temp "$temp" \
    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
}

# Print "<name>\t<lat>\t<lon>" for the weather location: the stored coordinates
# when there are any, otherwise wttr.in's match for the stored name, or for this
# IP address when nothing is stored. One request, as omarchy-weather-icon makes.
nl_resolve_location() {
  local name="" lat="" lon="" query="" resp

  if [[ -s $NL_LOC_FILE ]]; then
    name=$(jq -r '.name // "" | if type == "string" then . else "" end' "$NL_LOC_FILE" 2>/dev/null)
    lat=$(jq -r '.latitude // "" | tostring' "$NL_LOC_FILE" 2>/dev/null)
    lon=$(jq -r '.longitude // "" | tostring' "$NL_LOC_FILE" 2>/dev/null)
  fi

  if [[ ! $lat =~ $NL_COORD || ! $lon =~ $NL_COORD ]]; then
    [[ -n $name ]] && query=$(jq -rn --arg name "$name" '$name | @uri')
    resp=$(curl -fsS --max-time 6 "https://wttr.in/${query}?format=j1" 2>/dev/null) || return 1
    IFS=$'\t' read -r lat lon < <(jq -r '.nearest_area[0] | [.latitude, .longitude] | @tsv' <<<"$resp" 2>/dev/null)
    [[ -n $name ]] || name=$(jq -r '.nearest_area[0].areaName[0].value // empty' <<<"$resp" 2>/dev/null)
  fi

  [[ $lat =~ $NL_COORD && $lon =~ $NL_COORD ]] || return 1
  name=${name//[[:cntrl:]]/}
  printf '%s\t%s\t%s\n' "${name:-your location}" "$lat" "$lon"
}

# Print today's "<sunrise> <sunset>" as machine-local HH:MM, which is what
# hyprsunset's profiles are read in. Returns 1 when the network call itself
# fails and 2 when the sun doesn't rise or set (Open-Meteo returns the same
# time twice for polar night, midnight to midnight for polar day, and null for
# either at the API's discretion — all three mean "no usable schedule").
nl_sun_times() {
  local resp times sunrise sunset

  resp=$(curl -fsS --max-time 8 "https://api.open-meteo.com/v1/forecast?latitude=$1&longitude=$2&daily=sunrise,sunset&timezone=UTC&forecast_days=1" 2>/dev/null) || return 1
  times=$(jq -r '[.daily.sunrise[0] // "", .daily.sunset[0] // ""] | @tsv' <<<"$resp" 2>/dev/null)
  [[ -n $times ]] || return 1
  IFS=$'\t' read -r sunrise sunset <<<"$times"

  # No times at all (null or empty) or both the same minute: the sun doesn't
  # rise or set at this latitude today. Distinguish "no network" (curl exited
  # non-zero above) from "API answered but has no schedule for us".
  if [[ -z $sunrise || -z $sunset ]]; then
    return 2
  fi

  # Its UTC timestamps come without a trailing Z, which date would read as local time
  sunrise=$(date -d "${sunrise}Z" +%H:%M 2>/dev/null) && sunset=$(date -d "${sunset}Z" +%H:%M 2>/dev/null) || return 1

  [[ $sunrise != "$sunset" ]] || return 2
  printf '%s %s\n' "$sunrise" "$sunset"
}

# Render the conf we would write for the given name/lat/lon/times into
# stdout. Used by setup_conf (to write the file) and nl_backup_conf (to know
# whether an existing conf still matches our last output, in which case a
# re-run is a no-op rather than a clobber). The marker embeds a hash of the
# content so a hand-edited file with the marker still gets backed up.
nl_render_conf() {
  local name=$1 lat=$2 lon=$3 sunrise=$4 sunset=$5
  local body
  body=$(cat <<EOF
# Location: $name ($lat, $lon). Undo with: omarchy toggle nightlight --reset
# These times are fixed. Run the command again to follow sunrise and sunset through the year.

profile {
    time = $sunrise
    identity = true
}

profile {
    time = $sunset
    temperature = $ON_TEMP
}
EOF
)
  printf '# Generated by %q on %s [nl-hash:%s]\n%s' \
    "$NL_MARK" "$(date -Iseconds)" \
    "$(printf '%s' "$body" | sha256sum | cut -c1-12)" \
    "$body"
}

# Keep a config the user wrote. Our own unmodified output can be replaced
# silently; anything else (a hand-edited file, the shipped default, or our
# own previous output that's been edited) gets backed up. The marker alone
# isn't enough: nl_backup_conf also verifies the body hash still matches
# the one in the marker, so a user who edits a profile time keeps the
# "Generated by" line but loses the hash match, and the next --setup
# backs up.
nl_backup_conf() {
  local existing marker_hash body_hash backup

  [[ -f $NL_CONF ]] || return 0
  cmp -s "$OMARCHY_PATH/config/hypr/hyprsunset.conf" "$NL_CONF" && return 0

  existing=$(<"$NL_CONF")
  if [[ $existing == *"# Generated by "* ]] \
     && [[ $existing =~ \[nl-hash:([a-f0-9]+)\] ]]; then
    marker_hash=${BASH_REMATCH[1]}
    body_hash=$(printf '%s' "${existing#*$'\n'}" | sha256sum | cut -c1-12)
    [[ $marker_hash == "$body_hash" ]] && return 0
  fi

  backup="$NL_CONF.bak.$(date +%s)"
  cp -f "$NL_CONF" "$backup" || return 1
  echo "Saved your existing hyprsunset.conf as $backup"
}

# Resolve a config file path to the path that should actually be written:
# the path itself if it's a regular file or doesn't exist, the target
# path if it's a symlink. Used so a symlink-managed config (Stow,
# chezmoi, etc.) keeps its link intact and the underlying file gets the
# new content.
nl_resolve_conf_target() {
  local path=$1
  if [[ -L $path ]]; then
    readlink -f "$path"
  else
    printf '%s\n' "$path"
  fi
}

nl_enable_autostart() {
  if grep -qE '^[[:space:]]*o\.launch_on_start\(.hyprsunset.)' "$NL_AUTOSTART" 2>/dev/null; then
    return 0
  fi
  [[ -s $NL_AUTOSTART && -n $(tail -c1 "$NL_AUTOSTART" 2>/dev/null) ]] && echo >>"$NL_AUTOSTART"
  printf 'o.launch_on_start("hyprsunset") -- %s\n' "$NL_MARK" >>"$NL_AUTOSTART"
}

setup_conf() {
  local loc name lat lon times sunrise sunset rc=0 new_conf tmp_conf conf_target conf_dir

  if ! loc=$(nl_resolve_location); then
    echo "Couldn't work out where you are. Set a location with: omarchy weather location --set <name> [lat,lon]" >&2
    return 1
  fi
  IFS=$'\t' read -r name lat lon <<<"$loc"

  times=$(nl_sun_times "$lat" "$lon") || rc=$?
  case $rc in
  0) ;;
  2)
    echo "There is no sunrise or sunset in $name today (polar day or night), so there is nothing to schedule." >&2
    return 1
    ;;
  *)
    echo "Couldn't get today's sunrise and sunset; check your connection and try again." >&2
    return 1
    ;;
  esac
  read -r sunrise sunset <<<"$times"

  new_conf=$(nl_render_conf "$name" "$lat" "$lon" "$sunrise" "$sunset")
  nl_backup_conf || { echo "Couldn't back up your existing hyprsunset.conf, so it was left alone." >&2; return 1; }

  # Write the conf first. If this fails, the autostart has not been
  # touched yet, so the failure is clean: nothing on disk changed,
  # and --setup can be re-run after the underlying problem is fixed.
  # The temp file is created next to the resolved target (not next
  # to NL_CONF) so a symlinked conf that crosses filesystems still
  # gets an atomic rename rather than a copy+delete fallback.
  conf_target=$(nl_resolve_conf_target "$NL_CONF")
  conf_dir=$(dirname "$conf_target")
  if ! mkdir -p "$conf_dir"; then
    echo "Couldn't create $conf_dir to write the new hyprsunset.conf." >&2
    return 1
  fi
  tmp_conf=$(mktemp "${conf_target}.XXXXXX") || { echo "Couldn't create a temp file for hyprsunset.conf." >&2; return 1; }
  if ! printf '%s' "$new_conf" >"$tmp_conf"; then
    rm -f "$tmp_conf"
    echo "Couldn't write the new hyprsunset.conf, so it was left alone." >&2
    return 1
  fi
  if ! mv -f "$tmp_conf" "$conf_target"; then
    rm -f "$tmp_conf"
    echo "Couldn't replace hyprsunset.conf with the new schedule." >&2
    return 1
  fi

  # Add the autostart line. If the conf write above succeeded but
  # this fails, the new schedule is on disk and the user just has
  # to re-run --setup to add the launch line; the next login won't
  # start hyprsunset until they do.
  if ! nl_enable_autostart; then
    echo "Wrote hyprsunset.conf, but couldn't add the autostart line; hyprsunset won't start at login. Re-run --setup to retry." >&2
    return 1
  fi

  # hyprsunset reads its profiles once at startup, so it has to restart to pick these up
  omarchy-restart-hyprsunset
  for _ in {1..10}; do
    [[ -n $(current_temp) ]] && break
    sleep 0.3
  done

  echo "Night light scheduled for $name ($lat, $lon): on at sunset ($sunset), off at sunrise ($sunrise)."
  echo "Not the right place? Pin it down with: omarchy weather location --set <name> <lat>,<lon>"
  echo "These times are fixed. Run omarchy toggle nightlight --setup again to follow the seasons."
  if [[ -z $(current_temp) ]]; then
    echo "hyprsunset didn't start just now, so the schedule begins at your next login." >&2
  fi
}

reset_conf() {
  if ! omarchy-refresh-config hypr/hyprsunset.conf; then
    echo "Couldn't restore Omarchy's stock hyprsunset.conf; the autostart line and the old schedule are left alone." >&2
    return 1
  fi

  # Remove the autostart line through any symlink so symlink-managed
  # autostart.lua gets updated in place. sed -i on the resolved path
  # would also work, but the temp-file-and-mv path keeps the same
  # atomicity guarantees as setup_conf.
  if [[ -f $NL_AUTOSTART ]] || [[ -L $NL_AUTOSTART ]]; then
    local target new_content tmp_autostart
    target=$(readlink -f "$NL_AUTOSTART" 2>/dev/null || printf '%s\n' "$NL_AUTOSTART")
    if [[ -f $target ]]; then
      new_content=$(sed "/-- $NL_MARK\$/d" "$target") || { echo "Restored the stock hyprsunset.conf, but couldn't read the autostart file." >&2; return 1; }
      tmp_autostart=$(mktemp "${target}.XXXXXX") || { echo "Restored the stock hyprsunset.conf, but couldn't write the autostart temp file." >&2; return 1; }
      if ! printf '%s\n' "$new_content" >"$tmp_autostart"; then
        rm -f "$tmp_autostart"
        echo "Restored the stock hyprsunset.conf, but couldn't write the new autostart content." >&2
        return 1
      fi
      if ! mv -f "$tmp_autostart" "$target"; then
        rm -f "$tmp_autostart"
        echo "Restored the stock hyprsunset.conf, but couldn't replace the autostart file." >&2
        return 1
      fi
    fi
  fi

  omarchy-restart-hyprsunset
  echo "Night light is back to Omarchy's default, with no automatic tint."
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

if [[ ${1:-} == "--setup" ]]; then
  setup_conf
  exit $?
fi

if [[ ${1:-} == "--reset" ]]; then
  reset_conf
  exit $?
fi

# Ensure hyprsunset is running. One a few seconds old may still be booting,
# such as one started at login, so it counts as just started too.
STARTING=false
if ! pgrep -x hyprsunset >/dev/null; then
  setsid uwsm-app -- hyprsunset &
  STARTING=true
elif (( $(ps -o etimes= -p "$(pgrep -nx hyprsunset)" 2>/dev/null || echo 0) < 3 )); then
  STARTING=true
fi

# Query the current temperature
CURRENT_TEMP=$(current_temp)

if [[ -z $CURRENT_TEMP || $CURRENT_TEMP == $OFF_TEMP ]]; then
  TARGET_TEMP=$ON_TEMP
else
  TARGET_TEMP=$OFF_TEMP
fi

# A freshly-started hyprsunset applies its default temperature at the end of
# its boot, overriding anything set before then — so resend until it sticks. One
# that has finished starting applies it at once, so it needs no wait.
for _ in {1..10}; do
  hyprctl hyprsunset temperature $TARGET_TEMP >/dev/null 2>&1
  if [[ $STARTING == "false" && $(current_temp) == "$TARGET_TEMP" ]]; then
    break
  fi
  sleep 0.2
  [[ $(current_temp) == "$TARGET_TEMP" ]] && break
done

omarchy-shell -q nightlight refresh

#!/bin/bash

# omarchy:summary=Toggle nightlight screen temperature
# omarchy:args=[--status]
# omarchy:examples=omarchy toggle nightlight

ON_TEMP=4000
OFF_TEMP=6500
IDENTITY_TEMP=6000

current_temp() {
  local output

  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  [[ $output =~ [0-9]+ ]] && printf '%s\n' "${BASH_REMATCH[0]}"
}

# hyprsunset owns its IPC socket before it answers on it, so a probe during its
# boot reads as off and sends the next toggle the wrong way. Wait for the
# daemon to answer while its process exists; with no daemon there is nothing to
# wait for, and off is the truth.
settled_temp() {
  local temp attempt

  for attempt in {1..20}; do
    temp=$(current_temp)
    if [[ -n $temp ]]; then
      printf '%s' "$temp"
      return
    fi
    pgrep -u "$UID" -x hyprsunset >/dev/null || return
    sleep 0.1
  done
}

status_json() {
  local temp enabled temp_json=null

  temp=$(settled_temp)
  if [[ -n $temp ]]; then
    temp_json=$((10#$temp))
  fi
  if [[ -n $temp ]] && (( temp_json < IDENTITY_TEMP )); then
    enabled=true
  else
    enabled=false
  fi

  printf '{"enabled":%s,"temperature":%s}\n' "$enabled" "$temp_json"
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

# Read before ensuring the daemon, so one this toggle launches counts as off
# whatever profile it boots into: with no daemon there was no tint to undo.
CURRENT_TEMP=$(settled_temp)

# Ensure hyprsunset is running. One a few seconds old may still be booting,
# such as one started at login, so it counts as just started too.
STARTING=false
if ! pgrep -x hyprsunset >/dev/null; then
  setsid uwsm-app -- hyprsunset &
  STARTING=true
elif (( $(ps -o etimes= -p "$(pgrep -nx hyprsunset)" 2>/dev/null || echo 0) < 3 )); then
  STARTING=true
fi

if [[ -n $CURRENT_TEMP ]] && (( CURRENT_TEMP < IDENTITY_TEMP )); then
  TARGET_TEMP=$OFF_TEMP
else
  TARGET_TEMP=$ON_TEMP
fi

# A freshly-started hyprsunset applies its default temperature at the end of
# its boot, overriding anything set before then — so resend until it sticks. One
# that has finished starting applies it at once, so it needs no wait.
for _ in {1..10}; do
  hyprctl hyprsunset temperature $TARGET_TEMP >/dev/null 2>&1
  if [[ $STARTING == "false" && $(current_temp) == "$TARGET_TEMP" ]]; then
    break
  fi
  sleep 0.2
  [[ $(current_temp) == "$TARGET_TEMP" ]] && break
done

# Even 6500K tints the screen, so off also resets to the identity matrix;
# hyprsunset keeps reporting 6500K, which --status reads as off
if (( TARGET_TEMP == OFF_TEMP )); then
  hyprctl hyprsunset identity >/dev/null 2>&1
fi

omarchy-shell -q nightlight refresh

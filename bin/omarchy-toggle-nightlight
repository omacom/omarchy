#!/bin/bash

# omarchy:summary=Toggle nightlight screen temperature
# omarchy:args=[--status|--schedule|--manual]
# omarchy:examples=omarchy toggle nightlight | omarchy toggle nightlight --schedule

ON_TEMP=4000
OFF_TEMP=6500
IDENTITY_TEMP=6000

current_temp() {
  local output

  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  grep -oE '[0-9]+' <<<"$output" | head -n1
}

status_json() {
  local temp enabled

  temp=$(current_temp)
  if [[ -n $temp ]] && (( temp < IDENTITY_TEMP )); then
    enabled=true
  else
    enabled=false
  fi

  jq -cn --argjson enabled "$enabled" --arg temp "$temp" \
    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
}

if [[ ${1:-} == "--status" ]]; then
  schedule=false
  omarchy-nightlight-schedule enabled && schedule=true
  status_json | jq -c --argjson scheduled "$schedule" '. + {scheduled:$scheduled}'
  exit 0
fi

if [[ ${1:-} == "--schedule" ]]; then
  schedule_result=$(omarchy-nightlight-schedule toggle) || {
    omarchy-notification-send "$(omarchy-i18n nightlight.configureFailed)"
    exit 1
  }
  if [[ $schedule_result == "enabled" ]]; then
    timezone=$(timedatectl show -p Timezone --value 2>/dev/null)
    if [[ -n $timezone ]]; then
      omarchy-notification-send "$(omarchy-i18n nightlight.followTimezone "$timezone")"
    else
      omarchy-notification-send "$(omarchy-i18n nightlight.followSelectedTimezone)"
    fi
  else
    omarchy-notification-send "$(omarchy-i18n nightlight.scheduleDisabled)"
  fi
  omarchy-shell -q nightlight refresh
  exit 0
fi

if [[ ${1:-} == "--manual" ]]; then
  if ! omarchy-nightlight-schedule disable >/dev/null; then
    omarchy-notification-send "$(omarchy-i18n nightlight.disableFailed)"
    exit 1
  fi
  omarchy-shell -q nightlight refresh
  exit 0
fi

if ! omarchy-nightlight-schedule disable >/dev/null; then
  omarchy-notification-send "$(omarchy-i18n nightlight.manualOverride)"
fi

# Ensure hyprsunset is running. One a few seconds old may still be booting,
# such as one started at login, so it counts as just started too.
STARTING=false
if ! pgrep -x hyprsunset >/dev/null; then
  setsid uwsm-app -- hyprsunset &
  STARTING=true
elif (( $(ps -o etimes= -p "$(pgrep -nx hyprsunset)" 2>/dev/null || echo 0) < 3 )); then
  STARTING=true
fi

# Query the current temperature
CURRENT_TEMP=$(current_temp)

if [[ -n $CURRENT_TEMP ]] && (( CURRENT_TEMP < IDENTITY_TEMP )); then
  TARGET_TEMP=$OFF_TEMP
else
  TARGET_TEMP=$ON_TEMP
fi

# A freshly-started hyprsunset applies its default temperature at the end of
# its boot, overriding anything set before then — so resend until it sticks. One
# that has finished starting applies it at once, so it needs no wait.
for _ in {1..10}; do
  hyprctl hyprsunset temperature $TARGET_TEMP >/dev/null 2>&1
  if [[ $STARTING == "false" && $(current_temp) == "$TARGET_TEMP" ]]; then
    break
  fi
  sleep 0.2
  [[ $(current_temp) == "$TARGET_TEMP" ]] && break
done

# Even 6500K tints the screen, so off also resets to the identity matrix;
# hyprsunset keeps reporting 6500K, which --status reads as off
if (( TARGET_TEMP == OFF_TEMP )); then
  hyprctl hyprsunset identity >/dev/null 2>&1
fi

omarchy-shell -q nightlight refresh

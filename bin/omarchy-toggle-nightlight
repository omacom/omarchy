#!/bin/bash

# omarchy:summary=Toggle nightlight screen temperature
# omarchy:args=[--status]
# omarchy:examples=omarchy toggle nightlight

ON_TEMP=4000
IDENTITY_TEMP=6000

current_temp() {
  local output

  output=$(hyprctl hyprsunset temperature 2>/dev/null) || return
  grep -oE '[0-9]+' <<<"$output" | head -n1
}

# Off is the identity matrix, which leaves the temperature where it was, so
# night light is a warm temperature with identity off.
nightlight_on() {
  local temp

  temp=$(current_temp)
  [[ -n $temp ]] && (( temp < IDENTITY_TEMP )) &&
    [[ $(hyprctl hyprsunset identity get 2>/dev/null) != "true" ]]
}

status_json() {
  local enabled=false

  nightlight_on && enabled=true

  jq -cn --argjson enabled "$enabled" --arg temp "$(current_temp)" \
    '{enabled:$enabled, temperature:(($temp | tonumber?) // null)}'
}

if [[ ${1:-} == "--status" ]]; then
  status_json
  exit 0
fi

# Ensure hyprsunset is running. One a few seconds old may still be booting,
# such as one started at login, so it counts as just started too.
STARTING=false
if ! pgrep -x hyprsunset >/dev/null; then
  setsid uwsm-app -- hyprsunset &
  STARTING=true
elif (( $(ps -o etimes= -p "$(pgrep -nx hyprsunset)" 2>/dev/null || echo 0) < 3 )); then
  STARTING=true
fi

if nightlight_on; then
  # One request, so Hyprland fades from the warm matrix straight to identity.
  # Stepping through 6500K first restarts the fade at 6500K, which snaps.
  hyprctl hyprsunset identity >/dev/null 2>&1
else
  # A freshly-started hyprsunset applies its default (identity) at the end of
  # its boot, overriding anything set before then — so resend until it sticks.
  # One that has finished starting applies it at once, so it needs no wait.
  for _ in {1..10}; do
    hyprctl hyprsunset temperature $ON_TEMP >/dev/null 2>&1
    if [[ $STARTING == "false" ]] && nightlight_on; then
      break
    fi
    sleep 0.2
    nightlight_on && break
  done
fi

omarchy-shell -q nightlight refresh

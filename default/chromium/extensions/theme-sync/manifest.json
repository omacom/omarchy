{
  "manifest_version": 3,
  "name": "Omarchy Theme Sync",
  "version": "2.0",
  "minimum_chrome_version": "123",
  "description": "Share desktop colors only with sites you approve using the toolbar. Click again to stop sharing.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting",
    "activeTab",
    "alarms",
    "contextMenus"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Share desktop colors with this site",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background-2.js"
  }
}

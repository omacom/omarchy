{
  "manifest_version": 3,
  "name": "Omarchy Theme Sync",
  "version": "1.0",
  "description": "Share your Omarchy desktop colors with websites and keep them in sync when your theme changes.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background-1.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-api.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}

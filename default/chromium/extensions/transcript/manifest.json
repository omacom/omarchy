{
  "manifest_version": 3,
  "name": "Download Transcript",
  "version": "1.0",
  "description": "Download the current page's transcript, this extension is installed by Omarchy",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Download Transcript"
  },
  "commands": {
    "download-transcript": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Download Transcript"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}

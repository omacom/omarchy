{
  "manifest_version": 3,
  "name": "Web App External Links",
  "version": "1.0",
  "description": "Open external links from Omarchy web apps in the default browser",
  "key": "",
  "permissions": ["nativeMessaging", "webNavigation", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["policy.js", "links.js"],
    "run_at": "document_start"
  }]
}

{
  "manifest_version": 3,
  "name": "Omareader",
  "version": "1.0",
  "description": "Repaint web pages in the current Omarchy theme, this extension is installed by Omarchy",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["storage", "nativeMessaging", "alarms", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Omareader",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/omarchy-16.png", "32": "icons/omarchy-32.png" }
  },
  "icons": { "16": "icons/omarchy-16.png", "32": "icons/omarchy-32.png", "48": "icons/omarchy-48.png", "128": "icons/omarchy-128.png" },
  "commands": {
    "toggle-site": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Toggle Omareader on the current site"
    },
    "mode-normal": {
      "description": "All sites: Normal (pages untouched)"
    },
    "mode-dark": {
      "description": "All sites: Dark"
    },
    "mode-omarchy": {
      "description": "All sites: Follow Omarchy"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page-hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/color.js", "src/theme.js", "src/transform.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}

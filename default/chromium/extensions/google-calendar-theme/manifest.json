{
  "manifest_version": 3,
  "name": "Google Calendar Theme",
  "version": "1.0",
  "description": "Color Google Calendar with the current Omarchy theme, this extension is installed by Omarchy",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": {"service_worker": "background.js"},
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["sheet-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}

_omarchy_prioritize_agent_accounts_path() {
  local rc=$?
  local dir="$HOME/.local/share/omarchy/agent-accounts/bin"
  if [[ $PATH != "$dir":* && $PATH != "$dir" ]]; then
    local p=":$PATH:"
    p="${p//":$dir:"/:}"
    p="${p#:}"
    p="${p%:}"
    export PATH="$dir${p:+:$p}"
  fi
  return "$rc"
}

_omarchy_starship_now() {
  local t="${EPOCHREALTIME/[.,]/}"
  printf -v "$1" '%s' "${t%???}"
}

_omarchy_has_mise_env_override() {
  local var
  for var in "${!MISE_@}"; do
    [[ $var == "MISE_SHELL" ]] && continue
    return 0
  done
  return 1
}

_omarchy_has_uncached_mise_config() {
  local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mise"
  if [[ -e $cfg_dir/config.local.toml || -e $cfg_dir/mise.toml || -e $cfg_dir/mise.local.toml || -d $cfg_dir/conf.d || -e /etc/mise/config.toml ]]; then
    return 0
  fi

  local dir="$PWD"
  while true; do
    if [[ -e $dir/mise.toml || -e $dir/.mise.toml || -e $dir/mise.local.toml || -e $dir/.mise.local.toml ||
      -d $dir/.mise || -e $dir/mise/config.toml || -e $dir/mise/config.local.toml ]]; then
      return 0
    fi
    if [[ $dir != "$HOME" ]] && [[ -e $dir/.config/mise.toml || -e $dir/.config/mise.local.toml || -d $dir/.config/mise ]]; then
      return 0
    fi
    [[ $dir == "/" || $dir != */* ]] && break
    dir="${dir%/*}"
    [[ -n $dir ]] || dir="/"
  done
  return 1
}

_omarchy_starship_ps2_is_static() {
  local cfg="$1"
  [[ -z $cfg || ! -r $cfg ]] && return 0
  local line
  while IFS= read -r line || [[ -n $line ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z $line || $line == "#"* ]] && continue
    # Bail conservatively on escaped TOML keys (e.g. "\u0063ontinuation_prompt")
    if [[ $line == *\\*=* ]]; then
      return 1
    fi
    if [[ $line == *continuation_prompt* ]]; then
      if [[ $line =~ ^(\"continuation_prompt\"|\'continuation_prompt\'|continuation_prompt)[[:space:]]*=[[:space:]]*(\'[^\'\$\r]*\'|\"[^\"\$\\\r]*\")[[:space:]]*(#.*)?$ ]]; then
        continue
      fi
      return 1
    fi
  done <"$cfg"
  return 0
}

_omarchy_transform_mise_init() {
  local output="$1"
  local line
  local -a lines=()

  while IFS= read -r line; do
    case "$line" in
      'export __MISE_ORIG_PATH='* | 'export PATH='*) continue ;;
      *'eval "$(mise hook-env '* | *'eval "$(command '*' "$command" "$@")"'*)
        lines+=("$line; _omarchy_prioritize_agent_accounts_path")
        ;;
      *) lines+=("$line") ;;
    esac
  done <<<"$output"

  printf '%s\n' "${lines[@]}"
}

_omarchy_transform_starship_init() {
  local bin="$1" output="$2"
  local bin_q ps2 ps2_assign

  printf -v bin_q '%q' "$bin"
  output="${output//"STARSHIP_START_TIME=\$($bin time)"/"_omarchy_starship_now STARSHIP_START_TIME"}"
  output="${output//"STARSHIP_START_TIME=\$('$bin' time)"/"_omarchy_starship_now STARSHIP_START_TIME"}"
  output="${output//"STARSHIP_START_TIME=\$($bin_q time)"/"_omarchy_starship_now STARSHIP_START_TIME"}"
  output="${output//"STARSHIP_END_TIME=\$($bin time)"/"_omarchy_starship_now STARSHIP_END_TIME"}"
  output="${output//"STARSHIP_END_TIME=\$('$bin' time)"/"_omarchy_starship_now STARSHIP_END_TIME"}"
  output="${output//"STARSHIP_END_TIME=\$($bin_q time)"/"_omarchy_starship_now STARSHIP_END_TIME"}"
  output="${output//'if [[ "${PS0-}" != *"starship_preexec_ps0"* ]]; then'/'if [[ "${PS0-}" != *"STARSHIP_START_TIME"* ]]; then'}"
  output="${output//'STARSHIP_START_TIME="$(starship_preexec_ps0)"'/'STARSHIP_START_TIME=${EPOCHREALTIME/[.,]/},STARSHIP_START_TIME/=1000'}"

  if _omarchy_starship_ps2_is_static "${_omarchy_effective_starship_cfg:-}" && [[ $output == *"PS2=\"\$($bin prompt --continuation)\""* ||
    $output == *"PS2=\"\$('$bin' prompt --continuation)\""* ||
    $output == *"PS2=\"\$($bin_q prompt --continuation)\""* ]]; then
    if ps2=$(STARSHIP_SHELL=bash "$bin" prompt --continuation 2>/dev/null); then
      printf -v ps2_assign 'PS2=%q' "$ps2"
      output="${output//"PS2=\"\$($bin prompt --continuation)\""/"$ps2_assign"}"
      output="${output//"PS2=\"\$('$bin' prompt --continuation)\""/"$ps2_assign"}"
      output="${output//"PS2=\"\$($bin_q prompt --continuation)\""/"$ps2_assign"}"
    fi
  fi

  printf '%s\n' "$output"
}

_omarchy_source_cached_init() {
  local name="$1" bin="$2" stamp="$3" transform="$4"
  shift 4
  local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/bash"
  local cache="$cache_dir/$name.bash"
  local header="# omarchy-init:$bin:$stamp"
  local first=""

  if [[ -n $stamp && -s $cache ]]; then
    IFS= read -r first <"$cache" 2>/dev/null || true
    if [[ $first == "$header" ]]; then
      source "$cache"
      return
    fi
  fi

  local output
  output=$("$bin" "$@" 2>/dev/null) || return
  [[ -n $output ]] || return

  if [[ -n $transform ]]; then
    output=$("$transform" "$bin" "$output")
  fi

  if [[ -n $stamp ]] && mkdir -p "$cache_dir" 2>/dev/null; then
    local tmp="$cache.$$"
    if printf '%s\n%s\n' "$header" "$output" >"$tmp" 2>/dev/null && mv -f "$tmp" "$cache" 2>/dev/null; then
      source "$cache"
      return
    fi
    rm -f "$tmp"
  fi

  eval "$output"
}

_omarchy_init_paths=()
_omarchy_mise=""
_omarchy_mise_cacheable=0
_omarchy_mise_cfg=""
_omarchy_mise_sys_dir=""
_omarchy_mise_sys_cfg=""
_omarchy_starship=""
_omarchy_starship_cfg=""
_omarchy_starship_cfg_path=""
_omarchy_zoxide=""

if _omarchy_mise=$(type -P mise); then
  if ! _omarchy_has_mise_env_override && ! _omarchy_has_uncached_mise_config; then
    _omarchy_mise_cacheable=1
    _omarchy_init_paths+=("$_omarchy_mise")
    _omarchy_mise_cfg="${XDG_CONFIG_HOME:-$HOME/.config}/mise/config.toml"
    if [[ -e $_omarchy_mise_cfg ]]; then
      _omarchy_init_paths+=("$_omarchy_mise_cfg")
    else
      _omarchy_mise_cfg=""
    fi
    if [[ -d /etc/mise/conf.d ]]; then
      _omarchy_mise_sys_dir="/etc/mise/conf.d"
      _omarchy_init_paths+=("$_omarchy_mise_sys_dir")
    fi
    if [[ -e /etc/mise/conf.d/omarchy.toml ]]; then
      _omarchy_mise_sys_cfg="/etc/mise/conf.d/omarchy.toml"
      _omarchy_init_paths+=("$_omarchy_mise_sys_cfg")
    fi
  fi
fi
if [[ $- == *i* ]] && [[ ${TERM:-} != "dumb" ]]; then
  if _omarchy_starship=$(type -P starship); then
    _omarchy_init_paths+=("$_omarchy_starship")
    _omarchy_starship_cfg_path="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
    if [[ -e $_omarchy_starship_cfg_path ]]; then
      _omarchy_starship_cfg="$_omarchy_starship_cfg_path"
      _omarchy_init_paths+=("$_omarchy_starship_cfg")
    fi
  fi
fi
_omarchy_zoxide=$(type -P zoxide) && _omarchy_init_paths+=("$_omarchy_zoxide")

if (( ${#_omarchy_init_paths[@]} > 0 )) || [[ -n $_omarchy_mise ]]; then
  _omarchy_init_stamps=()
  if (( ${#_omarchy_init_paths[@]} > 0 )); then
    mapfile -t _omarchy_init_stamps < <(stat -Lc '%d:%i:%s:%y' "${_omarchy_init_paths[@]}" 2>/dev/null)
  fi
  _omarchy_stamp_idx=0
  if [[ -n $_omarchy_mise ]]; then
    _omarchy_mise_stamp=""
    if (( _omarchy_mise_cacheable )); then
      _omarchy_mise_stamp="${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}"
      (( _omarchy_stamp_idx++ ))
      if [[ -n $_omarchy_mise_cfg ]]; then
        _omarchy_mise_stamp+=":${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}"
        (( _omarchy_stamp_idx++ ))
      else
        _omarchy_mise_stamp+=":none"
      fi
      if [[ -n $_omarchy_mise_sys_dir ]]; then
        _omarchy_mise_stamp+=":${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}"
        (( _omarchy_stamp_idx++ ))
      else
        _omarchy_mise_stamp+=":none"
      fi
      if [[ -n $_omarchy_mise_sys_cfg ]]; then
        _omarchy_mise_stamp+=":${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}"
        (( _omarchy_stamp_idx++ ))
      else
        _omarchy_mise_stamp+=":none"
      fi
      _omarchy_mise_stamp+=":v3"
    fi
    _omarchy_mise_transform() { _omarchy_transform_mise_init "$2"; }
    _omarchy_source_cached_init mise "$_omarchy_mise" "$_omarchy_mise_stamp" _omarchy_mise_transform activate bash
    unset -f _omarchy_mise_transform
  fi
  if [[ -n $_omarchy_starship ]]; then
    _omarchy_starship_stamp="${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}"
    (( _omarchy_stamp_idx++ ))
    _omarchy_starship_cfg_stamp="none"
    if [[ -n $_omarchy_starship_cfg ]]; then
      _omarchy_starship_cfg_stamp="${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}"
      (( _omarchy_stamp_idx++ ))
    fi
    _omarchy_effective_starship_cfg="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
    if [[ $_omarchy_effective_starship_cfg != "$_omarchy_starship_cfg_path" ]]; then
      if [[ -e $_omarchy_effective_starship_cfg ]]; then
        _omarchy_starship_cfg_stamp=$(stat -Lc '%d:%i:%s:%y' "$_omarchy_effective_starship_cfg" 2>/dev/null) || _omarchy_starship_cfg_stamp="none"
      else
        _omarchy_starship_cfg_stamp="none"
      fi
    fi
    _omarchy_starship_stamp+=":${_omarchy_starship_cfg_stamp}:${NO_COLOR+1}:v3"
    _omarchy_source_cached_init starship "$_omarchy_starship" "$_omarchy_starship_stamp" _omarchy_transform_starship_init init bash --print-full-init
  fi
  if [[ -n $_omarchy_zoxide ]]; then
    _omarchy_source_cached_init zoxide "$_omarchy_zoxide" "${_omarchy_init_stamps[$_omarchy_stamp_idx]:-}" "" init bash
  fi
fi
unset _omarchy_init_paths _omarchy_init_stamps _omarchy_stamp_idx _omarchy_mise _omarchy_mise_cacheable _omarchy_mise_cfg _omarchy_mise_sys_dir _omarchy_mise_sys_cfg _omarchy_mise_stamp _omarchy_starship _omarchy_starship_cfg _omarchy_starship_cfg_path _omarchy_starship_cfg_stamp _omarchy_effective_starship_cfg _omarchy_starship_stamp _omarchy_zoxide
unset -f _omarchy_source_cached_init _omarchy_transform_mise_init _omarchy_transform_starship_init _omarchy_has_mise_env_override _omarchy_has_uncached_mise_config _omarchy_starship_ps2_is_static

if command -v try &> /dev/null; then
  try() {
    unset -f try
    eval "$(SHELL=/bin/bash command try init ~/Work/tries)"
    try "$@"
  }
fi

# Only the key bindings (Ctrl-R, Ctrl-T, Alt-C): fzf's completion.bash rewraps
# ~76 commands' completions on every shell start, adding ~25ms before the prompt.
if command -v fzf &> /dev/null; then
  if [[ -f /usr/share/fzf/key-bindings.bash ]]; then
    source /usr/share/fzf/key-bindings.bash
  fi
fi

source "$OMARCHY_PATH/default/bash/completions"

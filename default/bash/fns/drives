# Write iso file to sd card
iso2sd() {
  if (( $# < 1 )); then
    echo "Usage: iso2sd <input_file> [output_device]"
    echo "Example: iso2sd ~/Downloads/ubuntu-25.04-desktop-amd64.iso /dev/sda"
    return 1
  fi

  local iso="$1"
  local drive="$2"

  if [[ -z $drive ]]; then
    # Offer only removable, hot-pluggable or USB disks. Matching on the /dev/sd name
    # instead would offer internal SATA disks, since the kernel names SATA and USB
    # disks alike, while missing SD cards at /dev/mmcblk and USB enclosures that
    # present as NVMe. USB disks match by transport too, as one can report neither
    # flag; TRAN goes last because it is empty for zram and loop devices.
    local available_drives=$(lsblk -dpno NAME,RM,HOTPLUG,TYPE,TRAN |
      awk '$4 == "disk" && ($2 == 1 || $3 == 1 || $5 == "usb") { print $1 }')

    if [[ -z $available_drives ]]; then
      echo "No removable drives found and no drive specified"
      return 1
    fi

    drive=$(omarchy-drive-select "$available_drives")

    if [[ -z $drive ]]; then
      echo "No drive selected"
      return 1
    fi
  fi

  sudo dd bs=4M status=progress oflag=sync if="$iso" of="$drive"
  sudo eject "$drive"
}

# Format an entire drive for a single partition using exFAT
format-drive() {
  if (( $# != 2 )); then
    echo "Usage: format-drive <device> <name>"
    echo "Example: format-drive /dev/sda 'My Stuff'"
    echo -e "\nAvailable drives:"
    lsblk -d -o NAME -n | awk '{print "/dev/"$1}'
  elif ! [[ -b $1 ]]; then
    echo "Error: $1 is not a block device."
    return 1
  else
    echo "WARNING: This will completely erase all data on $1 and label it '$2'."
    read -rp "Are you sure you want to continue? (y/N): " confirm

    if [[ $confirm =~ ^[Yy]$ ]]; then
      sudo wipefs -a "$1" || { echo "Error: failed to wipe $1."; return 1; }
      sudo dd if=/dev/zero of="$1" bs=1M count=100 status=progress || { echo "Error: failed to zero $1."; return 1; }
      sudo parted -s "$1" mklabel gpt mkpart primary 1MiB 100% set 1 msftdata on || { echo "Error: failed to partition $1."; return 1; }

      if [[ $1 == *[0-9] ]]; then
        partition="${1}p1"
      else
        partition="${1}1"
      fi
      sudo partprobe "$1" || true
      sudo udevadm settle || true

      if sudo mkfs.exfat -n "$2" "$partition"; then
        echo "Drive $1 formatted as exFAT and labeled '$2'."
      else
        echo "Error: failed to format $partition as exFAT."
        return 1
      fi
    fi
  fi
}

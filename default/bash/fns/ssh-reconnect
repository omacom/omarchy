# Wrap ssh to clean up the terminal and reconnect when a connection drops.
#
# A remote tmux, herdr, or editor arms terminal modes over the SSH pipe (mouse
# tracking, focus reporting, the alternate screen) that only it can disarm. If
# the connection dies instead of exiting cleanly, those modes stay armed on the
# local terminal, and every mouse move floods the prompt with escape junk.
# Reloading bashrc must not reset an active Ghostty helper after its startup
# marker and SSH features have been consumed.
if [[ ${_omarchy_ghostty_ssh_active-} != 1 ]]; then
  _ssh_connect() {
    command ssh "$@"
  }
fi

# Ghostty's automatic Bash integration sources bashrc before defining its own
# ssh function. __ghostty_bash_flags remains set while bashrc runs, after the
# injection variable has been consumed. Take over supported SSH features here
# so both integrations use one connection path and Ghostty does not replace
# the reconnect wrapper. Ghostty 1.3 has the same injection markers but no
# +ssh action, so only take over versions that provide it.
if [[ -n ${BASH_VERSION-} && -n ${__ghostty_bash_flags-} &&
  -n ${GHOSTTY_BIN_DIR-} && -x ${GHOSTTY_BIN_DIR}/ghostty &&
  ${TERM_PROGRAM-} == "ghostty" && ${TERM_PROGRAM_VERSION-} =~ ^([0-9]+)\.([0-9]+) ]] &&
  (( BASH_REMATCH[1] > 1 || (BASH_REMATCH[1] == 1 && BASH_REMATCH[2] >= 4) )); then
  _omarchy_ghostty_ssh=0
  _omarchy_ghostty_supported=1
  _omarchy_ghostty_remaining_features=
  IFS=, read -ra _omarchy_ghostty_features <<< "${GHOSTTY_SHELL_FEATURES-}"
  for _omarchy_ghostty_feature in "${_omarchy_ghostty_features[@]}"; do
    case $_omarchy_ghostty_feature in
      ssh-env | ssh-terminfo)
        _omarchy_ghostty_ssh=1
        ;;
      ssh-*)
        # Leave newer SSH features for Ghostty instead of discarding them.
        _omarchy_ghostty_supported=0
        break
        ;;
      *)
        _omarchy_ghostty_remaining_features+="${_omarchy_ghostty_remaining_features:+,}$_omarchy_ghostty_feature"
        ;;
    esac
  done

  if (( _omarchy_ghostty_ssh && _omarchy_ghostty_supported )); then
    _omarchy_ghostty_ssh_active=1
    _omarchy_ghostty_ssh_flags=()
    [[ $GHOSTTY_SHELL_FEATURES == *ssh-env* ]] || _omarchy_ghostty_ssh_flags+=(--forward-env=false)
    [[ $GHOSTTY_SHELL_FEATURES == *ssh-terminfo* ]] || _omarchy_ghostty_ssh_flags+=(--terminfo=false)

    _ssh_connect() {
      command "$GHOSTTY_BIN_DIR/ghostty" +ssh "${_omarchy_ghostty_ssh_flags[@]}" -- "$@"
    }
    GHOSTTY_SHELL_FEATURES=$_omarchy_ghostty_remaining_features
  fi

  unset _omarchy_ghostty_ssh _omarchy_ghostty_supported \
    _omarchy_ghostty_remaining_features _omarchy_ghostty_features _omarchy_ghostty_feature
fi

ssh() {
  local rc started

  started=$SECONDS
  _ssh_connect "$@"
  rc=$?

  [[ -t 1 ]] || return $rc
  _ssh_disarm

  # Reconnect only when an interactive session drops: ssh exits 255 for
  # transport failures, but a fast 255 with no established session is a
  # connect/auth failure, a remote command's own 255 passes through
  # indistinguishably and must not replay its side effects, and redirected
  # stdin would feed the remaining piped input to a fresh remote shell.
  if (( rc != 255 )) || [[ ! -t 0 ]] || ! _ssh_interactive "$@" ||
    (( SECONDS - started < 30 )); then
    return $rc
  fi

  # Retry in a subshell: Ctrl-C reaches the whole foreground process group,
  # so it cancels both the in-flight attempt and the loop itself. Keep
  # retrying fast failures, since a rebooting server refuses connections too.
  (
    while true; do
      echo "Connection lost. Reconnecting (Ctrl-C to stop)..."
      sleep 2
      _ssh_connect "$@"
      rc=$?
      _ssh_disarm
      (( rc != 255 )) && exit $rc
    done
  )
}

# Disarm mouse tracking (1000/1002/1003, 1006 encoding), focus reporting
# (1004), and the alternate screen (1049), and show the cursor again.
_ssh_disarm() {
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?1004l\e[?1049l\e[?25h'
}

# True for an interactive session: a destination and no remote command. The
# letters are the ssh(1) options that consume a value, so their arguments are
# not mistaken for the destination.
_ssh_interactive() {
  local value_opts="BbcDEeFIiJLlmOoPpQRSWw"
  local argv=("$@") arg letters i dest="" opts_done=""

  while (($#)); do
    arg="$1"
    shift

    if [[ -z $opts_done && $arg == "--" ]]; then
      opts_done=1
    elif [[ -z $opts_done && $arg == -?* ]]; then
      letters="${arg#-}"
      for ((i = 0; i < ${#letters}; i++)); do
        if [[ $value_opts == *"${letters:i:1}"* ]]; then
          # The value is glued to the letter (-p2222) unless the letter ends
          # the argument, in which case it consumes the next one (-p 2222).
          (( i == ${#letters} - 1 )) && shift
          break
        fi
      done
    elif [[ -z $dest ]]; then
      dest="$arg"
    else
      return 1
    fi
  done

  [[ -n $dest ]] || return 1

  # A RemoteCommand from ssh_config or -o replays on reconnect just like a
  # positional command; ssh -G resolves the effective configuration for this
  # exact invocation without connecting. Fail closed when it cannot resolve,
  # since an undetected RemoteCommand must not replay. The explicit "none"
  # cancels a configured command, and some versions emit it when unset.
  local resolved
  resolved=$(command ssh -G "${argv[@]}" 2>/dev/null) || return 1
  ! grep -i '^remotecommand ' <<<"$resolved" | grep -qvi '^remotecommand none$'
}

{
  "schemaVersion": 1,
  "base": "{{ mode }}",
  "tokens": {
    "--background": "{{ background }}",
    "--editor-surface": "{{ background }}",
    "--foreground": "{{ foreground }}",
    "--card": "{{ dark_background }}",
    "--card-foreground": "{{ foreground }}",
    "--popover": "{{ dark_background }}",
    "--popover-foreground": "{{ foreground }}",
    "--primary": "{{ accent }}",
    "--primary-foreground": "{{ background }}",
    "--secondary": "{{ lighter_background }}",
    "--secondary-foreground": "{{ foreground }}",
    "--muted": "{{ lighter_background }}",
    "--muted-foreground": "{{ light_foreground }}",
    "--accent": "{{ selection_background }}",
    "--accent-foreground": "{{ selection_foreground }}",
    "--border": "{{ dark_background }}",
    "--input": "{{ selection_background }}",
    "--ring": "{{ accent }}",
    "--chart-1": "{{ accent }}",
    "--chart-2": "{{ blue }}",
    "--chart-3": "{{ green }}",
    "--chart-4": "{{ orange }}",
    "--chart-5": "{{ magenta }}",
    "--sidebar": "{{ dark_background }}",
    "--sidebar-foreground": "{{ foreground }}",
    "--sidebar-primary": "{{ accent }}",
    "--sidebar-primary-foreground": "{{ background }}",
    "--sidebar-accent": "{{ lighter_background }}",
    "--sidebar-accent-foreground": "{{ foreground }}",
    "--sidebar-border": "{{ dark_background }}",
    "--sidebar-ring": "{{ accent }}",
    "--worktree-sidebar": "{{ dark_background }}",
    "--worktree-sidebar-foreground": "{{ foreground }}",
    "--worktree-sidebar-accent": "{{ lighter_background }}",
    "--worktree-sidebar-accent-foreground": "{{ foreground }}",
    "--worktree-sidebar-border": "{{ dark_background }}",
    "--worktree-sidebar-ring": "{{ accent }}",
    "--worktree-sidebar-active": "{{ mix darker_background accent 18% }}",
    "--tab-bar": "{{ dark_background }}",
    "--tab-active": "{{ dark_background }}",
    "--tab-active-foreground": "{{ foreground }}",
    "--tab-active-indicator": "{{ accent }}",
    "--tab-inactive": "{{ dark_background }}",
    "--tab-inactive-foreground": "{{ dark_foreground }}",
    "--text-link": "{{ blue }}",
    "--diff-added": "{{ green }}",
    "--diff-removed": "{{ red }}",
    "--git-decoration-added": "{{ green }}",
    "--git-decoration-modified": "{{ yellow }}",
    "--git-decoration-deleted": "{{ red }}",
    "--git-decoration-renamed": "{{ cyan }}",
    "--git-decoration-untracked": "{{ green }}",
    "--git-decoration-copied": "{{ cyan }}",
    "--git-decoration-ignored": "{{ dark_foreground }}"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "{{ dark_foreground }}", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage"], "settings": { "foreground": "{{ magenta }}" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "{{ cyan }}" } },
    { "scope": ["string"], "settings": { "foreground": "{{ green }}" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "{{ orange }}" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "{{ blue }}" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "{{ yellow }}" } },
    { "scope": ["variable.parameter", "variable.other.property"], "settings": { "foreground": "{{ cyan }}" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "{{ red }}" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "{{ yellow }}" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "{{ accent }}", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "{{ blue }}" } },
    { "scope": ["invalid"], "settings": { "foreground": "{{ red }}" } }
  ]
}

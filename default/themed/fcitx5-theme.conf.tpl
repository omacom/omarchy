[Metadata]
Name=Omarchy
Version=1
Author=Omarchy
Description=Generated from the current Omarchy theme
ScaleWithDPI=True

[InputPanel]
NormalColor={{ foreground }}
HighlightCandidateColor={{ background }}
HighlightColor={{ accent }}
HighlightBackgroundColor={{ accent }}
PageButtonAlignment=Last Candidate

[InputPanel/TextMargin]
Left=12
Right=12
Top=8
Bottom=8

[InputPanel/ContentMargin]
Left=6
Right=6
Top=6
Bottom=6

[InputPanel/Background]
Color={{ background }}
BorderColor={{ selection }}
BorderWidth=2

[InputPanel/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[InputPanel/Highlight]
Color={{ accent }}

[InputPanel/Highlight/Margin]
Left=8
Right=8
Top=5
Bottom=5

[InputPanel/PrevPage]
Image=prev.svg

[InputPanel/PrevPage/ClickMargin]
Left=6
Right=6
Top=5
Bottom=5

[InputPanel/NextPage]
Image=next.svg

[InputPanel/NextPage/ClickMargin]
Left=6
Right=6
Top=5
Bottom=5

[Menu]
NormalColor={{ foreground }}
HighlightCandidateColor={{ background }}

[Menu/Background]
Color={{ background }}
BorderColor={{ selection }}
BorderWidth=2

[Menu/Background/Margin]
Left=2
Right=2
Top=2
Bottom=2

[Menu/ContentMargin]
Left=6
Right=6
Top=6
Bottom=6

[Menu/CheckBox]
Image=radio.svg

[Menu/SubMenu]
Image=arrow.svg

[Menu/Highlight]
Color={{ accent }}

[Menu/Highlight/Margin]
Left=8
Right=8
Top=5
Bottom=5

[Menu/Separator]
Color={{ muted }}

[Menu/TextMargin]
Left=12
Right=12
Top=8
Bottom=8

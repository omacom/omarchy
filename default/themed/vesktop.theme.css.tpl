/**
 * @name Omarchy
 * @description Automatically follows the active Omarchy colour palette.
 * @author Omarchy
 * @version 1.0.0
 */
:root, .theme-dark, .theme-light, .theme-darker, .theme-midnight {
  --background-primary: {{ background }} !important;
  --background-secondary: {{ dark_background }} !important;
  --background-secondary-alt: {{ darker_background }} !important;
  --background-tertiary: {{ darker_background }} !important;
  --background-accent: {{ lighter_background }} !important;
  --background-floating: {{ lighter_background }} !important;
  --background-nested-floating: {{ background }} !important;
  --background-mobile-primary: {{ background }} !important;
  --background-mobile-secondary: {{ dark_background }} !important;
  --background-base-lowest: {{ darker_background }} !important;
  --background-base-lower: {{ dark_background }} !important;
  --background-base-low: {{ background }} !important;
  --background-surface-high: {{ lighter_background }} !important;
  --background-surface-higher: {{ lighter_background }} !important;
  --background-surface-highest: {{ lighter_background }} !important;
  --bg-base-primary: {{ background }} !important;
  --bg-base-secondary: {{ dark_background }} !important;
  --bg-base-tertiary: {{ darker_background }} !important;
  --bg-surface-overlay: {{ lighter_background }} !important;
  --bg-surface-raised: {{ lighter_background }} !important;
  --chat-background: {{ background }} !important;
  --chat-background-default: {{ background }} !important;
  --chat-border: {{ muted }} !important;
  --channeltextarea-background: {{ lighter_background }} !important;
  --input-background: {{ lighter_background }} !important;
  --modal-background: {{ background }} !important;
  --modal-footer-background: {{ dark_background }} !important;
  --home-background: {{ background }} !important;
  --text-strong: {{ bright_foreground }} !important;
  --input-text-default: {{ foreground }} !important;
  --input-placeholder-text-default: {{ mix foreground background 25% }} !important;
  --input-background-default: {{ lighter_background }} !important;
  --input-background-hover: {{ lighter_background }} !important;
  --input-background-active: {{ lighter_background }} !important;
  --input-border-default: {{ muted }} !important;
  --input-border-hover: {{ accent }} !important;
  --input-border-active: {{ accent }} !important;
  --text-normal: {{ foreground }} !important;
  --text-default: {{ foreground }} !important;
  --text-primary: {{ foreground }} !important;
  --text-secondary: {{ foreground }} !important;
  --text-muted: {{ mix foreground background 30% }} !important;
  --text-subtle: {{ mix foreground background 30% }} !important;
  --text-tertiary: {{ mix foreground background 30% }} !important;
  --channels-default: {{ mix foreground background 20% }} !important;
  --header-primary: {{ bright_foreground }} !important;
  --header-secondary: {{ foreground }} !important;
  --interactive-normal: {{ foreground }} !important;
  --interactive-hover: {{ bright_foreground }} !important;
  --interactive-active: {{ accent }} !important;
  --interactive-muted: {{ muted }} !important;
  --interactive-text-default: {{ foreground }} !important;
  --interactive-text-hover: {{ bright_foreground }} !important;
  --interactive-text-active: {{ accent }} !important;
  --interactive-icon-default: {{ foreground }} !important;
  --interactive-icon-hover: {{ bright_foreground }} !important;
  --interactive-icon-active: {{ accent }} !important;
  --text-link: {{ accent }} !important;
  --text-brand: {{ accent }} !important;
  --text-positive: {{ green }} !important;
  --text-warning: {{ yellow }} !important;
  --text-danger: {{ red }} !important;
  --status-positive: {{ green }} !important;
  --status-warning: {{ yellow }} !important;
  --status-danger: {{ red }} !important;
  --background-modifier-hover: rgba({{ foreground_rgb }}, 0.07) !important;
  --background-modifier-active: rgba({{ accent_rgb }}, 0.14) !important;
  --background-modifier-selected: {{ selection_background }} !important;
  --background-modifier-accent: rgba({{ foreground_rgb }}, 0.12) !important;
  --background-mod-muted: rgba({{ foreground_rgb }}, 0.04) !important;
  --background-mod-normal: rgba({{ foreground_rgb }}, 0.07) !important;
  --background-mod-subtle: rgba({{ foreground_rgb }}, 0.07) !important;
  --background-mod-strong: rgba({{ foreground_rgb }}, 0.12) !important;
  --background-message-hover: rgba({{ foreground_rgb }}, 0.04) !important;
  --background-mentioned: rgba({{ yellow_rgb }}, 0.08) !important;
  --background-mentioned-hover: rgba({{ yellow_rgb }}, 0.12) !important;
  --background-message-highlight: rgba({{ accent_rgb }}, 0.12) !important;
  --mention-foreground: {{ accent }} !important;
  --mention-background: rgba({{ accent_rgb }}, 0.15) !important;
  --border-subtle: rgba({{ foreground_rgb }}, 0.12) !important;
  --border-normal: rgba({{ foreground_rgb }}, 0.18) !important;
  --border-strong: {{ muted }} !important;
  --app-border-frame: {{ darker_background }} !important;
  --brand-360: {{ accent }} !important;
  --brand-400: {{ accent }} !important;
  --brand-460: {{ accent }} !important;
  --brand-500: {{ accent }} !important;
  --brand-530: {{ mix accent background 10% }} !important;
  --brand-560: {{ mix accent background 15% }} !important;
  --brand-600: {{ mix accent background 20% }} !important;
  --control-brand-foreground: {{ accent }} !important;
  --control-primary-background-default: {{ accent }} !important;
  --control-primary-background-hover: {{ mix accent foreground 15% }} !important;
  --control-primary-background-active: {{ mix accent background 15% }} !important;
  --omarchy-on-accent: __OMARCHY_ON_ACCENT__ !important;
  --control-primary-text-default: var(--omarchy-on-accent) !important;
  --control-primary-text-hover: var(--omarchy-on-accent) !important;
  --control-primary-text-active: var(--omarchy-on-accent) !important;
  --button-filled-brand-background: {{ accent }} !important;
  --button-filled-brand-background-hover: {{ mix accent foreground 15% }} !important;
  --button-filled-brand-background-active: {{ mix accent background 15% }} !important;
  --button-filled-brand-text: var(--omarchy-on-accent) !important;
  --button-secondary-background: {{ lighter_background }} !important;
  --button-secondary-background-hover: {{ selection_background }} !important;
  --button-secondary-text: {{ foreground }} !important;
  --scrollbar-thin-thumb: {{ muted }} !important;
  --scrollbar-thin-track: transparent !important;
  --scrollbar-auto-thumb: {{ muted }} !important;
  --scrollbar-auto-track: {{ dark_background }} !important;
  --scrollbar-auto-scrollbar-color-thumb: {{ muted }} !important;
  --scrollbar-auto-scrollbar-color-track: {{ dark_background }} !important;
}
::selection { background: {{ selection_background }}; color: {{ selection_foreground }}; }

# Omarchy on systemd-boot: overrides mkinitcpio's hook of the same name, with
# the same triggers, so every initramfs is built once, stored as a boot image
# and published as a UKI by omarchy-boot-sync rather than written to the ESP
# as a loose kernel and initramfs.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/lib/systemd/systemd-udevd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm
Target = usr/bin/mdadm
Target = usr/bin/pdata_tools
Target = usr/lib/libcryptsetup.so
Target = usr/lib/libp11-kit.so
Target = usr/lib/libpcsclite.so
Target = usr/lib/modprobe.d/
# What a Snapdragon machine's boot image embeds (uki.conf's device trees, and
# the hardware IDs systemd-stub picks one by): a dtbs package's upgrade
# rebuilds it even when the kernel doesn't change.
Target = boot/dtbs/*
Target = usr/lib/systemd/boot/hwids/*

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = mkinitcpio
Target = mkinitcpio-git
[Action]
Description = Updating Omarchy boot images...
When = PostTransaction
Exec = /usr/bin/omarchy-boot-rebuild --pacman-install
NeedsTargets

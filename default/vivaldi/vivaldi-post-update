#!/bin/bash

set -eu

VIVALDI_UI=/opt/vivaldi/resources/vivaldi

[[ -d $VIVALDI_UI ]] || exit 0
[[ -f $VIVALDI_UI/window.html ]] || exit 0

cd "$VIVALDI_UI"

JS="style/omarchy.js"

sudo mkdir -p style
sudo cp "$OMARCHY_PATH/default/vivaldi/omarchy-theme-loader.js" "$JS"
sudo sed -i \
  -e "/script.*omarchy/d" -e "s|</body>|  <script src=\"$JS\"></script>\n&|" \
  -e "/omarchy-theme/d"   -e "s|</head>|  <style id=\"omarchy-theme\"></style>\n&|" window.html

# Retire the shared channels. Running windows with the old loader need a
# restart; new windows read only their user's private state, never /opt data.
sudo rm -f style/omarchy.csv style/omarchy.json

omarchy-theme-set-browser

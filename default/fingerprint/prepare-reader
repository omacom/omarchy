#!/bin/bash
set -e

echo -e "\e[32mSetting up fingerprint scanner for authentication.\n\e[0m"

# Bail before installing anything if there's no reader to talk to.
if ! omarchy-hw-fingerprint; then
  echo -e "\e[31mNo fingerprint sensor detected.\e[0m"
  exit 1
fi

# libfprint-git tracks upstream ahead of the Arch release, so a new reader only
# needs a pin bump in omarchy-pkgs. It conflicts with stock libfprint, and
# --noconfirm answers that prompt with N; --ask 4 accepts the replacement in
# one transaction, so a failed install leaves the existing driver in place.
packages=(libfprint-git fprintd usbutils)

# --ask 4 accepts any replacement, not just the stock-libfprint one it was
# written for. Readers libfprint cannot drive at all run on a TOD stack instead
# — a libfprint fork plus a vendor blob — and that fork provides libfprint too,
# so this would remove the only driver they have without asking. Check who owns
# the library: the TOD packages are named differently per vendor.
libfprint_owner=$(pacman -Qqo /usr/lib/libfprint-2.so.2 2>/dev/null || true)
if [[ -n $libfprint_owner && $libfprint_owner != "libfprint" && $libfprint_owner != "libfprint-git" ]]; then
  echo -e "\e[33mlibfprint is provided by $libfprint_owner; keeping it and skipping libfprint-git.\e[0m"
  packages=(fprintd usbutils)
fi

if omarchy-pkg-missing "${packages[@]}"; then
  echo "Installing required packages..."
  sudo pacman -S --needed --noconfirm --ask 4 -- "${packages[@]}"
fi

# Enroll first fingerprint
# Authenticate sudo first, and say so: with fingerprint sudo already set up it
# asks for a touch of its own, which must not pass for the first sample.
authenticate() {
  if ! sudo -n true 2>/dev/null; then
    echo -e "\n$1 Setup needs administrator rights to enroll."
    if ! sudo -v; then
      echo -e "\e[31mSetup needs administrator rights to enroll a fingerprint.\e[0m"
      exit 1
    fi
  fi
}
authenticate "First, confirm it's you."

# A reader its platform keeps off until the owner agrees (a Mac's Touch ID)
# is explained and turned on here, before fprintd is asked about it. Every
# other platform has no such hook, so this is a no-op there. Resolving as the
# user first runs nothing as root where there is nothing to run. Setup on a
# platform that can't be told goes on as on one without a hook: a reader its
# platform keeps off stays off, so fprintd doesn't find it, and any other
# reader still enrolls.
if ! enable_hook=$(omarchy-lifecycle-dispatch --resolve enable-fingerprint); then
  echo -e "\e[33mThe fingerprint sensor's platform support couldn't be checked, so a reader the platform keeps off stays off.\e[0m"
  enable_hook=
fi
if [[ -n $enable_hook ]]; then
  if ! sudo omarchy-lifecycle-dispatch enable-fingerprint; then
    echo -e "\e[31mThe fingerprint sensor was not turned on, so nothing was enrolled.\e[0m"
    exit 1
  fi
  # The owner may have read past sudo's timeout before answering.
  authenticate "Confirm it's you again."
fi

# Hyprland global shortcuts the Omarchy shell registers, one per line: a menu
# route to toggle, a panel plugin to toggle, or a volume key. A binding written
# as o.bind(keys, description, { menu = "theme" }), { panel = "omarchy.emojis" }
# or { audio = "raise" } dispatches the matching shortcut straight to the
# shell, with no process to spawn per keypress. Anything missing here still
# binds, through the omarchy-menu, omarchy-shell or omarchy-audio-output-volume
# command instead.
menu root
menu apps
menu capture
menu toggle
menu hardware
menu system
menu background
menu theme
menu share
menu reminder-set
panel omarchy.clipboard
panel omarchy.emojis
panel omarchy.audio
panel omarchy.bluetooth
panel omarchy.monitor
panel omarchy.clock
panel omarchy.network
panel omarchy.power
audio raise
audio lower
audio mute-toggle

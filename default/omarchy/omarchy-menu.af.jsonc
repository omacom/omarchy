{
  // Omarchy menu definition.
  // JSONC is used for Neovim-friendly highlighting, comments, and trailing commas.
  // IDs are object keys. Dotted IDs imply hierarchy: trigger.share.file belongs
  // under trigger.share.
  // Kind is inferred: action -> action, target -> link, otherwise submenu.
  // Dotted IDs define the tree. Use provider:"name" only when the submenu
  // calls provider_name() or a command named "name" to return JSON rows.
  // Optional fields:
  //   aliases        alternate `omarchy menu summon <name>` routes; also searchable.
  //                  Reserved for established names users already type; new entries
  //                  should not normally add any.
  //   iconFont       font family used for the icon glyph, when it differs from the menu font
  //   title          header text shown when the submenu is open; defaults to label
  //   when           shell condition; hide row when it fails
  //   checked        shell condition; append ✓ when it succeeds

  // Root Menu
  "apps": {"icon":"󰀻","label":"Toepassings","aliases":["app","applications"],"provider":"apps"},
  "learn": {"icon":"󰧑","label":"Leer"},
  "trigger": {"icon":"󱓞","label":"Snellers"},
  "style": {"icon":"","label":"Styl"},
  "setup": {"icon":"","label":"Opstelling","aliases":["settings"]},
  "install": {"icon":"󰉉","label":"Installeer"},
  "remove": {"icon":"󰭌","label":"Verwyder","aliases":["uninstall"]},
  "update": {"icon":"","label":"Werk by","aliases":["restart","refresh"]},
  "about": {"icon":"","label":"Oor","action":"omarchy-launch-about"},
  "system": {"icon":"","label":"Stelsel","aliases":["power-menu"]},

  // System
  "system.screensaver": {"icon":"󱄄","label":"Skermskerm","action":"omarchy-launch-screensaver force"},
  "system.lock": {"icon":"","label":"Sluit skerm","action":"omarchy-system-lock"},
  "system.suspend": {"icon":"󰒲","label":"Sluimer","when":"! omarchy-toggle-enabled suspend-off","action":"systemctl suspend"},
  "system.hibernate": {"icon":"󰤁","label":"Hibernasie","when":"omarchy-hibernation-available","action":"systemctl hibernate"},
  "system.logout": {"icon":"󰍃","label":"Meld af","action":"omarchy-system-logout"},
  "system.reboot": {"icon":"󰜉","label":"Herbegin","action":"omarchy-system-reboot"},
  "system.shutdown": {"icon":"󰐥","label":"Skakel af","action":"omarchy-system-shutdown"},

  // Learn
  "learn.keybindings": {"icon":"","label":"Sleutelkortpaaie","action":"omarchy-menu-keybindings"},
  "learn.omarchy": {"icon":"","label":"Omarchy","action":"omarchy-launch-webapp 'https://omarchy.org/manual/'"},
  "learn.hyprland": {"icon":"","label":"Hyprland","action":"omarchy-launch-webapp 'https://wiki.hypr.land/'"},
  "learn.arch": {"icon":"󰣇","label":"Arch","action":"omarchy-launch-webapp 'https://wiki.archlinux.org/title/Main_page'"},
  "learn.neovim": {"icon":"","label":"Neovim","action":"omarchy-launch-webapp 'https://www.lazyvim.org/keymaps'"},
  "learn.bash": {"icon":"󱆃","label":"Bash","action":"omarchy-launch-webapp 'https://devhints.io/bash'"},
  "learn.tmux-keybindings": {"icon":"","label":"Tmux","action":"omarchy-menu-tmux-keybindings"},
  "learn.herdr-keybindings": {"icon":"","label":"Herdr","action":"omarchy-menu-herdr-keybindings"},
  "learn.community": {"icon":"󰙯","label":"Gemeenskap","action":"omarchy-launch-discord-community"},

  // Trigger
  "trigger.emoji": {"icon":"","label":"Emoji","aliases":["emoji","emojis"],"action":"omarchy-menu-emoji"},
  "trigger.reminder": {"icon":"󰢌","label":"Herinnering","aliases":["reminder"]},
  "trigger.capture": {"icon":"","label":"Vang vas","aliases":["capture","screenshot","screenrecord","screen-record","screenrecording"]},
  "trigger.capture.screenshot": {"icon":"","label":"Skermkiekie","action":"omarchy-capture-screenshot"},
  "trigger.capture.screenrecord.stop": {"icon":"","label":"Stop skermopname","when":"pgrep -f '^gpu-screen-recorder'","action":"omarchy-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord": {"icon":"","label":"Skermopname"},
  "trigger.capture.text": {"icon":"󰴑","label":"Teks","action":"omarchy-capture-text"},
  "trigger.capture.qr": {"icon":"󰐲","label":"QR-kode","action":"omarchy-capture-qr"},
  "trigger.capture.color": {"icon":"󰃉","label":"Kleur","action":"pkill hyprpicker || hyprpicker -a"},
  "trigger.capture.screenrecord.no-audio": {"icon":"","label":"Sonder klank","action":"omarchy-capture-screenrecording"},
  "trigger.capture.screenrecord.desktop-audio": {"icon":"","label":"Met werkskermklank","action":"omarchy-capture-screenrecording --with-desktop-audio"},
  "trigger.capture.screenrecord.microphone": {"icon":"","label":"Met werkskerm- en mikrofoonklank","action":"omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio"},
  "trigger.capture.screenrecord.webcam": {"icon":"","label":"Met werkskerm-, mikrofoonklank en webkamera","when":"omarchy-hw-webcam","action":"omarchy-capture-screenrecording-with-webcam"},
  "trigger.transcode": {"icon":"󰧸","label":"Transkodeer","action":"omarchy-transcode"},
  "trigger.share": {"icon":"","label":"Deel","aliases":["share"]},
  "trigger.toggle": {"icon":"󰔎","label":"Wissel","aliases":["toggle","toggles"]},
  "trigger.hardware": {"icon":"","label":"Hardeware","aliases":["hardware","hw"]},
  "trigger.tests": {"icon":"󰓅","label":"Spoedtoets"},
  "trigger.hardware.laptop-display": {"icon":"󰛧","label":"Skootrekenaarskerm","when":"omarchy-hw-laptop","action":"omarchy-hyprland-monitor-internal toggle"},
  "trigger.hardware.mirror-display": {"icon":"󰍹","label":"Spieëlskerm","when":"omarchy-hw-laptop","action":"omarchy-hyprland-monitor-internal-mirror toggle"},
  "trigger.hardware.hybrid-gpu": {"icon":"","label":"Hybrid GPU","when":"omarchy-hw-hybrid-gpu","action":"omarchy-launch-floating-terminal-with-presentation omarchy-toggle-hybrid-gpu"},
  "trigger.hardware.touchpad": {"icon":"󰟸","label":"Raakblad","when":"omarchy-hw-touchpad","action":"omarchy-toggle-touchpad"},
  "trigger.hardware.touchpad-haptics": {"icon":"󰌌","label":"Raakblad-haptiek"},
  "trigger.hardware.touchpad-haptics.low": {"icon":"󰌌","label":"laag","when":"omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"low\" ]]","action":"dell-xps-touchpad-haptics set low"},
  "trigger.hardware.touchpad-haptics.mid": {"icon":"󰌌","label":"medium","when":"omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"mid\" ]]","action":"dell-xps-touchpad-haptics set mid"},
  "trigger.hardware.touchpad-haptics.high": {"icon":"󰌌","label":"hoog","when":"omarchy-hw-dell-xps-haptic-touchpad && omarchy-cmd-present dell-xps-touchpad-haptics","checked":"[[ \"$(dell-xps-touchpad-haptics get)\" == \"high\" ]]","action":"dell-xps-touchpad-haptics set high"},
  "trigger.hardware.touchscreen": {"icon":"󰆽","label":"Raakskerm","when":"omarchy-hw-touchscreen","action":"omarchy-toggle-touchscreen"},
  "trigger.reminder.set": {"icon":"󰢌","label":"Stel een","aliases":["reminder-set","remind"],"action":"omarchy-reminder -i"},
  "trigger.reminder.show": {"icon":"󰢌","label":"Wys alles","action":"omarchy-reminder show"},
  "trigger.reminder.clear": {"icon":"󰢌","label":"Maak alles skoon","action":"omarchy-reminder clear"},
  "trigger.share.clipboard": {"icon":"","label":"Knipbord","action":"omarchy-menu-share clipboard"},
  "trigger.share.file": {"icon":"","label":"Lêer","action":"omarchy-menu-share file"},
  "trigger.share.folder": {"icon":"","label":"Gids","action":"omarchy-menu-share folder"},
  "trigger.share.receive": {"icon":"󰥦","label":"Ontvang","action":"uwsm-app -- localsend"},
  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Bly wakker","action":"omarchy-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Kennisgewings","action":"omarchy-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Ineenstorting-vaslegging","action":"omarchy-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Skermskerm","action":"omarchy-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Naglig","action":"omarchy-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Kieslysbalk","action":"omarchy-toggle-bar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery-persentasie","when":"omarchy-hw-laptop","action":"omarchy-shell omarchy.power togglePercentage"},
  "trigger.toggle.workspace-layout": {"icon":"󱂬","label":"Werkspasie-uitleg","action":"omarchy-hyprland-workspace-layout-toggle"},
  "trigger.toggle.window-gaps": {"icon":"","label":"Vensterspasiëring","action":"omarchy-hyprland-window-gaps-toggle"},
  "trigger.toggle.one-window-ratio": {"icon":"","label":"1-Window Ratio","action":"omarchy-hyprland-window-single-square-aspect-toggle"},
  "trigger.tests.network-speedtest": {"icon":"󰓅","label":"Netwerkspoedtoets","action":"omarchy-shell shell summon omarchy.speedtest"},
  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Skyfspoedtoets","action":"omarchy-shell shell summon omarchy.disk-speedtest"},

  // Style
  "style.theme": {"icon":"󰸌","label":"Tema","aliases":["theme","themes"],"action":"theme=$(omarchy-theme-switcher); [[ -n $theme ]] && omarchy-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Muurpapier","aliases":["background","wallpaper"],"action":"background=$(omarchy-theme-bg-switcher); [[ -n $background ]] && omarchy-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Ontsluit","aliases":["unlock"],"action":"unlock=$(omarchy-plymouth-switcher); if [[ $unlock == default ]]; then omarchy-launch-floating-terminal-with-presentation omarchy-plymouth-reset; elif [[ -n $unlock ]]; then omarchy-launch-floating-terminal-with-presentation \"omarchy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon":"","label":"Lettertipe","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Kieslysbalk"},
  "style.bar.position": {"icon":"","label":"Posisie"},
  "style.bar.transparency": {"icon":"󰂵","label":"Deursigtigheid","action":"omarchy-bar transparent toggle"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Skermskerm"},
  "style.about": {"icon":"","label":"Oor"},
  "style.bar.position.top": {"icon":"󰁝","label":"Bo","action":"omarchy-bar position top"},
  "style.bar.position.bottom": {"icon":"󰁅","label":"Onder","action":"omarchy-bar position bottom"},
  "style.bar.position.left": {"icon":"󰁍","label":"Links","action":"omarchy-bar position left"},
  "style.bar.position.right": {"icon":"󰁔","label":"Regs","action":"omarchy-bar position right"},
  "style.about.text": {"icon":"","label":"Redigeer teks","action":"omarchy-branding-about text"},
  "style.about.image": {"icon":"","label":"Stel vanaf prent","action":"omarchy-branding-about image"},
  "style.about.default": {"icon":"","label":"Herstel na verstek","action":"omarchy-branding-about reset"},
  "style.screensaver.text": {"icon":"","label":"Redigeer teks","action":"omarchy-branding-screensaver text"},
  "style.screensaver.image": {"icon":"","label":"Stel vanaf prent","action":"omarchy-branding-screensaver image"},
  "style.screensaver.default": {"icon":"","label":"Herstel na verstek","action":"omarchy-branding-screensaver reset"},

  // Setup
  "setup.monitors": {"icon":"󰍹","label":"Monitors","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/monitors.lua\""},
  "setup.keybindings": {"icon":"","label":"Sleutelkortpaaie","when":"[[ -f ~/.config/hypr/bindings.lua ]]","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/bindings.lua\""},
  "setup.input": {"icon":"","label":"Toevoer","when":"[[ -f ~/.config/hypr/input.lua ]]","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/input.lua\""},
  "setup.network": {"icon":"󰛳","label":"Netwerk","aliases":["network"]},
  "setup.network.dns": {"icon":"󰇖","label":"DNS","aliases":["dns"]},
  "setup.network.dns.dhcp": {"icon":"󰩟","label":"DHCP","checked":"[[ \"$(omarchy-dns)\" == \"DHCP\" ]]","action":"omarchy-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon":"󰅟","label":"Cloudflare","checked":"[[ \"$(omarchy-dns)\" == \"Cloudflare\" ]]","action":"omarchy-dns Cloudflare"},
  "setup.network.dns.google": {"icon":"󰊭","label":"Google","checked":"[[ \"$(omarchy-dns)\" == \"Google\" ]]","action":"omarchy-dns Google"},
  "setup.network.dns.custom": {"icon":"","label":"Pasgemaak","checked":"[[ \"$(omarchy-dns)\" == \"Custom\" ]]","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-dns Custom'"},
  "setup.network.qr": {"icon":"󰐲","label":"QR-kode","aliases":["wifi-qr"],"when":"[[ $(omarchy-network-status) == wifi* ]]","action":"omarchy-shell shell summon omarchy.wifiqr"},
  "setup.default": {"icon":"","label":"Verstekwaardes","aliases":["default","defaults"]},
  "setup.default.agent": {"icon":"󰚩","label":"Agent","title":"Verstek-agent"},
  "setup.default.agent.claude": {"icon":"󰛄","label":"Claude","checked":"[[ \"$(omarchy-default-agent)\" == \"claude\" ]]","action":"omarchy-default-agent claude"},
  "setup.default.agent.codex": {"icon":"","iconFont":"omarchy","label":"Codex","checked":"[[ \"$(omarchy-default-agent)\" == \"codex\" ]]","action":"omarchy-default-agent codex"},
  "setup.default.agent.copilot": {"icon":"","label":"Copilot","checked":"[[ \"$(omarchy-default-agent)\" == \"copilot\" ]]","action":"omarchy-default-agent copilot"},
  "setup.default.agent.crush": {"icon":"󰋑","label":"Crush","checked":"[[ \"$(omarchy-default-agent)\" == \"crush\" ]]","action":"omarchy-default-agent crush"},
  "setup.default.agent.cursor-agent": {"icon":"","iconFont":"omarchy","label":"Cursor CLI","checked":"[[ \"$(omarchy-default-agent)\" == \"cursor-agent\" ]]","action":"omarchy-default-agent cursor-agent"},
  "setup.default.agent.gemini": {"icon":"󰫢","label":"Gemini","checked":"[[ \"$(omarchy-default-agent)\" == \"gemini\" ]]","action":"omarchy-default-agent gemini"},
  "setup.default.agent.grok": {"icon":"","iconFont":"omarchy","label":"Grok","checked":"[[ \"$(omarchy-default-agent)\" == \"grok\" ]]","action":"omarchy-default-agent grok"},
  "setup.default.agent.hermes": {"icon":"","iconFont":"omarchy","label":"Hermes","checked":"[[ \"$(omarchy-default-agent)\" == \"hermes\" ]]","action":"omarchy-default-agent hermes"},
  "setup.default.agent.muse": {"icon":"󰛤","label":"Muse Code","checked":"[[ \"$(omarchy-default-agent)\" == \"muse\" ]]","action":"omarchy-default-agent muse"},
  "setup.default.agent.omp": {"icon":"","iconFont":"omarchy","label":"omp","checked":"[[ \"$(omarchy-default-agent)\" == \"omp\" ]]","action":"omarchy-default-agent omp"},
  "setup.default.agent.openclaw": {"icon":"","iconFont":"omarchy","label":"OpenClaw","checked":"[[ \"$(omarchy-default-agent)\" == \"openclaw\" ]]","action":"omarchy-default-agent openclaw"},
  "setup.default.agent.opencode": {"icon":"","iconFont":"omarchy","label":"OpenCode","checked":"[[ \"$(omarchy-default-agent)\" == \"opencode\" ]]","action":"omarchy-default-agent opencode"},
  "setup.default.agent.pi": {"icon":"","iconFont":"omarchy","label":"Pi","checked":"[[ \"$(omarchy-default-agent)\" == \"pi\" ]]","action":"omarchy-default-agent pi"},
  "setup.default.browser": {"icon":"","label":"Webblaaier","title":"Verstek-webblaaier"},
  "setup.default.browser.chromium": {"icon":"","label":"Chromium","when":"omarchy-cmd-present chromium","checked":"[[ \"$(omarchy-default-browser)\" == \"chromium\" ]]","action":"omarchy-default-browser chromium"},
  "setup.default.browser.chrome": {"icon":"󰊯","label":"Chrome","when":"omarchy-cmd-present google-chrome-stable","checked":"[[ \"$(omarchy-default-browser)\" == \"chrome\" ]]","action":"omarchy-default-browser chrome"},
  "setup.default.browser.brave": {"icon":"󰖟","label":"Brave","when":"omarchy-cmd-present brave","checked":"[[ \"$(omarchy-default-browser)\" == \"brave\" ]]","action":"omarchy-default-browser brave"},
  "setup.default.browser.brave-origin": {"icon":"󰖟","label":"Brave Origin","when":"omarchy-cmd-present brave-origin","checked":"[[ \"$(omarchy-default-browser)\" == \"brave-origin\" ]]","action":"omarchy-default-browser brave-origin"},
  "setup.default.browser.edge": {"icon":"󰇩","label":"Edge","when":"omarchy-cmd-present microsoft-edge-stable","checked":"[[ \"$(omarchy-default-browser)\" == \"edge\" ]]","action":"omarchy-default-browser edge"},
  "setup.default.browser.firefox": {"icon":"","label":"Firefox","when":"omarchy-cmd-present firefox","checked":"[[ \"$(omarchy-default-browser)\" == \"firefox\" ]]","action":"omarchy-default-browser firefox"},
  "setup.default.browser.zen": {"icon":"󰖟","label":"Zen","when":"omarchy-cmd-present zen-browser","checked":"[[ \"$(omarchy-default-browser)\" == \"zen\" ]]","action":"omarchy-default-browser zen"},
  "setup.default.terminal": {"icon":"","label":"Terminaal","title":"Verstek-terminaal"},
  "setup.default.terminal.alacritty": {"icon":"","label":"Alacritty","when":"omarchy-cmd-present alacritty","checked":"[[ \"$(omarchy-default-terminal)\" == \"alacritty\" ]]","action":"omarchy-default-terminal alacritty"},
  "setup.default.terminal.foot": {"icon":"","label":"Foot","when":"omarchy-cmd-present foot","checked":"[[ \"$(omarchy-default-terminal)\" == \"foot\" ]]","action":"omarchy-default-terminal foot"},
  "setup.default.terminal.ghostty": {"icon":"","label":"Ghostty","when":"omarchy-cmd-present ghostty","checked":"[[ \"$(omarchy-default-terminal)\" == \"ghostty\" ]]","action":"omarchy-default-terminal ghostty"},
  "setup.default.terminal.kitty": {"icon":"","label":"Kitty","when":"omarchy-cmd-present kitty","checked":"[[ \"$(omarchy-default-terminal)\" == \"kitty\" ]]","action":"omarchy-default-terminal kitty"},
  "setup.default.editor": {"icon":"","label":"Redigeerder","title":"Verstek-redigeerder"},
  "setup.default.editor.neovim": {"icon":"","label":"Neovim","when":"omarchy-cmd-present nvim","checked":"[[ \"$(omarchy-default-editor)\" == \"nvim\" ]]","action":"omarchy-default-editor nvim"},
  "setup.default.editor.vscode": {"icon":"","label":"VSCode","when":"omarchy-cmd-present code","checked":"[[ \"$(omarchy-default-editor)\" == \"code\" ]]","action":"omarchy-default-editor code"},
  "setup.default.editor.cursor": {"icon":"","iconFont":"omarchy","label":"Cursor","when":"omarchy-cmd-present cursor","checked":"[[ \"$(omarchy-default-editor)\" == \"cursor\" ]]","action":"omarchy-default-editor cursor"},
  "setup.default.editor.zed": {"icon":"","label":"Zed","when":"omarchy-cmd-present zeditor","checked":"[[ \"$(omarchy-default-editor)\" == \"zeditor\" ]]","action":"omarchy-default-editor zed"},
  "setup.default.editor.sublime": {"icon":"","label":"Sublime Text","when":"omarchy-cmd-present sublime_text","checked":"[[ \"$(omarchy-default-editor)\" == \"sublime_text\" ]]","action":"omarchy-default-editor sublime_text"},
  "setup.default.editor.helix": {"icon":"","label":"Helix","when":"omarchy-cmd-present helix","checked":"[[ \"$(omarchy-default-editor)\" == \"helix\" ]]","action":"omarchy-default-editor helix"},
  "setup.default.editor.vim": {"icon":"","label":"Vim","when":"omarchy-cmd-present vim","checked":"[[ \"$(omarchy-default-editor)\" == \"vim\" ]]","action":"omarchy-default-editor vim"},
  "setup.default.editor.emacs": {"icon":"","label":"Emacs","when":"omarchy-cmd-present emacs","checked":"[[ \"$(omarchy-default-editor)\" == \"emacs\" ]]","action":"omarchy-default-editor emacs"},
  "setup.plugin": {"icon":"󰐱","label":"Plugins","aliases":["plugin","plugins"]},
  "setup.plugin.enable": {"icon":"󰄬","label":"Aktiveer inprop","action":"omarchy-menu-plugin enable"},
  "setup.plugin.disable": {"icon":"󰅖","label":"Deaktiveer inprop","action":"omarchy-menu-plugin disable"},
  "setup.plugin.add": {"icon":"󰖟","label":"Voeg inprop by","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-plugin-add'"},
  "setup.plugin.clone": {"icon":"󰆏","label":"Kloon inprop","action":"omarchy-menu-plugin clone"},
  "setup.plugin.remove": {"icon":"󰭌","label":"Verwyder inprop","when":"compgen -G \"$HOME/.config/omarchy/plugins/*/manifest.json\"","action":"omarchy-menu-plugin remove"},
  "setup.security": {"icon":"","label":"Sekuriteit"},
  "setup.config": {"icon":"","label":"Konfigurasie"},
  "setup.security.fingerprint": {"icon":"󰈷","label":"Vingerafdruk","when":"omarchy-hw-fingerprint","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-fingerprint"},
  "setup.security.fido2": {"icon":"","label":"Fido2","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-fido2"},
  "setup.security.sshd": {"icon":"󰣀","label":"SSHD","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-sshd"},
  "setup.security.passwordless-sudo": {"icon":"󰟵","label":"Wagwoordlose Sudo","action":"omarchy-launch-floating-terminal-with-presentation omarchy-sudo-passwordless"},
  "setup.security.sudoless-docker": {"icon":"󰡨","label":"Sudolose Docker","when":"omarchy-sudo-docker --configured","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-security-sudoless-docker"},
  "setup.config.hyprland": {"icon":"","label":"Hyprland","action":"omarchy-launch-config-editor \"$HOME/.config/hypr/hyprland.lua\""},
  "setup.config.hyprsunset": {"icon":"","label":"Hyprsunset","action":"omarchy-launch-config-editor ~/.config/hypr/hyprsunset.conf && omarchy-restart-hyprsunset"},
  "setup.config.xcompose": {"icon":"󰞅","label":"XCompose","action":"omarchy-launch-config-editor ~/.XCompose && omarchy-restart-xcompose"},
  "setup.direct-boot": {"icon":"","label":"Direkte herlaai","action":"omarchy-launch-floating-terminal-with-presentation omarchy-setup-direct-boot"},
  "setup.reset": {"icon":"󰑓","label":"Herstel rekenaar","when":"[[ $(findmnt -no FSTYPE /) == btrfs ]]","action":"omarchy-launch-floating-terminal-with-presentation omarchy-system-factory-reset"},

  // Install
  "install.package": {"icon":"󰣇","label":"Pakket","action":"xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-install"},
  "install.aur": {"icon":"󰣇","label":"AUR","action":"xdg-terminal-exec --app-id=org.omarchy.terminal omarchy-pkg-aur-install"},
  "install.webapp": {"icon":"","label":"Webtoepassing","action":"omarchy-launch-floating-terminal-with-presentation omarchy-webapp-install"},
  "install.tui": {"icon":"","label":"TUI","action":"omarchy-launch-floating-terminal-with-presentation omarchy-tui-install"},
  "install.style": {"icon":"","label":"Styl"},
  "install.style.theme": {"icon":"󰸌","label":"Tema","action":"omarchy-launch-floating-terminal-with-presentation omarchy-theme-install"},
  "install.style.background": {"icon":"","label":"Muurpapier","action":"omarchy-theme-bg-install"},

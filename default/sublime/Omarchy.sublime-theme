{
  "extends": "Adaptive.sublime-theme",
  "variables": {
    "dark_bg": "var(--background)",
    "medium_dark_bg": "var(--background)",
    "medium_bg": "var(--background)",
    "light_bg": "var(--background)",
    "tabset_dark_bg": "var(--background)",
    "tabset_medium_dark_bg": "var(--background)",
    "tabset_medium_bg": "var(--background)",
    "tabset_light_bg": "var(--background)",
    "file_tab_unselected_label_color": "color(var(--foreground) a(0.58))",
    "file_tab_unselected_light_label_color": "color(var(--foreground) a(0.58))",
    "file_tab_selected_label_color": "var(--foreground)",
    "file_tab_selected_light_label_color": "var(--foreground)",
    "file_tab_angled_unselected_label_color": "color(var(--foreground) a(0.58))",
    "file_tab_angled_unselected_medium_label_color": "color(var(--foreground) a(0.58))",
    "file_tab_angled_unselected_light_label_color": "color(var(--foreground) a(0.58))",
    "adaptive_dividers": "color(var(--foreground) a(0.16))",
    "tool_tip_bg": "var(--background)",
    "tool_tip_fg": "var(--foreground)",
    "link_fg": "var(--accent)",
    "radio_selected": "var(--accent)",
    "checkbox_selected": "var(--accent)",
    "auto_complete_selected_row_dark_tint": "color(var(--accent) a(0.20))",
    "auto_complete_selected_row_light_tint": "color(var(--accent) a(0.20))",
    "kind_function_color": "var(--bluish)",
    "kind_keyword_color": "var(--purplish)",
    "kind_markup_color": "var(--orangish)",
    "kind_namespace_color": "var(--cyanish)",
    "kind_type_color": "var(--yellowish)"
  },
  "rules": [
    { "class": "tabset_control", "tab_height": 30, "tab_overlap": 0 },
    { "class": "tab_control", "layer0.texture": "", "layer1.texture": "", "layer2.texture": "", "layer3.texture": "", "layer0.tint": "var(--background)", "layer0.opacity": 1.0, "layer1.opacity": 0.0, "layer2.opacity": 0.0, "layer3.opacity": 0.0, "content_margin": [12, 3, 10, 3] },
    { "class": "tab_control", "attributes": ["hover"], "layer0.tint": "color(var(--foreground) a(0.07))" },
    { "class": "tab_control", "attributes": ["selected"], "layer0.tint": "color(var(--accent) a(0.12))" },
    { "class": "sidebar_container", "layer0.tint": "var(--background)" },
    { "class": "sidebar_tree", "row_padding": [12, 3, 6, 3], "indent": 12, "spacer_rows": false },
    { "class": "sidebar_heading", "fg": "var(--accent)", "shadow_color": "transparent", "font.size": 11 },
    { "class": "sidebar_label", "fg": "color(var(--foreground) a(0.76))" },
    { "class": "sidebar_label", "parents": [{"class": "tree_row", "attributes": ["selected"]}], "fg": "var(--foreground)" },
    { "class": "tree_row", "attributes": ["selectable", "hover"], "layer0.tint": "color(var(--accent) a(0.09))", "layer0.opacity": 1.0 },
    { "class": "tree_row", "attributes": ["selected"], "layer0.tint": "color(var(--accent) a(0.18))", "layer0.opacity": 1.0 },
    { "class": "status_bar", "layer0.tint": "var(--background)" },
    { "class": "panel_control", "layer0.tint": "var(--background)" },
    { "class": "quick_panel", "layer0.tint": "var(--background)" },
    { "class": "auto_complete_popup", "layer0.tint": "var(--background)" }
  ]
}

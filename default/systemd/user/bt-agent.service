[Unit]
Description=Bluetooth pairing agent (auto-accept)
Documentation=man:bt-agent(1)
ConditionPathIsDirectory=/sys/class/bluetooth
# bluez must be reachable on the system bus before we can register.
# Do not add system-manager bluetooth unit deps from this user unit: the user
# manager cannot load system units, so those deps are inert. Wait for
# bluetoothd in ExecStart instead (see Service).
# Order after graphical-session.target so a bluez wait cannot hold the
# session target / uwsm-app launches open (see omarchy-migrate-notify).
After=dbus.socket graphical-session.target
Requires=dbus.socket

[Service]
Type=simple
# Wait for bluetoothd inside ExecStart (not ExecCondition / ExecStartPre).
# ExecCondition skip is terminal for the session across a bluez race.
# ExecStartPre would hold graphical-session.target for the whole wait.
# gdbus blocks until bluetoothd claims org.bluez (bluetooth.service is
# Type=dbus, so that is when it goes active), with no restart storm or
# polling while bluetoothd is off; Restart=on-failure still recovers after
# mid-session bluez restarts because bt-agent exits 1 when released.
# NoInputNoOutput auto-accepts pair requests. Safe because the adapter
# is only `pairable: true` when the user explicitly opens the omarchy
# bluetoothPanel and starts scanning; outside that window bluez refuses
# inbound pair attempts at a lower layer.
ExecStart=/usr/bin/bash -c '/usr/bin/gdbus wait --system org.bluez && exec /usr/bin/bt-agent -c NoInputNoOutput'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

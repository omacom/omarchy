[Unit]
Description=Warn before systemd-oomd kills an app, pause the runaway first, and say what it killed
# Needs the session bus to notify, and OMARCHY_PATH, which UWSM imports, for
# the commands it runs.
After=graphical-session.target wayland-session-waitenv.service
PartOf=graphical-session.target
ConditionEnvironment=OMARCHY_PATH
ConditionEnvironment=WAYLAND_DISPLAY
# Opt-in, set by omarchy-toggle-memory-watch.
ConditionPathExists=%h/.local/state/omarchy/toggles/memory-watch-on

[Service]
# Started only once the command could be run, so the toggle sees a failure.
Type=exec
ExecStart=/usr/bin/omarchy-memory-watch
Restart=always
RestartSec=3
# A user service lands in app.slice by default, which is exactly what
# systemd-oomd picks from. Beside the compositor, it is never a candidate and
# is still running to report the kill.
Slice=session.slice
CPUWeight=1000
# No OOMScoreAdjust or MemoryLow: the user manager runs at oom_score_adj 100
# and cannot lower its children below that, and no ancestor of session.slice
# sets memory.low for this to draw on, so either would be a silent no-op.

[Install]
WantedBy=graphical-session.target

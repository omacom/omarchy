[Unit]
Description=Backstop polling for unauthorized Thunderbolt devices
# The path unit relies on kernfs inotify, which has had kernel-specific gaps
# where sysfs changes never deliver events. This timer guarantees a check at
# worst every ~30s so a waiting device is never silently skipped because the
# watch went quiet.
# Conditions here (not just in the service) keep the timer from firing every
# 30s for users who opted out. No hardware check here on purpose: the bus
# exists whenever the thunderbolt module is loaded, and a controller can be
# fully powered down by firmware, so a missing domain* says nothing about
# whether a device might be plugged in later. Conditions are only evaluated
# at unit start and a skipped timer is not retried, so a hardware-based
# condition here could silence detection for a whole session.
ConditionPathExists=!%h/.local/state/omarchy/toggles/thunderbolt-auth-off

[Timer]
OnBootSec=45s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=omarchy-thunderbolt-notify.service

[Install]
WantedBy=timers.target

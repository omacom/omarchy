[Unit]
Description=Automatic screen rotation (GPD Pocket 4 accelerometer via iio-sensor-proxy)
# Only the internal panel of a GPD Pocket 4 needs this; other hardware stays
# inert even though the unit ships (and is enabled) everywhere.
ConditionPathIsDirectory=/sys/bus/iio/devices
ConditionEnvironment=OMARCHY_PATH
ConditionEnvironment=WAYLAND_DISPLAY
PartOf=graphical-session.target
After=graphical-session.target wayland-session-waitenv.service

[Service]
Type=simple
# Skip cleanly instead of restart-looping on machines without the hardware.
# ${OMARCHY_PATH} follows a linked checkout; /usr/bin is the packaged copy
# and is missing until the omarchy package is rebuilt.
ExecCondition=${OMARCHY_PATH}/bin/omarchy-hw-gpd-pocket-4
ExecStart=${OMARCHY_PATH}/bin/omarchy-hw-gpd-pocket-4-rotate
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

[Unit]
Description=Recover the internal monitor toggles when no external display is connected
Before=graphical-session-pre.target
ConditionPathIsDirectory=%h/.local/state/omarchy/toggles/hypr

[Service]
Type=oneshot
ExecStart=/usr/bin/omarchy-hw-recover-internal-monitor

[Install]
WantedBy=graphical-session-pre.target

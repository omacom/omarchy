[Unit]
Description=Bluetooth file receiving (Object Push from paired devices)
Documentation=man:org.bluez.obex.Agent(5)
ConditionPathIsDirectory=/sys/class/bluetooth
# The agent starts obexd itself so it can point obexd's root folder at the
# download directory it resolves; obexd registers the profile with bluetoothd
# over the system bus.
After=dbus.socket
Requires=dbus.socket

[Service]
Type=simple
# If bluetoothd is unavailable (for example in VMs or machines without a
# usable adapter), skip cleanly instead of entering a restart loop.
ExecCondition=/usr/bin/systemctl is-active --quiet bluetooth.service
# The agent is the receiver's decision point: obexd asks it before every push
# it stores. It accepts only senders BlueZ still lists as paired, and claims
# the destination name itself with O_EXCL, so a push can never land on an
# existing download. Nothing enables this unit but `omarchy bluetooth files
# on` and the panel switch, so receiving stays opt-in and stops again with the
# block that turns Bluetooth off.
ExecStart=/usr/bin/omarchy-bluetooth-files-agent
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

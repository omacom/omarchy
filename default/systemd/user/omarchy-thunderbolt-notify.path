[Unit]
Description=Watch the Thunderbolt bus for device changes
# Best-effort instant trigger: PathChanged on the devices directory may fire
# on some kernels when a Thunderbolt device connects, but kernfs does not
# deliver create events reliably -- the 30s backstop timer is what guarantees
# detection. This unit shortens the wait when the event does arrive.
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=!%h/.local/state/omarchy/toggles/thunderbolt-auth-off

[Path]
PathChanged=/sys/bus/thunderbolt/devices
Unit=omarchy-thunderbolt-notify.service

[Install]
WantedBy=graphical-session.target

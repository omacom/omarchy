# Installs the region's default packages (default/regions/<region>/packages)
# once the machine is online, retrying until it succeeds once. Enabled for
# regions with packages by install/config/region.sh.
[Unit]
Description=Omarchy regional default packages
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/omarchy/region
ConditionPathExists=!/var/lib/omarchy/region-packages-installed

[Service]
Type=oneshot
Environment=OMARCHY_PATH=/usr/share/omarchy
ExecStart=/usr/bin/omarchy-region-packages
Restart=on-failure
RestartSec=10min
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target

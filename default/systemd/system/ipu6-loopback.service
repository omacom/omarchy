[Unit]
Description=Create the Intel IPU6 webcam virtual camera
After=systemd-modules-load.service

[Service]
# Reruns on every relay start, so a deleted or unloaded device comes back.
Type=oneshot
ExecStart=/usr/bin/modprobe v4l2loopback
ExecStart=/bin/sh -c 'grep -qsx "Built-in Front Camera" /sys/devices/virtual/video4linux/*/name || exec v4l2loopback-ctl add -n "Built-in Front Camera" -x 1'

[Unit]
Description=Omarchy CPU frequency floor for the power profile
After=power-profiles-daemon.service systemd-logind.service

[Service]
ExecStart=/usr/bin/omarchy-powerprofiles-floor monitor
ExecStopPost=/usr/bin/omarchy-powerprofiles-floor release
Restart=on-failure
RestartSec=2
# Setting another process's utilisation clamp needs CAP_SYS_NICE, and only that
CapabilityBoundingSet=CAP_SYS_NICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
# power-profiles-daemon.service is ordered after multi-user.target, and a
# target starts after everything it wants. Wanted by multi-user.target, this
# unit would have to start both before that target and after it, and systemd
# breaks the cycle at boot by dropping this unit's start.
WantedBy=graphical.target

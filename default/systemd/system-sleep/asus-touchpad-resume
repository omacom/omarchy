#!/bin/bash

# Rebind the ASUS ASUP1206 I2C touchpad after a failed s2idle resume.
#
# On affected systems, i2c_hid_acpi can leave the touchpad present but
# unresponsive after reporting -121 from its resume callback. Rebinding only
# this device forces a fresh HID probe without disturbing other I2C devices.

device=i2c-ASUP1206:00
driver=/sys/bus/i2c/drivers/i2c_hid_acpi
attempts=5

if [[ $1 == "post" && -e $driver/$device ]]; then
  if ! echo "$device" > "$driver/unbind"; then
    echo "Could not unbind $device; leaving the touchpad as it is" >&2
    exit 1
  fi

  # A fresh probe can fail while the controller is still waking up, so retry.
  # Keep it bounded: systemd-sleep waits for every hook before resume finishes.
  for (( attempt = 1; attempt <= attempts; attempt++ )); do
    sleep 1
    echo "$device" > "$driver/bind" && exit 0
  done

  echo "Could not rebind $device after $attempts attempts; the touchpad stays unbound until reboot" >&2
  exit 1
fi

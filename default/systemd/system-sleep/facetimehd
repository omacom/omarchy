#!/bin/bash

# The pre-T2 FaceTime HD camera driver (bcwc_pcie, AUR facetimehd-dkms-git)
# deadlocks the machine during hibernation: its PCI suspend runs inside the
# kernel's device-freeze and the system hangs at "PM: hibernation: hibernation
# entry", before the image is written. Keeping it unloaded for the freeze and
# loading it again after resume avoids the hang; S3 does not need this, so it
# is left alone there.

module=${OMARCHY_FACETIMEHD_MODULE:-/sys/module/facetimehd}
marker=${OMARCHY_FACETIMEHD_MARKER:-/run/omarchy-facetimehd-unloaded}
sleep_action=${SYSTEMD_SLEEP_ACTION:-$2}

case "$1" in
  pre)
    # A marker only ever means this cycle unloaded the driver.
    rm -f "$marker"

    # hybrid-sleep writes the same image as hibernate, so it freezes the same way.
    if [[ $sleep_action == "hibernate" || $sleep_action == "hybrid-sleep" ]] && [[ -d $module ]]; then
      if modprobe -r facetimehd 2>/dev/null; then
        touch "$marker"
      fi
    fi
    ;;
  post)
    # Reload only what pre unloaded, so a driver the user removed stays removed.
    if [[ -e $marker ]]; then
      rm -f "$marker"
      modprobe facetimehd 2>/dev/null || true
    fi
    ;;
esac

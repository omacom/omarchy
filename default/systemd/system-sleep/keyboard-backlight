#!/bin/bash

# Turn off keyboard backlight before hibernate to prevent hang on power-off.
# The ASUS keyboard controller can block S4 shutdown if LEDs are active.
#
# Clearing the LED is one-way — the level cannot be read back once it is 0 — so
# the keyboard came back dark after every hibernate and stayed that way until a
# brightness key was pressed. Record the level before the clear and write it
# back in the post phase.

sleep_action=${SYSTEMD_SLEEP_ACTION:-$2}
level_record=/run/omarchy-keyboard-backlight-level

read_level() {
  local value
  value=$(cat "/sys/class/leds/$1/brightness" 2>/dev/null) || value=0

  if [[ $value =~ ^[0-9]+$ ]]; then
    printf '%s' "$value"
  else
    printf '0'
  fi
}

device=""
for candidate in /sys/class/leds/*kbd_backlight*; do
  if [[ -e $candidate ]]; then
    device="$(basename "$candidate")"
    break
  fi
done

if [[ -z $device || $sleep_action != "hibernate" ]]; then
  exit 0
fi

led=/sys/class/leds/$device/brightness

if [[ $1 == "pre" ]]; then
  printf '%s %s\n' "$device" "$(read_level "$device")" >"$level_record"
  printf '0\n' >"$led" 2>/dev/null
else
  if [[ -r $level_record ]]; then
    read -r recorded_device level <"$level_record"
    rm -f "$level_record"

    # The level belongs to the keyboard it was read from, wherever it now sorts.
    recorded_led=/sys/class/leds/$recorded_device/brightness

    # A lit LED wins: the idle-restore plugin or a lock's own restore may have
    # put a level back already, and this must not fight either of them.
    if [[ $recorded_device == *kbd_backlight* && $recorded_device != */* && -e $recorded_led && $level =~ ^[0-9]+$ ]] &&
      (( level > 0 )) && (( $(read_level "$recorded_device") == 0 )); then
      printf '%s\n' "$level" >"$recorded_led" 2>/dev/null
    fi
  fi
fi

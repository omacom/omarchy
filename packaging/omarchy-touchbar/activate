#!/bin/bash -p
# Root-owned package activation boundary; fixed tools and protected startup.
set -euo pipefail
[[ $- == *p* ]] || exit 126
(( EUID == 0 )) || exit 1

live=0
[[ ! -d /run/systemd/system ]] || live=1
config=/etc/tiny-dfr/config.toml
retired_config=""
retire_managed_config() {
  if [[ -f $config && ! -L $config ]] && { /usr/bin/grep -Fq 'Generated by io.github.austindixson.touchbar' "$config" || /usr/bin/grep -Fq 'Omarchy Apple Silicon Touch Bar' "$config"; }; then
    # Stock tiny-dfr cannot use the package-owned logo after replacement.
    # Keep the user's generated config as a backup and use stock defaults.
    retired_config="$config.omarchy-touchbar-backup-$(/usr/bin/date +%s)-$$"
    /usr/bin/mv -- "$config" "$retired_config" || return 1
  fi
}
restore_stock() {
  retire_managed_config || return 1
  if ! /usr/bin/pacman -S --noconfirm --ask 4 -- tiny-dfr; then
    if [[ -n $retired_config && -f $retired_config ]]; then
      /usr/bin/mv -- "$retired_config" "$config"
    fi
    return 1
  fi
}
if [[ ${1:-} == "--uninstall" && $# == 1 ]]; then
  restore_stock
  if (( live )); then
    /usr/bin/systemctl daemon-reload
    /usr/bin/systemctl restart tiny-dfr.service
  fi
  exit 0
fi
/usr/bin/python3 -I /usr/lib/omarchy-touchbar/hardware.py || exit 0
owner=""
if [[ ${1:-} == "--user" && $# == 2 ]]; then
  owner=$2
elif (( $# )); then
  exit 2
fi

if [[ -L /etc/tiny-dfr || -L $config ]]; then
  echo 'Refusing a symlinked Touch Bar configuration.' >&2
  exit 1
fi
if [[ ! -e $config ]]; then
  /usr/bin/install -D -m 644 /usr/share/omarchy-touchbar/default.toml "$config"
elif ! /usr/bin/grep -Fq 'Generated by io.github.austindixson.touchbar' "$config" && ! /usr/bin/grep -Fq 'Omarchy Apple Silicon Touch Bar' "$config"; then
  echo "Preserved custom $config; back it up and remove it before managed setup." >&2
  exit 1
fi
if [[ -n $owner ]]; then
  font_uid=$(/usr/bin/id -u -- "$owner")
  font_gid=$(/usr/bin/id -g -- "$owner")
  [[ $font_uid =~ ^[0-9]+$ && $font_gid =~ ^[0-9]+$ && $font_uid != 0 ]] || exit 1
  /usr/lib/omarchy-touchbar/setup-font-channel "$font_uid" "$font_gid"
  temporary=$(/usr/bin/mktemp /etc/tiny-dfr/.font-XXXXXX)
  trap '/usr/bin/rm -f -- "$temporary"' EXIT
  printf 'FontSyncUid = %s\n' "$font_uid" > "$temporary"
  /usr/bin/sed '/^FontSyncUid = /d' "$config" >> "$temporary"
  /usr/bin/chmod 644 "$temporary"
  /usr/bin/mv -f -- "$temporary" "$config"
fi
rollback() {
  echo 'Touch Bar startup failed; restoring stock tiny-dfr.' >&2
  restore_stock
  if (( live )); then
    /usr/bin/systemctl daemon-reload
    /usr/bin/systemctl restart tiny-dfr.service
  fi
  exit 1
}
[[ $(/usr/bin/omarchy-touchbar --capabilities) == "trace-animation ttfx-wipe" ]] || rollback
/usr/bin/omarchy-touchbar --check-config || rollback
# Remove only the exact service override produced by the early local installer.
legacy=/etc/systemd/system/tiny-dfr.service.d/90-omarchy-animation.conf
expected=$'[Service]\nExecStart=\nExecStart=/usr/local/libexec/tiny-dfr-omarchy'
if [[ -f $legacy && ! -L $legacy && $(<"$legacy") == "$expected" ]]; then
  /usr/bin/rm -- "$legacy"
fi
# An ISO chroot has neither devices nor systemd. udev starts the service on the
# installed model at boot; runtime setup verifies the actual service invocation.
if (( live )); then
  /usr/bin/systemctl daemon-reload || rollback
  /usr/bin/systemctl restart tiny-dfr.service || rollback
  /usr/bin/sleep 1
  invocation=$(/usr/bin/systemctl show tiny-dfr.service -p InvocationID --value) || rollback
  startup_log=$(/usr/bin/journalctl --no-pager "_SYSTEMD_INVOCATION_ID=$invocation") || rollback
  if ! /usr/bin/systemctl is-active --quiet tiny-dfr.service || [[ $startup_log == *"panicked at"* ]]; then
    rollback
  fi
fi

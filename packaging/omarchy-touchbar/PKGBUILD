# Maintainer: Guilherme Rossi Brum
pkgname=omarchy-touchbar
pkgver=0.3.8.omarchy1
pkgrel=2
pkgdesc='Omarchy Touch Bar daemon: branching logo animation, tap/hold actions and desktop font sync'
arch=('aarch64')
url='https://github.com/guirossibrum/omarchy-touchbar'
license=('MIT' 'Apache-2.0')
depends=('cairo' 'fontconfig' 'freetype2' 'gcc-libs' 'glib2' 'glibc' 'libinput' 'librsvg' 'systemd-libs' 'python')
makedepends=('git' 'pkgconf' 'rust')
provides=('tiny-dfr=0.3.8')
conflicts=('tiny-dfr')
install=omarchy-touchbar.install
_commit=6b77e96f8cef5ddf5c6c5c5b4a003b477f342ec9
_plugin_commit=1c1f34ac84459017b320123b57f5e14e7427ab7a
source=("tiny-dfr::git+https://github.com/guirossibrum/tiny-dfr.git#commit=$_commit"
        "companion::git+https://github.com/guirossibrum/omarchy-touchbar.git#commit=$_plugin_commit"
        'setup-font-channel' 'activate' 'render-default.py')
sha256sums=('SKIP' 'SKIP' '2a1a489b021b510f833d1a1aff961cf8af2dc5d337649c2defe4d182598160a7' 'bbcd784a76f450421882eb642eb400de0da5874fada20b3a0e32f8565d26e616' '86879d28eecd4ab58eff94adf1920340079584e639fbff7ad289e967571195ab')

prepare() {
  cd tiny-dfr
  cargo fetch --locked
}

build() {
  cd tiny-dfr
  cargo build --release --frozen --jobs 2 --bin tiny-dfr
}

check() {
  cd tiny-dfr
  cargo test --frozen --jobs 2
  [[ $(target/release/tiny-dfr --capabilities) == 'trace-animation ttfx-wipe' ]]
}

package() {
  cd tiny-dfr
  install -D -m 755 target/release/tiny-dfr "$pkgdir/usr/bin/omarchy-touchbar"
  ln -s omarchy-touchbar "$pkgdir/usr/bin/tiny-dfr"
  install -D -m 644 etc/systemd/system/tiny-dfr.service "$pkgdir/usr/lib/systemd/system/tiny-dfr.service"
  install -D -m 644 etc/udev/rules.d/*.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -D -m 644 share/tiny-dfr/* -t "$pkgdir/usr/share/tiny-dfr/"
  install -D -m 644 LICENSE LICENSE.material -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -D -m 755 "$srcdir/setup-font-channel" "$pkgdir/usr/lib/omarchy-touchbar/setup-font-channel"
  install -D -m 755 "$srcdir/activate" "$pkgdir/usr/lib/omarchy-touchbar/activate"
  install -D -m 644 "$srcdir/companion/hardware.py" "$pkgdir/usr/lib/omarchy-touchbar/hardware.py"

  # Explicit reviewed runtime allowlist: no repository metadata, tests, videos,
  # documentation, build outputs or mutable git checkout in the plugin tree.
  local plugin="$pkgdir/usr/share/omarchy/shell/plugins/touchbar"
  cd "$srcdir/companion"
  install -d "$plugin/assets" "$plugin/hooks"
  install -m 644 manifest.json Service.qml hardware.py sync-font.py layout.json layout-animated.json "$plugin/"
  install -m 755 apply.sh enable-animation.sh sync-font.sh "$plugin/"
  install -m 755 hooks/90-touchbar-font "$plugin/hooks/"
  # Keep hooks tied to the versioned package, never a stale user git clone.
  sed -i 's|$HOME/.config/omarchy/plugins/io.github.austindixson.touchbar/sync-font.sh|/usr/share/omarchy/shell/plugins/touchbar/sync-font.sh|' "$plugin/hooks/90-touchbar-font"
  install -m 644 assets/omarchy-green.svg assets/omarchy-trace.json "$plugin/assets/"
  printf '%s\n' "native=$_commit" "plugin=$_plugin_commit" > "$plugin/.omarchy-touchbar-package"
  install -D -m 644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE.plugin"
  install -D -m 644 assets/omarchy-green.svg "$pkgdir/usr/share/tiny-dfr/omarchy-green.svg"
  python "$srcdir/render-default.py" "$srcdir/companion" "$pkgdir/usr/share/omarchy-touchbar/default.toml"
}

#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEST_DIR="$ROOT/test/shell.d"

shopt -s nullglob
tests=()
for test in "$TEST_DIR"/*-test.sh; do
  [[ $(basename "$test") == "base-test.sh" ]] && continue
  tests+=("$test")
done
shopt -u nullglob

if (( ${#tests[@]} == 0 )); then
  echo "No shell tests found in $TEST_DIR" >&2
  exit 1
fi

uses_compositor() {
  grep -qE '^[[:space:]]*(require_compositor|require_quickshell)\b' "$1"
}

# Timing-sensitive files and tests that mutate shared compositor/shell state
# run one at a time after the parallel batches; everything else runs through
# a job pool sized to the machine. A file can also opt out of the pool with
# an `# omarchy:exclusive` marker near its top.
is_exclusive() {
  local name
  name=$(basename "$1")
  [[ $name == *budget* || $name == "sleep-lock-test.sh" || $name == "sleep-monitor-test.sh" || $name == "hyprland-window-close-all-test.sh" || $name == "remote-session-service-test.sh" ]] && return 0
  grep -q '# omarchy:exclusive' "$1"
}

# The idle-spawn guard spends most of its time passively watching its own
# shell's process tree through an exec logger, so non-compositor pool load
# cannot distort what it counts. It starts alongside the non-compositor pool
# while no other compositor test is running.
is_overlap() {
  [[ $(basename "$1") == "shell-idle-spawn-test.sh" ]]
}

parallel_noncomp_tests=()
parallel_comp_tests=()
exclusive_tests=()
overlap_tests=()
need_compositor=0
for test in "${tests[@]}"; do
  if uses_compositor "$test"; then
    need_compositor=1
  fi
  if is_overlap "$test"; then
    overlap_tests+=("$test")
  elif is_exclusive "$test"; then
    exclusive_tests+=("$test")
  elif uses_compositor "$test"; then
    parallel_comp_tests+=("$test")
  else
    parallel_noncomp_tests+=("$test")
  fi
done

# Start a private, headless nested Hyprland compositor when running inside an
# active Hyprland desktop session so compositor/Quickshell tests never appear
# on or steal focus from the user's active screen. Fails closed if the live
# desktop is present but the headless compositor cannot be established; set
# OMARCHY_TEST_USE_LIVE_COMPOSITOR=1 to use the live session directly (e.g.
# inside a disposable CI VM).
HEADLESS_DIR=""
HEADLESS_PID=""
HEADLESS_RT=""
HEADLESS_WL=""
HEADLESS_SIG=""
HEADLESS_DBUS=""

cleanup_headless() {
  if [[ -n $HEADLESS_DIR && -z $HEADLESS_PID && -s $HEADLESS_DIR/hypr.pid ]]; then
    HEADLESS_PID=$(<"$HEADLESS_DIR/hypr.pid")
  fi
  if [[ -n $HEADLESS_PID ]]; then
    kill -TERM -- "-$HEADLESS_PID" "$HEADLESS_PID" 2>/dev/null || true
    for _ in {1..30}; do
      kill -0 "$HEADLESS_PID" 2>/dev/null || break
      sleep 0.05
    done
    kill -KILL -- "-$HEADLESS_PID" "$HEADLESS_PID" 2>/dev/null || true
  fi
  [[ -n $HEADLESS_DIR && -d $HEADLESS_DIR ]] && rm -rf "$HEADLESS_DIR"
  return 0
}
trap cleanup_headless EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

fail_headless() {
  echo "test/shell: $1 (pass OMARCHY_TEST_USE_LIVE_COMPOSITOR=1 to run against the live desktop)" >&2
  if [[ -n $HEADLESS_DIR && -s $HEADLESS_DIR/hypr.log ]]; then
    tail -40 "$HEADLESS_DIR/hypr.log" >&2
  fi
  exit 1
}

start_headless_compositor() {
  (( need_compositor )) || return 0
  [[ ${OMARCHY_TEST_USE_LIVE_COMPOSITOR:-0} != "1" ]] || return 0
  [[ ${OMARCHY_TEST_HEADLESS_ACTIVE:-0} != "1" ]] || return 0
  [[ -n ${WAYLAND_DISPLAY:-} && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
  command -v Hyprland >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0

  local outer_rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  local outer_wl="$WAYLAND_DISPLAY"
  [[ $outer_wl == /* ]] || outer_wl="$outer_rt/$outer_wl"
  [[ -S $outer_wl ]] && hyprctl -j monitors >/dev/null 2>&1 || return 0

  # Short path so $XDG_RUNTIME_DIR/hypr/<sig>/.socket2.sock stays under the 108-byte Unix sun_path limit.
  HEADLESS_DIR=$(mktemp -d /tmp/oh.XXXXXX)
  mkdir -p "$HEADLESS_DIR/rt" "$HEADLESS_DIR/cfg"
  local sock
  for sock in bus pipewire-0 pulse; do
    [[ -e $outer_rt/$sock ]] && ln -s "$outer_rt/$sock" "$HEADLESS_DIR/rt/$sock"
  done

  cat >"$HEADLESS_DIR/cfg/hyprland.lua" <<'EOF'
hl.config({
  misc = {
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
  animations = {
    enabled = false,
  },
})
EOF

  cat >"$HEADLESS_DIR/run-hypr.sh" <<SH
#!/bin/bash
export XDG_RUNTIME_DIR=$(printf '%q' "$HEADLESS_DIR/rt")
export WAYLAND_DISPLAY=$(printf '%q' "$outer_wl")
unset HYPRLAND_INSTANCE_SIGNATURE DISPLAY
export HYPRLAND_NO_CRASHREPORTER=1
export HYPRLAND_NO_SD_NOTIFY=1
export HYPRLAND_NO_SD_VARS=1
export HYPRLAND_NO_RT=1
ulimit -c 0
exec setsid /bin/bash -c 'echo \$\$ >"\$1"; exec Hyprland -c "\$2"' _ \
  $(printf '%q' "$HEADLESS_DIR/hypr.pid") \
  $(printf '%q' "$HEADLESS_DIR/cfg/hyprland.lua") \
  >$(printf '%q' "$HEADLESS_DIR/hypr.log") 2>&1
SH
  chmod +x "$HEADLESS_DIR/run-hypr.sh"

  hyprctl dispatch "hl.dsp.exec_cmd($(jq -Rn --arg c "$HEADLESS_DIR/run-hypr.sh" '$c'), { workspace = \"special:omarchy-test silent\", float = true, no_initial_focus = true, size = \"1920 1080\" })" >/dev/null 2>&1 ||
    fail_headless "could not launch nested Hyprland"

  local sig="" wl="" ready=0
  for _ in {1..80}; do
    [[ -s $HEADLESS_DIR/hypr.pid ]] && HEADLESS_PID=$(<"$HEADLESS_DIR/hypr.pid")
    sig=$(ls "$HEADLESS_DIR/rt/hypr" 2>/dev/null | head -1 || true)
    wl=$(ls "$HEADLESS_DIR/rt" 2>/dev/null | grep -E '^wayland-[0-9]+$' | head -1 || true)
    if [[ -n $sig && -n $wl ]] &&
       XDG_RUNTIME_DIR="$HEADLESS_DIR/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl -j monitors >/dev/null 2>&1; then
      ready=1
      break
    fi
    sleep 0.05
  done

  (( ready )) || fail_headless "nested Hyprland did not become ready"

  XDG_RUNTIME_DIR="$HEADLESS_DIR/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl output create headless HEADLESS-1 >/dev/null 2>&1 ||
    fail_headless "could not create HEADLESS-1 output"

  local out
  local -a host_outputs=()
  mapfile -t host_outputs < <(XDG_RUNTIME_DIR="$HEADLESS_DIR/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.name | startswith("WAYLAND-")) | .name')
  for out in "${host_outputs[@]}"; do
    XDG_RUNTIME_DIR="$HEADLESS_DIR/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl output remove "$out" >/dev/null 2>&1 ||
      fail_headless "could not remove host-backed output $out"
  done

  local monitors_json
  monitors_json=$(XDG_RUNTIME_DIR="$HEADLESS_DIR/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl -j monitors 2>/dev/null || true)
  jq -e 'any(.[]; .name == "HEADLESS-1" and .width > 0 and .height > 0) and all(.[]; (.name | startswith("WAYLAND-")) | not)' <<<"$monitors_json" >/dev/null 2>&1 ||
    fail_headless "headless output verification failed (monitors: $monitors_json)"

  HEADLESS_RT="$HEADLESS_DIR/rt"
  HEADLESS_WL="$wl"
  HEADLESS_SIG="$sig"
  HEADLESS_DBUS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$outer_rt/bus}"
}

start_headless_compositor

# Every file's output is kept after the run, so a failure can be read from
# its log rather than found by running the suite again.
workdir=$(mktemp -d -t omarchy-test-shell.XXXXXX)
# Named up front, so test/ci-vm can find this run's logs while it runs, and
# after a hang, among the directories of the test/shell runs some tests start.
printf 'Logging every file to %s\n' "$workdir"

run_one() {
  local test="$1"
  local use_comp="${2:-0}"
  local name
  name=$(basename "$test")
  local status=0
  if [[ $use_comp == "1" && -n $HEADLESS_RT ]]; then
    XDG_RUNTIME_DIR="$HEADLESS_RT" \
    WAYLAND_DISPLAY="$HEADLESS_WL" \
    HYPRLAND_INSTANCE_SIGNATURE="$HEADLESS_SIG" \
    DBUS_SESSION_BUS_ADDRESS="$HEADLESS_DBUS" \
    OMARCHY_TEST_HEADLESS_ACTIVE=1 \
      bash "$test" >"$workdir/$name.out" 2>&1 || status=$?
  else
    OMARCHY_TEST_HEADLESS_ACTIVE="${OMARCHY_TEST_HEADLESS_ACTIVE:-${HEADLESS_RT:+1}}" \
      bash "$test" >"$workdir/$name.out" 2>&1 || status=$?
  fi
  echo "$status" >"$workdir/$name.code"
}
export -f run_one
export workdir HEADLESS_RT HEADLESS_WL HEADLESS_SIG HEADLESS_DBUS

# Schedule largest test files first (longest-processing-time heuristic) so slow
# files start at t=0 instead of forming a straggler tail at the end of the pool.
sort_largest_first() {
  (( $# > 0 )) || return 0
  stat -c '%s %n' "$@" | sort -rn | cut -d' ' -f2-
}

# Keep going after a failing file. A test file exits at its first failed
# assertion, so aborting the run there too would hide every file after it --
# one packaging failure was masking 114 of 134 files.
overlap_pids=()
for test in "${overlap_tests[@]}"; do
  comp=0
  uses_compositor "$test" && comp=1
  run_one "$test" "$comp" &
  overlap_pids+=("$!")
done
if (( ${#parallel_noncomp_tests[@]} > 0 )); then
  sort_largest_first "${parallel_noncomp_tests[@]}" |
    tr '\n' '\0' |
    xargs -0 -P "$(nproc)" -n 1 bash -c 'run_one "$1" 0' _
fi
# The overlap jobs must be done before other compositor tests start: those
# files launch shells/fixtures on the same compositor, which would trigger
# events or spawns the idle guard could observe.
if (( ${#overlap_pids[@]} > 0 )); then
  wait "${overlap_pids[@]}"
fi
if (( ${#parallel_comp_tests[@]} > 0 )); then
  if [[ -n $HEADLESS_RT ]]; then
    sort_largest_first "${parallel_comp_tests[@]}" |
      tr '\n' '\0' |
      xargs -0 -P "$(nproc)" -n 1 bash -c 'run_one "$1" 1' _
  else
    # Live compositor runs (e.g. CI VMs on software llvmpipe) keep compositor
    # fixtures serial so concurrent Qt rendering does not starve the compositor.
    for test in "${parallel_comp_tests[@]}"; do
      run_one "$test" 1
    done
  fi
fi
for test in "${exclusive_tests[@]}"; do
  comp=0
  uses_compositor "$test" && comp=1
  run_one "$test" "$comp"
done

failed=()
skipped=()
for test in "${tests[@]}"; do
  name=$(basename "$test")
  printf '==> %s\n' "${test#$ROOT/}"
  cat "$workdir/$name.out"
  if (( $(cat "$workdir/$name.code") != 0 )); then
    failed+=("${test#$ROOT/}")
  fi
  if grep -q '^ok - .* # SKIP$' "$workdir/$name.out"; then
    skipped+=("${test#$ROOT/}")
  fi
done

if (( ${#skipped[@]} > 0 )); then
  printf '\nSkipped checks in %d of %d test files:\n' "${#skipped[@]}" "${#tests[@]}"
  printf '  %s\n' "${skipped[@]}"
fi

if (( ${#failed[@]} > 0 )); then
  printf '\n%d of %d test files failed:\n' "${#failed[@]}" "${#tests[@]}" >&2
  for test in "${failed[@]}"; do
    printf '  %s (log: %s/%s.out)\n' "$test" "$workdir" "$(basename "$test")" >&2
  done
  printf 'Logs for every file: %s\n' "$workdir" >&2
  exit 1
fi

if (( ${#skipped[@]} == 0 )); then
  printf '\nAll %d test files passed.\n' "${#tests[@]}"
else
  printf '\n%d test files completed without failures; %d had skipped checks.\n' "${#tests[@]}" "${#skipped[@]}"
fi
printf 'Logs for every file: %s\n' "$workdir"

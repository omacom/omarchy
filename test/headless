#!/bin/bash

# Runs a command against a private, headless nested Hyprland compositor so
# compositor/Quickshell tests never render on or steal focus from the user's
# active desktop.
#
#   test/headless <command> [args...]
#
# Starts a nested Hyprland silently on special:omarchy-test, creates a
# HEADLESS-1 output (1920x1080@60Hz) and removes the host-backed WAYLAND-*
# output so zero windows remain on the host desktop while GPU-accelerated
# rendering stays available. Runs the command directly when no active Hyprland
# session is present, when already inside test/headless, or when
# OMARCHY_TEST_USE_LIVE_COMPOSITOR=1. Fails closed if a live Hyprland desktop
# is present but the headless compositor cannot be established.

set -euo pipefail

if (( $# == 0 )); then
  echo "Usage: $0 <command> [args...]" >&2
  exit 1
fi

if [[ ${OMARCHY_TEST_USE_LIVE_COMPOSITOR:-0} == "1" || ${OMARCHY_TEST_HEADLESS_ACTIVE:-0} == "1" ]] ||
   [[ -z ${WAYLAND_DISPLAY:-} || -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] ||
   ! command -v Hyprland >/dev/null 2>&1 ||
   ! command -v hyprctl >/dev/null 2>&1 ||
   ! command -v jq >/dev/null 2>&1; then
  exec "$@"
fi

outer_rt="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
outer_wl="$WAYLAND_DISPLAY"
[[ $outer_wl == /* ]] || outer_wl="$outer_rt/$outer_wl"
if [[ ! -S $outer_wl ]] || ! hyprctl -j monitors >/dev/null 2>&1; then
  exec "$@"
fi

# Short path so $XDG_RUNTIME_DIR/hypr/<sig>/.socket2.sock stays under the 108-byte Unix sun_path limit.
headless_dir=$(mktemp -d /tmp/oh.XXXXXX)
headless_pid=""
child_pid=""

cleanup() {
  if [[ -n $child_pid ]] && kill -0 "$child_pid" 2>/dev/null; then
    kill -TERM "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  if [[ -z $headless_pid && -s $headless_dir/hypr.pid ]]; then
    headless_pid=$(<"$headless_dir/hypr.pid")
  fi
  if [[ -n $headless_pid ]]; then
    kill -TERM -- "-$headless_pid" "$headless_pid" 2>/dev/null || true
    for _ in {1..30}; do
      kill -0 "$headless_pid" 2>/dev/null || break
      sleep 0.05
    done
    kill -KILL -- "-$headless_pid" "$headless_pid" 2>/dev/null || true
  fi
  rm -rf "$headless_dir"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

fail_headless() {
  echo "test/headless: $1 (pass OMARCHY_TEST_USE_LIVE_COMPOSITOR=1 to run against the live desktop)" >&2
  if [[ -s $headless_dir/hypr.log ]]; then
    tail -40 "$headless_dir/hypr.log" >&2
  fi
  exit 1
}

mkdir -p "$headless_dir/rt" "$headless_dir/cfg"
for sock in bus pipewire-0 pulse; do
  [[ -e $outer_rt/$sock ]] && ln -s "$outer_rt/$sock" "$headless_dir/rt/$sock"
done

cat >"$headless_dir/cfg/hyprland.lua" <<'EOF'
hl.config({
  misc = {
    disable_hyprland_logo = true,
    disable_splash_rendering = true,
  },
  animations = {
    enabled = false,
  },
})
EOF

cat >"$headless_dir/run-hypr.sh" <<SH
#!/bin/bash
export XDG_RUNTIME_DIR=$(printf '%q' "$headless_dir/rt")
export WAYLAND_DISPLAY=$(printf '%q' "$outer_wl")
unset HYPRLAND_INSTANCE_SIGNATURE DISPLAY
export HYPRLAND_NO_CRASHREPORTER=1
export HYPRLAND_NO_SD_NOTIFY=1
export HYPRLAND_NO_SD_VARS=1
export HYPRLAND_NO_RT=1
ulimit -c 0
exec setsid /bin/bash -c 'echo \$\$ >"\$1"; exec Hyprland -c "\$2"' _ \
  $(printf '%q' "$headless_dir/hypr.pid") \
  $(printf '%q' "$headless_dir/cfg/hyprland.lua") \
  >$(printf '%q' "$headless_dir/hypr.log") 2>&1
SH
chmod +x "$headless_dir/run-hypr.sh"

hyprctl dispatch "hl.dsp.exec_cmd($(jq -Rn --arg c "$headless_dir/run-hypr.sh" '$c'), { workspace = \"special:omarchy-test silent\", float = true, no_initial_focus = true, size = \"1920 1080\" })" >/dev/null 2>&1 ||
  fail_headless "could not launch nested Hyprland"

sig="" wl="" ready=0
for _ in {1..80}; do
  [[ -s $headless_dir/hypr.pid ]] && headless_pid=$(<"$headless_dir/hypr.pid")
  sig=$(ls "$headless_dir/rt/hypr" 2>/dev/null | head -1 || true)
  wl=$(ls "$headless_dir/rt" 2>/dev/null | grep -E '^wayland-[0-9]+$' | head -1 || true)
  if [[ -n $sig && -n $wl ]] &&
     XDG_RUNTIME_DIR="$headless_dir/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl -j monitors >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.05
done

(( ready )) || fail_headless "nested Hyprland did not become ready"

nested_hyprctl() {
  XDG_RUNTIME_DIR="$headless_dir/rt" HYPRLAND_INSTANCE_SIGNATURE="$sig" hyprctl "$@"
}

nested_hyprctl output create headless HEADLESS-1 >/dev/null 2>&1 ||
  fail_headless "could not create HEADLESS-1 output"

mapfile -t host_outputs < <(nested_hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.name | startswith("WAYLAND-")) | .name')
for out in "${host_outputs[@]}"; do
  nested_hyprctl output remove "$out" >/dev/null 2>&1 ||
    fail_headless "could not remove host-backed output $out"
done

monitors_json=$(nested_hyprctl -j monitors 2>/dev/null || true)
jq -e 'any(.[]; .name == "HEADLESS-1" and .width > 0 and .height > 0) and all(.[]; (.name | startswith("WAYLAND-")) | not)' <<<"$monitors_json" >/dev/null 2>&1 ||
  fail_headless "headless output verification failed (monitors: $monitors_json)"

status=0
XDG_RUNTIME_DIR="$headless_dir/rt" \
WAYLAND_DISPLAY="$wl" \
HYPRLAND_INSTANCE_SIGNATURE="$sig" \
DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$outer_rt/bus}" \
OMARCHY_TEST_HEADLESS_ACTIVE=1 \
  "$@" &
child_pid=$!
wait "$child_pid" || status=$?
child_pid=""

exit "$status"

import QtQuick
import QtQuick.Controls
import QtQuick.Window
import QtTest

Item {
  id: root
  width: 380; height: 1000
  property bool machinesOpen: true
  property bool cursorActive: false
  property int focusSection: 0
  property int providerIndex: 0
  property int usageCursor: 0
  property bool detailsOpen: false
  property var switchedPanels: []
  property var machineMoves: []
  function selectMachine(delta) { machineMoves = machineMoves.concat([delta]) }
  function selectProvider(index) { providerIndex = index }
  function switchPanel(direction) { switchedPanels = switchedPanels.concat([direction]) }
  SCROLL_FUNCTION
  CONTENT_ITEM_FUNCTION
  TOP_FUNCTION
  ACTIVE_FUNCTION
  function showMachines() { machinesOpen = true }
  function close() {}
  function refreshNow() {}
  QtObject {
    id: providerPages
    property int count: 1
    property int detailCount: 0
    property var rowYs: []
    function itemAt(index) {
      return {
        selectedPage: true,
        detailCount: detailCount,
        detailItemAt: function(rowIndex) {
          return {
            height: 30,
            mapToItem: function(item, x, y) { return {x: 0, y: providerPages.rowYs[rowIndex]} }
          }
        }
      }
    }
  }
  QtObject { id: contentStack }
  QtObject {
    id: panelFlick
    property real height: 100
    property real contentHeight: 300
    property real contentY: 0
  }
  QtObject {
    id: testStyle
    property var font: ({family:"monospace", caption:12, bodySmall:13, body:14})
    function space(value) { return value }
  }
  QtObject { id: testColor; property color foreground: "white"; property color urgent: "red" }
  QtObject {
    id: usage
    property var remoteMachines: []
    property bool machineBusy: false
    property string machineError: ""
    property var commands: []
    signal machineCommandFinished(bool success)
    function manageMachine(args) { commands = commands.concat([args]); machineBusy = true }
  }
  // Theme/paint substitutes; keyboard handlers come from the production button.
  component Button: Item {
    id: root
    property string text
    property color foreground
    property string fontFamily
    property real fontSize
    property bool hasCursor
    property bool selected
    property bool leftAlign
    property bool focusable: false
    implicitWidth: text.length * 8 + 20
    implicitHeight: 30
    signal clicked()
    BUTTON_KEYS
  }
  component PanelSectionHeader: Text { property color foreground; property string fontFamily }
  MACHINE_COMPONENT
  KEY_COMPONENT
  KEY_CATCHER
    MachineSettings {
      id: machineSettings
      width: parent.width
      usage: usage
      onFocusRequested: keyCatcher.forceActiveFocus()
      onBackRequested: root.machinesOpen = false
    }
  }

  TestCase {
    name: "MachineKeyboardManagement"
    when: windowShown
    function row(id, label) { return {id:id, label:label, target:"workbox", user:"tester", platform:"Linux", status:"current"} }
    function init() {
      root.width = 380
      usage.machineBusy = false; usage.machineError = ""; usage.commands = []
      usage.remoteMachines = [row("one", "Laptop"), row("two", "Workstation")]
      root.machinesOpen = true
      root.switchedPanels = []; root.machineMoves = []
      root.providerIndex = 0
      root.focusSection = 0; root.usageCursor = 0; root.detailsOpen = false
      providerPages.detailCount = 0; providerPages.rowYs = []; panelFlick.contentY = 0
      machineSettings.mode = ""; machineSettings.selectedId = "one"
      keyCatcher.forceActiveFocus()
      wait(5)
    }
    function text(value) { for (var i = 0; i < value.length; i++) keyClick(value[i]) }
    function finish(success) { usage.machineBusy = false; usage.machineCommandFinished(success); wait(5) }
    function focusedText() {
      var item = root.Window.window.activeFocusItem
      return item && item.text !== undefined ? item.text : ""
    }
    function test_add_rename_remove_with_keys() {
      keyClick("n"); wait(5)
      text("workbox"); keyClick(Qt.Key_Tab)
      keyClick(Qt.Key_Backtab); keyClick(Qt.Key_Tab); text("Laptop")
      keyClick(Qt.Key_Tab); keyClick(Qt.Key_Return)
      compare(usage.commands[0], ["add", "workbox", "--label", "Laptop"])
      finish(true)
      keyClick("j"); keyClick("e"); wait(5)
      keyClick(Qt.Key_A, Qt.ControlModifier); text("Desktop"); keyClick(Qt.Key_Return)
      compare(usage.commands[1], ["rename", "two", "--label", "Desktop"])
      finish(true)
      keyClick("x"); keyClick(Qt.Key_Return)
      compare(usage.commands[2], ["remove", "two"])
      finish(true)
      keyClick(Qt.Key_Escape)
      verify(!root.machinesOpen)
    }
    function test_cancel_and_retry() {
      keyClick("n"); wait(5); text("workbox"); keyClick(Qt.Key_Return)
      text("Laptop"); keyClick(Qt.Key_Return)
      finish(false)
      compare(machineSettings.mode, "add")
      keyClick(Qt.Key_Return); keyClick(Qt.Key_Return)
      compare(usage.commands.length, 2)
      finish(false)
      keyClick(Qt.Key_Escape)
      compare(machineSettings.mode, "")
      verify(root.machinesOpen)
      keyClick("x"); keyClick(Qt.Key_Escape)
      compare(usage.commands.length, 2, "cancel never removes a computer")
    }
    function test_save_button_failure_returns_focus_for_edit_and_cancel() {
      keyClick("n"); wait(5)
      text("workbox"); keyClick(Qt.Key_Tab); text("Laptop"); keyClick(Qt.Key_Tab); wait(5)
      compare(focusedText(), "Save [Enter]", "Tab must focus the real Save button")
      keyClick(Qt.Key_Return)
      compare(usage.commands[0], ["add", "workbox", "--label", "Laptop"])
      verify(usage.machineBusy, "Save starts the busy state")
      usage.machineError = "SSH connection failed"
      finish(false)
      compare(machineSettings.mode, "add")
      compare(focusedText(), "workbox", "a failed Save returns keyboard focus to the editor")
      keyClick(Qt.Key_A, Qt.ControlModifier); text("retry-host")
      compare(focusedText(), "retry-host", "failed input remains editable for a retry")
      keyClick(Qt.Key_Escape)
      compare(machineSettings.mode, "", "Escape cancels after editing the failed request")
      verify(root.machinesOpen)
      compare(usage.commands.length, 1, "editing and cancel do not submit an implicit retry")
    }
    function test_remove_confirmation_keeps_original_target() {
      keyClick("x")
      usage.remoteMachines = [row("two", "Workstation")]
      wait(5)
      keyClick(Qt.Key_Return)
      compare(usage.commands.length, 0, "a concurrent CLI removal must not retarget confirmation")
    }
    function test_external_last_machine_removal_keeps_surviving_selection_visible() {
      var rows=[]
      for(var i=0;i<10;i++) rows.push(row("machine"+i,"Computer "+(i+1)))
      usage.remoteMachines=rows
      machineSettings.selectedId="machine9"
      wait(30)
      var list=machineSettings.machineListForTest
      list.forceLayout()
      compare(list.height,list.contentHeight,"ten rows use their full measured height")
      var tenth=list.itemAtIndex(9)
      verify(tenth,"selected tenth delegate is instantiated")
      var before=tenth.mapToItem(list,0,0)
      verify(before.y<list.height && before.y+tenth.height>0,"selected tenth machine starts visible")

      usage.remoteMachines=rows.slice(0,9)
      wait(30)
      compare(machineSettings.selectedId,"machine8","the nearest surviving ninth machine stays selected")
      list.forceLayout()
      compare(list.height,list.contentHeight,"nine surviving rows remain fully measured")
      var ninth=list.itemAtIndex(8)
      verify(ninth,"surviving selected delegate is instantiated after model replacement")
      var after=ninth.mapToItem(list,0,0)
      verify(after.y<list.height && after.y+ninth.height>0,
        "surviving selected ninth machine stays within the actual ListView viewport")
    }
    function test_empty_five_and_ten_lists_have_no_inner_vertical_cap() {
      usage.remoteMachines=[]; wait(30)
      var list=machineSettings.machineListForTest
      verify(list.height>0,"the empty-list message contributes a real height")
      var emptyHeight=list.height
      var five=[]
      for(var i=0;i<5;i++) five.push(row("five"+i,"Computer "+(i+1)))
      usage.remoteMachines=five; wait(30); list.forceLayout()
      verify(list.height>emptyHeight)
      compare(list.height,list.contentHeight)
      var fifth=list.itemAtIndex(4)
      verify(fifth && fifth.y+fifth.height<=list.height,"all five rows are present without inner scrolling")
      var fiveHeight=list.height
      var ten=[]
      for(var j=0;j<10;j++) ten.push(row("ten"+j,"Computer "+(j+1)))
      usage.remoteMachines=ten; wait(30); list.forceLayout()
      compare(list.height,list.contentHeight)
      verify(list.height>fiveHeight,"ten rows grow beyond the five-row measurement")
      var tenth=list.itemAtIndex(9)
      verify(tenth && tenth.y+tenth.height<=list.height,"all ten rows are present without an artificial viewport")
    }
    function test_tab_switches_neighbor_panels_outside_editor() {
      root.machinesOpen = false
      keyClick(Qt.Key_Tab); keyClick(Qt.Key_Backtab)
      compare(root.switchedPanels, [1, -1], "overview Tab uses shared neighboring-panel navigation")
      root.machinesOpen = true
      keyClick(Qt.Key_Tab)
      compare(root.switchedPanels, [1, -1, 1], "management-list Tab also leaves the panel")
    }
    function test_arrows_reach_every_section_and_leave_usage_edges() {
      root.machinesOpen = false
      providerPages.detailCount = 3
      keyClick("l"); compare(root.providerIndex, 1, "provider selector retains horizontal navigation")
      root.providerIndex = 0
      keyClick("j"); compare(root.focusSection, 1, "computer selector follows provider")
      keyClick("h"); compare(root.machineMoves, [-1], "computer selector retains horizontal navigation")
      keyClick("j"); compare(root.focusSection, 2, "gear follows computer selector")
      keyClick(Qt.Key_Return); verify(root.machinesOpen, "gear remains keyboard-activatable")
      root.machinesOpen = false; root.focusSection = 2
      keyClick("j"); compare(root.focusSection, 3, "usage details follow gear")
      keyClick(Qt.Key_Return); verify(root.detailsOpen, "focused usage row opens details")
      keyClick("j"); compare(root.usageCursor, 1)
      keyClick("j"); compare(root.usageCursor, 2)
      keyClick("j"); compare(root.focusSection, 0, "last usage row can move to another section")
      keyClick("k"); compare(root.focusSection, 3); compare(root.usageCursor, 2,
              "reverse navigation enters usage at its last row")
      root.usageCursor = 0
      keyClick("k"); compare(root.focusSection, 2, "first usage row can move back to the gear")
      providerPages.detailCount = 0
      keyClick("j"); compare(root.focusSection, 0, "empty usage skips cleanly after the gear")
      keyClick("k"); compare(root.focusSection, 2, "empty usage skips cleanly before the provider")
    }
    function test_usage_cursor_scrolls_clipped_rows_into_view() {
      root.machinesOpen = false; root.focusSection = 3; root.usageCursor = 0
      providerPages.detailCount = 3; providerPages.rowYs = [20, 90, 180]
      keyClick("j"); wait(5)
      compare(root.usageCursor, 1)
      compare(panelFlick.contentY, 20, "row bottom is brought inside the viewport")
      keyClick("j"); wait(5)
      compare(panelFlick.contentY, 110, "later clipped rows continue following the cursor")
      panelFlick.contentY = 150; root.usageCursor = 1
      keyClick("k"); wait(5)
      compare(panelFlick.contentY, 20, "upward navigation reveals a row clipped above")
    }
    function test_management_height_contains_editor_and_error() {
      root.width = 300
      keyClick("n"); wait(5)
      usage.machineError = "A long SSH connection error that wraps across several lines and must remain visible below the full editor."
      wait(5)
      verify(machineSettings.implicitHeight >= machineSettings.children[0].implicitHeight,
             "panel content height must include every visible control and error")
      root.width = 380
    }
    function test_management_modes_reserve_their_largest_actual_layout() {
      wait(30)
      var overviewHeight=machineSettings.implicitHeight
      machineSettings.edit("add"); wait(10)
      var addHeight=machineSettings.implicitHeight
      machineSettings.back(); machineSettings.edit("rename"); wait(10)
      var renameHeight=machineSettings.implicitHeight
      machineSettings.back(); machineSettings.removeSelected(); wait(10)
      var removeHeight=machineSettings.implicitHeight
      compare(overviewHeight,addHeight,"opening Add must not grow the maximum panel")
      compare(renameHeight,addHeight,"Rename reserves the same management maximum")
      compare(removeHeight,addHeight,"Remove confirmation reserves the same management maximum")
    }
    function test_machine_details_and_confirmation_reserve_the_longest_current_text() {
      var shortMachine=row("short","Short")
      var ordinaryMachine=row("ordinary","Ordinary")
      usage.remoteMachines=[shortMachine,ordinaryMachine]; machineSettings.selectedId="short"; wait(30)
      var ordinaryHeight=machineSettings.implicitHeight

      var longDetail=row("detail","Detail")
      longDetail.target="user@a-very-long-fixture-hostname-that-wraps.invalid"
      longDetail.error="A retained machine detail issue long enough to wrap across several lines without resizing on selection."
      usage.remoteMachines=[shortMachine,longDetail]; wait(30)
      var detailHeight=machineSettings.implicitHeight
      verify(detailHeight>ordinaryHeight,"the longest current detail sets a larger measured maximum")
      machineSettings.selectedId="detail"; wait(20)
      compare(machineSettings.implicitHeight,detailHeight,"long detail text is reserved before selection")

      var longConfirmation=row("confirmation",Array(18).join("Very long computer name "))
      usage.remoteMachines=[shortMachine,ordinaryMachine]; machineSettings.selectedId="short"; wait(30)
      ordinaryHeight=machineSettings.implicitHeight
      usage.remoteMachines=[shortMachine,longConfirmation]; wait(30)
      var confirmationHeight=machineSettings.implicitHeight
      verify(confirmationHeight>ordinaryHeight,"the longest current confirmation sets a larger measured maximum")
      machineSettings.selectedId="confirmation"; wait(20)
      machineSettings.removeSelected(); wait(20)
      compare(machineSettings.implicitHeight,confirmationHeight,"the longest removal confirmation is already reserved")
      machineSettings.back(); machineSettings.selectedId="short"; machineSettings.removeSelected(); wait(20)
      compare(machineSettings.implicitHeight,confirmationHeight,"short confirmation uses the same current maximum")
    }
  }
}

#!/usr/bin/python3
"""Synthetic Cloudflare CLI. Never connects to Cloudflare."""
import json
import os
import signal
import sys
import time

args = sys.argv[1:]
account = os.environ.get('CLOUDFLARE_ACCOUNT_ID', '')
assert os.environ.get('NO_COLOR') == '1'
assert 'FORCE_COLOR' not in os.environ
with open(os.environ['CF_TEST_CALLS'], 'a') as log:
    log.write(json.dumps([account, args]) + '\n')

def emit(value):
    print(json.dumps(value), flush=True)

def option(name, default=None):
    return args[args.index(name) + 1] if name in args else default

if args == ['auth', 'whoami'] and os.environ['CF_TEST_SCENARIO'] == 'login-race':
    # Signed in only once the login below has saved its token, read as the
    # call starts, as cf reads its config.
    signed_in = os.path.exists(os.environ['CF_TEST_CALLS'] + '.token')
    time.sleep(1.5)
    emit({'authenticated': True, 'tokenValid': True, 'accounts': [{'id': 'a', 'name': 'A'}]} if signed_in else {'authenticated': False})
elif args == ['auth', 'whoami']:
    emit({'authenticated': True, 'tokenValid': True, 'accounts': [
        {'id': 'a', 'name': 'A'}, {'id': 'b', 'name': 'B'}]})
elif args[:2] in [['workers', 'list'], ['zones', 'list']]:
    scenario = os.environ['CF_TEST_SCENARIO']
    page = int(option('--page', '1'))
    size = int(option('--per-page', '10' if args[0] == 'workers' else '20'))
    assert size == (100 if args[0] == 'workers' else 50)
    if args[0] == 'zones':
        assert option('--account-id') == account
    if scenario.startswith('pagination'):
        time.sleep(0.1)
        if scenario == 'pagination-failure' and page == 2:
            with open(os.environ['CF_TEST_CALLS']) as log:
                calls = [json.loads(line) for line in log]
            if sum(call[1] == args for call in calls) == 1:
                sys.exit(1)
        count = 102 if args[0] == 'workers' else 52
        rows = [{'name': f'worker-{i}', 'id': f'w{i}'} if args[0] == 'workers' else
                {'name': f'zone-{i}.test', 'id': f'z{i}', 'account': {'id': account}}
                for i in range((page - 1) * size, min(page * size, count))]
        emit(rows)
        sys.exit(0)
    def delayed_list_exit(*_):
        time.sleep(0.4)
        emit([{'name': account + '-worker', 'observability': {'enabled': True}}] if args[0] == 'workers' else
             [{'id': account + '-zone', 'name': account + '.test', 'account': {'id': account}}])
        sys.exit(0)
    signal.signal(signal.SIGTERM, delayed_list_exit)
    time.sleep(0.8)
    if args[0] == 'workers':
        emit([{'name': account + '-worker', 'observability': {'enabled': True}}])
    else:
        emit([{'id': account + '-zone', 'name': account + '.test', 'account': {'id': account}}])
elif args == ['auth', 'login']:
    print('\n\t\tTo authorize Cloudflare CLI, please visit:\n\n\t\t  https://dash.cloudflare.com/oauth/device\n\n'
          '\t\tand enter the code:\n\n\t\t  TESTCODE\n\n\t\tYou have 10 minutes to approve this request.\n', flush=True)
    time.sleep(0.6)
    if os.environ['CF_TEST_SCENARIO'] == 'login-race':
        open(os.environ['CF_TEST_CALLS'] + '.token', 'w').close()
    emit({'success': True})
elif args[1:3] == ['telemetry', 'query']:
    # cf 1.0 names it o11y; the old-cli scenario stands in for 0.15, which
    # only knows observability. Either answers the other name with its usage.
    if args[0] != ('observability' if os.environ['CF_TEST_SCENARIO'] == 'old-cli' else 'o11y'):
        sys.stderr.write('cf <command> [options]\n\nThe Cloudflare CLI - manage your Cloudflare resources\n')
        sys.exit(1)
    body = json.loads(option('--body'))
    worker = body['parameters']['filters'][0]['value']
    if worker == 'errorfail' and body['parameters']['calculations'][0]['alias'] == 'errors':
        time.sleep(0.1)
        sys.exit(1)
    if worker == 'alpha':
        def delayed_exit(*_):
            time.sleep(0.4)
            sys.exit(15)
        signal.signal(signal.SIGTERM, delayed_exit)
        time.sleep(3)
    else:
        time.sleep(0.15)
    emit({'calculations': [{'alias': c['alias'], 'aggregates': [{'value': 42}]} for c in body['parameters']['calculations']]})
elif args[:3] == ['workers', 'versions', 'list']:
    if option('--worker-id') in ['stalled', 'stubborn']:
        if option('--worker-id') == 'stubborn': signal.signal(signal.SIGTERM, signal.SIG_IGN)
        time.sleep(6)
    emit([{'id': option('--worker-id') + '-version'}])
elif args[:3] == ['workers', 'deployments', 'list']:
    if option('--worker') in ['stalled', 'stubborn']:
        if option('--worker') == 'stubborn': signal.signal(signal.SIGTERM, signal.SIG_IGN)
        time.sleep(6)
    emit({'deployments': []})
else:
    sys.exit('unexpected cf command: ' + repr(args))

#!/bin/bash

# The hybrid policy starves A2DP on this Mac's BCM4350 with 2.4 GHz Wi-Fi.
# Measurements and scope: https://github.com/omacom/omarchy/issues/13297
# Keep other machines out of the vendor-command path entirely.
[[ -r /sys/class/dmi/id/product_name ]] || exit 0
[[ $(</sys/class/dmi/id/product_name) == "MacBookPro14,1" ]] || exit 0

/usr/bin/python3 -I - "$@" <<'PY'
from pathlib import Path
import re
import struct
import subprocess
import sys

STATE = Path('/run/omarchy-bcm4350-coexistence')


def run(*args, data=None):
  return subprocess.run(args, input=data, stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE, check=True, timeout=2).stdout


def iovar(iface, name, value=None):
  # brcmfmac's BRCMF_VNDR_CMDS_DCMD: native 20-byte header, LE firmware values.
  payload = name.encode('ascii') + b'\0'
  if value is not None:
    payload += struct.pack('<I', value)
  request = struct.pack('=IiIII', 262 if value is None else 263,
                        256 if value is None else len(payload),
                        20, int(value is not None), 0) + payload
  response = run('/usr/bin/iw', 'dev', iface, 'vendor', 'recvbin',
                 '0x001018', '0x1', '-', data=request)
  if value is not None:
    return
  # iw returns aligned netlink attributes: DATA=2, LEN=1.
  result = bytearray()
  offset = 0
  while offset < len(response):
    length, kind = struct.unpack_from('=HH', response, offset)
    if length < 4 or offset + length > len(response):
      raise ValueError('invalid vendor response')
    if kind & 0x3fff == 2:
      result.extend(response[offset + 4:offset + length])
    offset += (length + 3) & ~3
  if not result:
    raise ValueError('empty vendor response')
  return bytes(result)


def mode(iface):
  return struct.unpack_from('<I', iovar(iface, 'btc_mode'))[0]


def apply(iface):
  device = Path('/sys/class/net') / iface / 'device'
  if ((device / 'vendor').read_text().strip() != '0x14e4'
      or (device / 'device').read_text().strip() != '0x43a3'
      or (device / 'revision').read_text().strip() != '0x05'
      or (device / 'driver').resolve().name != 'brcmfmac'):
    return
  version = iovar(iface, 'ver').split(b'\0', 1)[0]
  if not re.search(rb'\bversion 7\.35\.180\.133\b.*\bFWID:? 01-c45b39d6\b', version):
    return

  # Dispatcher events can be stale by the time they run; inspect the live link.
  link = run('/usr/bin/iw', 'dev', iface, 'link').decode(errors='replace')
  frequency = re.search(r'^\s*freq:\s*(\d+)', link, re.MULTILINE)
  on_2ghz = frequency is not None and 2400 <= int(frequency[1]) <= 2500
  current = mode(iface)
  state = STATE / iface

  if on_2ghz and current == 5:
    # Record ownership before writing so a failed readback remains recoverable.
    STATE.mkdir(mode=0o755, exist_ok=True)
    state.touch(mode=0o600)
    iovar(iface, 'btc_mode', 4)
    if mode(iface) != 4:
      raise ValueError('parallel policy readback failed')
    print('BCM4350: enabled parallel coexistence on 2.4 GHz', file=sys.stderr)
  elif not on_2ghz and state.exists():
    # Restore only our recorded override; leave a different current policy alone.
    if current == 4:
      iovar(iface, 'btc_mode', 5)
      if mode(iface) != 5:
        raise ValueError('hybrid policy readback failed')
    state.unlink()
  elif current != 4:
    state.unlink(missing_ok=True)


def main(argv):
  if (len(argv) != 3
      or argv[2] not in ('up', 'reapply', 'dhcp4-change', 'dhcp6-change', 'down')
      or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}', argv[1])):
    return
  try:
    apply(argv[1])
  except (OSError, ValueError, struct.error, subprocess.SubprocessError) as error:
    # Device removal or unavailable firmware must not fail network activation.
    print(f'BCM4350: coexistence quirk skipped ({type(error).__name__})', file=sys.stderr)


if __name__ == '__main__':
  main(sys.argv)
PY

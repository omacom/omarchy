[Unit]
Description=USB authorization policy for the Omarchy lock screen
Conflicts=usbguard.service usbguard-dbus.service
After=systemd-udevd.service
ConditionPathExists=/etc/omarchy/usb-lock.enabled

[Service]
Type=simple
ExecStartPre=/usr/bin/omarchy-usb-lock-admin prepare
ExecStart=/usr/bin/usbguard-daemon -c /run/omarchy-usb-lock/daemon.conf
RuntimeDirectory=omarchy-usb-lock
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=1
TimeoutStopSec=2
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run /var/log/usbguard
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target

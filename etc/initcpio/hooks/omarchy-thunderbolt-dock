#!/usr/bin/ash

_tb_is_allowed() {
  local target="$1" allowlist="$2" entry=""
  [ -n "$target" ] || return 1
  while IFS= read -r entry || [ -n "$entry" ]; do
    [ "$entry" = "$target" ] && return 0
  done < "$allowlist"
  return 1
}

_tb_authorize_pass() {
  local allowlist="$1" dev="" uid="" auth=""
  _tb_matched=0
  _tb_newly_authorized=0
  for dev in /sys/bus/thunderbolt/devices/*; do
    [ -r "$dev/unique_id" ] || continue
    read -r uid < "$dev/unique_id" 2>/dev/null || continue
    _tb_is_allowed "$uid" "$allowlist" || continue
    _tb_matched=1
    if [ -r "$dev/authorized" ]; then
      read -r auth < "$dev/authorized" 2>/dev/null || auth=0
      if [ "$auth" = "0" ]; then
        if [ -w "$dev/authorized" ] && printf '1' > "$dev/authorized" 2>/dev/null; then
          _tb_newly_authorized=1
        fi
      fi
    fi
  done
}

_tb_wait_authorized() {
  local allowlist="$1" i=0 dev="" uid="" auth="" pending=0
  while [ "$i" -lt 20 ]; do
    pending=0
    for dev in /sys/bus/thunderbolt/devices/*; do
      [ -r "$dev/unique_id" ] || continue
      read -r uid < "$dev/unique_id" 2>/dev/null || continue
      _tb_is_allowed "$uid" "$allowlist" || continue
      if [ -r "$dev/authorized" ]; then
        read -r auth < "$dev/authorized" 2>/dev/null || auth=0
        if [ "$auth" = "0" ]; then
          pending=1
          break
        fi
      fi
    done
    [ "$pending" -eq 0 ] && break
    sleep 0.1
    i=$((i + 1))
  done
}

run_hook() {
  local allowlist="/etc/omarchy-thunderbolt-dock.uuids"
  local conn="" _tb_matched=0 _tb_newly_authorized=0

  [ -r "$allowlist" ] || return 0
  [ -d /sys/bus/thunderbolt/devices ] || return 0

  _tb_authorize_pass "$allowlist"

  # Undocked boot (or only unknown/non-enrolled devices): exit immediately
  # without slowing down boot.
  [ "$_tb_matched" -eq 1 ] || return 0

  if [ "$_tb_newly_authorized" -eq 1 ]; then
    _tb_wait_authorized "$allowlist"
  fi

  # Settle generically so PCIe-tunneled xHCI controllers and dock USB HID
  # devices finish enumerating before Plymouth and LUKS unlock.
  udevadm settle --timeout=3 2>/dev/null || true
  sleep 0.5
  udevadm settle --timeout=3 2>/dev/null || true

  # Authorize any daisy-chained enrolled peripheral that appeared behind the
  # first authorized dock, and settle once more if so.
  _tb_authorize_pass "$allowlist"
  if [ "$_tb_newly_authorized" -eq 1 ]; then
    _tb_wait_authorized "$allowlist"
    udevadm settle --timeout=3 2>/dev/null || true
    sleep 0.5
    udevadm settle --timeout=2 2>/dev/null || true
  fi

  # Re-probe external DisplayPort connectors now that the dock is authorized.
  for conn in /sys/class/drm/card*-DP-*/status; do
    [ -w "$conn" ] || continue
    printf 'detect' > "$conn" 2>/dev/null || true
  done
}

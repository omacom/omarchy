#!/bin/bash

build() {
  local boltd_devices_dir=/var/lib/boltd/devices
  if (( EUID != 0 )) && [[ -n ${OMARCHY_BOLTD_DEVICES_DIR:-} ]]; then
    boltd_devices_dir=$OMARCHY_BOLTD_DEVICES_DIR
  fi

  [[ -d $boltd_devices_dir ]] || return 0

  local -a uuids=()
  local dev_file uuid normalized section dev_type policy line key val
  for dev_file in "$boltd_devices_dir"/*; do
    [[ -f $dev_file && ! -L $dev_file && -r $dev_file ]] || continue
    uuid=${dev_file##*/}
    [[ $uuid =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || continue

    section=""
    dev_type=""
    policy=""
    while IFS= read -r line || [[ -n $line ]]; do
      line=${line%$'\r'}
      line=${line#"${line%%[![:space:]]*}"}
      line=${line%"${line##*[![:space:]]}"}
      [[ -z $line || $line == \#* || $line == \;* ]] && continue
      if [[ $line == \[*\] ]]; then
        section=${line:1:${#line}-2}
        continue
      fi
      if [[ $line == *=* ]]; then
        key=${line%%=*}
        val=${line#*=}
        key=${key%"${key##*[![:space:]]}"}
        val=${val#"${val%%[![:space:]]*}"}
        if [[ $section == "device" && $key == "type" ]]; then
          dev_type=$val
        elif [[ $section == "user" && $key == "policy" ]]; then
          policy=$val
        fi
      fi
    done <"$dev_file"

    if [[ $dev_type == "peripheral" && $policy == "auto" ]]; then
      normalized=${uuid,,}
      if [[ " ${uuids[*]:-} " != *" $normalized "* ]]; then
        uuids+=("$normalized")
      fi
    fi
  done

  (( ${#uuids[@]} > 0 )) || return 0

  # Include dock USB host controller and common HID drivers unconditionally so
  # rebuilding the initramfs while undocked (with autodetect) preserves dock
  # keyboard/mouse input at the LUKS unlock prompt.
  local mod
  for mod in \
    thunderbolt \
    xhci_pci \
    xhci_pci_renesas \
    xhci_hcd \
    usbhid \
    hid_generic \
    hid_logitech_dj \
    hid_logitech_hidpp \
    hid_apple; do
    add_module "${mod}?"
  done

  # Allowlist only enrolled policy=auto peripheral UUIDs; unknown Thunderbolt
  # devices are never auto-authorized in the initramfs.
  add_file - '/usr/lib/udev/rules.d/99-omarchy-thunderbolt-dock.rules' 644 < <(
    printf '# Generated by omarchy-thunderbolt-dock from enrolled policy=auto\n'
    printf '# Thunderbolt peripheral devices in /var/lib/boltd/devices.\n'
    for uuid in "${uuids[@]}"; do
      printf 'ACTION=="add|change", SUBSYSTEM=="thunderbolt", ATTR{unique_id}=="%s", ATTR{authorized}=="0", ATTR{authorized}="1"\n' "$uuid"
    done
  )

  # Busybox initramfs runs the runtime hook to settle dock USB/DP enumeration
  # before Plymouth and LUKS unlock. On systemd initramfs, systemd-udevd
  # applies the udev rule directly and busybox runscripts are not used.
  if ! declare -F add_systemd_unit >/dev/null; then
    add_file - '/etc/omarchy-thunderbolt-dock.uuids' 644 < <(
      printf '%s\n' "${uuids[@]}"
    )
    add_runscript
  fi
}

help() {
  cat <<HELPEOF
Authorizes already-enrolled (policy=auto) Thunderbolt peripheral docks during
early boot so keyboards and mice connected through the dock work at the
Plymouth and LUKS unlock prompt. No-ops when no policy=auto peripheral devices
are enrolled in /var/lib/boltd/devices.
HELPEOF
}

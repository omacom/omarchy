#!/usr/bin/ash
# Stands in for cryptsetup in the initramfs to note which key slot unlocked the
# disk, so omarchy-login-select can open that person's desktop. Every call but
# an unlock goes straight through. An unlock, whether Plymouth hands the
# password over or cryptsetup prompts on the console itself, runs the real
# cryptsetup once, verbose, with its prompt and errors on screen as before,
# keeps its exit status, and only after it succeeded writes
# "<LUKS UUID> <slot>" to /run, which switch_root carries into the system.
# Nothing here may turn an unlock that worked into one that failed.

real=${CRYPTSETUP_REAL:-/usr/bin/cryptsetup.real}
record=${LUKS_SLOT_RECORD:-/run/omarchy/luks-slot}

case " $* " in
  *" open "*) ;;
  *) exec "$real" "$@" ;;
esac

out=${record%/*}/luks-open.out
mkdir -p "${record%/*}" 2>/dev/null
# Somewhere to keep the output first, or the unlock goes straight through;
# `true`, since a redirect failing on `:` would end this shell instead.
true >"$out" 2>/dev/null || exec "$real" "$@"
# Only stdout is kept aside, where verbose names the slot; the prompt and any
# error stay on stderr, on screen.
"$real" --verbose "$@" >"$out"
status=$?
grep -v -e '^Key slot [0-9]* unlocked' -e '^Command successful' -e '^No usable token' "$out" 2>/dev/null
[ "$status" -eq 0 ] || { rm -f "$out"; exit "$status"; }

slot=$(sed -n 's/^Key slot \([0-9][0-9]*\) unlocked.*/\1/p' "$out" 2>/dev/null | head -n 1)
rm -f "$out"

# The device is the first argument after "open" that is neither an option nor
# the value of --type.
device=""
seen_open=0
skip=0
for arg in "$@"; do
  if [ "$skip" -eq 1 ]; then skip=0; continue; fi
  case $arg in
    open) seen_open=1 ;;
    --type) skip=1 ;;
    -*) ;;
    *) if [ "$seen_open" -eq 1 ]; then device=$arg; break; fi ;;
  esac
done

if [ -n "$slot" ] && [ -n "$device" ]; then
  uuid=$("$real" luksUUID "$device" 2>/dev/null)
  [ -n "$uuid" ] && echo "$uuid $slot" >"$record" 2>/dev/null
fi
exit 0

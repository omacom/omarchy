# A child changes their own password, which is also their disk key, and their
# lock screen asks whether a grown-up's password was typed, without a
# grown-up's sudo. The helper checks the child's current password for the
# first and answers only for a child, rate-limited, for the second.
%omarchy-child ALL=(root) NOPASSWD: /usr/bin/omarchy-user-helper password-self, /usr/bin/omarchy-user-helper adult-check

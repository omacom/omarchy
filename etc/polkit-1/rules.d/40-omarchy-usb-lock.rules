polkit.addRule(function(action, subject) {
  // pkexec supplies the executable path for its standard action. Accept the
  // old action too on machines that tested an earlier preview's XML policy.
  if ((action.id == "org.freedesktop.policykit.exec" || action.id == "org.omarchy.usb-lock.state") &&
      action.lookup("program") == "/usr/bin/omarchy-usb-lock-state") {
    if (subject.local && subject.active && subject.isInGroup("wheel")) {
      return polkit.Result.YES;
    }
    return polkit.Result.NO;
  }
});

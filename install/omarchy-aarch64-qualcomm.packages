# Qualcomm (Snapdragon) additions, composed after omarchy-base.packages and
# omarchy-aarch64.packages (omarchy-pkg-defaults aarch64-qualcomm): what every
# Snapdragon laptop runs, which install/hardware/qualcomm/ and vulkan.sh also
# install.
linux-firmware-qcom
# Copies the vendor-signed firmware (GPU zap shader, DSP images) from Windows.
qcom-firmware-extract
# A16 topology and boot checks activate only on the matching board/kernel ABI.
omarchy-a16-support
# OEM-signed A16 files have board-specific paths; calibration is model-gated.
asus-zenbook-a16-firmware
# Builds the UKI with the device trees systemd-stub picks one from.
systemd-ukify
# Adreno GPUs.
vulkan-freedreno

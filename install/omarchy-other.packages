# Hardware-specific and optional packages installed by install/hardware/*.
# Read by omarchy-iso when building the offline mirror; not baked into the
# root image (unlike omarchy-base.packages). Packages built for aarch64 only
# live in omarchy-other-aarch64.packages.

# GPU drivers and hardware video acceleration
intel-media-driver
libva-intel-driver
libva-nvidia-driver
libvpl
vpl-gpu-rt
vulkan-intel
vulkan-radeon
linux-omarchy-nvidia-open
nvidia-utils
nvidia-580xx-dkms
nvidia-580xx-utils
nvidia-container-toolkit

# Intel power, thermal, audio DSP, and MIPI camera
intel-lpmd
thermald
sof-firmware
intel-ipu7-camera
intel-ipu7-drivers-dkms
linux-omarchy-ipu7

# Audio and camera plumbing (installed when hardware needs them)
lsp-plugins-lv2
pipewire-libcamera
linux-omarchy-v4l2loopback
v4l2loopback-dkms
v4l2loopback-utils
v4l2-relayd

# Wireless
ath12k-board-fallback
broadcom-wl-dkms

# Apple Intel Macs (T2, FaceTime HD, SPI keyboard)
apple-bcm-firmware-fetcher
apple-t2-audio-config
linux-t2
linux-t2-headers
t2fanrd
facetimehd-dkms
facetimehd-firmware-fetcher
macbook12-spi-driver-dkms

# ASUS ROG
asusctl

# Dell XPS
dell-xps-touchpad-haptics
dell-xps13-sidecar-amps
linux-firmware-cirrus-dx13260

# Framework 16
qmk-hid

# Microsoft Surface
linux-firmware-marvell

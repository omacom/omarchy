#!/bin/bash

set -e

if omarchy-done ensure voxtype-install-invitation; then
  omarchy-notification-send -u critical -g  \
    "$(omarchy-i18n "Install Dictation with Voxtype")" \
    "$(omarchy-i18n "Click to install voice dictation for Omarchy.")" \
    --exec omarchy-launch-floating-terminal-with-presentation omarchy-voxtype-install
fi
